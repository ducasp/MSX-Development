    3118   00:508E  DB 06             >     in a,(IN_DATA_PORT)
    3119   00:5090  47                      ld  b,a
    3120   00:5091                          ; done
    3121   00:5091  AF                      xor a
    3122   00:5092  C9                      ret
    3123   00:5093                      
    3124   00:5093                      ;=====================
    3125   00:5093                      ;===  TCPIP_DNS_Q  ===
    3126   00:5093                      ;=====================
    3127   00:5093                      ;Start a host name resolution query.
    3128   00:5093                      ;
    3129   00:5093                      ;Input:  A  = 6
    3130   00:5093                      ;        HL = Address of the host name to be resolved, zero terminated
    3131   00:5093                      ;        B  = Flags, when set to 1 they instruct the resolver to:
    3132   00:5093                      ;             bit 0: Only abort the query currently in progress, if there is any
    3133   00:5093                      ;                    (other flags and registers are then ignored)
    3134   00:5093                      ;             bit 1: Assume that the passed name is an IP address,
    3135   00:5093                      ;                    and return an error if this is not true
    3136   00:5093                      ;             bit 2: If there is a query in progress already,
    3137   00:5093                      ;                    do NOT abort it and return an error instead
    3138   00:5093                      ;Output:  A = Error code
    3139   00:5093                      ;         B = 0 if a query to a DNS server is in progress
    3140   00:5093                      ;             1 if the name represented an IP address
    3141   00:5093                      ;             2 if the name could be resolved locally
    3142   00:5093                      ;         L.H.E.D = Resolved IP address
    3143   00:5093                      ;                   (only if no error occurred and B=1 or 2 is returned)
    3144   00:5093                      ;RAM Buffer to store names to be resolved (and used also to translate IPs from ASCII to 32bits number)
    3145   00:5093                      ;Will store the result of the last DNS query
    3146   00:5093                      TCPIP_DNS_Q:
    3147   00:5093  E5                      push    hl                      ; Save HL
    3148   00:5094  AF                      xor a
    3149   00:5095  5F                      ld  e,a
    3150   00:5096  57                      ld  d,a                         ; Zero DE
    3151   00:5097                      TCPIP_DNS_Q_SIZE_LOOP:
    3152   00:5097  7E                      ld  a,(hl)                      ; so let's check the size of dns data
    3153   00:5098  B7                      or  a                           ; it is zero terminated
    3154   00:5099  28 05                   jr  z,TCPIP_DNS_Q_SEND          ; if zero, end of string
    3155   00:509B  13                      inc de                          ; ok, not zero, one more char
    3156   00:509C  23                      inc hl                          ; next
    3157   00:509D  C3 97 50                jp  TCPIP_DNS_Q_SIZE_LOOP       ; jp is a tad bit faster and we are not worried about code size
    3158   00:50A0                      TCPIP_DNS_Q_SEND:
    3159   00:50A0                          ; Here we send the query and wait the result
    3160   00:50A0  13                      inc de                          ; add 1, we will send flag first
    3161   00:50A1  3E CE                   ld  a,206                       ; DNS_Q_NEW
    3162   00:50A3                          SEND_DATA                       ; Send the command
    3162   00:50A3  D3 07             >     out (OUT_TX_PORT),a
    3163   00:50A5  7A                      ld  a,d
    3164   00:50A6                          SEND_DATA                       ; Send the command size msb
    3164   00:50A6  D3 07             >     out (OUT_TX_PORT),a
    3165   00:50A8  7B                      ld  a,e
    3166   00:50A9                          SEND_DATA                       ; Send the command size lsb
    3166   00:50A9  D3 07             >     out (OUT_TX_PORT),a
    3167   00:50AB  78                      ld  a,b
    3168   00:50AC                          SEND_DATA                       ; Send the flag byte
    3168   00:50AC  D3 07             >     out (OUT_TX_PORT),a
    3169   00:50AE                      
    3170   00:50AE                          if USE_MEM_IO = 0
    3171   00:50AE                          ; now otir of DNS/DNS BUFFER DATA SIZE
    3172   00:50AE  0E 07                   ld  c,OUT_TX_PORT               ; our data TX port
    3173   00:50B0                          endif
    3174   00:50B0  E1                      pop hl                          ; string to try to resolve
    3175   00:50B1  1B                      dec de                          ; we are sending just data addressed by HL, so revert count
    3176   00:50B2  7A                      ld  a,d
    3177   00:50B3  B3                      or  e                           ; if de zero, no string, wrong parameters, but let the ESP answer
    3178   00:50B4  CA C4 50                jp  z,TCPIP_DNS_Q_WAIT_RSP
    3179   00:50B7  AF                      xor a
    3180   00:50B8                          ; Fast 16 bit variable size loop by GRAUW
    3181   00:50B8  43                      ld  b,e
    3182   00:50B9  1B                      dec de
    3183   00:50BA  14                      inc d
    3184   00:50BB                      TCPIP_DNS_Q_SENDLP:
    3185   00:50BB                          ; send it
    3186   00:50BB                          if USE_MEM_IO = 0
    3187   00:50BB  ED A3                   outi
    3188   00:50BD  C2 BB 50                jp  nz,TCPIP_DNS_Q_SENDLP
    3189   00:50C0                          else
    3190   00:50C0                    ~     ld  a,(hl)
    3191   00:50C0                    ~     ld  (MEM_OUT_TX_PORT),a
    3192   00:50C0                    ~     inc hl
    3193   00:50C0                    ~     djnz TCPIP_DNS_Q_SENDLP
    3194   00:50C0                    ~     endif
    3195   00:50C0  15                      dec d
    3196   00:50C1  C2 BB 50                jp  nz,TCPIP_DNS_Q_SENDLP
    3197   00:50C4                      TCPIP_DNS_Q_WAIT_RSP:
    3198   00:50C4                          ; Now wait up to 900 ticks (15s@60Hz) to get response
    3199   00:50C4  21 84 03                ld  hl,900
    3200   00:50C7  CD EC 5E                call    SETCOUNTER
    3201   00:50CA                      TCPIP_DNSQ_SEND_ST1:
    3202   00:50CA                          CHECK_DATA
    3202   00:50CA  DB 07             >     in  a,(IN_STS_PORT)
    3202   00:50CC  CB 47             >     bit 0,a
    3203   00:50CE  20 05                   jr  nz,TCPIP_DNSQ_SEND_ST1.1
    3204   00:50D0  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3205   00:50D3  18 F5                   jr  TCPIP_DNSQ_SEND_ST1
    3206   00:50D5                      TCPIP_DNSQ_SEND_ST1.1:
    3207   00:50D5                          ; nz, check the data
    3208   00:50D5                          RECEIVE_DATA
    3208   00:50D5  DB 06             >     in a,(IN_DATA_PORT)
    3209   00:50D7  FE CE                   cp  206                         ; Is response of our command?
    3210   00:50D9  20 EF                   jr  nz,TCPIP_DNSQ_SEND_ST1
    3211   00:50DB                          ; now get return code, if return code other than 0, it is finished
    3212   00:50DB                      TCPIP_DNSQ_SEND_RC:
    3213   00:50DB                          CHECK_DATA
    3213   00:50DB  DB 07             >     in  a,(IN_STS_PORT)
    3213   00:50DD  CB 47             >     bit 0,a
    3214   00:50DF  20 05                   jr  nz,TCPIP_DNSQ_SEND_RC.1
    3215   00:50E1  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3216   00:50E4  18 F5                   jr  TCPIP_DNSQ_SEND_RC
    3217   00:50E6                      TCPIP_DNSQ_SEND_RC.1:
    3218   00:50E6                          ; nz, discard
    3219   00:50E6                          RECEIVE_DATA
    3219   00:50E6  DB 06             >     in a,(IN_DATA_PORT)
    3220   00:50E8  B7                      or  a                           ; 0?
    3221   00:50E9  06 00                   ld  b,0                         ; say in progress as there is no failure status
    3222   00:50EB  C0                      ret nz                          ; if not, done, ERROR won't return data
    3223   00:50EC                      
    3224   00:50EC                          ; next two bytes are return code and size bytes, don't care, it is 4, resolved IP
    3225   00:50EC  06 02                   ld  b,2
    3226   00:50EE                      TCPIP_DNSQ_SEND_RC_ST2:
    3227   00:50EE                          CHECK_DATA
    3227   00:50EE  DB 07             >     in  a,(IN_STS_PORT)
    3227   00:50F0  CB 47             >     bit 0,a
    3228   00:50F2  20 05                   jr  nz,TCPIP_DNSQ_SEND_RC_ST2.1
    3229   00:50F4  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3230   00:50F7  18 F5                   jr  TCPIP_DNSQ_SEND_RC_ST2
    3231   00:50F9                      TCPIP_DNSQ_SEND_RC_ST2.1:
    3232   00:50F9                          ; nz, discard
    3233   00:50F9                          RECEIVE_DATA
    3233   00:50F9  DB 06             >     in a,(IN_DATA_PORT)
    3234   00:50FB  05                      dec b
    3235   00:50FC  20 F0                   jr  nz,TCPIP_DNSQ_SEND_RC_ST2
    3236   00:50FE                      
    3237   00:50FE                          ; now just get the 4 bytes IP and place it in L H E D
    3238   00:50FE                      TCPIP_DNSQ_IP_ST1:
    3239   00:50FE                          CHECK_DATA
    3239   00:50FE  DB 07             >     in  a,(IN_STS_PORT)
    3239   00:5100  CB 47             >     bit 0,a
    3240   00:5102  20 05                   jr  nz,TCPIP_DNSQ_IP_ST1.1
    3241   00:5104  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3242   00:5107  18 F5                   jr  TCPIP_DNSQ_IP_ST1
    3243   00:5109                      TCPIP_DNSQ_IP_ST1.1:
    3244   00:5109                          ; nz, get it
    3245   00:5109                          RECEIVE_DATA
    3245   00:5109  DB 06             >     in a,(IN_DATA_PORT)
    3246   00:510B  6F                      ld  l,a
    3247   00:510C                      TCPIP_DNSQ_IP_ST2:
    3248   00:510C                          CHECK_DATA
    3248   00:510C  DB 07             >     in  a,(IN_STS_PORT)
    3248   00:510E  CB 47             >     bit 0,a
    3249   00:5110  20 05                   jr  nz,TCPIP_DNSQ_IP_ST2.1
    3250   00:5112  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3251   00:5115  18 F5                   jr  TCPIP_DNSQ_IP_ST2
    3252   00:5117                      TCPIP_DNSQ_IP_ST2.1:
    3253   00:5117                          ; nz, get it
    3254   00:5117                          RECEIVE_DATA
    3254   00:5117  DB 06             >     in a,(IN_DATA_PORT)
    3255   00:5119  67                      ld  h,a
    3256   00:511A                      TCPIP_DNSQ_IP_ST3:
    3257   00:511A                          CHECK_DATA
    3257   00:511A  DB 07             >     in  a,(IN_STS_PORT)
    3257   00:511C  CB 47             >     bit 0,a
    3258   00:511E  20 05                   jr  nz,TCPIP_DNSQ_IP_ST3.1
    3259   00:5120  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3260   00:5123  18 F5                   jr  TCPIP_DNSQ_IP_ST3
    3261   00:5125                      TCPIP_DNSQ_IP_ST3.1:
    3262   00:5125                          ; nz, get it
    3263   00:5125                          RECEIVE_DATA
    3263   00:5125  DB 06             >     in a,(IN_DATA_PORT)
    3264   00:5127  5F                      ld  e,a
    3265   00:5128                      TCPIP_DNSQ_IP_ST4:
    3266   00:5128                          CHECK_DATA
    3266   00:5128  DB 07             >     in  a,(IN_STS_PORT)
    3266   00:512A  CB 47             >     bit 0,a
    3267   00:512C  20 05                   jr  nz,TCPIP_DNSQ_IP_ST4.1
    3268   00:512E  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3269   00:5131  18 F5                   jr  TCPIP_DNSQ_IP_ST4
    3270   00:5133                      TCPIP_DNSQ_IP_ST4.1:
    3271   00:5133                          ; nz, get it
    3272   00:5133                          RECEIVE_DATA
    3272   00:5133  DB 06             >     in a,(IN_DATA_PORT)
    3273   00:5135  57                      ld  d,a
    3274   00:5136                          ; done
    3275   00:5136  3E 01                   ld  a,1
    3276   00:5138  CD 11 60                call    SETDNSREADY             ; DNS done
    3277   00:513B  CD 3B 60                call    SETDNSRESULT            ; DNS RESULT
    3278   00:513E  06 02                   ld  b,2
    3279   00:5140  AF                      xor a
    3280   00:5141  C9                      ret
    3281   00:5142                      
    3282   00:5142                      ;=====================
    3283   00:5142                      ;===  TCPIP_DNS_S  ===
    3284   00:5142                      ;=====================
    3285   00:5142                      ;Obtains the host name resolution process state and result.
    3286   00:5142                      ;
    3287   00:5142                      ;Input:  A = 7
    3288   00:5142                      ;        B = Flags, when set to 1 they instruct the resolver to:
    3289   00:5142                      ;            bit 0: Clear any existing result or error condition after the execution
    3290   00:5142                      ;                   (except if there is a query in progress)
    3291   00:5142                      ;Output: A = Error code
    3292   00:5142                      ;        B = DNS error code (when error is ERR_DNS)
    3293   00:5142                      ;        B = Current query status (when error is ERR_OK):
    3294   00:5142                      ;            0: There is no query in progress, nor any result nor error code available
    3295   00:5142                      ;            1: There is a query in progress
    3296   00:5142                      ;            2: Query is complete
    3297   00:5142                      ;        C = Current query sub status (when error is ERR_OK and B=1):
    3298   00:5142                      ;            0: Unknown
    3299   00:5142                      ;            1: Querying the primary DNS server
    3300   00:5142                      ;            2: Querying the secondary DNS server
    3301   00:5142                      ;            3: Querying another DNS server
    3302   00:5142                      ;        C = Resolution process type (when error is ERR_OK and B=2):
    3303   00:5142                      ;            0: The name was obtained by querying a DNS server
    3304   00:5142                      ;            1: The name was a direct representation of an IP address
    3305   00:5142                      ;            2: The name was resolved locally
    3306   00:5142                      ;       L.H.E.D = Resolved IP address (when error is ERR_OK and B=2)
    3307   00:5142                      TCPIP_DNS_S:
    3308   00:5142                          ;--- Is there a result?
    3309   00:5142  CD FF 5F                call    GETDNSREADY             ; DNS done?
    3310   00:5145  B7                      or  a
    3311   00:5146  28 23                   jr  z,TCPIP_DNS_S_NORESULT      ; No DNS result
    3312   00:5148                          ;--- Ok, we have a result, is it success?
    3313   00:5148  3D                      dec a
    3314   00:5149  28 12                   jr  z,TCPIP_DNS_S_HASRESULT     ; If it is 1, it was not an error
    3315   00:514B                          ;--- Shoot, there is an error...
    3316   00:514B                          ;--- And sure thing, ESP do not tell us details, it is always failure :-P
    3317   00:514B  CB 40                   bit 0,b                         ;--- clear error after this?
    3318   00:514D  28 09                   jr  z,TCP_IP_DNS_S_NOCLR
    3319   00:514F                          ;--- Clear
    3320   00:514F  06 00                   ld b,0                          ;--- Like I've said, no details
    3321   00:5151  AF                      xor a
    3322   00:5152  CD 11 60                call    SETDNSREADY             ; DNS not done
    3323   00:5155  3E 08                   ld  a,ERR_DNS;
    3324   00:5157  C9                      ret
    3325   00:5158                      TCP_IP_DNS_S_NOCLR:
    3326   00:5158                          ;--- Don't clear
    3327   00:5158  3E 08                   ld  a,ERR_DNS
    3328   00:515A  06 00                   ld  b,0                         ;--- Like I've said, no details
    3329   00:515C  C9                      ret
    3330   00:515D                          ;--- There is a result available...
    3331   00:515D                      TCPIP_DNS_S_HASRESULT:
    3332   00:515D                          ;--- Copy the result
    3333   00:515D  CD 25 60                call    GETDNSRESULT
    3334   00:5160  AF                      xor a
    3335   00:5161  CB 40                   bit 0,b                         ;--- clear result after this?
    3336   00:5163  28 03                   jr  z,TCP_IP_DNS_S_RES_NOCLR    ;--- no, just return
    3337   00:5165                          ;--- Yes, clear
    3338   00:5165  CD 11 60                call    SETDNSREADY             ; DNS not done
    3339   00:5168                      TCP_IP_DNS_S_RES_NOCLR:
    3340   00:5168  06 02                   ld  b,2
    3341   00:516A  C9                      ret
    3342   00:516B                      
    3343   00:516B                      TCPIP_DNS_S_NORESULT:
    3344   00:516B  AF                      xor a                           ;--- OK no query in progress, no result, means nothing in progress
    3345   00:516C  06 00                   ld  b,0                         ;--- No query in progress
    3346   00:516E  C9                      ret
    3347   00:516F                      
    3348   00:516F                      ;========================
    3349   00:516F                      ;===  TCPIP_UDP_OPEN  ===
    3350   00:516F                      ;========================
    3351   00:516F                      ;Open an UDP connection.
    3352   00:516F                      ;
    3353   00:516F                      ;Input:  A  = 8
    3354   00:516F                      ;        HL = Local port number (#FFFF=random)
    3355   00:516F                      ;        B  = Intended connection lifetime:
    3356   00:516F                      ;             0: Transient
    3357   00:516F                      ;             1: Resident
    3358   00:516F                      ;Output: A = Error code
    3359   00:516F                      ;        B = Connection number
    3360   00:516F                      TCPIP_UDP_OPEN:
    3361   00:516F                          SEND_DATA                       ; Send the command
    3361   00:516F  D3 07             >     out (OUT_TX_PORT),a
    3362   00:5171  AF                      xor a
    3363   00:5172                          SEND_DATA                       ; Send the command size msb
    3363   00:5172  D3 07             >     out (OUT_TX_PORT),a
    3364   00:5174  3E 03                   ld  a,3
    3365   00:5176                          SEND_DATA                       ; Send the command size lsb
    3365   00:5176  D3 07             >     out (OUT_TX_PORT),a
    3366   00:5178  7D                      ld  a,l
    3367   00:5179                          SEND_DATA                       ; Send the port LSB
    3367   00:5179  D3 07             >     out (OUT_TX_PORT),a
    3368   00:517B  7C                      ld  a,h
    3369   00:517C                          SEND_DATA                       ; Send the port MSB
    3369   00:517C  D3 07             >     out (OUT_TX_PORT),a
    3370   00:517E  78                      ld  a,b
    3371   00:517F                          SEND_DATA                       ; Send the connection transient/resident
    3371   00:517F  D3 07             >     out (OUT_TX_PORT),a
    3372   00:5181                      
    3373   00:5181                          ; Now wait up to 180 ticks to get response
    3374   00:5181  21 B4 00                ld  hl,180
    3375   00:5184  CD EC 5E                call    SETCOUNTER
    3376   00:5187                      TCPIP_UDP_OPEN_ST1:
    3377   00:5187                          CHECK_DATA
    3377   00:5187  DB 07             >     in  a,(IN_STS_PORT)
    3377   00:5189  CB 47             >     bit 0,a
    3378   00:518B  20 05                   jr  nz,TCPIP_UDP_OPEN_ST1.1
    3379   00:518D  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3380   00:5190  18 F5                   jr  TCPIP_UDP_OPEN_ST1
    3381   00:5192                      TCPIP_UDP_OPEN_ST1.1:
    3382   00:5192                          ; nz, check the data
    3383   00:5192                          RECEIVE_DATA
    3383   00:5192  DB 06             >     in a,(IN_DATA_PORT)
    3384   00:5194  FE 08                   cp  8                           ; Is response of our command?
    3385   00:5196  20 EF                   jr  nz,TCPIP_UDP_OPEN_ST1
    3386   00:5198                          ; now get return code, if return code other than 0, it is finished
    3387   00:5198                      TCPIP_UDP_OPEN_RC:
    3388   00:5198                          CHECK_DATA
    3388   00:5198  DB 07             >     in  a,(IN_STS_PORT)
    3388   00:519A  CB 47             >     bit 0,a
    3389   00:519C  20 05                   jr  nz,TCPIP_UDP_OPEN_RC.1
    3390   00:519E  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3391   00:51A1  18 F5                   jr  TCPIP_UDP_OPEN_RC
    3392   00:51A3                      TCPIP_UDP_OPEN_RC.1:
    3393   00:51A3                          ; nz, discard
    3394   00:51A3                          RECEIVE_DATA
    3394   00:51A3  DB 06             >     in a,(IN_DATA_PORT)
    3395   00:51A5  B7                      or  a                           ; 0?
    3396   00:51A6  C0                      ret nz                          ; if not, done
    3397   00:51A7                      
    3398   00:51A7                          ; next two bytes are return code and size bytes, don't care, it is 1, conn #
    3399   00:51A7  06 02                   ld  b,2
    3400   00:51A9                      TCPIP_UDP_OPEN_ST2:
    3401   00:51A9                          CHECK_DATA
    3401   00:51A9  DB 07             >     in  a,(IN_STS_PORT)
    3401   00:51AB  CB 47             >     bit 0,a
    3402   00:51AD  20 05                   jr  nz,TCPIP_UDP_OPEN_ST2.1
    3403   00:51AF  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3404   00:51B2  18 F5                   jr  TCPIP_UDP_OPEN_ST2
    3405   00:51B4                      TCPIP_UDP_OPEN_ST2.1:
    3406   00:51B4                          ; nz, discard
    3407   00:51B4                          RECEIVE_DATA
    3407   00:51B4  DB 06             >     in a,(IN_DATA_PORT)
    3408   00:51B6  05                      dec b
    3409   00:51B7  20 F0                   jr  nz,TCPIP_UDP_OPEN_ST2
    3410   00:51B9                      
    3411   00:51B9                          ; now just get the 1 byte, conn#, should go to B
    3412   00:51B9                      TCPIP_UDP_OPEN_CONN_ST1:
    3413   00:51B9                          CHECK_DATA
    3413   00:51B9  DB 07             >     in  a,(IN_STS_PORT)
    3413   00:51BB  CB 47             >     bit 0,a
    3414   00:51BD  20 05                   jr  nz,TCPIP_UDP_OPEN_CONN_ST1.1
    3415   00:51BF  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3416   00:51C2  18 F5                   jr  TCPIP_UDP_OPEN_CONN_ST1
    3417   00:51C4                      TCPIP_UDP_OPEN_CONN_ST1.1:
    3418   00:51C4                          ; nz, get it
    3419   00:51C4                          RECEIVE_DATA
    3419   00:51C4  DB 06             >     in a,(IN_DATA_PORT)
    3420   00:51C6  47                      ld  b,a
