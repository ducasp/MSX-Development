    4912   00:5885                      ;===  TCPIP_TCP_STATE  ===
    4913   00:5885                      ;=========================
    4914   00:5885                      ;Get the state of a TCP connection.
    4915   00:5885                      ;
    4916   00:5885                      ;Input:  A = 16
    4917   00:5885                      ;        B = Connection number
