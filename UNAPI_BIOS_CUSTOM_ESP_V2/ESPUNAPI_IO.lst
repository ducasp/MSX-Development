    6683   00:5FDC  00                      db  %00000000
    6684   00:5FDD  20                      db  %00100000
    6685   00:5FDE  00                      db  %00000000
    6686   00:5FDF                      ; Pattern-07 is CHR$(1)+CHR$(87) = Wi-Fi is Idle, AP configured:
