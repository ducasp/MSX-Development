    1129   00:459C  20 FC                   jr  nz,WIFI_SCAN_WAITHS
    1130   00:459E  1B                      dec de
    1131   00:459F  7B                      ld  a,e
    1132   00:45A0  B2                      or  d
    1133   00:45A1  CA 05 48                jp  z,WIFI_SCAN_TIMEOUT
    1134   00:45A4  C3 81 45                jp  WIFI_SCAN_WAIT_END
