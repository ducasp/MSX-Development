    1353   00:4709                          ; Check for encryption
    1354   00:4709  1A                      ld  a,(de)
    1355   00:470A  B7                      or  a
    1356   00:470B  CA 9C 47                jp  z,WIFI_CONNECT_SENDCMD      ; If no password requested, good to go
    1357   00:470E                          ; Shoot, need to request password, well, let's do it
    1358   00:470E  E5                      push    hl                      ; Save HL
    1359   00:470F  21 ED 6A                ld  hl,MMENU_ASKPWD
    1360   00:4712  CD 47 4C                call    PRINTHL                 ; Inform that user need to input PWD
    1361   00:4715  E1                      pop hl                          ; Restore HL
    1362   00:4716  FD 21 00 00             ld  iy,0                        ; IY will help in backspacing
    1363   00:471A  DD 26 01                ld  ixh,1                       ; Start hidden
    1364   00:471D                      WIFI_CONNECT_RCV_PWD:
    1365   00:471D  CD 9F 00                call    CHGET
    1366   00:4720  FE 1B                   cp  #1b                         ; ESC?
    1367   00:4722  CA 46 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1368   00:4725  FE 08                   cp  #08                         ; Backspace?
    1369   00:4727  CA 78 47                jp  z,WIFI_CONNECT_RCV_PWD_BS   ; Check if there is something to erase
    1370   00:472A  FE 0D                   cp  #0d                         ; ENTER?
    1371   00:472C  CA 95 47                jp  z,WIFI_PWD_CHECK_INPUT      ; Check if ok
    1372   00:472F  FE 7F                   cp  #7f                         ; Delete?
    1373   00:4731  CA 64 47                jp  z,WIFI_CONNECT_RCV_PWDH     ; Change password from clear to hidden or vice versa
    1374   00:4734                      WIFI_CONNECT_RCV_PWD_STR:
    1375   00:4734                          ; Ok, so it is a digit and store
    1376   00:4734  12                      ld  (de),a
    1377   00:4735  FD 7D                   ld  a,iyl
    1378   00:4737  D6 3F                   sub 63                          ; 63 chars password limit (WPA2 encryption)
    1379   00:4739  28 E2                   jr  z,WIFI_CONNECT_RCV_PWD
    1380   00:473B  1A                      ld  a,(de)
    1381   00:473C  03                      inc bc
    1382   00:473D  13                      inc de
    1383   00:473E  FD 23                   inc iy                          ; Increment counters and pointer
    1384   00:4740  F5                      push    af                      ; Save A
    1385   00:4741  DD 7C                   ld  a,ixh
    1386   00:4743  B7                      or  a                           ; If zero, print char, otherwise print *
    1387   00:4744  28 09                   jr  z,WIFI_CONNECT_RCV_PWD_CHAR
    1388   00:4746  F1                      pop af
    1389   00:4747  3E 2A                   ld  a,'*'                       ; Print * and keep password hidden
    1390   00:4749  CD A2 00                call    CHPUT
    1391   00:474C  C3 1D 47                jp  WIFI_CONNECT_RCV_PWD        ; And back to receiving digits
    1392   00:474F                      WIFI_CONNECT_RCV_PWD_CHAR:
    1393   00:474F  F1                      pop af
    1394   00:4750  FE 20                   cp  32
    1395   00:4752  30 04                   jr  nc,WIFI_CONNECT_RCV_CHKPRT2 ; Ok, not below space, but is it delete?
    1396   00:4754  3E 3F                   ld  a,'?'                       ; Prints a question mark
    1397   00:4756  18 06                   jr  WIFI_CONNECT_RCV_CHKPRTD
    1398   00:4758                      WIFI_CONNECT_RCV_CHKPRT2:
    1399   00:4758  FE 7F                   cp  #7f
    1400   00:475A  20 02                   jr  nz,WIFI_CONNECT_RCV_CHKPRTD
    1401   00:475C  3E 3F                   ld  a,'?'                       ; Prints a question mark if it is delete
    1402   00:475E                      WIFI_CONNECT_RCV_CHKPRTD:
    1403   00:475E  CD A2 00                call    CHPUT                   ; Print a char
    1404   00:4761  C3 1D 47                jp  WIFI_CONNECT_RCV_PWD        ; And back to receiving digits
    1405   00:4764                      
    1406   00:4764                      WIFI_CONNECT_RCV_PWDH:
    1407   00:4764  FD 7D                   ld  a,iyl
    1408   00:4766  FD B4                   or  iyh
    1409   00:4768  C2 34 47                jp  nz,WIFI_CONNECT_RCV_PWD_STR ; If digits entered, can't change password behavior, so it is a pass phrase char
    1410   00:476B  AF                      xor a
    1411   00:476C  DD B4                   or  ixh
    1412   00:476E  DD 26 01                ld  ixh,1
    1413   00:4771  28 AA                   jr  z,WIFI_CONNECT_RCV_PWD      ; Return if it was 0
    1414   00:4773  DD 26 00                ld  ixh,0
    1415   00:4776  28 A5                   jr  z,WIFI_CONNECT_RCV_PWD      ; Otherwise set to 0 and return
    1416   00:4778                      
    1417   00:4778                      WIFI_CONNECT_RCV_PWD_BS:
    1418   00:4778  FD 7D                   ld  a,iyl
    1419   00:477A  FD B4                   or  iyh
    1420   00:477C  CA 1D 47                jp  z,WIFI_CONNECT_RCV_PWD      ; If no digits entered, nothing to erase
    1421   00:477F  FD 2B                   dec iy                          ; Decrement counter
    1422   00:4781  0B                      dec bc                          ; Decrement counter
    1423   00:4782  1B                      dec de                          ; Decrement pointer
    1424   00:4783  3E 08                   ld  a,8                         ; Backspace
    1425   00:4785  CD A2 00                call    CHPUT                   ; Print it
    1426   00:4788  3E 20                   ld  a,' '                       ; Space
    1427   00:478A  CD A2 00                call    CHPUT                   ; Print it
    1428   00:478D  3E 08                   ld  a,8                         ; Backspace
    1429   00:478F  CD A2 00                call    CHPUT                   ; Print it
    1430   00:4792  C3 1D 47                jp  WIFI_CONNECT_RCV_PWD        ; Return
    1431   00:4795                      
    1432   00:4795                      WIFI_PWD_CHECK_INPUT:
    1433   00:4795  FD 7D                   ld  a,iyl
    1434   00:4797  FD B4                   or  iyh
    1435   00:4799  CA 1D 47                jp  z,WIFI_CONNECT_RCV_PWD      ; If no digits entered, no password to send
    1436   00:479C                          ; Otherwise done and ready to send
    1437   00:479C                      WIFI_CONNECT_SENDCMD:
    1438   00:479C  CD DE 49                call    WAIT_250MS_AND_THEN_CONTINUE
    1439   00:479F  E5                      push    hl
    1440   00:47A0  21 A9 6A                ld  HL,MMENU_CONNECTING
    1441   00:47A3  CD 47 4C                call    PRINTHL
    1442   00:47A6  E1                      pop hl
    1443   00:47A7                          ; Print AP name
    1444   00:47A7  E5                      push    hl
    1445   00:47A8  CD 51 4C                call    PRINTHLINE              ; Print AP Name
    1446   00:47AB  E1                      pop hl
    1447   00:47AC                          ; HL has the address of our data, BC the data size, so it is just needed to send the command
    1448   00:47AC                          CLEAR_UART
    1448   00:47AC  3E 14             >     ld  a,20
    1448   00:47AE  D3 06             >     out (OUT_CMD_PORT),a
    1449   00:47B0  3E 41                   ld  a,CMD_WIFI_CONNECT
    1450   00:47B2                          SEND_DATA
    1450   00:47B2  D3 07             >     out (OUT_TX_PORT),a
    1451   00:47B4  78                      ld  a,b                         ; Size MSB is in B
    1452   00:47B5                          SEND_DATA
    1452   00:47B5  D3 07             >     out (OUT_TX_PORT),a
    1453   00:47B7  79                      ld  a,c                         ; Size LSB is in c
    1454   00:47B8                          SEND_DATA
    1454   00:47B8  D3 07             >     out (OUT_TX_PORT),a
    1455   00:47BA                      WIFI_CONNECT_SENDCMDLP:
    1456   00:47BA  7E                      ld  a,(hl)
    1457   00:47BB                          SEND_DATA
    1457   00:47BB  D3 07             >     out (OUT_TX_PORT),a
    1458   00:47BD  23                      inc hl
    1459   00:47BE  0B                      dec bc
    1460   00:47BF  78                      ld  a,b
    1461   00:47C0  B1                      or  c
    1462   00:47C1  C2 BA 47                jp  nz,WIFI_CONNECT_SENDCMDLP
    1463   00:47C4  21 58 02                ld  hl,600                      ; Wait Up To 10s
    1464   00:47C7  3E 41                   ld  a,CMD_WIFI_CONNECT          ; Our command
    1465   00:47C9  CD FA 4A                call    WAIT_MENU_QCMD_RESPONSE
    1466   00:47CC  CA D8 47                jp  z,WIFI_CONNECT_FAIL
    1467   00:47CF  21 4E 6F                ld  hl,STR_SENDING_OK_JN        ; Success
    1468   00:47D2  CD 47 4C                call    PRINTHL
    1469   00:47D5  C3 D6 49                jp  WAIT_2S_AND_THEN_MAINMENU
    1470   00:47D8                      WIFI_CONNECT_FAIL:
    1471   00:47D8  21 70 6F                ld  hl,STR_SENDING_NOK_JN       ; Failure
    1472   00:47DB  CD 47 4C                call    PRINTHL
    1473   00:47DE  C3 D2 49                jp  WAIT_4S_AND_THEN_MAINMENU
    1474   00:47E1                      
    1475   00:47E1                      INPUT_WFSAP_BAD_INPUT:
    1476   00:47E1  C5                      push    bc
    1477   00:47E2  D5                      push    de
    1478   00:47E3  F5                      push    af
    1479   00:47E4  E5                      push    hl
    1480   00:47E5  DD E5                   push    ix
    1481   00:47E7  FD E5                   push    iy
    1482   00:47E9  CD C0 00                call    BEEP                    ; Wrong Input, beep
    1483   00:47EC  FD E1                   pop iy
    1484   00:47EE  DD E1                   pop ix
    1485   00:47F0  E1                      pop hl
    1486   00:47F1  F1                      pop af
    1487   00:47F2  D1                      pop de
    1488   00:47F3  C1                      pop bc
    1489   00:47F4  C3 24 46                jp WIFI_SELECT_AP               ; Return
    1490   00:47F7                      
    1491   00:47F7                      WIFI_SCAN_NONETWORKS:
    1492   00:47F7  21 5C 6A                ld  hl,MMENU_SCANN
    1493   00:47FA  CD 47 4C                call    PRINTHL
    1494   00:47FD  C3 D2 49                jp  WAIT_4S_AND_THEN_MAINMENU
    1495   00:4800                      
    1496   00:4800                      WIFI_SCAN_TIMEOUT:
    1497   00:4800  21 3C 6A                ld  hl,MMENU_SCANF
    1498   00:4803  CD 47 4C                call    PRINTHL
    1499   00:4806  C3 D2 49                jp  WAIT_4S_AND_THEN_MAINMENU
    1500   00:4809                      
    1501   00:4809                      SET_WIFI_TIMEOUT:
    1502   00:4809  3E 32                   ld  a,'2'
    1503   00:480B  CD A2 00                call    CHPUT
    1504   00:480E  CD DE 49                call    WAIT_250MS_AND_THEN_CONTINUE
    1505   00:4811  21 1F 6C                ld  hl,MMENU_TIMEOUT
    1506   00:4814  CD 47 4C                call    PRINTHL                 ; Print Main Timeout message
    1507   00:4817  CD 4B 4A                call    CHECKTIMEOUT            ; TimeOut is on or off?
    1508   00:481A  CA 32 48                jp  z,WIFI_SET_ALWAYS_ON        ; If 0, always on
    1509   00:481D                          ; Otherwise there is a timeout
    1510   00:481D  E5                      push    hl
    1511   00:481E  21 56 6D                ld hl,MMENU_TIMEOUT_NOTALWAYSON1
    1512   00:4821  CD 47 4C                call    PRINTHL
    1513   00:4824  E1                      pop hl
    1514   00:4825  CD 47 4C                call    PRINTHL
    1515   00:4828  21 6C 6D                ld hl,MMENU_TIMEOUT_NOTALWAYSON2
    1516   00:482B  CD 47 4C                call    PRINTHL
    1517   00:482E  16 00                   ld  d,0                         ; Count digits
    1518   00:4830  18 10                   jr  INPUT_TIMEOUT
    1519   00:4832                      WIFI_SET_ALWAYS_ON:
    1520   00:4832  21 01 6D                ld  hl,MMENU_TIMEOUT_ALWAYSON
    1521   00:4835  CD 47 4C                call    PRINTHL
    1522   00:4838  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1523   00:483C  DD 6B                   ld  ixl,e
    1524   00:483E  DD 62                   ld  ixh,d                       ; Address in IX
    1525   00:4840  16 00                   ld  d,0                         ; Count digits
    1526   00:4842                      INPUT_TIMEOUT:
    1527   00:4842  CD 9F 00                call    CHGET
    1528   00:4845  FE 1B                   cp  #1b                         ; ESC?
    1529   00:4847  CA 46 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1530   00:484A  FE 0D                   cp  #0d                         ; ENTER?
    1531   00:484C  CA 90 48                jp  z,SET_WIFI_CHECK_INPUT      ; Check if ok
    1532   00:484F  FE 08                   cp  #08                         ; Backspace?
    1533   00:4851  CA 76 48                jp  z,SET_WIFI_BS_INPUT         ; Check if there is something to erase
    1534   00:4854  FE 30                   cp  '0'                         ; Check if A is less than 0
    1535   00:4856  DA 70 48                jp  c,INPUT_TIMEOUT_BAD_INPUT   ; if it is, ignore
    1536   00:4859  FE 3A                   cp  '9'+1                       ; Check if a is greater than  9
    1537   00:485B  D2 70 48                jp  nc,INPUT_TIMEOUT_BAD_INPUT  ; If it is, ignore
    1538   00:485E  DD 77 00                ld  (ix+0),a                    ; Save it
    1539   00:4861  CD A2 00                call    CHPUT                   ; It is valid, so print it
    1540   00:4864  14                      inc d                           ; Increment digit count
    1541   00:4865  DD 23                   inc ix                          ; Increment pointer
    1542   00:4867  3E 03                   ld  a,3
    1543   00:4869  BA                      cp  d
    1544   00:486A  CA 90 48                jp  z,SET_WIFI_CHECK_INPUT      ; All we can do is accept up to 3 digits, check if ok
    1545   00:486D  C3 42 48                jp  INPUT_TIMEOUT               ; Not done yet, so continue
    1546   00:4870                      
    1547   00:4870                      INPUT_TIMEOUT_BAD_INPUT:
    1548   00:4870  CD C0 00                call    BEEP                    ; Wrong Input, beep
    1549   00:4873  C3 42 48                jp INPUT_TIMEOUT                ; Return
    1550   00:4876                      
    1551   00:4876                      SET_WIFI_BS_INPUT:
    1552   00:4876  AF                      xor a
    1553   00:4877  B2                      or  d                           ; Counter has any digit?
    1554   00:4878  CA 42 48                jp  z,INPUT_TIMEOUT             ; Nope, so just continue
    1555   00:487B  15                      dec d                           ; Decrement counter
    1556   00:487C  DD 2B                   dec ix                          ; Decrement pointer
    1557   00:487E  3E 08                   ld  a,8                         ; Backspace
    1558   00:4880  CD A2 00                call    CHPUT                   ; Print it
    1559   00:4883  3E 20                   ld  a,' '                       ; Space
    1560   00:4885  CD A2 00                call    CHPUT                   ; Print it
    1561   00:4888  3E 08                   ld  a,8                         ; Backspace
    1562   00:488A  CD A2 00                call    CHPUT                   ; Print it
    1563   00:488D  C3 42 48                jp  INPUT_TIMEOUT               ; Return
    1564   00:4890                      
    1565   00:4890                      SET_WIFI_CHECK_INPUT:
    1566   00:4890  AF                      xor a
    1567   00:4891  B2                      or  d                           ; Counter has any digits
    1568   00:4892  CA 42 48                jp  z,INPUT_TIMEOUT             ; Nope, so just continue
    1569   00:4895                          ; IX is pointing one position after last digit, so revert
    1570   00:4895  DD 2B                   dec ix
    1571   00:4897  DD 7E 00                ld  a,(ix+0)                    ; Digit in A
    1572   00:489A  D6 30                   sub '0'                         ; Convert it to decimal
    1573   00:489C  26 00                   ld  h,0                         ; First digit, so H is 0
    1574   00:489E  6F                      ld  l,a                         ; And L has the digit
    1575   00:489F  15                      dec d                           ; If digits finished, just set
    1576   00:48A0  CA CC 48                jp  z,SET_WIFI_EXECUTE_SET_COMMAND
    1577   00:48A3  DD 2B                   dec ix
    1578   00:48A5  DD 7E 00                ld  a,(ix+0)                    ; Digit in A
    1579   00:48A8  D6 30                   sub '0'                         ; Convert it to decimal
    1580   00:48AA  87                      add a,a                         ; A*2
    1581   00:48AB  4F                      ld  c,a                         ; A*2 in C
    1582   00:48AC  87                      add a,a                         ; A*4
    1583   00:48AD  87                      add a,a                         ; A*8
    1584   00:48AE  81                      add a,c                         ; A*10
    1585   00:48AF                          ; Up to here, we can get 90 + 9, 99, won't go to H anyway, just add to L
    1586   00:48AF  85                      add a,l                         ; L has the first digit
    1587   00:48B0  6F                      ld  l,a                         ; And now L has the two digits
    1588   00:48B1  15                      dec d                           ; If digits finished, just set
    1589   00:48B2  CA CC 48                jp  z,SET_WIFI_EXECUTE_SET_COMMAND
    1590   00:48B5  DD 2B                   dec ix
    1591   00:48B7  DD 7E 00                ld  a,(ix+0)                    ; Digit in A
    1592   00:48BA  D6 30                   sub '0'                         ; Convert it to decimal
    1593   00:48BC  87                      add a,a                         ; A*2
    1594   00:48BD  4F                      ld  c,a                         ; A*2 in C
    1595   00:48BE  87                      add a,a                         ; A*4
    1596   00:48BF  87                      add a,a                         ; A*8
    1597   00:48C0  81                      add a,c                         ; A*10
    1598   00:48C1  EB                      ex  de,hl                       ; Get the two digits results in de
    1599   00:48C2  6F                      ld  l,a
    1600   00:48C3  26 00                   ld  h,0                         ; HL = A*10
    1601   00:48C5  29                      add hl,hl                       ; HL = A*20
    1602   00:48C6  4D                      ld  c,l
    1603   00:48C7  44                      ld  b,h                         ; BC = A*20
    1604   00:48C8  29                      add hl,hl                       ; HL = A*40
    1605   00:48C9  29                      add hl,hl                       ; HL = A*80
    1606   00:48CA  09                      add hl,bc                       ; HL = A*100
    1607   00:48CB  19                      add hl,de                       ; HL = three digits result
    1608   00:48CC                          ; This was the last digit, up to three
    1609   00:48CC                      SET_WIFI_EXECUTE_SET_COMMAND:
    1610   00:48CC  C3 1E 49                jp  SET_ESP_WIFI_TIMEOUT        ; And set and done
    1611   00:48CF                      
