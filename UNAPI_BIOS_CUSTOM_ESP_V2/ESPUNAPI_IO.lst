    5489   00:5B24  20 EF                   jr  nz,TCPIP_TCP_RCV_ST1
    5490   00:5B26                          ; At this point, all data is being buffered, so 15 ticks, quarter second, is more than enough time-out
    5491   00:5B26  F3                      di
    5492   00:5B27  21 1E 00                ld  hl,30
    5493   00:5B2A  CD F4 5E                call    SETCOUNTER
