    4251   00:557C                      ;========================
    4252   00:557C                      ;===     SSH_OPEN     ===
    4253   00:557C                      ;========================
    4254   00:557C                      ;Open a SSH connection.
    4255   00:557C                      ;
    4256   00:557C                      ;Input:  A  = 2
    4257   00:557C                      ;        HL = Address of parameters block
    4258   00:557C                      ;Output: A = Error code
    4259   00:557C                      ;        B = Connection number
    4260   00:557C                      ;
    4261   00:557C                      ;Parameters block format:
    4262   00:557C                      ;
    4263   00:557C                      ;+0 (4): Remote IP address (0.0.0.0 for unspecified remote socket)
    4264   00:557C                      ;+4 (2): Remote port (ignored if unspecified remote socket)
    4265   00:557C                      ;+6 (1): Subsystem
    4266   00:557C                      ;+7 (1): Flags
    4267   00:557C                      ;+8 (variable): username (0 terminated) and then password or public key (0 terminated)
    4268   00:557C                      ;
    4269   00:557C                      ;Parameter block MUST have at least 32 bytes available if doing host key verification
    4270   00:557C                      ;as unknown host key hash will be returned in it
    4271   00:557C                      
    4272   00:557C                      SSH_OPEN:
    4273   00:557C  E5                      push    hl                      ; save param block address
    4274   00:557D  3E 08                   ld  a,8
    4275   00:557F  85                      add a,l
    4276   00:5580  6F                      ld  l,a
    4277   00:5581  30 01                   jr  nc,SSH_OPEN_1
    4278   00:5583  24                      inc h
    4279   00:5584                      SSH_OPEN_1:
    4280   00:5584                          ; let's check how many bytes there are
    4281   00:5584  11 08 00                ld  de,8                        ; Start with 8, all params except username and password
    4282   00:5587                      SSH_OPEN_CHECK_USER:
    4283   00:5587  7E                      ld  a,(hl)
    4284   00:5588  13                      inc de                          ; Increase size count
    4285   00:5589  23                      inc hl                          ; And next byte
    4286   00:558A  B7                      or  a                           ; If zero, user terminated
    4287   00:558B                          ; Loop until terminator (0) is found
    4288   00:558B  C2 87 55                jp  nz,SSH_OPEN_CHECK_USER
    4289   00:558E                      SSH_OPEN_CHECK_PASS:
    4290   00:558E  7E                      ld  a,(hl)
    4291   00:558F  13                      inc de                          ; Increase size count
    4292   00:5590  23                      inc hl                          ; And next byte
    4293   00:5591  B7                      or  a                           ; If zero, password terminated
    4294   00:5592                          ; Loop until terminator (0) is found
    4295   00:5592  C2 8E 55                jp  nz,SSH_OPEN_CHECK_PASS
    4296   00:5595                      
    4297   00:5595                      SSH_OPEN_SENDCMD:
    4298   00:5595                          ; Ok, so, DE has the full data size, let's start sending from here
    4299   00:5595  3E 82                   ld  a,#82                       ; Function SSH OPEN
    4300   00:5597                          SEND_DATA                       ; Send the command
    4300   00:5597  D3 07             >     out (OUT_TX_PORT),a
    4301   00:5599  7A                      ld  a,d
    4302   00:559A                          SEND_DATA                       ; Send the command size msb
    4302   00:559A  D3 07             >     out (OUT_TX_PORT),a
    4303   00:559C  7B                      ld  a,e
    4304   00:559D                          SEND_DATA                       ; Send the command size lsb
    4304   00:559D  D3 07             >     out (OUT_TX_PORT),a
    4305   00:559F  E1                      pop hl                          ; Restore the memory address for the parameters
    4306   00:55A0  E5                      push    hl                      ; we might need it later
    4307   00:55A1                      ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    4308   00:55A1  43                      ld  b,e                         ; Number of loops originaly in DE
    4309   00:55A2  1B                      dec de
    4310   00:55A3  14                      inc d
    4311   00:55A4                          if USE_MEM_IO = 0
    4312   00:55A4  0E 07                   ld  c,OUT_TX_PORT
    4313   00:55A6                      SSH_OPEN_SENDDATA:
    4314   00:55A6  ED A3                   outi
    4315   00:55A8  20 FC                   jr  nz,SSH_OPEN_SENDDATA
    4316   00:55AA                          else
    4317   00:55AA                    ~ SSH_OPEN_SENDDATA:
    4318   00:55AA                    ~     ld  a,(hl)
    4319   00:55AA                    ~     ld  (MEM_OUT_TX_PORT),a
    4320   00:55AA                    ~     inc hl
    4321   00:55AA                    ~     djnz SSH_OPEN_SENDDATA
    4322   00:55AA                    ~     endif
    4323   00:55AA  15                      dec d
    4324   00:55AB  20 F9                   jr  nz,SSH_OPEN_SENDDATA
    4325   00:55AD                          ; Now wait up to 3600 (1 minute @ 60Hz) ticks to get response
    4326   00:55AD  21 10 0E                ld  hl,3600
    4327   00:55B0  CD EC 5E                call    SETCOUNTER
    4328   00:55B3                      SSH_OPEN_ST1:
    4329   00:55B3                          CHECK_DATA
    4329   00:55B3  DB 07             >     in  a,(IN_STS_PORT)
    4329   00:55B5  CB 47             >     bit 0,a
    4330   00:55B7  20 05                   jr  nz,SSH_OPEN_ST1.1
    4331   00:55B9  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4332   00:55BC  18 F5                   jr  SSH_OPEN_ST1
    4333   00:55BE                      SSH_OPEN_ST1.1:
    4334   00:55BE                          ; nz, check the data
    4335   00:55BE                          RECEIVE_DATA
    4335   00:55BE  DB 06             >     in a,(IN_DATA_PORT)
    4336   00:55C0  FE 82                   cp  #82                         ; Is response of our command?
    4337   00:55C2  20 EF                   jr  nz,SSH_OPEN_ST1
    4338   00:55C4                          ; now get return code, if return code other than 0, it is finished
