    3883   00:53FD                      
    3884   00:53FD                          ; save the received data in memory
    3885   00:53FD  CD 61 5F                call    REGBACKUP               ; Save the data received so far, registers will change
    3886   00:5400                          ; will start moving at RCV_ADDRESS that was stored in our WORD
    3887   00:5400  CD 22 5F                call    GETWORD
    3888   00:5403                          ; size goes to DE
    3889   00:5403  50                      ld  d,b
    3890   00:5404  59                      ld  e,c
    3891   00:5405                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use ini :-D
    3892   00:5405  43                      ld  b,e                         ; Number of loops originaly in DE
    3893   00:5406  1B                      dec de
    3894   00:5407  14                      inc d
    3895   00:5408                          if USE_MEM_IO = 0
    3896   00:5408  0E 06                   ld  c,IN_DATA_PORT
    3897   00:540A                          endif
    3898   00:540A                          CHECK_QUICK_RECEIVE
    3898   00:540A  DB 07             >     in  a,(IN_STS_PORT)
    3898   00:540C  CB 5F             >     bit 3,a
    3899   00:540E  28 11                   jr  z,TCPIP_UDP_RCV_R_NSF       ; If not, go to the old, slower route
    3900   00:5410                          ; Otherwise, let's speed it up baby!
    3901   00:5410                      TCPIP_UDP_RCV_R:
    3902   00:5410                          if USE_MEM_IO = 0
    3903   00:5410  ED B2                   inir
