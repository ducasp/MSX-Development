    5408   00:5AB5                      ; Save registers other than AF
    5409   00:5AB5                      TCPIP_TCP_RCV_CHECK_TIME_OUT:
    5410   00:5AB5  C5                      push bc
    5411   00:5AB6  D5                      push de
    5412   00:5AB7  E5                      push hl
    5413   00:5AB8  CD E5 5E                call    GETCOUNTER
    5414   00:5ABB  7D                      ld  a,l
    5415   00:5ABC  B4                      or  h
    5416   00:5ABD                          ; Restore registers, we are returning
    5417   00:5ABD  E1                      pop hl
    5418   00:5ABE  D1                      pop de
    5419   00:5ABF  C1                      pop bc
    5420   00:5AC0  C0                      ret nz
    5421   00:5AC1                          ; Ok, timeout...
    5422   00:5AC1  F1                      pop af                          ; Get return address of who called this out of the stack, we will return from the function or re-start
