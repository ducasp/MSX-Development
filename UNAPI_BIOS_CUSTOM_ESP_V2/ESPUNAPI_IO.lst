    3009   00:5007  05                      dec b
    3010   00:5008  20 F0                   jr  nz,TCPIP_GET_IPINFO_ST2
    3011   00:500A                      
    3012   00:500A                          ; now just get the 4 bytes IP and order it in L, H, E and D
