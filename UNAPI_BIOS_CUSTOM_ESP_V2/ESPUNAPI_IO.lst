    5701   00:5C47                      ;========================
    5702   00:5C47                      ;=== SSH_AUTH_RESPOND ===
    5703   00:5C47                      ;========================
    5704   00:5C47                      ;Respond auth data requested for SSH connection.
    5705   00:5C47                      ;
    5706   00:5C47                      ;Input:  A  = 10
    5707   00:5C47                      ;        B  = Connection number
    5708   00:5C47                      ;        DE = Address of the data to be sent
    5709   00:5C47                      ;        HL = Length of the data to be sent
    5710   00:5C47                      ;Output: A  = Error code
    5711   00:5C47                      SSH_AUTH_RESPOND:
    5712   00:5C47  CB FF                   set 7,a                         ; ESP SSH commands start at #80
    5713   00:5C49                          SEND_DATA                       ; Send the command
    5713   00:5C49  D3 07             >     out (OUT_TX_PORT),a
    5714   00:5C4B                          ; prepare new data size, adding our 1 byte overhead (connection #)
    5715   00:5C4B  23                      inc hl
    5716   00:5C4C  7C                      ld  a,h
    5717   00:5C4D                          SEND_DATA                       ; Send the command size msb
    5717   00:5C4D  D3 07             >     out (OUT_TX_PORT),a
    5718   00:5C4F  7D                      ld  a,l
    5719   00:5C50                          SEND_DATA                       ; Send the command size lsb
    5719   00:5C50  D3 07             >     out (OUT_TX_PORT),a
    5720   00:5C52  78                      ld  a,b
    5721   00:5C53                          SEND_DATA                       ; Send the connection #
    5721   00:5C53  D3 07             >     out (OUT_TX_PORT),a
    5722   00:5C55  2B                      dec hl
    5723   00:5C56  EB                      ex  de,hl
    5724   00:5C57                          ; now oti the data starting at hl, size is in DE
    5725   00:5C57                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    5726   00:5C57  43                      ld  b,e                         ;Number of loops originaly in DE
    5727   00:5C58  1B                      dec de
    5728   00:5C59  14                      inc d
    5729   00:5C5A                          if USE_MEM_IO = 0
    5730   00:5C5A  0E 07                   ld  c,OUT_TX_PORT
    5731   00:5C5C                      SSH_AUTH_RESPOND_R:
    5732   00:5C5C  ED A3                   outi
    5733   00:5C5E  20 FC                   jr  nz,SSH_AUTH_RESPOND_R
    5734   00:5C60                          else
    5735   00:5C60                    ~ SSH_AUTH_RESPOND_R:
    5736   00:5C60                    ~     ld  a,(hl)
    5737   00:5C60                    ~     ld  (MEM_OUT_TX_PORT),a
    5738   00:5C60                    ~     inc hl
    5739   00:5C60                    ~     djnz SSH_AUTH_RESPOND_R
    5740   00:5C60                    ~     endif
    5741   00:5C60  15                      dec d
    5742   00:5C61  20 F9                   jr  nz,SSH_AUTH_RESPOND_R
    5743   00:5C63                      
    5744   00:5C63                          ; Now wait up to 600 ticks to get response
    5745   00:5C63  21 58 02                ld  hl,600
    5746   00:5C66  CD DF 60                call    SETCOUNTER
    5747   00:5C69                      SSH_AUTH_RESPOND_ST1:
    5748   00:5C69                          CHECK_DATA
    5748   00:5C69  DB 07             >     in  a,(IN_STS_PORT)
    5748   00:5C6B  CB 47             >     bit 0,a
    5749   00:5C6D  20 05                   jr  nz,SSH_AUTH_RESPOND_R.1
    5750   00:5C6F  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5751   00:5C72  18 F5                   jr  SSH_AUTH_RESPOND_ST1
    5752   00:5C74                      SSH_AUTH_RESPOND_R.1:
    5753   00:5C74                          ; nz, check the data
    5754   00:5C74                          RECEIVE_DATA
    5754   00:5C74  DB 06             >     in a,(IN_DATA_PORT)
    5755   00:5C76  FE 8A                   cp  #8A                         ; Is response of our command?
    5756   00:5C78  20 EF                   jr  nz,SSH_AUTH_RESPOND_ST1
    5757   00:5C7A                          ; now get return code, if return code other than 0, it is finished
    5758   00:5C7A                      SSH_AUTH_RESPOND_RC:
    5759   00:5C7A                          CHECK_DATA
    5759   00:5C7A  DB 07             >     in  a,(IN_STS_PORT)
    5759   00:5C7C  CB 47             >     bit 0,a
    5760   00:5C7E  20 05                   jr  nz,SSH_AUTH_RESPOND_RC.1
    5761   00:5C80  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5762   00:5C83  18 F5                   jr  SSH_AUTH_RESPOND_RC
    5763   00:5C85                      SSH_AUTH_RESPOND_RC.1:
    5764   00:5C85                          ; nz, discard
    5765   00:5C85                          RECEIVE_DATA
    5765   00:5C85  DB 06             >     in a,(IN_DATA_PORT)
    5766   00:5C87  B7                      or  a                           ; 0?
    5767   00:5C88  C0                      ret nz                          ; if not, done
    5768   00:5C89                      
    5769   00:5C89                          ; next two bytes are return code and size bytes, don't care, it is 0
    5770   00:5C89  06 02                   ld  b,2
    5771   00:5C8B                      SSH_AUTH_RESPOND_ST2:
    5772   00:5C8B                          CHECK_DATA
    5772   00:5C8B  DB 07             >     in  a,(IN_STS_PORT)
    5772   00:5C8D  CB 47             >     bit 0,a
    5773   00:5C8F  20 05                   jr  nz,SSH_AUTH_RESPOND_ST2.1
    5774   00:5C91  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5775   00:5C94  18 F5                   jr  SSH_AUTH_RESPOND_ST2
    5776   00:5C96                      SSH_AUTH_RESPOND_ST2.1:
    5777   00:5C96                          ; nz, discard
    5778   00:5C96                          RECEIVE_DATA
    5778   00:5C96  DB 06             >     in a,(IN_DATA_PORT)
    5779   00:5C98  05                      dec b
    5780   00:5C99  20 F0                   jr  nz,SSH_AUTH_RESPOND_ST2
    5781   00:5C9B                      
    5782   00:5C9B                          ; done, no return data other than return code
    5783   00:5C9B  AF                      xor a
    5784   00:5C9C  C9                      ret
    5785   00:5C9D                      
    5786   00:5C9D                      ;=======================
    5787   00:5C9D                      ;===  TCPIP_TCP_RCV  ===
    5788   00:5C9D                      ;=======================
    5789   00:5C9D                      ;Receive data from a TCP connection.
    5790   00:5C9D                      ;
    5791   00:5C9D                      ;Input:   A  = 18
    5792   00:5C9D                      ;         B  = Connection number
    5793   00:5C9D                      ;         DE = Address for the retrieved data
    5794   00:5C9D                      ;         HL = Length of the data to be obtained
    5795   00:5C9D                      ;Output:  A  = Error code
    5796   00:5C9D                      ;         BC = Total number of bytes that have been actually retrieved
    5797   00:5C9D                      ;         HL = Number of urgent data bytes that have been retrieved
    5798   00:5C9D                      ;              (placed at the beginning of the received data block)
    5799   00:5C9D                      ; Save registers other than AF
    5800   00:5C9D                      TCPIP_TCP_RCV_CHECK_TIME_OUT:
    5801   00:5C9D  C5                      push bc
    5802   00:5C9E  D5                      push de
    5803   00:5C9F  E5                      push hl
    5804   00:5CA0  CD D0 60                call    GETCOUNTER
    5805   00:5CA3  7D                      ld  a,l
    5806   00:5CA4  B4                      or  h
    5807   00:5CA5                          ; Restore registers, we are returning
    5808   00:5CA5  E1                      pop hl
    5809   00:5CA6  D1                      pop de
    5810   00:5CA7  C1                      pop bc
    5811   00:5CA8  C0                      ret nz
    5812   00:5CA9                          ; Ok, timeout...
    5813   00:5CA9  F1                      pop af                          ; Get return address of who called this out of the stack, we will return from the function or re-start
    5814   00:5CAA                      TCPIP_TCP_RCV_RETRY_QRCV:
    5815   00:5CAA  CD EF 60                call    GETBYTE
    5816   00:5CAD  B7                      or  a
    5817   00:5CAE  28 0B                   jr  z,TCPIP_TCP_RCV_CHECK_TIME_OUT.NORXRETRY
    5818   00:5CB0                          ; Ok, so let's ask ESP to re-send the data and retry receiving it
    5819   00:5CB0  3D                      dec a
    5820   00:5CB1  CD 01 61                call    SETBYTE                 ; we are retrying it
    5821   00:5CB4  3E 72                   ld  a,'r'                       ; retry transmission command
    5822   00:5CB6                          SEND_DATA
    5822   00:5CB6  D3 07             >     out (OUT_TX_PORT),a
    5823   00:5CB8  C3 F7 5C                jp  TCPIP_TCP_RCV.RXRETRY       ; and retry it
    5824   00:5CBB                      TCPIP_TCP_RCV_CHECK_TIME_OUT.NORXRETRY:
    5825   00:5CBB  3E 0F                   ld  a,ERR_INV_OPER
    5826   00:5CBD  C9                      ret                             ; and return the function itself
    5827   00:5CBE                      
    5828   00:5CBE                      TCPIP_TCP_RCV_RET_ERR:
    5829   00:5CBE                          ; next two bytes are size bytes, don't care
    5830   00:5CBE  47                      ld  b,a                         ; save error in b
    5831   00:5CBF  0E 02                   ld  c,2
    5832   00:5CC1                      TCPIP_TCP_RCV_RET_ERR2:
    5833   00:5CC1                          CHECK_DATA
    5833   00:5CC1  DB 07             >     in  a,(IN_STS_PORT)
    5833   00:5CC3  CB 47             >     bit 0,a
    5834   00:5CC5  20 05                   jr  nz,TCPIP_TCP_RCV_RET_ERR2.1
    5835   00:5CC7  CD 9D 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5836   00:5CCA  18 F5                   jr  TCPIP_TCP_RCV_RET_ERR2
    5837   00:5CCC                      TCPIP_TCP_RCV_RET_ERR2.1:
    5838   00:5CCC                          ; nz, discard
    5839   00:5CCC                          RECEIVE_DATA
    5839   00:5CCC  DB 06             >     in a,(IN_DATA_PORT)
    5840   00:5CCE  0D                      dec c
    5841   00:5CCF  20 F0                   jr  nz,TCPIP_TCP_RCV_RET_ERR2
    5842   00:5CD1                          ; now return w/ error that is saved in b
    5843   00:5CD1  78                      ld  a,b
    5844   00:5CD2                      TCPIP_TCP_RCV_RET_NODATA:
    5845   00:5CD2  21 00 00                ld  hl,0
    5846   00:5CD5  01 00 00                ld  bc,0
    5847   00:5CD8  C9                      ret
    5848   00:5CD9                      
    5849   00:5CD9                      TCPIP_TCP_RCV:
    5850   00:5CD9  EB                      ex  de,hl
    5851   00:5CDA  CD 28 61                call    SETWORD
    5852   00:5CDD  EB                      ex  de,hl
    5853   00:5CDE  3E 12                   ld  a,18
    5854   00:5CE0                          SEND_DATA                       ; Send the command
    5854   00:5CE0  D3 07             >     out (OUT_TX_PORT),a
    5855   00:5CE2  AF                      xor a
    5856   00:5CE3                          SEND_DATA                       ; Send the command size msb
    5856   00:5CE3  D3 07             >     out (OUT_TX_PORT),a
    5857   00:5CE5  3E 03                   ld  a,3
    5858   00:5CE7                          SEND_DATA                       ; Send the command size lsb
    5858   00:5CE7  D3 07             >     out (OUT_TX_PORT),a
    5859   00:5CE9  78                      ld  a,b
    5860   00:5CEA                          SEND_DATA                       ; Send the connection #
    5860   00:5CEA  D3 07             >     out (OUT_TX_PORT),a
    5861   00:5CEC  7D                      ld  a,l
    5862   00:5CED                          SEND_DATA                       ; Send MAX rcv size LSB
    5862   00:5CED  D3 07             >     out (OUT_TX_PORT),a
    5863   00:5CEF  7C                      ld  a,h
    5864   00:5CF0                          SEND_DATA                       ; Send MAX rcv size MSB
    5864   00:5CF0  D3 07             >     out (OUT_TX_PORT),a
    5865   00:5CF2  3E 03                   ld  a,3
    5866   00:5CF4  CD 01 61                call    SETBYTE                 ; Ok, retry up to three times
    5867   00:5CF7                      TCPIP_TCP_RCV.RXRETRY:
    5868   00:5CF7                          ; Now wait up to 600 ticks to get response
    5869   00:5CF7  21 58 02                ld  hl,600
    5870   00:5CFA  CD DF 60                call    SETCOUNTER
    5871   00:5CFD                      TCPIP_TCP_RCV_ST1:
    5872   00:5CFD                          CHECK_DATA
    5872   00:5CFD  DB 07             >     in  a,(IN_STS_PORT)
    5872   00:5CFF  CB 47             >     bit 0,a
    5873   00:5D01  20 05                   jr  nz,TCPIP_TCP_RCV_ST1.1
    5874   00:5D03  CD 9D 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5875   00:5D06  18 F5                   jr  TCPIP_TCP_RCV_ST1
    5876   00:5D08                      TCPIP_TCP_RCV_ST1.1:
    5877   00:5D08                          ; nz, check the data
    5878   00:5D08                          RECEIVE_DATA
    5878   00:5D08  DB 06             >     in a,(IN_DATA_PORT)
    5879   00:5D0A  FE 12                   cp 18                           ; Is response of our command?
    5880   00:5D0C  20 EF                   jr  nz,TCPIP_TCP_RCV_ST1
    5881   00:5D0E                          ; At this point, all data is being buffered, so 15 ticks, quarter second, is more than enough time-out
    5882   00:5D0E  F3                      di
    5883   00:5D0F  21 1E 00                ld  hl,30
    5884   00:5D12  CD DF 60                call    SETCOUNTER
    5885   00:5D15  FB                      ei
    5886   00:5D16                          ; now get return code, if return code other than 0, it is finished
    5887   00:5D16                      TCPIP_TCP_RCV_RC:
    5888   00:5D16                          CHECK_DATA
    5888   00:5D16  DB 07             >     in  a,(IN_STS_PORT)
    5888   00:5D18  CB 47             >     bit 0,a
    5889   00:5D1A  20 05                   jr  nz,TCPIP_TCP_RCV_RC.1
    5890   00:5D1C  CD 9D 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5891   00:5D1F  18 F5                   jr  TCPIP_TCP_RCV_RC
    5892   00:5D21                      TCPIP_TCP_RCV_RC.1:
    5893   00:5D21                          ; nz, discard
    5894   00:5D21                          RECEIVE_DATA
    5894   00:5D21  DB 06             >     in a,(IN_DATA_PORT)
    5895   00:5D23  B7                      or  a                           ; 0?
    5896   00:5D24  20 98                   jr  nz,TCPIP_TCP_RCV_RET_ERR    ; if not, done
    5897   00:5D26                          ; next two bytes are response size bytes (UB count two bytes, always 0, and data read), save it -2 to BC
    5898   00:5D26                      TCPIP_TCP_RCV_ST2A:
    5899   00:5D26                          CHECK_DATA
    5899   00:5D26  DB 07             >     in  a,(IN_STS_PORT)
    5899   00:5D28  CB 47             >     bit 0,a
    5900   00:5D2A  20 05                   jr  nz,TCPIP_TCP_RCV_ST2A.1
    5901   00:5D2C  CD 9D 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5902   00:5D2F  18 F5                   jr  TCPIP_TCP_RCV_ST2A
    5903   00:5D31                      TCPIP_TCP_RCV_ST2A.1:
    5904   00:5D31                          ; nz, high byte count of bytes to receive
    5905   00:5D31                          RECEIVE_DATA
    5905   00:5D31  DB 06             >     in a,(IN_DATA_PORT)
    5906   00:5D33  67                      ld h,a
    5907   00:5D34                      TCPIP_TCP_RCV_ST2B:
    5908   00:5D34                          CHECK_DATA
    5908   00:5D34  DB 07             >     in  a,(IN_STS_PORT)
    5908   00:5D36  CB 47             >     bit 0,a
    5909   00:5D38  20 05                   jr  nz,TCPIP_TCP_RCV_ST2B.1
    5910   00:5D3A  CD 9D 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5911   00:5D3D  18 F5                   jr  TCPIP_TCP_RCV_ST2B
    5912   00:5D3F                      TCPIP_TCP_RCV_ST2B.1:
    5913   00:5D3F                          ; nz, low byte count of bytes to receive
    5914   00:5D3F                          RECEIVE_DATA
    5914   00:5D3F  DB 06             >     in a,(IN_DATA_PORT)
    5915   00:5D41  6F                      ld  l,a
    5916   00:5D42  01 02 00                ld  bc,2
    5917   00:5D45                          ; subtract 2 (Urgent data count, not used)
    5918   00:5D45  AF                      xor a                           ; zero carry
    5919   00:5D46  ED 42                   sbc hl,bc
    5920   00:5D48                          ; if it was 0, will carry
    5921   00:5D48                          if USE_MEM_IO = 1
    5922   00:5D48                    ~     jp  c,TCPIP_TCP_RCV_RET_NODATA
    5923   00:5D48                    ~     else
    5924   00:5D48  38 88                   jr  c,TCPIP_TCP_RCV_RET_NODATA
    5925   00:5D4A                          endif
    5926   00:5D4A  4D                      ld  c,l
    5927   00:5D4B  44                      ld  b,h                         ; BC has effective received data size, as well as HL
    5928   00:5D4C                      
    5929   00:5D4C                          ; now just discard 2 bytes urgent data
    5930   00:5D4C                      TCPIP_TCP_RCV_UDC_ST1:
    5931   00:5D4C                          CHECK_DATA
    5931   00:5D4C  DB 07             >     in  a,(IN_STS_PORT)
    5931   00:5D4E  CB 47             >     bit 0,a
    5932   00:5D50  20 05                   jr  nz,TCPIP_TCP_RCV_UDC_ST1.1
    5933   00:5D52  CD 9D 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5934   00:5D55  18 F5                   jr  TCPIP_TCP_RCV_UDC_ST1
    5935   00:5D57                      TCPIP_TCP_RCV_UDC_ST1.1:
    5936   00:5D57                          ; nz, get it
    5937   00:5D57                          RECEIVE_DATA
    5937   00:5D57  DB 06             >     in a,(IN_DATA_PORT)
    5938   00:5D59                      TCPIP_TCP_RCV_UDC_ST2:
    5939   00:5D59                          CHECK_DATA
    5939   00:5D59  DB 07             >     in  a,(IN_STS_PORT)
    5939   00:5D5B  CB 47             >     bit 0,a
    5940   00:5D5D  20 05                   jr  nz,TCPIP_TCP_RCV_UDC_ST2.1
    5941   00:5D5F  CD 9D 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5942   00:5D62  18 F5                   jr  TCPIP_TCP_RCV_UDC_ST2
    5943   00:5D64                      TCPIP_TCP_RCV_UDC_ST2.1:
    5944   00:5D64                          ; nz, get it
    5945   00:5D64                          RECEIVE_DATA
    5945   00:5D64  DB 06             >     in a,(IN_DATA_PORT)
    5946   00:5D66                      
    5947   00:5D66                          ; put effective data size in de
    5948   00:5D66  EB                      ex  de,hl
    5949   00:5D67                          ; will start moving at address in stack (we've pushed the adress in WORD)
    5950   00:5D67  CD 15 61                call    GETWORD
    5951   00:5D6A  CD 88 61                call    BCBACKUP                ; save count (BC)
    5952   00:5D6D                      
    5953   00:5D6D                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use ini :-D
    5954   00:5D6D  43                      ld  b,e                         ; Number of loops originaly in DE
    5955   00:5D6E  1B                      dec de
    5956   00:5D6F  14                      inc d
    5957   00:5D70                          if USE_MEM_IO = 0
    5958   00:5D70  0E 06                   ld  c,IN_DATA_PORT
    5959   00:5D72                          CHECK_QUICK_RECEIVE
    5959   00:5D72  3A 07 00          >     ld  a,(IN_STS_PORT)
    5959   00:5D75  CB 5F             >     bit 3,a
    5960   00:5D77  28 14                   jr  z,TCPIP_TCP_RCV_R_NSF       ; If not, go to the old, slower route
    5961   00:5D79                          ; Otherwise, let's speed it up baby!
    5962   00:5D79                      TCPIP_TCP_RCV_R:
    5963   00:5D79  ED B2                   inir
    5964   00:5D7B                          else
    5965   00:5D7B                    ~     CHECK_QUICK_RECEIVE
    5966   00:5D7B                    ~     jr  z,TCPIP_TCP_RCV_R_NSF       ; If not, go to the old, slower route
    5967   00:5D7B                    ~     ; Otherwise, let's speed it up baby!
    5968   00:5D7B                    ~ TCPIP_TCP_RCV_R:
    5969   00:5D7B                    ~     ld  a,(MEM_IN_DATA_PORT)
    5970   00:5D7B                    ~     ld  (hl),a
    5971   00:5D7B                    ~     inc hl
    5972   00:5D7B                    ~     djnz TCPIP_TCP_RCV_R
    5973   00:5D7B                    ~     endif
    5974   00:5D7B  15                      dec d
