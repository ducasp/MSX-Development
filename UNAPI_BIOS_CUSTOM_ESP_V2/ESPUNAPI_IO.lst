    3104   00:5087  20 F0                   jr  nz,TCPIP_NET_STATE_ST2
    3105   00:5089                      
    3106   00:5089                          ; now just get the 1 byte (NET STATE) IP and place it in B
    3107   00:5089                      TCPIP_NET_STATE_NS_ST1:
    3108   00:5089                          CHECK_DATA
    3108   00:5089  DB 07             >     in  a,(IN_STS_PORT)
    3108   00:508B  CB 47             >     bit 0,a
    3109   00:508D  20 05                   jr  nz,TCPIP_NET_STATE_NS_ST1.1
    3110   00:508F  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3111   00:5092  18 F5                   jr  TCPIP_NET_STATE_NS_ST1
    3112   00:5094                      TCPIP_NET_STATE_NS_ST1.1:
