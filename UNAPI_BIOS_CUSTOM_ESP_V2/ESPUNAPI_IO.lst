    1665   00:4924  3E 0D                   ld  a,#0d
    1666   00:4926  CD A2 00                call    CHPUT
    1667   00:4929  3E 0A                   ld  a,#0a
    1668   00:492B  CD A2 00                call    CHPUT
    1669   00:492E  21 03 6E                ld  hl,STR_SENDING              ; Indicate it is sending a command
    1670   00:4931  CD 4C 4C                call    PRINTHL
    1671   00:4934                          CLEAR_UART
    1671   00:4934  3E 14             >     ld  a,20
    1671   00:4936  D3 06             >     out (OUT_CMD_PORT),a
