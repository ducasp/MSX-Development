    5393   00:5AAD                      ;=======================
    5394   00:5AAD                      ;===  TCPIP_TCP_RCV  ===
    5395   00:5AAD                      ;=======================
    5396   00:5AAD                      ;Receive data from a TCP connection.
    5397   00:5AAD                      ;
    5398   00:5AAD                      ;Input:   A  = 18
    5399   00:5AAD                      ;         B  = Connection number
    5400   00:5AAD                      ;         DE = Address for the retrieved data
    5401   00:5AAD                      ;         HL = Length of the data to be obtained
