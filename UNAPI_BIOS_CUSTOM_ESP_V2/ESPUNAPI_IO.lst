    1665   00:492B                      SET_ESP_WIFI_TIMEOUT:
    1666   00:492B  EB                      ex  de,hl
    1667   00:492C  3E 0D                   ld  a,#0d
    1668   00:492E  CD A2 00                call    CHPUT
    1669   00:4931  3E 0A                   ld  a,#0a
    1670   00:4933  CD A2 00                call    CHPUT
    1671   00:4936  21 0B 6E                ld  hl,STR_SENDING              ; Indicate it is sending a command
    1672   00:4939  CD 54 4C                call    PRINTHL
    1673   00:493C                          CLEAR_UART
    1673   00:493C  3E 14             >     ld  a,20
    1673   00:493E  D3 06             >     out (OUT_CMD_PORT),a
    1674   00:4940  3E 54                   ld  a,CMD_TIMER_SET
    1675   00:4942                          SEND_DATA
