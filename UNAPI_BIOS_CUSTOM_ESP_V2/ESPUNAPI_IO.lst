    5781   00:5C85                      ;==============================
    5782   00:5C85                      ;=== SSH_AUTH_GET_CHALLENGE ===
    5783   00:5C85                      ;==============================
    5784   00:5C85                      ;Receive keyboard interactive challenge data from a SSH connection.
    5785   00:5C85                      ;
    5786   00:5C85                      ;Input:   A  = 9
    5787   00:5C85                      ;         B  = Connection number
    5788   00:5C85                      ;         DE = Address for the retrieved data
    5789   00:5C85                      ;         HL = Max Length of the data to be obtained
    5790   00:5C85                      ;Output:  A  = Error code
    5791   00:5C85                      ;         BC = Total number of bytes that have been actually retrieved
    5792   00:5C85                      ;         H  = Number of prompts
    5793   00:5C85                      ;         L  = Echo flag bitmap
    5794   00:5C85                      ; Save registers other than AF
    5795   00:5C85                      SSH_AUTH_GET_CHALLENGE_RETRY_QRCV:
    5796   00:5C85  CD 04 5F                call    GETBYTE
    5797   00:5C88  B7                      or  a
    5798   00:5C89  28 0B                   jr  z,SSH_AUTH_GET_CHALLENGE_CHECK_TIME_OUT.NORXRETRY
    5799   00:5C8B                          ; Ok, so let's ask ESP to re-send the data and retry receiving it
    5800   00:5C8B  3D                      dec a
    5801   00:5C8C  CD 16 5F                call    SETBYTE                 ; we are retrying it
    5802   00:5C8F  3E 72                   ld  a,'r'                       ; retry transmission command
    5803   00:5C91                          SEND_DATA
    5803   00:5C91  D3 07             >     out (OUT_TX_PORT),a
    5804   00:5C93  C3 B7 5C                jp  SSH_AUTH_GET_CHALLENGE.RXRETRY             ; and retry it
    5805   00:5C96                      SSH_AUTH_GET_CHALLENGE_CHECK_TIME_OUT.NORXRETRY:
    5806   00:5C96  3E 0F                   ld  a,ERR_INV_OPER
    5807   00:5C98  C9                      ret                             ; and return the function itself
    5808   00:5C99                      
    5809   00:5C99                      SSH_AUTH_GET_CHALLENGE:
    5810   00:5C99  EB                      ex  de,hl
    5811   00:5C9A  CD 3D 5F                call    SETWORD
    5812   00:5C9D  EB                      ex  de,hl
    5813   00:5C9E  3E 89                   ld  a,#89
    5814   00:5CA0                          SEND_DATA                       ; Send the command
    5814   00:5CA0  D3 07             >     out (OUT_TX_PORT),a
    5815   00:5CA2  AF                      xor a
    5816   00:5CA3                          SEND_DATA                       ; Send the command size msb
    5816   00:5CA3  D3 07             >     out (OUT_TX_PORT),a
    5817   00:5CA5  3E 03                   ld  a,3
    5818   00:5CA7                          SEND_DATA                       ; Send the command size lsb
    5818   00:5CA7  D3 07             >     out (OUT_TX_PORT),a
    5819   00:5CA9  78                      ld  a,b
    5820   00:5CAA                          SEND_DATA                       ; Send the connection #
    5820   00:5CAA  D3 07             >     out (OUT_TX_PORT),a
    5821   00:5CAC  7D                      ld  a,l
    5822   00:5CAD                          SEND_DATA                       ; Send MAX rcv size LSB
    5822   00:5CAD  D3 07             >     out (OUT_TX_PORT),a
    5823   00:5CAF  7C                      ld  a,h
    5824   00:5CB0                          SEND_DATA                       ; Send MAX rcv size MSB
    5824   00:5CB0  D3 07             >     out (OUT_TX_PORT),a
    5825   00:5CB2  3E 03                   ld  a,3
    5826   00:5CB4  CD 16 5F                call    SETBYTE                 ; Ok, retry up to three times
    5827   00:5CB7                      SSH_AUTH_GET_CHALLENGE.RXRETRY:
    5828   00:5CB7                          ; Now wait up to 600 ticks to get response
    5829   00:5CB7  21 58 02                ld  hl,600
    5830   00:5CBA  CD F4 5E                call    SETCOUNTER
    5831   00:5CBD                      SSH_AUTH_GET_CHALLENGE_ST1:
    5832   00:5CBD                          CHECK_DATA
    5832   00:5CBD  DB 07             >     in  a,(IN_STS_PORT)
    5832   00:5CBF  CB 47             >     bit 0,a
    5833   00:5CC1  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_ST1.1
    5834   00:5CC3  CD B5 5A                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5835   00:5CC6  18 F5                   jr  SSH_AUTH_GET_CHALLENGE_ST1
    5836   00:5CC8                      SSH_AUTH_GET_CHALLENGE_ST1.1:
    5837   00:5CC8                          ; nz, check the data
    5838   00:5CC8                          RECEIVE_DATA
    5838   00:5CC8  DB 06             >     in a,(IN_DATA_PORT)
    5839   00:5CCA  FE 89                   cp #89                          ; Is response of our command?
    5840   00:5CCC  20 EF                   jr  nz,SSH_AUTH_GET_CHALLENGE_ST1
    5841   00:5CCE                          ; At this point, all data is being buffered, so 15 ticks, quarter second, is more than enough time-out
    5842   00:5CCE  F3                      di
    5843   00:5CCF  21 1E 00                ld  hl,30
    5844   00:5CD2  CD F4 5E                call    SETCOUNTER
    5845   00:5CD5  FB                      ei
    5846   00:5CD6                          ; now get return code, if return code other than 0, it is finished
    5847   00:5CD6                      SSH_AUTH_GET_CHALLENGE_RC:
    5848   00:5CD6                          CHECK_DATA
    5848   00:5CD6  DB 07             >     in  a,(IN_STS_PORT)
    5848   00:5CD8  CB 47             >     bit 0,a
    5849   00:5CDA  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_RC.1
    5850   00:5CDC  CD B5 5A                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5851   00:5CDF  18 F5                   jr  SSH_AUTH_GET_CHALLENGE_RC
    5852   00:5CE1                      SSH_AUTH_GET_CHALLENGE_RC.1:
    5853   00:5CE1                          ; nz, discard
    5854   00:5CE1                          RECEIVE_DATA
    5854   00:5CE1  DB 06             >     in a,(IN_DATA_PORT)
    5855   00:5CE3  CD 16 5F                call    SETBYTE                 ; Save return just in case
    5856   00:5CE6  B7                      or  a                           ; 0?
    5857   00:5CE7  28 0D                   jr  z,SSH_AUTH_GET_CHALLENGE_ST2A              ; if not, done
    5858   00:5CE9  D6 0D                   sub 13                          ; 13? ERR BUFF will return the desired buffer size
    5859   00:5CEB  28 09                   jr  z,SSH_AUTH_GET_CHALLENGE_ST2A;
    5860   00:5CED  C6 0D                   add 13                          ; restore error code
    5861   00:5CEF  01 00 00                ld  bc,0                        ; no data received
    5862   00:5CF2  21 00 00                ld  hl,0
    5863   00:5CF5  C9                      ret
    5864   00:5CF6                          ; next two bytes are response size bytes save it to BC
    5865   00:5CF6                      SSH_AUTH_GET_CHALLENGE_ST2A:
    5866   00:5CF6                          CHECK_DATA
