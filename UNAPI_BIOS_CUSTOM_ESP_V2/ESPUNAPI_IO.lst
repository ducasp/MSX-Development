    1338   00:46F8                          ; Found, jump encryption byte
    1339   00:46F8  23                      inc hl
    1340   00:46F9  1D                      dec e                           ; Decrement selection, if 0 we are done
    1341   00:46FA  C2 EF 46                jp  nz,WIFI_CONNECT_AP_SRCH.1
