    5713   00:5C38                    ~     else
    5714   00:5C38  CA E2 5A                jp  z,TCPIP_TCP_RCV_RET_NODATA  ; not a typo, no need to make the same code again
    5715   00:5C3B                          endif
    5716   00:5C3B  4D                      ld  c,l
    5717   00:5C3C  44                      ld  b,h                         ; BC has effective received data size, as well as HL
