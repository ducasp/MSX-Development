    3944   00:5440                      ;========================
    3945   00:5440                      ;===  TCPIP_TCP_OPEN  ===
    3946   00:5440                      ;========================
    3947   00:5440                      ;Open a TCP connection.
    3948   00:5440                      ;
    3949   00:5440                      ;Input:  A  = 13
    3950   00:5440                      ;        HL = Address of parameters block
    3951   00:5440                      ;Output: A = Error code
    3952   00:5440                      ;        B = Connection number
    3953   00:5440                      ;        C = Connection not open reason (mostly for TLS)
    3954   00:5440                      ;
    3955   00:5440                      ;Parameters block format:
    3956   00:5440                      ;
    3957   00:5440                      ;+0 (4): Remote IP address (0.0.0.0 for unspecified remote socket)
    3958   00:5440                      ;+4 (2): Remote port (ignored if unspecified remote socket)
    3959   00:5440                      ;+6 (2): Local port, 0FFFFh for a random value
    3960   00:5440                      ;+8 (2): Suggestion for user timeout value
    3961   00:5440                      ;+10 (1): Flags:
    3962   00:5440                      ;         bit 0: Set for passive connection
    3963   00:5440                      ;         bit 1: Set for resident connection
    3964   00:5440                      ;         bit 2: Set for TLS connection
    3965   00:5440                      ;         bit 3: Set for TLS connection validating host certificate
    3966   00:5440                      ;+11 (2): If 0000 no host name validation, otherwise the hostname string address (zero terminated)
    3967   00:5440                      ;TCP_OPEN_IP1               (ix+0)
    3968   00:5440                      ;TCP_OPEN_IP2               (ix+1)
    3969   00:5440                      ;TCP_OPEN_IP3               (ix+2)
    3970   00:5440                      ;TCP_OPEN_IP4               (ix+3)
    3971   00:5440                      ;TCP_OPEN_RP                (ix+4)
    3972   00:5440                      ;TCP_OPEN_LP                (ix+6)
    3973   00:5440                      ;TCP_OPEN_TO                (ix+8)
    3974   00:5440                      ;TCP_OPEN_CMD_FLAGS         (ix+10)
    3975   00:5440                      ;TCP_OPEN_CMD_HOST_LSB      (ix+11)
    3976   00:5440                      ;TCP_OPEN_CMD_HOST_MSB      (ix+12)
    3977   00:5440                      
    3978   00:5440                      ; When no connection, let's get the reason and put in register C, as agreed
    3979   00:5440                      ; with Nestor this will be the way to go in the next UNAPI revision
    3980   00:5440                      TCPIP_TCP_OPEN_ERROR:
    3981   00:5440                          ; next two bytes are return code and size bytes, don't care, it is 1, conn close reason
    3982   00:5440  47                      ld  b,a                         ; save error in b
    3983   00:5441  0E 02                   ld  c,2
    3984   00:5443                      TCPIP_TCP_OPEN_ERROR2:
    3985   00:5443                          CHECK_DATA
    3985   00:5443  DB 07             >     in  a,(IN_STS_PORT)
    3985   00:5445  CB 47             >     bit 0,a
    3986   00:5447  20 05                   jr  nz,TCPIP_TCP_OPEN_ERROR2.1
    3987   00:5449  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3988   00:544C  18 F5                   jr  TCPIP_TCP_OPEN_ERROR2
    3989   00:544E                      TCPIP_TCP_OPEN_ERROR2.1:
    3990   00:544E                          ; nz, discard
    3991   00:544E                          RECEIVE_DATA
    3991   00:544E  DB 06             >     in a,(IN_DATA_PORT)
    3992   00:5450  0D                      dec c
    3993   00:5451  20 F0                   jr  nz,TCPIP_TCP_OPEN_ERROR2
    3994   00:5453  78                      ld  a,b
    3995   00:5454  FE 0B                   cp  ERR_NO_CONN
    3996   00:5456  20 0E                   jr  nz,TCPIP_TCP_OPEN_ERROR4    ; other errors do not have extra bytes as result
    3997   00:5458                      ; now just get the 1 byte, close reason, should go to C
    3998   00:5458                      TCPIP_TCP_OPEN_ERROR3:
    3999   00:5458                          CHECK_DATA
    3999   00:5458  DB 07             >     in  a,(IN_STS_PORT)
    3999   00:545A  CB 47             >     bit 0,a
    4000   00:545C  20 05                   jr  nz,TCPIP_TCP_OPEN_ERROR3.1
    4001   00:545E  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4002   00:5461  18 F5                   jr  TCPIP_TCP_OPEN_ERROR3
    4003   00:5463                      TCPIP_TCP_OPEN_ERROR3.1:
    4004   00:5463                          ; nz, get it
    4005   00:5463                          RECEIVE_DATA
    4005   00:5463  DB 06             >     in a,(IN_DATA_PORT)
    4006   00:5465  4F                      ld  c,a
    4007   00:5466                      TCPIP_TCP_OPEN_ERROR4:
    4008   00:5466                          ; now return w/ error that is saved in b
    4009   00:5466  78                      ld  a,b
    4010   00:5467  06 00                   ld  b,0                         ; no connection, so 0
    4011   00:5469  C9                      ret
    4012   00:546A                      
    4013   00:546A                      TCPIP_TCP_OPEN:
    4014   00:546A  E5                      push    hl                      ; save param block address
    4015   00:546B  7C                      ld  a,h
    4016   00:546C  DD 67                   ld  ixh,a
    4017   00:546E  7D                      ld  a,l
    4018   00:546F  DD 6F                   ld  ixl,a
    4019   00:5471                          ; IX now has the parameters area
    4020   00:5471                          ; most times it will be non tls, so this is the first test case
    4021   00:5471  21 0B 00                ld  hl,11
    4022   00:5474  CD 3D 5F                call    SETWORD                 ; If it is non-TLS, send 11 bytes
    4023   00:5477  DD 7E 0A                ld  a,(ix+10)                   ; TCP_OPEN_CMD_FLAGS
    4024   00:547A  CB 57                   bit 2,a
    4025   00:547C  28 5A                   jr  z,TCPIP_TCP_OPEN_NO_TLS
    4026   00:547E                      
    4027   00:547E                          ; TLS, but, do we have host name?
    4028   00:547E  21 0C 00                ld  hl,12
    4029   00:5481  CD 3D 5F                call    SETWORD                 ; If it is TLS without host name, send 12 bytes, one zero as host name suffice
    4030   00:5484  DD 6E 0B                ld  l,(ix+11)                   ; TCP_OPEN_CMD_HOST_LSB
    4031   00:5487  DD 7E 0C                ld  a,(ix+12)                   ; TCP_OPEN_CMD_HOST_MSB
    4032   00:548A  B5                      or  l
    4033   00:548B                          ; if TLS and next two bytes are 00 no host to check
    4034   00:548B  28 4B                   jr  z,TCPIP_TCP_OPEN_NO_CHECKHOST
    4035   00:548D                          ; we are here, host to check
    4036   00:548D  DD 66 0C                ld  h,(ix+12)                   ; TCP_OPEN_CMD_HOST_MSB
    4037   00:5490  D1                      pop de                          ; Retrieve parameters address
    4038   00:5491  E5                      push    hl                      ; Save host name address
    4039   00:5492  D5                      push    de                      ; Save Parameters address (so it is in the order we are going to need)
    4040   00:5493                          ; let's check how many bytes there are
    4041   00:5493  11 0B 00                ld  de,11                       ; Start with 11, all params except host name
    4042   00:5496                      TCPIP_TCP_OPEN_CHECK_HOSTOF:
    4043   00:5496  7E                      ld  a,(hl)
    4044   00:5497  13                      inc de                          ; Not zero, so increase size count
    4045   00:5498  23                      inc hl                          ; And next hostname byte
    4046   00:5499  B7                      or  a                           ; If zero, hostname terminated
    4047   00:549A                          ; Loop until terminator (0) is found
    4048   00:549A  C2 96 54                jp  nz,TCPIP_TCP_OPEN_CHECK_HOSTOF
    4049   00:549D                      
    4050   00:549D                      TCPIP_TCP_OPEN_HOSTNAME_SENDCMDWITHHOSTNAME:
    4051   00:549D                          ; Ok, so, DE has the full hostname size, let's start sending from here
    4052   00:549D  3E 0D                   ld  a,13                        ; Function TCP OPEN
    4053   00:549F                          SEND_DATA                       ; Send the command
    4053   00:549F  D3 07             >     out (OUT_TX_PORT),a
    4054   00:54A1  7A                      ld  a,d
    4055   00:54A2                          SEND_DATA                       ; Send the command size msb
    4055   00:54A2  D3 07             >     out (OUT_TX_PORT),a
    4056   00:54A4  7B                      ld  a,e
    4057   00:54A5                          SEND_DATA                       ; Send the command size lsb
    4057   00:54A5  D3 07             >     out (OUT_TX_PORT),a
    4058   00:54A7  E1                      pop hl                          ; Restore the memory address for the parameters
    4059   00:54A8                          ; First send the 11 bytes parameters
    4060   00:54A8                          if USE_MEM_IO = 0
    4061   00:54A8  0E 07                   ld  c,OUT_TX_PORT
    4062   00:54AA  ED A3                   outi
    4063   00:54AC  ED A3                   outi
    4064   00:54AE  ED A3                   outi
    4065   00:54B0  ED A3                   outi
    4066   00:54B2  ED A3                   outi
    4067   00:54B4  ED A3                   outi
    4068   00:54B6  ED A3                   outi
    4069   00:54B8  ED A3                   outi
    4070   00:54BA  ED A3                   outi
    4071   00:54BC  ED A3                   outi
    4072   00:54BE  ED A3                   outi                            ; Unrolled outi is a bit faster :)
    4073   00:54C0                          else
    4074   00:54C0                    ~     ld  b,11                        ; Send 11 bytes
    4075   00:54C0                    ~ TCPIP_TCP_OPEN_HOSTNAME_SENDCMDWITHHOSTNAME_LOOP_PARAM:
    4076   00:54C0                    ~     ld  a,(hl)
    4077   00:54C0                    ~     ld  (MEM_OUT_TX_PORT),a
    4078   00:54C0                    ~     inc hl
    4079   00:54C0                    ~     djnz TCPIP_TCP_OPEN_HOSTNAME_SENDCMDWITHHOSTNAME_LOOP_PARAM
    4080   00:54C0                    ~     endif
    4081   00:54C0  EB                      ex  de,hl                       ; Size in HL
    4082   00:54C1  11 0B 00                ld  de,11
    4083   00:54C4  B7                      or  a                           ; zero flag
    4084   00:54C5  ED 52                   sbc hl,de
    4085   00:54C7  EB                      ex de,hl                        ; and adjusted size back in de
    4086   00:54C8  E1                      pop hl                          ; Restore the memory address for hostname
    4087   00:54C9                      ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    4088   00:54C9  43                      ld  b,e                         ; Number of loops originaly in DE
    4089   00:54CA  1B                      dec de
    4090   00:54CB  14                      inc d
    4091   00:54CC                          if USE_MEM_IO = 0
    4092   00:54CC  0E 07                   ld  c,OUT_TX_PORT
    4093   00:54CE                      TCPIP_TCP_OPEN_SENDHOSTNAME:
    4094   00:54CE  ED A3                   outi
    4095   00:54D0  20 FC                   jr  nz,TCPIP_TCP_OPEN_SENDHOSTNAME
    4096   00:54D2                          else
    4097   00:54D2                    ~ TCPIP_TCP_OPEN_SENDHOSTNAME:
    4098   00:54D2                    ~     ld  a,(hl)
    4099   00:54D2                    ~     ld  (MEM_OUT_TX_PORT),a
    4100   00:54D2                    ~     inc hl
    4101   00:54D2                    ~     djnz TCPIP_TCP_OPEN_SENDHOSTNAME
    4102   00:54D2                    ~     endif
    4103   00:54D2  15                      dec d
    4104   00:54D3  20 F9                   jr  nz,TCPIP_TCP_OPEN_SENDHOSTNAME
    4105   00:54D5  C3 F4 54                jp  TCPIP_TCP_OPEN_WAIT_RESPONSE
    4106   00:54D8                      
    4107   00:54D8                      TCPIP_TCP_OPEN_NO_TLS:
    4108   00:54D8                      TCPIP_TCP_OPEN_NO_CHECKHOST:
    4109   00:54D8  3E 0D                   ld  a,13                        ; Function TCP OPEN
    4110   00:54DA                          SEND_DATA                       ; Send the command
    4110   00:54DA  D3 07             >     out (OUT_TX_PORT),a
    4111   00:54DC  CD 2A 5F                call    GETWORD
    4112   00:54DF  7C                      ld  a,h
    4113   00:54E0  57                      ld  d,a
    4114   00:54E1                          SEND_DATA                       ; Send the command size msb
    4114   00:54E1  D3 07             >     out (OUT_TX_PORT),a
    4115   00:54E3  7D                      ld  a,l
    4116   00:54E4  5F                      ld  e,a
    4117   00:54E5                          SEND_DATA                       ; Send the command size lsb
    4117   00:54E5  D3 07             >     out (OUT_TX_PORT),a
    4118   00:54E7                      
    4119   00:54E7  E1                      pop hl                          ; Restore the memory address for the parameters
    4120   00:54E8                      ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    4121   00:54E8  43                      ld  b,e                         ; Number of loops originaly in DE
    4122   00:54E9  1B                      dec de
    4123   00:54EA  14                      inc d
    4124   00:54EB                          if USE_MEM_IO = 0
    4125   00:54EB  0E 07                   ld  c,OUT_TX_PORT
    4126   00:54ED                      TCPIP_TCP_OPEN_R:
    4127   00:54ED  ED A3                   outi
    4128   00:54EF  20 FC                   jr  nz,TCPIP_TCP_OPEN_R
    4129   00:54F1                          else
    4130   00:54F1                    ~ TCPIP_TCP_OPEN_R:
    4131   00:54F1                    ~     ld  a,(hl)
    4132   00:54F1                    ~     ld  (MEM_OUT_TX_PORT),a
    4133   00:54F1                    ~     inc hl
    4134   00:54F1                    ~     djnz TCPIP_TCP_OPEN_R
    4135   00:54F1                    ~     endif
    4136   00:54F1  15                      dec d
    4137   00:54F2  20 F9                   jr  nz,TCPIP_TCP_OPEN_R
    4138   00:54F4                      
    4139   00:54F4                      TCPIP_TCP_OPEN_WAIT_RESPONSE:
    4140   00:54F4                          ; Now wait up to 3600 (1 minute @ 60Hz) ticks to get response
    4141   00:54F4                          ; TLS Connections might take SEVERAL seconds on TLS Handshake
    4142   00:54F4                          ; Even more if certificates database is being indexed
    4143   00:54F4  21 10 0E                ld  hl,3600
    4144   00:54F7  CD F4 5E                call    SETCOUNTER
    4145   00:54FA                      TCPIP_TCP_OPEN_ST1:
    4146   00:54FA                          CHECK_DATA
    4146   00:54FA  DB 07             >     in  a,(IN_STS_PORT)
    4146   00:54FC  CB 47             >     bit 0,a
    4147   00:54FE  20 05                   jr  nz,TCPIP_TCP_OPEN_ST1.1
    4148   00:5500  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4149   00:5503  18 F5                   jr  TCPIP_TCP_OPEN_ST1
    4150   00:5505                      TCPIP_TCP_OPEN_ST1.1:
    4151   00:5505                          ; nz, check the data
    4152   00:5505                          RECEIVE_DATA
    4152   00:5505  DB 06             >     in a,(IN_DATA_PORT)
