    2159   00:4C34  DD E1                   pop ix
    2160   00:4C36  D1                      pop de
    2161   00:4C37  C9                      ret
    2162   00:4C38                      WAIT_MENU_SCMD_RESPONSE_END_NOK:
    2163   00:4C38  21 00 00                ld  hl,0
    2164   00:4C3B  47                      ld  b,a                         ; Return code in B
