    2141   00:4C14  DD 23                   inc ix                          ; Increment pointer
    2142   00:4C16  B7                      or  a                           ; Terminator of AP Name?
    2143   00:4C17  20 E8                   jr  nz,WAIT_MENU_SCMD_RESPONSE_ST2B
    2144   00:4C19                          ; Get encryption
    2145   00:4C19                      WAIT_MENU_SCMD_RESPONSE_GET_ENC:
    2146   00:4C19                          CHECK_DATA
    2146   00:4C19  DB 07             >     in  a,(IN_STS_PORT)
    2146   00:4C1B  CB 47             >     bit 0,a
