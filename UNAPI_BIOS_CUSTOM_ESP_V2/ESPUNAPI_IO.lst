    2074   00:4BC7                      ; WAIT an ESP Wi-Fi Scan command Response
    2075   00:4BC7                      ; Inputs:
    2076   00:4BC7                      ; A -> Command Code
    2077   00:4BC7                      ; HL -> Timeout
    2078   00:4BC7                      ; IX -> Where to store response
    2079   00:4BC7                      ;
    2080   00:4BC7                      ; Returns:
    2081   00:4BC7                      ; Flag Z is zero if failure, non zero if success
    2082   00:4BC7                      ; A is the number of access points scanned
    2083   00:4BC7                      ;
    2084   00:4BC7                      ; Response is stored as:
    2085   00:4BC7                      ; Access Point SSID zero terminated and after first 0
    2086   00:4BC7                      ; 0 if Open otherwise requires a password to join
    2087   00:4BC7                      ; And this repeats...
    2088   00:4BC7                      ;
    2089   00:4BC7                      ; Affect:
    2090   00:4BC7                      ; AF , BC and HL
    2091   00:4BC7                      ;
    2092   00:4BC7                      WAIT_MENU_SCMD_RESPONSE:
    2093   00:4BC7  D5                      push    de
    2094   00:4BC8  DD E5                   push    ix
    2095   00:4BCA  57                      ld  d,a                         ; Command to wait in D
