    3425   00:51C9                      ;=========================
    3426   00:51C9                      ;===  TCPIP_UDP_CLOSE  ===
    3427   00:51C9                      ;=========================
    3428   00:51C9                      ;Close a UDP connection.
    3429   00:51C9                      ;
    3430   00:51C9                      ;Input:  A = 9
