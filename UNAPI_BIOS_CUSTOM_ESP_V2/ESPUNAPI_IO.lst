    4957   00:58E6                      ;===  TCPIP_TCP_SEND  ===
    4958   00:58E6                      ;========================
    4959   00:58E6                      ;Send data to a TCP connection.
    4960   00:58E6                      ;
    4961   00:58E6                      ;Input:  A  = 17
    4962   00:58E6                      ;        B  = Connection number
    4963   00:58E6                      ;        DE = Address of the data to be sent
    4964   00:58E6                      ;        HL = Length of the data to be sent
    4965   00:58E6                      ;        C  = Flags:
    4966   00:58E6                      ;             bit 0: Send the data PUSHed
    4967   00:58E6                      ;             bit 1: The data is urgent
    4968   00:58E6                      ;Output: A = Error code
    4969   00:58E6                      TCPIP_TCP_SEND:
    4970   00:58E6  E5                      push    hl
    4971   00:58E7  D5                      push    de
    4972   00:58E8                          SEND_DATA                       ; Send the command
    4972   00:58E8  D3 07             >     out (OUT_TX_PORT),a
    4973   00:58EA                          ; prepare new data size, adding our 2 bytes overhead
    4974   00:58EA  11 02 00                ld  de,2
    4975   00:58ED  19                      add hl,de
