    5473   00:5B08                          SEND_DATA                       ; Send MAX rcv size MSB
    5473   00:5B08  D3 07             >     out (OUT_TX_PORT),a
    5474   00:5B0A  3E 03                   ld  a,3
    5475   00:5B0C  CD 16 5F                call    SETBYTE                 ; Ok, retry up to three times
    5476   00:5B0F                      TCPIP_TCP_RCV.RXRETRY:
    5477   00:5B0F                          ; Now wait up to 600 ticks to get response
    5478   00:5B0F  21 58 02                ld  hl,600
