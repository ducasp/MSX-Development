    3446   00:51DD  CB 47             >     bit 0,a
    3447   00:51DF  20 05                   jr  nz,TCPIP_UDP_CLOSE_ST1.1
    3448   00:51E1  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3449   00:51E4  18 F5                   jr  TCPIP_UDP_CLOSE_ST1
    3450   00:51E6                      TCPIP_UDP_CLOSE_ST1.1:
    3451   00:51E6                          ; nz, check the data
    3452   00:51E6                          RECEIVE_DATA
    3452   00:51E6  DB 06             >     in a,(IN_DATA_PORT)
    3453   00:51E8  FE 09                   cp  9                           ; Is response of our command?
    3454   00:51EA  20 EF                   jr  nz,TCPIP_UDP_CLOSE_ST1
    3455   00:51EC                          ; now get return code, if return code other than 0, it is finished
    3456   00:51EC                      TCPIP_UDP_CLOSE_RC:
    3457   00:51EC                          CHECK_DATA
    3457   00:51EC  DB 07             >     in  a,(IN_STS_PORT)
    3457   00:51EE  CB 47             >     bit 0,a
    3458   00:51F0  20 05                   jr  nz,TCPIP_UDP_CLOSE_RC.1
    3459   00:51F2  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3460   00:51F5  18 F5                   jr  TCPIP_UDP_CLOSE_RC
    3461   00:51F7                      TCPIP_UDP_CLOSE_RC.1:
    3462   00:51F7                          ; nz, discard
    3463   00:51F7                          RECEIVE_DATA
    3463   00:51F7  DB 06             >     in a,(IN_DATA_PORT)
    3464   00:51F9  B7                      or  a                           ; 0?
    3465   00:51FA  C0                      ret nz                          ; if not, done
    3466   00:51FB                      
    3467   00:51FB                          ; next two bytes are return code and size bytes, don't care, it is 1, conn #
    3468   00:51FB  06 02                   ld  b,2
    3469   00:51FD                      TCPIP_UDP_CLOSE_ST2:
    3470   00:51FD                          CHECK_DATA
