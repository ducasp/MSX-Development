    4188   00:553D                      ;=========================
    4189   00:553D                      ;===  TCPIP_TCP_CLOSE  ===
    4190   00:553D                      ;=========================
    4191   00:553D                      ;Close a TCP connection.
    4192   00:553D                      ;
    4193   00:553D                      ;Input:  A = 14
    4194   00:553D                      ;        B = Connection number
    4195   00:553D                      ;            0 to close all open transient UDP connections
    4196   00:553D                      ;Output: A = Error code
    4197   00:553D                      TCPIP_TCP_CLOSE:
    4198   00:553D                          SEND_DATA                       ; Send the command
    4198   00:553D  D3 07             >     out (OUT_TX_PORT),a
    4199   00:553F  AF                      xor a
