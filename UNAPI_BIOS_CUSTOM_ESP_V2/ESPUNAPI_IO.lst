    2195   00:4C55  B7                      or  a
    2196   00:4C56  28 1F                   jr  z,PHLINESPC                 ; When string is finished, done!
    2197   00:4C58  CD A2 00                call    CHPUT
    2198   00:4C5B  23                      inc hl
    2199   00:4C5C  10 F6                   djnz    PHLINEL
    2200   00:4C5E  3E 1D                   ld  a,GOLEFT
    2201   00:4C60  CD A2 00                call    CHPUT
    2202   00:4C63  CD A2 00                call    CHPUT
