    4362   00:55E5  DB 06             >     in a,(IN_DATA_PORT)
    4363   00:55E7  05                      dec b
    4364   00:55E8  20 F0                   jr  nz,SSH_OPEN_ST2
    4365   00:55EA                      
    4366   00:55EA                          ; now just get the 1 byte, conn#, should go to B
    4367   00:55EA                      SSH_OPEN_CONN_ST1:
    4368   00:55EA                          CHECK_DATA
    4368   00:55EA  DB 07             >     in  a,(IN_STS_PORT)
    4368   00:55EC  CB 47             >     bit 0,a
    4369   00:55EE  20 05                   jr  nz,SSH_OPEN_CONN_ST1.1
    4370   00:55F0  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4371   00:55F3  18 F5                   jr  SSH_OPEN_CONN_ST1
    4372   00:55F5                      SSH_OPEN_CONN_ST1.1:
    4373   00:55F5                          ; nz, get it
    4374   00:55F5                          RECEIVE_DATA
    4374   00:55F5  DB 06             >     in a,(IN_DATA_PORT)
    4375   00:55F7  47                      ld  b,a
    4376   00:55F8                          ; done
    4377   00:55F8  AF                      xor a
    4378   00:55F9  C9                      ret
    4379   00:55FA                      
    4380   00:55FA                      SSH_OPEN_HOSTHASH:
    4381   00:55FA                          ; HL has memory area to write host fingerprint / hash
    4382   00:55FA                          ; we will receive size, should be 33, 1 byte for connection ID
    4383   00:55FA                          ; 32 bytes for fingerprint / hash
    4384   00:55FA                          CHECK_DATA
    4384   00:55FA  DB 07             >     in  a,(IN_STS_PORT)
    4384   00:55FC  CB 47             >     bit 0,a
    4385   00:55FE  20 05                   jr  nz,SSH_OPEN_HOSTHASH.1
    4386   00:5600  CD AD 5A                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    4387   00:5603  18 F5                   jr  SSH_OPEN_HOSTHASH
    4388   00:5605                      SSH_OPEN_HOSTHASH.1:
    4389   00:5605                          ; nz, high byte count of bytes to receive
    4390   00:5605                          RECEIVE_DATA
    4390   00:5605  DB 06             >     in a,(IN_DATA_PORT)
    4391   00:5607  67                      ld h,a
    4392   00:5608                      SSH_OPEN_HOSTHASHB:
    4393   00:5608                          CHECK_DATA
    4393   00:5608  DB 07             >     in  a,(IN_STS_PORT)
    4393   00:560A  CB 47             >     bit 0,a
    4394   00:560C  20 05                   jr  nz,SSH_OPEN_HOSTHASHB.1
    4395   00:560E  CD AD 5A                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    4396   00:5611  18 F5                   jr  SSH_OPEN_HOSTHASHB
    4397   00:5613                      SSH_OPEN_HOSTHASHB.1:
    4398   00:5613                          ; nz, low byte count of bytes to receive
    4399   00:5613                          RECEIVE_DATA
    4399   00:5613  DB 06             >     in a,(IN_DATA_PORT)
    4400   00:5615  6F                      ld  l,a
    4401   00:5616  B4                      or  h
    4402   00:5617                          ; if it was 0, no data
    4403   00:5617                          if USE_MEM_IO = 1
    4404   00:5617                    ~     jp  z,TCPIP_TCP_RCV_RET_NODATA  ; not a typo, no need to make the same code again
    4405   00:5617                    ~     else
    4406   00:5617  CA E2 5A                jp  z,TCPIP_TCP_RCV_RET_NODATA  ; not a typo, no need to make the same code again
    4407   00:561A                          endif
    4408   00:561A  2B                      dec hl                          ; decrement one byte, first is connection will go to B
    4409   00:561B                          ; Now get connection number and save it 
    4410   00:561B                      SSH_OPEN_HOSTHASH_CONN:
    4411   00:561B                          CHECK_DATA
    4411   00:561B  DB 07             >     in  a,(IN_STS_PORT)
    4411   00:561D  CB 47             >     bit 0,a
    4412   00:561F  20 05                   jr  nz,SSH_OPEN_HOSTHASH_CONN.1
    4413   00:5621  CD AD 5A                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    4414   00:5624  18 F5                   jr  SSH_OPEN_HOSTHASH_CONN
    4415   00:5626                      SSH_OPEN_HOSTHASH_CONN.1:
