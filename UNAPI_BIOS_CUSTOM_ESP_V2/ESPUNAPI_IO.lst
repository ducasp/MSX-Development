    2216   00:4C7A  CD A2 00                call    CHPUT
    2217   00:4C7D  3E 20                   ld  a,' '
    2218   00:4C7F  CD A2 00                call    CHPUT
    2219   00:4C82  18 07                   jr  PHLINELR
