    4233   00:5571                          CHECK_DATA
    4233   00:5571  DB 07             >     in  a,(IN_STS_PORT)
    4233   00:5573  CB 47             >     bit 0,a
    4234   00:5575  20 05                   jr  nz,TCPIP_TCP_CLOSE_ST2.1
