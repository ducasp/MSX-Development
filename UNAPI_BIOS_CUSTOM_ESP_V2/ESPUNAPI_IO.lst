    6763   00:602B                      ;*********************************************
    6764   00:602B                      ;***    ESP Specific Commands/Responses    ***
    6765   00:602B                      ;*********************************************
    6766   00:602B                      ; Cold reset of ESP firmware
    6767   00:602B  (00:0052)           CMD_RESET_ESP           equ 'R'
    6768   00:602B                      ; ESP32 only, return the firmware type on the device
    6769   00:602B  (00:0062)           CMD_GET_FW_TYPE         equ 'b'
    6770   00:602B                      ; Warm reset of ESP firmware
    6771   00:602B  (00:0057)           CMD_WRESET_ESP          equ 'W'
    6772   00:602B                      ; Hold Wi-Fi Connection On
    6773   00:602B  (00:0048)           CMD_WIFIHOLD_ESP        equ 'H'
    6774   00:602B                      ; Release Wi-Fi Connection Hold
    6775   00:602B  (00:0068)           CMD_WIFIRELEASE_ESP     equ 'h'
    6776   00:602B                      ; Get Updated time and date from internet
    6777   00:602B  (00:0047)           CMD_GET_TIME            equ 'G'
    6778   00:602B                      ; Query Auto Clock settings
    6779   00:602B  (00:0063)           CMD_QUERY_ACLK_SETTINGS equ 'c'
    6780   00:602B                      ; Set Auto Clock settings
    6781   00:602B  (00:0043)           CMD_SET_ACLK_SETTINGS   equ 'C'
    6782   00:602B                      ; Query ESP settings
    6783   00:602B  (00:0051)           CMD_QUERY_ESP_SETTINGS  equ 'Q'
    6784   00:602B                      ; Set Timer Value
    6785   00:602B  (00:0054)           CMD_TIMER_SET           equ 'T'
    6786   00:602B                      ; Turn Nagle On
    6787   00:602B  (00:0044)           CMD_NAGLE_ON            equ 'D'
    6788   00:602B                      ; Turn Nagle Off
    6789   00:602B  (00:004E)           CMD_NAGLE_OFF           equ 'N'
    6790   00:602B                      ; Turn Wi-Fi Off
    6791   00:602B  (00:004F)           CMD_WIFI_OFF            equ 'O'
    6792   00:602B                      ; Request to connect to a network
    6793   00:602B  (00:0041)           CMD_WIFI_CONNECT        equ 'A'
    6794   00:602B                      ; Request to start network scan
    6795   00:602B  (00:0053)           CMD_SCAN_START          equ 'S'
    6796   00:602B                      ; Request network scan result
    6797   00:602B  (00:0073)           CMD_SCAN_RESULTS        equ 's'
    6798   00:602B                      ; Request AP Status
    6799   00:602B  (00:0067)           CMD_AP_STS              equ 'g'
    6800   00:602B                      ; Get ESP firmware version
    6801   00:602B  (00:0056)           CMD_GET_ESP_VER         equ 'V'
    6802   00:602B                      ; After finishing Warm reset, ESP returns ready
    6803   00:602B  52 65 61 64 79      RSP_CMD_RESET_ESP       db  "Ready"
    6804   00:6030  (00:0005)           RSP_CMD_RESET_ESP_SIZE  equ 5
    6805   00:6030                      ; Query ESP Presence
    6806   00:6030  (00:003F)           CMD_QUERY_ESP           equ '?'
    6807   00:6030                      ; Query response
    6808   00:6030  4F 4B               RSP_CMD_QUERY_ESP       db  "OK"
    6809   00:6032  (00:0002)           RSP_CMD_QUERY_ESP_SIZE  equ 2
    6810   00:6032                      
