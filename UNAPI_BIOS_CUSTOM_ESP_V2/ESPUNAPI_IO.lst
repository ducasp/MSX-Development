    3107   00:5086                          ; nz, discard
    3108   00:5086                          RECEIVE_DATA
    3108   00:5086  DB 06             >     in a,(IN_DATA_PORT)
    3109   00:5088  05                      dec b
    3110   00:5089  20 F0                   jr  nz,TCPIP_NET_STATE_ST2
    3111   00:508B                      
    3112   00:508B                          ; now just get the 1 byte (NET STATE) IP and place it in B
    3113   00:508B                      TCPIP_NET_STATE_NS_ST1:
    3114   00:508B                          CHECK_DATA
    3114   00:508B  DB 07             >     in  a,(IN_STS_PORT)
    3114   00:508D  CB 47             >     bit 0,a
    3115   00:508F  20 05                   jr  nz,TCPIP_NET_STATE_NS_ST1.1
    3116   00:5091  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3117   00:5094  18 F5                   jr  TCPIP_NET_STATE_NS_ST1
    3118   00:5096                      TCPIP_NET_STATE_NS_ST1.1:
    3119   00:5096                          ; nz, get it
    3120   00:5096                          RECEIVE_DATA
    3120   00:5096  DB 06             >     in a,(IN_DATA_PORT)
    3121   00:5098  47                      ld  b,a
    3122   00:5099                          ; done
    3123   00:5099  AF                      xor a
    3124   00:509A  C9                      ret
    3125   00:509B                      
    3126   00:509B                      ;=====================
    3127   00:509B                      ;===  TCPIP_DNS_Q  ===
    3128   00:509B                      ;=====================
    3129   00:509B                      ;Start a host name resolution query.
    3130   00:509B                      ;
    3131   00:509B                      ;Input:  A  = 6
    3132   00:509B                      ;        HL = Address of the host name to be resolved, zero terminated
    3133   00:509B                      ;        B  = Flags, when set to 1 they instruct the resolver to:
    3134   00:509B                      ;             bit 0: Only abort the query currently in progress, if there is any
    3135   00:509B                      ;                    (other flags and registers are then ignored)
    3136   00:509B                      ;             bit 1: Assume that the passed name is an IP address,
    3137   00:509B                      ;                    and return an error if this is not true
    3138   00:509B                      ;             bit 2: If there is a query in progress already,
    3139   00:509B                      ;                    do NOT abort it and return an error instead
    3140   00:509B                      ;Output:  A = Error code
    3141   00:509B                      ;         B = 0 if a query to a DNS server is in progress
    3142   00:509B                      ;             1 if the name represented an IP address
    3143   00:509B                      ;             2 if the name could be resolved locally
    3144   00:509B                      ;         L.H.E.D = Resolved IP address
    3145   00:509B                      ;                   (only if no error occurred and B=1 or 2 is returned)
    3146   00:509B                      ;RAM Buffer to store names to be resolved (and used also to translate IPs from ASCII to 32bits number)
    3147   00:509B                      ;Will store the result of the last DNS query
    3148   00:509B                      TCPIP_DNS_Q:
    3149   00:509B  E5                      push    hl                      ; Save HL
    3150   00:509C  AF                      xor a
    3151   00:509D  5F                      ld  e,a
    3152   00:509E  57                      ld  d,a                         ; Zero DE
    3153   00:509F                      TCPIP_DNS_Q_SIZE_LOOP:
    3154   00:509F  7E                      ld  a,(hl)                      ; so let's check the size of dns data
    3155   00:50A0  B7                      or  a                           ; it is zero terminated
    3156   00:50A1  28 05                   jr  z,TCPIP_DNS_Q_SEND          ; if zero, end of string
    3157   00:50A3  13                      inc de                          ; ok, not zero, one more char
    3158   00:50A4  23                      inc hl                          ; next
    3159   00:50A5  C3 9F 50                jp  TCPIP_DNS_Q_SIZE_LOOP       ; jp is a tad bit faster and we are not worried about code size
    3160   00:50A8                      TCPIP_DNS_Q_SEND:
    3161   00:50A8                          ; Here we send the query and wait the result
    3162   00:50A8  13                      inc de                          ; add 1, we will send flag first
    3163   00:50A9  3E CE                   ld  a,206                       ; DNS_Q_NEW
    3164   00:50AB                          SEND_DATA                       ; Send the command
    3164   00:50AB  D3 07             >     out (OUT_TX_PORT),a
    3165   00:50AD  7A                      ld  a,d
    3166   00:50AE                          SEND_DATA                       ; Send the command size msb
    3166   00:50AE  D3 07             >     out (OUT_TX_PORT),a
    3167   00:50B0  7B                      ld  a,e
    3168   00:50B1                          SEND_DATA                       ; Send the command size lsb
    3168   00:50B1  D3 07             >     out (OUT_TX_PORT),a
    3169   00:50B3  78                      ld  a,b
    3170   00:50B4                          SEND_DATA                       ; Send the flag byte
    3170   00:50B4  D3 07             >     out (OUT_TX_PORT),a
    3171   00:50B6                      
    3172   00:50B6                          if USE_MEM_IO = 0
    3173   00:50B6                          ; now otir of DNS/DNS BUFFER DATA SIZE
    3174   00:50B6  0E 07                   ld  c,OUT_TX_PORT               ; our data TX port
    3175   00:50B8                          endif
    3176   00:50B8  E1                      pop hl                          ; string to try to resolve
    3177   00:50B9  1B                      dec de                          ; we are sending just data addressed by HL, so revert count
    3178   00:50BA  7A                      ld  a,d
    3179   00:50BB  B3                      or  e                           ; if de zero, no string, wrong parameters, but let the ESP answer
    3180   00:50BC  CA CC 50                jp  z,TCPIP_DNS_Q_WAIT_RSP
    3181   00:50BF  AF                      xor a
    3182   00:50C0                          ; Fast 16 bit variable size loop by GRAUW
    3183   00:50C0  43                      ld  b,e
    3184   00:50C1  1B                      dec de
    3185   00:50C2  14                      inc d
    3186   00:50C3                      TCPIP_DNS_Q_SENDLP:
    3187   00:50C3                          ; send it
    3188   00:50C3                          if USE_MEM_IO = 0
    3189   00:50C3  ED A3                   outi
    3190   00:50C5  C2 C3 50                jp  nz,TCPIP_DNS_Q_SENDLP
    3191   00:50C8                          else
    3192   00:50C8                    ~     ld  a,(hl)
    3193   00:50C8                    ~     ld  (MEM_OUT_TX_PORT),a
    3194   00:50C8                    ~     inc hl
    3195   00:50C8                    ~     djnz TCPIP_DNS_Q_SENDLP
    3196   00:50C8                    ~     endif
    3197   00:50C8  15                      dec d
    3198   00:50C9  C2 C3 50                jp  nz,TCPIP_DNS_Q_SENDLP
    3199   00:50CC                      TCPIP_DNS_Q_WAIT_RSP:
    3200   00:50CC                          ; Now wait up to 900 ticks (15s@60Hz) to get response
    3201   00:50CC  21 84 03                ld  hl,900
    3202   00:50CF  CD F4 5E                call    SETCOUNTER
    3203   00:50D2                      TCPIP_DNSQ_SEND_ST1:
    3204   00:50D2                          CHECK_DATA
    3204   00:50D2  DB 07             >     in  a,(IN_STS_PORT)
    3204   00:50D4  CB 47             >     bit 0,a
    3205   00:50D6  20 05                   jr  nz,TCPIP_DNSQ_SEND_ST1.1
    3206   00:50D8  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3207   00:50DB  18 F5                   jr  TCPIP_DNSQ_SEND_ST1
    3208   00:50DD                      TCPIP_DNSQ_SEND_ST1.1:
    3209   00:50DD                          ; nz, check the data
    3210   00:50DD                          RECEIVE_DATA
    3210   00:50DD  DB 06             >     in a,(IN_DATA_PORT)
    3211   00:50DF  FE CE                   cp  206                         ; Is response of our command?
    3212   00:50E1  20 EF                   jr  nz,TCPIP_DNSQ_SEND_ST1
    3213   00:50E3                          ; now get return code, if return code other than 0, it is finished
    3214   00:50E3                      TCPIP_DNSQ_SEND_RC:
    3215   00:50E3                          CHECK_DATA
    3215   00:50E3  DB 07             >     in  a,(IN_STS_PORT)
    3215   00:50E5  CB 47             >     bit 0,a
    3216   00:50E7  20 05                   jr  nz,TCPIP_DNSQ_SEND_RC.1
    3217   00:50E9  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3218   00:50EC  18 F5                   jr  TCPIP_DNSQ_SEND_RC
    3219   00:50EE                      TCPIP_DNSQ_SEND_RC.1:
    3220   00:50EE                          ; nz, discard
    3221   00:50EE                          RECEIVE_DATA
    3221   00:50EE  DB 06             >     in a,(IN_DATA_PORT)
    3222   00:50F0  B7                      or  a                           ; 0?
    3223   00:50F1  06 00                   ld  b,0                         ; say in progress as there is no failure status
    3224   00:50F3  C0                      ret nz                          ; if not, done, ERROR won't return data
    3225   00:50F4                      
    3226   00:50F4                          ; next two bytes are return code and size bytes, don't care, it is 4, resolved IP
    3227   00:50F4  06 02                   ld  b,2
    3228   00:50F6                      TCPIP_DNSQ_SEND_RC_ST2:
    3229   00:50F6                          CHECK_DATA
    3229   00:50F6  DB 07             >     in  a,(IN_STS_PORT)
    3229   00:50F8  CB 47             >     bit 0,a
    3230   00:50FA  20 05                   jr  nz,TCPIP_DNSQ_SEND_RC_ST2.1
    3231   00:50FC  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3232   00:50FF  18 F5                   jr  TCPIP_DNSQ_SEND_RC_ST2
    3233   00:5101                      TCPIP_DNSQ_SEND_RC_ST2.1:
    3234   00:5101                          ; nz, discard
    3235   00:5101                          RECEIVE_DATA
    3235   00:5101  DB 06             >     in a,(IN_DATA_PORT)
    3236   00:5103  05                      dec b
    3237   00:5104  20 F0                   jr  nz,TCPIP_DNSQ_SEND_RC_ST2
    3238   00:5106                      
    3239   00:5106                          ; now just get the 4 bytes IP and place it in L H E D
    3240   00:5106                      TCPIP_DNSQ_IP_ST1:
    3241   00:5106                          CHECK_DATA
    3241   00:5106  DB 07             >     in  a,(IN_STS_PORT)
    3241   00:5108  CB 47             >     bit 0,a
    3242   00:510A  20 05                   jr  nz,TCPIP_DNSQ_IP_ST1.1
    3243   00:510C  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3244   00:510F  18 F5                   jr  TCPIP_DNSQ_IP_ST1
    3245   00:5111                      TCPIP_DNSQ_IP_ST1.1:
    3246   00:5111                          ; nz, get it
    3247   00:5111                          RECEIVE_DATA
    3247   00:5111  DB 06             >     in a,(IN_DATA_PORT)
    3248   00:5113  6F                      ld  l,a
    3249   00:5114                      TCPIP_DNSQ_IP_ST2:
    3250   00:5114                          CHECK_DATA
    3250   00:5114  DB 07             >     in  a,(IN_STS_PORT)
    3250   00:5116  CB 47             >     bit 0,a
    3251   00:5118  20 05                   jr  nz,TCPIP_DNSQ_IP_ST2.1
    3252   00:511A  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3253   00:511D  18 F5                   jr  TCPIP_DNSQ_IP_ST2
    3254   00:511F                      TCPIP_DNSQ_IP_ST2.1:
    3255   00:511F                          ; nz, get it
    3256   00:511F                          RECEIVE_DATA
    3256   00:511F  DB 06             >     in a,(IN_DATA_PORT)
    3257   00:5121  67                      ld  h,a
    3258   00:5122                      TCPIP_DNSQ_IP_ST3:
    3259   00:5122                          CHECK_DATA
    3259   00:5122  DB 07             >     in  a,(IN_STS_PORT)
    3259   00:5124  CB 47             >     bit 0,a
    3260   00:5126  20 05                   jr  nz,TCPIP_DNSQ_IP_ST3.1
    3261   00:5128  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3262   00:512B  18 F5                   jr  TCPIP_DNSQ_IP_ST3
    3263   00:512D                      TCPIP_DNSQ_IP_ST3.1:
    3264   00:512D                          ; nz, get it
    3265   00:512D                          RECEIVE_DATA
    3265   00:512D  DB 06             >     in a,(IN_DATA_PORT)
    3266   00:512F  5F                      ld  e,a
    3267   00:5130                      TCPIP_DNSQ_IP_ST4:
    3268   00:5130                          CHECK_DATA
    3268   00:5130  DB 07             >     in  a,(IN_STS_PORT)
    3268   00:5132  CB 47             >     bit 0,a
    3269   00:5134  20 05                   jr  nz,TCPIP_DNSQ_IP_ST4.1
    3270   00:5136  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3271   00:5139  18 F5                   jr  TCPIP_DNSQ_IP_ST4
    3272   00:513B                      TCPIP_DNSQ_IP_ST4.1:
    3273   00:513B                          ; nz, get it
    3274   00:513B                          RECEIVE_DATA
    3274   00:513B  DB 06             >     in a,(IN_DATA_PORT)
    3275   00:513D  57                      ld  d,a
    3276   00:513E                          ; done
    3277   00:513E  3E 01                   ld  a,1
    3278   00:5140  CD 19 60                call    SETDNSREADY             ; DNS done
    3279   00:5143  CD 43 60                call    SETDNSRESULT            ; DNS RESULT
    3280   00:5146  06 02                   ld  b,2
    3281   00:5148  AF                      xor a
    3282   00:5149  C9                      ret
    3283   00:514A                      
    3284   00:514A                      ;=====================
    3285   00:514A                      ;===  TCPIP_DNS_S  ===
    3286   00:514A                      ;=====================
    3287   00:514A                      ;Obtains the host name resolution process state and result.
    3288   00:514A                      ;
    3289   00:514A                      ;Input:  A = 7
    3290   00:514A                      ;        B = Flags, when set to 1 they instruct the resolver to:
    3291   00:514A                      ;            bit 0: Clear any existing result or error condition after the execution
    3292   00:514A                      ;                   (except if there is a query in progress)
    3293   00:514A                      ;Output: A = Error code
    3294   00:514A                      ;        B = DNS error code (when error is ERR_DNS)
    3295   00:514A                      ;        B = Current query status (when error is ERR_OK):
    3296   00:514A                      ;            0: There is no query in progress, nor any result nor error code available
    3297   00:514A                      ;            1: There is a query in progress
    3298   00:514A                      ;            2: Query is complete
    3299   00:514A                      ;        C = Current query sub status (when error is ERR_OK and B=1):
    3300   00:514A                      ;            0: Unknown
    3301   00:514A                      ;            1: Querying the primary DNS server
    3302   00:514A                      ;            2: Querying the secondary DNS server
    3303   00:514A                      ;            3: Querying another DNS server
    3304   00:514A                      ;        C = Resolution process type (when error is ERR_OK and B=2):
    3305   00:514A                      ;            0: The name was obtained by querying a DNS server
    3306   00:514A                      ;            1: The name was a direct representation of an IP address
    3307   00:514A                      ;            2: The name was resolved locally
    3308   00:514A                      ;       L.H.E.D = Resolved IP address (when error is ERR_OK and B=2)
    3309   00:514A                      TCPIP_DNS_S:
    3310   00:514A                          ;--- Is there a result?
    3311   00:514A  CD 07 60                call    GETDNSREADY             ; DNS done?
    3312   00:514D  B7                      or  a
    3313   00:514E  28 23                   jr  z,TCPIP_DNS_S_NORESULT      ; No DNS result
    3314   00:5150                          ;--- Ok, we have a result, is it success?
    3315   00:5150  3D                      dec a
    3316   00:5151  28 12                   jr  z,TCPIP_DNS_S_HASRESULT     ; If it is 1, it was not an error
    3317   00:5153                          ;--- Shoot, there is an error...
    3318   00:5153                          ;--- And sure thing, ESP do not tell us details, it is always failure :-P
    3319   00:5153  CB 40                   bit 0,b                         ;--- clear error after this?
    3320   00:5155  28 09                   jr  z,TCP_IP_DNS_S_NOCLR
    3321   00:5157                          ;--- Clear
    3322   00:5157  06 00                   ld b,0                          ;--- Like I've said, no details
    3323   00:5159  AF                      xor a
    3324   00:515A  CD 19 60                call    SETDNSREADY             ; DNS not done
    3325   00:515D  3E 08                   ld  a,ERR_DNS;
    3326   00:515F  C9                      ret
    3327   00:5160                      TCP_IP_DNS_S_NOCLR:
    3328   00:5160                          ;--- Don't clear
    3329   00:5160  3E 08                   ld  a,ERR_DNS
    3330   00:5162  06 00                   ld  b,0                         ;--- Like I've said, no details
    3331   00:5164  C9                      ret
    3332   00:5165                          ;--- There is a result available...
    3333   00:5165                      TCPIP_DNS_S_HASRESULT:
    3334   00:5165                          ;--- Copy the result
    3335   00:5165  CD 2D 60                call    GETDNSRESULT
    3336   00:5168  AF                      xor a
    3337   00:5169  CB 40                   bit 0,b                         ;--- clear result after this?
    3338   00:516B  28 03                   jr  z,TCP_IP_DNS_S_RES_NOCLR    ;--- no, just return
    3339   00:516D                          ;--- Yes, clear
    3340   00:516D  CD 19 60                call    SETDNSREADY             ; DNS not done
    3341   00:5170                      TCP_IP_DNS_S_RES_NOCLR:
    3342   00:5170  06 02                   ld  b,2
    3343   00:5172  C9                      ret
    3344   00:5173                      
    3345   00:5173                      TCPIP_DNS_S_NORESULT:
    3346   00:5173  AF                      xor a                           ;--- OK no query in progress, no result, means nothing in progress
    3347   00:5174  06 00                   ld  b,0                         ;--- No query in progress
    3348   00:5176  C9                      ret
    3349   00:5177                      
    3350   00:5177                      ;========================
    3351   00:5177                      ;===  TCPIP_UDP_OPEN  ===
    3352   00:5177                      ;========================
    3353   00:5177                      ;Open an UDP connection.
    3354   00:5177                      ;
    3355   00:5177                      ;Input:  A  = 8
    3356   00:5177                      ;        HL = Local port number (#FFFF=random)
    3357   00:5177                      ;        B  = Intended connection lifetime:
    3358   00:5177                      ;             0: Transient
    3359   00:5177                      ;             1: Resident
    3360   00:5177                      ;Output: A = Error code
    3361   00:5177                      ;        B = Connection number
    3362   00:5177                      TCPIP_UDP_OPEN:
    3363   00:5177                          SEND_DATA                       ; Send the command
    3363   00:5177  D3 07             >     out (OUT_TX_PORT),a
    3364   00:5179  AF                      xor a
    3365   00:517A                          SEND_DATA                       ; Send the command size msb
    3365   00:517A  D3 07             >     out (OUT_TX_PORT),a
    3366   00:517C  3E 03                   ld  a,3
    3367   00:517E                          SEND_DATA                       ; Send the command size lsb
    3367   00:517E  D3 07             >     out (OUT_TX_PORT),a
    3368   00:5180  7D                      ld  a,l
    3369   00:5181                          SEND_DATA                       ; Send the port LSB
    3369   00:5181  D3 07             >     out (OUT_TX_PORT),a
    3370   00:5183  7C                      ld  a,h
    3371   00:5184                          SEND_DATA                       ; Send the port MSB
    3371   00:5184  D3 07             >     out (OUT_TX_PORT),a
    3372   00:5186  78                      ld  a,b
    3373   00:5187                          SEND_DATA                       ; Send the connection transient/resident
    3373   00:5187  D3 07             >     out (OUT_TX_PORT),a
    3374   00:5189                      
    3375   00:5189                          ; Now wait up to 180 ticks to get response
    3376   00:5189  21 B4 00                ld  hl,180
    3377   00:518C  CD F4 5E                call    SETCOUNTER
    3378   00:518F                      TCPIP_UDP_OPEN_ST1:
    3379   00:518F                          CHECK_DATA
    3379   00:518F  DB 07             >     in  a,(IN_STS_PORT)
    3379   00:5191  CB 47             >     bit 0,a
    3380   00:5193  20 05                   jr  nz,TCPIP_UDP_OPEN_ST1.1
    3381   00:5195  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3382   00:5198  18 F5                   jr  TCPIP_UDP_OPEN_ST1
    3383   00:519A                      TCPIP_UDP_OPEN_ST1.1:
    3384   00:519A                          ; nz, check the data
    3385   00:519A                          RECEIVE_DATA
    3385   00:519A  DB 06             >     in a,(IN_DATA_PORT)
    3386   00:519C  FE 08                   cp  8                           ; Is response of our command?
    3387   00:519E  20 EF                   jr  nz,TCPIP_UDP_OPEN_ST1
    3388   00:51A0                          ; now get return code, if return code other than 0, it is finished
    3389   00:51A0                      TCPIP_UDP_OPEN_RC:
    3390   00:51A0                          CHECK_DATA
    3390   00:51A0  DB 07             >     in  a,(IN_STS_PORT)
    3390   00:51A2  CB 47             >     bit 0,a
    3391   00:51A4  20 05                   jr  nz,TCPIP_UDP_OPEN_RC.1
    3392   00:51A6  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3393   00:51A9  18 F5                   jr  TCPIP_UDP_OPEN_RC
    3394   00:51AB                      TCPIP_UDP_OPEN_RC.1:
    3395   00:51AB                          ; nz, discard
    3396   00:51AB                          RECEIVE_DATA
    3396   00:51AB  DB 06             >     in a,(IN_DATA_PORT)
    3397   00:51AD  B7                      or  a                           ; 0?
    3398   00:51AE  C0                      ret nz                          ; if not, done
    3399   00:51AF                      
    3400   00:51AF                          ; next two bytes are return code and size bytes, don't care, it is 1, conn #
    3401   00:51AF  06 02                   ld  b,2
    3402   00:51B1                      TCPIP_UDP_OPEN_ST2:
    3403   00:51B1                          CHECK_DATA
    3403   00:51B1  DB 07             >     in  a,(IN_STS_PORT)
    3403   00:51B3  CB 47             >     bit 0,a
    3404   00:51B5  20 05                   jr  nz,TCPIP_UDP_OPEN_ST2.1
    3405   00:51B7  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3406   00:51BA  18 F5                   jr  TCPIP_UDP_OPEN_ST2
    3407   00:51BC                      TCPIP_UDP_OPEN_ST2.1:
    3408   00:51BC                          ; nz, discard
    3409   00:51BC                          RECEIVE_DATA
    3409   00:51BC  DB 06             >     in a,(IN_DATA_PORT)
    3410   00:51BE  05                      dec b
    3411   00:51BF  20 F0                   jr  nz,TCPIP_UDP_OPEN_ST2
    3412   00:51C1                      
    3413   00:51C1                          ; now just get the 1 byte, conn#, should go to B
    3414   00:51C1                      TCPIP_UDP_OPEN_CONN_ST1:
    3415   00:51C1                          CHECK_DATA
    3415   00:51C1  DB 07             >     in  a,(IN_STS_PORT)
    3415   00:51C3  CB 47             >     bit 0,a
    3416   00:51C5  20 05                   jr  nz,TCPIP_UDP_OPEN_CONN_ST1.1
    3417   00:51C7  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3418   00:51CA  18 F5                   jr  TCPIP_UDP_OPEN_CONN_ST1
    3419   00:51CC                      TCPIP_UDP_OPEN_CONN_ST1.1:
    3420   00:51CC                          ; nz, get it
    3421   00:51CC                          RECEIVE_DATA
    3421   00:51CC  DB 06             >     in a,(IN_DATA_PORT)
    3422   00:51CE  47                      ld  b,a
    3423   00:51CF                          ; done
    3424   00:51CF  AF                      xor a
    3425   00:51D0  C9                      ret
    3426   00:51D1                      
    3427   00:51D1                      ;=========================
    3428   00:51D1                      ;===  TCPIP_UDP_CLOSE  ===
    3429   00:51D1                      ;=========================
    3430   00:51D1                      ;Close a UDP connection.
    3431   00:51D1                      ;
    3432   00:51D1                      ;Input:  A = 9
    3433   00:51D1                      ;        B = Connection number
    3434   00:51D1                      ;            0 to close all open transient UDP connections
    3435   00:51D1                      ;Output: A = Error code
    3436   00:51D1                      TCPIP_UDP_CLOSE:
    3437   00:51D1                          SEND_DATA                       ; Send the command
    3437   00:51D1  D3 07             >     out (OUT_TX_PORT),a
