    4942   00:588B  DB 06             >     in a,(IN_DATA_PORT)
    4943   00:588D  0D                      dec c
    4944   00:588E  20 F0                   jr  nz,TCPIP_TCP_STATE_ERROR2
    4945   00:5890                      
    4946   00:5890                          ; now return w/ error that is saved in b
    4947   00:5890  78                      ld  a,b
    4948   00:5891  06 00                   ld  b,0
    4949   00:5893  0E 07                   ld  c,7
    4950   00:5895  21 00 00                ld  hl,0
    4951   00:5898  11 00 00                ld  de,0
    4952   00:589B  DD 21 00 00             ld  ix,0
