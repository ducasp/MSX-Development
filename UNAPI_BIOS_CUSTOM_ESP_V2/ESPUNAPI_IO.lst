    5302   00:5A6D                      ;=========================
    5303   00:5A6D                      ;===  TCPIP_TCP_STATE  ===
    5304   00:5A6D                      ;=========================
    5305   00:5A6D                      ;Get the state of a TCP connection.
    5306   00:5A6D                      ;
    5307   00:5A6D                      ;Input:  A = 16
    5308   00:5A6D                      ;        B = Connection number
    5309   00:5A6D                      ;        HL = Pointer in TPA for connection information block
    5310   00:5A6D                      ;             (0 if not needed)
    5311   00:5A6D                      ;Output: A  = Error code
    5312   00:5A6D                      ;        B  = Connection state
    5313   00:5A6D                      ;        C  = Close reason (only if ERR_NO_CONN is returned)
    5314   00:5A6D                      ;        HL = Number of total available incoming bytes
    5315   00:5A6D                      ;        DE = Number of urgent available incoming bytes
    5316   00:5A6D                      ;        IX = Available free space in the output buffer
    5317   00:5A6D                      ;             (0FFFFh = infinite)
    5318   00:5A6D                      ;
    5319   00:5A6D                      ;Connection information block consists of:
    5320   00:5A6D                      ;
    5321   00:5A6D                      ;    +0 (4): Remote IP address
    5322   00:5A6D                      ;    +4 (2): Remote port
    5323   00:5A6D                      ;    +6 (2): Local port
    5324   00:5A6D                      TCPIP_TCP_STATE_ERROR:
    5325   00:5A6D                          ; next two bytes are size bytes, don't care
    5326   00:5A6D  47                      ld  b,a                         ; save error in b
    5327   00:5A6E  0E 02                   ld  c,2
