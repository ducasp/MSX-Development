    5478   00:5B0D                      TCPIP_TCP_RCV_ST1:
    5479   00:5B0D                          CHECK_DATA
    5479   00:5B0D  DB 07             >     in  a,(IN_STS_PORT)
    5479   00:5B0F  CB 47             >     bit 0,a
