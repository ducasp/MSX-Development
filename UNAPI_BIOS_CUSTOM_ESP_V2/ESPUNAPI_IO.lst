    2063   00:4BBA                      
    2064   00:4BBA                      ; WAIT an ESP Wi-Fi Scan command Response
    2065   00:4BBA                      ; Inputs:
    2066   00:4BBA                      ; A -> Command Code
    2067   00:4BBA                      ; HL -> Timeout
    2068   00:4BBA                      ; IX -> Where to store response
    2069   00:4BBA                      ;
    2070   00:4BBA                      ; Returns:
    2071   00:4BBA                      ; Flag Z is zero if failure, non zero if success
    2072   00:4BBA                      ; A is the number of access points scanned
    2073   00:4BBA                      ;
    2074   00:4BBA                      ; Response is stored as:
    2075   00:4BBA                      ; Access Point SSID zero terminated and after first 0
    2076   00:4BBA                      ; 0 if Open otherwise requires a password to join
    2077   00:4BBA                      ; And this repeats...
    2078   00:4BBA                      ;
    2079   00:4BBA                      ; Affect:
    2080   00:4BBA                      ; AF , BC and HL
    2081   00:4BBA                      ;
    2082   00:4BBA                      WAIT_MENU_SCMD_RESPONSE:
    2083   00:4BBA  D5                      push    de
    2084   00:4BBB  DD E5                   push    ix
    2085   00:4BBD  57                      ld  d,a                         ; Command to wait in D
