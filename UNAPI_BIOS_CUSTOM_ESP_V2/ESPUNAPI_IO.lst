    4340   00:55C6  CB 47             >     bit 0,a
    4341   00:55C8  20 05                   jr  nz,SSH_OPEN_RC.1
    4342   00:55CA  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4343   00:55CD  18 F5                   jr  SSH_OPEN_RC
    4344   00:55CF                      SSH_OPEN_RC.1:
    4345   00:55CF                          ; nz, discard
    4346   00:55CF                          RECEIVE_DATA
    4346   00:55CF  DB 06             >     in a,(IN_DATA_PORT)
    4347   00:55D1  D1                      pop de                          ; restore memory area address in DE just in case it is needed
    4348   00:55D2  FE 84                   cp  132
    4349   00:55D4  28 24                   jr  z,SSH_OPEN_HOSTHASH
    4350   00:55D6  B7                      or  a                           ; 0?
    4351   00:55D7  C0                      ret nz
    4352   00:55D8                      
    4353   00:55D8                          ; next two bytes are size bytes, don't care, it is 1, conn #
    4354   00:55D8  06 02                   ld  b,2
    4355   00:55DA                      SSH_OPEN_ST2:
    4356   00:55DA                          CHECK_DATA
    4356   00:55DA  DB 07             >     in  a,(IN_STS_PORT)
    4356   00:55DC  CB 47             >     bit 0,a
    4357   00:55DE  20 05                   jr  nz,SSH_OPEN_ST2.1
