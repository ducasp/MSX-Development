    3504   00:5228  CB 47             >     bit 0,a
    3505   00:522A  20 05                   jr  nz,TCPIP_UDP_STATE_ST1.1
    3506   00:522C  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3507   00:522F  18 F5                   jr  TCPIP_UDP_STATE_ST1
    3508   00:5231                      TCPIP_UDP_STATE_ST1.1:
    3509   00:5231                          ; nz, check the data
