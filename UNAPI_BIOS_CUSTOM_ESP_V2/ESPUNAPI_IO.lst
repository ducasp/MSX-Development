    2818   00:4F0B                          CHECK_DATA
    2818   00:4F0B  DB 07             >     in  a,(IN_STS_PORT)
    2818   00:4F0D  CB 47             >     bit 0,a
    2819   00:4F0F  20 05                   jr  nz,TCPIP_GET_CAPAB_BLK3_ST3.1
    2820   00:4F11  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2821   00:4F14  18 F5                   jr  TCPIP_GET_CAPAB_BLK3_ST3
    2822   00:4F16                      TCPIP_GET_CAPAB_BLK3_ST3.1:
    2823   00:4F16                          ; nz, get it
