    4436   00:5632  DB 07             >     in  a,(IN_STS_PORT)
    4436   00:5634  CB 47             >     bit 0,a
    4437   00:5636  20 05                   jr  nz,SSH_OPEN_HOSTHASH_NSF.1
    4438   00:5638  CD AD 5A                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    4439   00:563B  18 F5                   jr  SSH_OPEN_HOSTHASH_NSF
    4440   00:563D                      SSH_OPEN_HOSTHASH_NSF.1:
    4441   00:563D                          if USE_MEM_IO = 0
    4442   00:563D  ED A2                   ini
    4443   00:563F                          else
