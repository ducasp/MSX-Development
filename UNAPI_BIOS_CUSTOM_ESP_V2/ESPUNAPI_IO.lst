    1044   00:44F7  B7                      or  a                           ; Is it zero?
    1045   00:44F8  20 0E                   jr  nz,CLK_AUTO_GMT_CHK_CSD1    ; If not, check for 1
    1046   00:44FA                          ; It was zero
    1047   00:44FA  3E 0A                   ld  a,10                        ; So, 10
    1048   00:44FC  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1049   00:44FF  DD 77 01                ld  (ix+1),a                    ; Save
    1050   00:4502  79                      ld  a,c
    1051   00:4503  CD A2 00                call    CHPUT                   ; Print it
