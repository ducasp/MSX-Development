    2811   00:4F05                          CHECK_DATA
    2811   00:4F05  DB 07             >     in  a,(IN_STS_PORT)
    2811   00:4F07  CB 47             >     bit 0,a
    2812   00:4F09  20 05                   jr  nz,TCPIP_GET_CAPAB_BLK3_ST2.1
    2813   00:4F0B  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2814   00:4F0E  18 F5                   jr  TCPIP_GET_CAPAB_BLK3_ST2
    2815   00:4F10                      TCPIP_GET_CAPAB_BLK3_ST2.1:
