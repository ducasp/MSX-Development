    1740   00:49D7                      
    1741   00:49D7                      WAIT_4S_AND_THEN_MAINMENU:
    1742   00:49D7  3E F0                   ld  a,240                       ; Wait 4 seconds with message on screen
    1743   00:49D9  18 02                   jr  WAIT_AND_THEN_MAINMENU
    1744   00:49DB                      WAIT_2S_AND_THEN_MAINMENU:
    1745   00:49DB  3E 78                   ld  a,120                       ; Wait 2 seconds with message on screen
    1746   00:49DD                      WAIT_AND_THEN_MAINMENU:
    1747   00:49DD  CD E5 49                call    WAIT_BEFORE_CONTINUING
    1748   00:49E0  C3 47 42                jp  ESPSETUP                    ; When done, back to main setup
    1749   00:49E3                      WAIT_250MS_AND_THEN_CONTINUE:
    1750   00:49E3  3E 0F                   ld  a,15                        ; Wait 250 ms then continue
    1751   00:49E5                      WAIT_BEFORE_CONTINUING:
    1752   00:49E5  76                      halt
    1753   00:49E6  3D                      dec a
    1754   00:49E7                          ; If not zero, our time out has not elapsed
    1755   00:49E7  20 FC                   jr  nz,WAIT_BEFORE_CONTINUING
    1756   00:49E9  C9                      ret                             ; Time out and continue
    1757   00:49EA                      
    1758   00:49EA                      ; Check Auto Clock
    1759   00:49EA                      ISCLKAUTO:
    1760   00:49EA                          CLEAR_UART
    1760   00:49EA  3E 14             >     ld  a,20
    1760   00:49EC  D3 06             >     out (OUT_CMD_PORT),a
    1761   00:49EE  3E 63                   ld  a,CMD_QUERY_ACLK_SETTINGS
    1762   00:49F0                          SEND_DATA
    1762   00:49F0  D3 07             >     out (OUT_TX_PORT),a
    1763   00:49F2  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1764   00:49F5  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1765   00:49F9  DD 6B                   ld  ixl,e
    1766   00:49FB  DD 62                   ld  ixh,d                       ; address in IX
    1767   00:49FD  CD 38 4B                call    WAIT_MENU_CMD_RESPONSE
    1768   00:4A00  CA F5 4A                jp  z,MENU_SUB_BAD_END
    1769   00:4A03                          ; Response received, IX+0 and IX+1 has Auto Clock and GMT, A
    1770   00:4A03  C9                      ret
    1771   00:4A04                      
    1772   00:4A04                      ; Check what is the current NAGLE setting
    1773   00:4A04                      CHECKNAGLE:
    1774   00:4A04                          CLEAR_UART
    1774   00:4A04  3E 14             >     ld  a,20
    1774   00:4A06  D3 06             >     out (OUT_CMD_PORT),a
    1775   00:4A08  3E 51                   ld  a,CMD_QUERY_ESP_SETTINGS
    1776   00:4A0A                          SEND_DATA
    1776   00:4A0A  D3 07             >     out (OUT_TX_PORT),a
    1777   00:4A0C  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1778   00:4A0F  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1779   00:4A13  DD 6B                   ld  ixl,e
    1780   00:4A15  DD 62                   ld  ixh,d                       ; Address in IX
    1781   00:4A17  CD 38 4B                call    WAIT_MENU_CMD_RESPONSE
    1782   00:4A1A  CA F5 4A                jp  z,MENU_SUB_BAD_END
    1783   00:4A1D                          ; Response received, nagle is the first one, ON: or OFF:
    1784   00:4A1D  3E 4F                   ld  a,'O'
    1785   00:4A1F  DD BE 00                cp  (ix+0)
    1786   00:4A22  C2 F5 4A                jp  nz,MENU_SUB_BAD_END
    1787   00:4A25  3E 4E                   ld  a,'N'
    1788   00:4A27  DD BE 01                cp  (ix+1)
    1789   00:4A2A  C2 37 4A                jp  nz,CHECK_NAGLE_OFF
    1790   00:4A2D  3E 3A                   ld  a,':'
    1791   00:4A2F  DD BE 02                cp  (ix+2)
    1792   00:4A32  C2 F5 4A                jp  nz,MENU_SUB_BAD_END
    1793   00:4A35  B7                      or  a                           ; It will make it NZ
    1794   00:4A36  C9                      ret
    1795   00:4A37                      CHECK_NAGLE_OFF:
    1796   00:4A37  3E 46                   ld  a,'F'
    1797   00:4A39  DD BE 01                cp  (ix+1)
    1798   00:4A3C  C2 F5 4A                jp  nz,MENU_SUB_BAD_END
    1799   00:4A3F  3E 46                   ld  a,'F'
    1800   00:4A41  DD BE 02                cp  (ix+2)
    1801   00:4A44  C2 F5 4A                jp  nz,MENU_SUB_BAD_END
    1802   00:4A47  3E 3A                   ld  a,':'
    1803   00:4A49  DD BE 03                cp  (ix+3)
    1804   00:4A4C  C2 F5 4A                jp  nz,MENU_SUB_BAD_END
    1805   00:4A4F                          ; Already has zero, so just ret
    1806   00:4A4F  C9                      ret
    1807   00:4A50                      
    1808   00:4A50                      ; Check what is the current TIMEOUT setting, return 0 if always on, otherwise there is a timeout
    1809   00:4A50                      ; Will return a zero terminated string @ HL that can be printed
    1810   00:4A50                      ; Will return the value in DE
    1811   00:4A50                      CHECKTIMEOUT:
    1812   00:4A50                          CLEAR_UART
    1812   00:4A50  3E 14             >     ld  a,20
    1812   00:4A52  D3 06             >     out (OUT_CMD_PORT),a
    1813   00:4A54  3E 51                   ld  a,CMD_QUERY_ESP_SETTINGS
    1814   00:4A56                          SEND_DATA
    1814   00:4A56  D3 07             >     out (OUT_TX_PORT),a
    1815   00:4A58  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1816   00:4A5B  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1817   00:4A5F  DD 6B                   ld  ixl,e
    1818   00:4A61  DD 62                   ld  ixh,d                       ; Address in IX
    1819   00:4A63  CD 38 4B                call    WAIT_MENU_CMD_RESPONSE
    1820   00:4A66  CA F5 4A                jp  z,MENU_SUB_BAD_END
    1821   00:4A69                          ; Response received, nagle is the first one, ON: or OFF:
    1822   00:4A69  3E 3A                   ld  a,':'
    1823   00:4A6B  DD 23                   inc ix
    1824   00:4A6D  DD 23                   inc ix                          ; Nagle response is two or three bytes long, let's check
    1825   00:4A6F  0B                      dec bc
    1826   00:4A70  0B                      dec bc                          ; Remaining bytes
    1827   00:4A71  DD BE 00                cp  (ix+0)
    1828   00:4A74  CA 80 4A                jp  z,CHECKTIMEOUT.1
    1829   00:4A77  DD 23                   inc ix
    1830   00:4A79  0B                      dec bc                          ; Remaining bytes
    1831   00:4A7A  DD BE 00                cp  (ix+0)
    1832   00:4A7D  C2 F5 4A                jp  nz,MENU_SUB_BAD_END         ; If not here, sorry to say it is an error
    1833   00:4A80                      CHECKTIMEOUT.1:
    1834   00:4A80  78                      ld  a,b
    1835   00:4A81  B1                      or  c                           ; All data read?
    1836   00:4A82  CA F5 4A                jp  z,MENU_SUB_BAD_END          ; If so, sorry to say it is an error
    1837   00:4A85  DD 23                   inc ix                          ; At the first digit
    1838   00:4A87  0B                      dec bc                          ; Remaining bytes
    1839   00:4A88  78                      ld  a,b
    1840   00:4A89  B1                      or  c                           ; All data read?
    1841   00:4A8A  CA F5 4A                jp  z,MENU_SUB_BAD_END          ; If so, sorry to say it is an error
    1842   00:4A8D  DD E5                   push    ix                      ; This is the start of the string, save it
    1843   00:4A8F  26 00                   ld  h,0                         ; No digit so far
    1844   00:4A91                          ; It can have up to three digits
    1845   00:4A91                      CHECKTIMEOUT.2:
    1846   00:4A91  3E 3A                   ld  a,':'
    1847   00:4A93  DD BE 00                cp  (ix+0)                      ; Check if it is the separator
    1848   00:4A96  CA B7 4A                jp  z,CHECKTIMEOUT.3            ; If it is routine will follow through
    1849   00:4A99  DD 7E 00                ld  a,(ix+0)                    ; Get the supposed digit in A
    1850   00:4A9C  2E 3A                   ld  l,'9'+1
    1851   00:4A9E  BD                      cp  l
    1852   00:4A9F  D2 F4 4A                jp  nc,MENU_SUB_BAD_END_1S      ; If more than '9', sorry to say it is an error
    1853   00:4AA2  2E 30                   ld  l,'0'
    1854   00:4AA4  BD                      cp  l
    1855   00:4AA5  DA F4 4A                jp  c,MENU_SUB_BAD_END_1S       ; If less than '0', sorry to say it is an error
    1856   00:4AA8  24                      inc h                           ; It is not, so it is a digit
    1857   00:4AA9  3E 03                   ld  a,3
    1858   00:4AAB  BC                      cp  h
    1859   00:4AAC  DA F4 4A                jp  c,MENU_SUB_BAD_END_1S       ; If more than three digits, sorry to say it is an error
    1860   00:4AAF  DD 23                   inc ix                          ; Increase pointer
    1861   00:4AB1  0B                      dec bc                          ; Decrease remaining
    1862   00:4AB2  78                      ld  a,b
    1863   00:4AB3  B1                      or  c                           ; All data read?
    1864   00:4AB4  C2 91 4A                jp  nz,CHECKTIMEOUT.2           ; Not, so rinse and repeat
    1865   00:4AB7                      CHECKTIMEOUT.3:
    1866   00:4AB7  DD 36 00 00             ld  (ix+0),0                    ; Null terminate string value
    1867   00:4ABB  DD 2B                   dec ix
    1868   00:4ABD  DD 7E 00                ld  a,(ix+0)                    ; 1st Digit in A
    1869   00:4AC0  D6 30                   sub '0'                         ; Convert it to decimal value
    1870   00:4AC2  5F                      ld  e,a
    1871   00:4AC3  16 00                   ld  d,0                         ; DE has first digit
    1872   00:4AC5  25                      dec h                           ; Decrement digit counter
    1873   00:4AC6  28 28                   jr  z,CHECKTIMEOUT.END          ; If all digits, done
    1874   00:4AC8                          ; Now second digit, multiply it by 10 and add to E, even if 90 + 9, still fits E
    1875   00:4AC8  DD 2B                   dec ix
    1876   00:4ACA  DD 7E 00                ld  a,(ix+0)                    ; 2nd Digit
    1877   00:4ACD  D6 30                   sub '0'                         ; Convert it to decimal value
    1878   00:4ACF  87                      add a,a                         ; A has *2
    1879   00:4AD0  4F                      ld  c,a                         ; C has *2
    1880   00:4AD1  87                      add a,a                         ; A has *4
    1881   00:4AD2  87                      add a,a                         ; A has *8
    1882   00:4AD3  81                      add a,c                         ; A has *10
    1883   00:4AD4  83                      add a,e                         ; A has two digits result
    1884   00:4AD5  5F                      ld  e,a                         ; Back to E, DE has two digits results
    1885   00:4AD6  25                      dec h                           ; Decrement digit counter
    1886   00:4AD7  28 17                   jr  z,CHECKTIMEOUT.END          ; If all digits, done
    1887   00:4AD9                          ; Now Third digit, multiply it by 100 and add to DE
    1888   00:4AD9  DD 2B                   dec ix
    1889   00:4ADB  DD 7E 00                ld  a,(ix+0)                    ; 3rd Digit
    1890   00:4ADE  D6 30                   sub '0'                         ; Convert it to decimal value
    1891   00:4AE0  87                      add a,a                         ; A has *2
    1892   00:4AE1  4F                      ld  c,a                         ; C has *2
    1893   00:4AE2  87                      add a,a                         ; A has *4
    1894   00:4AE3  87                      add a,a                         ; A has *8
    1895   00:4AE4  81                      add a,c                         ; A has *10
    1896   00:4AE5  26 00                   ld  h,0
    1897   00:4AE7  6F                      ld  l,a                         ; HL has *10
    1898   00:4AE8  29                      add hl,hl                       ; HL has *20
    1899   00:4AE9  44                      ld  b,h
    1900   00:4AEA  4D                      ld  c,l                         ; BC has *20
    1901   00:4AEB  29                      add hl,hl                       ; HL has *40
    1902   00:4AEC  29                      add hl,hl                       ; HL has *80
    1903   00:4AED  09                      add hl,bc                       ; HL has *100
    1904   00:4AEE  19                      add hl,de                       ; HL has three digit value
    1905   00:4AEF  EB                      ex  de,hl                       ; now in DE
    1906   00:4AF0                      CHECKTIMEOUT.END:
    1907   00:4AF0  E1                      pop hl                          ; Restore address of string version of time count
    1908   00:4AF1  7A                      ld  a,d
    1909   00:4AF2  B3                      or  e                           ; Set zero flag according to the time out set
    1910   00:4AF3  C9                      ret
    1911   00:4AF4                      
    1912   00:4AF4                      MENU_SUB_BAD_END_1S:
    1913   00:4AF4  F1                      pop af                          ; 1 register was stacked, pop it
    1914   00:4AF5                      MENU_SUB_BAD_END:
    1915   00:4AF5  F1                      pop af                          ; It was a sub, so clear stack
    1916   00:4AF6                      MENU_BAD_END:
    1917   00:4AF6  21 9B 6E                ld  hl,STR_SENDING_FAIL         ; error message
    1918   00:4AF9  CD 4C 4C                call    PRINTHL
    1919   00:4AFC  C3 DB 49                jp  WAIT_2S_AND_THEN_MAINMENU
    1920   00:4AFF                      
    1921   00:4AFF                      ; WAIT an ESP quick command Response
    1922   00:4AFF                      ; Inputs:
    1923   00:4AFF                      ; A -> Command Code
    1924   00:4AFF                      ; HL -> Timeout
    1925   00:4AFF                      ;
    1926   00:4AFF                      ; Returns:
    1927   00:4AFF                      ; Flag Z is zero if failure, non zero if success
    1928   00:4AFF                      ;
    1929   00:4AFF                      ; Affect:
    1930   00:4AFF                      ; AF and HL
    1931   00:4AFF                      ;
    1932   00:4AFF                      WAIT_MENU_QCMD_RESPONSE:
    1933   00:4AFF  D5                      push    de
    1934   00:4B00  57                      ld  d,a                         ; Command to wait in D
    1935   00:4B01                      WAIT_MENU_QCMD_RESPONSE_ST1:
    1936   00:4B01                          LOAD_STS_PORT_IN_A
    1936   00:4B01  DB 07             >     in  a,(IN_STS_PORT)
    1937   00:4B03  CB 6F                   bit 5,a                         ; If nz Port #07 is not available
    1938   00:4B05  C2 32 4B                jp  nz,WAIT_MENU_QCMD_RESPONSE_END_NOK
    1939   00:4B08  CB 47                   bit 0,a                         ; If nz has data
    1940   00:4B0A  20 08                   jr  nz,WAIT_MENU_QCMD_RESPONSE_ST1.1
    1941   00:4B0C  CD 46 4C                call    HLTIMEOUT
    1942   00:4B0F  20 F0                   jr  nz,WAIT_MENU_QCMD_RESPONSE_ST1
    1943   00:4B11  C3 30 4B                jp  WAIT_MENU_QCMD_RESPONSE_END ; If time out waiting, return
    1944   00:4B14                      WAIT_MENU_QCMD_RESPONSE_ST1.1:
    1945   00:4B14                          ; nz, check the data
    1946   00:4B14                          RECEIVE_DATA
    1946   00:4B14  DB 06             >     in a,(IN_DATA_PORT)
    1947   00:4B16  BA                      cp  d                           ; Is response of our command?
    1948   00:4B17  20 E8                   jr  nz,WAIT_MENU_QCMD_RESPONSE_ST1
    1949   00:4B19                          ; Now get return code, if return code other than 0, it is failure, otherwise success
    1950   00:4B19                      WAIT_MENU_QCMD_RESPONSE_RC:
    1951   00:4B19                          CHECK_DATA
    1951   00:4B19  DB 07             >     in  a,(IN_STS_PORT)
    1951   00:4B1B  CB 47             >     bit 0,a
    1952   00:4B1D  20 08                   jr  nz,WAIT_MENU_QCMD_RESPONSE_RC.1
    1953   00:4B1F  CD 46 4C                call    HLTIMEOUT
    1954   00:4B22  20 F5                   jr  nz,WAIT_MENU_QCMD_RESPONSE_RC
    1955   00:4B24  C3 30 4B                jp  WAIT_MENU_QCMD_RESPONSE_END ; If time-out waiting, return
    1956   00:4B27                      WAIT_MENU_QCMD_RESPONSE_RC.1:
    1957   00:4B27                          RECEIVE_DATA
    1957   00:4B27  DB 06             >     in a,(IN_DATA_PORT)
    1958   00:4B29  B7                      or  a                           ; 0?
    1959   00:4B2A                          ; If not, done
    1960   00:4B2A  C2 32 4B                jp  nz,WAIT_MENU_QCMD_RESPONSE_END_NOK
    1961   00:4B2D                      WAIT_MENU_QCMD_RESPONSE_END_OK:
    1962   00:4B2D  3E 01                   ld  a,1
    1963   00:4B2F  B7                      or  a                           ; NZ to indicate success
    1964   00:4B30                      WAIT_MENU_QCMD_RESPONSE_END:
    1965   00:4B30  D1                      pop de
    1966   00:4B31  C9                      ret
    1967   00:4B32                      WAIT_MENU_QCMD_RESPONSE_END_NOK:
    1968   00:4B32  21 00 00                ld  hl,0
    1969   00:4B35  AF                      xor a
    1970   00:4B36  D1                      pop de
    1971   00:4B37  C9                      ret
    1972   00:4B38                      
    1973   00:4B38                      ; WAIT an ESP regular command Response
    1974   00:4B38                      ; Inputs:
    1975   00:4B38                      ; A -> Command Code
    1976   00:4B38                      ; HL -> Timeout
    1977   00:4B38                      ; IX -> Where to store response
    1978   00:4B38                      ;
    1979   00:4B38                      ; Returns:
    1980   00:4B38                      ; Flag Z is zero if failure, non zero if success
    1981   00:4B38                      ; BC is the response size
