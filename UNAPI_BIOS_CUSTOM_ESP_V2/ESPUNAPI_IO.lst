    5509   00:5B3F  18 F5                   jr  TCPIP_TCP_RCV_ST2A
    5510   00:5B41                      TCPIP_TCP_RCV_ST2A.1:
    5511   00:5B41                          ; nz, high byte count of bytes to receive
    5512   00:5B41                          RECEIVE_DATA
    5512   00:5B41  DB 06             >     in a,(IN_DATA_PORT)
    5513   00:5B43  67                      ld h,a
