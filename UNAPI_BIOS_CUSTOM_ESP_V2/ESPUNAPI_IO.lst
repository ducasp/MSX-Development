    5698   00:5C2E                      SSH_RCV_ST2A.1:
    5699   00:5C2E                          ; nz, high byte count of bytes to receive
    5700   00:5C2E                          RECEIVE_DATA
    5700   00:5C2E  DB 06             >     in a,(IN_DATA_PORT)
    5701   00:5C30  67                      ld h,a
