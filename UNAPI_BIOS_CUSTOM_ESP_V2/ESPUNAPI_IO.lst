    2175   00:4C44  D1                      pop de
    2176   00:4C45  C9                      ret
    2177   00:4C46                      
    2178   00:4C46                      ; This routine will check if HL is 0, if it is, will return immediatelly
    2179   00:4C46                      ; If it is not, will decrease HL value and halt (wait one interrupt)
    2180   00:4C46                      HLTIMEOUT:
    2181   00:4C46  7C                      ld  a,h
    2182   00:4C47  B5                      or  l
    2183   00:4C48  C8                      ret z
    2184   00:4C49  2B                      dec hl
