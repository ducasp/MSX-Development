    1292   00:46AE  3E 0D                   ld  a,#0d
    1293   00:46B0  CD A2 00                call    CHPUT
    1294   00:46B3  3E 0A                   ld  a,#0a
    1295   00:46B5  CD A2 00                call    CHPUT
    1296   00:46B8  C3 FD 46                jp  WIFI_CONNECT_AP_PWDQ        ; And the rest is handled like if menu selected
    1297   00:46BB                      WIFI_CONNECT_ME_BS:
