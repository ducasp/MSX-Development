    1613   00:48CF                      ;===  SETUP Menu Routines  ==
    1614   00:48CF                      ;===      NAGLE Menu       ==
    1615   00:48CF                      ;============================
    1616   00:48CF                      SET_NAGLE:
    1617   00:48CF  3E 31                   ld  a,'1'
    1618   00:48D1  CD A2 00                call    CHPUT
    1619   00:48D4  CD DE 49                call    WAIT_250MS_AND_THEN_CONTINUE
    1620   00:48D7  21 A4 6D                ld  hl,MMENU_NAGLE
    1621   00:48DA  CD 47 4C                call    PRINTHL                 ; Print Main Nagle message
    1622   00:48DD  CD FF 49                call    CHECKNAGLE              ; Nagle is on or off?
    1623   00:48E0  20 1E                   jr  nz,NAGLE_IS_ON              ;
    1624   00:48E2  21 D9 6E                ld  hl,MMENU_NAGLE_OFF          ; Show the menu telling nagle is off
    1625   00:48E5  CD 47 4C                call    PRINTHL                 ; Print options
    1626   00:48E8                      SET_NAGLE_WI_ON:
    1627   00:48E8  CD 9F 00                call    CHGET
    1628   00:48EB  FE 1B                   cp  #1b                         ; ESC?
    1629   00:48ED  CA 46 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1630   00:48F0  FE 4F                   cp  'O'                         ; Toggle Nagle On
    1631   00:48F2  CA A3 49                jp  z,SET_NAGLE_ON              ;
    1632   00:48F5  FE 6F                   cp  'o'                         ; Toggle Nagle On
    1633   00:48F7  CA A3 49                jp  z,SET_NAGLE_ON              ;
    1634   00:48FA  CD C0 00                call    BEEP                    ; Wrong Input, beep
    1635   00:48FD  C3 E8 48                jp  SET_NAGLE_WI_ON             ; And return waiting key
    1636   00:4900                      
    1637   00:4900                      NAGLE_IS_ON:
    1638   00:4900  21 99 6E                ld  hl,MMENU_NAGLE_ON           ; Show the menu telling nagle is on
    1639   00:4903  CD 47 4C                call    PRINTHL                 ; Print options
    1640   00:4906                      SET_NAGLE_WI_OFF:
    1641   00:4906  CD 9F 00                call    CHGET
    1642   00:4909  FE 1B                   cp  #1b                         ; ESC?
    1643   00:490B  CA 46 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1644   00:490E  FE 4F                   cp  'O'                         ; Toggle Nagle Off
    1645   00:4910  CA 58 49                jp  z,SET_NAGLE_OFF             ;
    1646   00:4913  FE 6F                   cp  'o'                         ; Toggle Nagle Off
    1647   00:4915  CA 58 49                jp  z,SET_NAGLE_OFF             ;
    1648   00:4918  CD C0 00                call    BEEP                    ; Wrong Input, beep
    1649   00:491B  C3 06 49                jp  SET_NAGLE_WI_OFF            ; And return waiting key
    1650   00:491E                      
    1651   00:491E                      ;============================
    1652   00:491E                      ;===  SETUP Menu Routines  ==
    1653   00:491E                      ;===  Auxiliary Functions  ==
    1654   00:491E                      ;============================
    1655   00:491E                      SET_ESP_WIFI_TIMEOUT:
    1656   00:491E  EB                      ex  de,hl
    1657   00:491F  3E 0D                   ld  a,#0d
    1658   00:4921  CD A2 00                call    CHPUT
    1659   00:4924  3E 0A                   ld  a,#0a
    1660   00:4926  CD A2 00                call    CHPUT
    1661   00:4929  21 1A 6F                ld  hl,STR_SENDING              ; Indicate it is sending a command
    1662   00:492C  CD 47 4C                call    PRINTHL
    1663   00:492F                          CLEAR_UART
    1663   00:492F  3E 14             >     ld  a,20
    1663   00:4931  D3 06             >     out (OUT_CMD_PORT),a
    1664   00:4933  3E 54                   ld  a,CMD_TIMER_SET
    1665   00:4935                          SEND_DATA
    1665   00:4935  D3 07             >     out (OUT_TX_PORT),a
    1666   00:4937  AF                      xor a                           ; Size MSB is 0
    1667   00:4938                          SEND_DATA
    1667   00:4938  D3 07             >     out (OUT_TX_PORT),a
    1668   00:493A  3E 02                   ld  a,2                         ; Size LSB is 2
    1669   00:493C                          SEND_DATA
    1669   00:493C  D3 07             >     out (OUT_TX_PORT),a
    1670   00:493E  7A                      ld  a,d                         ; Timeout MSB
    1671   00:493F                          SEND_DATA
    1671   00:493F  D3 07             >     out (OUT_TX_PORT),a
    1672   00:4941  7B                      ld  a,e                         ; Timeout LSB
    1673   00:4942                          SEND_DATA
    1673   00:4942  D3 07             >     out (OUT_TX_PORT),a
    1674   00:4944  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1675   00:4947  3E 54                   ld  a,CMD_TIMER_SET             ; Our command
