    3942   00:5438                      ;========================
    3943   00:5438                      ;===  TCPIP_TCP_OPEN  ===
    3944   00:5438                      ;========================
    3945   00:5438                      ;Open a TCP connection.
    3946   00:5438                      ;
    3947   00:5438                      ;Input:  A  = 13
    3948   00:5438                      ;        HL = Address of parameters block
    3949   00:5438                      ;Output: A = Error code
    3950   00:5438                      ;        B = Connection number
    3951   00:5438                      ;        C = Connection not open reason (mostly for TLS)
    3952   00:5438                      ;
    3953   00:5438                      ;Parameters block format:
    3954   00:5438                      ;
    3955   00:5438                      ;+0 (4): Remote IP address (0.0.0.0 for unspecified remote socket)
    3956   00:5438                      ;+4 (2): Remote port (ignored if unspecified remote socket)
    3957   00:5438                      ;+6 (2): Local port, 0FFFFh for a random value
    3958   00:5438                      ;+8 (2): Suggestion for user timeout value
    3959   00:5438                      ;+10 (1): Flags:
    3960   00:5438                      ;         bit 0: Set for passive connection
    3961   00:5438                      ;         bit 1: Set for resident connection
    3962   00:5438                      ;         bit 2: Set for TLS connection
    3963   00:5438                      ;         bit 3: Set for TLS connection validating host certificate
    3964   00:5438                      ;+11 (2): If 0000 no host name validation, otherwise the hostname string address (zero terminated)
    3965   00:5438                      ;TCP_OPEN_IP1               (ix+0)
    3966   00:5438                      ;TCP_OPEN_IP2               (ix+1)
    3967   00:5438                      ;TCP_OPEN_IP3               (ix+2)
    3968   00:5438                      ;TCP_OPEN_IP4               (ix+3)
    3969   00:5438                      ;TCP_OPEN_RP                (ix+4)
    3970   00:5438                      ;TCP_OPEN_LP                (ix+6)
    3971   00:5438                      ;TCP_OPEN_TO                (ix+8)
    3972   00:5438                      ;TCP_OPEN_CMD_FLAGS         (ix+10)
    3973   00:5438                      ;TCP_OPEN_CMD_HOST_LSB      (ix+11)
    3974   00:5438                      ;TCP_OPEN_CMD_HOST_MSB      (ix+12)
    3975   00:5438                      
    3976   00:5438                      ; When no connection, let's get the reason and put in register C, as agreed
    3977   00:5438                      ; with Nestor this will be the way to go in the next UNAPI revision
    3978   00:5438                      TCPIP_TCP_OPEN_ERROR:
    3979   00:5438                          ; next two bytes are return code and size bytes, don't care, it is 1, conn close reason
    3980   00:5438  47                      ld  b,a                         ; save error in b
    3981   00:5439  0E 02                   ld  c,2
    3982   00:543B                      TCPIP_TCP_OPEN_ERROR2:
    3983   00:543B                          CHECK_DATA
    3983   00:543B  DB 07             >     in  a,(IN_STS_PORT)
    3983   00:543D  CB 47             >     bit 0,a
    3984   00:543F  20 05                   jr  nz,TCPIP_TCP_OPEN_ERROR2.1
    3985   00:5441  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3986   00:5444  18 F5                   jr  TCPIP_TCP_OPEN_ERROR2
    3987   00:5446                      TCPIP_TCP_OPEN_ERROR2.1:
    3988   00:5446                          ; nz, discard
    3989   00:5446                          RECEIVE_DATA
    3989   00:5446  DB 06             >     in a,(IN_DATA_PORT)
    3990   00:5448  0D                      dec c
    3991   00:5449  20 F0                   jr  nz,TCPIP_TCP_OPEN_ERROR2
    3992   00:544B  78                      ld  a,b
    3993   00:544C  FE 0B                   cp  ERR_NO_CONN
    3994   00:544E  20 0E                   jr  nz,TCPIP_TCP_OPEN_ERROR4    ; other errors do not have extra bytes as result
    3995   00:5450                      ; now just get the 1 byte, close reason, should go to C
    3996   00:5450                      TCPIP_TCP_OPEN_ERROR3:
    3997   00:5450                          CHECK_DATA
    3997   00:5450  DB 07             >     in  a,(IN_STS_PORT)
    3997   00:5452  CB 47             >     bit 0,a
    3998   00:5454  20 05                   jr  nz,TCPIP_TCP_OPEN_ERROR3.1
    3999   00:5456  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4000   00:5459  18 F5                   jr  TCPIP_TCP_OPEN_ERROR3
    4001   00:545B                      TCPIP_TCP_OPEN_ERROR3.1:
    4002   00:545B                          ; nz, get it
    4003   00:545B                          RECEIVE_DATA
    4003   00:545B  DB 06             >     in a,(IN_DATA_PORT)
    4004   00:545D  4F                      ld  c,a
    4005   00:545E                      TCPIP_TCP_OPEN_ERROR4:
    4006   00:545E                          ; now return w/ error that is saved in b
    4007   00:545E  78                      ld  a,b
    4008   00:545F  06 00                   ld  b,0                         ; no connection, so 0
    4009   00:5461  C9                      ret
    4010   00:5462                      
    4011   00:5462                      TCPIP_TCP_OPEN:
    4012   00:5462  E5                      push    hl                      ; save param block address
    4013   00:5463  7C                      ld  a,h
    4014   00:5464  DD 67                   ld  ixh,a
    4015   00:5466  7D                      ld  a,l
    4016   00:5467  DD 6F                   ld  ixl,a
    4017   00:5469                          ; IX now has the parameters area
    4018   00:5469                          ; most times it will be non tls, so this is the first test case
    4019   00:5469  21 0B 00                ld  hl,11
    4020   00:546C  CD 35 5F                call    SETWORD                 ; If it is non-TLS, send 11 bytes
    4021   00:546F  DD 7E 0A                ld  a,(ix+10)                   ; TCP_OPEN_CMD_FLAGS
    4022   00:5472  CB 57                   bit 2,a
    4023   00:5474  28 5A                   jr  z,TCPIP_TCP_OPEN_NO_TLS
    4024   00:5476                      
    4025   00:5476                          ; TLS, but, do we have host name?
    4026   00:5476  21 0C 00                ld  hl,12
    4027   00:5479  CD 35 5F                call    SETWORD                 ; If it is TLS without host name, send 12 bytes, one zero as host name suffice
    4028   00:547C  DD 6E 0B                ld  l,(ix+11)                   ; TCP_OPEN_CMD_HOST_LSB
    4029   00:547F  DD 7E 0C                ld  a,(ix+12)                   ; TCP_OPEN_CMD_HOST_MSB
    4030   00:5482  B5                      or  l
    4031   00:5483                          ; if TLS and next two bytes are 00 no host to check
    4032   00:5483  28 4B                   jr  z,TCPIP_TCP_OPEN_NO_CHECKHOST
    4033   00:5485                          ; we are here, host to check
    4034   00:5485  DD 66 0C                ld  h,(ix+12)                   ; TCP_OPEN_CMD_HOST_MSB
    4035   00:5488  D1                      pop de                          ; Retrieve parameters address
    4036   00:5489  E5                      push    hl                      ; Save host name address
    4037   00:548A  D5                      push    de                      ; Save Parameters address (so it is in the order we are going to need)
    4038   00:548B                          ; let's check how many bytes there are
    4039   00:548B  11 0B 00                ld  de,11                       ; Start with 11, all params except host name
    4040   00:548E                      TCPIP_TCP_OPEN_CHECK_HOSTOF:
    4041   00:548E  7E                      ld  a,(hl)
    4042   00:548F  13                      inc de                          ; Not zero, so increase size count
    4043   00:5490  23                      inc hl                          ; And next hostname byte
    4044   00:5491  B7                      or  a                           ; If zero, hostname terminated
    4045   00:5492                          ; Loop until terminator (0) is found
    4046   00:5492  C2 8E 54                jp  nz,TCPIP_TCP_OPEN_CHECK_HOSTOF
    4047   00:5495                      
    4048   00:5495                      TCPIP_TCP_OPEN_HOSTNAME_SENDCMDWITHHOSTNAME:
    4049   00:5495                          ; Ok, so, DE has the full hostname size, let's start sending from here
    4050   00:5495  3E 0D                   ld  a,13                        ; Function TCP OPEN
    4051   00:5497                          SEND_DATA                       ; Send the command
    4051   00:5497  D3 07             >     out (OUT_TX_PORT),a
    4052   00:5499  7A                      ld  a,d
    4053   00:549A                          SEND_DATA                       ; Send the command size msb
    4053   00:549A  D3 07             >     out (OUT_TX_PORT),a
    4054   00:549C  7B                      ld  a,e
    4055   00:549D                          SEND_DATA                       ; Send the command size lsb
    4055   00:549D  D3 07             >     out (OUT_TX_PORT),a
    4056   00:549F  E1                      pop hl                          ; Restore the memory address for the parameters
    4057   00:54A0                          ; First send the 11 bytes parameters
    4058   00:54A0                          if USE_MEM_IO = 0
    4059   00:54A0  0E 07                   ld  c,OUT_TX_PORT
    4060   00:54A2  ED A3                   outi
    4061   00:54A4  ED A3                   outi
    4062   00:54A6  ED A3                   outi
    4063   00:54A8  ED A3                   outi
    4064   00:54AA  ED A3                   outi
    4065   00:54AC  ED A3                   outi
    4066   00:54AE  ED A3                   outi
    4067   00:54B0  ED A3                   outi
    4068   00:54B2  ED A3                   outi
    4069   00:54B4  ED A3                   outi
    4070   00:54B6  ED A3                   outi                            ; Unrolled outi is a bit faster :)
    4071   00:54B8                          else
    4072   00:54B8                    ~     ld  b,11                        ; Send 11 bytes
    4073   00:54B8                    ~ TCPIP_TCP_OPEN_HOSTNAME_SENDCMDWITHHOSTNAME_LOOP_PARAM:
    4074   00:54B8                    ~     ld  a,(hl)
    4075   00:54B8                    ~     ld  (MEM_OUT_TX_PORT),a
    4076   00:54B8                    ~     inc hl
    4077   00:54B8                    ~     djnz TCPIP_TCP_OPEN_HOSTNAME_SENDCMDWITHHOSTNAME_LOOP_PARAM
    4078   00:54B8                    ~     endif
    4079   00:54B8  EB                      ex  de,hl                       ; Size in HL
    4080   00:54B9  11 0B 00                ld  de,11
    4081   00:54BC  B7                      or  a                           ; zero flag
    4082   00:54BD  ED 52                   sbc hl,de
    4083   00:54BF  EB                      ex de,hl                        ; and adjusted size back in de
    4084   00:54C0  E1                      pop hl                          ; Restore the memory address for hostname
    4085   00:54C1                      ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    4086   00:54C1  43                      ld  b,e                         ; Number of loops originaly in DE
    4087   00:54C2  1B                      dec de
    4088   00:54C3  14                      inc d
    4089   00:54C4                          if USE_MEM_IO = 0
    4090   00:54C4  0E 07                   ld  c,OUT_TX_PORT
    4091   00:54C6                      TCPIP_TCP_OPEN_SENDHOSTNAME:
    4092   00:54C6  ED A3                   outi
    4093   00:54C8  20 FC                   jr  nz,TCPIP_TCP_OPEN_SENDHOSTNAME
    4094   00:54CA                          else
    4095   00:54CA                    ~ TCPIP_TCP_OPEN_SENDHOSTNAME:
    4096   00:54CA                    ~     ld  a,(hl)
    4097   00:54CA                    ~     ld  (MEM_OUT_TX_PORT),a
    4098   00:54CA                    ~     inc hl
    4099   00:54CA                    ~     djnz TCPIP_TCP_OPEN_SENDHOSTNAME
    4100   00:54CA                    ~     endif
    4101   00:54CA  15                      dec d
    4102   00:54CB  20 F9                   jr  nz,TCPIP_TCP_OPEN_SENDHOSTNAME
    4103   00:54CD  C3 EC 54                jp  TCPIP_TCP_OPEN_WAIT_RESPONSE
    4104   00:54D0                      
    4105   00:54D0                      TCPIP_TCP_OPEN_NO_TLS:
    4106   00:54D0                      TCPIP_TCP_OPEN_NO_CHECKHOST:
    4107   00:54D0  3E 0D                   ld  a,13                        ; Function TCP OPEN
    4108   00:54D2                          SEND_DATA                       ; Send the command
    4108   00:54D2  D3 07             >     out (OUT_TX_PORT),a
    4109   00:54D4  CD 22 5F                call    GETWORD
    4110   00:54D7  7C                      ld  a,h
    4111   00:54D8  57                      ld  d,a
    4112   00:54D9                          SEND_DATA                       ; Send the command size msb
    4112   00:54D9  D3 07             >     out (OUT_TX_PORT),a
    4113   00:54DB  7D                      ld  a,l
    4114   00:54DC  5F                      ld  e,a
    4115   00:54DD                          SEND_DATA                       ; Send the command size lsb
    4115   00:54DD  D3 07             >     out (OUT_TX_PORT),a
    4116   00:54DF                      
    4117   00:54DF  E1                      pop hl                          ; Restore the memory address for the parameters
    4118   00:54E0                      ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    4119   00:54E0  43                      ld  b,e                         ; Number of loops originaly in DE
    4120   00:54E1  1B                      dec de
    4121   00:54E2  14                      inc d
    4122   00:54E3                          if USE_MEM_IO = 0
    4123   00:54E3  0E 07                   ld  c,OUT_TX_PORT
    4124   00:54E5                      TCPIP_TCP_OPEN_R:
    4125   00:54E5  ED A3                   outi
    4126   00:54E7  20 FC                   jr  nz,TCPIP_TCP_OPEN_R
    4127   00:54E9                          else
    4128   00:54E9                    ~ TCPIP_TCP_OPEN_R:
    4129   00:54E9                    ~     ld  a,(hl)
    4130   00:54E9                    ~     ld  (MEM_OUT_TX_PORT),a
    4131   00:54E9                    ~     inc hl
    4132   00:54E9                    ~     djnz TCPIP_TCP_OPEN_R
    4133   00:54E9                    ~     endif
    4134   00:54E9  15                      dec d
    4135   00:54EA  20 F9                   jr  nz,TCPIP_TCP_OPEN_R
    4136   00:54EC                      
    4137   00:54EC                      TCPIP_TCP_OPEN_WAIT_RESPONSE:
    4138   00:54EC                          ; Now wait up to 3600 (1 minute @ 60Hz) ticks to get response
    4139   00:54EC                          ; TLS Connections might take SEVERAL seconds on TLS Handshake
    4140   00:54EC                          ; Even more if certificates database is being indexed
    4141   00:54EC  21 10 0E                ld  hl,3600
    4142   00:54EF  CD EC 5E                call    SETCOUNTER
    4143   00:54F2                      TCPIP_TCP_OPEN_ST1:
    4144   00:54F2                          CHECK_DATA
    4144   00:54F2  DB 07             >     in  a,(IN_STS_PORT)
    4144   00:54F4  CB 47             >     bit 0,a
