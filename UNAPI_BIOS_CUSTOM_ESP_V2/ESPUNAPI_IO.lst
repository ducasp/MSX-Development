    5390   00:5AC6  78                      ld  a,b
    5391   00:5AC7                          SEND_DATA                       ; Send the connection #
    5391   00:5AC7  D3 07             >     out (OUT_TX_PORT),a
    5392   00:5AC9  7D                      ld  a,l
    5393   00:5ACA                          SEND_DATA                       ; Send MAX rcv size LSB
    5393   00:5ACA  D3 07             >     out (OUT_TX_PORT),a
    5394   00:5ACC  7C                      ld  a,h
    5395   00:5ACD                          SEND_DATA                       ; Send MAX rcv size MSB
    5395   00:5ACD  D3 07             >     out (OUT_TX_PORT),a
    5396   00:5ACF  3E 03                   ld  a,3
    5397   00:5AD1  CD E2 5C                call    SETBYTE                 ; Ok, retry up to three times
    5398   00:5AD4                      SSH_RCV.RXRETRY:
    5399   00:5AD4                          ; Now wait up to 600 ticks to get response
    5400   00:5AD4  21 58 02                ld  hl,600
    5401   00:5AD7  CD C0 5C                call    SETCOUNTER
    5402   00:5ADA                      SSH_RCV_ST1:
    5403   00:5ADA                          CHECK_DATA
    5403   00:5ADA  DB 07             >     in  a,(IN_STS_PORT)
    5403   00:5ADC  CB 47             >     bit 0,a
    5404   00:5ADE  20 05                   jr  nz,SSH_RCV_ST1.1
    5405   00:5AE0  CD 98 59                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5406   00:5AE3  18 F5                   jr  SSH_RCV_ST1
    5407   00:5AE5                      SSH_RCV_ST1.1:
    5408   00:5AE5                          ; nz, check the data
    5409   00:5AE5                          RECEIVE_DATA
    5409   00:5AE5  DB 06             >     in a,(IN_DATA_PORT)
    5410   00:5AE7  FE 86                   cp #86                          ; Is response of our command?
    5411   00:5AE9  20 EF                   jr  nz,SSH_RCV_ST1
    5412   00:5AEB                          ; At this point, all data is being buffered, so 15 ticks, quarter second, is more than enough time-out
    5413   00:5AEB  F3                      di
    5414   00:5AEC  21 1E 00                ld  hl,30
    5415   00:5AEF  CD C0 5C                call    SETCOUNTER
    5416   00:5AF2  FB                      ei
    5417   00:5AF3                          ; now get return code, if return code other than 0, it is finished
    5418   00:5AF3                      SSH_RCV_RC:
    5419   00:5AF3                          CHECK_DATA
    5419   00:5AF3  DB 07             >     in  a,(IN_STS_PORT)
    5419   00:5AF5  CB 47             >     bit 0,a
    5420   00:5AF7  20 05                   jr  nz,SSH_RCV_RC.1
    5421   00:5AF9  CD 98 59                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5422   00:5AFC  18 F5                   jr  SSH_RCV_RC
    5423   00:5AFE                      SSH_RCV_RC.1:
    5424   00:5AFE                          ; nz, discard
    5425   00:5AFE                          RECEIVE_DATA
    5425   00:5AFE  DB 06             >     in a,(IN_DATA_PORT)
    5426   00:5B00  B7                      or  a                           ; 0?
    5427   00:5B01  28 04                   jr  z,SSH_RCV_ST2A              ; if not, done
    5428   00:5B03  01 00 00                ld  bc,0                        ; no data received
    5429   00:5B06  C9                      ret
    5430   00:5B07                          ; next two bytes are response size bytes save it to BC
    5431   00:5B07                      SSH_RCV_ST2A:
    5432   00:5B07                          CHECK_DATA
    5432   00:5B07  DB 07             >     in  a,(IN_STS_PORT)
    5432   00:5B09  CB 47             >     bit 0,a
    5433   00:5B0B  20 05                   jr  nz,SSH_RCV_ST2A.1
    5434   00:5B0D  CD 98 59                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5435   00:5B10  18 F5                   jr  SSH_RCV_ST2A
    5436   00:5B12                      SSH_RCV_ST2A.1:
    5437   00:5B12                          ; nz, high byte count of bytes to receive
    5438   00:5B12                          RECEIVE_DATA
    5438   00:5B12  DB 06             >     in a,(IN_DATA_PORT)
    5439   00:5B14  67                      ld h,a
    5440   00:5B15                      SSH_RCV_ST2B:
    5441   00:5B15                          CHECK_DATA
    5441   00:5B15  DB 07             >     in  a,(IN_STS_PORT)
    5441   00:5B17  CB 47             >     bit 0,a
    5442   00:5B19  20 05                   jr  nz,SSH_RCV_ST2B.1
    5443   00:5B1B  CD 98 59                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5444   00:5B1E  18 F5                   jr  SSH_RCV_ST2B
    5445   00:5B20                      SSH_RCV_ST2B.1:
    5446   00:5B20                          ; nz, low byte count of bytes to receive
    5447   00:5B20                          RECEIVE_DATA
    5447   00:5B20  DB 06             >     in a,(IN_DATA_PORT)
    5448   00:5B22  6F                      ld  l,a
    5449   00:5B23  B4                      or  h
    5450   00:5B24                          ; if it was 0, no data
    5451   00:5B24                          if USE_MEM_IO = 1
    5452   00:5B24                    ~     jp  z,TCPIP_TCP_RCV_RET_NODATA  ; not a typo, no need to make the same code again
    5453   00:5B24                    ~     else
    5454   00:5B24  CA CD 59                jp  z,TCPIP_TCP_RCV_RET_NODATA  ; not a typo, no need to make the same code again
    5455   00:5B27                          endif
    5456   00:5B27  4D                      ld  c,l
    5457   00:5B28  44                      ld  b,h                         ; BC has effective received data size, as well as HL
    5458   00:5B29                      
    5459   00:5B29                          ; put effective data size in de
    5460   00:5B29  EB                      ex  de,hl
    5461   00:5B2A                          ; will start moving at address in stack (we've pushed the adress in WORD)
    5462   00:5B2A  CD F6 5C                call    GETWORD
    5463   00:5B2D  CD 69 5D                call    BCBACKUP                ; save count (BC)
    5464   00:5B30                      
    5465   00:5B30                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use ini :-D
    5466   00:5B30  43                      ld  b,e                         ; Number of loops originaly in DE
    5467   00:5B31  1B                      dec de
    5468   00:5B32  14                      inc d
    5469   00:5B33                          if USE_MEM_IO = 0
    5470   00:5B33  0E 06                   ld  c,IN_DATA_PORT
    5471   00:5B35                          CHECK_QUICK_RECEIVE
    5471   00:5B35  3A 07 00          >     ld  a,(IN_STS_PORT)
    5471   00:5B38  CB 5F             >     bit 3,a
    5472   00:5B3A  28 14                   jr  z,SSH_RCV_R_NSF             ; If not, go to the old, slower route
    5473   00:5B3C                          ; Otherwise, let's speed it up baby!
    5474   00:5B3C                      SSH_RCV_R:
    5475   00:5B3C  ED B2                   inir
    5476   00:5B3E                          else
    5477   00:5B3E                    ~     CHECK_QUICK_RECEIVE
    5478   00:5B3E                    ~     jr  z,SSH_RCV_R_NSF       ; If not, go to the old, slower route
    5479   00:5B3E                    ~     ; Otherwise, let's speed it up baby!
    5480   00:5B3E                    ~ SSH_RCV_R:
    5481   00:5B3E                    ~     ld  a,(MEM_IN_DATA_PORT)
    5482   00:5B3E                    ~     ld  (hl),a
    5483   00:5B3E                    ~     inc hl
    5484   00:5B3E                    ~     djnz SSH_RCV_R
    5485   00:5B3E                    ~     endif
    5486   00:5B3E  15                      dec d
    5487   00:5B3F  20 FB                   jr nz,SSH_RCV_R
    5488   00:5B41                          CHECK_BUFFER_UNDERRUN
    5488   00:5B41  DB 07             >     in  a,(IN_STS_PORT)
    5488   00:5B43  CB 67             >     bit 4,a
    5489   00:5B45  C2 A2 5A                jp  nz,SSH_RCV_RETRY_QRCV ; If yes, retry
    5490   00:5B48                          ; Otherwise, done
    5491   00:5B48  CD 57 5D                call    BCRESTORE               ; done, restore return data in BC
    5492   00:5B4B                          ; no urgent data support
    5493   00:5B4B  21 00 00                ld  hl,0
    5494   00:5B4E  AF                      xor a
    5495   00:5B4F  C9                      ret
    5496   00:5B50                      SSH_RCV_R_NSF:
    5497   00:5B50                          CHECK_DATA
    5497   00:5B50  DB 07             >     in  a,(IN_STS_PORT)
    5497   00:5B52  CB 47             >     bit 0,a
    5498   00:5B54  20 05                   jr  nz,SSH_RCV_R_NSF.1
    5499   00:5B56  CD 98 59                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5500   00:5B59  18 F5                   jr  SSH_RCV_R_NSF
    5501   00:5B5B                      SSH_RCV_R_NSF.1:
    5502   00:5B5B                          if USE_MEM_IO = 0
    5503   00:5B5B  ED A2                   ini
    5504   00:5B5D                          else
    5505   00:5B5D                    ~     ld  a,(MEM_IN_DATA_PORT)
    5506   00:5B5D                    ~     ld  (hl),a
    5507   00:5B5D                    ~     inc hl
    5508   00:5B5D                    ~     dec b
    5509   00:5B5D                    ~     endif
    5510   00:5B5D  20 F1                   jr  nz,SSH_RCV_R_NSF
    5511   00:5B5F  15                      dec d
    5512   00:5B60  20 EE                   jr nz,SSH_RCV_R_NSF
    5513   00:5B62  CD 57 5D                call    BCRESTORE               ; done, restore return data in BC
    5514   00:5B65                          ; no urgent data support
    5515   00:5B65  21 00 00                ld  hl,0
    5516   00:5B68  AF                      xor a
    5517   00:5B69  C9                      ret
    5518   00:5B6A                      
    5519   00:5B6A                      ;=============================
    5520   00:5B6A                      ;===  TCPIP_CONFIG_AUTOIP  ===
    5521   00:5B6A                      ;=============================
    5522   00:5B6A                      ;Enable or disable the automatic IP addresses retrieval.
    5523   00:5B6A                      ;
    5524   00:5B6A                      ;Input:  A = 25
    5525   00:5B6A                      ;        B = 0: Get current configuration
    5526   00:5B6A                      ;            1: Set configuration
    5527   00:5B6A                      ;        C = Configuration to set (only if B=1):
    5528   00:5B6A                      ;            bit 0: Set to automatically retrieve
    5529   00:5B6A                      ;                   local IP address, subnet mask and default gateway
    5530   00:5B6A                      ;            bit 1: Set to automatically retrieve DNS servers addresses
    5531   00:5B6A                      ;            bits 2-7: Unused, must be zero
    5532   00:5B6A                      ;Output: A = Error code
    5533   00:5B6A                      ;        C = Configuration after the routine execution
    5534   00:5B6A                      ;            (same format as C at input)
    5535   00:5B6A                      TCPIP_CONFIG_AUTOIP:
    5536   00:5B6A                          SEND_DATA                       ; Send the command
    5536   00:5B6A  D3 07             >     out (OUT_TX_PORT),a
    5537   00:5B6C  AF                      xor a
    5538   00:5B6D                          SEND_DATA                       ; Send the command size msb
    5538   00:5B6D  D3 07             >     out (OUT_TX_PORT),a
    5539   00:5B6F  3E 02                   ld  a,2
    5540   00:5B71                          SEND_DATA                       ; Send the command size lsb
    5540   00:5B71  D3 07             >     out (OUT_TX_PORT),a
    5541   00:5B73  78                      ld  a,b
    5542   00:5B74                          SEND_DATA                       ; Send the command
    5542   00:5B74  D3 07             >     out (OUT_TX_PORT),a
    5543   00:5B76  79                      ld  a,c
    5544   00:5B77                          SEND_DATA                       ; Send the command parameter
    5544   00:5B77  D3 07             >     out (OUT_TX_PORT),a
    5545   00:5B79                      
    5546   00:5B79                          ; Now wait up to 180 ticks to get response
    5547   00:5B79  21 B4 00                ld hl,180
    5548   00:5B7C  CD C0 5C                call    SETCOUNTER
    5549   00:5B7F                      TCPIP_CONFIG_AUTOIP_ST1:
    5550   00:5B7F                          CHECK_DATA
    5550   00:5B7F  DB 07             >     in  a,(IN_STS_PORT)
    5550   00:5B81  CB 47             >     bit 0,a
    5551   00:5B83  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_ST1.1
    5552   00:5B85  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5553   00:5B88  18 F5                   jr  TCPIP_CONFIG_AUTOIP_ST1
    5554   00:5B8A                      TCPIP_CONFIG_AUTOIP_ST1.1:
    5555   00:5B8A                          ; nz, check the data
    5556   00:5B8A                          RECEIVE_DATA
    5556   00:5B8A  DB 06             >     in a,(IN_DATA_PORT)
    5557   00:5B8C  FE 19                   cp  25                          ; Is response of our command?
    5558   00:5B8E  20 EF                   jr  nz,TCPIP_CONFIG_AUTOIP_ST1
    5559   00:5B90                          ; now get return code, if return code other than 0, it is finished
    5560   00:5B90                      TCPIP_CONFIG_AUTOIP_RC:
    5561   00:5B90                          CHECK_DATA
    5561   00:5B90  DB 07             >     in  a,(IN_STS_PORT)
    5561   00:5B92  CB 47             >     bit 0,a
    5562   00:5B94  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_RC.1
    5563   00:5B96  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5564   00:5B99  18 F5                   jr  TCPIP_CONFIG_AUTOIP_RC
    5565   00:5B9B                      TCPIP_CONFIG_AUTOIP_RC.1:
    5566   00:5B9B                          ;nz, discard
    5567   00:5B9B                          RECEIVE_DATA
    5567   00:5B9B  DB 06             >     in a,(IN_DATA_PORT)
    5568   00:5B9D  B7                      or  a                           ; 0?
    5569   00:5B9E  C0                      ret nz                          ; if not, done
    5570   00:5B9F                      
    5571   00:5B9F                          ; next two bytes are return code and size bytes, don't care, it is 1, configuration
    5572   00:5B9F  06 02                   ld  b,2
    5573   00:5BA1                      TCPIP_CONFIG_AUTOIP_ST2:
    5574   00:5BA1                          CHECK_DATA
    5574   00:5BA1  DB 07             >     in  a,(IN_STS_PORT)
    5574   00:5BA3  CB 47             >     bit 0,a
    5575   00:5BA5  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_ST2.1
    5576   00:5BA7  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5577   00:5BAA  18 F5                   jr  TCPIP_CONFIG_AUTOIP_ST2
    5578   00:5BAC                      TCPIP_CONFIG_AUTOIP_ST2.1:
    5579   00:5BAC                          ; nz, discard
    5580   00:5BAC                          RECEIVE_DATA
    5580   00:5BAC  DB 06             >     in a,(IN_DATA_PORT)
    5581   00:5BAE  05                      dec b
    5582   00:5BAF  20 F0                   jr  nz,TCPIP_CONFIG_AUTOIP_ST2
    5583   00:5BB1                      
    5584   00:5BB1                          ; now just get the 1 byte, configuration, should go to C
    5585   00:5BB1                      TCPIP_CONFIG_AUTOIP_CONF_ST1:
    5586   00:5BB1                          CHECK_DATA
    5586   00:5BB1  DB 07             >     in  a,(IN_STS_PORT)
    5586   00:5BB3  CB 47             >     bit 0,a
    5587   00:5BB5  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_CONF_ST1.1
    5588   00:5BB7  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5589   00:5BBA  18 F5                   jr  TCPIP_CONFIG_AUTOIP_CONF_ST1
    5590   00:5BBC                      TCPIP_CONFIG_AUTOIP_CONF_ST1.1:
    5591   00:5BBC                          ; nz, get it
    5592   00:5BBC                          RECEIVE_DATA
    5592   00:5BBC  DB 06             >     in a,(IN_DATA_PORT)
    5593   00:5BBE  4F                      ld  c,a
    5594   00:5BBF                          ; done
    5595   00:5BBF  AF                      xor a
    5596   00:5BC0  C9                      ret
    5597   00:5BC1                      
    5598   00:5BC1                      ;=========================
    5599   00:5BC1                      ;===  TCPIP_CONFIG_IP  ===
    5600   00:5BC1                      ;=========================
    5601   00:5BC1                      ;Manually configure an IP address.
    5602   00:5BC1                      ;
    5603   00:5BC1                      ;Input:  A = 26
    5604   00:5BC1                      ;        B = Index of address to set:
    5605   00:5BC1                      ;            1: Local IP address
    5606   00:5BC1                      ;            2: Peer IP address
    5607   00:5BC1                      ;            3: Subnet mask
    5608   00:5BC1                      ;            4: Default gateway
    5609   00:5BC1                      ;            5: Primary DNS server IP address
    5610   00:5BC1                      ;            6: Secondary DNS server IP address
    5611   00:5BC1                      ;        L.H.E.D = Address value
    5612   00:5BC1                      ;Output: A = Error code
    5613   00:5BC1                      TCPIP_CONFIG_IP:
    5614   00:5BC1                          SEND_DATA                       ; Send the command
    5614   00:5BC1  D3 07             >     out (OUT_TX_PORT),a
    5615   00:5BC3  AF                      xor a
    5616   00:5BC4                          SEND_DATA                       ; Send the command size msb
    5616   00:5BC4  D3 07             >     out (OUT_TX_PORT),a
    5617   00:5BC6  3E 05                   ld  a,5
    5618   00:5BC8                          SEND_DATA                       ; Send the command size lsb
    5618   00:5BC8  D3 07             >     out (OUT_TX_PORT),a
    5619   00:5BCA  78                      ld  a,b
    5620   00:5BCB                          SEND_DATA                       ; Send the address to set
    5620   00:5BCB  D3 07             >     out (OUT_TX_PORT),a
    5621   00:5BCD  7D                      ld  a,l
    5622   00:5BCE                          SEND_DATA                       ; Send the IP first byte
    5622   00:5BCE  D3 07             >     out (OUT_TX_PORT),a
    5623   00:5BD0  7C                      ld  a,h
    5624   00:5BD1                          SEND_DATA                       ; Send the IP second byte
    5624   00:5BD1  D3 07             >     out (OUT_TX_PORT),a
    5625   00:5BD3  7B                      ld  a,e
    5626   00:5BD4                          SEND_DATA                       ; Send the IP third byte
    5626   00:5BD4  D3 07             >     out (OUT_TX_PORT),a
    5627   00:5BD6  7A                      ld  a,d
    5628   00:5BD7                          SEND_DATA                       ; Send the IP fourth byte
    5628   00:5BD7  D3 07             >     out (OUT_TX_PORT),a
    5629   00:5BD9                      
    5630   00:5BD9                          ; Now wait up to 180 ticks to get response
    5631   00:5BD9  21 B4 00                ld  hl,180
    5632   00:5BDC  CD C0 5C                call    SETCOUNTER
    5633   00:5BDF                      TCPIP_CONFIG_IP_ST1:
    5634   00:5BDF                          CHECK_DATA
    5634   00:5BDF  DB 07             >     in  a,(IN_STS_PORT)
    5634   00:5BE1  CB 47             >     bit 0,a
    5635   00:5BE3  20 05                   jr  nz,TCPIP_CONFIG_IP_ST1.1
    5636   00:5BE5  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5637   00:5BE8  18 F5                   jr  TCPIP_CONFIG_IP_ST1
    5638   00:5BEA                      TCPIP_CONFIG_IP_ST1.1:
    5639   00:5BEA                          ; nz, check the data
    5640   00:5BEA                          RECEIVE_DATA
    5640   00:5BEA  DB 06             >     in a,(IN_DATA_PORT)
    5641   00:5BEC  FE 1A                   cp  26                          ; Is response of our command?
    5642   00:5BEE  20 EF                   jr  nz,TCPIP_CONFIG_IP_ST1
    5643   00:5BF0                          ; now get return code, and that is it
    5644   00:5BF0                      TCPIP_CONFIG_IP_RC:
    5645   00:5BF0                          CHECK_DATA
    5645   00:5BF0  DB 07             >     in  a,(IN_STS_PORT)
    5645   00:5BF2  CB 47             >     bit 0,a
    5646   00:5BF4  20 05                   jr  nz,TCPIP_CONFIG_IP_RC.1
    5647   00:5BF6  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5648   00:5BF9  18 F5                   jr  TCPIP_CONFIG_IP_RC
    5649   00:5BFB                      TCPIP_CONFIG_IP_RC.1:
    5650   00:5BFB                          ; nz, discard
    5651   00:5BFB                          RECEIVE_DATA
    5651   00:5BFB  DB 06             >     in a,(IN_DATA_PORT)
    5652   00:5BFD  C9                      ret                             ; done
    5653   00:5BFE                      
    5654   00:5BFE                      ;==========================
    5655   00:5BFE                      ;===  TCPIP_CONFIG_TTL  ===
    5656   00:5BFE                      ;==========================
    5657   00:5BFE                      ;Get/set the value of TTL and TOS for outgoing datagrams.
    5658   00:5BFE                      ;
    5659   00:5BFE                      ;Input:  A = 27
    5660   00:5BFE                      ;        B = 0: Get current values (just return 255 for TTL and 0 for TOS
    5661   00:5BFE                      ;               as ESP do not expose or allow configurations of it)
    5662   00:5BFE                      ;            1: Set values
    5663   00:5BFE                      ;        D = New value for TTL (only if B=1)
    5664   00:5BFE                      ;        E = New value for ToS (only if B=1)
    5665   00:5BFE                      ;Output: A = Error code
    5666   00:5BFE                      ;        D = Value of TTL after the routine execution
    5667   00:5BFE                      ;        E = Value of ToS after the routine execution
    5668   00:5BFE                      TCPIP_CONFIG_TTL:
    5669   00:5BFE  78                      ld  a,b
    5670   00:5BFF  E6 FE                   and %11111110
    5671   00:5C01  B7                      or  a
    5672   00:5C02  3E 04                   ld  a,ERR_INV_PARAM
    5673   00:5C04  C0                      ret nz
    5674   00:5C05  78                      ld  a,b
    5675   00:5C06  B7                      or  a
    5676   00:5C07                          ; Cant set, so NOT IMP
    5677   00:5C07  3E 01                   ld  a,ERR_NOT_IMP
    5678   00:5C09  C0                      ret nz                          ; if not get, not implemented
    5679   00:5C0A                          ; get, so just return D = #FF, A = OK = 0 and E = 0
    5680   00:5C0A  AF                      xor a
    5681   00:5C0B  1E 00                   ld  e,0
    5682   00:5C0D  16 FF                   ld  d,#FF
    5683   00:5C0F  C9                      ret
    5684   00:5C10                      
    5685   00:5C10                      ;===========================
    5686   00:5C10                      ;===  TCPIP_CONFIG_PING  ===
    5687   00:5C10                      ;===========================
    5688   00:5C10                      ;Get/set the automatic PING reply flag.
    5689   00:5C10                      ;
    5690   00:5C10                      ;Input:  A = 28
    5691   00:5C10                      ;        B = 0: Get current flag value
    5692   00:5C10                      ;            1: Set flag value (ERR_NOT_IMP)
    5693   00:5C10                      ;        C = New flag value (only if B=1):
