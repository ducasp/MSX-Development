    5427   00:5AC8                          ; Ok, so let's ask ESP to re-send the data and retry receiving it
    5428   00:5AC8  3D                      dec a
    5429   00:5AC9  CD 16 5F                call    SETBYTE                 ; we are retrying it
    5430   00:5ACC  3E 72                   ld  a,'r'                       ; retry transmission command
    5431   00:5ACE                          SEND_DATA
    5431   00:5ACE  D3 07             >     out (OUT_TX_PORT),a
    5432   00:5AD0  C3 0F 5B                jp  TCPIP_TCP_RCV.RXRETRY       ; and retry it
    5433   00:5AD3                      TCPIP_TCP_RCV_CHECK_TIME_OUT.NORXRETRY:
    5434   00:5AD3  3E 0F                   ld  a,ERR_INV_OPER
