    1652   00:4916  FE 1B                   cp  #1b                         ; ESC?
    1653   00:4918  CA 4F 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1654   00:491B  FE 4F                   cp  'O'                         ; Toggle Nagle Off
    1655   00:491D  CA 65 49                jp  z,SET_NAGLE_OFF             ;
    1656   00:4920  FE 6F                   cp  'o'                         ; Toggle Nagle Off
    1657   00:4922  CA 65 49                jp  z,SET_NAGLE_OFF             ;
    1658   00:4925  CD C0 00                call    BEEP                    ; Wrong Input, beep
    1659   00:4928  C3 13 49                jp  SET_NAGLE_WI_OFF            ; And return waiting key
    1660   00:492B                      
