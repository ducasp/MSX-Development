    5608   00:5BEA  DB 06             >     in a,(IN_DATA_PORT)
    5609   00:5BEC  05                      dec b
    5610   00:5BED  20 F0                   jr  nz,TCPIP_TCP_SEND_ST2
    5611   00:5BEF                      
    5612   00:5BEF                          ; done, no return data other than return code
    5613   00:5BEF  AF                      xor a
    5614   00:5BF0  C9                      ret
    5615   00:5BF1                      
    5616   00:5BF1                      ;========================
    5617   00:5BF1                      ;===     SSH_SEND     ===
    5618   00:5BF1                      ;========================
    5619   00:5BF1                      ;Send data to a SSH connection.
    5620   00:5BF1                      ;
    5621   00:5BF1                      ;Input:  A  = 5
    5622   00:5BF1                      ;        B  = Connection number
    5623   00:5BF1                      ;        DE = Address of the data to be sent
    5624   00:5BF1                      ;        HL = Length of the data to be sent
    5625   00:5BF1                      ;Output: A  = Error code
    5626   00:5BF1                      SSH_SEND:
    5627   00:5BF1  CB FF                   set 7,a                         ; ESP SSH commands start at #80
    5628   00:5BF3                          SEND_DATA                       ; Send the command
    5628   00:5BF3  D3 07             >     out (OUT_TX_PORT),a
    5629   00:5BF5                          ; prepare new data size, adding our 1 byte overhead (connection #)
    5630   00:5BF5  23                      inc hl
    5631   00:5BF6  7C                      ld  a,h
    5632   00:5BF7                          SEND_DATA                       ; Send the command size msb
    5632   00:5BF7  D3 07             >     out (OUT_TX_PORT),a
    5633   00:5BF9  7D                      ld  a,l
    5634   00:5BFA                          SEND_DATA                       ; Send the command size lsb
    5634   00:5BFA  D3 07             >     out (OUT_TX_PORT),a
    5635   00:5BFC  78                      ld  a,b
    5636   00:5BFD                          SEND_DATA                       ; Send the connection #
    5636   00:5BFD  D3 07             >     out (OUT_TX_PORT),a
    5637   00:5BFF  2B                      dec hl
    5638   00:5C00  EB                      ex  de,hl
    5639   00:5C01                          ; now oti the data starting at hl, size is in DE
    5640   00:5C01                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    5641   00:5C01  43                      ld  b,e                         ;Number of loops originaly in DE
    5642   00:5C02  1B                      dec de
    5643   00:5C03  14                      inc d
    5644   00:5C04                          if USE_MEM_IO = 0
    5645   00:5C04  0E 07                   ld  c,OUT_TX_PORT
    5646   00:5C06                      SSH_SEND_R:
    5647   00:5C06  ED A3                   outi
    5648   00:5C08  20 FC                   jr  nz,SSH_SEND_R
    5649   00:5C0A                          else
    5650   00:5C0A                    ~ SSH_SEND_R:
    5651   00:5C0A                    ~     ld  a,(hl)
    5652   00:5C0A                    ~     ld  (MEM_OUT_TX_PORT),a
    5653   00:5C0A                    ~     inc hl
    5654   00:5C0A                    ~     djnz SSH_SEND_R
    5655   00:5C0A                    ~     endif
    5656   00:5C0A  15                      dec d
    5657   00:5C0B  20 F9                   jr  nz,SSH_SEND_R
    5658   00:5C0D                      
    5659   00:5C0D                          ; Now wait up to 600 ticks to get response
    5660   00:5C0D  21 58 02                ld  hl,600
    5661   00:5C10  CD DF 60                call    SETCOUNTER
    5662   00:5C13                      SSH_SEND_ST1:
    5663   00:5C13                          CHECK_DATA
    5663   00:5C13  DB 07             >     in  a,(IN_STS_PORT)
    5663   00:5C15  CB 47             >     bit 0,a
    5664   00:5C17  20 05                   jr  nz,SSH_SEND_R.1
    5665   00:5C19  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5666   00:5C1C  18 F5                   jr  SSH_SEND_ST1
    5667   00:5C1E                      SSH_SEND_R.1:
    5668   00:5C1E                          ; nz, check the data
    5669   00:5C1E                          RECEIVE_DATA
    5669   00:5C1E  DB 06             >     in a,(IN_DATA_PORT)
    5670   00:5C20  FE 85                   cp  #85                         ; Is response of our command?
    5671   00:5C22  20 EF                   jr  nz,SSH_SEND_ST1
    5672   00:5C24                          ; now get return code, if return code other than 0, it is finished
    5673   00:5C24                      SSH_SEND_RC:
    5674   00:5C24                          CHECK_DATA
    5674   00:5C24  DB 07             >     in  a,(IN_STS_PORT)
    5674   00:5C26  CB 47             >     bit 0,a
    5675   00:5C28  20 05                   jr  nz,SSH_SEND_RC.1
    5676   00:5C2A  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5677   00:5C2D  18 F5                   jr  SSH_SEND_RC
    5678   00:5C2F                      SSH_SEND_RC.1:
    5679   00:5C2F                          ; nz, discard
    5680   00:5C2F                          RECEIVE_DATA
    5680   00:5C2F  DB 06             >     in a,(IN_DATA_PORT)
    5681   00:5C31  B7                      or  a                           ; 0?
    5682   00:5C32  C0                      ret nz                          ; if not, done
    5683   00:5C33                      
    5684   00:5C33                          ; next two bytes are return code and size bytes, don't care, it is 0
    5685   00:5C33  06 02                   ld  b,2
    5686   00:5C35                      SSH_SEND_ST2:
    5687   00:5C35                          CHECK_DATA
    5687   00:5C35  DB 07             >     in  a,(IN_STS_PORT)
    5687   00:5C37  CB 47             >     bit 0,a
    5688   00:5C39  20 05                   jr  nz,SSH_SEND_ST2.1
    5689   00:5C3B  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5690   00:5C3E  18 F5                   jr  SSH_SEND_ST2
    5691   00:5C40                      SSH_SEND_ST2.1:
    5692   00:5C40                          ; nz, discard
    5693   00:5C40                          RECEIVE_DATA
    5693   00:5C40  DB 06             >     in a,(IN_DATA_PORT)
