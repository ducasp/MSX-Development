    2772   00:4ED1  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2773   00:4ED4  18 F5                   jr  TCPIP_GET_CAPAB_BLK3_ST1
    2774   00:4ED6                      TCPIP_GET_CAPAB_BLK3_ST1.1:
    2775   00:4ED6                          ; nz, get it
    2776   00:4ED6                          RECEIVE_DATA
    2776   00:4ED6  DB 06             >     in a,(IN_DATA_PORT)
    2777   00:4ED8  6F                      ld  l,a
