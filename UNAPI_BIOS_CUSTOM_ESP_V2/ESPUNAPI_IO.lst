    5703   00:5C31                          CHECK_DATA
    5703   00:5C31  DB 07             >     in  a,(IN_STS_PORT)
    5703   00:5C33  CB 47             >     bit 0,a
    5704   00:5C35  20 05                   jr  nz,SSH_RCV_ST2B.1
    5705   00:5C37  CD B5 5A                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5706   00:5C3A  18 F5                   jr  SSH_RCV_ST2B
    5707   00:5C3C                      SSH_RCV_ST2B.1:
    5708   00:5C3C                          ; nz, low byte count of bytes to receive
    5709   00:5C3C                          RECEIVE_DATA
    5709   00:5C3C  DB 06             >     in a,(IN_DATA_PORT)
    5710   00:5C3E  6F                      ld  l,a
