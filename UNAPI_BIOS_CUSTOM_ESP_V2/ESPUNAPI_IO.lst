    6097   00:5D78  23                      inc hl
    6098   00:5D79  70                      ld  (hl),b
    6099   00:5D7A  E1                      pop hl                          ; Restore HL original value
    6100   00:5D7B  D1                      pop de                          ; Restore DE
    6101   00:5D7C  C9                      ret
    6102   00:5D7D                      
    6103   00:5D7D                      ;--- Restores HL copy saved in high memory
    6104   00:5D7D                      ;    Input:  none
    6105   00:5D7D                      ;    Output: HL
    6106   00:5D7D                      ;    Modifies: AF
    6107   00:5D7D                      
    6108   00:5D7D                      HLRESTORE:
    6109   00:5D7D  C5                      push    bc
    6110   00:5D7E  D5                      push    de
    6111   00:5D7F  CD 20 5C                call    GETSLT
    6112   00:5D82                          ; Slot in A, now get the address of our counter
    6113   00:5D82  CD A9 5C                call    GETMEMPOINTER
    6114   00:5D85                          ; HL has the address of our memory area, param is 7 bytes after start
    6115   00:5D85  11 11 00                ld  de,MEMORY_HLBACKUP_OFFSET
    6116   00:5D88  19                      add hl,de
    6117   00:5D89                          ; Ok, this is where our param is so get it
    6118   00:5D89  5E                      ld  e,(hl)
    6119   00:5D8A  23                      inc hl
    6120   00:5D8B  56                      ld  d,(hl)
    6121   00:5D8C  EB                      ex  de,hl
    6122   00:5D8D  D1                      pop de
    6123   00:5D8E  C1                      pop bc
    6124   00:5D8F  C9                      ret
    6125   00:5D90                      
    6126   00:5D90                      ;--- Backups HL in high memory
    6127   00:5D90                      ;    Input:  HL
    6128   00:5D90                      ;    Output: none
    6129   00:5D90                      ;    Modifies: AF
    6130   00:5D90                      
    6131   00:5D90                      HLBACKUP:
    6132   00:5D90  D5                      push    de
    6133   00:5D91  C5                      push    bc
    6134   00:5D92  E5                      push    hl
    6135   00:5D93  CD 20 5C                call    GETSLT
    6136   00:5D96                          ; Slot in A, now get the address
    6137   00:5D96  CD A9 5C                call    GETMEMPOINTER
    6138   00:5D99                          ; HL has the address of our memory area, byte param is 7 bytes after start
    6139   00:5D99  11 11 00                ld  de,MEMORY_HLBACKUP_OFFSET
    6140   00:5D9C  19                      add hl,de
    6141   00:5D9D                          ; HL has the address of param
    6142   00:5D9D  D1                      pop de                          ; Restore HL in de
    6143   00:5D9E  73                      ld  (hl),e
    6144   00:5D9F  23                      inc hl
    6145   00:5DA0  72                      ld  (hl),d
    6146   00:5DA1  EB                      ex  de,hl                       ; Restore HL
    6147   00:5DA2  C1                      pop bc                          ; Restore BC
    6148   00:5DA3  D1                      pop de                          ; Restore DE
    6149   00:5DA4  C9                      ret
    6150   00:5DA5                      
    6151   00:5DA5                      ;--- Return the saved ESP TYPE
    6152   00:5DA5                      ;    Input:  none
    6153   00:5DA5                      ;    Output: A and F will be NZ if ESP32
    6154   00:5DA5                      ;    Modifies: AF
    6155   00:5DA5                      
    6156   00:5DA5                      GETESPTYPE:
    6157   00:5DA5  D5                      push    de
    6158   00:5DA6  C5                      push    bc
    6159   00:5DA7  E5                      push    hl
    6160   00:5DA8  DD E5                   push    ix
    6161   00:5DAA  FD E5                   push    iy
    6162   00:5DAC  CD 20 5C                call    GETSLT
    6163   00:5DAF  CD 8D 5C                call    GETMEMPOINTERADDR       ; This is where we are going to store our memory area address
    6164   00:5DB2                          ; GETSLT and GETMEMPOINTER do not change DE, so it still has the our memory area address
    6165   00:5DB2  11 07 00                ld  de,7
    6166   00:5DB5  19                      add hl,de
    6167   00:5DB6  7E                      ld  a,(hl)
    6168   00:5DB7  B7                      or  a
    6169   00:5DB8  FD E1                   pop iy
    6170   00:5DBA  DD E1                   pop ix
    6171   00:5DBC  E1                      pop hl
    6172   00:5DBD  C1                      pop bc
    6173   00:5DBE  D1                      pop de
    6174   00:5DBF  C9                      ret
    6175   00:5DC0                      
    6176   00:5DC0                      ;--- Obtain if DNS is ready saved in high memory
    6177   00:5DC0                      ;    Input:  none
    6178   00:5DC0                      ;    Output: A = DNS ready value
    6179   00:5DC0                      ;    Modifies: AF
    6180   00:5DC0                      
    6181   00:5DC0                      GETDNSREADY:
    6182   00:5DC0  C5                      push    bc
    6183   00:5DC1  D5                      push    de
    6184   00:5DC2  E5                      push    hl
    6185   00:5DC3  CD 20 5C                call    GETSLT
    6186   00:5DC6                          ; Slot in A, now get the address
    6187   00:5DC6  CD A9 5C                call    GETMEMPOINTER
    6188   00:5DC9                          ; HL has the address of our memory area, DNS ready is 8 bytes after start
    6189   00:5DC9  11 08 00                ld  de,MEMORY_DNS_READY_OFFSET
    6190   00:5DCC  19                      add hl,de
    6191   00:5DCD                          ; Ok, get it
    6192   00:5DCD  7E                      ld  a,(hl)
    6193   00:5DCE  E1                      pop hl
    6194   00:5DCF  D1                      pop de
    6195   00:5DD0  C1                      pop bc
    6196   00:5DD1  C9                      ret
    6197   00:5DD2                      
    6198   00:5DD2                      ;--- Set DNS redy in high memory
    6199   00:5DD2                      ;    Input:  A = new value
    6200   00:5DD2                      ;    Output: none
    6201   00:5DD2                      ;    Modifies: AF
    6202   00:5DD2                      
    6203   00:5DD2                      SETDNSREADY:
    6204   00:5DD2  C5                      push    bc
    6205   00:5DD3  D5                      push    de
    6206   00:5DD4  E5                      push    hl
    6207   00:5DD5  F5                      push    af                      ; Save parameter
    6208   00:5DD6  CD 20 5C                call    GETSLT
    6209   00:5DD9                          ; Slot in A, now get the address
    6210   00:5DD9  CD A9 5C                call    GETMEMPOINTER
    6211   00:5DDC                          ; HL has the address of our memory area, DNS ready is 8 bytes after start
    6212   00:5DDC  11 08 00                ld  de,MEMORY_DNS_READY_OFFSET
    6213   00:5DDF  19                      add hl,de
    6214   00:5DE0                          ; HL has the address of DNS ready
    6215   00:5DE0  F1                      pop af                          ; Restore parameter
    6216   00:5DE1  77                      ld  (hl),a
    6217   00:5DE2  E1                      pop hl
    6218   00:5DE3  D1                      pop de
    6219   00:5DE4  C1                      pop bc
    6220   00:5DE5  C9                      ret
    6221   00:5DE6                      
    6222   00:5DE6                      ;--- Obtain DNS result saved in high memory
    6223   00:5DE6                      ;    Input:  none
    6224   00:5DE6                      ;    Output: HL DE = DNS result
    6225   00:5DE6                      ;    Modifies: AF
    6226   00:5DE6                      
    6227   00:5DE6                      GETDNSRESULT:
    6228   00:5DE6  C5                      push    bc
    6229   00:5DE7  CD 20 5C                call    GETSLT
    6230   00:5DEA                          ; Slot in A, now get the address
    6231   00:5DEA  CD A9 5C                call    GETMEMPOINTER
    6232   00:5DED                          ; HL has the address of our memory area, DNS result is 9 bytes after start
    6233   00:5DED  11 09 00                ld  de,MEMORY_DNS_RES_OFFSET
    6234   00:5DF0  19                      add hl,de
    6235   00:5DF1                          ; Ok, get it, first bytes are hl
    6236   00:5DF1  5E                      ld  e,(hl)
    6237   00:5DF2  23                      inc hl
    6238   00:5DF3  56                      ld  d,(hl)
    6239   00:5DF4  D5                      push    de                      ; for now, save in stack, so we can restore to HL later
    6240   00:5DF5  23                      inc hl
    6241   00:5DF6  5E                      ld  e,(hl)
    6242   00:5DF7  23                      inc hl
    6243   00:5DF8  56                      ld  d,(hl)
    6244   00:5DF9  E1                      pop hl                          ; and now restore HL value from stack
    6245   00:5DFA  C1                      pop bc
    6246   00:5DFB  C9                      ret
    6247   00:5DFC                      
    6248   00:5DFC                      ;--- Set DNS result in high memory
    6249   00:5DFC                      ;    Input:  HL DE = new value
    6250   00:5DFC                      ;    Output: none
    6251   00:5DFC                      ;    Modifies: AF
    6252   00:5DFC                      
    6253   00:5DFC                      SETDNSRESULT:
    6254   00:5DFC  C5                      push    bc
    6255   00:5DFD  D5                      push    de
    6256   00:5DFE  E5                      push    hl
    6257   00:5DFF  CD 20 5C                call    GETSLT
    6258   00:5E02                          ; Slot in A, now get the address
    6259   00:5E02  CD A9 5C                call    GETMEMPOINTER
    6260   00:5E05                          ; HL has the address of our memory area, DNS result is 9 bytes after start
    6261   00:5E05  11 09 00                ld  de,MEMORY_DNS_RES_OFFSET
    6262   00:5E08  19                      add hl,de
    6263   00:5E09                          ; HL has the address of DNS result
    6264   00:5E09  C1                      pop bc                          ; Restore parameter HL in BC
    6265   00:5E0A  71                      ld  (hl),c
    6266   00:5E0B  23                      inc hl
    6267   00:5E0C  70                      ld  (hl),b
    6268   00:5E0D  D1                      pop de                          ; Restore parameter DE in DE
    6269   00:5E0E  23                      inc hl
    6270   00:5E0F  73                      ld  (hl),e
    6271   00:5E10  23                      inc hl
    6272   00:5E11  72                      ld  (hl),d
    6273   00:5E12  69                      ld  l,c
    6274   00:5E13  60                      ld  h,b                         ; And HL is restored
    6275   00:5E14  C1                      pop bc                          ; Restore BC
    6276   00:5E15  C9                      ret
    6277   00:5E16                      
    6278   00:5E16                      ;--- Convert a character to upper-case if it is a lower-case letter
    6279   00:5E16                      TOUPPER:
    6280   00:5E16  FE 61                   cp  "a"
    6281   00:5E18  D8                      ret c
    6282   00:5E19  FE 7B                   cp  "z"+1
    6283   00:5E1B  D0                      ret nc
    6284   00:5E1C  E6 DF                   and #DF
    6285   00:5E1E  C9                      ret
    6286   00:5E1F                      
    6287   00:5E1F                      ;*********************************************
    6288   00:5E1F                      ;***       WAIT_RESPONSE_FROM_ESP          ***
    6289   00:5E1F                      ;*** Will wait ESP to send a response,     ***
    6290   00:5E1F                      ;*** discarding all data until it is found.***
    6291   00:5E1F                      ;***                                       ***
    6292   00:5E1F                      ;*** Inputs:                               ***
    6293   00:5E1F                      ;*** HL - Expected response string         ***
    6294   00:5E1F                      ;*** A - Response Size                     ***
    6295   00:5E1F                      ;*** DE - TimeOut in ticks                 ***
    6296   00:5E1F                      ;***                                       ***
    6297   00:5E1F                      ;*** Output:                               ***
    6298   00:5E1F                      ;*** A - 0 if response received            ***
    6299   00:5E1F                      ;*** otherwise response not received and   ***
    6300   00:5E1F                      ;*** timed-out.                            ***
    6301   00:5E1F                      ;***                                       ***
    6302   00:5E1F                      ;*** Changes HL, BC, AF, DE, IX            ***
    6303   00:5E1F                      ;*********************************************
    6304   00:5E1F                      WRFE_WAIT_DATA:
    6305   00:5E1F                          LOAD_STS_PORT_IN_A
    6305   00:5E1F  DB 07             >     in  a,(IN_STS_PORT)
    6306   00:5E21  CB 6F                   bit 5,a                         ; If nz Port #07 is not available
    6307   00:5E23  20 06                   jr  nz,WRFE_STS_NOT_AVAILABLE
    6308   00:5E25  CB 47                   bit 0,a                         ; if nz has data
    6309   00:5E27  C0                      ret nz
    6310   00:5E28  1B                      dec de
    6311   00:5E29  76                      halt
    6312   00:5E2A  C9                      ret
    6313   00:5E2B                      WRFE_STS_NOT_AVAILABLE:
    6314   00:5E2B  11 00 00                ld  de,0
    6315   00:5E2E  AF                      xor a
    6316   00:5E2F  C9                      ret
    6317   00:5E30                      
    6318   00:5E30                      WRFE_COMPARE:
    6319   00:5E30  47                      ld  b,a
    6320   00:5E31  7E                      ld  a,(hl)
    6321   00:5E32  B8                      cp  b
    6322   00:5E33  C0                      ret nz
    6323   00:5E34  23                      inc hl
    6324   00:5E35  C9                      ret
    6325   00:5E36                      
    6326   00:5E36                      WAIT_RESPONSE_FROM_ESP:
    6327   00:5E36  4F                      ld  c,a                         ; Response size in C
    6328   00:5E37  E5                      push    hl                      ; Save HL
    6329   00:5E38  AF                      xor a
    6330   00:5E39                      WRFE_ST1:
    6331   00:5E39  DD 67                   ld  ixh,a                       ; We start at index 0
    6332   00:5E3B                      
    6333   00:5E3B                      WRFE_LOOP:
    6334   00:5E3B  CD 1F 5E                call    WRFE_WAIT_DATA
    6335   00:5E3E  20 07                   jr  nz,WRFE_LOOP.1
    6336   00:5E40  7B                      ld  a,e
    6337   00:5E41  B2                      or  d
    6338   00:5E42  CA 61 5E                jp  z,WRFE_RET_ERROR
    6339   00:5E45  18 F4                   jr  WRFE_LOOP
    6340   00:5E47                      WRFE_LOOP.1:
    6341   00:5E47                          ; nz, check the data
    6342   00:5E47                          RECEIVE_DATA
    6342   00:5E47  DB 06             >     in a,(IN_DATA_PORT)
    6343   00:5E49                          ; Ok, now the byte is in A, let's compare
    6344   00:5E49                      WRFE_IDXCMD:
    6345   00:5E49  CD 30 5E                call WRFE_COMPARE
    6346   00:5E4C                          ; if match
    6347   00:5E4C  28 07                   jr  z,WRFE_RSP_MATCH
    6348   00:5E4E                          ; did not match, let's zero the rsp index
    6349   00:5E4E  AF                      xor a
    6350   00:5E4F  DD 67                   ld  ixh,a                       ; re-start at index 0
    6351   00:5E51  E1                      pop hl                          ; restore the response index
    6352   00:5E52  E5                      push    hl                      ; and keep it in stack
    6353   00:5E53                          ; back to get another byte
    6354   00:5E53  18 E6                   jr  WRFE_LOOP
    6355   00:5E55                      WRFE_RSP_MATCH:
    6356   00:5E55                          ; match
    6357   00:5E55  DD 24                   inc ixh
    6358   00:5E57  DD 7C                   ld  a,ixh
    6359   00:5E59  B9                      cp  c
    6360   00:5E5A                          ; if a = c done and response is success
    6361   00:5E5A  28 02                   jr  z,WRFE_RET_OK
    6362   00:5E5C                          ; not done, back to get more bytes
    6363   00:5E5C  18 DD                   jr  WRFE_LOOP
    6364   00:5E5E                      WRFE_RET_OK:
    6365   00:5E5E  E1                      pop hl
    6366   00:5E5F  AF                      xor a
    6367   00:5E60  C9                      ret
    6368   00:5E61                      WRFE_RET_ERROR:
    6369   00:5E61  E1                      pop hl
    6370   00:5E62  3E 01                   ld  a,1
    6371   00:5E64  C9                      ret
    6372   00:5E65                      
    6373   00:5E65                      ;*********************************************
    6374   00:5E65                      ;***            CHECK_ESP_TYPE             ***
    6375   00:5E65                      ;*** If ESP32, NZ will be set and A = 1, if***
    6376   00:5E65                      ;*** not NZ will be reset and A=0          ***
    6377   00:5E65                      ;*********************************************
    6378   00:5E65                      CHECK_ESP_TYPE:
    6379   00:5E65  E5                      push    hl
    6380   00:5E66  D5                      push    de
    6381   00:5E67  FD E5                   push    iy
    6382   00:5E69  DD E5                   push    ix
    6383   00:5E6B                          CLEAR_UART                      ; Clear UART
    6383   00:5E6B  3E 14             >     ld  a,20
    6383   00:5E6D  D3 06             >     out (OUT_CMD_PORT),a
    6384   00:5E6F  3E 62                   ld  a,CMD_GET_FW_TYPE
    6385   00:5E71                          SEND_DATA
    6385   00:5E71  D3 07             >     out (OUT_TX_PORT),a
    6386   00:5E73  21 06 00                ld  hl,6                        ; Wait up to 100ms
    6387   00:5E76  ED 5B 76 F6             ld  de,(TXTTAB)                 ; Borrow Basic program area for now....
    6388   00:5E7A  DD 6B                   ld  ixl,e
    6389   00:5E7C  DD 62                   ld  ixh,d                       ; Address in IX
    6390   00:5E7E  CD 33 4B                call    WAIT_MENU_CMD_RESPONSE
    6391   00:5E81  F5                      push    af
    6392   00:5E82  CD 20 5C                call    GETSLT
    6393   00:5E85  CD 8D 5C                call    GETMEMPOINTERADDR       ; This is where we are going to store our memory area address
    6394   00:5E88  11 07 00                ld  de,7
    6395   00:5E8B  19                      add hl,de
    6396   00:5E8C  F1                      pop af
    6397   00:5E8D  77                      ld  (hl),a
    6398   00:5E8E  B7                      or  a
    6399   00:5E8F  DD E1                   pop ix
    6400   00:5E91  FD E1                   pop iy
    6401   00:5E93  D1                      pop de
    6402   00:5E94  E1                      pop hl
    6403   00:5E95  C9                      ret
    6404   00:5E96                      
    6405   00:5E96                      ;*********************************************
    6406   00:5E96                      ;***              RESET ESP                ***
    6407   00:5E96                      ;*** If RESET ok, A will be 0, otherwise   ***
    6408   00:5E96                      ;*** failure                               ***
    6409   00:5E96                      ;*********************************************
    6410   00:5E96                      RESET_ESP:
    6411   00:5E96                          ; Is ESP installed?
    6412   00:5E96                          CLEAR_UART                      ; Clear UART
    6412   00:5E96  3E 14             >     ld  a,20
    6412   00:5E98  D3 06             >     out (OUT_CMD_PORT),a
    6413   00:5E9A  3E 3F                   ld  a,CMD_QUERY_ESP
    6414   00:5E9C                          SEND_DATA
    6414   00:5E9C  D3 07             >     out (OUT_TX_PORT),a
    6415   00:5E9E  21 30 60                ld  hl,RSP_CMD_QUERY_ESP        ; Expected response
    6416   00:5EA1  11 3C 00                ld  de,60                       ; Up to 1s @ 60Hz
    6417   00:5EA4  3E 02                   ld  a,RSP_CMD_QUERY_ESP_SIZE    ; Size of response
    6418   00:5EA6  CD 36 5E                call    WAIT_RESPONSE_FROM_ESP
    6419   00:5EA9  B7                      or  a
    6420   00:5EAA  3E 01                   ld  a,1
    6421   00:5EAC  28 03                   jr  z,RESET_ESP_INIT            ; ESP Found
    6422   00:5EAE  06 00                   ld  b,0                         ; 0 if no response
    6423   00:5EB0  C9                      ret
    6424   00:5EB1                      RESET_ESP_INIT:
    6425   00:5EB1  06 03                   ld  b,3                         ; Retry up to 10 times
    6426   00:5EB3                      RESET_ESP_LOOP:
    6427   00:5EB3                          CLEAR_UART
    6427   00:5EB3  3E 14             >     ld  a,20
    6427   00:5EB5  D3 06             >     out (OUT_CMD_PORT),a
    6428   00:5EB7                          SET_SPEED
    6428   00:5EB7  AF                >     xor a
    6428   00:5EB8  D3 06             >     out (OUT_CMD_PORT),a
    6429   00:5EBA  76                      halt
    6430   00:5EBB  76                      halt                            ; Wait a little to make sure speed is adjusted
    6431   00:5EBC  3E 57                   ld  a,CMD_WRESET_ESP
    6432   00:5EBE                          SEND_DATA
    6432   00:5EBE  D3 07             >     out (OUT_TX_PORT),a
    6433   00:5EC0  21 2B 60                ld  hl,RSP_CMD_RESET_ESP        ; Expected response
    6434   00:5EC3  11 5A 00                ld  de,90                       ; Up to 1.5s @ 60Hz
    6435   00:5EC6  3E 05                   ld  a,RSP_CMD_RESET_ESP_SIZE    ; Size of response
    6436   00:5EC8  C5                      push    bc                      ; Save retry counter
    6437   00:5EC9  CD 36 5E                call    WAIT_RESPONSE_FROM_ESP
    6438   00:5ECC  C1                      pop bc                          ; restore retry counter
    6439   00:5ECD  B7                      or  a                           ; Did WAIT RESPONSE return zero?
    6440   00:5ECE  C8                      ret z                           ; Yes, Warm Reset Ok
    6441   00:5ECF  10 E2                   djnz RESET_ESP_LOOP             ; No, decrement retry counter and let the loop check
    6442   00:5ED1                          ; No more retries? Then check if it is old ESP FW
    6443   00:5ED1                      RESET_CHK_IF_INSTALLED:
    6444   00:5ED1                          ; No more retries? Then it is old ESP FW
    6445   00:5ED1  06 01                   ld  b,1
    6446   00:5ED3  C9                      ret
    6447   00:5ED4                      
    6448   00:5ED4                      ;*********************************************
    6449   00:5ED4                      ;***              SET TIME                 ***
    6450   00:5ED4                      ;*** H - Hour                              ***
    6451   00:5ED4                      ;*** L - Minutes                           ***
    6452   00:5ED4                      ;*** D - Seconds                           ***
    6453   00:5ED4                      ;***                                       ***
    6454   00:5ED4                      ;*** A - 0 if Ok otherwise invalid time    ***
    6455   00:5ED4                      ;*********************************************
    6456   00:5ED4                      SET_TIME:
    6457   00:5ED4  7C                      ld  a,h                         ; Hour in A
    6458   00:5ED5  FE 18                   cp  24                          ; Compare to 24
    6459   00:5ED7  30 12                   jr  nc,SET_TIME_ERR             ; If 24 or more, invalid
    6460   00:5ED9  7D                      ld  a,l                         ; Minutes in A
    6461   00:5EDA  FE 3C                   cp  60                          ; Compare to 60
    6462   00:5EDC  30 0D                   jr  nc,SET_TIME_ERR             ; If 60 or more, invalid
    6463   00:5EDE  7A                      LD  a,d                         ; Seconds in D
    6464   00:5EDF  FE 3C                   cp  60                          ; Compare to 60
    6465   00:5EE1  30 08                   jr  nc,SET_TIME_ERR             ; If 60 or more invalid
    6466   00:5EE3  44                      ld  b,h                         ; Hour in B
    6467   00:5EE4  4D                      ld  c,l                         ; Minutes in C
    6468   00:5EE5  5A                      ld  e,d                         ; Seconds in E
    6469   00:5EE6  CD EE 5E                call    SET_RTC_TIME            ; Set time in RTC
    6470   00:5EE9  AF                      xor a                           ; 0 in A
    6471   00:5EEA  C9                      ret                             ; Return
    6472   00:5EEB                      ;   Invalid parameter
    6473   00:5EEB                      SET_TIME_ERR:
    6474   00:5EEB  3E 01                   ld  a,1                         ; Invalid Time
    6475   00:5EED  C9                      ret                             ; Return
    6476   00:5EEE                      
    6477   00:5EEE                      SET_RTC_TIME:
    6478   00:5EEE  6B                      ld  l,e                         ; Seconds in L
    6479   00:5EEF  61                      ld  h,c                         ; Minutes in H
    6480   00:5EF0  50                      ld  d,b                         ; Hour in D
    6481   00:5EF1  CD 49 5F                call    STOP_RTC_COUNT_SET_MODE0; Select RTC Register 13, and set Mode / Page 0
    6482   00:5EF4  3E 0F                   ld  a,#F                        ; Register F
    6483   00:5EF6  D3 B4                   out (#B4),a
    6484   00:5EF8  3E 02                   ld  a,2
    6485   00:5EFA  D3 B5                   out (#B5),a                     ; Timer reset seconds and on both clock pulses
    6486   00:5EFC  1E 00                   ld  e,0                         ; Start at register 0
    6487   00:5EFE  C3 84 5F                jp  SET_RTC_DATE.1              ; And save L, H and D, function will return from there
    6488   00:5F01                      
    6489   00:5F01                      ;*********************************************
    6490   00:5F01                      ;***              SET DATE                 ***
    6491   00:5F01                      ;*** HL - Year from 1980 to 2079           ***
    6492   00:5F01                      ;*** D - Month from 1 to 12                ***
    6493   00:5F01                      ;*** E - Day from 1 to 31                  ***
    6494   00:5F01                      ;***                                       ***
    6495   00:5F01                      ;*** A - 0 if Ok otherwise invalid Date    ***
    6496   00:5F01                      ;*********************************************
    6497   00:5F01                      SET_DATE:
    6498   00:5F01  01 44 F8                ld  bc,#F844
    6499   00:5F04  09                      add hl,bc
    6500   00:5F05  30 32                   jr  nc,SET_DATE_ERR             ; No carry -> Year is less than 1980, invalid date
    6501   00:5F07  7C                      ld  a,h
    6502   00:5F08  B7                      or  a
    6503   00:5F09  20 2E                   jr  nz,SET_DATE_ERR             ; If H is set, means year is greater than 2235 ,invalid
    6504   00:5F0B  7D                      ld  a,l
    6505   00:5F0C  FE 64                   cp  100
    6506   00:5F0E  30 29                   jr  nc,SET_DATE_ERR             ; If L >= 100 year is greater than 2079, invalid
    6507   00:5F10  47                      ld  b,a                         ; Year - 1980 in B
    6508   00:5F11  7A                      ld  a,d                         ; Now test month
    6509   00:5F12  3D                      dec a
    6510   00:5F13  FE 0C                   cp  12                          ; If 12 or less this should carry
    6511   00:5F15  30 22                   jr  nc,SET_DATE_ERR             ; otherwise invalid
    6512   00:5F17  21 3C 5F                ld  hl,DAYS_IN_MONTH            ; Days in Month table
    6513   00:5F1A  85                      add a,l                         ; add our month
    6514   00:5F1B  6F                      ld  l,a                         ; back in L
    6515   00:5F1C  30 01                   jr  nc,SET_DATE1                ; no carry done
    6516   00:5F1E  24                      inc h                           ; otherwise increase H
    6517   00:5F1F                      SET_DATE1:
    6518   00:5F1F  3E 1C                   ld  a,28                        ; 28 days
    6519   00:5F21  BE                      cp  (hl)                        ; If month is 28 days, February, need to check if leap and limit is 29 in this year
    6520   00:5F22  20 08                   jr  nz,SET_DATE2                ; if not, skip below code , so probably above check is if month is february
    6521   00:5F24  78                      ld  a,b                         ; Year - 1980 in A again
    6522   00:5F25  E6 03                   and 3                           ; if other than 0, non divisible per 4, so not a leap year
    6523   00:5F27  20 03                   jr  nz,SET_DATE2                ; Regular year
    6524   00:5F29  21 48 5F                ld  hl,DAYS_IN_FEBRUARY_LEAP    ; HL has address of 29 days, maximum number of days for february in leap year
    6525   00:5F2C                      SET_DATE2:
    6526   00:5F2C  7B                      ld  a,e                         ; Day of month in A
    6527   00:5F2D  3D                      dec a                           ; Decrement
    6528   00:5F2E  BE                      cp  (hl)                        ; Compare with Days in month
    6529   00:5F2F  30 08                   jr  nc,SET_DATE_ERR             ; If day is greater than how many days in month, invalid
    6530   00:5F31  6B                      ld  l,e                         ; Day of month in L
    6531   00:5F32  62                      ld  h,d                         ; Month in H
    6532   00:5F33  50                      ld  d,b                         ; Year - 1980 in D
    6533   00:5F34  CD 6E 5F                call    SET_RTC_DATE            ; Set date in RTC
    6534   00:5F37  AF                      xor a                           ; A = 0
    6535   00:5F38  C9                      ret                             ; Success
    6536   00:5F39                      ;   Invalid parameter
    6537   00:5F39                      SET_DATE_ERR:
    6538   00:5F39  3E 01                   ld  a,1
    6539   00:5F3B  C9                      ret
    6540   00:5F3C                      
    6541   00:5F3C                      ; Table of top day value for each month
    6542   00:5F3C                      DAYS_IN_MONTH:          db  31,28,31,30,31,30,31,31,30,31,30,31
    6542   00:5F3C  1F 1C 1F 1E 1F 1E 1F 1F 1E 1F 1E 1F 
    6543   00:5F48                      ; And top day value in February when Leap Year
    6544   00:5F48  1D                  DAYS_IN_FEBRUARY_LEAP:  db  29
    6545   00:5F49                      
    6546   00:5F49                      ; Will select Mode 00 (Date and Time page) and stop clock counting
    6547   00:5F49                      ; Register D value will be left in A
    6548   00:5F49                      STOP_RTC_COUNT_SET_MODE0:
    6549   00:5F49  3E 0D                   ld  a,#D
    6550   00:5F4B  D3 B4                   out (#B4),a                     ; Select RTC register D (mode)
    6551   00:5F4D  DB B5                   in  a,(#B5)                     ; read register D
    6552   00:5F4F  E6 04                   and 4                           ; Save Alarm EN setting, and mode register is 00 and stop counting time
    6553   00:5F51  D3 B5                   out (#B5),a                     ; And save
    6554   00:5F53  C9                      ret
    6555   00:5F54                      
    6556   00:5F54                      ; Will get a non BCD value in A, convert it to BCD and then save it in
    6557   00:5F54                      ; a register pair that starts in the register indicated in E
    6558   00:5F54                      ; Register E will have the next register after that register pair
    6559   00:5F54                      RTC_SAVE_REGISTERPAIR:
    6560   00:5F54  4F                      ld  c,a                         ; Save A in C
    6561   00:5F55  AF                      xor a                           ; 0 in A
    6562   00:5F56  06 08                   ld  b,8                         ; 8 in B, number of bits for conversion
    6563   00:5F58                      RTC_SAVE_REGISTERPAIR.1:
    6564   00:5F58  CB 01                   rlc c                           ; Leftmost bit in Carry
    6565   00:5F5A  8F                      adc a,a                         ; A = (A * 2) + Carry
    6566   00:5F5B  27                      daa                             ; decimal adjust A, shift = BCD x 2 + carry
    6567   00:5F5C  10 FA                   djnz    RTC_SAVE_REGISTERPAIR.1 ; Repeat for 8 bits
    6568   00:5F5E  CD 65 5F                call    SET_RTC_REG             ; Save LSB in register and increase register address
    6569   00:5F61  0F                      rrca
    6570   00:5F62  0F                      rrca
    6571   00:5F63  0F                      rrca
    6572   00:5F64  0F                      rrca                            ; now MSB is in LSB position
    6573   00:5F65                      SET_RTC_REG:
    6574   00:5F65  47                      ld  b,a                         ; save value to set in B
    6575   00:5F66  7B                      ld  a,e                         ; and now register address in A
    6576   00:5F67  D3 B4                   out (#B4),a                     ; The register we want to set
    6577   00:5F69  78                      ld  a,b                         ; restore value
    6578   00:5F6A  D3 B5                   out (#B5),a                     ; save it
    6579   00:5F6C  1C                      inc e                           ; increase register address, as this usually is done in pairs
    6580   00:5F6D  C9                      ret
    6581   00:5F6E                      
    6582   00:5F6E                      ; Auxiliary function for SET_DATE and SET_TIME
    6583   00:5F6E                      ; SET_RTC_DATE will save date, parameters:
    6584   00:5F6E                      ; L - Day
    6585   00:5F6E                      ; H - Month
    6586   00:5F6E                      ; D - Years since 1980
    6587   00:5F6E                      ; All values are regular values, this function will properly convert them
    6588   00:5F6E                      ;
    6589   00:5F6E                      ; SET_RTC_DATE.1 is used by SET_TIME as well
    6590   00:5F6E                      ; It will save three register pairs, starting with the register in E
    6591   00:5F6E                      ; First pair is updated with value in L
    6592   00:5F6E                      ; Second pair is updated with value in H
    6593   00:5F6E                      ; Third pair is updated with value in D
    6594   00:5F6E                      SET_RTC_DATE:
    6595   00:5F6E  CD 49 5F                call    STOP_RTC_COUNT_SET_MODE0; Select RTC Register 13, and set Mode / Page 0
    6596   00:5F71  F6 01                   or  1                           ; Set Bit 0, so Mode / Page 1
    6597   00:5F73  D3 B5                   out (#B5),a                     ; save it in register 13, now page 1 selected
    6598   00:5F75  3E 0B                   ld  a,#B                        ; Leap Year Counter Register
    6599   00:5F77  D3 B4                   out (#B4),a                     ; Select it
    6600   00:5F79  7A                      ld  a,d                         ; Load Years in leap year counter
    6601   00:5F7A  D3 B5                   out (#B5),a                     ; So it has count of leap years (0 is 1980, leap, and every time it is 4, leap year again)
    6602   00:5F7C  CD 49 5F                call    STOP_RTC_COUNT_SET_MODE0; Select RTC Register 13 and set mode / page 0
    6603   00:5F7F  CD 49 5F                call    STOP_RTC_COUNT_SET_MODE0; do it a second time... DOS does it, don't want to JYNX it :P
    6604   00:5F82  1E 07                   ld  e,7                         ; Register 7
    6605   00:5F84                      SET_RTC_DATE.1:
    6606   00:5F84  7D                      ld  a,l                         ; A has day
    6607   00:5F85  CD 54 5F                call    RTC_SAVE_REGISTERPAIR   ; Will convert day to BCD and save in registers 7 and 8
    6608   00:5F88  7C                      ld  a,h                         ; A has month
    6609   00:5F89  CD 54 5F                call    RTC_SAVE_REGISTERPAIR   ; Will convert month to BCD and save in register 9 and A
    6610   00:5F8C  7A                      ld  a,d                         ; A has how many years since 1980
    6611   00:5F8D  CD 54 5F                call    RTC_SAVE_REGISTERPAIR   ; Will convert to BCD and save in register B and C
    6612   00:5F90  3E 0D                   ld  a,#D                        ; Register D
    6613   00:5F92  D3 B4                   out (#B4),a                     ; Send it
    6614   00:5F94  DB B5                   in  a,(#B5)                     ; Read its value
    6615   00:5F96  F6 08                   or  8                           ; Start counting time again
    6616   00:5F98  D3 B5                   out (#B5),a                     ; Send
    6617   00:5F9A  C9                      ret
    6618   00:5F9B                      
    6619   00:5F9B                      ; Pattern setup routine
    6620   00:5F9B                      PATTERN_SETUP:
    6621   00:5F9B  AF                      xor a                           ; Bit-16, V9938 and V9958 only
    6622   00:5F9C  21 88 00                ld  hl,#0088                    ; Bit-15 to 0, pattern base address = #0088
    6623   00:5F9F  CD 0F 60                call SET_VDP_WRITE
    6624   00:5FA2  21 AF 5F                ld  hl,PATTERN_DATA             ; Point to hl
    6625   00:5FA5  06 60                   ld  b,8*12                      ; Redraw 12 chars, max 12 chars are suggested
    6626   00:5FA7  0E 98                   ld  c,#98                       ; port #98
    6627   00:5FA9                      OUTI_TO_VRAM_TMS9918:
    6628   00:5FA9  ED A3                   outi                            ; Slower than otir but useful on TMS9918 which requires 29 T-states
    6629   00:5FAB  C2 A9 5F                jp  nz,OUTI_TO_VRAM_TMS9918     ; Therefore, don't use 'djnz' here!
    6630   00:5FAE  C9                      ret
    6631   00:5FAF                      PATTERN_DATA:
    6632   00:5FAF                      ; Pattern-01 is CHR$(1)+CHR$(81) = SCAN_TERMINATOR_OPEN
    6633   00:5FAF  06                      db  %00000110
    6634   00:5FB0  09                      db  %00001001
    6635   00:5FB1  09                      db  %00001001
    6636   00:5FB2  FC                      db  %11111100                   ; "Opened Padlock"
    6637   00:5FB3  FC                      db  %11111100
    6638   00:5FB4  FC                      db  %11111100
    6639   00:5FB5  FC                      db  %11111100
    6640   00:5FB6  00                      db  %00000000
    6641   00:5FB7                      ; Pattern-02 is CHR$(1)+CHR$(82) = SCAN_TERMINATOR_ENC
    6642   00:5FB7  30                      db  %00110000
    6643   00:5FB8  48                      db  %01001000
    6644   00:5FB9  48                      db  %01001000
    6645   00:5FBA  FC                      db  %11111100                   ; "Closed Padlock"
    6646   00:5FBB  FC                      db  %11111100
    6647   00:5FBC  FC                      db  %11111100
    6648   00:5FBD  FC                      db  %11111100
    6649   00:5FBE  00                      db  %00000000
    6650   00:5FBF                      ; Pattern-03 is CHR$(1)+CHR$(83) = Wi-Fi Connected to the AP:
    6651   00:5FBF  00                      db  %00000000
    6652   00:5FC0  00                      db  %00000000
    6653   00:5FC1  70                      db  %01110000
    6654   00:5FC2  70                      db  %01110000                   ; "Full Access Point"
    6655   00:5FC3  70                      db  %01110000
    6656   00:5FC4  20                      db  %00100000
    6657   00:5FC5  20                      db  %00100000
    6658   00:5FC6  70                      db  %01110000
    6659   00:5FC7                      ; Pattern-04 is CHR$(1)+CHR$(84) = Wi-Fi Failed to connect to:
    6660   00:5FC7  00                      db  %00000000
    6661   00:5FC8  88                      db  %10001000
    6662   00:5FC9  50                      db  %01010000
    6663   00:5FCA  20                      db  %00100000                   ; "X"
    6664   00:5FCB  50                      db  %01010000
    6665   00:5FCC  88                      db  %10001000
    6666   00:5FCD  00                      db  %00000000
    6667   00:5FCE  00                      db  %00000000
    6668   00:5FCF                      ; Pattern-05 is CHR$(1)+CHR$(85) = Requesting connection to:
    6669   00:5FCF  00                      db  %00000000
