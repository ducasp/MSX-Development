    5951   00:5D68                          ; Otherwise, let's speed it up baby!
    5952   00:5D68                      SSH_AUTH_GET_CHALLENGE_R:
    5953   00:5D68  ED B2                   inir
    5954   00:5D6A                          else
    5955   00:5D6A                    ~     CHECK_QUICK_RECEIVE
    5956   00:5D6A                    ~     jr  z,SSH_AUTH_GET_CHALLENGE_R_NSF       ; If not, go to the old, slower route
    5957   00:5D6A                    ~     ; Otherwise, let's speed it up baby!
    5958   00:5D6A                    ~ SSH_AUTH_GET_CHALLENGE_R:
    5959   00:5D6A                    ~     ld  a,(MEM_IN_DATA_PORT)
    5960   00:5D6A                    ~     ld  (hl),a
    5961   00:5D6A                    ~     inc hl
    5962   00:5D6A                    ~     djnz SSH_AUTH_GET_CHALLENGE_R
    5963   00:5D6A                    ~     endif
    5964   00:5D6A  15                      dec d
    5965   00:5D6B  20 FB                   jr nz,SSH_AUTH_GET_CHALLENGE_R
    5966   00:5D6D                          CHECK_BUFFER_UNDERRUN
    5966   00:5D6D  DB 07             >     in  a,(IN_STS_PORT)
    5966   00:5D6F  CB 67             >     bit 4,a
    5967   00:5D71  C2 7D 5C                jp  nz,SSH_AUTH_GET_CHALLENGE_RETRY_QRCV ; If yes, retry
    5968   00:5D74                          ; Otherwise, done
    5969   00:5D74  CD 83 5F                call    BCRESTORE               ; done, restore return data in BC
    5970   00:5D77  03                      inc bc
    5971   00:5D78  03                      inc bc
    5972   00:5D79                          ; get flags back from stack
    5973   00:5D79  E1                      pop hl
    5974   00:5D7A  AF                      xor a
    5975   00:5D7B  C9                      ret
    5976   00:5D7C                      SSH_AUTH_GET_CHALLENGE_R_NSF:
    5977   00:5D7C                          CHECK_DATA
    5977   00:5D7C  DB 07             >     in  a,(IN_STS_PORT)
    5977   00:5D7E  CB 47             >     bit 0,a
    5978   00:5D80  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_R_NSF.1
    5979   00:5D82  CD AD 5A                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5980   00:5D85  18 F5                   jr  SSH_AUTH_GET_CHALLENGE_R_NSF
    5981   00:5D87                      SSH_AUTH_GET_CHALLENGE_R_NSF.1:
    5982   00:5D87                          if USE_MEM_IO = 0
    5983   00:5D87  ED A2                   ini
    5984   00:5D89                          else
    5985   00:5D89                    ~     ld  a,(MEM_IN_DATA_PORT)
    5986   00:5D89                    ~     ld  (hl),a
    5987   00:5D89                    ~     inc hl
    5988   00:5D89                    ~     dec b
    5989   00:5D89                    ~     endif
    5990   00:5D89  20 F1                   jr  nz,SSH_AUTH_GET_CHALLENGE_R_NSF
    5991   00:5D8B  15                      dec d
    5992   00:5D8C  20 EE                   jr nz,SSH_AUTH_GET_CHALLENGE_R_NSF
    5993   00:5D8E  CD 83 5F                call    BCRESTORE               ; done, restore return data in BC
    5994   00:5D91  03                      inc bc
    5995   00:5D92  03                      inc bc
    5996   00:5D93                          ; get flags back from stack
    5997   00:5D93  E1                      pop hl
    5998   00:5D94  AF                      xor a
    5999   00:5D95  C9                      ret
