    3500   00:5215  D3 07             >     out (OUT_TX_PORT),a
    3501   00:5217  78                      ld  a,b
    3502   00:5218                          SEND_DATA                       ; Send the parameter
    3502   00:5218  D3 07             >     out (OUT_TX_PORT),a
