    4922   00:5885                      ;        C  = Close reason (only if ERR_NO_CONN is returned)
    4923   00:5885                      ;        HL = Number of total available incoming bytes
    4924   00:5885                      ;        DE = Number of urgent available incoming bytes
    4925   00:5885                      ;        IX = Available free space in the output buffer
    4926   00:5885                      ;             (0FFFFh = infinite)
    4927   00:5885                      ;
    4928   00:5885                      ;Connection information block consists of:
    4929   00:5885                      ;
    4930   00:5885                      ;    +0 (4): Remote IP address
    4931   00:5885                      ;    +4 (2): Remote port
    4932   00:5885                      ;    +6 (2): Local port
    4933   00:5885                      TCPIP_TCP_STATE_ERROR:
    4934   00:5885                          ; next two bytes are size bytes, don't care
    4935   00:5885  47                      ld  b,a                         ; save error in b
