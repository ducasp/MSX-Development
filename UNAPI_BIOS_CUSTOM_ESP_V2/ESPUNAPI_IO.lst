    3890   00:540B                          ; size goes to DE
    3891   00:540B  50                      ld  d,b
    3892   00:540C  59                      ld  e,c
    3893   00:540D                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use ini :-D
    3894   00:540D  43                      ld  b,e                         ; Number of loops originaly in DE
    3895   00:540E  1B                      dec de
    3896   00:540F  14                      inc d
    3897   00:5410                          if USE_MEM_IO = 0
    3898   00:5410  0E 06                   ld  c,IN_DATA_PORT
    3899   00:5412                          endif
    3900   00:5412                          CHECK_QUICK_RECEIVE
    3900   00:5412  DB 07             >     in  a,(IN_STS_PORT)
    3900   00:5414  CB 5F             >     bit 3,a
