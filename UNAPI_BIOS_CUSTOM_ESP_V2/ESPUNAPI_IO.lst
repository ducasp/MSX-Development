    2710   00:4E97                      ;=========================
    2711   00:4E97                      ;===  TCPIP_GET_CAPAB  ===
    2712   00:4E97                      ;=========================
    2713   00:4E97                      ; Get information about the TCP/IP capabilities and features.
    2714   00:4E97                      ;
    2715   00:4E97                      ;    Input:  A = 1
    2716   00:4E97                      ;            B = Index of information block to retrieve:
    2717   00:4E97                      ;                1: Capabilities and features flags, link level protocol
    2718   00:4E97                      ;                2: Connection pool size and status
    2719   00:4E97                      ;                3: Maximum datagram size allowed
    2720   00:4E97                      ;                4: Second set of capabilities and features flags
    2721   00:4E97                      ;    Output: A = Error code
    2722   00:4E97                      ;        When information block 1 requested:
    2723   00:4E97                      ;            HL = Capabilities flags
    2724   00:4E97                      ;            DE = Features flags
    2725   00:4E97                      ;            B  = Link level protocol used
    2726   00:4E97                      ;        When information block 2 requested:
    2727   00:4E97                      ;            B = Maximum simultaneous TCP connections supported
    2728   00:4E97                      ;            C = Maximum simultaneous UDP connections supported
    2729   00:4E97                      ;            D = Free TCP connections currently available
    2730   00:4E97                      ;            E = Free UDP connections currently available
    2731   00:4E97                      ;            H = Maximum simultaneous raw IP connections supported
    2732   00:4E97                      ;            L = Free raw IP connections currently available
    2733   00:4E97                      ;        When information block 3 requested:
    2734   00:4E97                      ;            HL = Maximum incoming datagram size supported
    2735   00:4E97                      ;            DE = Maximum outgoing datagram size supported
    2736   00:4E97                      ;        When information block 4 requested:
    2737   00:4E97                      ;            HL = Second set of capabilities flags
    2738   00:4E97                      ;            DE = Second set of features flags (currently unused, always zero)
    2739   00:4E97                      TCPIP_GET_CAPAB:
    2740   00:4E97                          SEND_DATA                       ; Send the command
    2740   00:4E97  D3 07             >     out (OUT_TX_PORT),a
    2741   00:4E99  AF                      xor a
    2742   00:4E9A                          SEND_DATA                       ; Send the command size msb
    2742   00:4E9A  D3 07             >     out (OUT_TX_PORT),a
    2743   00:4E9C  3C                      inc a
    2744   00:4E9D                          SEND_DATA                       ; Send the command size lsb
    2744   00:4E9D  D3 07             >     out (OUT_TX_PORT),a
    2745   00:4E9F  78                      ld  a,b
    2746   00:4EA0  CD 0E 5F                call    SETBYTE                 ; Save it, we are going to need it later
    2747   00:4EA3                          SEND_DATA                       ; Send the parameter
    2747   00:4EA3  D3 07             >     out (OUT_TX_PORT),a
    2748   00:4EA5                      
    2749   00:4EA5                          ; Now wait up to 120 ticks to get response
    2750   00:4EA5  21 78 00                ld  hl,120
    2751   00:4EA8  CD EC 5E                call    SETCOUNTER
    2752   00:4EAB                      TCPIP_GET_CAPAB_ST1:
    2753   00:4EAB                          CHECK_DATA
    2753   00:4EAB  DB 07             >     in  a,(IN_STS_PORT)
    2753   00:4EAD  CB 47             >     bit 0,a
    2754   00:4EAF  20 05                   jr  nz,TCPIP_GET_CAPAB_ST1.1
    2755   00:4EB1  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2756   00:4EB4  18 F5                   jr  TCPIP_GET_CAPAB_ST1
    2757   00:4EB6                      TCPIP_GET_CAPAB_ST1.1:
    2758   00:4EB6                          ; nz, check the data
    2759   00:4EB6                          RECEIVE_DATA
    2759   00:4EB6  DB 06             >     in a,(IN_DATA_PORT)
    2760   00:4EB8  FE 01                   cp  1                           ; Is response of our command?
    2761   00:4EBA  20 EF                   jr  nz,TCPIP_GET_CAPAB_ST1
    2762   00:4EBC                          ; Now get return code, if return code other than 0, it is finished
    2763   00:4EBC                      TCPIP_GET_CAPAB_RC:
    2764   00:4EBC                          CHECK_DATA
    2764   00:4EBC  DB 07             >     in  a,(IN_STS_PORT)
    2764   00:4EBE  CB 47             >     bit 0,a
    2765   00:4EC0  20 05                   jr  nz,TCPIP_GET_CAPAB_RC.1
    2766   00:4EC2  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2767   00:4EC5  18 F5                   jr  TCPIP_GET_CAPAB_RC
    2768   00:4EC7                      TCPIP_GET_CAPAB_RC.1:
    2769   00:4EC7                          ; nz, discard
    2770   00:4EC7                          RECEIVE_DATA
    2770   00:4EC7  DB 06             >     in a,(IN_DATA_PORT)
    2771   00:4EC9  B7                      or  a                           ; 0?
    2772   00:4ECA  C0                      ret nz                          ; If not, done
    2773   00:4ECB                      
    2774   00:4ECB                          ; Next two bytes are return code and size bytes, don't care
    2775   00:4ECB  06 02                   ld  b,2
    2776   00:4ECD                      TCPIP_GET_CAPAB_ST2:
    2777   00:4ECD                          CHECK_DATA
    2777   00:4ECD  DB 07             >     in  a,(IN_STS_PORT)
    2777   00:4ECF  CB 47             >     bit 0,a
    2778   00:4ED1  20 05                   jr  nz,TCPIP_GET_CAPAB_ST2.1
    2779   00:4ED3  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2780   00:4ED6  18 F5                   jr  TCPIP_GET_CAPAB_ST2
    2781   00:4ED8                      TCPIP_GET_CAPAB_ST2.1:
    2782   00:4ED8                          ; Nz, discard
    2783   00:4ED8                          RECEIVE_DATA
    2783   00:4ED8  DB 06             >     in a,(IN_DATA_PORT)
    2784   00:4EDA  05                      dec b
    2785   00:4EDB  20 F0                   jr  nz,TCPIP_GET_CAPAB_ST2
    2786   00:4EDD                      
    2787   00:4EDD                          ; Now check if block 1, 2 or 3
    2788   00:4EDD  CD FC 5E                call    GETBYTE                 ; Get the parameter we saved at the start
    2789   00:4EE0  3D                      dec a
    2790   00:4EE1  CA 7F 4F                jp  z,TCPIP_GET_CAPAB_BLK1      ; 1
    2791   00:4EE4  3D                      dec a
    2792   00:4EE5  CA 29 4F                jp  z,TCPIP_GET_CAPAB_BLK2      ; 2
    2793   00:4EE8  3D                      dec a
    2794   00:4EE9  CA EF 4E                jp  z,TCPIP_GET_CAPAB_BLK3      ; 3
    2795   00:4EEC                          ; Else, only block four, same as block 1
    2796   00:4EEC  C3 7F 4F                jp  TCPIP_GET_CAPAB_BLK1        ; 1
    2797   00:4EEF                          ; Block 3 Handling, we will receive L, H, E and D
