    5072   00:593A                      SSH_TERM_TYPE:
    5073   00:593A  CB FF                   set 7,a                         ; ESP SSH commands start at #80
    5074   00:593C                          SEND_DATA                       ; Send the command
    5074   00:593C  D3 07             >     out (OUT_TX_PORT),a
