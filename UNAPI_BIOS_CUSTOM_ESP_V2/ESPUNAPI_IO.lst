    2680   00:4E73                      ;=========================
    2681   00:4E73                      ;===  TCPIP_GET_CAPAB  ===
    2682   00:4E73                      ;=========================
    2683   00:4E73                      ; Get information about the TCP/IP capabilities and features.
    2684   00:4E73                      ;
    2685   00:4E73                      ;    Input:  A = 1
    2686   00:4E73                      ;            B = Index of information block to retrieve:
    2687   00:4E73                      ;                1: Capabilities and features flags, link level protocol
    2688   00:4E73                      ;                2: Connection pool size and status
    2689   00:4E73                      ;                3: Maximum datagram size allowed
    2690   00:4E73                      ;                4: Second set of capabilities and features flags
    2691   00:4E73                      ;    Output: A = Error code
    2692   00:4E73                      ;        When information block 1 requested:
    2693   00:4E73                      ;            HL = Capabilities flags
    2694   00:4E73                      ;            DE = Features flags
    2695   00:4E73                      ;            B  = Link level protocol used
    2696   00:4E73                      ;        When information block 2 requested:
    2697   00:4E73                      ;            B = Maximum simultaneous TCP connections supported
    2698   00:4E73                      ;            C = Maximum simultaneous UDP connections supported
    2699   00:4E73                      ;            D = Free TCP connections currently available
    2700   00:4E73                      ;            E = Free UDP connections currently available
    2701   00:4E73                      ;            H = Maximum simultaneous raw IP connections supported
    2702   00:4E73                      ;            L = Free raw IP connections currently available
    2703   00:4E73                      ;        When information block 3 requested:
    2704   00:4E73                      ;            HL = Maximum incoming datagram size supported
    2705   00:4E73                      ;            DE = Maximum outgoing datagram size supported
    2706   00:4E73                      ;        When information block 4 requested:
    2707   00:4E73                      ;            HL = Second set of capabilities flags
    2708   00:4E73                      ;            DE = Second set of features flags (currently unused, always zero)
    2709   00:4E73                      TCPIP_GET_CAPAB:
    2710   00:4E73                          SEND_DATA                       ; Send the command
    2710   00:4E73  D3 07             >     out (OUT_TX_PORT),a
    2711   00:4E75  AF                      xor a
    2712   00:4E76                          SEND_DATA                       ; Send the command size msb
    2712   00:4E76  D3 07             >     out (OUT_TX_PORT),a
    2713   00:4E78  3C                      inc a
    2714   00:4E79                          SEND_DATA                       ; Send the command size lsb
    2714   00:4E79  D3 07             >     out (OUT_TX_PORT),a
    2715   00:4E7B  78                      ld  a,b
    2716   00:4E7C  CD E2 5C                call    SETBYTE                 ; Save it, we are going to need it later
    2717   00:4E7F                          SEND_DATA                       ; Send the parameter
    2717   00:4E7F  D3 07             >     out (OUT_TX_PORT),a
    2718   00:4E81                      
    2719   00:4E81                          ; Now wait up to 120 ticks to get response
    2720   00:4E81  21 78 00                ld  hl,120
    2721   00:4E84  CD C0 5C                call    SETCOUNTER
    2722   00:4E87                      TCPIP_GET_CAPAB_ST1:
    2723   00:4E87                          CHECK_DATA
    2723   00:4E87  DB 07             >     in  a,(IN_STS_PORT)
    2723   00:4E89  CB 47             >     bit 0,a
    2724   00:4E8B  20 05                   jr  nz,TCPIP_GET_CAPAB_ST1.1
    2725   00:4E8D  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2726   00:4E90  18 F5                   jr  TCPIP_GET_CAPAB_ST1
    2727   00:4E92                      TCPIP_GET_CAPAB_ST1.1:
    2728   00:4E92                          ; nz, check the data
    2729   00:4E92                          RECEIVE_DATA
    2729   00:4E92  DB 06             >     in a,(IN_DATA_PORT)
    2730   00:4E94  FE 01                   cp  1                           ; Is response of our command?
    2731   00:4E96  20 EF                   jr  nz,TCPIP_GET_CAPAB_ST1
    2732   00:4E98                          ; Now get return code, if return code other than 0, it is finished
    2733   00:4E98                      TCPIP_GET_CAPAB_RC:
    2734   00:4E98                          CHECK_DATA
    2734   00:4E98  DB 07             >     in  a,(IN_STS_PORT)
    2734   00:4E9A  CB 47             >     bit 0,a
    2735   00:4E9C  20 05                   jr  nz,TCPIP_GET_CAPAB_RC.1
    2736   00:4E9E  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2737   00:4EA1  18 F5                   jr  TCPIP_GET_CAPAB_RC
    2738   00:4EA3                      TCPIP_GET_CAPAB_RC.1:
    2739   00:4EA3                          ; nz, discard
    2740   00:4EA3                          RECEIVE_DATA
    2740   00:4EA3  DB 06             >     in a,(IN_DATA_PORT)
    2741   00:4EA5  B7                      or  a                           ; 0?
    2742   00:4EA6  C0                      ret nz                          ; If not, done
    2743   00:4EA7                      
    2744   00:4EA7                          ; Next two bytes are return code and size bytes, don't care
    2745   00:4EA7  06 02                   ld  b,2
    2746   00:4EA9                      TCPIP_GET_CAPAB_ST2:
    2747   00:4EA9                          CHECK_DATA
    2747   00:4EA9  DB 07             >     in  a,(IN_STS_PORT)
    2747   00:4EAB  CB 47             >     bit 0,a
    2748   00:4EAD  20 05                   jr  nz,TCPIP_GET_CAPAB_ST2.1
    2749   00:4EAF  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2750   00:4EB2  18 F5                   jr  TCPIP_GET_CAPAB_ST2
    2751   00:4EB4                      TCPIP_GET_CAPAB_ST2.1:
    2752   00:4EB4                          ; Nz, discard
    2753   00:4EB4                          RECEIVE_DATA
    2753   00:4EB4  DB 06             >     in a,(IN_DATA_PORT)
    2754   00:4EB6  05                      dec b
    2755   00:4EB7  20 F0                   jr  nz,TCPIP_GET_CAPAB_ST2
    2756   00:4EB9                      
    2757   00:4EB9                          ; Now check if block 1, 2 or 3
    2758   00:4EB9  CD D0 5C                call    GETBYTE                 ; Get the parameter we saved at the start
    2759   00:4EBC  3D                      dec a
    2760   00:4EBD  CA 5B 4F                jp  z,TCPIP_GET_CAPAB_BLK1      ; 1
    2761   00:4EC0  3D                      dec a
    2762   00:4EC1  CA 05 4F                jp  z,TCPIP_GET_CAPAB_BLK2      ; 2
    2763   00:4EC4  3D                      dec a
    2764   00:4EC5  CA CB 4E                jp  z,TCPIP_GET_CAPAB_BLK3      ; 3
    2765   00:4EC8                          ; Else, only block four, same as block 1
    2766   00:4EC8  C3 5B 4F                jp  TCPIP_GET_CAPAB_BLK1        ; 1
    2767   00:4ECB                          ; Block 3 Handling, we will receive L, H, E and D
