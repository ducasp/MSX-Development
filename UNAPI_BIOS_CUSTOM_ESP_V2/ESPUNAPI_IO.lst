    1748   00:49E4  C9                      ret                             ; Time out and continue
    1749   00:49E5                      
    1750   00:49E5                      ; Check Auto Clock
    1751   00:49E5                      ISCLKAUTO:
    1752   00:49E5                          CLEAR_UART
    1752   00:49E5  3E 14             >     ld  a,20
    1752   00:49E7  D3 06             >     out (OUT_CMD_PORT),a
    1753   00:49E9  3E 63                   ld  a,CMD_QUERY_ACLK_SETTINGS
    1754   00:49EB                          SEND_DATA
    1754   00:49EB  D3 07             >     out (OUT_TX_PORT),a
    1755   00:49ED  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1756   00:49F0  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1757   00:49F4  DD 6B                   ld  ixl,e
    1758   00:49F6  DD 62                   ld  ixh,d                       ; address in IX
    1759   00:49F8  CD 33 4B                call    WAIT_MENU_CMD_RESPONSE
    1760   00:49FB  CA F0 4A                jp  z,MENU_SUB_BAD_END
    1761   00:49FE                          ; Response received, IX+0 and IX+1 has Auto Clock and GMT, A
    1762   00:49FE  C9                      ret
    1763   00:49FF                      
    1764   00:49FF                      ; Check what is the current NAGLE setting
    1765   00:49FF                      CHECKNAGLE:
    1766   00:49FF                          CLEAR_UART
    1766   00:49FF  3E 14             >     ld  a,20
    1766   00:4A01  D3 06             >     out (OUT_CMD_PORT),a
    1767   00:4A03  3E 51                   ld  a,CMD_QUERY_ESP_SETTINGS
    1768   00:4A05                          SEND_DATA
    1768   00:4A05  D3 07             >     out (OUT_TX_PORT),a
    1769   00:4A07  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1770   00:4A0A  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1771   00:4A0E  DD 6B                   ld  ixl,e
    1772   00:4A10  DD 62                   ld  ixh,d                       ; Address in IX
    1773   00:4A12  CD 33 4B                call    WAIT_MENU_CMD_RESPONSE
    1774   00:4A15  CA F0 4A                jp  z,MENU_SUB_BAD_END
    1775   00:4A18                          ; Response received, nagle is the first one, ON: or OFF:
    1776   00:4A18  3E 4F                   ld  a,'O'
    1777   00:4A1A  DD BE 00                cp  (ix+0)
    1778   00:4A1D  C2 F0 4A                jp  nz,MENU_SUB_BAD_END
    1779   00:4A20  3E 4E                   ld  a,'N'
    1780   00:4A22  DD BE 01                cp  (ix+1)
    1781   00:4A25  C2 32 4A                jp  nz,CHECK_NAGLE_OFF
    1782   00:4A28  3E 3A                   ld  a,':'
    1783   00:4A2A  DD BE 02                cp  (ix+2)
    1784   00:4A2D  C2 F0 4A                jp  nz,MENU_SUB_BAD_END
    1785   00:4A30  B7                      or  a                           ; It will make it NZ
    1786   00:4A31  C9                      ret
    1787   00:4A32                      CHECK_NAGLE_OFF:
    1788   00:4A32  3E 46                   ld  a,'F'
    1789   00:4A34  DD BE 01                cp  (ix+1)
    1790   00:4A37  C2 F0 4A                jp  nz,MENU_SUB_BAD_END
    1791   00:4A3A  3E 46                   ld  a,'F'
    1792   00:4A3C  DD BE 02                cp  (ix+2)
    1793   00:4A3F  C2 F0 4A                jp  nz,MENU_SUB_BAD_END
    1794   00:4A42  3E 3A                   ld  a,':'
    1795   00:4A44  DD BE 03                cp  (ix+3)
    1796   00:4A47  C2 F0 4A                jp  nz,MENU_SUB_BAD_END
    1797   00:4A4A                          ; Already has zero, so just ret
    1798   00:4A4A  C9                      ret
    1799   00:4A4B                      
    1800   00:4A4B                      ; Check what is the current TIMEOUT setting, return 0 if always on, otherwise there is a timeout
    1801   00:4A4B                      ; Will return a zero terminated string @ HL that can be printed
    1802   00:4A4B                      ; Will return the value in DE
    1803   00:4A4B                      CHECKTIMEOUT:
    1804   00:4A4B                          CLEAR_UART
    1804   00:4A4B  3E 14             >     ld  a,20
    1804   00:4A4D  D3 06             >     out (OUT_CMD_PORT),a
    1805   00:4A4F  3E 51                   ld  a,CMD_QUERY_ESP_SETTINGS
    1806   00:4A51                          SEND_DATA
    1806   00:4A51  D3 07             >     out (OUT_TX_PORT),a
    1807   00:4A53  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1808   00:4A56  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1809   00:4A5A  DD 6B                   ld  ixl,e
    1810   00:4A5C  DD 62                   ld  ixh,d                       ; Address in IX
    1811   00:4A5E  CD 33 4B                call    WAIT_MENU_CMD_RESPONSE
    1812   00:4A61  CA F0 4A                jp  z,MENU_SUB_BAD_END
    1813   00:4A64                          ; Response received, nagle is the first one, ON: or OFF:
    1814   00:4A64  3E 3A                   ld  a,':'
    1815   00:4A66  DD 23                   inc ix
    1816   00:4A68  DD 23                   inc ix                          ; Nagle response is two or three bytes long, let's check
    1817   00:4A6A  0B                      dec bc
    1818   00:4A6B  0B                      dec bc                          ; Remaining bytes
    1819   00:4A6C  DD BE 00                cp  (ix+0)
    1820   00:4A6F  CA 7B 4A                jp  z,CHECKTIMEOUT.1
    1821   00:4A72  DD 23                   inc ix
    1822   00:4A74  0B                      dec bc                          ; Remaining bytes
    1823   00:4A75  DD BE 00                cp  (ix+0)
    1824   00:4A78  C2 F0 4A                jp  nz,MENU_SUB_BAD_END         ; If not here, sorry to say it is an error
    1825   00:4A7B                      CHECKTIMEOUT.1:
    1826   00:4A7B  78                      ld  a,b
    1827   00:4A7C  B1                      or  c                           ; All data read?
    1828   00:4A7D  CA F0 4A                jp  z,MENU_SUB_BAD_END          ; If so, sorry to say it is an error
    1829   00:4A80  DD 23                   inc ix                          ; At the first digit
    1830   00:4A82  0B                      dec bc                          ; Remaining bytes
    1831   00:4A83  78                      ld  a,b
    1832   00:4A84  B1                      or  c                           ; All data read?
    1833   00:4A85  CA F0 4A                jp  z,MENU_SUB_BAD_END          ; If so, sorry to say it is an error
    1834   00:4A88  DD E5                   push    ix                      ; This is the start of the string, save it
    1835   00:4A8A  26 00                   ld  h,0                         ; No digit so far
    1836   00:4A8C                          ; It can have up to three digits
    1837   00:4A8C                      CHECKTIMEOUT.2:
    1838   00:4A8C  3E 3A                   ld  a,':'
    1839   00:4A8E  DD BE 00                cp  (ix+0)                      ; Check if it is the separator
    1840   00:4A91  CA B2 4A                jp  z,CHECKTIMEOUT.3            ; If it is routine will follow through
    1841   00:4A94  DD 7E 00                ld  a,(ix+0)                    ; Get the supposed digit in A
    1842   00:4A97  2E 3A                   ld  l,'9'+1
    1843   00:4A99  BD                      cp  l
    1844   00:4A9A  D2 EF 4A                jp  nc,MENU_SUB_BAD_END_1S      ; If more than '9', sorry to say it is an error
    1845   00:4A9D  2E 30                   ld  l,'0'
    1846   00:4A9F  BD                      cp  l
    1847   00:4AA0  DA EF 4A                jp  c,MENU_SUB_BAD_END_1S       ; If less than '0', sorry to say it is an error
    1848   00:4AA3  24                      inc h                           ; It is not, so it is a digit
    1849   00:4AA4  3E 03                   ld  a,3
    1850   00:4AA6  BC                      cp  h
    1851   00:4AA7  DA EF 4A                jp  c,MENU_SUB_BAD_END_1S       ; If more than three digits, sorry to say it is an error
    1852   00:4AAA  DD 23                   inc ix                          ; Increase pointer
    1853   00:4AAC  0B                      dec bc                          ; Decrease remaining
    1854   00:4AAD  78                      ld  a,b
    1855   00:4AAE  B1                      or  c                           ; All data read?
    1856   00:4AAF  C2 8C 4A                jp  nz,CHECKTIMEOUT.2           ; Not, so rinse and repeat
    1857   00:4AB2                      CHECKTIMEOUT.3:
    1858   00:4AB2  DD 36 00 00             ld  (ix+0),0                    ; Null terminate string value
    1859   00:4AB6  DD 2B                   dec ix
    1860   00:4AB8  DD 7E 00                ld  a,(ix+0)                    ; 1st Digit in A
    1861   00:4ABB  D6 30                   sub '0'                         ; Convert it to decimal value
    1862   00:4ABD  5F                      ld  e,a
    1863   00:4ABE  16 00                   ld  d,0                         ; DE has first digit
    1864   00:4AC0  25                      dec h                           ; Decrement digit counter
    1865   00:4AC1  28 28                   jr  z,CHECKTIMEOUT.END          ; If all digits, done
    1866   00:4AC3                          ; Now second digit, multiply it by 10 and add to E, even if 90 + 9, still fits E
    1867   00:4AC3  DD 2B                   dec ix
    1868   00:4AC5  DD 7E 00                ld  a,(ix+0)                    ; 2nd Digit
    1869   00:4AC8  D6 30                   sub '0'                         ; Convert it to decimal value
    1870   00:4ACA  87                      add a,a                         ; A has *2
    1871   00:4ACB  4F                      ld  c,a                         ; C has *2
    1872   00:4ACC  87                      add a,a                         ; A has *4
    1873   00:4ACD  87                      add a,a                         ; A has *8
    1874   00:4ACE  81                      add a,c                         ; A has *10
    1875   00:4ACF  83                      add a,e                         ; A has two digits result
    1876   00:4AD0  5F                      ld  e,a                         ; Back to E, DE has two digits results
    1877   00:4AD1  25                      dec h                           ; Decrement digit counter
    1878   00:4AD2  28 17                   jr  z,CHECKTIMEOUT.END          ; If all digits, done
    1879   00:4AD4                          ; Now Third digit, multiply it by 100 and add to DE
    1880   00:4AD4  DD 2B                   dec ix
    1881   00:4AD6  DD 7E 00                ld  a,(ix+0)                    ; 3rd Digit
    1882   00:4AD9  D6 30                   sub '0'                         ; Convert it to decimal value
    1883   00:4ADB  87                      add a,a                         ; A has *2
    1884   00:4ADC  4F                      ld  c,a                         ; C has *2
    1885   00:4ADD  87                      add a,a                         ; A has *4
    1886   00:4ADE  87                      add a,a                         ; A has *8
    1887   00:4ADF  81                      add a,c                         ; A has *10
    1888   00:4AE0  26 00                   ld  h,0
    1889   00:4AE2  6F                      ld  l,a                         ; HL has *10
    1890   00:4AE3  29                      add hl,hl                       ; HL has *20
    1891   00:4AE4  44                      ld  b,h
    1892   00:4AE5  4D                      ld  c,l                         ; BC has *20
    1893   00:4AE6  29                      add hl,hl                       ; HL has *40
    1894   00:4AE7  29                      add hl,hl                       ; HL has *80
    1895   00:4AE8  09                      add hl,bc                       ; HL has *100
    1896   00:4AE9  19                      add hl,de                       ; HL has three digit value
    1897   00:4AEA  EB                      ex  de,hl                       ; now in DE
    1898   00:4AEB                      CHECKTIMEOUT.END:
    1899   00:4AEB  E1                      pop hl                          ; Restore address of string version of time count
    1900   00:4AEC  7A                      ld  a,d
    1901   00:4AED  B3                      or  e                           ; Set zero flag according to the time out set
    1902   00:4AEE  C9                      ret
    1903   00:4AEF                      
    1904   00:4AEF                      MENU_SUB_BAD_END_1S:
    1905   00:4AEF  F1                      pop af                          ; 1 register was stacked, pop it
    1906   00:4AF0                      MENU_SUB_BAD_END:
    1907   00:4AF0  F1                      pop af                          ; It was a sub, so clear stack
    1908   00:4AF1                      MENU_BAD_END:
    1909   00:4AF1  21 B2 6F                ld  hl,STR_SENDING_FAIL         ; error message
    1910   00:4AF4  CD 47 4C                call    PRINTHL
    1911   00:4AF7  C3 D6 49                jp  WAIT_2S_AND_THEN_MAINMENU
    1912   00:4AFA                      
    1913   00:4AFA                      ; WAIT an ESP quick command Response
    1914   00:4AFA                      ; Inputs:
    1915   00:4AFA                      ; A -> Command Code
    1916   00:4AFA                      ; HL -> Timeout
    1917   00:4AFA                      ;
    1918   00:4AFA                      ; Returns:
    1919   00:4AFA                      ; Flag Z is zero if failure, non zero if success
    1920   00:4AFA                      ;
    1921   00:4AFA                      ; Affect:
    1922   00:4AFA                      ; AF and HL
    1923   00:4AFA                      ;
    1924   00:4AFA                      WAIT_MENU_QCMD_RESPONSE:
    1925   00:4AFA  D5                      push    de
    1926   00:4AFB  57                      ld  d,a                         ; Command to wait in D
    1927   00:4AFC                      WAIT_MENU_QCMD_RESPONSE_ST1:
    1928   00:4AFC                          LOAD_STS_PORT_IN_A
    1928   00:4AFC  DB 07             >     in  a,(IN_STS_PORT)
    1929   00:4AFE  CB 6F                   bit 5,a                         ; If nz Port #07 is not available
    1930   00:4B00  C2 2D 4B                jp  nz,WAIT_MENU_QCMD_RESPONSE_END_NOK
    1931   00:4B03  CB 47                   bit 0,a                         ; If nz has data
    1932   00:4B05  20 08                   jr  nz,WAIT_MENU_QCMD_RESPONSE_ST1.1
    1933   00:4B07  CD 41 4C                call    HLTIMEOUT
    1934   00:4B0A  20 F0                   jr  nz,WAIT_MENU_QCMD_RESPONSE_ST1
    1935   00:4B0C  C3 2B 4B                jp  WAIT_MENU_QCMD_RESPONSE_END ; If time out waiting, return
    1936   00:4B0F                      WAIT_MENU_QCMD_RESPONSE_ST1.1:
    1937   00:4B0F                          ; nz, check the data
    1938   00:4B0F                          RECEIVE_DATA
    1938   00:4B0F  DB 06             >     in a,(IN_DATA_PORT)
    1939   00:4B11  BA                      cp  d                           ; Is response of our command?
    1940   00:4B12  20 E8                   jr  nz,WAIT_MENU_QCMD_RESPONSE_ST1
    1941   00:4B14                          ; Now get return code, if return code other than 0, it is failure, otherwise success
    1942   00:4B14                      WAIT_MENU_QCMD_RESPONSE_RC:
    1943   00:4B14                          CHECK_DATA
    1943   00:4B14  DB 07             >     in  a,(IN_STS_PORT)
    1943   00:4B16  CB 47             >     bit 0,a
    1944   00:4B18  20 08                   jr  nz,WAIT_MENU_QCMD_RESPONSE_RC.1
    1945   00:4B1A  CD 41 4C                call    HLTIMEOUT
    1946   00:4B1D  20 F5                   jr  nz,WAIT_MENU_QCMD_RESPONSE_RC
    1947   00:4B1F  C3 2B 4B                jp  WAIT_MENU_QCMD_RESPONSE_END ; If time-out waiting, return
    1948   00:4B22                      WAIT_MENU_QCMD_RESPONSE_RC.1:
    1949   00:4B22                          RECEIVE_DATA
    1949   00:4B22  DB 06             >     in a,(IN_DATA_PORT)
    1950   00:4B24  B7                      or  a                           ; 0?
    1951   00:4B25                          ; If not, done
    1952   00:4B25  C2 2D 4B                jp  nz,WAIT_MENU_QCMD_RESPONSE_END_NOK
    1953   00:4B28                      WAIT_MENU_QCMD_RESPONSE_END_OK:
    1954   00:4B28  3E 01                   ld  a,1
    1955   00:4B2A  B7                      or  a                           ; NZ to indicate success
    1956   00:4B2B                      WAIT_MENU_QCMD_RESPONSE_END:
    1957   00:4B2B  D1                      pop de
    1958   00:4B2C  C9                      ret
    1959   00:4B2D                      WAIT_MENU_QCMD_RESPONSE_END_NOK:
    1960   00:4B2D  21 00 00                ld  hl,0
    1961   00:4B30  AF                      xor a
    1962   00:4B31  D1                      pop de
    1963   00:4B32  C9                      ret
    1964   00:4B33                      
    1965   00:4B33                      ; WAIT an ESP regular command Response
    1966   00:4B33                      ; Inputs:
    1967   00:4B33                      ; A -> Command Code
    1968   00:4B33                      ; HL -> Timeout
    1969   00:4B33                      ; IX -> Where to store response
    1970   00:4B33                      ;
    1971   00:4B33                      ; Returns:
    1972   00:4B33                      ; Flag Z is zero if failure, non zero if success
    1973   00:4B33                      ; BC is the response size
    1974   00:4B33                      ;
    1975   00:4B33                      ; Affect:
    1976   00:4B33                      ; AF , BC and HL
    1977   00:4B33                      WAIT_MENU_CMD_RESPONSE:
    1978   00:4B33  D5                      push    de
    1979   00:4B34  DD E5                   push    ix
    1980   00:4B36  57                      ld  d,a                         ; Command to wait in D
    1981   00:4B37                      WAIT_MENU_CMD_RESPONSE_ST1:
    1982   00:4B37                          LOAD_STS_PORT_IN_A
    1982   00:4B37  DB 07             >     in  a,(IN_STS_PORT)
    1983   00:4B39  CB 6F                   bit 5,a                         ; If nz Port #07 is not available
