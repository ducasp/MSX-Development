    1299   00:46BC  B9                      cp  c                           ; Has any data to delete?
    1300   00:46BD  28 9B                   jr  z,WIFI_CONNECT_MANUAL_ENTRY ; No
    1301   00:46BF                          ; Yes
    1302   00:46BF  2B                      dec hl                          ; Decrement pointer
    1303   00:46C0  0D                      dec c                           ; Decrement counter
    1304   00:46C1  3E 08                   ld  a,8                         ; Backspace
    1305   00:46C3  CD A2 00                call    CHPUT                   ; Print it
    1306   00:46C6  3E 20                   ld  a,' '                       ; Space
    1307   00:46C8  CD A2 00                call    CHPUT                   ; Print it
    1308   00:46CB  3E 08                   ld  a,8                         ; Backspace
    1309   00:46CD  CD A2 00                call    CHPUT                   ; Print it
    1310   00:46D0  18 88                   jr  WIFI_CONNECT_MANUAL_ENTRY   ; Return
    1311   00:46D2                      WIFI_ME_CHECK_INPUT:
