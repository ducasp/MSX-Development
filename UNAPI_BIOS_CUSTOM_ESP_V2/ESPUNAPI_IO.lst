    7048   00:61DD  D1                      pop de
    7049   00:61DE  C9                      ret
    7050   00:61DF                      
    7051   00:61DF                      ;--- Obtain if DNS is ready saved in high memory
    7052   00:61DF                      ;    Input:  none
    7053   00:61DF                      ;    Output: A = DNS ready value
    7054   00:61DF                      ;    Modifies: AF
    7055   00:61DF                      
    7056   00:61DF                      GETDNSREADY:
    7057   00:61DF  C5                      push    bc
    7058   00:61E0  D5                      push    de
    7059   00:61E1  E5                      push    hl
    7060   00:61E2  CD 3F 60                call    GETSLT
    7061   00:61E5                          ; Slot in A, now get the address
    7062   00:61E5  CD C8 60                call    GETMEMPOINTER
    7063   00:61E8                          ; HL has the address of our memory area, DNS ready is 8 bytes after start
    7064   00:61E8  11 08 00                ld  de,MEMORY_DNS_READY_OFFSET
    7065   00:61EB  19                      add hl,de
    7066   00:61EC                          ; Ok, get it
    7067   00:61EC  7E                      ld  a,(hl)
    7068   00:61ED  E1                      pop hl
    7069   00:61EE  D1                      pop de
    7070   00:61EF  C1                      pop bc
    7071   00:61F0  C9                      ret
    7072   00:61F1                      
    7073   00:61F1                      ;--- Set DNS redy in high memory
    7074   00:61F1                      ;    Input:  A = new value
    7075   00:61F1                      ;    Output: none
    7076   00:61F1                      ;    Modifies: AF
    7077   00:61F1                      
    7078   00:61F1                      SETDNSREADY:
    7079   00:61F1  C5                      push    bc
    7080   00:61F2  D5                      push    de
    7081   00:61F3  E5                      push    hl
    7082   00:61F4  F5                      push    af                      ; Save parameter
    7083   00:61F5  CD 3F 60                call    GETSLT
    7084   00:61F8                          ; Slot in A, now get the address
    7085   00:61F8  CD C8 60                call    GETMEMPOINTER
    7086   00:61FB                          ; HL has the address of our memory area, DNS ready is 8 bytes after start
    7087   00:61FB  11 08 00                ld  de,MEMORY_DNS_READY_OFFSET
    7088   00:61FE  19                      add hl,de
    7089   00:61FF                          ; HL has the address of DNS ready
    7090   00:61FF  F1                      pop af                          ; Restore parameter
    7091   00:6200  77                      ld  (hl),a
    7092   00:6201  E1                      pop hl
    7093   00:6202  D1                      pop de
    7094   00:6203  C1                      pop bc
    7095   00:6204  C9                      ret
    7096   00:6205                      
    7097   00:6205                      ;--- Obtain DNS result saved in high memory
    7098   00:6205                      ;    Input:  none
    7099   00:6205                      ;    Output: HL DE = DNS result
    7100   00:6205                      ;    Modifies: AF
    7101   00:6205                      
    7102   00:6205                      GETDNSRESULT:
    7103   00:6205  C5                      push    bc
    7104   00:6206  CD 3F 60                call    GETSLT
    7105   00:6209                          ; Slot in A, now get the address
    7106   00:6209  CD C8 60                call    GETMEMPOINTER
    7107   00:620C                          ; HL has the address of our memory area, DNS result is 9 bytes after start
    7108   00:620C  11 09 00                ld  de,MEMORY_DNS_RES_OFFSET
    7109   00:620F  19                      add hl,de
    7110   00:6210                          ; Ok, get it, first bytes are hl
    7111   00:6210  5E                      ld  e,(hl)
    7112   00:6211  23                      inc hl
    7113   00:6212  56                      ld  d,(hl)
    7114   00:6213  D5                      push    de                      ; for now, save in stack, so we can restore to HL later
    7115   00:6214  23                      inc hl
    7116   00:6215  5E                      ld  e,(hl)
    7117   00:6216  23                      inc hl
    7118   00:6217  56                      ld  d,(hl)
    7119   00:6218  E1                      pop hl                          ; and now restore HL value from stack
    7120   00:6219  C1                      pop bc
    7121   00:621A  C9                      ret
    7122   00:621B                      
    7123   00:621B                      ;--- Set DNS result in high memory
    7124   00:621B                      ;    Input:  HL DE = new value
    7125   00:621B                      ;    Output: none
    7126   00:621B                      ;    Modifies: AF
    7127   00:621B                      
    7128   00:621B                      SETDNSRESULT:
    7129   00:621B  C5                      push    bc
    7130   00:621C  D5                      push    de
    7131   00:621D  E5                      push    hl
    7132   00:621E  CD 3F 60                call    GETSLT
    7133   00:6221                          ; Slot in A, now get the address
    7134   00:6221  CD C8 60                call    GETMEMPOINTER
    7135   00:6224                          ; HL has the address of our memory area, DNS result is 9 bytes after start
    7136   00:6224  11 09 00                ld  de,MEMORY_DNS_RES_OFFSET
    7137   00:6227  19                      add hl,de
    7138   00:6228                          ; HL has the address of DNS result
    7139   00:6228  C1                      pop bc                          ; Restore parameter HL in BC
    7140   00:6229  71                      ld  (hl),c
    7141   00:622A  23                      inc hl
    7142   00:622B  70                      ld  (hl),b
    7143   00:622C  D1                      pop de                          ; Restore parameter DE in DE
    7144   00:622D  23                      inc hl
    7145   00:622E  73                      ld  (hl),e
    7146   00:622F  23                      inc hl
    7147   00:6230  72                      ld  (hl),d
    7148   00:6231  69                      ld  l,c
    7149   00:6232  60                      ld  h,b                         ; And HL is restored
    7150   00:6233  C1                      pop bc                          ; Restore BC
    7151   00:6234  C9                      ret
    7152   00:6235                      
    7153   00:6235                      ;--- Convert a character to upper-case if it is a lower-case letter
    7154   00:6235                      TOUPPER:
    7155   00:6235  FE 61                   cp  "a"
    7156   00:6237  D8                      ret c
    7157   00:6238  FE 7B                   cp  "z"+1
    7158   00:623A  D0                      ret nc
    7159   00:623B  E6 DF                   and #DF
    7160   00:623D  C9                      ret
