    3496   00:521B                          SEND_DATA                       ; Send the command size lsb
    3496   00:521B  D3 07             >     out (OUT_TX_PORT),a
    3497   00:521D  78                      ld  a,b
    3498   00:521E                          SEND_DATA                       ; Send the parameter
    3498   00:521E  D3 07             >     out (OUT_TX_PORT),a
    3499   00:5220                      
    3500   00:5220                          ; Now wait up to 60 ticks to get response
    3501   00:5220  21 3C 00                ld  hl,60
    3502   00:5223  CD DF 60                call    SETCOUNTER
    3503   00:5226                      TCPIP_UDP_STATE_ST1:
