    2809   00:4EFD                          CHECK_DATA
    2809   00:4EFD  DB 07             >     in  a,(IN_STS_PORT)
    2809   00:4EFF  CB 47             >     bit 0,a
    2810   00:4F01  20 05                   jr  nz,TCPIP_GET_CAPAB_BLK3_ST2.1
    2811   00:4F03  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2812   00:4F06  18 F5                   jr  TCPIP_GET_CAPAB_BLK3_ST2
