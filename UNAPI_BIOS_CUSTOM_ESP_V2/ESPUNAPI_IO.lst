    2133   00:4C0F  DD 23                   inc ix                          ; Increment pointer
    2134   00:4C11  B7                      or  a                           ; Terminator of AP Name?
    2135   00:4C12  20 E8                   jr  nz,WAIT_MENU_SCMD_RESPONSE_ST2B
    2136   00:4C14                          ; Get encryption
    2137   00:4C14                      WAIT_MENU_SCMD_RESPONSE_GET_ENC:
    2138   00:4C14                          CHECK_DATA
    2138   00:4C14  DB 07             >     in  a,(IN_STS_PORT)
    2138   00:4C16  CB 47             >     bit 0,a
    2139   00:4C18  20 08                   jr  nz,WAIT_MENU_SCMD_RESPONSE_GET_ENC.1
    2140   00:4C1A  CD 41 4C                call    HLTIMEOUT
    2141   00:4C1D  20 F5                   jr  nz,WAIT_MENU_SCMD_RESPONSE_GET_ENC
    2142   00:4C1F  C3 34 4C                jp  WAIT_MENU_SCMD_RESPONSE_END  ; If time out waiting, return
    2143   00:4C22                      WAIT_MENU_SCMD_RESPONSE_GET_ENC.1:
    2144   00:4C22                          RECEIVE_DATA            ; Get data
    2144   00:4C22  DB 06             >     in a,(IN_DATA_PORT)
    2145   00:4C24  D6 4F                   sub 'O'                         ; If O, open, will be 0, otherwise, will be notzero
    2146   00:4C26  DD 77 00                ld  (ix+0),a                    ; Put it in the buffer
    2147   00:4C29  DD 23                   inc ix                          ; Increment pointer
    2148   00:4C2B  0D                      dec c                           ; Decrement counter
    2149   00:4C2C  AF                      xor a
    2150   00:4C2D  B1                      or  c                           ; Is counter 0?
    2151   00:4C2E                          ; If not continue getting more SSIDs
    2152   00:4C2E  20 CC                   jr  nz,WAIT_MENU_SCMD_RESPONSE_ST2B
    2153   00:4C30                          ; It is zero, so, done
    2154   00:4C30                      WAIT_MENU_SCMD_RESPONSE_END_OK:
    2155   00:4C30  3E 01                   ld  a,1
    2156   00:4C32  B7                      or  a                           ; NZ to indicate success
    2157   00:4C33  78                      ld  a,b                         ; Number of APs in A
    2158   00:4C34                      WAIT_MENU_SCMD_RESPONSE_END:
    2159   00:4C34  DD E1                   pop ix
    2160   00:4C36  D1                      pop de
    2161   00:4C37  C9                      ret
    2162   00:4C38                      WAIT_MENU_SCMD_RESPONSE_END_NOK:
    2163   00:4C38  21 00 00                ld  hl,0
    2164   00:4C3B  47                      ld  b,a                         ; Return code in B
    2165   00:4C3C  AF                      xor a
    2166   00:4C3D  DD E1                   pop ix
    2167   00:4C3F  D1                      pop de
    2168   00:4C40  C9                      ret
    2169   00:4C41                      
    2170   00:4C41                      ; This routine will check if HL is 0, if it is, will return immediatelly
    2171   00:4C41                      ; If it is not, will decrease HL value and halt (wait one interrupt)
    2172   00:4C41                      HLTIMEOUT:
    2173   00:4C41  7C                      ld  a,h
    2174   00:4C42  B5                      or  l
    2175   00:4C43  C8                      ret z
    2176   00:4C44  2B                      dec hl
    2177   00:4C45  76                      halt
    2178   00:4C46  C9                      ret
    2179   00:4C47                      
    2180   00:4C47                      ; Routine to print the string addressed by HL
    2181   00:4C47                      PRINTHL:
    2182   00:4C47  7E                      ld  a,(hl)
    2183   00:4C48  B7                      or  a
    2184   00:4C49  C8                      ret z                           ; When string is finished, done!
    2185   00:4C4A  CD A2 00                call    CHPUT
    2186   00:4C4D  23                      inc hl
    2187   00:4C4E  C3 47 4C                jp  PRINTHL
    2188   00:4C51                      
    2189   00:4C51                      ; Routine to print the string addressed by HL on a line, if exceeding it, ends with ..
    2190   00:4C51                      PRINTHLINE:
    2191   00:4C51  C5                      push    bc
    2192   00:4C52  06 18                   ld  b,24
    2193   00:4C54                      PHLINEL:
