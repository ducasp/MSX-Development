    1626   00:48DC                      SET_NAGLE:
    1627   00:48DC  3E 31                   ld  a,'1'
    1628   00:48DE  CD A2 00                call    CHPUT
    1629   00:48E1  CD EB 49                call    WAIT_250MS_AND_THEN_CONTINUE
    1630   00:48E4  21 95 6C                ld  hl,MMENU_NAGLE
    1631   00:48E7  CD 54 4C                call    PRINTHL                 ; Print Main Nagle message
    1632   00:48EA  CD 0C 4A                call    CHECKNAGLE              ; Nagle is on or off?
    1633   00:48ED  20 1E                   jr  nz,NAGLE_IS_ON              ;
    1634   00:48EF  21 CA 6D                ld  hl,MMENU_NAGLE_OFF          ; Show the menu telling nagle is off
    1635   00:48F2  CD 54 4C                call    PRINTHL                 ; Print options
    1636   00:48F5                      SET_NAGLE_WI_ON:
