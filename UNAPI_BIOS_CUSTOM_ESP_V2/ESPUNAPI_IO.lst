    5927   00:5D54  18 F5                   jr  SSH_AUTH_GET_CHALLENGE_FLAGSB
    5928   00:5D56                      SSH_AUTH_GET_CHALLENGE_FLAGSB.1:
    5929   00:5D56                          ; nz, prompts, C to later go to L
    5930   00:5D56                          RECEIVE_DATA
    5930   00:5D56  DB 06             >     in a,(IN_DATA_PORT)
    5931   00:5D58  4F                      ld c,a
    5932   00:5D59  C5                      push    bc                      ; stack has the flags
    5933   00:5D5A                          ; Now let's decrease HL as we've read 2 bytes
    5934   00:5D5A  2B                      dec hl
    5935   00:5D5B  2B                      dec hl
    5936   00:5D5C                          ; And loop for the whole remaining response
    5937   00:5D5C  4D                      ld  c,l
    5938   00:5D5D  44                      ld  b,h                         ; BC has effective received data size, as well as HL
    5939   00:5D5E                          ; put effective data size in de
    5940   00:5D5E  EB                      ex  de,hl
    5941   00:5D5F                          ; will start moving at address in stack (we've pushed the adress in WORD)
    5942   00:5D5F  CD 2A 5F                call    GETWORD
    5943   00:5D62  CD 9D 5F                call    BCBACKUP                ; save count (BC)
    5944   00:5D65                      
    5945   00:5D65                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use ini :-D
    5946   00:5D65  43                      ld  b,e                         ; Number of loops originaly in DE
    5947   00:5D66  1B                      dec de
    5948   00:5D67  14                      inc d
    5949   00:5D68                          if USE_MEM_IO = 0
    5950   00:5D68  0E 06                   ld  c,IN_DATA_PORT
    5951   00:5D6A                          CHECK_QUICK_RECEIVE
    5951   00:5D6A  DB 07             >     in  a,(IN_STS_PORT)
    5951   00:5D6C  CB 5F             >     bit 3,a
    5952   00:5D6E  28 14                   jr  z,SSH_AUTH_GET_CHALLENGE_R_NSF             ; If not, go to the old, slower route
    5953   00:5D70                          ; Otherwise, let's speed it up baby!
    5954   00:5D70                      SSH_AUTH_GET_CHALLENGE_R:
    5955   00:5D70  ED B2                   inir
    5956   00:5D72                          else
    5957   00:5D72                    ~     CHECK_QUICK_RECEIVE
    5958   00:5D72                    ~     jr  z,SSH_AUTH_GET_CHALLENGE_R_NSF       ; If not, go to the old, slower route
    5959   00:5D72                    ~     ; Otherwise, let's speed it up baby!
    5960   00:5D72                    ~ SSH_AUTH_GET_CHALLENGE_R:
    5961   00:5D72                    ~     ld  a,(MEM_IN_DATA_PORT)
    5962   00:5D72                    ~     ld  (hl),a
    5963   00:5D72                    ~     inc hl
    5964   00:5D72                    ~     djnz SSH_AUTH_GET_CHALLENGE_R
    5965   00:5D72                    ~     endif
    5966   00:5D72  15                      dec d
    5967   00:5D73  20 FB                   jr nz,SSH_AUTH_GET_CHALLENGE_R
