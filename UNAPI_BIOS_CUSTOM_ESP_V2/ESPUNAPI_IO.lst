    2817   00:4F10  DB 06             >     in a,(IN_DATA_PORT)
    2818   00:4F12  67                      ld  h,a
    2819   00:4F13                      TCPIP_GET_CAPAB_BLK3_ST3:
    2820   00:4F13                          CHECK_DATA
    2820   00:4F13  DB 07             >     in  a,(IN_STS_PORT)
    2820   00:4F15  CB 47             >     bit 0,a
    2821   00:4F17  20 05                   jr  nz,TCPIP_GET_CAPAB_BLK3_ST3.1
    2822   00:4F19  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2823   00:4F1C  18 F5                   jr  TCPIP_GET_CAPAB_BLK3_ST3
