    3039   00:5023  D3 07             >     out (OUT_TX_PORT),a
    3040   00:5025                          SEND_DATA                       ; Send the command size lsb
    3040   00:5025  D3 07             >     out (OUT_TX_PORT),a
    3041   00:5027                      
    3042   00:5027                          ; Now wait up to 720 ticks to get response
    3043   00:5027  21 D0 02                ld  hl,720
