    5524   00:5B95                      ;========================
    5525   00:5B95                      ;===  TCPIP_TCP_SEND  ===
    5526   00:5B95                      ;========================
    5527   00:5B95                      ;Send data to a TCP connection.
    5528   00:5B95                      ;
    5529   00:5B95                      ;Input:  A  = 17
    5530   00:5B95                      ;        B  = Connection number
    5531   00:5B95                      ;        DE = Address of the data to be sent
    5532   00:5B95                      ;        HL = Length of the data to be sent
    5533   00:5B95                      ;        C  = Flags:
    5534   00:5B95                      ;             bit 0: Send the data PUSHed
    5535   00:5B95                      ;             bit 1: The data is urgent
    5536   00:5B95                      ;Output: A = Error code
    5537   00:5B95                      TCPIP_TCP_SEND:
    5538   00:5B95  E5                      push    hl
    5539   00:5B96  D5                      push    de
    5540   00:5B97                          SEND_DATA                       ; Send the command
    5540   00:5B97  D3 07             >     out (OUT_TX_PORT),a
    5541   00:5B99                          ; prepare new data size, adding our 2 bytes overhead
    5542   00:5B99  11 02 00                ld  de,2
    5543   00:5B9C  19                      add hl,de
    5544   00:5B9D  7C                      ld  a,h
    5545   00:5B9E                          SEND_DATA                       ; Send the command size msb
    5545   00:5B9E  D3 07             >     out (OUT_TX_PORT),a
    5546   00:5BA0  7D                      ld  a,l
    5547   00:5BA1                          SEND_DATA                       ; Send the command size lsb
    5547   00:5BA1  D3 07             >     out (OUT_TX_PORT),a
    5548   00:5BA3  78                      ld  a,b
    5549   00:5BA4                          SEND_DATA                       ; Send the connection #
    5549   00:5BA4  D3 07             >     out (OUT_TX_PORT),a
    5550   00:5BA6  79                      ld  a,c
    5551   00:5BA7                          SEND_DATA                       ; Send the connection flags
    5551   00:5BA7  D3 07             >     out (OUT_TX_PORT),a
    5552   00:5BA9  E1                      pop hl
    5553   00:5BAA  D1                      pop de
    5554   00:5BAB                          ; now oti the data starting at hl, size is in DE
    5555   00:5BAB                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    5556   00:5BAB  43                      ld  b,e                         ;Number of loops originaly in DE
    5557   00:5BAC  1B                      dec de
    5558   00:5BAD  14                      inc d
    5559   00:5BAE                          if USE_MEM_IO = 0
    5560   00:5BAE  0E 07                   ld  c,OUT_TX_PORT
    5561   00:5BB0                      TCPIP_TCP_SEND_R:
    5562   00:5BB0  ED A3                   outi
