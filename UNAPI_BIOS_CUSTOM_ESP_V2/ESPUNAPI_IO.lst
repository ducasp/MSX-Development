    5942   00:5D5D                      
    5943   00:5D5D                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use ini :-D
    5944   00:5D5D  43                      ld  b,e                         ; Number of loops originaly in DE
    5945   00:5D5E  1B                      dec de
    5946   00:5D5F  14                      inc d
    5947   00:5D60                          if USE_MEM_IO = 0
    5948   00:5D60  0E 06                   ld  c,IN_DATA_PORT
