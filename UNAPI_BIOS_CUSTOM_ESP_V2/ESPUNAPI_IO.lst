    2962   00:4FCD  D3 07             >     out (OUT_TX_PORT),a
    2963   00:4FCF  AF                      xor a
    2964   00:4FD0                          SEND_DATA                       ; Send the command size msb
    2964   00:4FD0  D3 07             >     out (OUT_TX_PORT),a
    2965   00:4FD2  3C                      inc a
    2966   00:4FD3                          SEND_DATA                       ; Send the command size lsb
    2966   00:4FD3  D3 07             >     out (OUT_TX_PORT),a
    2967   00:4FD5  78                      ld  a,b
    2968   00:4FD6                          SEND_DATA
