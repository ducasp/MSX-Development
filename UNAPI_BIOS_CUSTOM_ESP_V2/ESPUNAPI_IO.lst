    5487   00:5B1C  20 EF                   jr  nz,TCPIP_TCP_RCV_ST1
    5488   00:5B1E                          ; At this point, all data is being buffered, so 15 ticks, quarter second, is more than enough time-out
    5489   00:5B1E  F3                      di
    5490   00:5B1F  21 1E 00                ld  hl,30
    5491   00:5B22  CD EC 5E                call    SETCOUNTER
