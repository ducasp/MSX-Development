    4221   00:5559                      ;========================
    4222   00:5559                      ;===     SSH_OPEN     ===
    4223   00:5559                      ;========================
    4224   00:5559                      ;Open a SSH connection.
    4225   00:5559                      ;
    4226   00:5559                      ;Input:  A  = 2
    4227   00:5559                      ;        HL = Address of parameters block
    4228   00:5559                      ;Output: A = Error code
    4229   00:5559                      ;        B = Connection number
    4230   00:5559                      ;
    4231   00:5559                      ;Parameters block format:
    4232   00:5559                      ;
    4233   00:5559                      ;+0 (4): Remote IP address (0.0.0.0 for unspecified remote socket)
    4234   00:5559                      ;+4 (2): Remote port (ignored if unspecified remote socket)
    4235   00:5559                      ;+6 (1): Subsystem
    4236   00:5559                      ;+7 (1): Flags
    4237   00:5559                      ;+8 (variable): username (0 terminated) and then password or public key (0 terminated)
    4238   00:5559                      
    4239   00:5559                      SSH_OPEN:
    4240   00:5559  E5                      push    hl                      ; save param block address
    4241   00:555A  3E 08                   ld  a,8
    4242   00:555C  85                      add a,l
    4243   00:555D  6F                      ld  l,a
    4244   00:555E  30 01                   jr  nc,SSH_OPEN_1
    4245   00:5560  24                      inc h
    4246   00:5561                      SSH_OPEN_1:
    4247   00:5561                          ; let's check how many bytes there are
    4248   00:5561  11 08 00                ld  de,8                        ; Start with 8, all params except username and password
    4249   00:5564                      SSH_OPEN_CHECK_USER:
    4250   00:5564  7E                      ld  a,(hl)
    4251   00:5565  13                      inc de                          ; Increase size count
    4252   00:5566  23                      inc hl                          ; And next byte
    4253   00:5567  B7                      or  a                           ; If zero, user terminated
    4254   00:5568                          ; Loop until terminator (0) is found
    4255   00:5568  C2 64 55                jp  nz,SSH_OPEN_CHECK_USER
    4256   00:556B                      SSH_OPEN_CHECK_PASS:
    4257   00:556B  7E                      ld  a,(hl)
    4258   00:556C  13                      inc de                          ; Increase size count
    4259   00:556D  23                      inc hl                          ; And next byte
    4260   00:556E  B7                      or  a                           ; If zero, password terminated
    4261   00:556F                          ; Loop until terminator (0) is found
    4262   00:556F  C2 6B 55                jp  nz,SSH_OPEN_CHECK_PASS
    4263   00:5572                      
    4264   00:5572                      SSH_OPEN_SENDCMD:
    4265   00:5572                          ; Ok, so, DE has the full data size, let's start sending from here
    4266   00:5572  3E 82                   ld  a,#82                       ; Function SSH OPEN
    4267   00:5574                          SEND_DATA                       ; Send the command
    4267   00:5574  D3 07             >     out (OUT_TX_PORT),a
    4268   00:5576  7A                      ld  a,d
    4269   00:5577                          SEND_DATA                       ; Send the command size msb
    4269   00:5577  D3 07             >     out (OUT_TX_PORT),a
    4270   00:5579  7B                      ld  a,e
    4271   00:557A                          SEND_DATA                       ; Send the command size lsb
    4271   00:557A  D3 07             >     out (OUT_TX_PORT),a
    4272   00:557C  E1                      pop hl                          ; Restore the memory address for the parameters
    4273   00:557D                      ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    4274   00:557D  43                      ld  b,e                         ; Number of loops originaly in DE
    4275   00:557E  1B                      dec de
    4276   00:557F  14                      inc d
    4277   00:5580                          if USE_MEM_IO = 0
    4278   00:5580  0E 07                   ld  c,OUT_TX_PORT
    4279   00:5582                      SSH_OPEN_SENDDATA:
    4280   00:5582  ED A3                   outi
    4281   00:5584  20 FC                   jr  nz,SSH_OPEN_SENDDATA
    4282   00:5586                          else
    4283   00:5586                    ~ SSH_OPEN_SENDDATA:
    4284   00:5586                    ~     ld  a,(hl)
    4285   00:5586                    ~     ld  (MEM_OUT_TX_PORT),a
    4286   00:5586                    ~     inc hl
    4287   00:5586                    ~     djnz SSH_OPEN_SENDDATA
    4288   00:5586                    ~     endif
    4289   00:5586  15                      dec d
    4290   00:5587  20 F9                   jr  nz,SSH_OPEN_SENDDATA
    4291   00:5589                          ; Now wait up to 3600 (1 minute @ 60Hz) ticks to get response
    4292   00:5589  21 10 0E                ld  hl,3600
    4293   00:558C  CD C0 5C                call    SETCOUNTER
    4294   00:558F                      SSH_OPEN_ST1:
    4295   00:558F                          CHECK_DATA
    4295   00:558F  DB 07             >     in  a,(IN_STS_PORT)
    4295   00:5591  CB 47             >     bit 0,a
    4296   00:5593  20 05                   jr  nz,SSH_OPEN_ST1.1
    4297   00:5595  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4298   00:5598  18 F5                   jr  SSH_OPEN_ST1
    4299   00:559A                      SSH_OPEN_ST1.1:
    4300   00:559A                          ; nz, check the data
    4301   00:559A                          RECEIVE_DATA
    4301   00:559A  DB 06             >     in a,(IN_DATA_PORT)
    4302   00:559C  FE 82                   cp  #82                         ; Is response of our command?
    4303   00:559E  20 EF                   jr  nz,SSH_OPEN_ST1
    4304   00:55A0                          ; now get return code, if return code other than 0, it is finished
    4305   00:55A0                      SSH_OPEN_RC:
    4306   00:55A0                          CHECK_DATA
    4306   00:55A0  DB 07             >     in  a,(IN_STS_PORT)
    4306   00:55A2  CB 47             >     bit 0,a
    4307   00:55A4  20 05                   jr  nz,SSH_OPEN_RC.1
