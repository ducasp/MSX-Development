    5372   00:5AB6  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5373   00:5AB9  18 F5                   jr  TCPIP_TCP_STATE_ST1
    5374   00:5ABB                      TCPIP_TCP_STATE_ST1.1:
    5375   00:5ABB                          ; nz, check the data
    5376   00:5ABB                          RECEIVE_DATA
    5376   00:5ABB  DB 06             >     in a,(IN_DATA_PORT)
    5377   00:5ABD  FE 10                   cp  16                          ; Is response of our command?
    5378   00:5ABF  20 EF                   jr  nz,TCPIP_TCP_STATE_ST1
    5379   00:5AC1                          ; now get return code, if return code other than 0, it is finished
