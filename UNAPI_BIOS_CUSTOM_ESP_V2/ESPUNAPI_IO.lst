    2306   00:4CE6  CD A5 5D                call    GETESPTYPE
    2307   00:4CE9  20 05                   jr  nz,SSH_CHECK1
    2308   00:4CEB  CD 65 5E                call    CHECK_ESP_TYPE
    2309   00:4CEE  28 3D                   jr  z,JUMP_OLD2
    2310   00:4CF0                      SSH_CHECK1:
    2311   00:4CF0                          ; Check API ID SSH
    2312   00:4CF0  21 F8 6C                ld  hl,UNAPI_ID2
    2313   00:4CF3  11 47 F8                ld  de,ARG
    2314   00:4CF6                      LOOPSSH:
    2315   00:4CF6  1A                      ld  a,(de)
    2316   00:4CF7  CD 16 5E                call    TOUPPER
    2317   00:4CFA  BE                      cp  (hl)
    2318   00:4CFB  20 30                   jr  nz,JUMP_OLD2
    2319   00:4CFD  23                      inc hl
    2320   00:4CFE  13                      inc de
    2321   00:4CFF  B7                      or  a
    2322   00:4D00  20 F4                   jr  nz,LOOPSSH
    2323   00:4D02                      
    2324   00:4D02                          ; A=255: Jump to old hook
    2325   00:4D02                      
    2326   00:4D02  F1                      pop af
    2327   00:4D03  F5                      push    af
    2328   00:4D04  3C                      inc a
    2329   00:4D05  28 26                   jr  z,JUMP_OLD2
    2330   00:4D07                      
    2331   00:4D07                          ; A=0: B=B+1 and jump to old hook
    2332   00:4D07                      
    2333   00:4D07  CD 20 5C                call    GETSLT
    2334   00:4D0A  CD 79 5C                call    GETWRK
    2335   00:4D0D  F1                      pop af
    2336   00:4D0E  C1                      pop bc
    2337   00:4D0F  B7                      or  a
    2338   00:4D10  20 06                   jr  nz,DO_EXTBIO2SSH
    2339   00:4D12  04                      inc b
    2340   00:4D13  E3                      ex  (sp),hl
    2341   00:4D14  11 22 22                ld  de,#2222
    2342   00:4D17  C9                      ret
    2343   00:4D18                      
    2344   00:4D18                      DO_EXTBIO2SSH:
    2345   00:4D18                          ; A=1: Return A=Slot, B=Segment, HL=UNAPI entry address
    2346   00:4D18                      
    2347   00:4D18  3D                      dec a
    2348   00:4D19  20 0D                   jr  nz,DO_EXTBIO3SSH
    2349   00:4D1B  E1                      pop hl
    2350   00:4D1C  CD 40 5C                call    GETSLTT                 ; GETSLTT is GETSLT that checks if our memory area @ HIMEM has been allocated, if not, allocate it
    2351   00:4D1F  06 FF                   ld  b,#FF
    2352   00:4D21  21 99 4D                ld  hl,UNAPI2_ENTRY
    2353   00:4D24  11 22 22                ld  de,#2222
    2354   00:4D27  C9                      ret
    2355   00:4D28                      
    2356   00:4D28                          ; A>1: A=A-1, and jump to old hook
    2357   00:4D28                      
    2358   00:4D28                      DO_EXTBIO3SSH:                         ; A=A-1 already done
    2359   00:4D28  E3                      ex  (sp),hl
    2360   00:4D29  11 22 22                ld  de,#2222
    2361   00:4D2C  C9                      ret
    2362   00:4D2D                      
    2363   00:4D2D                      ; Jump here to execute old EXTBIO code
    2364   00:4D2D                      JUMP_OLD2:
    2365   00:4D2D  11 22 22                ld  de,#2222
    2366   00:4D30                      JUMP_OLD:                           ; Assumes "push hl,bc,af" done
    2367   00:4D30  D5                      push    de
    2368   00:4D31  CD 20 5C                call    GETSLT
    2369   00:4D34  CD 79 5C                call    GETWRK
    2370   00:4D37  D1                      pop de
    2371   00:4D38  F1                      pop af
    2372   00:4D39  C1                      pop bc
    2373   00:4D3A  E3                      ex  (sp),hl
    2374   00:4D3B  C9                      ret
    2375   00:4D3C                      
    2376   00:4D3C                      ;====================================
    2377   00:4D3C                      ;===  Functions entry point code  ===
    2378   00:4D3C                      ;===            TCP/IP            ===
    2379   00:4D3C                      ;====================================
    2380   00:4D3C                      UNAPI_ENTRY:
    2381   00:4D3C  FB                      ei
    2382   00:4D3D  E5                      push    hl
    2383   00:4D3E  F5                      push    af
    2384   00:4D3F  21 5D 4D                ld  hl,FN_TABLE
    2385   00:4D42  CB 7F                   bit 7,a
    2386   00:4D44  20 14                   jr  nz,UNDEFINED
    2387   00:4D46                      
    2388   00:4D46  FE 1D                   cp  MAX_FN
    2389   00:4D48  28 02                   jr  z,OK_FNUM
    2390   00:4D4A  30 0E                   jr  nc,UNDEFINED
    2391   00:4D4C                      
    2392   00:4D4C                      OK_FNUM:
    2393   00:4D4C  87                      add a,a
    2394   00:4D4D  D5                      push    de
    2395   00:4D4E  5F                      ld  e,a
    2396   00:4D4F  16 00                   ld  d,0
    2397   00:4D51  19                      add hl,de
    2398   00:4D52  D1                      pop de
    2399   00:4D53                      
    2400   00:4D53  7E                      ld  a,(hl)
    2401   00:4D54  23                      inc hl
    2402   00:4D55  66                      ld  h,(hl)
    2403   00:4D56  6F                      ld  l,a
    2404   00:4D57                      
    2405   00:4D57  F1                      pop af
    2406   00:4D58  E3                      ex  (sp),hl
    2407   00:4D59  C9                      ret
    2408   00:4D5A                      
    2409   00:4D5A                      ; Undefined function: return with registers unmodified
    2410   00:4D5A                      UNDEFINED:
    2411   00:4D5A  F1                      pop af
    2412   00:4D5B  E1                      pop hl
    2413   00:4D5C  C9                      ret
    2414   00:4D5D                      
    2415   00:4D5D                      ;===================================
    2416   00:4D5D                      ;===  Functions addresses table  ===
    2417   00:4D5D                      ;===            TCP/IP           ===
    2418   00:4D5D                      ;===================================
    2419   00:4D5D                      ;--- Implementation-specific routines addresses table
    2420   00:4D5D                      FN_TABLE:
    2421   00:4D5D  DE 4D               FN_0:                   dw  UNAPI_GET_INFO
    2422   00:4D5F  73 4E               FN_1:                   dw  TCPIP_GET_CAPAB
    2423   00:4D61  A3 4F               FN_2:                   dw  TCPIP_GET_IPINFO
    2424   00:4D63  20 50               FN_3:                   dw  TCPIP_NET_STATE
    2425   00:4D65                      ; TCPIP_SEND_ECHO not going to be implemented, ESP do not support ping like UNAPI specify
    2426   00:4D65  C9 4D               FN_4:                   dw  FN_NOT_IMP
    2427   00:4D67                      ; TCPIP_RCV_ECHO not going to be implemented as SEND_ECHO is not implemented
    2428   00:4D67  C9 4D               FN_5:                   dw  FN_NOT_IMP
    2429   00:4D69  6F 50               FN_6:                   dw  TCPIP_DNS_Q
    2430   00:4D6B  1E 51               FN_7:                   dw  TCPIP_DNS_S
    2431   00:4D6D  4B 51               FN_8:                   dw  TCPIP_UDP_OPEN
    2432   00:4D6F  A5 51               FN_9:                   dw  TCPIP_UDP_CLOSE
    2433   00:4D71  EB 51               FN_10:                  dw  TCPIP_UDP_STATE
    2434   00:4D73  76 52               FN_11:                  dw  TCPIP_UDP_SEND
    2435   00:4D75  15 53               FN_12:                  dw  TCPIP_UDP_RCV
    2436   00:4D77  3F 54               FN_13:                  dw  TCPIP_TCP_OPEN
    2437   00:4D79  13 55               FN_14:                  dw  TCPIP_TCP_CLOSE
    2438   00:4D7B  78 57               FN_15:                  dw  TCPIP_TCP_ABORT
    2439   00:4D7D  E1 57               FN_16:                  dw  TCPIP_TCP_STATE
    2440   00:4D7F  E6 58               FN_17:                  dw  TCPIP_TCP_SEND
    2441   00:4D81  D4 59               FN_18:                  dw  TCPIP_TCP_RCV
    2442   00:4D83                      ; TCPIP_TCP_FLUSH makes no sense as we do not use buffers to send, any buffer is internal to ESP and we can't delete
    2443   00:4D83  C9 4D               FN_19:                  dw  FN_NOT_IMP
    2444   00:4D85                      ; TCPIP_RAW_OPEN not going to be implemented, ESP do not support RAW connections
    2445   00:4D85  C9 4D               FN_20:                  dw  FN_NOT_IMP
    2446   00:4D87                      ; TCPIP_RAW_CLOSE not going to be implemented, ESP do not support RAW connections
    2447   00:4D87  C9 4D               FN_21:                  dw  FN_NOT_IMP
    2448   00:4D89                      ; TCPIP_RAW_STATE not going to be implemented, ESP do not support RAW connections
    2449   00:4D89  C9 4D               FN_22:                  dw  FN_NOT_IMP
    2450   00:4D8B                      ; TCPIP_RAW_SEND not going to be implemented, ESP do not support RAW connections
    2451   00:4D8B  C9 4D               FN_23:                  dw  FN_NOT_IMP
    2452   00:4D8D                      ; TCPIP_RAW_RCV not going to be implemented, ESP do not support RAW connections
    2453   00:4D8D  C9 4D               FN_24:                  dw  FN_NOT_IMP
    2454   00:4D8F  6A 5B               FN_25:                  dw  TCPIP_CONFIG_AUTOIP
    2455   00:4D91  C1 5B               FN_26:                  dw  TCPIP_CONFIG_IP
    2456   00:4D93  FE 5B               FN_27:                  dw  TCPIP_CONFIG_TTL
    2457   00:4D95  10 5C               FN_28:                  dw  TCPIP_CONFIG_PING
    2458   00:4D97                      ; TCPIP_WAIT not needed for our implementation
    2459   00:4D97  CC 4D               FN_29:                  dw  END_OK
    2460   00:4D99                      
    2461   00:4D99                      ;====================================
    2462   00:4D99                      ;===  Functions entry point code  ===
    2463   00:4D99                      ;===             SSH              ===
    2464   00:4D99                      ;====================================
    2465   00:4D99                      UNAPI2_ENTRY:
    2466   00:4D99  FB                      ei
    2467   00:4D9A  E5                      push    hl
    2468   00:4D9B  F5                      push    af
    2469   00:4D9C  21 B7 4D                ld  hl,FN_TABLE_S
    2470   00:4D9F  CB 7F                   bit 7,a
    2471   00:4DA1  20 B7                   jr  nz,UNDEFINED
    2472   00:4DA3                      
    2473   00:4DA3  FE 08                   cp  MAX_FN_S
    2474   00:4DA5  28 02                   jr  z,OK_FNUM_S
    2475   00:4DA7  30 B1                   jr  nc,UNDEFINED
    2476   00:4DA9                      
    2477   00:4DA9                      OK_FNUM_S:
    2478   00:4DA9  87                      add a,a
    2479   00:4DAA  D5                      push    de
    2480   00:4DAB  5F                      ld  e,a
    2481   00:4DAC  16 00                   ld  d,0
    2482   00:4DAE  19                      add hl,de
    2483   00:4DAF  D1                      pop de
    2484   00:4DB0                      
    2485   00:4DB0  7E                      ld  a,(hl)
    2486   00:4DB1  23                      inc hl
    2487   00:4DB2  66                      ld  h,(hl)
    2488   00:4DB3  6F                      ld  l,a
    2489   00:4DB4                      
    2490   00:4DB4  F1                      pop af
    2491   00:4DB5  E3                      ex  (sp),hl
    2492   00:4DB6  C9                      ret
    2493   00:4DB7                      
    2494   00:4DB7                      ;===================================
    2495   00:4DB7                      ;===  Functions addresses table  ===
    2496   00:4DB7                      ;===             SSH             ===
    2497   00:4DB7                      ;===================================
    2498   00:4DB7                      ;--- Implementation-specific routines addresses table
    2499   00:4DB7                      
    2500   00:4DB7                      FN_TABLE_S:
    2501   00:4DB7  E9 4D               FN_0_S:                 dw  UNAPI_GET_INFO_SSH
    2502   00:4DB9  F4 4D               FN_1_S:                 dw  SSH_GET_CAPAB
    2503   00:4DBB  59 55               FN_2_S:                 dw  SSH_OPEN
    2504   00:4DBD  D1 55               FN_3_S:                 dw  SSH_CLOSE
    2505   00:4DBF  19 56               FN_4_S:                 dw  SSH_STATE
    2506   00:4DC1  42 59               FN_5_S:                 dw  SSH_SEND
    2507   00:4DC3  B6 5A               FN_6_S:                 dw  SSH_RCV
    2508   00:4DC5  8B 56               FN_7_S:                 dw  SSH_TERM_TYPE
    2509   00:4DC7  F9 56               FN_8_S:                 dw  SSH_WIN_SIZE
    2510   00:4DC9                      
    2511   00:4DC9                      ;========================
    2512   00:4DC9                      ;===  Functions code  ===
    2513   00:4DC9                      ;========================
    2514   00:4DC9                      FN_NOT_IMP:
    2515   00:4DC9  3E 01                   ld  a,ERR_NOT_IMP
    2516   00:4DCB  C9                      ret
    2517   00:4DCC                      
    2518   00:4DCC                      END_OK:
    2519   00:4DCC  AF                      xor a
    2520   00:4DCD  C9                      ret
    2521   00:4DCE                      
    2522   00:4DCE                      ; Most functions do not have special handling on time out and can use this.
    2523   00:4DCE                      ; If there is a need to retry sending or receiving on time-out, then a custom
    2524   00:4DCE                      ; time-out function must be done, check the examples of UDP and TCP receive
    2525   00:4DCE                      TCPIP_GENERIC_CHECK_TIME_OUT:
    2526   00:4DCE                          ; Save registers other than AF
    2527   00:4DCE  C5                      push bc
    2528   00:4DCF  D5                      push de
    2529   00:4DD0  E5                      push hl
    2530   00:4DD1  CD B1 5C                call    GETCOUNTER
    2531   00:4DD4  7D                      ld  a,l
    2532   00:4DD5  B4                      or  h
    2533   00:4DD6                          ; Restore registers, we are returning
    2534   00:4DD6  E1                      pop hl
    2535   00:4DD7  D1                      pop de
    2536   00:4DD8  C1                      pop bc
    2537   00:4DD9  C0                      ret nz
    2538   00:4DDA                          ; Ok, timeout...
    2539   00:4DDA  F1                      pop af                          ; Get return address of who called this out of the stack
    2540   00:4DDB  3E 0F                   ld  a,ERR_INV_OPER
    2541   00:4DDD  C9                      ret                             ; and return the function itself
    2542   00:4DDE                      
    2543   00:4DDE                      ;========================
    2544   00:4DDE                      ;===  UNAPI_GET_INFO  ===
    2545   00:4DDE                      ;========================
    2546   00:4DDE                      ; Obtain the implementation name and version for TCP/IP.
    2547   00:4DDE                      ;
    2548   00:4DDE                      ;    Input:  A  = 0
    2549   00:4DDE                      ;    Output: HL = Descriptive string for this implementation, on this slot, zero terminated
    2550   00:4DDE                      ;            DE = API version supported, D.E
    2551   00:4DDE                      ;            BC = This implementation version, B.C.
    2552   00:4DDE                      ;            A  = 0 and Cy = 0
    2553   00:4DDE                      UNAPI_GET_INFO:
    2554   00:4DDE  01 03 01                ld  bc,256*ROM_V_P+ROM_V_S
    2555   00:4DE1  11 02 01                ld  de,256*API_V_P+API_V_S
    2556   00:4DE4  21 FC 6C                ld  hl,APIINFO
    2557   00:4DE7  AF                      xor a
    2558   00:4DE8  C9                      ret
    2559   00:4DE9                      
    2560   00:4DE9                      ;========================
    2561   00:4DE9                      ;===  UNAPI_GET_INFO  ===
    2562   00:4DE9                      ;========================
    2563   00:4DE9                      ; Obtain the implementation name and version for SSH.
    2564   00:4DE9                      ;
    2565   00:4DE9                      ;    Input:  A  = 0
    2566   00:4DE9                      ;    Output: HL = Descriptive string for this implementation, on this slot, zero terminated
    2567   00:4DE9                      ;            DE = API version supported, D.E
    2568   00:4DE9                      ;            BC = This implementation version, B.C.
    2569   00:4DE9                      ;            A  = 0 and Cy = 0
    2570   00:4DE9                      UNAPI_GET_INFO_SSH:
    2571   00:4DE9  01 03 01                ld  bc,256*ROM_V_P+ROM_V_S
    2572   00:4DEC  11 02 01                ld  de,256*API_V_P+API_V_S
    2573   00:4DEF  21 0D 6D                ld  hl,APIINFO_SSH
    2574   00:4DF2  AF                      xor a
    2575   00:4DF3  C9                      ret
    2576   00:4DF4                      
    2577   00:4DF4                      ;=========================
    2578   00:4DF4                      ;===   SSH_GET_CAPAB   ===
    2579   00:4DF4                      ;=========================
    2580   00:4DF4                      ; Get information about the SSH capabilities and features.
    2581   00:4DF4                      ;
    2582   00:4DF4                      ;    Input:  A = 1
    2583   00:4DF4                      ;            B = Index of information block to retrieve:
    2584   00:4DF4                      ;                1: Block 1 (only block supported, other blocks reserved for expansion)
    2585   00:4DF4                      ;    Output: A = Error code
    2586   00:4DF4                      ;        When information block 1 requested:
    2587   00:4DF4                      ;            HL = Capabilities flags
    2588   00:4DF4                      ;            B  = Maximum simultaneous SSH connections supported
    2589   00:4DF4                      ;            C  = Free SSH connections currently available
    2590   00:4DF4                      SSH_GET_CAPAB:
    2591   00:4DF4                          ; SSH functions start at 127 on ESP
    2592   00:4DF4  CB FF                   set 7,a
    2593   00:4DF6                          SEND_DATA                       ; Send the command
    2593   00:4DF6  D3 07             >     out (OUT_TX_PORT),a
    2594   00:4DF8  AF                      xor a
    2595   00:4DF9                          SEND_DATA                       ; Send the command size msb
    2595   00:4DF9  D3 07             >     out (OUT_TX_PORT),a
    2596   00:4DFB  3C                      inc a
    2597   00:4DFC                          SEND_DATA                       ; Send the command size lsb
    2597   00:4DFC  D3 07             >     out (OUT_TX_PORT),a
    2598   00:4DFE  78                      ld  a,b
    2599   00:4DFF                          SEND_DATA                       ; Send the parameter
    2599   00:4DFF  D3 07             >     out (OUT_TX_PORT),a
    2600   00:4E01                      
    2601   00:4E01                          ; Now wait up to 120 ticks to get response
    2602   00:4E01  21 78 00                ld  hl,120
    2603   00:4E04  CD C0 5C                call    SETCOUNTER
    2604   00:4E07                      SSH_GET_CAPAB_ST1:
    2605   00:4E07                          CHECK_DATA
    2605   00:4E07  DB 07             >     in  a,(IN_STS_PORT)
    2605   00:4E09  CB 47             >     bit 0,a
    2606   00:4E0B  20 05                   jr  nz,SSH_GET_CAPAB_ST1.1
    2607   00:4E0D  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2608   00:4E10  18 F5                   jr  SSH_GET_CAPAB_ST1
    2609   00:4E12                      SSH_GET_CAPAB_ST1.1:
    2610   00:4E12                          ; nz, check the data
    2611   00:4E12                          RECEIVE_DATA
    2611   00:4E12  DB 06             >     in a,(IN_DATA_PORT)
    2612   00:4E14  FE 81                   cp  #81                         ; Is response of our command?
    2613   00:4E16  20 EF                   jr  nz,SSH_GET_CAPAB_ST1
    2614   00:4E18                          ; Now get return code, if return code other than 0, it is finished
    2615   00:4E18                      SSH_GET_CAPAB_RC:
    2616   00:4E18                          CHECK_DATA
    2616   00:4E18  DB 07             >     in  a,(IN_STS_PORT)
    2616   00:4E1A  CB 47             >     bit 0,a
    2617   00:4E1C  20 05                   jr  nz,SSH_GET_CAPAB_RC.1
    2618   00:4E1E  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2619   00:4E21  18 F5                   jr  SSH_GET_CAPAB_RC
    2620   00:4E23                      SSH_GET_CAPAB_RC.1:
    2621   00:4E23                          ; nz, discard
    2622   00:4E23                          RECEIVE_DATA
    2622   00:4E23  DB 06             >     in a,(IN_DATA_PORT)
    2623   00:4E25  B7                      or  a                           ; 0?
    2624   00:4E26  C0                      ret nz                          ; If not, done
    2625   00:4E27                      
    2626   00:4E27                          ; Next two bytes are size bytes, don't care
    2627   00:4E27  06 02                   ld  b,2
    2628   00:4E29                      SSH_GET_CAPAB_ST2:
    2629   00:4E29                          CHECK_DATA
    2629   00:4E29  DB 07             >     in  a,(IN_STS_PORT)
    2629   00:4E2B  CB 47             >     bit 0,a
    2630   00:4E2D  20 05                   jr  nz,SSH_GET_CAPAB_ST2.1
    2631   00:4E2F  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2632   00:4E32  18 F5                   jr  SSH_GET_CAPAB_ST2
    2633   00:4E34                      SSH_GET_CAPAB_ST2.1:
    2634   00:4E34                          ; Nz, discard
    2635   00:4E34                          RECEIVE_DATA
    2635   00:4E34  DB 06             >     in a,(IN_DATA_PORT)
    2636   00:4E36  05                      dec b
    2637   00:4E37  20 F0                   jr  nz,SSH_GET_CAPAB_ST2
    2638   00:4E39                      
    2639   00:4E39                      SSH_GET_CAPAB_BLK1_ST1:
    2640   00:4E39                          CHECK_DATA
    2640   00:4E39  DB 07             >     in  a,(IN_STS_PORT)
    2640   00:4E3B  CB 47             >     bit 0,a
    2641   00:4E3D  20 05                   jr  nz,SSH_GET_CAPAB_BLK1_ST1.1
    2642   00:4E3F  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2643   00:4E42  18 F5                   jr  SSH_GET_CAPAB_BLK1_ST1
    2644   00:4E44                      SSH_GET_CAPAB_BLK1_ST1.1:
    2645   00:4E44                          ; nz, get it
    2646   00:4E44                          RECEIVE_DATA
    2646   00:4E44  DB 06             >     in a,(IN_DATA_PORT)
    2647   00:4E46  6F                      ld  l,a
    2648   00:4E47                      SSH_GET_CAPAB_BLK1_ST2:
    2649   00:4E47                          CHECK_DATA
    2649   00:4E47  DB 07             >     in  a,(IN_STS_PORT)
    2649   00:4E49  CB 47             >     bit 0,a
    2650   00:4E4B  20 05                   jr  nz,SSH_GET_CAPAB_BLK1_ST2.1
    2651   00:4E4D  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2652   00:4E50  18 F5                   jr  SSH_GET_CAPAB_BLK1_ST2
    2653   00:4E52                      SSH_GET_CAPAB_BLK1_ST2.1:
    2654   00:4E52                          ; nz, get it
    2655   00:4E52                          RECEIVE_DATA
    2655   00:4E52  DB 06             >     in a,(IN_DATA_PORT)
    2656   00:4E54  67                      ld  h,a
    2657   00:4E55                      SSH_GET_CAPAB_BLK1_ST3:
