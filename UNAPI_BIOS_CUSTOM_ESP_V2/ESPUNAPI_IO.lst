    6704   00:5FEF                      ; Pattern-09 is CHR$(1)+CHR$(89) = Right Middle Wave
    6705   00:5FEF  00                      db  %00000000
    6706   00:5FF0  20                      db  %00100000
    6707   00:5FF1  10                      db  %00010000
