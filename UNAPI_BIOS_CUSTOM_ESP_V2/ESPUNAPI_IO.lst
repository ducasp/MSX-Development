    4331   00:55C1                          CHECK_DATA
    4331   00:55C1  DB 07             >     in  a,(IN_STS_PORT)
    4331   00:55C3  CB 47             >     bit 0,a
    4332   00:55C5  20 05                   jr  nz,SSH_OPEN_CONN_ST1.1
    4333   00:55C7  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4334   00:55CA  18 F5                   jr  SSH_OPEN_CONN_ST1
    4335   00:55CC                      SSH_OPEN_CONN_ST1.1:
