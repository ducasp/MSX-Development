    3521   00:5242  DB 06             >     in a,(IN_DATA_PORT)
    3522   00:5244  B7                      or  a                           ; 0?
    3523   00:5245  C0                      ret nz                          ; if not, done
    3524   00:5246                      
    3525   00:5246                          ; next two bytes are return code and size bytes, don't care, it is 5
    3526   00:5246  06 02                   ld  b,2
    3527   00:5248                      TCPIP_UDP_STATE_ST2:
    3528   00:5248                          CHECK_DATA
    3528   00:5248  DB 07             >     in  a,(IN_STS_PORT)
    3528   00:524A  CB 47             >     bit 0,a
    3529   00:524C  20 05                   jr  nz,TCPIP_UDP_STATE_ST2.1
    3530   00:524E  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3531   00:5251  18 F5                   jr  TCPIP_UDP_STATE_ST2
    3532   00:5253                      TCPIP_UDP_STATE_ST2.1:
    3533   00:5253                          ; nz, discard
    3534   00:5253                          RECEIVE_DATA
    3534   00:5253  DB 06             >     in a,(IN_DATA_PORT)
    3535   00:5255  05                      dec b
    3536   00:5256  20 F0                   jr  nz,TCPIP_UDP_STATE_ST2
    3537   00:5258                      
    3538   00:5258                          ; now just get the 5 bytes (Port LSB then MSB, # of packets, packet size LSB then MSB) and order it in L, H, B, E and D
    3539   00:5258                      TCPIP_UDP_STATE_RESP_ST1:
    3540   00:5258                          CHECK_DATA
    3540   00:5258  DB 07             >     in  a,(IN_STS_PORT)
    3540   00:525A  CB 47             >     bit 0,a
    3541   00:525C  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST1.1
    3542   00:525E  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3543   00:5261  18 F5                   jr  TCPIP_UDP_STATE_RESP_ST1
    3544   00:5263                      TCPIP_UDP_STATE_RESP_ST1.1:
    3545   00:5263                          ; nz, get it
    3546   00:5263                          RECEIVE_DATA
    3546   00:5263  DB 06             >     in a,(IN_DATA_PORT)
    3547   00:5265  6F                      ld  l,a
    3548   00:5266                      TCPIP_UDP_STATE_RESP_ST2:
    3549   00:5266                          CHECK_DATA
    3549   00:5266  DB 07             >     in  a,(IN_STS_PORT)
    3549   00:5268  CB 47             >     bit 0,a
    3550   00:526A  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST2.1
    3551   00:526C  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3552   00:526F  18 F5                   jr  TCPIP_UDP_STATE_RESP_ST2
    3553   00:5271                      TCPIP_UDP_STATE_RESP_ST2.1:
    3554   00:5271                          ; nz, get it
    3555   00:5271                          RECEIVE_DATA
    3555   00:5271  DB 06             >     in a,(IN_DATA_PORT)
    3556   00:5273  67                      ld  h,a
    3557   00:5274                      TCPIP_UDP_STATE_RESP_ST3:
    3558   00:5274                          CHECK_DATA
    3558   00:5274  DB 07             >     in  a,(IN_STS_PORT)
    3558   00:5276  CB 47             >     bit 0,a
    3559   00:5278  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST3.1
    3560   00:527A  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3561   00:527D  18 F5                   jr  TCPIP_UDP_STATE_RESP_ST3
    3562   00:527F                      TCPIP_UDP_STATE_RESP_ST3.1:
    3563   00:527F                          ; nz, get it
    3564   00:527F                          RECEIVE_DATA
    3564   00:527F  DB 06             >     in a,(IN_DATA_PORT)
    3565   00:5281  47                      ld  b,a
    3566   00:5282                      TCPIP_UDP_STATE_RESP_ST4:
    3567   00:5282                          CHECK_DATA
    3567   00:5282  DB 07             >     in  a,(IN_STS_PORT)
    3567   00:5284  CB 47             >     bit 0,a
    3568   00:5286  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST4.1
    3569   00:5288  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3570   00:528B  18 F5                   jr  TCPIP_UDP_STATE_RESP_ST4
    3571   00:528D                      TCPIP_UDP_STATE_RESP_ST4.1:
    3572   00:528D                          ; nz, get it
    3573   00:528D                          RECEIVE_DATA
    3573   00:528D  DB 06             >     in a,(IN_DATA_PORT)
    3574   00:528F  5F                      ld  e,a
    3575   00:5290                      TCPIP_UDP_STATE_RESP_ST5:
    3576   00:5290                          CHECK_DATA
    3576   00:5290  DB 07             >     in  a,(IN_STS_PORT)
    3576   00:5292  CB 47             >     bit 0,a
    3577   00:5294  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST5.1
    3578   00:5296  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3579   00:5299  18 F5                   jr  TCPIP_UDP_STATE_RESP_ST5
    3580   00:529B                      TCPIP_UDP_STATE_RESP_ST5.1:
    3581   00:529B                          ; nz, get it
    3582   00:529B                          RECEIVE_DATA
    3582   00:529B  DB 06             >     in a,(IN_DATA_PORT)
    3583   00:529D  57                      ld  d,a
    3584   00:529E                          ; done
    3585   00:529E  AF                      xor a
    3586   00:529F  C9                      ret
    3587   00:52A0                      
    3588   00:52A0                      ;========================
    3589   00:52A0                      ;===  TCPIP_UDP_SEND  ===
    3590   00:52A0                      ;========================
    3591   00:52A0                      ;Send an UDP datagram.
    3592   00:52A0                      ;
    3593   00:52A0                      ;Input:  A = 11
    3594   00:52A0                      ;        B = Connection number
    3595   00:52A0                      ;        HL = Address of datagram data
    3596   00:52A0                      ;        DE = Address of parameters block
    3597   00:52A0                      ;Output: A = Error code
    3598   00:52A0                      ;
    3599   00:52A0                      ;Parameters block:
    3600   00:52A0                      ;
    3601   00:52A0                      ;    +0 (4): Destination IP address
    3602   00:52A0                      ;    +4 (2): Destination port
    3603   00:52A0                      ;    +6 (2): Data length
    3604   00:52A0                      TCPIP_UDP_SEND:
    3605   00:52A0  E5                      push    hl
    3606   00:52A1  D5                      push    de
    3607   00:52A2                          SEND_DATA                       ; Send the command
    3607   00:52A2  D3 07             >     out (OUT_TX_PORT),a
    3608   00:52A4                          ; prepare new data size, adding our 7 bytes overhead
    3609   00:52A4  DD 62                   ld  ixh,d
    3610   00:52A6  DD 6B                   ld  ixl,e
    3611   00:52A8  11 07 00                ld  de,7
    3612   00:52AB  DD 6E 06                ld  l,(ix+6)
    3613   00:52AE  DD 66 07                ld  h,(ix+7)
    3614   00:52B1  19                      add hl,de
    3615   00:52B2  7C                      ld  a,h
    3616   00:52B3                          SEND_DATA                       ; Send the command size msb
    3616   00:52B3  D3 07             >     out (OUT_TX_PORT),a
    3617   00:52B5  7D                      ld  a,l
    3618   00:52B6                          SEND_DATA                       ; Send the command size lsb
    3618   00:52B6  D3 07             >     out (OUT_TX_PORT),a
    3619   00:52B8  78                      ld  a,b
    3620   00:52B9                          SEND_DATA                       ; Send the connection #
    3620   00:52B9  D3 07             >     out (OUT_TX_PORT),a
    3621   00:52BB  D1                      pop de
    3622   00:52BC  E1                      pop hl
    3623   00:52BD  1A                      ld  a,(de)
    3624   00:52BE                          SEND_DATA                       ; Send IP byte 1
    3624   00:52BE  D3 07             >     out (OUT_TX_PORT),a
    3625   00:52C0  13                      inc de
    3626   00:52C1  1A                      ld  a,(de)
    3627   00:52C2                          SEND_DATA                       ; Send IP byte 2
    3627   00:52C2  D3 07             >     out (OUT_TX_PORT),a
    3628   00:52C4  13                      inc de
    3629   00:52C5  1A                      ld  a,(de)
    3630   00:52C6                          SEND_DATA                       ; Send IP byte 3
    3630   00:52C6  D3 07             >     out (OUT_TX_PORT),a
    3631   00:52C8  13                      inc de
    3632   00:52C9  1A                      ld  a,(de)
    3633   00:52CA                          SEND_DATA                       ; Send IP byte 4
    3633   00:52CA  D3 07             >     out (OUT_TX_PORT),a
    3634   00:52CC  13                      inc de
    3635   00:52CD  1A                      ld  a,(de)
    3636   00:52CE                          SEND_DATA                       ; Send Port LSB
    3636   00:52CE  D3 07             >     out (OUT_TX_PORT),a
    3637   00:52D0  13                      inc de
    3638   00:52D1  1A                      ld  a,(de)
    3639   00:52D2                          SEND_DATA                       ; Send Port MSB
    3639   00:52D2  D3 07             >     out (OUT_TX_PORT),a
    3640   00:52D4                          ; now oti the data starting at hl, size is in next DE position
    3641   00:52D4  13                      inc de
    3642   00:52D5  1A                      ld  a,(de)
    3643   00:52D6  47                      ld  b,a                         ; save lsb in b
    3644   00:52D7  13                      inc de
    3645   00:52D8  1A                      ld  a,(de)                      ; msb
    3646   00:52D9  57                      ld  d,a                         ; put in D, there is no ld d,(de)
    3647   00:52DA  58                      ld  e,b                         ; lsb
    3648   00:52DB                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    3649   00:52DB                          ;ld b,e                         ; Number of loops originaly in DE, not needed, b already has e
    3650   00:52DB  1B                      dec de
    3651   00:52DC  14                      inc d
    3652   00:52DD                          if USE_MEM_IO = 0
    3653   00:52DD  0E 07                   ld  c,OUT_TX_PORT
    3654   00:52DF                      TCPIP_UDP_SEND_R:
    3655   00:52DF  ED B3                   otir                            ; Send until B is 0
    3656   00:52E1                          else
    3657   00:52E1                    ~ TCPIP_UDP_SEND_R:
    3658   00:52E1                    ~     ld  a,(hl)
    3659   00:52E1                    ~     ld  (MEM_OUT_TX_PORT),a
    3660   00:52E1                    ~     inc hl
    3661   00:52E1                    ~     djnz TCPIP_UDP_SEND_R
    3662   00:52E1                    ~     endif
    3663   00:52E1  15                      dec d                           ; decrement secondary counter
    3664   00:52E2  20 FB                   jr  nz,TCPIP_UDP_SEND_R         ; If still have another round, do it
    3665   00:52E4                          ; Now wait up to 600 ticks to get response
    3666   00:52E4  21 58 02                ld  hl,600
    3667   00:52E7  CD DF 60                call    SETCOUNTER
    3668   00:52EA                      TCPIP_UDP_SEND_ST1:
    3669   00:52EA                          CHECK_DATA
    3669   00:52EA  DB 07             >     in  a,(IN_STS_PORT)
    3669   00:52EC  CB 47             >     bit 0,a
    3670   00:52EE  20 05                   jr  nz,TCPIP_UDP_SEND_ST1.1
    3671   00:52F0  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3672   00:52F3  18 F5                   jr  TCPIP_UDP_SEND_ST1
    3673   00:52F5                      TCPIP_UDP_SEND_ST1.1:
    3674   00:52F5                          ; nz, check the data
    3675   00:52F5                          RECEIVE_DATA
    3675   00:52F5  DB 06             >     in a,(IN_DATA_PORT)
    3676   00:52F7  FE 0B                   cp  11                          ; Is response of our command?
    3677   00:52F9  20 EF                   jr  nz,TCPIP_UDP_SEND_ST1
    3678   00:52FB                          ; now get return code, if return code other than 0, it is finished
    3679   00:52FB                      TCPIP_UDP_SEND_RC:
    3680   00:52FB                          CHECK_DATA
    3680   00:52FB  DB 07             >     in  a,(IN_STS_PORT)
    3680   00:52FD  CB 47             >     bit 0,a
    3681   00:52FF  20 05                   jr  nz,TCPIP_UDP_SEND_RC.1
    3682   00:5301  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3683   00:5304  18 F5                   jr  TCPIP_UDP_SEND_RC
    3684   00:5306                      TCPIP_UDP_SEND_RC.1:
    3685   00:5306                          ; nz, discard
    3686   00:5306                          RECEIVE_DATA
    3686   00:5306  DB 06             >     in a,(IN_DATA_PORT)
    3687   00:5308  B7                      or  a                           ; 0?
    3688   00:5309  C0                      ret nz                          ; if not, done
    3689   00:530A                      
    3690   00:530A                          ; next two bytes are return code and size bytes, don't care, it is 0
    3691   00:530A  06 02                   ld  b,2
    3692   00:530C                      TCPIP_UDP_SEND_ST2:
    3693   00:530C                          CHECK_DATA
    3693   00:530C  DB 07             >     in  a,(IN_STS_PORT)
    3693   00:530E  CB 47             >     bit 0,a
    3694   00:5310  20 05                   jr  nz,TCPIP_UDP_SEND_ST2.1
    3695   00:5312  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3696   00:5315  18 F5                   jr  TCPIP_UDP_SEND_ST2
    3697   00:5317                      TCPIP_UDP_SEND_ST2.1:
    3698   00:5317                          ; nz, discard
    3699   00:5317                          RECEIVE_DATA
    3699   00:5317  DB 06             >     in a,(IN_DATA_PORT)
    3700   00:5319  05                      dec b
    3701   00:531A  20 F0                   jr  nz,TCPIP_UDP_SEND_ST2
    3702   00:531C                      
    3703   00:531C                          ; done, no return data other than return code
    3704   00:531C  AF                      xor a
    3705   00:531D  C9                      ret
    3706   00:531E                      
    3707   00:531E                      ;=======================
    3708   00:531E                      ;===  TCPIP_UDP_RCV  ===
    3709   00:531E                      ;=======================
    3710   00:531E                      ;Retrieve an incoming UDP datagram.
    3711   00:531E                      ;
    3712   00:531E                      ;Input:  A = 12
    3713   00:531E                      ;        B = Connection number
    3714   00:531E                      ;        HL = Address for datagram data
    3715   00:531E                      ;        DE = Maximum data size to retrieve
    3716   00:531E                      ;Output: A = Error code
    3717   00:531E                      ;        L.H.E.D = Source IP address
    3718   00:531E                      ;        IX = Source port
    3719   00:531E                      ;        BC = Actual received data size
    3720   00:531E                      
    3721   00:531E                      ; Customized TIME OUT routine: If time out receiving data, retry as received data
    3722   00:531E                      ; won't be re-sent as host is unaware of this
    3723   00:531E                      TCPIP_UDP_RCV_CHECK_TIME_OUT:
    3724   00:531E                          ; Save registers other than AF
    3725   00:531E  C5                      push bc
    3726   00:531F  D5                      push de
    3727   00:5320  E5                      push hl
    3728   00:5321  CD D0 60                call    GETCOUNTER
    3729   00:5324  7D                      ld  a,l
    3730   00:5325  B4                      or  h
    3731   00:5326                          ; Restore registers, we are returning
    3732   00:5326  E1                      pop hl
    3733   00:5327  D1                      pop de
    3734   00:5328  C1                      pop bc
    3735   00:5329  C0                      ret nz
    3736   00:532A                          ; Ok, timeout...
    3737   00:532A  F1                      pop af                          ; Get return address of who called this out of the stack, we will return from the function or re-start
    3738   00:532B                      TCPIP_TCP_UDP_RETRY_QRCV:
    3739   00:532B  CD EF 60                call    GETBYTE
    3740   00:532E  B7                      or  a
    3741   00:532F  28 0B                   jr  z,TCPIP_UDP_RCV_CHECK_TIME_OUT.NORXRETRY
    3742   00:5331                          ; Ok, so let's ask ESP to re-send the data and retry receiving it
    3743   00:5331  3D                      dec a
    3744   00:5332  CD 01 61                call    SETBYTE                 ; we are retrying it
    3745   00:5335  3E 72                   ld  a,'r'                       ; retry transmission command
    3746   00:5337                          SEND_DATA
    3746   00:5337  D3 07             >     out (OUT_TX_PORT),a
    3747   00:5339  C3 5B 53                jp  TCPIP_UDP_RCV.RXRETRY       ; and retry it
    3748   00:533C                      TCPIP_UDP_RCV_CHECK_TIME_OUT.NORXRETRY:
    3749   00:533C  3E 0F                   ld  a,ERR_INV_OPER
    3750   00:533E  C9                      ret                             ; and return the function itself
    3751   00:533F                      
    3752   00:533F                      TCPIP_UDP_RCV:
    3753   00:533F  CD 28 61                call    SETWORD                 ; Save for later the datagram address
    3754   00:5342  3E 0C                   ld  a,12
    3755   00:5344                          SEND_DATA                       ; Send the command
    3755   00:5344  D3 07             >     out (OUT_TX_PORT),a
    3756   00:5346  AF                      xor a
    3757   00:5347                          SEND_DATA                       ; Send the command size msb
    3757   00:5347  D3 07             >     out (OUT_TX_PORT),a
    3758   00:5349  3E 03                   ld  a,3
    3759   00:534B                          SEND_DATA                       ; Send the command size lsb
    3759   00:534B  D3 07             >     out (OUT_TX_PORT),a
    3760   00:534D  78                      ld  a,b
    3761   00:534E                          SEND_DATA                       ; Send the connection #
    3761   00:534E  D3 07             >     out (OUT_TX_PORT),a
    3762   00:5350  7B                      ld  a,e
    3763   00:5351                          SEND_DATA                       ; Send MAX rcv size LSB
    3763   00:5351  D3 07             >     out (OUT_TX_PORT),a
    3764   00:5353  7A                      ld  a,d
    3765   00:5354                          SEND_DATA                       ; Send MAX rcv size MSB
    3765   00:5354  D3 07             >     out (OUT_TX_PORT),a
    3766   00:5356  3E 03                   ld  a,3
    3767   00:5358  CD 01 61                call    SETBYTE                 ; Ok, retry up to three times
    3768   00:535B                      TCPIP_UDP_RCV.RXRETRY:
    3769   00:535B                          ; Now wait up to 600 ticks to get response
    3770   00:535B  21 58 02                ld  hl,600
    3771   00:535E  CD DF 60                call    SETCOUNTER
    3772   00:5361                      TCPIP_UDP_RCV_ST1:
    3773   00:5361                          CHECK_DATA
    3773   00:5361  DB 07             >     in  a,(IN_STS_PORT)
    3773   00:5363  CB 47             >     bit 0,a
    3774   00:5365  20 05                   jr  nz,TCPIP_UDP_RCV_ST1.1
    3775   00:5367  CD 1E 53                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3776   00:536A  18 F5                   jr  TCPIP_UDP_RCV_ST1
    3777   00:536C                      TCPIP_UDP_RCV_ST1.1:
    3778   00:536C                          ; nz, check the data
    3779   00:536C                          RECEIVE_DATA
    3779   00:536C  DB 06             >     in a,(IN_DATA_PORT)
    3780   00:536E  FE 0C                   cp  12                          ; Is response of our command?
    3781   00:5370  20 EF                   jr  nz,TCPIP_UDP_RCV_ST1
    3782   00:5372                          ; At this point, all data is being buffered, so 30 ticks, half second, is more than enough time-out
    3783   00:5372  F3                      di
    3784   00:5373  21 1E 00                ld  hl,30
    3785   00:5376  CD DF 60                call    SETCOUNTER
    3786   00:5379  FB                      ei
    3787   00:537A                          ; now get return code, if return code other than 0, it is finished
    3788   00:537A                      TCPIP_UDP_RCV_RC:
    3789   00:537A                          CHECK_DATA
    3789   00:537A  DB 07             >     in  a,(IN_STS_PORT)
    3789   00:537C  CB 47             >     bit 0,a
    3790   00:537E  20 05                   jr  nz,TCPIP_UDP_RCV_RC.1
    3791   00:5380  CD 1E 53                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3792   00:5383  18 F5                   jr  TCPIP_UDP_RCV_RC
    3793   00:5385                      TCPIP_UDP_RCV_RC.1:
    3794   00:5385                          ; nz, discard
    3795   00:5385                          RECEIVE_DATA
    3795   00:5385  DB 06             >     in a,(IN_DATA_PORT)
    3796   00:5387  B7                      or  a                           ; 0?
    3797   00:5388  C0                      ret nz                          ; if not, done
    3798   00:5389                          ; next two bytes are return code and size bytes, save it to BC
    3799   00:5389                      TCPIP_UDP_RCV_ST2A:
    3800   00:5389                          CHECK_DATA
    3800   00:5389  DB 07             >     in  a,(IN_STS_PORT)
    3800   00:538B  CB 47             >     bit 0,a
    3801   00:538D  20 05                   jr  nz,TCPIP_UDP_RCV_ST2A.1
    3802   00:538F  CD 1E 53                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3803   00:5392  18 F5                   jr  TCPIP_UDP_RCV_ST2A
    3804   00:5394                      TCPIP_UDP_RCV_ST2A.1:
    3805   00:5394                          ; nz, discard
    3806   00:5394                          RECEIVE_DATA
    3806   00:5394  DB 06             >     in a,(IN_DATA_PORT)
    3807   00:5396  67                      ld  h,a
    3808   00:5397                      TCPIP_UDP_RCV_ST2B:
    3809   00:5397                          CHECK_DATA
    3809   00:5397  DB 07             >     in  a,(IN_STS_PORT)
    3809   00:5399  CB 47             >     bit 0,a
    3810   00:539B  20 05                   jr  nz,TCPIP_UDP_RCV_ST2B.1
    3811   00:539D  CD 1E 53                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3812   00:53A0  18 F5                   jr  TCPIP_UDP_RCV_ST2B
    3813   00:53A2                      TCPIP_UDP_RCV_ST2B.1:
    3814   00:53A2                          ; nz, discard
    3815   00:53A2                          RECEIVE_DATA
    3815   00:53A2  DB 06             >     in a,(IN_DATA_PORT)
    3816   00:53A4  6F                      ld  l,a
    3817   00:53A5  01 06 00                ld  bc,6
    3818   00:53A8                          ; subtract 6 (IP and PORT)
    3819   00:53A8  AF                      xor a                           ; zero carry
    3820   00:53A9  ED 42                   sbc hl,bc
    3821   00:53AB  4D                      ld  c,l
    3822   00:53AC  44                      ld  b,h                         ; BC has effective received data size
    3823   00:53AD                          ; now just get the 4 bytes IP and place it in L H E D
    3824   00:53AD                      TCPIP_UDP_RCV_IP_ST1:
    3825   00:53AD                          CHECK_DATA
    3825   00:53AD  DB 07             >     in  a,(IN_STS_PORT)
    3825   00:53AF  CB 47             >     bit 0,a
    3826   00:53B1  20 05                   jr  nz,TCPIP_UDP_RCV_IP_ST1.1
    3827   00:53B3  CD 1E 53                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3828   00:53B6  18 F5                   jr  TCPIP_UDP_RCV_IP_ST1
    3829   00:53B8                      TCPIP_UDP_RCV_IP_ST1.1:
    3830   00:53B8                          ; nz, get it
    3831   00:53B8                          RECEIVE_DATA
    3831   00:53B8  DB 06             >     in a,(IN_DATA_PORT)
    3832   00:53BA  6F                      ld  l,a
    3833   00:53BB                      TCPIP_UDP_RCV_IP_ST2:
    3834   00:53BB                          CHECK_DATA
    3834   00:53BB  DB 07             >     in  a,(IN_STS_PORT)
    3834   00:53BD  CB 47             >     bit 0,a
