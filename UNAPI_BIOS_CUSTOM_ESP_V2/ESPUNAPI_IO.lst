    2155   00:4C2E  DD 23                   inc ix                          ; Increment pointer
    2156   00:4C30  0D                      dec c                           ; Decrement counter
    2157   00:4C31  AF                      xor a
    2158   00:4C32  B1                      or  c                           ; Is counter 0?
    2159   00:4C33                          ; If not continue getting more SSIDs
    2160   00:4C33  20 CC                   jr  nz,WAIT_MENU_SCMD_RESPONSE_ST2B
    2161   00:4C35                          ; It is zero, so, done
    2162   00:4C35                      WAIT_MENU_SCMD_RESPONSE_END_OK:
    2163   00:4C35  3E 01                   ld  a,1
    2164   00:4C37  B7                      or  a                           ; NZ to indicate success
    2165   00:4C38  78                      ld  a,b                         ; Number of APs in A
    2166   00:4C39                      WAIT_MENU_SCMD_RESPONSE_END:
    2167   00:4C39  DD E1                   pop ix
    2168   00:4C3B  D1                      pop de
    2169   00:4C3C  C9                      ret
