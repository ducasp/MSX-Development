    6728   00:6004  66                      db  %01100110
    6729   00:6005  66                      db  %01100110
    6730   00:6006  00                      db  %00000000
    6731   00:6007                      ; Pattern-12 is CHR$(1)+CHR$(92) = Copyright
    6732   00:6007  38                      db  %00111000
    6733   00:6008  44                      db  %01000100
    6734   00:6009  BA                      db  %10111010
    6735   00:600A  A2                      db  %10100010                   ; "(c)"
    6736   00:600B  BA                      db  %10111010
    6737   00:600C  44                      db  %01000100
    6738   00:600D  38                      db  %00111000
    6739   00:600E  00                      db  %00000000
    6740   00:600F                      ; http://map.grauw.nl/articles/vdp_tut.php
    6741   00:600F                      ; Set VDP address counter to write from address AHL (17-bits)
    6742   00:600F                      ; Enables the interrupts
    6743   00:600F                      SET_VDP_WRITE:
    6744   00:600F  CB 04                   rlc h
    6745   00:6011  17                      rla
    6746   00:6012  CB 04                   rlc h
    6747   00:6014  17                      rla
    6748   00:6015  CB 3C                   srl h
    6749   00:6017  CB 3C                   srl h
    6750   00:6019  F3                      di
    6751   00:601A  D3 99                   out (#99),a
    6752   00:601C  3E 8E                   ld  a,14+128
    6753   00:601E  D3 99                   out (#99),a
    6754   00:6020  7D                      ld  a,l
    6755   00:6021  00                      nop                             ; Do not remove this 'nop' here!
    6756   00:6022  D3 99                   out (#99),a
    6757   00:6024  7C                      ld  a,h
    6758   00:6025  F6 40                   or  64
    6759   00:6027  FB                      ei
    6760   00:6028  D3 99                   out (#99),a
    6761   00:602A  C9                      ret
