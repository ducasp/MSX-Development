    5080   00:5946  20 09                   jr  nz,SSH_TERM_TYPE_SET
    5081   00:5948  3E 01                   ld  a,1                         ; Get sends 1 byte
    5082   00:594A                          SEND_DATA                       ; Send the command size lsb
    5082   00:594A  D3 07             >     out (OUT_TX_PORT),a
    5083   00:594C  79                      ld  a,c
    5084   00:594D                          SEND_DATA                       ; Send the operation
    5084   00:594D  D3 07             >     out (OUT_TX_PORT),a
    5085   00:594F  18 0A                   jr  SSH_TERM_TYPE_ST0
