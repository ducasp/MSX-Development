    7612   00:642B  44                      db  %01000100
    7613   00:642C  38                      db  %00111000
    7614   00:642D  00                      db  %00000000
    7615   00:642E                      ; http://map.grauw.nl/articles/vdp_tut.php
    7616   00:642E                      ; Set VDP address counter to write from address AHL (17-bits)
    7617   00:642E                      ; Enables the interrupts
    7618   00:642E                      SET_VDP_WRITE:
    7619   00:642E  CB 04                   rlc h
    7620   00:6430  17                      rla
    7621   00:6431  CB 04                   rlc h
    7622   00:6433  17                      rla
    7623   00:6434  CB 3C                   srl h
    7624   00:6436  CB 3C                   srl h
    7625   00:6438  F3                      di
    7626   00:6439  D3 99                   out (#99),a
    7627   00:643B  3E 8E                   ld  a,14+128
    7628   00:643D  D3 99                   out (#99),a
    7629   00:643F  7D                      ld  a,l
    7630   00:6440  00                      nop                             ; Do not remove this 'nop' here!
    7631   00:6441  D3 99                   out (#99),a
    7632   00:6443  7C                      ld  a,h
    7633   00:6444  F6 40                   or  64
    7634   00:6446  FB                      ei
    7635   00:6447  D3 99                   out (#99),a
    7636   00:6449  C9                      ret
