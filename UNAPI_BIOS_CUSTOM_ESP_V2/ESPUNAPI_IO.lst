    1226   00:463B  FE 30                   cp  '0'                         ; Check if A is less than 0
    1227   00:463D  DA E6 47                jp  c,INPUT_WFSAP_BAD_INPUT     ; If it is, ignore
    1228   00:4640  BB                      cp  e                           ; Check if a is greater than what is in E
    1229   00:4641  D2 E6 47                jp  nc,INPUT_WFSAP_BAD_INPUT    ; If it is, ignore
    1230   00:4644  C3 DE 46                jp  WIFI_CONNECT_SELECTION_OK   ; Selection Ok if here
    1231   00:4647                      
    1232   00:4647                      WIFI_SELECT_SPACEBAR:
