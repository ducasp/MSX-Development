    4458   00:5648                      ;==========================
    4459   00:5648                      ;=== SSH_ADD_KNOWN_HOST ===
    4460   00:5648                      ;==========================
    4461   00:5648                      ;Add an unknown host whose connection we tried to open as known
    4462   00:5648                      ;
    4463   00:5648                      ;Input:  A = 11
    4464   00:5648                      ;        B = Connection number
    4465   00:5648                      ;Output: A = Error code
    4466   00:5648                      
    4467   00:5648                      SSH_ADD_KNOWN_HOST:
    4468   00:5648  CB FF                   set 7,a                         ; ESP SSH commands start at #80
    4469   00:564A                          SEND_DATA                       ; Send the command
