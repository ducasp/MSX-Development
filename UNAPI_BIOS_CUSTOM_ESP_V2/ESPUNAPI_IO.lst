    2143   00:4C22                      WAIT_MENU_SCMD_RESPONSE_GET_ENC.1:
    2144   00:4C22                          RECEIVE_DATA            ; Get data
    2144   00:4C22  DB 06             >     in a,(IN_DATA_PORT)
    2145   00:4C24  D6 4F                   sub 'O'                         ; If O, open, will be 0, otherwise, will be notzero
    2146   00:4C26  DD 77 00                ld  (ix+0),a                    ; Put it in the buffer
    2147   00:4C29  DD 23                   inc ix                          ; Increment pointer
    2148   00:4C2B  0D                      dec c                           ; Decrement counter
    2149   00:4C2C  AF                      xor a
    2150   00:4C2D  B1                      or  c                           ; Is counter 0?
    2151   00:4C2E                          ; If not continue getting more SSIDs
    2152   00:4C2E  20 CC                   jr  nz,WAIT_MENU_SCMD_RESPONSE_ST2B
    2153   00:4C30                          ; It is zero, so, done
    2154   00:4C30                      WAIT_MENU_SCMD_RESPONSE_END_OK:
    2155   00:4C30  3E 01                   ld  a,1
    2156   00:4C32  B7                      or  a                           ; NZ to indicate success
    2157   00:4C33  78                      ld  a,b                         ; Number of APs in A
