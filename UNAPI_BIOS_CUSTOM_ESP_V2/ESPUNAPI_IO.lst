    2102   00:4BD6  CD 4E 4C                call    HLTIMEOUT
    2103   00:4BD9  20 F0                   jr  nz,WAIT_MENU_SCMD_RESPONSE_ST1
    2104   00:4BDB  C3 41 4C                jp  WAIT_MENU_SCMD_RESPONSE_END ; If time out waiting, return
    2105   00:4BDE                      WAIT_MENU_SCMD_RESPONSE_ST1.1:
    2106   00:4BDE                          ; nz, check the data
    2107   00:4BDE                          RECEIVE_DATA
    2107   00:4BDE  DB 06             >     in a,(IN_DATA_PORT)
    2108   00:4BE0  BA                      cp  d                           ; Is response of our command?
    2109   00:4BE1  20 E8                   jr  nz,WAIT_MENU_SCMD_RESPONSE_ST1
