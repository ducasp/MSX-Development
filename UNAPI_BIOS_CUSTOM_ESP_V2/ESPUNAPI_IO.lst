    2281   00:4CC5                          ; A=0: B=B+1 and jump to old hook
    2282   00:4CC5                      
    2283   00:4CC5  CD 4C 5E                call    GETSLT
    2284   00:4CC8  CD A5 5E                call    GETWRK
    2285   00:4CCB  F1                      pop af
