    5349   00:5A90  CD 28 61                call    SETWORD                 ; Save HL pointer in our memory
    5350   00:5A93  7C                      ld  a,h
    5351   00:5A94  B5                      or  l                           ; Information block required?
    5352   00:5A95  3E 00                   ld  a,0                         ; do not want to mess with flags, let's say no need
    5353   00:5A97  28 01                   jr  z,TCPIP_TCP_STATE_NOINFOBLOCK
    5354   00:5A99  3C                      inc a                           ; otherwise there is a need
    5355   00:5A9A                      TCPIP_TCP_STATE_NOINFOBLOCK:
    5356   00:5A9A  CD 01 61                call    SETBYTE                 ; Save for later
    5357   00:5A9D  3E 10                   ld  a,16                        ; Our command
    5358   00:5A9F                          SEND_DATA                       ; Send the command
    5358   00:5A9F  D3 07             >     out (OUT_TX_PORT),a
    5359   00:5AA1  AF                      xor a
    5360   00:5AA2                          SEND_DATA                       ; Send the command size msb
    5360   00:5AA2  D3 07             >     out (OUT_TX_PORT),a
    5361   00:5AA4  3C                      inc a
    5362   00:5AA5                          SEND_DATA                       ; Send the command size lsb
    5362   00:5AA5  D3 07             >     out (OUT_TX_PORT),a
    5363   00:5AA7  78                      ld  a,b
    5364   00:5AA8                          SEND_DATA                       ; Send the parameter
    5364   00:5AA8  D3 07             >     out (OUT_TX_PORT),a
    5365   00:5AAA                      
    5366   00:5AAA                          ; Now wait up to 180 ticks to get response
    5367   00:5AAA  21 B4 00                ld  hl,180
    5368   00:5AAD  CD DF 60                call    SETCOUNTER
    5369   00:5AB0                      TCPIP_TCP_STATE_ST1:
