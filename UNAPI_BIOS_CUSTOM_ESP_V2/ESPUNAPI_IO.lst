    7638   00:644A                      ;*********************************************
    7639   00:644A                      ;***    ESP Specific Commands/Responses    ***
    7640   00:644A                      ;*********************************************
    7641   00:644A                      ; Cold reset of ESP firmware
    7642   00:644A  (00:0052)           CMD_RESET_ESP           equ 'R'
    7643   00:644A                      ; ESP32 only, return the firmware type on the device
    7644   00:644A  (00:0062)           CMD_GET_FW_TYPE         equ 'b'
    7645   00:644A                      ; Warm reset of ESP firmware
    7646   00:644A  (00:0057)           CMD_WRESET_ESP          equ 'W'
    7647   00:644A                      ; Hold Wi-Fi Connection On
    7648   00:644A  (00:0048)           CMD_WIFIHOLD_ESP        equ 'H'
    7649   00:644A                      ; Release Wi-Fi Connection Hold
    7650   00:644A  (00:0068)           CMD_WIFIRELEASE_ESP     equ 'h'
    7651   00:644A                      ; Get Updated time and date from internet
    7652   00:644A  (00:0047)           CMD_GET_TIME            equ 'G'
    7653   00:644A                      ; Query Auto Clock settings
    7654   00:644A  (00:0063)           CMD_QUERY_ACLK_SETTINGS equ 'c'
    7655   00:644A                      ; Set Auto Clock settings
    7656   00:644A  (00:0043)           CMD_SET_ACLK_SETTINGS   equ 'C'
    7657   00:644A                      ; Query ESP settings
    7658   00:644A  (00:0051)           CMD_QUERY_ESP_SETTINGS  equ 'Q'
    7659   00:644A                      ; Set Timer Value
    7660   00:644A  (00:0054)           CMD_TIMER_SET           equ 'T'
    7661   00:644A                      ; Turn Nagle On
    7662   00:644A  (00:0044)           CMD_NAGLE_ON            equ 'D'
    7663   00:644A                      ; Turn Nagle Off
    7664   00:644A  (00:004E)           CMD_NAGLE_OFF           equ 'N'
    7665   00:644A                      ; Turn Wi-Fi Off
    7666   00:644A  (00:004F)           CMD_WIFI_OFF            equ 'O'
    7667   00:644A                      ; Request to connect to a network
    7668   00:644A  (00:0041)           CMD_WIFI_CONNECT        equ 'A'
    7669   00:644A                      ; Request to start network scan
    7670   00:644A  (00:0053)           CMD_SCAN_START          equ 'S'
    7671   00:644A                      ; Request network scan result
    7672   00:644A  (00:0073)           CMD_SCAN_RESULTS        equ 's'
    7673   00:644A                      ; Request AP Status
    7674   00:644A  (00:0067)           CMD_AP_STS              equ 'g'
    7675   00:644A                      ; Get ESP firmware version
    7676   00:644A  (00:0056)           CMD_GET_ESP_VER         equ 'V'
    7677   00:644A                      ; After finishing Warm reset, ESP returns ready
    7678   00:644A  52 65 61 64 79      RSP_CMD_RESET_ESP       db  "Ready"
    7679   00:644F  (00:0005)           RSP_CMD_RESET_ESP_SIZE  equ 5
    7680   00:644F                      ; Query ESP Presence
    7681   00:644F  (00:003F)           CMD_QUERY_ESP           equ '?'
    7682   00:644F                      ; Query response
    7683   00:644F  4F 4B               RSP_CMD_QUERY_ESP       db  "OK"
    7684   00:6451  (00:0002)           RSP_CMD_QUERY_ESP_SIZE  equ 2
    7685   00:6451                      
