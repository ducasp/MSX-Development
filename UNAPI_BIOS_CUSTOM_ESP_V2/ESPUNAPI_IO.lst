    2251   00:4CA6  C2 30 4D                jp  nz,JUMP_OLD
    2252   00:4CA9                      
    2253   00:4CA9                          ; Check API ID TCP/IP
    2254   00:4CA9  21 10 71                ld  hl,UNAPI_ID
