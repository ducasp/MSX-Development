    5404   00:5AAD                      ;         HL = Number of urgent data bytes that have been retrieved
    5405   00:5AAD                      ;              (placed at the beginning of the received data block)
    5406   00:5AAD                      ; Save registers other than AF
    5407   00:5AAD                      TCPIP_TCP_RCV_CHECK_TIME_OUT:
    5408   00:5AAD  C5                      push bc
    5409   00:5AAE  D5                      push de
    5410   00:5AAF  E5                      push hl
    5411   00:5AB0  CD DD 5E                call    GETCOUNTER
    5412   00:5AB3  7D                      ld  a,l
    5413   00:5AB4  B4                      or  h
    5414   00:5AB5                          ; Restore registers, we are returning
    5415   00:5AB5  E1                      pop hl
    5416   00:5AB6  D1                      pop de
    5417   00:5AB7  C1                      pop bc
    5418   00:5AB8  C0                      ret nz
    5419   00:5AB9                          ; Ok, timeout...
    5420   00:5AB9  F1                      pop af                          ; Get return address of who called this out of the stack, we will return from the function or re-start
    5421   00:5ABA                      TCPIP_TCP_RCV_RETRY_QRCV:
    5422   00:5ABA  CD FC 5E                call    GETBYTE
    5423   00:5ABD  B7                      or  a
    5424   00:5ABE  28 0B                   jr  z,TCPIP_TCP_RCV_CHECK_TIME_OUT.NORXRETRY
    5425   00:5AC0                          ; Ok, so let's ask ESP to re-send the data and retry receiving it
    5426   00:5AC0  3D                      dec a
    5427   00:5AC1  CD 0E 5F                call    SETBYTE                 ; we are retrying it
    5428   00:5AC4  3E 72                   ld  a,'r'                       ; retry transmission command
    5429   00:5AC6                          SEND_DATA
    5429   00:5AC6  D3 07             >     out (OUT_TX_PORT),a
    5430   00:5AC8  C3 07 5B                jp  TCPIP_TCP_RCV.RXRETRY       ; and retry it
    5431   00:5ACB                      TCPIP_TCP_RCV_CHECK_TIME_OUT.NORXRETRY:
    5432   00:5ACB  3E 0F                   ld  a,ERR_INV_OPER
