     156   00:4000  (00:F3E1)           REG2SAV:                equ #F3E1
     157   00:4000  (00:F3E3)           REG4SAV:                equ #F3E3
     158   00:4000  (00:F676)           TXTTAB:                 equ #F676
     159   00:4000  (00:F847)           ARG:                    equ #F847
