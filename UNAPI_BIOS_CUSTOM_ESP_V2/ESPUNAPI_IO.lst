    2186   00:4C4B  C9                      ret
    2187   00:4C4C                      
    2188   00:4C4C                      ; Routine to print the string addressed by HL
    2189   00:4C4C                      PRINTHL:
    2190   00:4C4C  7E                      ld  a,(hl)
    2191   00:4C4D  B7                      or  a
    2192   00:4C4E  C8                      ret z                           ; When string is finished, done!
