    1735   00:49CB                          SEND_DATA
    1735   00:49CB  D3 07             >     out (OUT_TX_PORT),a
    1736   00:49CD  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1737   00:49D0  CD 07 4B                call    WAIT_MENU_QCMD_RESPONSE
    1738   00:49D3  CA FE 4A                jp  z,MENU_BAD_END
    1739   00:49D6  21 26 6E                ld  hl,STR_SENDING_OK           ; Success
    1740   00:49D9  CD 54 4C                call    PRINTHL
