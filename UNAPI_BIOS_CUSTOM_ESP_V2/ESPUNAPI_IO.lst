    5916   00:5D3E  18 F5                   jr  SSH_AUTH_GET_CHALLENGE_FLAGSA
    5917   00:5D40                      SSH_AUTH_GET_CHALLENGE_FLAGSA.1:
    5918   00:5D40                          ; nz, prompts, B to later go to H
    5919   00:5D40                          RECEIVE_DATA
    5919   00:5D40  DB 06             >     in a,(IN_DATA_PORT)
    5920   00:5D42  47                      ld b,a
