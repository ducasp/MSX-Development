    4312   00:55AB  DB 06             >     in a,(IN_DATA_PORT)
    4313   00:55AD  B7                      or  a                           ; 0?
    4314   00:55AE  C0                      ret nz
    4315   00:55AF                      
    4316   00:55AF                          ; next two bytes are size bytes, don't care, it is 1, conn #
    4317   00:55AF  06 02                   ld  b,2
    4318   00:55B1                      SSH_OPEN_ST2:
    4319   00:55B1                          CHECK_DATA
    4319   00:55B1  DB 07             >     in  a,(IN_STS_PORT)
    4319   00:55B3  CB 47             >     bit 0,a
