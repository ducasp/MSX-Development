    4634   00:572F                          CHECK_DATA
    4634   00:572F  DB 07             >     in  a,(IN_STS_PORT)
    4634   00:5731  CB 47             >     bit 0,a
    4635   00:5733  20 05                   jr  nz,SSH_KEY_EXPORT_SIZE_B.1
