    5889   00:5D1A  18 F5                   jr  SSH_AUTH_GET_CHALLENGE_BUFERRA
    5890   00:5D1C                      SSH_AUTH_GET_CHALLENGE_BUFERRA.1:
    5891   00:5D1C                          ; nz, low byte count of bytes to receive
    5892   00:5D1C                          RECEIVE_DATA
    5892   00:5D1C  DB 06             >     in a,(IN_DATA_PORT)
    5893   00:5D1E  4F                      ld c,a
    5894   00:5D1F                      SSH_AUTH_GET_CHALLENGE_BUFERRB:
    5895   00:5D1F                          CHECK_DATA
    5895   00:5D1F  DB 07             >     in  a,(IN_STS_PORT)
    5895   00:5D21  CB 47             >     bit 0,a
    5896   00:5D23  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_BUFERRB.1
    5897   00:5D25  CD AD 5A                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5898   00:5D28  18 F5                   jr  SSH_AUTH_GET_CHALLENGE_BUFERRB
    5899   00:5D2A                      SSH_AUTH_GET_CHALLENGE_BUFERRB.1:
