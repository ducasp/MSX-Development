    5334   00:5A7B                          ; nz, discard
    5335   00:5A7B                          RECEIVE_DATA
    5335   00:5A7B  DB 06             >     in a,(IN_DATA_PORT)
    5336   00:5A7D  0D                      dec c
    5337   00:5A7E  20 F0                   jr  nz,TCPIP_TCP_STATE_ERROR2
    5338   00:5A80                      
    5339   00:5A80                          ; now return w/ error that is saved in b
    5340   00:5A80  78                      ld  a,b
    5341   00:5A81  06 00                   ld  b,0
    5342   00:5A83  0E 07                   ld  c,7
    5343   00:5A85  21 00 00                ld  hl,0
    5344   00:5A88  11 00 00                ld  de,0
    5345   00:5A8B  DD 21 00 00             ld  ix,0
