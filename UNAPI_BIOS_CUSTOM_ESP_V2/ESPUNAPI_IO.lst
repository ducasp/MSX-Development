    7514   00:63D4  FC                      db  %11111100
    7515   00:63D5  00                      db  %00000000
    7516   00:63D6                      ; Pattern-02 is CHR$(1)+CHR$(82) = SCAN_TERMINATOR_ENC
    7517   00:63D6  30                      db  %00110000
    7518   00:63D7  48                      db  %01001000
    7519   00:63D8  48                      db  %01001000
    7520   00:63D9  FC                      db  %11111100                   ; "Closed Padlock"
