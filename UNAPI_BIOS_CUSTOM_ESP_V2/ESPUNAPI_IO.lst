    5469   00:5AFD                          SEND_DATA                       ; Send MAX rcv size LSB
    5469   00:5AFD  D3 07             >     out (OUT_TX_PORT),a
    5470   00:5AFF  7C                      ld  a,h
    5471   00:5B00                          SEND_DATA                       ; Send MAX rcv size MSB
    5471   00:5B00  D3 07             >     out (OUT_TX_PORT),a
    5472   00:5B02  3E 03                   ld  a,3
    5473   00:5B04  CD 0E 5F                call    SETBYTE                 ; Ok, retry up to three times
    5474   00:5B07                      TCPIP_TCP_RCV.RXRETRY:
    5475   00:5B07                          ; Now wait up to 600 ticks to get response
    5476   00:5B07  21 58 02                ld  hl,600
