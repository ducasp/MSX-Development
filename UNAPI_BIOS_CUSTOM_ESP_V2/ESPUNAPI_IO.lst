    2132   00:4C08  4F                      ld  c,a                         ; And C as well
    2133   00:4C09                          ; Now should loop this until c is 0, c will control access point received count
    2134   00:4C09                      WAIT_MENU_SCMD_RESPONSE_ST2B:
    2135   00:4C09                          CHECK_DATA
    2135   00:4C09  DB 07             >     in  a,(IN_STS_PORT)
    2135   00:4C0B  CB 47             >     bit 0,a
    2136   00:4C0D  20 08                   jr  nz,WAIT_MENU_SCMD_RESPONSE_ST2B.1
    2137   00:4C0F  CD 4E 4C                call    HLTIMEOUT
