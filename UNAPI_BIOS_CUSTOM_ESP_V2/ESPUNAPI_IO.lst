    1724   00:49BC  3E 44                   ld  a,CMD_NAGLE_ON
    1725   00:49BE                          SEND_DATA
    1725   00:49BE  D3 07             >     out (OUT_TX_PORT),a
    1726   00:49C0  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1727   00:49C3  CD FA 4A                call    WAIT_MENU_QCMD_RESPONSE
    1728   00:49C6  CA F1 4A                jp  z,MENU_BAD_END
    1729   00:49C9  21 35 6F                ld  hl,STR_SENDING_OK           ; Success
