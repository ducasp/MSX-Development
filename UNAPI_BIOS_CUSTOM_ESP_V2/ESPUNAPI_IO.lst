    1035   00:44EB  14                      inc d                           ; Digits entered now is 1
    1036   00:44EC  1C                      inc e                           ; Digits printed increased
    1037   00:44ED  C3 4D 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; Continue waiting input
    1038   00:44F0                      CLK_AUTO_GMT_CHK_CSD:
