    2153   00:4C2F                      WAIT_MENU_SCMD_RESPONSE_GET_ENC.1:
    2154   00:4C2F                          RECEIVE_DATA            ; Get data
    2154   00:4C2F  DB 06             >     in a,(IN_DATA_PORT)
    2155   00:4C31  D6 4F                   sub 'O'                         ; If O, open, will be 0, otherwise, will be notzero
    2156   00:4C33  DD 77 00                ld  (ix+0),a                    ; Put it in the buffer
    2157   00:4C36  DD 23                   inc ix                          ; Increment pointer
    2158   00:4C38  0D                      dec c                           ; Decrement counter
    2159   00:4C39  AF                      xor a
    2160   00:4C3A  B1                      or  c                           ; Is counter 0?
    2161   00:4C3B                          ; If not continue getting more SSIDs
    2162   00:4C3B  20 CC                   jr  nz,WAIT_MENU_SCMD_RESPONSE_ST2B
    2163   00:4C3D                          ; It is zero, so, done
    2164   00:4C3D                      WAIT_MENU_SCMD_RESPONSE_END_OK:
    2165   00:4C3D  3E 01                   ld  a,1
    2166   00:4C3F  B7                      or  a                           ; NZ to indicate success
    2167   00:4C40  78                      ld  a,b                         ; Number of APs in A
    2168   00:4C41                      WAIT_MENU_SCMD_RESPONSE_END:
    2169   00:4C41  DD E1                   pop ix
    2170   00:4C43  D1                      pop de
    2171   00:4C44  C9                      ret
    2172   00:4C45                      WAIT_MENU_SCMD_RESPONSE_END_NOK:
    2173   00:4C45  21 00 00                ld  hl,0
    2174   00:4C48  47                      ld  b,a                         ; Return code in B
    2175   00:4C49  AF                      xor a
    2176   00:4C4A  DD E1                   pop ix
    2177   00:4C4C  D1                      pop de
    2178   00:4C4D  C9                      ret
    2179   00:4C4E                      
    2180   00:4C4E                      ; This routine will check if HL is 0, if it is, will return immediatelly
    2181   00:4C4E                      ; If it is not, will decrease HL value and halt (wait one interrupt)
    2182   00:4C4E                      HLTIMEOUT:
    2183   00:4C4E  7C                      ld  a,h
    2184   00:4C4F  B5                      or  l
    2185   00:4C50  C8                      ret z
    2186   00:4C51  2B                      dec hl
    2187   00:4C52  76                      halt
    2188   00:4C53  C9                      ret
    2189   00:4C54                      
    2190   00:4C54                      ; Routine to print the string addressed by HL
    2191   00:4C54                      PRINTHL:
    2192   00:4C54  7E                      ld  a,(hl)
    2193   00:4C55  B7                      or  a
    2194   00:4C56  C8                      ret z                           ; When string is finished, done!
    2195   00:4C57  CD A2 00                call    CHPUT
    2196   00:4C5A  23                      inc hl
    2197   00:4C5B  C3 54 4C                jp  PRINTHL
    2198   00:4C5E                      
    2199   00:4C5E                      ; Routine to print the string addressed by HL on a line, if exceeding it, ends with ..
    2200   00:4C5E                      PRINTHLINE:
    2201   00:4C5E  C5                      push    bc
    2202   00:4C5F  06 18                   ld  b,24
    2203   00:4C61                      PHLINEL:
