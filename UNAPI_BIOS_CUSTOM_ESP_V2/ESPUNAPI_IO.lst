    5918   00:5D46  18 F5                   jr  SSH_AUTH_GET_CHALLENGE_FLAGSA
    5919   00:5D48                      SSH_AUTH_GET_CHALLENGE_FLAGSA.1:
    5920   00:5D48                          ; nz, prompts, B to later go to H
    5921   00:5D48                          RECEIVE_DATA
    5921   00:5D48  DB 06             >     in a,(IN_DATA_PORT)
    5922   00:5D4A  47                      ld b,a
    5923   00:5D4B                      SSH_AUTH_GET_CHALLENGE_FLAGSB:
    5924   00:5D4B                          CHECK_DATA
    5924   00:5D4B  DB 07             >     in  a,(IN_STS_PORT)
    5924   00:5D4D  CB 47             >     bit 0,a
    5925   00:5D4F  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_FLAGSB.1
