    6266   00:5E9E  09                      add hl,bc
    6267   00:5E9F  7E                      ld  a,(hl)
    6268   00:5EA0  B7                      or  a
    6269   00:5EA1  C2 A9 5E                jp  nz,GETSLTTRET
    6270   00:5EA4  3C                      inc a
    6271   00:5EA5  77                      ld  (hl),a
    6272   00:5EA6  CD F0 41                call    HIMEM_ALLOC
    6273   00:5EA9                      GETSLTTRET:
