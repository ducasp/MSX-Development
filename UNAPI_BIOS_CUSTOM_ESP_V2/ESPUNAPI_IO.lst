    4910   00:587D                      ;===  TCPIP_TCP_STATE  ===
    4911   00:587D                      ;=========================
    4912   00:587D                      ;Get the state of a TCP connection.
    4913   00:587D                      ;
    4914   00:587D                      ;Input:  A = 16
    4915   00:587D                      ;        B = Connection number
