    2100   00:4BCE  CD 46 4C                call    HLTIMEOUT
    2101   00:4BD1  20 F0                   jr  nz,WAIT_MENU_SCMD_RESPONSE_ST1
    2102   00:4BD3  C3 39 4C                jp  WAIT_MENU_SCMD_RESPONSE_END ; If time out waiting, return
    2103   00:4BD6                      WAIT_MENU_SCMD_RESPONSE_ST1.1:
    2104   00:4BD6                          ; nz, check the data
    2105   00:4BD6                          RECEIVE_DATA
    2105   00:4BD6  DB 06             >     in a,(IN_DATA_PORT)
    2106   00:4BD8  BA                      cp  d                           ; Is response of our command?
    2107   00:4BD9  20 E8                   jr  nz,WAIT_MENU_SCMD_RESPONSE_ST1
