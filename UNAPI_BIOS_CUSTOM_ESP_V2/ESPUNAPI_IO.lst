    1725   00:49B0  3E 4F                   ld  a,'O'
    1726   00:49B2  CD A2 00                call    CHPUT
    1727   00:49B5  3E 0D                   ld  a,#0d
    1728   00:49B7  CD A2 00                call    CHPUT
    1729   00:49BA  3E 0A                   ld  a,#0a
    1730   00:49BC  CD A2 00                call    CHPUT
    1731   00:49BF  21 0B 6E                ld  hl,STR_SENDING              ; Indicate it is sending a command
    1732   00:49C2  CD 54 4C                call    PRINTHL
    1733   00:49C5                          CLEAR_UART
    1733   00:49C5  3E 14             >     ld  a,20
