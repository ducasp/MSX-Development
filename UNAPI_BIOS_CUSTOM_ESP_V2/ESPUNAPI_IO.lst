    3053   00:5044                      ;=========================
    3054   00:5044                      ;===  TCPIP_NET_STATE  ===
    3055   00:5044                      ;=========================
    3056   00:5044                      ;Get network state.
    3057   00:5044                      ;
    3058   00:5044                      ;Input:  A = 3
    3059   00:5044                      ;Output: A = Error code
    3060   00:5044                      ;        B = Current network state:
    3061   00:5044                      ;            0: Closed
    3062   00:5044                      ;            1: Opening
    3063   00:5044                      ;            2: Open
    3064   00:5044                      ;            3: Closing
    3065   00:5044                      ;            255: Unknown
    3066   00:5044                      TCPIP_NET_STATE:
    3067   00:5044                          SEND_DATA                       ; Send the command
    3067   00:5044  D3 07             >     out (OUT_TX_PORT),a
    3068   00:5046  AF                      xor a
    3069   00:5047                          SEND_DATA                       ; Send the command size msb
    3069   00:5047  D3 07             >     out (OUT_TX_PORT),a
    3070   00:5049                          SEND_DATA                       ; Send the command size lsb
    3070   00:5049  D3 07             >     out (OUT_TX_PORT),a
    3071   00:504B                      
    3072   00:504B                          ; Now wait up to 720 ticks to get response
    3073   00:504B  21 D0 02                ld  hl,720
    3074   00:504E  CD EC 5E                call    SETCOUNTER
    3075   00:5051                      TCPIP_NET_STATE_ST1:
    3076   00:5051                          CHECK_DATA
    3076   00:5051  DB 07             >     in  a,(IN_STS_PORT)
    3076   00:5053  CB 47             >     bit 0,a
    3077   00:5055  20 05                   jr  nz,TCPIP_NET_STATE_ST1.1
    3078   00:5057  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3079   00:505A  18 F5                   jr  TCPIP_NET_STATE_ST1
    3080   00:505C                      TCPIP_NET_STATE_ST1.1:
    3081   00:505C                          ; nz, check the data
    3082   00:505C                          RECEIVE_DATA
    3082   00:505C  DB 06             >     in a,(IN_DATA_PORT)
    3083   00:505E  FE 03                   cp  3                           ; Is response of our command?
    3084   00:5060  20 EF                   jr  nz,TCPIP_NET_STATE_ST1
    3085   00:5062                          ; now get return code, if return code other than 0, it is finished
    3086   00:5062                      TCPIP_NET_STATE_RC:
    3087   00:5062                          CHECK_DATA
    3087   00:5062  DB 07             >     in  a,(IN_STS_PORT)
    3087   00:5064  CB 47             >     bit 0,a
    3088   00:5066  20 05                   jr  nz,TCPIP_NET_STATE_RC.1
    3089   00:5068  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3090   00:506B  18 F5                   jr  TCPIP_NET_STATE_RC
    3091   00:506D                      TCPIP_NET_STATE_RC.1:
    3092   00:506D                          ; nz, get it
    3093   00:506D                          RECEIVE_DATA
    3093   00:506D  DB 06             >     in a,(IN_DATA_PORT)
    3094   00:506F  B7                      or  a                           ; 0?
    3095   00:5070  C0                      ret nz                          ; if not, done
    3096   00:5071                      
    3097   00:5071                          ; next two bytes are return code and size bytes, don't care, it is 1
    3098   00:5071  06 02                   ld  b,2
    3099   00:5073                      TCPIP_NET_STATE_ST2:
    3100   00:5073                          CHECK_DATA
    3100   00:5073  DB 07             >     in  a,(IN_STS_PORT)
    3100   00:5075  CB 47             >     bit 0,a
    3101   00:5077  20 05                   jr  nz,TCPIP_NET_STATE_ST2.1
    3102   00:5079  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3103   00:507C  18 F5                   jr  TCPIP_NET_STATE_ST2
