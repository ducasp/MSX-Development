     334   00:4000                      ;************************
     335   00:4000                      ;***  MSX ROM HEADER  ***
     336   00:4000                      ;************************
     337   00:4000                          org #4000
     338   00:4000  41 42                   db                  #41,#42
     339   00:4002  10 40                   dw                  INIT        ; Initialize ESP, if not found, won't install hook
     340   00:4004  00 00                   dw                  0           ; Statement
     341   00:4006  00 00                   dw                  0           ; Device
     342   00:4008  00 00                   dw                  0           ; Text
     343   00:400A  00 (6)                  ds                  6           ; Reserved
     344   00:4010                      
     345   00:4010                      ;==================
     346   00:4010                      ;===  Start-up  ===
     347   00:4010                      ;==================
     348   00:4010                      
     349   00:4010                      INIT:
     350   00:4010  7C                      ld  a,h                         ; Let's test if we are mirrored and being executed in wrong page
     351   00:4011  FE 40                   cp  #40                         ; is MSB 0x40?
     352   00:4013  C0                      ret nz                          ; if not, return, it is a mirror
     353   00:4014                          ; Let's set some System Variables
     354   00:4014  AF                      xor a                           ; a = #00
     355   00:4015  32 A9 FC                ld  (CSRSW),a                   ; cursor display is disabled
     356   00:4018  32 DB F3                ld  (CLIKSW),a                  ; when key press, key click disabled
     357   00:401B                          ; Let's intercept [DEL] key
     358   00:401B  3E 08                   ld  a,8
     359   00:401D  CD 41 01                call    SNSMAT
     360   00:4020  CB 5F                   bit 3,a                         ; Test [DEL]
     361   00:4022  C8                      ret z                           ; If DEL is pressed, UNAPI driver is not loaded and exits
     362   00:4023                          ; Let's check the Screen Mode, ref. https://www.msx.org/wiki/VDP_Table_Base_Address_Registers
     363   00:4023  3A E1 F3                ld  a,(REG2SAV)
     364   00:4026  FE 02                   cp  2
     365   00:4028  CA 32 40                jp  z,SCREEN_SETUP              ; If yes, is SCREEN 3
     366   00:402B  3A E3 F3                ld  a,(REG4SAV)
     367   00:402E  FE 00                   cp  0
     368   00:4030  28 06                   jr  z,IS_SCREEN1                ; If yes, is SCREEN 1
     369   00:4032                      SCREEN_SETUP:
     370   00:4032                          ; Let's set the SCREEN 1
     371   00:4032  3E 01                   ld  a,1                         ; a = #01
     372   00:4034  F7                      rst #30
     373   00:4035  00                      db  0
     374   00:4036  5F 00                   dw  CHGMOD                      ; SCREEN 1
     375   00:4038                      IS_SCREEN1:
     376   00:4038  3E 1D                   ld  a,29                        ; WIDTH 29
     377   00:403A  32 B0 F3                ld  (LINLEN),a
     378   00:403D                          ; We check if the Port F2 device is available
     379   00:403D                          READ_F2                         ; a = #FF, default value if it comes from power off or hard reset
     379   00:403D  DB F2             >     in  a,(PORT_F2)
     380   00:403F  2F                      cpl                             ; a = #FF - a
     381   00:4040  4F                      ld  c,a                         ; c = #00
     382   00:4041                          WRITE_F2                        ; a = #00
     382   00:4041  D3 F2             >     out (PORT_F2),a
     383   00:4043                          ; Wait 250ms to ensure a successful hard reset even if you press the button very quickly
     384   00:4043  CD DE 49                call    WAIT_250MS_AND_THEN_CONTINUE
     385   00:4046                          READ_F2                         ; a = #00?
     385   00:4046  DB F2             >     in  a,(PORT_F2)
     386   00:4048  2F                      cpl                             ; a = #FF - a
     387   00:4049                          WRITE_F2                        ; a = #FF?
     387   00:4049  D3 F2             >     out (PORT_F2),a
     388   00:404B  F5                      push    af
     389   00:404C  3E FE                   ld  a,#FE                       ; Preset #FE, unexpected error
     390   00:404E                          WRITE_F2                        ; on port #F2
     390   00:404E  D3 F2             >     out (PORT_F2),a
     391   00:4050  F1                      pop af
     392   00:4051  B9                      cp  c                           ; If not a = c, port #F2 is writable and available
     393   00:4052  28 3C                   jr  z,BOOT_FROM_POWER_OFF       ; If a = c, port #F2 is not available, let's proceed as "boot from power off"
     394   00:4054                          ; Ok, Port F2 device available
     395   00:4054  FE EF                   cp  #EF                         ; UNAPI driver has been disabled
     396   00:4056  20 03                   jr  nz,NOT_DISABLED_BY_F2       ; No, let's continue checking
     397   00:4058                          WRITE_F2                        ; If yes, UNAPI driver is not loaded and exits, but need to restore F2 port to not have a false error
     397   00:4058  D3 F2             >     out (PORT_F2),a
     398   00:405A  C9                      ret                             ; And our work is done
     399   00:405B                      NOT_DISABLED_BY_F2:
     400   00:405B  FE F0                   cp  #F0                         ; UNAPI driver has been loaded at least once
     401   00:405D  C2 72 40                jp  nz, F2_IS_NOT_F0            ; Ok, has not been loaded
     402   00:4060                          ; Let's intercept [F1] key
     403   00:4060  3E 06                   ld  a,6
     404   00:4062  CD 41 01                call    SNSMAT
     405   00:4065  CB 6F                   bit 5,a                         ; Test [F1]
     406   00:4067  CA 2C 42                jp  z,ENTERING_ESPSETUP         ; If F1 is pressed, let's execute our setup menu
     407   00:406A                          ; F1 is not pressed, continue
     408   00:406A  CB 77                   bit 6,a                         ; Test [F2]
     409   00:406C  C2 EA 40                jp  nz,INIT_UNAPI               ; If F2 is not pressed, let's proceed to INIT_UNAPI
     410   00:406F                          ; F2 is not pressed, continue
     411   00:406F  C3 97 41                jp  INIT_NOCLOCKUPDAT2          ; If yes, proceed without affecting the connection or the date and time
     412   00:4072                      F2_IS_NOT_F0:
     413   00:4072  FE F1                   cp  #F1                         ; User requested to go directly to Wi-Fi Setup
     414   00:4074  CA 2C 42                jp  z,ENTERING_ESPSETUP         ; If yes, let's execute our setup menu
     415   00:4077  FE F2                   cp  #F2                         ; User forces to check if ESP is installed
     416   00:4079  CA C7 40                jp  z,F2_IS_PRESSED             ; If yes, let's go check it out
     417   00:407C  FE FE                   cp  #FE                         ; Unexpected error from the previous reboot
     418   00:407E  20 10                   jr  nz,BOOT_FROM_POWER_OFF      ; If no one is confirmed, let's proceed as "boot from power off"
     419   00:4080                          ; Oops! An unexpected error occurred on the last reboot
     420   00:4080  21 D5 70                ld  hl,STR_OOPS                 ; Print Oops! An unexpected error message
     421   00:4083  CD 47 4C                call    PRINTHL                 ; and let's proceed as "boot from power off"
     422   00:4086  06 78                   ld  b,120                       ; Wait 2 seconds with message on screen
     423   00:4088                      WAIT_2S:
     424   00:4088  76                      halt
     425   00:4089  10 FD                   djnz    WAIT_2S                 ; If not zero, our time out has not elapsed
     426   00:408B  3E 0C                   ld  a,CLS
     427   00:408D  CD A2 00                call    CHPUT
     428   00:4090                      BOOT_FROM_POWER_OFF:
     429   00:4090                          ; Let's intercept [F1] key
     430   00:4090  3E 06                   ld  a,6
     431   00:4092  CD 41 01                call    SNSMAT
     432   00:4095  CB 6F                   bit 5,a                         ; Test [F1]
     433   00:4097  CA 2C 42                jp  z,ENTERING_ESPSETUP         ; If F1 is pressed, let's execute our setup menu
     434   00:409A                          ; F1 is not pressed, continue
     435   00:409A                          if  NON_VERBOSE_ROM = 0
     436   00:409A  21 6D 64                ld  hl,WELCOME
     437   00:409D  CD 84 62                call    CHECK_ESP_TYPE
     438   00:40A0  28 03                   jr  z,NOT32_1
     439   00:40A2  21 B7 64                ld  hl,WELCOME32
     440   00:40A5                      NOT32_1:
     441   00:40A5  CD 47 4C                call    PRINTHL
     442   00:40A8                          CHECK_QUICK_RECEIVE
     442   00:40A8  3A 07 00          >     ld  a,(IN_STS_PORT)
     442   00:40AB  CB 5F             >     bit 3,a
     443   00:40AD  20 08                   jr  nz,BOOT_FROM_POWER_OFF.1    ; QR Supported
     444   00:40AF  21 21 65                ld  hl,WELCOME_SF2
     445   00:40B2  CD 47 4C                call    PRINTHL
     446   00:40B5  18 06                   jr  BOOT_FROM_POWER_OFF.2
     447   00:40B7                      BOOT_FROM_POWER_OFF.1:
     448   00:40B7  21 05 65                ld  hl,WELCOME_SF
     449   00:40BA  CD 47 4C                call    PRINTHL
     450   00:40BD                      BOOT_FROM_POWER_OFF.2:
     451   00:40BD                          endif
     452   00:40BD  3E 06                   ld  a,6
     453   00:40BF  CD 41 01                call    SNSMAT
     454   00:40C2  CB 77                   bit 6,a                         ; Test [F2]
     455   00:40C4  C2 EA 40                jp  nz,INIT_UNAPI               ; If F2 is not pressed, let's proceed to INIT_UNAPI
     456   00:40C7                          ; F2 is pressed, continue
     457   00:40C7                      F2_IS_PRESSED:
     458   00:40C7  CD B5 62                call    RESET_ESP
     459   00:40CA  B7                      or  a
     460   00:40CB  20 06                   jr  nz,ESP_NOT_FOUND
     461   00:40CD  21 35 70                ld  hl,OK_S                     ; Properly detected
     462   00:40D0  C3 DD 40                jp  INIT_F_MSG                  ; Well, if reset successful, continue
     463   00:40D3                      ESP_NOT_FOUND:
     464   00:40D3                          ; If here, ESP was not found, so, exit with an error message
     465   00:40D3  78                      ld  a,b
     466   00:40D4  B7                      or  a
     467   00:40D5  21 50 70                ld  hl,FAIL_S                   ; If 0, non responsive
     468   00:40D8  28 03                   jr  z,INIT_F_MSG
     469   00:40DA  21 9A 70                ld  hl,FAIL_F                   ; Otherwise, firmware is old
     470   00:40DD                      INIT_F_MSG:
     471   00:40DD  CD 47 4C                call    PRINTHL
     472   00:40E0                      INIT_F_WAIT:
     473   00:40E0  06 B4                   ld  b,180                       ; 3s
     474   00:40E2                      INIT_F_LOOP_WAIT:
     475   00:40E2  76                      halt
     476   00:40E3  10 FD                   djnz    INIT_F_LOOP_WAIT
     477   00:40E5                      AND_DONE:
     478   00:40E5  3E EF                   ld  a,#EF                       ; Set #EF, ESP Not Found
     479   00:40E7                          WRITE_F2                        ; on port #F2
     479   00:40E7  D3 F2             >     out (PORT_F2),a
     480   00:40E9  C9                      ret                             ; And done
     481   00:40EA                      INIT_UNAPI:
     482   00:40EA                          CLEAR_UART
     482   00:40EA  3E 14             >     ld  a,20
     482   00:40EC  D3 06             >     out (OUT_CMD_PORT),a
     483   00:40EE  3E 63                   ld  a,CMD_QUERY_ACLK_SETTINGS
     484   00:40F0                          SEND_DATA
     484   00:40F0  D3 07             >     out (OUT_TX_PORT),a
     485   00:40F2  21 3C 00                ld  hl,60                       ; Wait Up To 1s
     486   00:40F5  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
     487   00:40F9  DD 6B                   ld  ixl,e
     488   00:40FB  DD 62                   ld  ixh,d                       ; Address in IX
     489   00:40FD  CD 33 4B                call    WAIT_MENU_CMD_RESPONSE
     490   00:4100  CA 8F 41                jp  z,INIT_NOCLOCKUPDATE        ; If error, just skip
     491   00:4103                          ; Response received, IX+0 and IX+1 has Auto Clock and GMT
     492   00:4103  3E 03                   ld  a,3
     493   00:4105  DD BE 00                cp  (ix+0)
     494   00:4108  20 09                   jr  nz,INIT_UNAPI2              ; If not disabled continue on INIT_UNAPI2
     495   00:410A                          ; Disabled, ok, so let's ensure connection is not locked (just in case it was setup as disabled right now)
     496   00:410A                          CLEAR_UART
     496   00:410A  3E 14             >     ld  a,20
     496   00:410C  D3 06             >     out (OUT_CMD_PORT),a
     497   00:410E  3E 68                   ld  a,CMD_WIFIRELEASE_ESP
     498   00:4110                          SEND_DATA                       ; Just send, no need to wait response
     498   00:4110  D3 07             >     out (OUT_TX_PORT),a
     499   00:4112  C9                      ret
     500   00:4113                      INIT_UNAPI2:
     501   00:4113  3A 2D 00                ld  a,(#002D)                   ; Check MSX Version
     502   00:4116  B7                      or  a
     503   00:4117  28 76                   jr  z,INIT_NOCLOCKUPDATE        ; If zero, MSX1, can't set clock
     504   00:4119  AF                      xor a
     505   00:411A  DD B6 00                or  (ix+0)
     506   00:411D  28 70                   jr  z,INIT_NOCLOCKUPDATE        ; if turned off, skip
     507   00:411F                          ; Ok, not zero, so we are going to simply request the time, it might take up to 10s
     508   00:411F  DD 23                   inc ix
     509   00:4121  DD 23                   inc ix                          ; ok, leave IX+0 and IX+1 intact
     510   00:4123                          ; b = number of response check attempts
     511   00:4123  06 05                   ld  b,5                         ; 5 * 2s = 10s
     512   00:4125                          CLEAR_UART
     512   00:4125  3E 14             >     ld  a,20
     512   00:4127  D3 06             >     out (OUT_CMD_PORT),a
     513   00:4129  3E 47                   ld  a,CMD_GET_TIME
     514   00:412B                          SEND_DATA
     514   00:412B  D3 07             >     out (OUT_TX_PORT),a
     515   00:412D                      TRY_AGAIN:
     516   00:412D  C5                      push    bc
     517   00:412E  21 78 00                ld  hl,120                      ; Wait Up To 2s per attempt
     518   00:4131  CD 33 4B                call    WAIT_MENU_CMD_RESPONSE
     519   00:4134  20 1E                   jr  nz,INIT_CLOCKUPDATE         ; if ok, follow up
     520   00:4136  21 B5 70                ld  hl,STR_WAITING              ; Print Waiting for connection message
     521   00:4139  CD 47 4C                call    PRINTHL
     522   00:413C  3E FF                   ld  a,#ff
     523   00:413E  B8                      cp  b                           ; Was time-out the failure reason?
     524   00:413F  C1                      pop bc                          ; Restore stack ballance and retry counter
     525   00:4140  20 04                   jr  nz,STOP_TRYING              ; If error return code and not time-out, no more checks needed
     526   00:4142  3E 47                   ld  a,CMD_GET_TIME              ; Needed for retries
     527   00:4144  10 E7                   djnz    TRY_AGAIN
     528   00:4146                      STOP_TRYING:
     529   00:4146                          ; Leave a message that clock has not been updated
     530   00:4146  21 C7 6F                ld  hl,STR_CLKUPDT_FAIL
     531   00:4149  CD 47 4C                call    PRINTHL
     532   00:414C  3E F0                   ld  a,240                       ; Wait 4 seconds with message on screen
     533   00:414E                      WAIT_4S:
     534   00:414E  76                      halt
     535   00:414F  3D                      dec a
     536   00:4150                          ; If not zero, our time out has not elapsed
     537   00:4150  20 FC                   jr  nz,WAIT_4S
     538   00:4152  18 3B                   jr  INIT_NOCLOCKUPDATE          ; error, just skip to not set garbage in clock
     539   00:4154                      INIT_CLOCKUPDATE:
     540   00:4154  C1                      pop bc
     541   00:4155  DD 2B                   dec ix
     542   00:4157  DD 2B                   dec ix                          ; ix back where it should
     543   00:4159                          ; ix + 0 -> 0 If no need to set clock, 1 if set clock, 2 if set clock and request to turn Wi-Fi Off
     544   00:4159                          ; ix + 1 -> GMT setting, well, not going to use it
     545   00:4159                          ; ix + 2 -> Seconds
     546   00:4159                          ; ix + 3 -> Minutes
     547   00:4159                          ; ix + 4 -> Hours
     548   00:4159                          ; ix + 5 -> Day
     549   00:4159                          ; ix + 6 -> Month
     550   00:4159                          ; ix + 7 -> Year LSB
     551   00:4159                          ; ix + 8 -> Year MSB
     552   00:4159  DD 66 04                ld  h,(ix+4)
     553   00:415C  DD 6E 03                ld  l,(ix+3)
     554   00:415F  DD 56 02                ld  d,(ix+2)
     555   00:4162  CD F3 62                call    SET_TIME
     556   00:4165  20 28                   jr  nz,INIT_NOCLOCKUPDATE       ; if error, just skip
     557   00:4167  DD 66 08                ld  h,(ix+8)
     558   00:416A  DD 6E 07                ld  l,(ix+7)
     559   00:416D  DD 56 06                ld  d,(ix+6)
     560   00:4170  DD 5E 05                ld  e,(ix+5)
     561   00:4173  CD 20 63                call    SET_DATE
     562   00:4176  3E 02                   ld  a,2
     563   00:4178  DD BE 00                cp  (ix+0)
     564   00:417B  20 12                   jr  nz,INIT_NOCLOCKUPDATE
     565   00:417D                          ; First, release any hold to Wi-Fi Connection
     566   00:417D                          CLEAR_UART
     566   00:417D  3E 14             >     ld  a,20
     566   00:417F  D3 06             >     out (OUT_CMD_PORT),a
     567   00:4181  3E 68                   ld  a,CMD_WIFIRELEASE_ESP
     568   00:4183                          SEND_DATA                       ; Just send, no need to wait response
     568   00:4183  D3 07             >     out (OUT_TX_PORT),a
     569   00:4185                          ; And, turn off Wi-Fi Immediatelly
     570   00:4185                          CLEAR_UART
     570   00:4185  3E 14             >     ld  a,20
     570   00:4187  D3 06             >     out (OUT_CMD_PORT),a
     571   00:4189  3E 4F                   ld  a,CMD_WIFI_OFF
     572   00:418B                          SEND_DATA                       ; Just send, no need to wait response
     572   00:418B  D3 07             >     out (OUT_TX_PORT),a
     573   00:418D  18 08                   jr  INIT_NOCLOCKUPDAT2
     574   00:418F                      INIT_NOCLOCKUPDATE:
     575   00:418F                          ; Release any hold to Wi-Fi Connection
     576   00:418F                          CLEAR_UART
     576   00:418F  3E 14             >     ld  a,20
     576   00:4191  D3 06             >     out (OUT_CMD_PORT),a
     577   00:4193  3E 68                   ld  a,CMD_WIFIRELEASE_ESP
     578   00:4195                          SEND_DATA                       ; Just send, no need to wait response
     578   00:4195  D3 07             >     out (OUT_TX_PORT),a
     579   00:4197                      INIT_NOCLOCKUPDAT2:
     580   00:4197                          ; Save existing EXTBIO hook if it exists
     581   00:4197  3A 20 FB                ld  a,(HOKVLD)
     582   00:419A  CB 47                   bit 0,a
     583   00:419C  20 0B                   jr  nz,SAVE_HOOK2               ; HOKVLD tells us if there is an extended BIOS already or not, if yes, save it
     584   00:419E                          ; If here, no extended BIOS
     585   00:419E  CD 3F 60                call    GETSLT
     586   00:41A1  CD 98 60                call    GETWRK                  ; Our ROM work area address is at HL (we can use up to 8 bytes)
     587   00:41A4  3E C9                   ld  a,#c9                       ; RET, as we are the first extended BIOS
     588   00:41A6  77                      ld  (hl),a
     589   00:41A7  18 13                   jr  PATCH                       ; And now all we need to do is patch the EXTBIO hook :)
     590   00:41A9                      
     591   00:41A9                      SAVE_HOOK2:
     592   00:41A9                          ; If here, we are not the first to extend bios, so we need to save the previous one
     593   00:41A9  CD 3F 60                call    GETSLT
     594   00:41AC  CD 98 60                call    GETWRK                  ; Our ROM work area address is at HL (we can use up to 8 bytes)
     595   00:41AF  EB                      ex  de,hl                       ; It is the destination for....
     596   00:41B0  21 CA FF                ld  hl,EXTBIO                   ; The actual EXTBIO hook
     597   00:41B3  01 05 00                ld  bc,5                        ; That is 5 bytes large
     598   00:41B6  ED B0                   ldir                            ; And move to our work area
     599   00:41B8  AF                      xor a
     600   00:41B9  12                      ld  (de),a                      ; Not initialized (de is at the sixth byte) of our slot work area
     601   00:41BA  13                      inc de
     602   00:41BB  12                      ld  (de),a                      ; Not initialized (de is at the seventh byte) of our slot work area
     603   00:41BC                      
     604   00:41BC                          ; Patch EXTBIO
     605   00:41BC                      PATCH:
     606   00:41BC  3E F7                   ld  a,#F7                       ; RST #30
     607   00:41BE  32 CA FF                ld  (EXTBIO),a                  ; In EXTBIO hook
     608   00:41C1  CD 3F 60                call    GETSLT                  ; Our Slot in A
     609   00:41C4  32 CB FF                ld  (EXTBIO+1),a                ; Next EXTBIO hook byte
     610   00:41C7  21 9C 4C                ld  hl,DO_EXTBIO                ; Our EXTBIO routine address
     611   00:41CA  22 CC FF                ld  (EXTBIO+2),hl               ; Goes to the following two bytes in the hook
     612   00:41CD                      
     613   00:41CD  21 CF FF                ld  hl,EXTBIO+5                 ; Must patch DISINT and ENAINT as well
     614   00:41D0  06 0A                   ld  b,5*2
     615   00:41D2                      PATCH2:
     616   00:41D2  36 C9                   ld  (hl),#C9
     617   00:41D4  23                      inc hl
     618   00:41D5  10 FB                   djnz    PATCH2                  ; So patch all 10 bytes with return
     619   00:41D7                      
     620   00:41D7  21 20 FB                ld  hl,HOKVLD
     621   00:41DA  CB C6                   set 0,(hl)                      ; And set HOKVLD properly to indicate an EXTBIOS is installed
     622   00:41DC                      INIT_OK:
     623   00:41DC                          if  NON_VERBOSE_ROM = 0
     624   00:41DC  21 35 70                ld  hl,OK_S                     ; All done and set, nice exit message
     625   00:41DF  CD 47 4C                call    PRINTHL
     626   00:41E2                          endif
     627   00:41E2  3E F0                   ld  a,#F0                       ; Set #F0, UNAPI driver has been loaded at least once
     628   00:41E4                          WRITE_F2
     628   00:41E4  D3 F2             >     out (PORT_F2),a
     629   00:41E6  C9                      ret
     630   00:41E7                      
     631   00:41E7                      ;==============================
     632   00:41E7                      ;===  TPA Memory Allocation  ==
     633   00:41E7                      ;==============================
     634   00:41E7                      HIMEM_ALLOC:
     635   00:41E7                          ; Now let's reserve memory in the 4th page for our usage
     636   00:41E7  2A 4A FC                ld hl,(HIMEM)                   ; Get HIMEM
     637   00:41EA  B7                      or  a                           ; Clear Carry
     638   00:41EB  11 1E 00                ld  de,HIMEM_RESERVED_SIZE      ; Reserve How much memory we need
     639   00:41EE  ED 52                   sbc hl,de                       ; New HIMEM
     640   00:41F0  22 4A FC                ld  (HIMEM),hl                  ; Save it
     641   00:41F3  23                      inc hl                          ; To be safe
     642   00:41F4  EB                      ex  de,hl                       ; now in DE
     643   00:41F5  CD 3F 60                call    GETSLT
     644   00:41F8  CD AC 60                call    GETMEMPOINTERADDR       ; This is where we are going to store our memory area address
     645   00:41FB                          ; GETSLT and GETMEMPOINTER do not change DE, so it still has the our memory area address
     646   00:41FB  73                      ld  (hl),e
     647   00:41FC  23                      inc hl
     648   00:41FD  72                      ld  (hl),d                      ; And save our memory area there
     649   00:41FE                          ; Ok, DE has our memory area, let's save old H_TIMI hook there
     650   00:41FE  21 9F FD                ld  hl,H_TIMI                   ; The actual H_TIMI hook
     651   00:4201  01 05 00                ld  bc,5                        ; That is 5 bytes large
     652   00:4204  ED B0                   ldir                            ; And move to our memory area
     653   00:4206  F3                      di                              ; Turn of interrupts as we are going to patch H_TIMI
     654   00:4207                      PATCH_H_TIMI:
     655   00:4207  3E F7                   ld  a,#F7                       ; RST #30
     656   00:4209  32 9F FD                ld  (H_TIMI),a                  ; In H_TIMI hook
     657   00:420C  CD 3F 60                call    GETSLT                  ; Our Slot in A
     658   00:420F  32 A0 FD                ld  (H_TIMI+1),a                ; Next H_TIMI hook byte
     659   00:4212  21 88 4C                ld  hl,DO_HTIMI                 ; Our H_TIMI routine address
     660   00:4215  22 A1 FD                ld  (H_TIMI+2),hl               ; Goes to the following two bytes in the hook
     661   00:4218  FB                      ei                              ; done, so re-enable interrupts
     662   00:4219                      
     663   00:4219                          ; Set DNS_READY to zero
     664   00:4219  AF                      xor a
     665   00:421A  CD F1 61                call    SETDNSREADY
     666   00:421D                          ; Set TIME-OUT counter to zero
     667   00:421D  21 00 00                ld  hl,0
     668   00:4220  CD DF 60                call    SETCOUNTER
     669   00:4223  C9                      ret
     670   00:4224                      
     671   00:4224                      ;============================
     672   00:4224                      ;===  SETUP Menu Routines  ==
     673   00:4224                      ;===       Main Menu       ==
     674   00:4224                      ;============================
     675   00:4224                      ESPSETUP.EXIT:
     676   00:4224  3E 0C                   ld  a,CLS
     677   00:4226  CD A2 00                call    CHPUT
     678   00:4229  C3 EA 40                jp  INIT_UNAPI                  ; When done, resume initialization
     679   00:422C                      ENTERING_ESPSETUP:
     680   00:422C  21 51 64                ld  hl,ENTERING_WIFI_SETUP
     681   00:422F  CD 47 4C                call    PRINTHL
     682   00:4232  CD BA 63                call    PATTERN_SETUP
     683   00:4235  CD DE 49                call    WAIT_250MS_AND_THEN_CONTINUE
     684   00:4238                          ; Hold Wi-Fi Connection On
     685   00:4238                          CLEAR_UART
     685   00:4238  3E 14             >     ld  a,20
     685   00:423A  D3 06             >     out (OUT_CMD_PORT),a
     686   00:423C  3E 48                   ld  a,CMD_WIFIHOLD_ESP
     687   00:423E                          SEND_DATA
     687   00:423E  D3 07             >     out (OUT_TX_PORT),a
     688   00:4240  21 3C 00                ld  hl,60                       ; Up to 1s time-out
     689   00:4243  CD 33 4B                call    WAIT_MENU_CMD_RESPONSE  ; Wait response
     690   00:4246                          ; We do not want to error here, just in case user still need to upgrade ESP firmware
     691   00:4246                      ESPSETUP:
     692   00:4246  CD B5 62                call    RESET_ESP
     693   00:4249  B7                      or  a
     694   00:424A  C2 D3 40                jp  nz,ESP_NOT_FOUND            ; Not well, ESP was not found
     695   00:424D                          ; Well, if reset successful, continue
     696   00:424D  21 6D 64                ld  hl,WELCOME
     697   00:4250  CD 84 62                call    CHECK_ESP_TYPE
     698   00:4253  28 03                   jr  z,NOT32_2
     699   00:4255  21 B7 64                ld  hl,WELCOME32
     700   00:4258                      NOT32_2:
     701   00:4258  CD 47 4C                call    PRINTHL
     702   00:425B                          CHECK_QUICK_RECEIVE
     702   00:425B  3A 07 00          >     ld  a,(IN_STS_PORT)
     702   00:425E  CB 5F             >     bit 3,a
     703   00:4260  20 08                   jr  nz,ESPSETUP.2NF             ; If yes, tells Quick Receive support
     704   00:4262  21 21 65                ld  hl,WELCOME_SF2
     705   00:4265  CD 47 4C                call    PRINTHL                 ; Print Welcome message no QR
     706   00:4268  18 06                   jr  ESPSETUP.3NF
     707   00:426A                      ESPSETUP.2NF:
     708   00:426A  21 05 65                ld  hl,WELCOME_SF
     709   00:426D  CD 47 4C                call    PRINTHL                 ; Print Welcome message QR
     710   00:4270                      ESPSETUP.3NF:
     711   00:4270  21 41 65                ld  hl,WELCOME_CS
     712   00:4273  CD 47 4C                call    PRINTHL                 ; Print Wi-Fi is reconnecting to:
     713   00:4276                      ESPSETUP_NEXT:
     714   00:4276  CD 56 01                call    KILBUF                  ; Clear Keyboard Buffer
     715   00:4279  21 6B 65                ld  hl,WELCOME_NEXT
     716   00:427C  CD 47 4C                call    PRINTHL
     717   00:427F  21 75 65                ld  hl,WELCOME_SF_NEXT
     718   00:4282  CD 47 4C                call    PRINTHL                 ; Print Empty Welcome message
     719   00:4285  CD 1B 43                call    GET_AP_STAT
     720   00:4288  CA C0 42                jp  z,ESPSETUP_NEXT.1G          ; Won't block in case of error
     721   00:428B                          ; Success, so connection state is in IX+0, then, zero terminated string with SSID starting at IX+1
     722   00:428B  DD 7E 00                ld  a,(ix+0)
     723   00:428E  21 78 65                ld  hl,WELCOME_CS0_NEXT
     724   00:4291  FE 00                   cp  0
     725   00:4293  28 1F                   jr  z,ESPSETUP_NEXT.2F
     726   00:4295  21 A2 65                ld  hl,WELCOME_CS1_NEXT
     727   00:4298  FE 01                   cp  1
     728   00:429A  28 18                   jr  z,ESPSETUP_NEXT.2F
     729   00:429C  21 AB 65                ld  hl,WELCOME_CS2_NEXT
     730   00:429F  FE 02                   cp  2
     731   00:42A1  28 11                   jr  z,ESPSETUP_NEXT.2F
     732   00:42A3  21 D5 65                ld  hl,WELCOME_CS3_NEXT
     733   00:42A6  FE 03                   cp  3
     734   00:42A8  28 0A                   jr  z,ESPSETUP_NEXT.2F
     735   00:42AA  21 FF 65                ld  hl,WELCOME_CS4_NEXT
     736   00:42AD  FE 04                   cp  4
     737   00:42AF  28 03                   jr  z,ESPSETUP_NEXT.2F
     738   00:42B1  21 29 66                ld  hl,WELCOME_CS5_NEXT
     739   00:42B4                      ESPSETUP_NEXT.2F:
     740   00:42B4  FD 67                   ld  iyh,a                       ; Save current conn status in iyh
     741   00:42B6  CD 47 4C                call    PRINTHL                 ; Print Status
     742   00:42B9  DD E5                   push    ix
     743   00:42BB  E1                      pop hl
     744   00:42BC  23                      inc hl                          ; HL has AP Name
     745   00:42BD  CD 51 4C                call    PRINTHLINE              ; Print AP Name
     746   00:42C0                      ESPSETUP_NEXT.1G:
     747   00:42C0  21 53 66                ld  hl,MMENU_S_NEXT
     748   00:42C3  CD 47 4C                call    PRINTHL                 ; Print Main Menu
     749   00:42C6                      MM_CURSOR_BLINK:
     750   00:42C6  CD 07 43                call    MM_CURSOR_SW            ; Cursor On
     751   00:42C9                      CONN_CHG_LOOP:
     752   00:42C9  CD 9C 00                call    CHSNS
     753   00:42CC  20 13                   jr  nz,MM_WAIT_INPUT            ; If not zero, there is a key in buffer
     754   00:42CE                          ; Ok, there is not, we can check if connection status changed
     755   00:42CE  CD 1B 43                call    GET_AP_STAT
     756   00:42D1  CA C9 42                jp  z,CONN_CHG_LOOP             ; Won't block in case of error
     757   00:42D4                          ; Success, so connection state is in IX+0
     758   00:42D4  DD 7E 00                ld  a,(ix+0)
     759   00:42D7  FD BC                   cp  iyh                         ; If same, zero
     760   00:42D9  28 EE                   jr  z,CONN_CHG_LOOP             ; Keep loop
     761   00:42DB  CD 07 43                call    MM_CURSOR_SW            ; Cursor Off
     762   00:42DE  C3 76 42                jp  ESPSETUP_NEXT               ; Changed, re-build menu
     763   00:42E1                      MM_WAIT_INPUT:
     764   00:42E1  CD 9F 00                call    CHGET
     765   00:42E4  FE 1B                   cp  #1b                         ; ESC?
     766   00:42E6  CA 24 42                jp  z,ESPSETUP.EXIT             ; When done, resume initialization
     767   00:42E9  FE 31                   cp  '1'                         ; Setup Nagle?
     768   00:42EB  CA CF 48                jp  z,SET_NAGLE
     769   00:42EE  FE 32                   cp  '2'                         ; Setup Wi-Fi On Period?
     770   00:42F0  CA 09 48                jp  z,SET_WIFI_TIMEOUT
     771   00:42F3  FE 33                   cp  '3'                         ; Scan networks?
     772   00:42F5  CA 60 45                jp  z,START_WIFI_SCAN
     773   00:42F8  FE 34                   cp  '4'                         ; Automatic Setting of Clock?
     774   00:42FA  CA 82 43                jp  z,START_CLK_AUTO
     775   00:42FD  CD C0 00                call    BEEP                    ; Wrong Input, beep
     776   00:4300  CD 07 43                call    MM_CURSOR_SW            ; Cursor Off
     777   00:4303  76                      halt
     778   00:4304  C3 C6 42                jp  MM_CURSOR_BLINK             ; And return, waiting another key
     779   00:4307                      MM_CURSOR_SW:                       ; Cursor workaround for CONN_CHG_LOOP
     780   00:4307  3E 1D                   ld  a,GOLEFT
     781   00:4309  CD A2 00                call    CHPUT
     782   00:430C  3E 01                   ld  a,1
     783   00:430E  32 A9 FC                ld  (CSRSW),a
     784   00:4311  3E 20                   ld  a,' '
     785   00:4313  CD A2 00                call    CHPUT                   ; Switch the cursor display mode
     786   00:4316  AF                      xor a
     787   00:4317  32 A9 FC                ld  (CSRSW),a
     788   00:431A  C9                      ret
     789   00:431B                      GET_AP_STAT:                        ; Use 'call GET_AP_STAT'
     790   00:431B                          CLEAR_UART
     790   00:431B  3E 14             >     ld  a,20
     790   00:431D  D3 06             >     out (OUT_CMD_PORT),a
     791   00:431F  3E 67                   ld  a,CMD_AP_STS
     792   00:4321                          SEND_DATA                       ; Get AP conn status and name
     792   00:4321  D3 07             >     out (OUT_TX_PORT),a
     793   00:4323  21 3C 00                ld  hl,60                       ; Wait Up To 1s
     794   00:4326  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
     795   00:432A  DD 6B                   ld  ixl,e
     796   00:432C  DD 62                   ld  ixh,d                       ; Address in IX
     797   00:432E  C3 33 4B                jp  WAIT_MENU_CMD_RESPONSE
     798   00:4331                      
     799   00:4331                      ;============================
     800   00:4331                      ;===  SETUP Menu Routines  ==
     801   00:4331                      ;===  Wi-Fi and Clock Menu ==
     802   00:4331                      ;============================
     803   00:4331                      CLK_MSX1_GO:
     804   00:4331  21 42 68                ld  hl,MMENU_CLOCK_MSX1
     805   00:4334  CD 47 4C                call    PRINTHL                 ; Print Main Clock MSX1 message
     806   00:4337  CD E5 49                call    ISCLKAUTO
     807   00:433A  DD 7E 00                ld  a,(ix+0)                    ; Auto Clock Current setting
     808   00:433D  FE 03                   cp  3                           ; If 3 adapter disabled
     809   00:433F  28 08                   jr  z,CLK_MSX1_ADAPTERDIS
     810   00:4341  21 D6 68                ld  hl,MMENU_CLOCK_0
     811   00:4344  CD 47 4C                call    PRINTHL
     812   00:4347  18 06                   jr  CLK_MSX1_OPT
     813   00:4349                      CLK_MSX1_ADAPTERDIS:
     814   00:4349  21 1C 69                ld  hl,MMENU_CLOCK_3
     815   00:434C  CD 47 4C                call    PRINTHL
     816   00:434F                      CLK_MSX1_OPT:
     817   00:434F  21 2F 69                ld  hl,MMENU_CLOCK_OPT
     818   00:4352  CD 47 4C                call    PRINTHL
     819   00:4355                      CLK_MSX1_WAIT_OPT_INPUT:
     820   00:4355  CD 9F 00                call    CHGET
     821   00:4358  FE 1B                   cp  #1b                         ; ESC?
     822   00:435A  CA 46 42                jp  z,ESPSETUP                  ; Back to main menu
     823   00:435D  FE 30                   cp  '0'
     824   00:435F  CA 6D 43                jp  z,CLK_MSX1_SEND_CMD
     825   00:4362  FE 33                   cp  '3'
     826   00:4364  CA 29 44                jp  z,CLK_AUTO_WAIT_GMT
     827   00:4367  CD C0 00                call    BEEP                    ; Wrong Input, beep
     828   00:436A  C3 55 43                jp  CLK_MSX1_WAIT_OPT_INPUT     ; And return, waiting another key
     829   00:436D                      CLK_MSX1_SEND_CMD:
     830   00:436D  CD A2 00                call    CHPUT                   ; Print option
     831   00:4370  D6 30                   sub '0'                         ; Adjust format
     832   00:4372  DD 77 00                ld  (ix+0),a                    ; Save it
     833   00:4375  3E 0D                   ld  a,#0d
     834   00:4377  CD A2 00                call    CHPUT
     835   00:437A  3E 0A                   ld  a,#0a
     836   00:437C  CD A2 00                call    CHPUT
     837   00:437F  C3 20 45                jp  CLK_AUTO_GMT_CHK_DONE       ; And sending the command will be done there
     838   00:4382                      
     839   00:4382                      START_CLK_AUTO:
     840   00:4382  3E 34                   ld  a,'4'
     841   00:4384  CD A2 00                call    CHPUT
     842   00:4387  CD DE 49                call    WAIT_250MS_AND_THEN_CONTINUE
     843   00:438A  3A 2D 00                ld  a,(#002D)                   ; Check MSX Version
     844   00:438D  B7                      or  a
     845   00:438E  CA 31 43                jp  z,CLK_MSX1_GO               ; If zero, MSX1, so can just enable or disable adapter
     846   00:4391                      CLK_AUTO_GO:
     847   00:4391  21 E2 66                ld  hl,MMENU_CLOCK_MSX2
     848   00:4394  CD 47 4C                call    PRINTHL                 ; Print Main Clock MSX2 message
     849   00:4397  CD E5 49                call    ISCLKAUTO
     850   00:439A  DD 7E 00                ld  a,(ix+0)                    ; Auto Clock Current setting
     851   00:439D  B7                      or  a                           ; If zero, off
     852   00:439E  20 08                   jr  nz,CLK_AUTO_CHK1
     853   00:43A0  21 D6 68                ld  hl,MMENU_CLOCK_0
     854   00:43A3  CD 47 4C                call    PRINTHL
     855   00:43A6  18 59                   jr  CLK_AUTO_GMT_OPT
     856   00:43A8                      CLK_AUTO_CHK1:
     857   00:43A8  3D                      dec a                           ; If 1, on and keep wifi on
     858   00:43A9  20 08                   jr  nz,CLK_AUTO_CHK2
     859   00:43AB  21 E8 68                ld  hl,MMENU_CLOCK_1
     860   00:43AE  CD 47 4C                call    PRINTHL
     861   00:43B1  18 13                   jr  CLK_AUTO_GMT
     862   00:43B3                      CLK_AUTO_CHK2:
     863   00:43B3  3D                      dec a                           ; If 2, on and turn wifi off
     864   00:43B4  20 08                   jr  nz,CLK_AUTO_3
     865   00:43B6  21 02 69                ld  hl,MMENU_CLOCK_2
     866   00:43B9  CD 47 4C                call    PRINTHL
     867   00:43BC  18 08                   jr  CLK_AUTO_GMT
     868   00:43BE                      CLK_AUTO_3:
     869   00:43BE  21 1C 69                ld  hl,MMENU_CLOCK_3
     870   00:43C1  CD 47 4C                call    PRINTHL
     871   00:43C4  18 3B                   jr  CLK_AUTO_GMT_OPT
     872   00:43C6                      CLK_AUTO_GMT:
     873   00:43C6  DD 66 01                ld  h,(ix+1)                    ; Save it for now
     874   00:43C9  DD 7E 01                ld  a,(ix+1)                    ; GMT current setting
     875   00:43CC  CB 7F                   bit 7,a                         ; If set, is -
     876   00:43CE  28 0B                   jr  z,CLK_AUTO_GMTP
     877   00:43D0  3E 2D                   ld  a,'-'
     878   00:43D2  CD A2 00                call    CHPUT
     879   00:43D5  DD CB 01 BE             res 7,(ix+1)                    ; Clear - indicator
     880   00:43D9  18 05                   jr  CLK_AUTO_GMTM
     881   00:43DB                      CLK_AUTO_GMTP:
     882   00:43DB  3E 2B                   ld  a,'+'
     883   00:43DD  CD A2 00                call    CHPUT
     884   00:43E0                      CLK_AUTO_GMTM:
     885   00:43E0  3E 09                   ld  a,9
     886   00:43E2  DD BE 01                cp  (ix+1)                      ; Greater than 9?
     887   00:43E5  30 0F                   jr  nc,CLK_AUTO_GMTD            ; If not, just print what is in A + '0'
     888   00:43E7  3E 31                   ld  a,'1'                       ; It is 1
     889   00:43E9  CD A2 00                call    CHPUT
     890   00:43EC  DD 7E 01                ld  a,(ix+1)
     891   00:43EF  C6 26                   add '0'-10                      ; Need to subtract 10 and add '0' to print
     892   00:43F1  CD A2 00                call    CHPUT
     893   00:43F4  18 0B                   jr  CLK_AUTO_GMT_OPT
     894   00:43F6                      CLK_AUTO_GMTD:
     895   00:43F6  3E 30                   ld  a,'0'
     896   00:43F8  DD 86 01                add a,(ix+1)                    ; Our value
     897   00:43FB  CD A2 00                call    CHPUT
     898   00:43FE  DD 74 01                ld  (ix+1),h                    ; Restore original value
     899   00:4401                      CLK_AUTO_GMT_OPT:
     900   00:4401  21 2F 69                ld  hl,MMENU_CLOCK_OPT
     901   00:4404  CD 47 4C                call    PRINTHL
     902   00:4407                      CLK_AUTO_WAIT_OPT_INPUT:
     903   00:4407  CD 9F 00                call    CHGET
     904   00:440A  FE 1B                   cp  #1b                         ; ESC?
     905   00:440C  CA 46 42                jp  z,ESPSETUP                  ; Back to main menu
     906   00:440F  FE 30                   cp  '0'
     907   00:4411  CA 29 44                jp  z,CLK_AUTO_WAIT_GMT
     908   00:4414  FE 31                   cp  '1'
     909   00:4416  CA 29 44                jp  z,CLK_AUTO_WAIT_GMT
     910   00:4419  FE 32                   cp  '2'
     911   00:441B  CA 29 44                jp  z,CLK_AUTO_WAIT_GMT
     912   00:441E  FE 33                   cp  '3'
     913   00:4420  CA 29 44                jp  z,CLK_AUTO_WAIT_GMT
     914   00:4423  CD C0 00                call    BEEP                    ; Wrong Input, beep
     915   00:4426  C3 07 44                jp  CLK_AUTO_WAIT_OPT_INPUT     ; And return, waiting another key
     916   00:4429                      CLK_AUTO_WAIT_GMT:
     917   00:4429  CD A2 00                call    CHPUT                   ; Print option
     918   00:442C  D6 30                   sub '0'                         ; Adjust format
     919   00:442E  DD 77 00                ld  (ix+0),a                    ; Save it
     920   00:4431  B7                      or  a
     921   00:4432  CA 20 45                jp  z,CLK_AUTO_GMT_CHK_DONE     ; And send the command if just disabling clock auto set
     922   00:4435  FE 03                   cp  3
     923   00:4437  CA 20 45                jp  z,CLK_AUTO_GMT_CHK_DONE     ; Or send the command if just disabling the adapter
     924   00:443A  21 59 69                ld  hl,MMENU_GMT_OPT
     925   00:443D  CD 47 4C                call    PRINTHL
     926   00:4440  16 00                   ld  d,0                         ; # of digits entered
     927   00:4442  1E 00                   ld  e,0                         ; # of characters printed
     928   00:4444  DD 36 01 00             ld  (ix+1),0                    ; GMT 0
     929   00:4448                      CLK_AUTO_WAIT_GMT_INPUT:
     930   00:4448  CD 9F 00                call    CHGET
     931   00:444B  FE 1B                   cp  #1b                         ; ESC?
     932   00:444D  CA 46 42                jp  z,ESPSETUP                  ; Back to main menu
     933   00:4450  FE 0D                   cp  #0d                         ; ENTER?
     934   00:4452  CA 9B 44                jp  z,CLK_AUTO_GMT_CHK_INPUT    ; Check if ok to send command
     935   00:4455  FE 08                   cp  #08                         ; Backspace?
     936   00:4457  CA 6C 44                jp  z,CLK_AUTO_GMT_CHK_BS       ; Check if there is something to erase
     937   00:445A  FE 2D                   cp  '-'                         ; Negative value?
     938   00:445C  CA 9B 44                jp  z,CLK_AUTO_GMT_CHK_INPUT
     939   00:445F  FE 30                   cp  '0'                         ; >=0?
     940   00:4461  DA 8D 44                jp  c,CLK_AUTO_GMT_BAD_INPUT    ; If not, bad input
     941   00:4464  FE 3A                   cp  '9'+1                       ; <= 9
     942   00:4466  D2 8D 44                jp  nc,CLK_AUTO_GMT_BAD_INPUT   ; If not, bad input
     943   00:4469  C3 9B 44                jp  CLK_AUTO_GMT_CHK_INPUT      ; Otherwise, validate digit
     944   00:446C                      CLK_AUTO_GMT_CHK_BS:
     945   00:446C  AF                      xor a
     946   00:446D  BB                      cp  e                           ; Anything on screen?
     947   00:446E  28 1D                   jr  z,CLK_AUTO_GMT_BAD_INPUT    ; Nothing to erase
     948   00:4470  1D                      dec e                           ; One less character on the screen
     949   00:4471  BA                      cp  d                           ; Any digit?
     950   00:4472  28 03                   jr  z,CLK_AUTO_GMT_CHK_BS_MIN   ; If not, just erase - sign
     951   00:4474                          ; There is, so it is one less digit
     952   00:4474  15                      dec d
     953   00:4475  18 04                   jr  CLK_AUTO_GMT_CHK_DIGIT
     954   00:4477                      CLK_AUTO_GMT_CHK_BS_MIN:
     955   00:4477  DD 36 01 00             ld  (ix+1),0                    ; Reset sign
     956   00:447B                      CLK_AUTO_GMT_CHK_DIGIT:
     957   00:447B  3E 08                   ld  a,8                         ; Backspace
     958   00:447D  CD A2 00                call    CHPUT                   ; Print it
     959   00:4480  3E 20                   ld  a,' '                       ; Space
     960   00:4482  CD A2 00                call    CHPUT                   ; Print it
     961   00:4485  3E 08                   ld  a,8                         ; Backspace
     962   00:4487  CD A2 00                call    CHPUT                   ; Print it
     963   00:448A  C3 48 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; Return
     964   00:448D                      CLK_AUTO_GMT_BAD_INPUT:
     965   00:448D                          ; Beep might use sub rom, and if so, all registers will be messed up, better save
     966   00:448D  C5                      push    bc
     967   00:448E  D5                      push    de
     968   00:448F  F5                      push    af
     969   00:4490  E5                      push    hl
     970   00:4491  CD C0 00                call    BEEP                    ; Wrong Input, beep
     971   00:4494  E1                      pop hl
     972   00:4495  F1                      pop af
     973   00:4496  D1                      pop de
     974   00:4497  C1                      pop bc
     975   00:4498  C3 48 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; And return, waiting another key
     976   00:449B                      CLK_AUTO_GMT_CHK_INPUT:
     977   00:449B  4F                      ld  c,a                         ; Save in C for printing if needed
     978   00:449C  FE 2D                   cp  '-'                         ; - sign?
     979   00:449E  20 11                   jr  nz,CLK_AUTO_GMT_CHK_CR      ; If not, check if enter
     980   00:44A0                          ; - sign
     981   00:44A0  3E 00                   ld  a,0
     982   00:44A2  BB                      cp  e                           ; If not the first character, can't accept
     983   00:44A3  20 E8                   jr  nz,CLK_AUTO_GMT_BAD_INPUT
     984   00:44A5                          ; It is the first, so let's print it
     985   00:44A5  79                      ld  a,c
     986   00:44A6  CD A2 00                call    CHPUT
     987   00:44A9  DD 36 01 80             ld  (ix+1),0x80                 ; Set the - sign bit, for now rest is zero
     988   00:44AD  1C                      inc e                           ; Increase # of characters printed
     989   00:44AE  C3 48 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; Continue waiting input
     990   00:44B1                      CLK_AUTO_GMT_CHK_CR:
     991   00:44B1  FE 0D                   cp  #0d                         ; ENTER?
     992   00:44B3  20 0F                   jr  nz,CLK_AUTO_GMT_CHK_CD      ; If not, check if digit is valid
     993   00:44B5                          ; Enter
     994   00:44B5  3E 00                   ld  a,0
     995   00:44B7  BA                      cp  d                           ; Ok, at least one digit entered?
     996   00:44B8  28 D3                   jr  z,CLK_AUTO_GMT_BAD_INPUT    ; No, so, enter is no good now
     997   00:44BA                          ; It is, if it had a digit entered and did not send, it was 1, so...
     998   00:44BA  3E 01                   ld  a,1
     999   00:44BC  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1000   00:44BF  DD 77 01                ld  (ix+1),a                    ; Save
    1001   00:44C2  18 5C                   jr  CLK_AUTO_GMT_CHK_DONE       ; Ok, ready to send
    1002   00:44C4                      CLK_AUTO_GMT_CHK_CD:
    1003   00:44C4                          ; Ok, it is a digit
    1004   00:44C4  06 30                   ld  b,'0'
    1005   00:44C6  90                      sub a,b                         ; A has digit value
    1006   00:44C7  47                      ld  b,a                         ; Save in B
    1007   00:44C8  3E 00                   ld  a,0
    1008   00:44CA  BA                      cp  d
    1009   00:44CB  20 1E                   jr  nz,CLK_AUTO_GMT_CHK_CSD     ; If not zero, it is second digit, so almost done
    1010   00:44CD                          ; 1st digit, let's check if it is other than 1, if it is, we are almost done
    1011   00:44CD  3E 01                   ld  a,1
    1012   00:44CF  B8                      cp  b
    1013   00:44D0  28 10                   jr  z,CLK_AUTO_GMT_CHK_CD.1     ; If it is 1, wait next digit or enter
    1014   00:44D2                          ; Not 1, so just adjust ix+1 and go
    1015   00:44D2  79                      ld  a,c
    1016   00:44D3  CD A2 00                call    CHPUT                   ; Print it
    1017   00:44D6  78                      ld  a,b
    1018   00:44D7  B7                      or  a
    1019   00:44D8  28 03                   jr  z,CLK_AUTO_SKIP_SIGN
    1020   00:44DA  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1021   00:44DD                      CLK_AUTO_SKIP_SIGN:
    1022   00:44DD  DD 77 01                ld  (ix+1),a                    ; Save
    1023   00:44E0  18 3E                   jr  CLK_AUTO_GMT_CHK_DONE       ; Ok, ready to send
    1024   00:44E2                      CLK_AUTO_GMT_CHK_CD.1:
    1025   00:44E2  79                      ld  a,c
    1026   00:44E3  CD A2 00                call    CHPUT                   ; Print it
    1027   00:44E6  14                      inc d                           ; Digits entered now is 1
    1028   00:44E7  1C                      inc e                           ; Digits printed increased
    1029   00:44E8  C3 48 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; Continue waiting input
    1030   00:44EB                      CLK_AUTO_GMT_CHK_CSD:
    1031   00:44EB                          ; Second digit, easy... First was 1, now need to check if it is 0, 1 or 2, otherwise, bad entry
    1032   00:44EB  78                      ld  a,b
    1033   00:44EC  06 03                   ld  b,3
    1034   00:44EE  B8                      cp  b
    1035   00:44EF  D2 8D 44                jp  nc,CLK_AUTO_GMT_BAD_INPUT   ; 3 or more, so, not valid
    1036   00:44F2  B7                      or  a                           ; Is it zero?
    1037   00:44F3  20 0E                   jr  nz,CLK_AUTO_GMT_CHK_CSD1    ; If not, check for 1
    1038   00:44F5                          ; It was zero
    1039   00:44F5  3E 0A                   ld  a,10                        ; So, 10
    1040   00:44F7  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1041   00:44FA  DD 77 01                ld  (ix+1),a                    ; Save
    1042   00:44FD  79                      ld  a,c
    1043   00:44FE  CD A2 00                call    CHPUT                   ; Print it
    1044   00:4501  18 1D                   jr  CLK_AUTO_GMT_CHK_DONE       ; Ready to
    1045   00:4503                      CLK_AUTO_GMT_CHK_CSD1:
    1046   00:4503  3D                      dec a                           ; Is it one?
    1047   00:4504  20 0E                   jr  nz,CLK_AUTO_GMT_CHK_CSD2
    1048   00:4506                          ; It was one
    1049   00:4506  3E 0B                   ld  a,11                        ; So, eleven
    1050   00:4508  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1051   00:450B  DD 77 01                ld  (ix+1),a                    ; Save
    1052   00:450E  79                      ld  a,c
    1053   00:450F  CD A2 00                call    CHPUT                   ; Print it
    1054   00:4512  18 0C                   jr  CLK_AUTO_GMT_CHK_DONE       ; Ready to send
    1055   00:4514                      CLK_AUTO_GMT_CHK_CSD2:
    1056   00:4514                          ; It was two
    1057   00:4514  3E 0C                   ld  a,12                        ; So, twelve
    1058   00:4516  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1059   00:4519  DD 77 01                ld  (ix+1),a                    ; Save
    1060   00:451C  79                      ld  a,c
    1061   00:451D  CD A2 00                call    CHPUT                   ; Print it
    1062   00:4520                          ; And send command
    1063   00:4520                      CLK_AUTO_GMT_CHK_DONE:
    1064   00:4520  3E 0D                   ld  a,#0d
    1065   00:4522  CD A2 00                call    CHPUT
    1066   00:4525  3E 0A                   ld  a,#0a
    1067   00:4527  CD A2 00                call    CHPUT
    1068   00:452A  21 1A 6F                ld  hl,STR_SENDING
    1069   00:452D  CD 47 4C                call    PRINTHL
    1070   00:4530                          CLEAR_UART
    1070   00:4530  3E 14             >     ld  a,20
    1070   00:4532  D3 06             >     out (OUT_CMD_PORT),a
    1071   00:4534  3E 43                   ld  a,CMD_SET_ACLK_SETTINGS
    1072   00:4536                          SEND_DATA
    1072   00:4536  D3 07             >     out (OUT_TX_PORT),a
    1073   00:4538  3E 00                   ld  a,0                         ; Size MSB is 0
    1074   00:453A                          SEND_DATA
    1074   00:453A  D3 07             >     out (OUT_TX_PORT),a
    1075   00:453C  3E 02                   ld  a,2                         ; Size LSB is 2
    1076   00:453E                          SEND_DATA
    1076   00:453E  D3 07             >     out (OUT_TX_PORT),a
    1077   00:4540  DD 7E 00                ld  a,(ix+0)                    ; Option
    1078   00:4543                          SEND_DATA
    1078   00:4543  D3 07             >     out (OUT_TX_PORT),a
    1079   00:4545  DD 7E 01                ld  a,(ix+1)                    ; GMT
    1080   00:4548                          SEND_DATA
    1080   00:4548  D3 07             >     out (OUT_TX_PORT),a
    1081   00:454A  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1082   00:454D  3E 43                   ld  a,CMD_SET_ACLK_SETTINGS
    1083   00:454F  CD FA 4A                call    WAIT_MENU_QCMD_RESPONSE
    1084   00:4552  21 35 6F                ld  hl,STR_SENDING_OK
    1085   00:4555  20 03                   jr  nz,CLK_AUTO_GMT_CHK_RESULT
    1086   00:4557  21 B2 6F                ld  hl,STR_SENDING_FAIL
    1087   00:455A                      CLK_AUTO_GMT_CHK_RESULT:
    1088   00:455A  CD 47 4C                call    PRINTHL
    1089   00:455D  C3 D6 49                jp  WAIT_2S_AND_THEN_MAINMENU
    1090   00:4560                      
    1091   00:4560                      ;============================
    1092   00:4560                      ;===  SETUP Menu Routines  ==
    1093   00:4560                      ;===    Wi-Fi Scan Menu    ==
    1094   00:4560                      ;============================
    1095   00:4560                      START_WIFI_SCAN:
    1096   00:4560  3E 33                   ld  a,'3'
    1097   00:4562  CD A2 00                call    CHPUT
    1098   00:4565  CD DE 49                call    WAIT_250MS_AND_THEN_CONTINUE
    1099   00:4568                      START_WIFI_RESCAN:
    1100   00:4568  21 EE 69                ld  hl,MMENU_SCAN
    1101   00:456B  CD 47 4C                call    PRINTHL                 ; Print Main Scan message
    1102   00:456E  CD 87 49                call    STARTWIFISCAN           ; Request Wi-Fi Scan to start
    1103   00:4571  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1104   00:4575  DD 6B                   ld  ixl,e
    1105   00:4577  DD 62                   ld  ixh,d                       ; Address in IX
    1106   00:4579  11 14 00                ld  de,20                       ; At least 10s waiting scan to finish, retry 20 times waiting 0.5s between attempts
    1107   00:457C                      WIFI_SCAN_WAIT_END:
    1108   00:457C                          CLEAR_UART
    1108   00:457C  3E 14             >     ld  a,20
    1108   00:457E  D3 06             >     out (OUT_CMD_PORT),a
    1109   00:4580  3E 73                   ld  a,CMD_SCAN_RESULTS
    1110   00:4582                          SEND_DATA
    1110   00:4582  D3 07             >     out (OUT_TX_PORT),a
    1111   00:4584  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1112   00:4587  CD BA 4B                call    WAIT_MENU_SCMD_RESPONSE
    1113   00:458A  C2 A2 45                jp  nz,WIFI_SCAN_SHOW_LIST      ; if success show the list
    1114   00:458D  78                      ld  a,b
    1115   00:458E  FE 02                   cp  2                           ; If 2, scan is done and nothing found
    1116   00:4590  CA F7 47                jp  z,WIFI_SCAN_NONETWORKS
    1117   00:4593  2E 1E                   ld  l,30
    1118   00:4595                      WIFI_SCAN_WAITHS:
    1119   00:4595  76                      halt
    1120   00:4596  2D                      dec l
    1121   00:4597  20 FC                   jr  nz,WIFI_SCAN_WAITHS
    1122   00:4599  1B                      dec de
    1123   00:459A  7B                      ld  a,e
    1124   00:459B  B2                      or  d
    1125   00:459C  CA 00 48                jp  z,WIFI_SCAN_TIMEOUT
    1126   00:459F  C3 7C 45                jp  WIFI_SCAN_WAIT_END
    1127   00:45A2                      WIFI_SCAN_SHOW_LIST:
    1128   00:45A2  57                      ld  d,a                         ; Save access point counter here
    1129   00:45A3  1E 00                   ld  e,0                         ; And here how many were printed
    1130   00:45A5  21 73 6A                ld  hl,MMENU_SCANS
    1131   00:45A8  CD 47 4C                call    PRINTHL
    1132   00:45AB  DD E5                   push    ix
    1133   00:45AD  E1                      pop hl                          ; IX in HL
    1134   00:45AE                      WIFI_LIST_LOOP:
    1135   00:45AE  7B                      ld  a,e
    1136   00:45AF  C6 30                   add a,'0'                       ; Convert to number
    1137   00:45B1  CD A2 00                call    CHPUT
    1138   00:45B4  3E 20                   ld  a,' '                       ; Space
    1139   00:45B6  CD A2 00                call    CHPUT
    1140   00:45B9  3E 2D                   ld  a,'-'                       ; Dash
    1141   00:45BB  CD A2 00                call    CHPUT
    1142   00:45BE  3E 20                   ld  a,' '                       ; Space
    1143   00:45C0  CD A2 00                call    CHPUT
    1144   00:45C3  06 18                   ld  b,24                        ; Cuts AP names > 23 chars
    1145   00:45C5                      PRT_APNAMELP:
    1146   00:45C5  7E                      ld  a,(hl)
    1147   00:45C6  B7                      or  a
    1148   00:45C7  CA E1 45                jp  z,PRT_APENC
    1149   00:45CA  CD A2 00                call    CHPUT
    1150   00:45CD  23                      inc hl
    1151   00:45CE  10 F5                   djnz    PRT_APNAMELP
    1152   00:45D0  E5                      push    hl
    1153   00:45D1  21 0A 6C                ld  hl,SCAN_TERMINATOR_CUT
    1154   00:45D4  CD 47 4C                call    PRINTHL
    1155   00:45D7  E1                      pop hl
    1156   00:45D8                      PRT_APNAMELP_CUT:
    1157   00:45D8  7E                      ld  a,(hl)
    1158   00:45D9  B7                      or  a
    1159   00:45DA  CA E1 45                jp  z,PRT_APENC
    1160   00:45DD  23                      inc hl
    1161   00:45DE  C3 D8 45                jp  PRT_APNAMELP_CUT
    1162   00:45E1                      PRT_APENC:
    1163   00:45E1  23                      inc hl
    1164   00:45E2  7E                      ld  a,(hl)
    1165   00:45E3  B7                      or  a
    1166   00:45E4  CA F2 45                jp  z,PRT_APNOTENC
    1167   00:45E7  E5                      push    hl
    1168   00:45E8  21 18 6C                ld  hl,SCAN_TERMINATOR_ENC
    1169   00:45EB  CD 47 4C                call    PRINTHL
    1170   00:45EE  E1                      pop hl
    1171   00:45EF  C3 FA 45                jp  PRT_AP_CHKLOOP
    1172   00:45F2                      PRT_APNOTENC:
    1173   00:45F2  E5                      push    hl
    1174   00:45F3  21 11 6C                ld  hl,SCAN_TERMINATOR_OPEN
    1175   00:45F6  CD 47 4C                call    PRINTHL
    1176   00:45F9  E1                      pop hl
    1177   00:45FA                      PRT_AP_CHKLOOP:
    1178   00:45FA  23                      inc hl
    1179   00:45FB  1C                      inc e
    1180   00:45FC  3E 08                   ld  a,SCAN_MAX_PAGE_SIZE
    1181   00:45FE  BB                      cp  e
    1182   00:45FF  CA 0A 46                jp  z,APLIST_OVERFLOW
    1183   00:4602  15                      dec d
    1184   00:4603  C2 AE 45                jp  nz,WIFI_LIST_LOOP
    1185   00:4606  06 00                   ld  b,0                         ; Signal no more list data
    1186   00:4608  18 10                   jr  APLIST_NO_OVERFLOW
    1187   00:460A                      APLIST_OVERFLOW:
    1188   00:460A  15                      dec d                           ; Update remaining items
    1189   00:460B  AF                      xor a
    1190   00:460C  B2                      or  d                           ; Still has items?
    1191   00:460D  28 0B                   jr  z,APLIST_NO_OVERFLOW        ; No more items
    1192   00:460F  06 01                   ld  b,1                         ; Signal that there still is data pending to list in another page
    1193   00:4611  E5                      push    hl
    1194   00:4612  FD E1                   pop iy                          ; Save in IY the address to continue from
    1195   00:4614  4A                      ld  c,d                         ; And C has the remaining AP count
    1196   00:4615  21 9B 6B                ld  hl,MMENU_SCANQM
    1197   00:4618  18 03                   jr  APLIST_NOFLW
    1198   00:461A                      APLIST_NO_OVERFLOW:
    1199   00:461A                          ; If here, current page has been printed
    1200   00:461A                          ; E has the maximum allowable AP number
    1201   00:461A                          ; B will indicate if there are more items for a next page
    1202   00:461A                          ; IY will hold the address of the following items
    1203   00:461A                          ; Let's ask which one to connect
    1204   00:461A  21 30 6B                ld  hl,MMENU_SCANQ
    1205   00:461D                      APLIST_NOFLW:
    1206   00:461D  CD 47 4C                call    PRINTHL                 ; Show message asking which network to connect
    1207   00:4620  3E 30                   ld  a,'0'
    1208   00:4622  83                      add a,e
    1209   00:4623  5F                      ld  e,a                         ; To make it easy in the selection screen
    1210   00:4624                      WIFI_SELECT_AP:
    1211   00:4624  CD 9F 00                call    CHGET
    1212   00:4627  FE 1B                   cp  #1b                         ; ESC?
    1213   00:4629  CA 46 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1214   00:462C  FE 20                   cp  #20                         ; Spacebar?
    1215   00:462E  CA 42 46                jp  z,WIFI_SELECT_SPACEBAR      ; Check if re-scan or next page
    1216   00:4631  FE 0D                   cp  CR                          ; ENTER?
    1217   00:4633  CA 4F 46                jp  z,WIFI_CONNECT_ME_CHOOSEN   ; Request AP Name and Password if needed
    1218   00:4636  FE 30                   cp  '0'                         ; Check if A is less than 0
    1219   00:4638  DA E1 47                jp  c,INPUT_WFSAP_BAD_INPUT     ; If it is, ignore
    1220   00:463B  BB                      cp  e                           ; Check if a is greater than what is in E
    1221   00:463C  D2 E1 47                jp  nc,INPUT_WFSAP_BAD_INPUT    ; If it is, ignore
    1222   00:463F  C3 D9 46                jp  WIFI_CONNECT_SELECTION_OK   ; Selection Ok if here
    1223   00:4642                      
    1224   00:4642                      WIFI_SELECT_SPACEBAR:
    1225   00:4642  AF                      xor a
    1226   00:4643  B2                      or  d                           ; D = AP counter
    1227   00:4644  CA 68 45                jp  z,START_WIFI_RESCAN         ; Rescan if no more items
    1228   00:4647                          ; Otherwise, more items, start at IY
    1229   00:4647  FD E5                   push    iy
    1230   00:4649  DD E1                   pop ix                          ; Restore the list from where we finished last time
    1231   00:464B  79                      ld  a,c                         ; Restore the remaining APs to list
    1232   00:464C  C3 A2 45                jp  WIFI_SCAN_SHOW_LIST         ; And show
    1233   00:464F                      
    1234   00:464F                      WIFI_CONNECT_ME_CHOOSEN:
    1235   00:464F  21 72 69                ld  hl,MMENU_MANUALENTRY
    1236   00:4652  CD 47 4C                call    PRINTHL                 ; Show message asking AP details....
    1237   00:4655                          ; IX has the AP list, we don't care, but that address is ours to use to handle SSID Entry
    1238   00:4655  DD E5                   push    ix
    1239   00:4657  E1                      pop hl                          ; HL has the address
    1240   00:4658  0E 00                   ld  c,0                         ; AP name size
    1241   00:465A                      WIFI_CONNECT_MANUAL_ENTRY:
    1242   00:465A  CD 9F 00                call    CHGET
    1243   00:465D  FE 1B                   cp  #1b                         ; ESC?
    1244   00:465F  CA 46 42                jp  z,ESPSETUP                  ; Back to main setup
    1245   00:4662  FE 08                   cp  #08                         ; Backspace?
    1246   00:4664  28 55                   jr  z,WIFI_CONNECT_ME_BS        ; Check if there is something to erase
    1247   00:4666  FE 0D                   cp  #0d                         ; ENTER?
    1248   00:4668  28 68                   jr  z,WIFI_ME_CHECK_INPUT       ; Check if ok
    1249   00:466A                          ; Otherwise it is a digit
    1250   00:466A  77                      ld  (hl),a
    1251   00:466B  79                      ld  a,c
    1252   00:466C  D6 20                   sub 32                          ; SSID maximum is 32 characters
    1253   00:466E  28 EA                   jr  z,WIFI_CONNECT_MANUAL_ENTRY
    1254   00:4670  7E                      ld  a,(hl)
    1255   00:4671  0C                      inc c
    1256   00:4672  23                      inc hl
    1257   00:4673  FE 20                   cp  32
    1258   00:4675  30 04                   jr  nc,WIFI_CONNECT_ME_CHKPRT2  ; Ok, not below space, but is it delete?
    1259   00:4677  3E 3F                   ld  a,'?'                       ; Prints a question mark
    1260   00:4679  18 06                   jr  WIFI_CONNECT_ME_CHKPRTD
    1261   00:467B                      WIFI_CONNECT_ME_CHKPRT2:
    1262   00:467B  FE 7F                   cp  #7f
    1263   00:467D  20 02                   jr  nz,WIFI_CONNECT_ME_CHKPRTD
    1264   00:467F  3E 3F                   ld  a,'?'                       ; Prints a question mark if it is delete
    1265   00:4681                      WIFI_CONNECT_ME_CHKPRTD:
    1266   00:4681  CD A2 00                call    CHPUT                   ; Print a char
    1267   00:4684  C3 5A 46                jp  WIFI_CONNECT_MANUAL_ENTRY
    1268   00:4687                      WIFI_CONNECT_ME_0_TERM:
    1269   00:4687  AF                      xor a
    1270   00:4688  77                      ld  (hl),a
    1271   00:4689  23                      inc hl
    1272   00:468A  E5                      push    hl                      ; Save it
    1273   00:468B  21 D3 69                ld  hl,MENU_MANUALENTRY_PWD
    1274   00:468E  CD 47 4C                call    PRINTHL                 ; We are asking if password is needed
    1275   00:4691  E1                      pop hl                          ; Restore it
    1276   00:4692  CD 9F 00                call    CHGET                   ; Get key, if Y or y, needed, otherwise not
    1277   00:4695  CB AF                   res 5,a                         ; Force upper case
    1278   00:4697  FE 59                   cp  'Y'
    1279   00:4699  28 08                   jr  z,WIFI_CONNECT_ME_PWD_Y     ; And tell using encryption
    1280   00:469B  3E 6E                   ld  a,'n'
    1281   00:469D  CD A2 00                call    CHPUT                   ; Overwrite what was typed with 'n'
    1282   00:46A0  AF                      xor a                           ; Ok, if here, no pwd, so no encryption
    1283   00:46A1  18 07                   jr  WIFI_CONNECT_ME_PWD
    1284   00:46A3                      WIFI_CONNECT_ME_PWD_Y:
    1285   00:46A3  3E 79                   ld  a,'y'
    1286   00:46A5  CD A2 00                call    CHPUT                   ; Print 'y'
    1287   00:46A8  3E 01                   ld  a,1                         ; Do not change flags, pwd needed
    1288   00:46AA                      WIFI_CONNECT_ME_PWD:
