    4253   00:5584                      ;========================
    4254   00:5584                      ;===     SSH_OPEN     ===
    4255   00:5584                      ;========================
    4256   00:5584                      ;Open a SSH connection.
    4257   00:5584                      ;
    4258   00:5584                      ;Input:  A  = 2
    4259   00:5584                      ;        HL = Address of parameters block
    4260   00:5584                      ;Output: A = Error code
    4261   00:5584                      ;        B = Connection number
    4262   00:5584                      ;
    4263   00:5584                      ;Parameters block format:
    4264   00:5584                      ;
    4265   00:5584                      ;+0 (4): Remote IP address (0.0.0.0 for unspecified remote socket)
    4266   00:5584                      ;+4 (2): Remote port (ignored if unspecified remote socket)
    4267   00:5584                      ;+6 (1): Subsystem
    4268   00:5584                      ;+7 (1): Flags
    4269   00:5584                      ;+8 (variable): username (0 terminated) and then password or public key (0 terminated)
    4270   00:5584                      ;
    4271   00:5584                      ;Parameter block MUST have at least 32 bytes available if doing host key verification
    4272   00:5584                      ;as unknown host key hash will be returned in it
    4273   00:5584                      
    4274   00:5584                      SSH_OPEN:
    4275   00:5584  E5                      push    hl                      ; save param block address
    4276   00:5585  3E 08                   ld  a,8
    4277   00:5587  85                      add a,l
    4278   00:5588  6F                      ld  l,a
    4279   00:5589  30 01                   jr  nc,SSH_OPEN_1
    4280   00:558B  24                      inc h
    4281   00:558C                      SSH_OPEN_1:
    4282   00:558C                          ; let's check how many bytes there are
    4283   00:558C  11 08 00                ld  de,8                        ; Start with 8, all params except username and password
    4284   00:558F                      SSH_OPEN_CHECK_USER:
    4285   00:558F  7E                      ld  a,(hl)
    4286   00:5590  13                      inc de                          ; Increase size count
    4287   00:5591  23                      inc hl                          ; And next byte
    4288   00:5592  B7                      or  a                           ; If zero, user terminated
    4289   00:5593                          ; Loop until terminator (0) is found
    4290   00:5593  C2 8F 55                jp  nz,SSH_OPEN_CHECK_USER
    4291   00:5596                      SSH_OPEN_CHECK_PASS:
    4292   00:5596  7E                      ld  a,(hl)
    4293   00:5597  13                      inc de                          ; Increase size count
    4294   00:5598  23                      inc hl                          ; And next byte
    4295   00:5599  B7                      or  a                           ; If zero, password terminated
    4296   00:559A                          ; Loop until terminator (0) is found
    4297   00:559A  C2 96 55                jp  nz,SSH_OPEN_CHECK_PASS
    4298   00:559D                      
    4299   00:559D                      SSH_OPEN_SENDCMD:
    4300   00:559D                          ; Ok, so, DE has the full data size, let's start sending from here
    4301   00:559D  3E 82                   ld  a,#82                       ; Function SSH OPEN
    4302   00:559F                          SEND_DATA                       ; Send the command
    4302   00:559F  D3 07             >     out (OUT_TX_PORT),a
    4303   00:55A1  7A                      ld  a,d
    4304   00:55A2                          SEND_DATA                       ; Send the command size msb
    4304   00:55A2  D3 07             >     out (OUT_TX_PORT),a
    4305   00:55A4  7B                      ld  a,e
    4306   00:55A5                          SEND_DATA                       ; Send the command size lsb
    4306   00:55A5  D3 07             >     out (OUT_TX_PORT),a
    4307   00:55A7  E1                      pop hl                          ; Restore the memory address for the parameters
    4308   00:55A8  E5                      push    hl                      ; we might need it later
    4309   00:55A9                      ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    4310   00:55A9  43                      ld  b,e                         ; Number of loops originaly in DE
    4311   00:55AA  1B                      dec de
    4312   00:55AB  14                      inc d
    4313   00:55AC                          if USE_MEM_IO = 0
    4314   00:55AC  0E 07                   ld  c,OUT_TX_PORT
    4315   00:55AE                      SSH_OPEN_SENDDATA:
    4316   00:55AE  ED A3                   outi
    4317   00:55B0  20 FC                   jr  nz,SSH_OPEN_SENDDATA
    4318   00:55B2                          else
    4319   00:55B2                    ~ SSH_OPEN_SENDDATA:
    4320   00:55B2                    ~     ld  a,(hl)
    4321   00:55B2                    ~     ld  (MEM_OUT_TX_PORT),a
    4322   00:55B2                    ~     inc hl
    4323   00:55B2                    ~     djnz SSH_OPEN_SENDDATA
    4324   00:55B2                    ~     endif
    4325   00:55B2  15                      dec d
    4326   00:55B3  20 F9                   jr  nz,SSH_OPEN_SENDDATA
    4327   00:55B5                          ; Now wait up to 3600 (1 minute @ 60Hz) ticks to get response
    4328   00:55B5  21 10 0E                ld  hl,3600
    4329   00:55B8  CD F4 5E                call    SETCOUNTER
    4330   00:55BB                      SSH_OPEN_ST1:
    4331   00:55BB                          CHECK_DATA
    4331   00:55BB  DB 07             >     in  a,(IN_STS_PORT)
    4331   00:55BD  CB 47             >     bit 0,a
    4332   00:55BF  20 05                   jr  nz,SSH_OPEN_ST1.1
    4333   00:55C1  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4334   00:55C4  18 F5                   jr  SSH_OPEN_ST1
    4335   00:55C6                      SSH_OPEN_ST1.1:
    4336   00:55C6                          ; nz, check the data
    4337   00:55C6                          RECEIVE_DATA
    4337   00:55C6  DB 06             >     in a,(IN_DATA_PORT)
    4338   00:55C8  FE 82                   cp  #82                         ; Is response of our command?
    4339   00:55CA  20 EF                   jr  nz,SSH_OPEN_ST1
    4340   00:55CC                          ; now get return code, if return code other than 0, it is finished
    4341   00:55CC                      SSH_OPEN_RC:
    4342   00:55CC                          CHECK_DATA
    4342   00:55CC  DB 07             >     in  a,(IN_STS_PORT)
    4342   00:55CE  CB 47             >     bit 0,a
    4343   00:55D0  20 05                   jr  nz,SSH_OPEN_RC.1
    4344   00:55D2  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4345   00:55D5  18 F5                   jr  SSH_OPEN_RC
    4346   00:55D7                      SSH_OPEN_RC.1:
    4347   00:55D7                          ; nz, discard
    4348   00:55D7                          RECEIVE_DATA
    4348   00:55D7  DB 06             >     in a,(IN_DATA_PORT)
    4349   00:55D9  D1                      pop de                          ; restore memory area address in DE just in case it is needed
    4350   00:55DA  FE 84                   cp  132
    4351   00:55DC  28 24                   jr  z,SSH_OPEN_HOSTHASH
    4352   00:55DE  B7                      or  a                           ; 0?
    4353   00:55DF  C0                      ret nz
    4354   00:55E0                      
    4355   00:55E0                          ; next two bytes are size bytes, don't care, it is 1, conn #
    4356   00:55E0  06 02                   ld  b,2
    4357   00:55E2                      SSH_OPEN_ST2:
    4358   00:55E2                          CHECK_DATA
    4358   00:55E2  DB 07             >     in  a,(IN_STS_PORT)
    4358   00:55E4  CB 47             >     bit 0,a
    4359   00:55E6  20 05                   jr  nz,SSH_OPEN_ST2.1
    4360   00:55E8  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4361   00:55EB  18 F5                   jr  SSH_OPEN_ST2
    4362   00:55ED                      SSH_OPEN_ST2.1:
    4363   00:55ED                          ; nz, discard
    4364   00:55ED                          RECEIVE_DATA
    4364   00:55ED  DB 06             >     in a,(IN_DATA_PORT)
    4365   00:55EF  05                      dec b
    4366   00:55F0  20 F0                   jr  nz,SSH_OPEN_ST2
    4367   00:55F2                      
    4368   00:55F2                          ; now just get the 1 byte, conn#, should go to B
    4369   00:55F2                      SSH_OPEN_CONN_ST1:
    4370   00:55F2                          CHECK_DATA
    4370   00:55F2  DB 07             >     in  a,(IN_STS_PORT)
    4370   00:55F4  CB 47             >     bit 0,a
    4371   00:55F6  20 05                   jr  nz,SSH_OPEN_CONN_ST1.1
    4372   00:55F8  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4373   00:55FB  18 F5                   jr  SSH_OPEN_CONN_ST1
    4374   00:55FD                      SSH_OPEN_CONN_ST1.1:
    4375   00:55FD                          ; nz, get it
    4376   00:55FD                          RECEIVE_DATA
    4376   00:55FD  DB 06             >     in a,(IN_DATA_PORT)
    4377   00:55FF  47                      ld  b,a
    4378   00:5600                          ; done
    4379   00:5600  AF                      xor a
    4380   00:5601  C9                      ret
    4381   00:5602                      
    4382   00:5602                      SSH_OPEN_HOSTHASH:
    4383   00:5602                          ; HL has memory area to write host fingerprint / hash
    4384   00:5602                          ; we will receive size, should be 33, 1 byte for connection ID
    4385   00:5602                          ; 32 bytes for fingerprint / hash
    4386   00:5602                          CHECK_DATA
    4386   00:5602  DB 07             >     in  a,(IN_STS_PORT)
    4386   00:5604  CB 47             >     bit 0,a
    4387   00:5606  20 05                   jr  nz,SSH_OPEN_HOSTHASH.1
    4388   00:5608  CD B5 5A                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    4389   00:560B  18 F5                   jr  SSH_OPEN_HOSTHASH
    4390   00:560D                      SSH_OPEN_HOSTHASH.1:
    4391   00:560D                          ; nz, high byte count of bytes to receive
    4392   00:560D                          RECEIVE_DATA
    4392   00:560D  DB 06             >     in a,(IN_DATA_PORT)
    4393   00:560F  67                      ld h,a
    4394   00:5610                      SSH_OPEN_HOSTHASHB:
    4395   00:5610                          CHECK_DATA
    4395   00:5610  DB 07             >     in  a,(IN_STS_PORT)
    4395   00:5612  CB 47             >     bit 0,a
    4396   00:5614  20 05                   jr  nz,SSH_OPEN_HOSTHASHB.1
    4397   00:5616  CD B5 5A                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    4398   00:5619  18 F5                   jr  SSH_OPEN_HOSTHASHB
    4399   00:561B                      SSH_OPEN_HOSTHASHB.1:
    4400   00:561B                          ; nz, low byte count of bytes to receive
    4401   00:561B                          RECEIVE_DATA
    4401   00:561B  DB 06             >     in a,(IN_DATA_PORT)
    4402   00:561D  6F                      ld  l,a
    4403   00:561E  B4                      or  h
    4404   00:561F                          ; if it was 0, no data
    4405   00:561F                          if USE_MEM_IO = 1
    4406   00:561F                    ~     jp  z,TCPIP_TCP_RCV_RET_NODATA  ; not a typo, no need to make the same code again
    4407   00:561F                    ~     else
    4408   00:561F  CA EA 5A                jp  z,TCPIP_TCP_RCV_RET_NODATA  ; not a typo, no need to make the same code again
    4409   00:5622                          endif
    4410   00:5622  2B                      dec hl                          ; decrement one byte, first is connection will go to B
    4411   00:5623                          ; Now get connection number and save it 
    4412   00:5623                      SSH_OPEN_HOSTHASH_CONN:
    4413   00:5623                          CHECK_DATA
    4413   00:5623  DB 07             >     in  a,(IN_STS_PORT)
    4413   00:5625  CB 47             >     bit 0,a
    4414   00:5627  20 05                   jr  nz,SSH_OPEN_HOSTHASH_CONN.1
    4415   00:5629  CD B5 5A                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    4416   00:562C  18 F5                   jr  SSH_OPEN_HOSTHASH_CONN
    4417   00:562E                      SSH_OPEN_HOSTHASH_CONN.1:
    4418   00:562E                          ; nz, connection number
    4419   00:562E                          RECEIVE_DATA
    4419   00:562E  DB 06             >     in a,(IN_DATA_PORT)
    4420   00:5630  47                      ld b,a
    4421   00:5631  C5                      push    bc                      ; save it
    4422   00:5632                      
    4423   00:5632  4D                      ld  c,l
    4424   00:5633  44                      ld  b,h                         ; BC has effective received data size, as well as HL
    4425   00:5634                      
    4426   00:5634                          ; put effective data size in de
    4427   00:5634  EB                      ex  de,hl
    4428   00:5635                          ; address was in de, now in HL, BC effective received size
    4429   00:5635                      
    4430   00:5635                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use ini :-D
    4431   00:5635  43                      ld  b,e                         ; Number of loops originaly in DE
    4432   00:5636  1B                      dec de
    4433   00:5637  14                      inc d
    4434   00:5638                          if USE_MEM_IO = 0
    4435   00:5638  0E 06                   ld  c,IN_DATA_PORT
    4436   00:563A                          endif
    4437   00:563A                      SSH_OPEN_HOSTHASH_NSF:
    4438   00:563A                          CHECK_DATA
    4438   00:563A  DB 07             >     in  a,(IN_STS_PORT)
    4438   00:563C  CB 47             >     bit 0,a
    4439   00:563E  20 05                   jr  nz,SSH_OPEN_HOSTHASH_NSF.1
    4440   00:5640  CD B5 5A                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    4441   00:5643  18 F5                   jr  SSH_OPEN_HOSTHASH_NSF
    4442   00:5645                      SSH_OPEN_HOSTHASH_NSF.1:
    4443   00:5645                          if USE_MEM_IO = 0
    4444   00:5645  ED A2                   ini
    4445   00:5647                          else
    4446   00:5647                    ~     ld  a,(MEM_IN_DATA_PORT)
    4447   00:5647                    ~     ld  (hl),a
    4448   00:5647                    ~     inc hl
    4449   00:5647                    ~     dec b
    4450   00:5647                    ~     endif
    4451   00:5647  20 F1                   jr  nz,SSH_OPEN_HOSTHASH_NSF
    4452   00:5649  15                      dec d
    4453   00:564A  20 EE                   jr nz,SSH_OPEN_HOSTHASH_NSF
    4454   00:564C                          ; restore BC to get conn # in B
    4455   00:564C  C1                      pop bc
    4456   00:564D                          ; if we are here, return code is 132, unknown host
    4457   00:564D  3E 84                   ld  a,132
    4458   00:564F  C9                      ret
    4459   00:5650                      
    4460   00:5650                      ;==========================
    4461   00:5650                      ;=== SSH_ADD_KNOWN_HOST ===
    4462   00:5650                      ;==========================
    4463   00:5650                      ;Add an unknown host whose connection we tried to open as known
    4464   00:5650                      ;
    4465   00:5650                      ;Input:  A = 11
    4466   00:5650                      ;        B = Connection number
    4467   00:5650                      ;Output: A = Error code
    4468   00:5650                      
    4469   00:5650                      SSH_ADD_KNOWN_HOST:
    4470   00:5650  CB FF                   set 7,a                         ; ESP SSH commands start at #80
    4471   00:5652                          SEND_DATA                       ; Send the command
    4471   00:5652  D3 07             >     out (OUT_TX_PORT),a
    4472   00:5654  AF                      xor a
    4473   00:5655                          SEND_DATA                       ; Send the command size msb
    4473   00:5655  D3 07             >     out (OUT_TX_PORT),a
    4474   00:5657  3E 01                   ld  a,1
    4475   00:5659                          SEND_DATA                       ; Send the command size lsb
