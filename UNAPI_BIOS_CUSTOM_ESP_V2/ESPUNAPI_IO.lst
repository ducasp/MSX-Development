    3470   00:51FF  CB 47             >     bit 0,a
    3471   00:5201  20 05                   jr  nz,TCPIP_UDP_CLOSE_ST2.1
    3472   00:5203  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3473   00:5206  18 F5                   jr  TCPIP_UDP_CLOSE_ST2
    3474   00:5208                      TCPIP_UDP_CLOSE_ST2.1:
    3475   00:5208                          ; nz, discard
    3476   00:5208                          RECEIVE_DATA
    3476   00:5208  DB 06             >     in a,(IN_DATA_PORT)
    3477   00:520A  05                      dec b
    3478   00:520B  20 F0                   jr  nz,TCPIP_UDP_CLOSE_ST2
    3479   00:520D                      
    3480   00:520D                          ; done, no return data other than return code
    3481   00:520D  AF                      xor a
