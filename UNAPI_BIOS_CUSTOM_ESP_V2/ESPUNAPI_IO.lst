    6712   00:6020                          ; Slot in A, now get the address
    6713   00:6020  CD DD 5E                call    GETMEMPOINTER
    6714   00:6023                          ; HL has the address of our memory area, DNS ready is 8 bytes after start
    6715   00:6023  11 08 00                ld  de,MEMORY_DNS_READY_OFFSET
    6716   00:6026  19                      add hl,de
    6717   00:6027                          ; HL has the address of DNS ready
    6718   00:6027  F1                      pop af                          ; Restore parameter
    6719   00:6028  77                      ld  (hl),a
    6720   00:6029  E1                      pop hl
    6721   00:602A  D1                      pop de
    6722   00:602B  C1                      pop bc
    6723   00:602C  C9                      ret
    6724   00:602D                      
    6725   00:602D                      ;--- Obtain DNS result saved in high memory
    6726   00:602D                      ;    Input:  none
    6727   00:602D                      ;    Output: HL DE = DNS result
    6728   00:602D                      ;    Modifies: AF
    6729   00:602D                      
    6730   00:602D                      GETDNSRESULT:
    6731   00:602D  C5                      push    bc
    6732   00:602E  CD 54 5E                call    GETSLT
    6733   00:6031                          ; Slot in A, now get the address
    6734   00:6031  CD DD 5E                call    GETMEMPOINTER
    6735   00:6034                          ; HL has the address of our memory area, DNS result is 9 bytes after start
    6736   00:6034  11 09 00                ld  de,MEMORY_DNS_RES_OFFSET
    6737   00:6037  19                      add hl,de
    6738   00:6038                          ; Ok, get it, first bytes are hl
    6739   00:6038  5E                      ld  e,(hl)
    6740   00:6039  23                      inc hl
    6741   00:603A  56                      ld  d,(hl)
    6742   00:603B  D5                      push    de                      ; for now, save in stack, so we can restore to HL later
    6743   00:603C  23                      inc hl
    6744   00:603D  5E                      ld  e,(hl)
    6745   00:603E  23                      inc hl
    6746   00:603F  56                      ld  d,(hl)
    6747   00:6040  E1                      pop hl                          ; and now restore HL value from stack
    6748   00:6041  C1                      pop bc
    6749   00:6042  C9                      ret
    6750   00:6043                      
    6751   00:6043                      ;--- Set DNS result in high memory
    6752   00:6043                      ;    Input:  HL DE = new value
    6753   00:6043                      ;    Output: none
    6754   00:6043                      ;    Modifies: AF
    6755   00:6043                      
    6756   00:6043                      SETDNSRESULT:
    6757   00:6043  C5                      push    bc
    6758   00:6044  D5                      push    de
    6759   00:6045  E5                      push    hl
    6760   00:6046  CD 54 5E                call    GETSLT
    6761   00:6049                          ; Slot in A, now get the address
    6762   00:6049  CD DD 5E                call    GETMEMPOINTER
    6763   00:604C                          ; HL has the address of our memory area, DNS result is 9 bytes after start
    6764   00:604C  11 09 00                ld  de,MEMORY_DNS_RES_OFFSET
    6765   00:604F  19                      add hl,de
    6766   00:6050                          ; HL has the address of DNS result
    6767   00:6050  C1                      pop bc                          ; Restore parameter HL in BC
    6768   00:6051  71                      ld  (hl),c
    6769   00:6052  23                      inc hl
    6770   00:6053  70                      ld  (hl),b
    6771   00:6054  D1                      pop de                          ; Restore parameter DE in DE
    6772   00:6055  23                      inc hl
    6773   00:6056  73                      ld  (hl),e
    6774   00:6057  23                      inc hl
    6775   00:6058  72                      ld  (hl),d
    6776   00:6059  69                      ld  l,c
    6777   00:605A  60                      ld  h,b                         ; And HL is restored
    6778   00:605B  C1                      pop bc                          ; Restore BC
    6779   00:605C  C9                      ret
    6780   00:605D                      
    6781   00:605D                      ;--- Convert a character to upper-case if it is a lower-case letter
    6782   00:605D                      TOUPPER:
    6783   00:605D  FE 61                   cp  "a"
    6784   00:605F  D8                      ret c
    6785   00:6060  FE 7B                   cp  "z"+1
    6786   00:6062  D0                      ret nc
    6787   00:6063  E6 DF                   and #DF
    6788   00:6065  C9                      ret
    6789   00:6066                      
    6790   00:6066                      ;*********************************************
    6791   00:6066                      ;***       WAIT_RESPONSE_FROM_ESP          ***
    6792   00:6066                      ;*** Will wait ESP to send a response,     ***
    6793   00:6066                      ;*** discarding all data until it is found.***
    6794   00:6066                      ;***                                       ***
    6795   00:6066                      ;*** Inputs:                               ***
    6796   00:6066                      ;*** HL - Expected response string         ***
    6797   00:6066                      ;*** A - Response Size                     ***
    6798   00:6066                      ;*** DE - TimeOut in ticks                 ***
    6799   00:6066                      ;***                                       ***
    6800   00:6066                      ;*** Output:                               ***
    6801   00:6066                      ;*** A - 0 if response received            ***
    6802   00:6066                      ;*** otherwise response not received and   ***
    6803   00:6066                      ;*** timed-out.                            ***
    6804   00:6066                      ;***                                       ***
    6805   00:6066                      ;*** Changes HL, BC, AF, DE, IX            ***
    6806   00:6066                      ;*********************************************
    6807   00:6066                      WRFE_WAIT_DATA:
    6808   00:6066                          LOAD_STS_PORT_IN_A
    6808   00:6066  DB 07             >     in  a,(IN_STS_PORT)
    6809   00:6068  CB 6F                   bit 5,a                         ; If nz Port #07 is not available
    6810   00:606A  20 06                   jr  nz,WRFE_STS_NOT_AVAILABLE
    6811   00:606C  CB 47                   bit 0,a                         ; if nz has data
    6812   00:606E  C0                      ret nz
    6813   00:606F  1B                      dec de
    6814   00:6070  76                      halt
    6815   00:6071  C9                      ret
    6816   00:6072                      WRFE_STS_NOT_AVAILABLE:
    6817   00:6072  11 00 00                ld  de,0
    6818   00:6075  AF                      xor a
    6819   00:6076  C9                      ret
    6820   00:6077                      
    6821   00:6077                      WRFE_COMPARE:
    6822   00:6077  47                      ld  b,a
    6823   00:6078  7E                      ld  a,(hl)
    6824   00:6079  B8                      cp  b
    6825   00:607A  C0                      ret nz
    6826   00:607B  23                      inc hl
    6827   00:607C  C9                      ret
    6828   00:607D                      
    6829   00:607D                      WAIT_RESPONSE_FROM_ESP:
    6830   00:607D  4F                      ld  c,a                         ; Response size in C
    6831   00:607E  E5                      push    hl                      ; Save HL
    6832   00:607F  AF                      xor a
    6833   00:6080                      WRFE_ST1:
    6834   00:6080  DD 67                   ld  ixh,a                       ; We start at index 0
    6835   00:6082                      
    6836   00:6082                      WRFE_LOOP:
    6837   00:6082  CD 66 60                call    WRFE_WAIT_DATA
    6838   00:6085  20 07                   jr  nz,WRFE_LOOP.1
    6839   00:6087  7B                      ld  a,e
    6840   00:6088  B2                      or  d
    6841   00:6089  CA A8 60                jp  z,WRFE_RET_ERROR
    6842   00:608C  18 F4                   jr  WRFE_LOOP
    6843   00:608E                      WRFE_LOOP.1:
    6844   00:608E                          ; nz, check the data
    6845   00:608E                          RECEIVE_DATA
    6845   00:608E  DB 06             >     in a,(IN_DATA_PORT)
    6846   00:6090                          ; Ok, now the byte is in A, let's compare
    6847   00:6090                      WRFE_IDXCMD:
    6848   00:6090  CD 77 60                call WRFE_COMPARE
    6849   00:6093                          ; if match
    6850   00:6093  28 07                   jr  z,WRFE_RSP_MATCH
    6851   00:6095                          ; did not match, let's zero the rsp index
    6852   00:6095  AF                      xor a
    6853   00:6096  DD 67                   ld  ixh,a                       ; re-start at index 0
    6854   00:6098  E1                      pop hl                          ; restore the response index
    6855   00:6099  E5                      push    hl                      ; and keep it in stack
    6856   00:609A                          ; back to get another byte
    6857   00:609A  18 E6                   jr  WRFE_LOOP
    6858   00:609C                      WRFE_RSP_MATCH:
    6859   00:609C                          ; match
    6860   00:609C  DD 24                   inc ixh
    6861   00:609E  DD 7C                   ld  a,ixh
    6862   00:60A0  B9                      cp  c
    6863   00:60A1                          ; if a = c done and response is success
    6864   00:60A1  28 02                   jr  z,WRFE_RET_OK
    6865   00:60A3                          ; not done, back to get more bytes
    6866   00:60A3  18 DD                   jr  WRFE_LOOP
    6867   00:60A5                      WRFE_RET_OK:
    6868   00:60A5  E1                      pop hl
    6869   00:60A6  AF                      xor a
    6870   00:60A7  C9                      ret
    6871   00:60A8                      WRFE_RET_ERROR:
    6872   00:60A8  E1                      pop hl
    6873   00:60A9  3E 01                   ld  a,1
    6874   00:60AB  C9                      ret
    6875   00:60AC                      
    6876   00:60AC                      ;*********************************************
    6877   00:60AC                      ;***            CHECK_ESP_TYPE             ***
    6878   00:60AC                      ;*** Always flags the SSH check as done.   ***
    6879   00:60AC                      ;*** If ESP32, flags it and probes if SSH  ***
    6880   00:60AC                      ;*** commands are supported.               ***
    6881   00:60AC                      ;*** If ESP32, NZ will be set and A = 1, if***
    6882   00:60AC                      ;*** not NZ will be reset and A=0          ***
    6883   00:60AC                      ;*********************************************
    6884   00:60AC                      CHECK_ESP_TYPE:
    6885   00:60AC  E5                      push    hl
    6886   00:60AD  D5                      push    de
    6887   00:60AE  FD E5                   push    iy
    6888   00:60B0  DD E5                   push    ix
    6889   00:60B2                          CLEAR_UART                      ; Clear UART
    6889   00:60B2  3E 14             >     ld  a,20
    6889   00:60B4  D3 06             >     out (OUT_CMD_PORT),a
    6890   00:60B6  3E 62                   ld  a,CMD_GET_FW_TYPE
    6891   00:60B8                          SEND_DATA
    6891   00:60B8  D3 07             >     out (OUT_TX_PORT),a
    6892   00:60BA  21 06 00                ld  hl,6                        ; Wait up to 100ms
    6893   00:60BD  ED 5B 76 F6             ld  de,(TXTTAB)                 ; Borrow Basic program area for now....
    6894   00:60C1  DD 6B                   ld  ixl,e
    6895   00:60C3  DD 62                   ld  ixh,d                       ; Address in IX
    6896   00:60C5  CD 40 4B                call    WAIT_MENU_CMD_RESPONSE
    6897   00:60C8  F5                      push    af                      ; Keep result (1 = ESP32, 0 = not)
    6898   00:60C9  CD 54 5E                call    GETSLT
    6899   00:60CC  CD C1 5E                call    GETMEMPOINTERADDR       ; This is where we are going to store our memory area address
    6900   00:60CF  11 02 00                ld  de,2
    6901   00:60D2  19                      add hl,de                       ; HL = our flags byte
    6902   00:60D3  F1                      pop af
    6903   00:60D4  28 0A                   jr  z,CHECK_ESP_TYPE_NO32
    6904   00:60D6                          ; ESP32 found: probed + ESP32, then check SSH support
    6905   00:60D6  36 81                   ld  (hl),ESPFLAG_SSH_PROBED+ESPFLAG_ESP32
    6906   00:60D8  CD EA 60                call    PROBE_ESP_SSH           ; Sets/clears ESPFLAG_SSH
    6907   00:60DB  3E 01                   ld  a,1
    6908   00:60DD  B7                      or  a                           ; NZ = ESP32, as before
    6909   00:60DE  18 03                   jr  CHECK_ESP_TYPE_END
    6910   00:60E0                      CHECK_ESP_TYPE_NO32:
    6911   00:60E0                          ; No ESP32 means no SSH support either, and SSH was probed
    6912   00:60E0  36 80                   ld  (hl),ESPFLAG_SSH_PROBED
    6913   00:60E2  AF                      xor a                           ; Z = not ESP32, as before
    6914   00:60E3                      CHECK_ESP_TYPE_END:
    6915   00:60E3  DD E1                   pop ix
    6916   00:60E5  FD E1                   pop iy
    6917   00:60E7  D1                      pop de
    6918   00:60E8  E1                      pop hl
    6919   00:60E9  C9                      ret
    6920   00:60EA                      
    6921   00:60EA                      ;*********************************************
    6922   00:60EA                      ;***             PROBE_ESP_SSH             ***
    6923   00:60EA                      ;*** Sends an SSH GET_CAPAB request for    ***
    6924   00:60EA                      ;*** block 1 (81h 00h 01h 01h) and accepts ***
    6925   00:60EA                      ;*** 81h 00h or 81h 04h as SSH support.    ***
    6926   00:60EA                      ;*** Sets/clears ESPFLAG_SSH and marks the ***
    6927   00:60EA                      ;*** check as done. Called from boot only. ***
    6928   00:60EA                      ;*** Output: NZ if SSH is supported        ***
    6929   00:60EA                      ;*********************************************
    6930   00:60EA                      PROBE_ESP_SSH:
    6931   00:60EA  C5                      push    bc
    6932   00:60EB  D5                      push    de
    6933   00:60EC  E5                      push    hl
    6934   00:60ED  CD 54 5E                call    GETSLT
    6935   00:60F0  CD C1 5E                call    GETMEMPOINTERADDR
    6936   00:60F3  11 02 00                ld  de,2
    6937   00:60F6  19                      add hl,de                       ; Our flags byte
    6938   00:60F7  E5                      push    hl                      ; Keep its address
    6939   00:60F8  CB FE                   set 7,(hl)                      ; SSH check is done
    6940   00:60FA  CB 8E                   res 1,(hl)                      ; Assume SSH is not supported
    6941   00:60FC                          CLEAR_UART                      ; Clear UART
    6941   00:60FC  3E 14             >     ld  a,20
    6941   00:60FE  D3 06             >     out (OUT_CMD_PORT),a
    6942   00:6100  3E 81                   ld  a,#81                       ; SSH GET_CAPAB command
    6943   00:6102                          SEND_DATA
    6943   00:6102  D3 07             >     out (OUT_TX_PORT),a
    6944   00:6104  AF                      xor a
    6945   00:6105                          SEND_DATA                       ; Command size MSB
    6945   00:6105  D3 07             >     out (OUT_TX_PORT),a
    6946   00:6107  3C                      inc a
    6947   00:6108                          SEND_DATA                       ; Command size LSB
    6947   00:6108  D3 07             >     out (OUT_TX_PORT),a
    6948   00:610A                          SEND_DATA                       ; Block index (1)
    6948   00:610A  D3 07             >     out (OUT_TX_PORT),a
    6949   00:610C  21 02 00                ld  hl,2                        ; Wait up to 2 frames
    6950   00:610F                      PROBE_ESP_SSH_ST1:
    6951   00:610F                          CHECK_DATA
    6951   00:610F  DB 07             >     in  a,(IN_STS_PORT)
    6951   00:6111  CB 47             >     bit 0,a
    6952   00:6113  20 07                   jr  nz,PROBE_ESP_SSH_ST1.1
    6953   00:6115  CD 4E 4C                call    HLTIMEOUT
    6954   00:6118  20 F5                   jr  nz,PROBE_ESP_SSH_ST1
    6955   00:611A  18 20                   jr  PROBE_ESP_SSH_END           ; Time-out, not supported
    6956   00:611C                      PROBE_ESP_SSH_ST1.1:
    6957   00:611C                          RECEIVE_DATA
    6957   00:611C  DB 06             >     in a,(IN_DATA_PORT)
    6958   00:611E  FE 81                   cp  #81                         ; Is response of our command?
    6959   00:6120  20 ED                   jr  nz,PROBE_ESP_SSH_ST1
    6960   00:6122                      PROBE_ESP_SSH_ST2:
    6961   00:6122                          CHECK_DATA
    6961   00:6122  DB 07             >     in  a,(IN_STS_PORT)
    6961   00:6124  CB 47             >     bit 0,a
    6962   00:6126  20 07                   jr  nz,PROBE_ESP_SSH_ST2.1
    6963   00:6128  CD 4E 4C                call    HLTIMEOUT
    6964   00:612B  20 F5                   jr  nz,PROBE_ESP_SSH_ST2
    6965   00:612D  18 0D                   jr  PROBE_ESP_SSH_END           ; Time-out, not supported
    6966   00:612F                      PROBE_ESP_SSH_ST2.1:
    6967   00:612F                          RECEIVE_DATA
    6967   00:612F  DB 06             >     in a,(IN_DATA_PORT)
    6968   00:6131  B7                      or  a                           ; Error code 0?
    6969   00:6132  28 04                   jr  z,PROBE_ESP_SSH_OK
    6970   00:6134  FE 04                   cp  4                           ; Error code 4?
    6971   00:6136  20 04                   jr  nz,PROBE_ESP_SSH_END        ; Anything else, not supported
    6972   00:6138                      PROBE_ESP_SSH_OK:
    6973   00:6138  E1                      pop hl
    6974   00:6139  CB CE                   set 1,(hl)                      ; SSH is supported
    6975   00:613B  E5                      push    hl
    6976   00:613C                      PROBE_ESP_SSH_END:
    6977   00:613C                          CLEAR_UART                      ; Consume/discard remaining response
    6977   00:613C  3E 14             >     ld  a,20
    6977   00:613E  D3 06             >     out (OUT_CMD_PORT),a
    6978   00:6140  E1                      pop hl
    6979   00:6141  7E                      ld  a,(hl)
    6980   00:6142  E6 02                   and ESPFLAG_SSH
    6981   00:6144  E1                      pop hl
    6982   00:6145  D1                      pop de
    6983   00:6146  C1                      pop bc
    6984   00:6147  C9                      ret
    6985   00:6148                      
    6986   00:6148                      ;*********************************************
    6987   00:6148                      ;***         PRINT_INSTALLED_MSG           ***
    6988   00:6148                      ;*** ESP8266: prints installed message.    ***
    6989   00:6148                      ;*** ESP32: uses the 'b' (Get Board)       ***
    6990   00:6148                      ;*** command to print the board ID.        ***
    6991   00:6148                      ;*********************************************
    6992   00:6148                      PRINT_INSTALLED_MSG:
    6993   00:6148  C5                      push    bc
    6994   00:6149  D5                      push    de
    6995   00:614A  FD E5                   push    iy
    6996   00:614C  DD E5                   push    ix
    6997   00:614E  CD D9 5F                call    GETESPTYPE
    6998   00:6151  28 46                   jr  z,PRINT_INST_8266           ; Not an ESP32, no need to ask
    6999   00:6153                          ; ESP32, let's get the board identification string
    7000   00:6153                          CLEAR_UART                      ; Clear UART
    7000   00:6153  3E 14             >     ld  a,20
    7000   00:6155  D3 06             >     out (OUT_CMD_PORT),a
    7001   00:6157  3E 62                   ld  a,CMD_GET_FW_TYPE           ; 'b' Get Board, ESP32 only
    7002   00:6159                          SEND_DATA
    7002   00:6159  D3 07             >     out (OUT_TX_PORT),a
    7003   00:615B  21 06 00                ld  hl,6                        ; Wait up to 100ms
    7004   00:615E  ED 5B 76 F6             ld  de,(TXTTAB)                 ; Borrow Basic program area for now....
    7005   00:6162  DD 6B                   ld  ixl,e
    7006   00:6164  DD 62                   ld  ixh,d                       ; Address in IX
    7007   00:6166  CD 40 4B                call    WAIT_MENU_CMD_RESPONSE
    7008   00:6169  28 26                   jr  z,PRINT_INST_32             ; No answer, just tell it is an ESP32
    7009   00:616B                          ; Response size is in BC, board ID copied at (TXTTAB)
    7010   00:616B  78                      ld  a,b
    7011   00:616C  B7                      or  a                           ; Size above 255?
    7012   00:616D  20 22                   jr  nz,PRINT_INST_32            ; Then just tell it is an ESP32
    7013   00:616F  79                      ld  a,c
    7014   00:6170  B7                      or  a                           ; Size zero?
    7015   00:6171  28 1E                   jr  z,PRINT_INST_32             ; Then just tell it is an ESP32
    7016   00:6173  FE 18                   cp  24                          ; More than 23 chars?
    7017   00:6175  30 1A                   jr  nc,PRINT_INST_32            ; Then just tell it is an ESP32
    7018   00:6177  2A 76 F6                ld  hl,(TXTTAB)
    7019   00:617A  09                      add hl,bc
    7020   00:617B  36 00                   ld  (hl),0                      ; Ensure the string is terminated
    7021   00:617D  21 85 6F                ld  hl,OK_INST_PRE              ; "Installed "
    7022   00:6180  CD 54 4C                call    PRINTHL
    7023   00:6183  2A 76 F6                ld  hl,(TXTTAB)
    7024   00:6186  CD 54 4C                call    PRINTHL                 ; Board identification string
    7025   00:6189  21 90 6F                ld  hl,OK_INST_SUF              ; " successfully!"
    7026   00:618C  CD 54 4C                call    PRINTHL
    7027   00:618F  18 0E                   jr  PRINT_INST_END
    7028   00:6191                      PRINT_INST_32:
    7029   00:6191  21 64 6F                ld  hl,OK_ESP32                 ; Installed ESP32 successfully!
    7030   00:6194  CD 54 4C                call    PRINTHL
    7031   00:6197  18 06                   jr  PRINT_INST_END
    7032   00:6199                      PRINT_INST_8266:
    7033   00:6199  21 41 6F                ld  hl,OK_ESP8266               ; Installed ESP8266 successfully!
    7034   00:619C  CD 54 4C                call    PRINTHL
    7035   00:619F                      PRINT_INST_END:
    7036   00:619F  DD E1                   pop ix
    7037   00:61A1  FD E1                   pop iy
    7038   00:61A3  D1                      pop de
    7039   00:61A4  C1                      pop bc
    7040   00:61A5  C9                      ret
    7041   00:61A6                      
    7042   00:61A6                      ;*********************************************
    7043   00:61A6                      ;***              RESET ESP                ***
    7044   00:61A6                      ;*** If RESET ok, A will be 0, otherwise   ***
    7045   00:61A6                      ;*** failure                               ***
    7046   00:61A6                      ;*********************************************
    7047   00:61A6                      RESET_ESP:
    7048   00:61A6                          ; Is ESP installed?
    7049   00:61A6                          CLEAR_UART                      ; Clear UART
    7049   00:61A6  3E 14             >     ld  a,20
    7049   00:61A8  D3 06             >     out (OUT_CMD_PORT),a
    7050   00:61AA  3E 3F                   ld  a,CMD_QUERY_ESP
    7051   00:61AC                          SEND_DATA
    7051   00:61AC  D3 07             >     out (OUT_TX_PORT),a
    7052   00:61AE  21 40 63                ld  hl,RSP_CMD_QUERY_ESP        ; Expected response
    7053   00:61B1  11 3C 00                ld  de,60                       ; Up to 1s @ 60Hz
    7054   00:61B4  3E 02                   ld  a,RSP_CMD_QUERY_ESP_SIZE    ; Size of response
    7055   00:61B6  CD 7D 60                call    WAIT_RESPONSE_FROM_ESP
    7056   00:61B9  B7                      or  a
    7057   00:61BA  3E 01                   ld  a,1
    7058   00:61BC  28 03                   jr  z,RESET_ESP_INIT            ; ESP Found
    7059   00:61BE  06 00                   ld  b,0                         ; 0 if no response
    7060   00:61C0  C9                      ret
    7061   00:61C1                      RESET_ESP_INIT:
    7062   00:61C1  06 03                   ld  b,3                         ; Retry up to 10 times
    7063   00:61C3                      RESET_ESP_LOOP:
    7064   00:61C3                          CLEAR_UART
    7064   00:61C3  3E 14             >     ld  a,20
    7064   00:61C5  D3 06             >     out (OUT_CMD_PORT),a
    7065   00:61C7                          SET_SPEED
    7065   00:61C7  AF                >     xor a
    7065   00:61C8  D3 06             >     out (OUT_CMD_PORT),a
    7066   00:61CA  76                      halt
    7067   00:61CB  76                      halt                            ; Wait a little to make sure speed is adjusted
    7068   00:61CC  3E 57                   ld  a,CMD_WRESET_ESP
    7069   00:61CE                          SEND_DATA
    7069   00:61CE  D3 07             >     out (OUT_TX_PORT),a
    7070   00:61D0  21 3B 63                ld  hl,RSP_CMD_RESET_ESP        ; Expected response
    7071   00:61D3  11 5A 00                ld  de,90                       ; Up to 1.5s @ 60Hz
    7072   00:61D6  3E 05                   ld  a,RSP_CMD_RESET_ESP_SIZE    ; Size of response
    7073   00:61D8  C5                      push    bc                      ; Save retry counter
    7074   00:61D9  CD 7D 60                call    WAIT_RESPONSE_FROM_ESP
    7075   00:61DC  C1                      pop bc                          ; restore retry counter
    7076   00:61DD  B7                      or  a                           ; Did WAIT RESPONSE return zero?
    7077   00:61DE  C8                      ret z                           ; Yes, Warm Reset Ok
    7078   00:61DF  10 E2                   djnz RESET_ESP_LOOP             ; No, decrement retry counter and let the loop check
    7079   00:61E1                          ; No more retries? Then check if it is old ESP FW
    7080   00:61E1                      RESET_CHK_IF_INSTALLED:
    7081   00:61E1                          ; No more retries? Then it is old ESP FW
    7082   00:61E1  06 01                   ld  b,1
    7083   00:61E3  C9                      ret
    7084   00:61E4                      
    7085   00:61E4                      ;*********************************************
    7086   00:61E4                      ;***              SET TIME                 ***
    7087   00:61E4                      ;*** H - Hour                              ***
    7088   00:61E4                      ;*** L - Minutes                           ***
    7089   00:61E4                      ;*** D - Seconds                           ***
    7090   00:61E4                      ;***                                       ***
    7091   00:61E4                      ;*** A - 0 if Ok otherwise invalid time    ***
    7092   00:61E4                      ;*********************************************
    7093   00:61E4                      SET_TIME:
    7094   00:61E4  7C                      ld  a,h                         ; Hour in A
    7095   00:61E5  FE 18                   cp  24                          ; Compare to 24
    7096   00:61E7  30 12                   jr  nc,SET_TIME_ERR             ; If 24 or more, invalid
    7097   00:61E9  7D                      ld  a,l                         ; Minutes in A
    7098   00:61EA  FE 3C                   cp  60                          ; Compare to 60
    7099   00:61EC  30 0D                   jr  nc,SET_TIME_ERR             ; If 60 or more, invalid
    7100   00:61EE  7A                      LD  a,d                         ; Seconds in D
    7101   00:61EF  FE 3C                   cp  60                          ; Compare to 60
    7102   00:61F1  30 08                   jr  nc,SET_TIME_ERR             ; If 60 or more invalid
    7103   00:61F3  44                      ld  b,h                         ; Hour in B
    7104   00:61F4  4D                      ld  c,l                         ; Minutes in C
    7105   00:61F5  5A                      ld  e,d                         ; Seconds in E
    7106   00:61F6  CD FE 61                call    SET_RTC_TIME            ; Set time in RTC
    7107   00:61F9  AF                      xor a                           ; 0 in A
    7108   00:61FA  C9                      ret                             ; Return
    7109   00:61FB                      ;   Invalid parameter
    7110   00:61FB                      SET_TIME_ERR:
    7111   00:61FB  3E 01                   ld  a,1                         ; Invalid Time
    7112   00:61FD  C9                      ret                             ; Return
    7113   00:61FE                      
    7114   00:61FE                      SET_RTC_TIME:
    7115   00:61FE  6B                      ld  l,e                         ; Seconds in L
    7116   00:61FF  61                      ld  h,c                         ; Minutes in H
    7117   00:6200  50                      ld  d,b                         ; Hour in D
    7118   00:6201  CD 59 62                call    STOP_RTC_COUNT_SET_MODE0; Select RTC Register 13, and set Mode / Page 0
    7119   00:6204  3E 0F                   ld  a,#F                        ; Register F
    7120   00:6206  D3 B4                   out (#B4),a
    7121   00:6208  3E 02                   ld  a,2
    7122   00:620A  D3 B5                   out (#B5),a                     ; Timer reset seconds and on both clock pulses
    7123   00:620C  1E 00                   ld  e,0                         ; Start at register 0
    7124   00:620E  C3 94 62                jp  SET_RTC_DATE.1              ; And save L, H and D, function will return from there
    7125   00:6211                      
    7126   00:6211                      ;*********************************************
    7127   00:6211                      ;***              SET DATE                 ***
    7128   00:6211                      ;*** HL - Year from 1980 to 2079           ***
    7129   00:6211                      ;*** D - Month from 1 to 12                ***
    7130   00:6211                      ;*** E - Day from 1 to 31                  ***
    7131   00:6211                      ;***                                       ***
    7132   00:6211                      ;*** A - 0 if Ok otherwise invalid Date    ***
    7133   00:6211                      ;*********************************************
    7134   00:6211                      SET_DATE:
    7135   00:6211  01 44 F8                ld  bc,#F844
    7136   00:6214  09                      add hl,bc
    7137   00:6215  30 32                   jr  nc,SET_DATE_ERR             ; No carry -> Year is less than 1980, invalid date
    7138   00:6217  7C                      ld  a,h
    7139   00:6218  B7                      or  a
    7140   00:6219  20 2E                   jr  nz,SET_DATE_ERR             ; If H is set, means year is greater than 2235 ,invalid
    7141   00:621B  7D                      ld  a,l
    7142   00:621C  FE 64                   cp  100
    7143   00:621E  30 29                   jr  nc,SET_DATE_ERR             ; If L >= 100 year is greater than 2079, invalid
    7144   00:6220  47                      ld  b,a                         ; Year - 1980 in B
    7145   00:6221  7A                      ld  a,d                         ; Now test month
    7146   00:6222  3D                      dec a
    7147   00:6223  FE 0C                   cp  12                          ; If 12 or less this should carry
    7148   00:6225  30 22                   jr  nc,SET_DATE_ERR             ; otherwise invalid
    7149   00:6227  21 4C 62                ld  hl,DAYS_IN_MONTH            ; Days in Month table
    7150   00:622A  85                      add a,l                         ; add our month
    7151   00:622B  6F                      ld  l,a                         ; back in L
    7152   00:622C  30 01                   jr  nc,SET_DATE1                ; no carry done
    7153   00:622E  24                      inc h                           ; otherwise increase H
    7154   00:622F                      SET_DATE1:
    7155   00:622F  3E 1C                   ld  a,28                        ; 28 days
    7156   00:6231  BE                      cp  (hl)                        ; If month is 28 days, February, need to check if leap and limit is 29 in this year
    7157   00:6232  20 08                   jr  nz,SET_DATE2                ; if not, skip below code , so probably above check is if month is february
    7158   00:6234  78                      ld  a,b                         ; Year - 1980 in A again
    7159   00:6235  E6 03                   and 3                           ; if other than 0, non divisible per 4, so not a leap year
    7160   00:6237  20 03                   jr  nz,SET_DATE2                ; Regular year
    7161   00:6239  21 58 62                ld  hl,DAYS_IN_FEBRUARY_LEAP    ; HL has address of 29 days, maximum number of days for february in leap year
    7162   00:623C                      SET_DATE2:
    7163   00:623C  7B                      ld  a,e                         ; Day of month in A
    7164   00:623D  3D                      dec a                           ; Decrement
    7165   00:623E  BE                      cp  (hl)                        ; Compare with Days in month
    7166   00:623F  30 08                   jr  nc,SET_DATE_ERR             ; If day is greater than how many days in month, invalid
    7167   00:6241  6B                      ld  l,e                         ; Day of month in L
    7168   00:6242  62                      ld  h,d                         ; Month in H
    7169   00:6243  50                      ld  d,b                         ; Year - 1980 in D
    7170   00:6244  CD 7E 62                call    SET_RTC_DATE            ; Set date in RTC
    7171   00:6247  AF                      xor a                           ; A = 0
    7172   00:6248  C9                      ret                             ; Success
    7173   00:6249                      ;   Invalid parameter
    7174   00:6249                      SET_DATE_ERR:
    7175   00:6249  3E 01                   ld  a,1
    7176   00:624B  C9                      ret
    7177   00:624C                      
    7178   00:624C                      ; Table of top day value for each month
    7179   00:624C                      DAYS_IN_MONTH:          db  31,28,31,30,31,30,31,31,30,31,30,31
    7179   00:624C  1F 1C 1F 1E 1F 1E 1F 1F 1E 1F 1E 1F 
    7180   00:6258                      ; And top day value in February when Leap Year
    7181   00:6258  1D                  DAYS_IN_FEBRUARY_LEAP:  db  29
    7182   00:6259                      
    7183   00:6259                      ; Will select Mode 00 (Date and Time page) and stop clock counting
    7184   00:6259                      ; Register D value will be left in A
    7185   00:6259                      STOP_RTC_COUNT_SET_MODE0:
    7186   00:6259  3E 0D                   ld  a,#D
    7187   00:625B  D3 B4                   out (#B4),a                     ; Select RTC register D (mode)
    7188   00:625D  DB B5                   in  a,(#B5)                     ; read register D
    7189   00:625F  E6 04                   and 4                           ; Save Alarm EN setting, and mode register is 00 and stop counting time
    7190   00:6261  D3 B5                   out (#B5),a                     ; And save
    7191   00:6263  C9                      ret
    7192   00:6264                      
    7193   00:6264                      ; Will get a non BCD value in A, convert it to BCD and then save it in
    7194   00:6264                      ; a register pair that starts in the register indicated in E
    7195   00:6264                      ; Register E will have the next register after that register pair
    7196   00:6264                      RTC_SAVE_REGISTERPAIR:
    7197   00:6264  4F                      ld  c,a                         ; Save A in C
    7198   00:6265  AF                      xor a                           ; 0 in A
    7199   00:6266  06 08                   ld  b,8                         ; 8 in B, number of bits for conversion
    7200   00:6268                      RTC_SAVE_REGISTERPAIR.1:
    7201   00:6268  CB 01                   rlc c                           ; Leftmost bit in Carry
    7202   00:626A  8F                      adc a,a                         ; A = (A * 2) + Carry
    7203   00:626B  27                      daa                             ; decimal adjust A, shift = BCD x 2 + carry
    7204   00:626C  10 FA                   djnz    RTC_SAVE_REGISTERPAIR.1 ; Repeat for 8 bits
    7205   00:626E  CD 75 62                call    SET_RTC_REG             ; Save LSB in register and increase register address
    7206   00:6271  0F                      rrca
    7207   00:6272  0F                      rrca
    7208   00:6273  0F                      rrca
    7209   00:6274  0F                      rrca                            ; now MSB is in LSB position
    7210   00:6275                      SET_RTC_REG:
    7211   00:6275  47                      ld  b,a                         ; save value to set in B
    7212   00:6276  7B                      ld  a,e                         ; and now register address in A
    7213   00:6277  D3 B4                   out (#B4),a                     ; The register we want to set
    7214   00:6279  78                      ld  a,b                         ; restore value
    7215   00:627A  D3 B5                   out (#B5),a                     ; save it
    7216   00:627C  1C                      inc e                           ; increase register address, as this usually is done in pairs
    7217   00:627D  C9                      ret
    7218   00:627E                      
    7219   00:627E                      ; Auxiliary function for SET_DATE and SET_TIME
    7220   00:627E                      ; SET_RTC_DATE will save date, parameters:
    7221   00:627E                      ; L - Day
    7222   00:627E                      ; H - Month
    7223   00:627E                      ; D - Years since 1980
    7224   00:627E                      ; All values are regular values, this function will properly convert them
    7225   00:627E                      ;
    7226   00:627E                      ; SET_RTC_DATE.1 is used by SET_TIME as well
    7227   00:627E                      ; It will save three register pairs, starting with the register in E
    7228   00:627E                      ; First pair is updated with value in L
    7229   00:627E                      ; Second pair is updated with value in H
    7230   00:627E                      ; Third pair is updated with value in D
    7231   00:627E                      SET_RTC_DATE:
    7232   00:627E  CD 59 62                call    STOP_RTC_COUNT_SET_MODE0; Select RTC Register 13, and set Mode / Page 0
    7233   00:6281  F6 01                   or  1                           ; Set Bit 0, so Mode / Page 1
    7234   00:6283  D3 B5                   out (#B5),a                     ; save it in register 13, now page 1 selected
    7235   00:6285  3E 0B                   ld  a,#B                        ; Leap Year Counter Register
    7236   00:6287  D3 B4                   out (#B4),a                     ; Select it
    7237   00:6289  7A                      ld  a,d                         ; Load Years in leap year counter
    7238   00:628A  D3 B5                   out (#B5),a                     ; So it has count of leap years (0 is 1980, leap, and every time it is 4, leap year again)
    7239   00:628C  CD 59 62                call    STOP_RTC_COUNT_SET_MODE0; Select RTC Register 13 and set mode / page 0
    7240   00:628F  CD 59 62                call    STOP_RTC_COUNT_SET_MODE0; do it a second time... DOS does it, don't want to JYNX it :P
    7241   00:6292  1E 07                   ld  e,7                         ; Register 7
    7242   00:6294                      SET_RTC_DATE.1:
    7243   00:6294  7D                      ld  a,l                         ; A has day
    7244   00:6295  CD 64 62                call    RTC_SAVE_REGISTERPAIR   ; Will convert day to BCD and save in registers 7 and 8
    7245   00:6298  7C                      ld  a,h                         ; A has month
    7246   00:6299  CD 64 62                call    RTC_SAVE_REGISTERPAIR   ; Will convert month to BCD and save in register 9 and A
    7247   00:629C  7A                      ld  a,d                         ; A has how many years since 1980
    7248   00:629D  CD 64 62                call    RTC_SAVE_REGISTERPAIR   ; Will convert to BCD and save in register B and C
    7249   00:62A0  3E 0D                   ld  a,#D                        ; Register D
    7250   00:62A2  D3 B4                   out (#B4),a                     ; Send it
    7251   00:62A4  DB B5                   in  a,(#B5)                     ; Read its value
    7252   00:62A6  F6 08                   or  8                           ; Start counting time again
    7253   00:62A8  D3 B5                   out (#B5),a                     ; Send
    7254   00:62AA  C9                      ret
    7255   00:62AB                      
    7256   00:62AB                      ; Pattern setup routine
    7257   00:62AB                      PATTERN_SETUP:
    7258   00:62AB  AF                      xor a                           ; Bit-16, V9938 and V9958 only
    7259   00:62AC  21 88 00                ld  hl,#0088                    ; Bit-15 to 0, pattern base address = #0088
    7260   00:62AF  CD 1F 63                call SET_VDP_WRITE
    7261   00:62B2  21 BF 62                ld  hl,PATTERN_DATA             ; Point to hl
    7262   00:62B5  06 60                   ld  b,8*12                      ; Redraw 12 chars, max 12 chars are suggested
    7263   00:62B7  0E 98                   ld  c,#98                       ; port #98
    7264   00:62B9                      OUTI_TO_VRAM_TMS9918:
    7265   00:62B9  ED A3                   outi                            ; Slower than otir but useful on TMS9918 which requires 29 T-states
    7266   00:62BB  C2 B9 62                jp  nz,OUTI_TO_VRAM_TMS9918     ; Therefore, don't use 'djnz' here!
    7267   00:62BE  C9                      ret
