    6257   00:5E8E  CB 7F                   bit 7,a
    6258   00:5E90  C2 95 5E                jp  nz,GETSLTT1
    6259   00:5E93  E6 03                   and %11
    6260   00:5E95                      GETSLTT1:
    6261   00:5E95  F5                      push    af
    6262   00:5E96  C5                      push    bc
    6263   00:5E97  E5                      push    hl
    6264   00:5E98  CD AD 5E                call    GETWRK
