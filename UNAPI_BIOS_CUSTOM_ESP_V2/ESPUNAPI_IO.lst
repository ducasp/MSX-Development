    2089   00:4BC2  C2 38 4C                jp  nz,WAIT_MENU_SCMD_RESPONSE_END_NOK
    2090   00:4BC5  CB 47                   bit 0,a                         ; If nz has data
    2091   00:4BC7  20 08                   jr  nz,WAIT_MENU_SCMD_RESPONSE_ST1.1
    2092   00:4BC9  CD 41 4C                call    HLTIMEOUT
    2093   00:4BCC  20 F0                   jr  nz,WAIT_MENU_SCMD_RESPONSE_ST1
