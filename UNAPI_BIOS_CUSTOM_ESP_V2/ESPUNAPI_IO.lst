    2115   00:4BE9                      WAIT_MENU_SCMD_RESPONSE_RC.1:
    2116   00:4BE9                          RECEIVE_DATA
    2116   00:4BE9  DB 06             >     in a,(IN_DATA_PORT)
    2117   00:4BEB  B7                      or  a                           ; 0?
    2118   00:4BEC                          ; If not, done
    2119   00:4BEC  C2 3D 4C                jp  nz,WAIT_MENU_SCMD_RESPONSE_END_NOK
    2120   00:4BEF                          ; Next byte is how many access points are available
    2121   00:4BEF                      WAIT_MENU_SCMD_RESPONSE_ST2A:
