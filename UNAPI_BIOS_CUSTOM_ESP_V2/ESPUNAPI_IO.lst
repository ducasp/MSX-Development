    3866   00:53E1  CB 47             >     bit 0,a
    3867   00:53E3  20 05                   jr  nz,TCPIP_UDP_RCV_PORT_ST1.1
    3868   00:53E5  CD 18 53                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3869   00:53E8  18 F5                   jr  TCPIP_UDP_RCV_PORT_ST1
    3870   00:53EA                      TCPIP_UDP_RCV_PORT_ST1.1:
    3871   00:53EA                          ; nz, get it
    3872   00:53EA                          RECEIVE_DATA
    3872   00:53EA  DB 06             >     in a,(IN_DATA_PORT)
