    2779   00:4ED9                          CHECK_DATA
    2779   00:4ED9  DB 07             >     in  a,(IN_STS_PORT)
    2779   00:4EDB  CB 47             >     bit 0,a
    2780   00:4EDD  20 05                   jr  nz,TCPIP_GET_CAPAB_BLK3_ST2.1
    2781   00:4EDF  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2782   00:4EE2  18 F5                   jr  TCPIP_GET_CAPAB_BLK3_ST2
