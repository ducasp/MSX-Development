    5868   00:5CF9                      SSH_AUTH_GET_CHALLENGE_ST2A.1:
    5869   00:5CF9                          ; nz, high byte count of bytes to receive
    5870   00:5CF9                          RECEIVE_DATA
    5870   00:5CF9  DB 06             >     in a,(IN_DATA_PORT)
    5871   00:5CFB  67                      ld h,a
    5872   00:5CFC                      SSH_AUTH_GET_CHALLENGE_ST2B:
    5873   00:5CFC                          CHECK_DATA
    5873   00:5CFC  DB 07             >     in  a,(IN_STS_PORT)
    5873   00:5CFE  CB 47             >     bit 0,a
    5874   00:5D00  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_ST2B.1
    5875   00:5D02  CD AD 5A                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5876   00:5D05  18 F5                   jr  SSH_AUTH_GET_CHALLENGE_ST2B
    5877   00:5D07                      SSH_AUTH_GET_CHALLENGE_ST2B.1:
    5878   00:5D07                          ; nz, low byte count of bytes to receive
    5879   00:5D07                          RECEIVE_DATA
    5879   00:5D07  DB 06             >     in a,(IN_DATA_PORT)
    5880   00:5D09  6F                      ld  l,a
    5881   00:5D0A  CD FC 5E                call    GETBYTE                 ; if return was err buff...
    5882   00:5D0D  D6 0D                   sub 13
    5883   00:5D0F  20 1F                   jr  nz,SSH_AUTH_GET_CHALLENGE_ST2BB.1
    5884   00:5D11                          ; If here we need to have A as 13, B and C with needed buffer size
    5885   00:5D11                      SSH_AUTH_GET_CHALLENGE_BUFERRA:
    5886   00:5D11                          CHECK_DATA
    5886   00:5D11  DB 07             >     in  a,(IN_STS_PORT)
    5886   00:5D13  CB 47             >     bit 0,a
    5887   00:5D15  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_BUFERRA.1
