    2966   00:4FC7  D3 07             >     out (OUT_TX_PORT),a
    2967   00:4FC9  AF                      xor a
    2968   00:4FCA                          SEND_DATA                       ; Send the command size msb
    2968   00:4FCA  D3 07             >     out (OUT_TX_PORT),a
    2969   00:4FCC  3C                      inc a
    2970   00:4FCD                          SEND_DATA                       ; Send the command size lsb
    2970   00:4FCD  D3 07             >     out (OUT_TX_PORT),a
    2971   00:4FCF  78                      ld  a,b
    2972   00:4FD0                          SEND_DATA
    2972   00:4FD0  D3 07             >     out (OUT_TX_PORT),a
    2973   00:4FD2                      
    2974   00:4FD2                          ; Now wait up to 600 ticks to get response
    2975   00:4FD2  21 58 02                ld  hl,600
    2976   00:4FD5  CD EC 5E                call    SETCOUNTER
    2977   00:4FD8                      TCPIP_GET_IPINFO_ST1:
    2978   00:4FD8                          CHECK_DATA
    2978   00:4FD8  DB 07             >     in  a,(IN_STS_PORT)
    2978   00:4FDA  CB 47             >     bit 0,a
    2979   00:4FDC  20 05                   jr  nz,TCPIP_GET_IPINFO_ST1.1
    2980   00:4FDE  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2981   00:4FE1  18 F5                   jr  TCPIP_GET_IPINFO_ST1
