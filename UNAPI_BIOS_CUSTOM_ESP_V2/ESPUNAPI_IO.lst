    5870   00:5D01                      SSH_AUTH_GET_CHALLENGE_ST2A.1:
    5871   00:5D01                          ; nz, high byte count of bytes to receive
    5872   00:5D01                          RECEIVE_DATA
    5872   00:5D01  DB 06             >     in a,(IN_DATA_PORT)
    5873   00:5D03  67                      ld h,a
    5874   00:5D04                      SSH_AUTH_GET_CHALLENGE_ST2B:
    5875   00:5D04                          CHECK_DATA
    5875   00:5D04  DB 07             >     in  a,(IN_STS_PORT)
    5875   00:5D06  CB 47             >     bit 0,a
    5876   00:5D08  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_ST2B.1
    5877   00:5D0A  CD B5 5A                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5878   00:5D0D  18 F5                   jr  SSH_AUTH_GET_CHALLENGE_ST2B
    5879   00:5D0F                      SSH_AUTH_GET_CHALLENGE_ST2B.1:
    5880   00:5D0F                          ; nz, low byte count of bytes to receive
    5881   00:5D0F                          RECEIVE_DATA
    5881   00:5D0F  DB 06             >     in a,(IN_DATA_PORT)
    5882   00:5D11  6F                      ld  l,a
    5883   00:5D12  CD 04 5F                call    GETBYTE                 ; if return was err buff...
    5884   00:5D15  D6 0D                   sub 13
    5885   00:5D17  20 1F                   jr  nz,SSH_AUTH_GET_CHALLENGE_ST2BB.1
    5886   00:5D19                          ; If here we need to have A as 13, B and C with needed buffer size
    5887   00:5D19                      SSH_AUTH_GET_CHALLENGE_BUFERRA:
    5888   00:5D19                          CHECK_DATA
    5888   00:5D19  DB 07             >     in  a,(IN_STS_PORT)
    5888   00:5D1B  CB 47             >     bit 0,a
    5889   00:5D1D  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_BUFERRA.1
    5890   00:5D1F  CD B5 5A                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5891   00:5D22  18 F5                   jr  SSH_AUTH_GET_CHALLENGE_BUFERRA
    5892   00:5D24                      SSH_AUTH_GET_CHALLENGE_BUFERRA.1:
    5893   00:5D24                          ; nz, low byte count of bytes to receive
    5894   00:5D24                          RECEIVE_DATA
    5894   00:5D24  DB 06             >     in a,(IN_DATA_PORT)
    5895   00:5D26  4F                      ld c,a
    5896   00:5D27                      SSH_AUTH_GET_CHALLENGE_BUFERRB:
    5897   00:5D27                          CHECK_DATA
    5897   00:5D27  DB 07             >     in  a,(IN_STS_PORT)
    5897   00:5D29  CB 47             >     bit 0,a
    5898   00:5D2B  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_BUFERRB.1
    5899   00:5D2D  CD B5 5A                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5900   00:5D30  18 F5                   jr  SSH_AUTH_GET_CHALLENGE_BUFERRB
    5901   00:5D32                      SSH_AUTH_GET_CHALLENGE_BUFERRB.1:
    5902   00:5D32                          ; nz, high byte count of bytes to receive
    5903   00:5D32                          RECEIVE_DATA
    5903   00:5D32  DB 06             >     in a,(IN_DATA_PORT)
    5904   00:5D34  47                      ld  b,a
    5905   00:5D35  3E 0D                   ld  a,13                        ; ERR BUFF
    5906   00:5D37  C9                      ret
    5907   00:5D38                          ; If here, should be ok and will get the data
    5908   00:5D38                      SSH_AUTH_GET_CHALLENGE_ST2BB.1:
    5909   00:5D38  7D                      ld  a,l
    5910   00:5D39  B4                      or  h
    5911   00:5D3A                          ; if it was 0, no data
    5912   00:5D3A  CA EA 5A                jp  z,TCPIP_TCP_RCV_RET_NODATA  ; not a typo, no need to make the same code again
    5913   00:5D3D                          ; Ok, we need to get the flags that will go to HL, we get it in BC and then push to the stack
    5914   00:5D3D                      SSH_AUTH_GET_CHALLENGE_FLAGSA:
