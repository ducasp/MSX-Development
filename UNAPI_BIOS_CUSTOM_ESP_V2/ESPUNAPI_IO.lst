    1292   00:46AE  3E 0D                   ld  a,#0d
    1293   00:46B0  CD A2 00                call    CHPUT
    1294   00:46B3  3E 0A                   ld  a,#0a
    1295   00:46B5  CD A2 00                call    CHPUT
    1296   00:46B8  C3 FD 46                jp  WIFI_CONNECT_AP_PWDQ        ; And the rest is handled like if menu selected
    1297   00:46BB                      WIFI_CONNECT_ME_BS:
    1298   00:46BB  AF                      xor a
    1299   00:46BC  B9                      cp  c                           ; Has any data to delete?
    1300   00:46BD  28 9B                   jr  z,WIFI_CONNECT_MANUAL_ENTRY ; No
    1301   00:46BF                          ; Yes
    1302   00:46BF  2B                      dec hl                          ; Decrement pointer
    1303   00:46C0  0D                      dec c                           ; Decrement counter
    1304   00:46C1  3E 08                   ld  a,8                         ; Backspace
    1305   00:46C3  CD A2 00                call    CHPUT                   ; Print it
    1306   00:46C6  3E 20                   ld  a,' '                       ; Space
    1307   00:46C8  CD A2 00                call    CHPUT                   ; Print it
    1308   00:46CB  3E 08                   ld  a,8                         ; Backspace
    1309   00:46CD  CD A2 00                call    CHPUT                   ; Print it
    1310   00:46D0  18 88                   jr  WIFI_CONNECT_MANUAL_ENTRY   ; Return
    1311   00:46D2                      WIFI_ME_CHECK_INPUT:
    1312   00:46D2  AF                      xor a
    1313   00:46D3  B9                      cp  c                           ; Has received any data?
    1314   00:46D4  28 84                   jr  z,WIFI_CONNECT_MANUAL_ENTRY ; No
    1315   00:46D6  C3 87 46                jp  WIFI_CONNECT_ME_0_TERM      ; Yes, so handle SSID input termination
    1316   00:46D9                      
    1317   00:46D9                      WIFI_CONNECT_SELECTION_OK:
    1318   00:46D9  CD A2 00                call    CHPUT                   ; Valid input, print it
    1319   00:46DC  1E 30                   ld  e,'0'
    1320   00:46DE  93                      sub a,e                         ; Get in decimal
    1321   00:46DF  5F                      ld  e,a                         ; Back in E
    1322   00:46E0                          ; IX has the AP list, A which one has been selected, now our routine will do it
    1323   00:46E0  3E 0D                   ld  a,#0d
    1324   00:46E2  CD A2 00                call    CHPUT
    1325   00:46E5  3E 0A                   ld  a,#0a
    1326   00:46E7  CD A2 00                call    CHPUT
    1327   00:46EA  DD E5                   push    ix
    1328   00:46EC  E1                      pop hl                          ; put IX in HL
    1329   00:46ED                      WIFI_CONNECT_AP_SRCH:
