    5830   00:5CB7  CB 47             >     bit 0,a
    5831   00:5CB9  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_ST1.1
    5832   00:5CBB  CD AD 5A                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
