    4920   00:587D                      ;        C  = Close reason (only if ERR_NO_CONN is returned)
    4921   00:587D                      ;        HL = Number of total available incoming bytes
    4922   00:587D                      ;        DE = Number of urgent available incoming bytes
    4923   00:587D                      ;        IX = Available free space in the output buffer
    4924   00:587D                      ;             (0FFFFh = infinite)
    4925   00:587D                      ;
    4926   00:587D                      ;Connection information block consists of:
    4927   00:587D                      ;
    4928   00:587D                      ;    +0 (4): Remote IP address
    4929   00:587D                      ;    +4 (2): Remote port
    4930   00:587D                      ;    +6 (2): Local port
    4931   00:587D                      TCPIP_TCP_STATE_ERROR:
    4932   00:587D                          ; next two bytes are size bytes, don't care
    4933   00:587D  47                      ld  b,a                         ; save error in b
    4934   00:587E  0E 02                   ld  c,2
    4935   00:5880                      TCPIP_TCP_STATE_ERROR2:
    4936   00:5880                          CHECK_DATA
    4936   00:5880  DB 07             >     in  a,(IN_STS_PORT)
    4936   00:5882  CB 47             >     bit 0,a
