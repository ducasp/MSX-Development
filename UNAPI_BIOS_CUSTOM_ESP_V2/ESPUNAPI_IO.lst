    7162   00:623E                      ;*********************************************
    7163   00:623E                      ;***       WAIT_RESPONSE_FROM_ESP          ***
    7164   00:623E                      ;*** Will wait ESP to send a response,     ***
    7165   00:623E                      ;*** discarding all data until it is found.***
    7166   00:623E                      ;***                                       ***
    7167   00:623E                      ;*** Inputs:                               ***
    7168   00:623E                      ;*** HL - Expected response string         ***
    7169   00:623E                      ;*** A - Response Size                     ***
    7170   00:623E                      ;*** DE - TimeOut in ticks                 ***
    7171   00:623E                      ;***                                       ***
    7172   00:623E                      ;*** Output:                               ***
    7173   00:623E                      ;*** A - 0 if response received            ***
    7174   00:623E                      ;*** otherwise response not received and   ***
    7175   00:623E                      ;*** timed-out.                            ***
    7176   00:623E                      ;***                                       ***
    7177   00:623E                      ;*** Changes HL, BC, AF, DE, IX            ***
    7178   00:623E                      ;*********************************************
    7179   00:623E                      WRFE_WAIT_DATA:
    7180   00:623E                          LOAD_STS_PORT_IN_A
    7180   00:623E  DB 07             >     in  a,(IN_STS_PORT)
    7181   00:6240  CB 6F                   bit 5,a                         ; If nz Port #07 is not available
    7182   00:6242  20 06                   jr  nz,WRFE_STS_NOT_AVAILABLE
    7183   00:6244  CB 47                   bit 0,a                         ; if nz has data
    7184   00:6246  C0                      ret nz
    7185   00:6247  1B                      dec de
    7186   00:6248  76                      halt
    7187   00:6249  C9                      ret
    7188   00:624A                      WRFE_STS_NOT_AVAILABLE:
    7189   00:624A  11 00 00                ld  de,0
    7190   00:624D  AF                      xor a
    7191   00:624E  C9                      ret
    7192   00:624F                      
    7193   00:624F                      WRFE_COMPARE:
    7194   00:624F  47                      ld  b,a
    7195   00:6250  7E                      ld  a,(hl)
    7196   00:6251  B8                      cp  b
    7197   00:6252  C0                      ret nz
    7198   00:6253  23                      inc hl
    7199   00:6254  C9                      ret
    7200   00:6255                      
    7201   00:6255                      WAIT_RESPONSE_FROM_ESP:
    7202   00:6255  4F                      ld  c,a                         ; Response size in C
    7203   00:6256  E5                      push    hl                      ; Save HL
    7204   00:6257  AF                      xor a
    7205   00:6258                      WRFE_ST1:
    7206   00:6258  DD 67                   ld  ixh,a                       ; We start at index 0
    7207   00:625A                      
    7208   00:625A                      WRFE_LOOP:
    7209   00:625A  CD 3E 62                call    WRFE_WAIT_DATA
    7210   00:625D  20 07                   jr  nz,WRFE_LOOP.1
    7211   00:625F  7B                      ld  a,e
    7212   00:6260  B2                      or  d
    7213   00:6261  CA 80 62                jp  z,WRFE_RET_ERROR
    7214   00:6264  18 F4                   jr  WRFE_LOOP
    7215   00:6266                      WRFE_LOOP.1:
    7216   00:6266                          ; nz, check the data
    7217   00:6266                          RECEIVE_DATA
    7217   00:6266  DB 06             >     in a,(IN_DATA_PORT)
    7218   00:6268                          ; Ok, now the byte is in A, let's compare
    7219   00:6268                      WRFE_IDXCMD:
    7220   00:6268  CD 4F 62                call WRFE_COMPARE
    7221   00:626B                          ; if match
    7222   00:626B  28 07                   jr  z,WRFE_RSP_MATCH
    7223   00:626D                          ; did not match, let's zero the rsp index
    7224   00:626D  AF                      xor a
    7225   00:626E  DD 67                   ld  ixh,a                       ; re-start at index 0
    7226   00:6270  E1                      pop hl                          ; restore the response index
    7227   00:6271  E5                      push    hl                      ; and keep it in stack
    7228   00:6272                          ; back to get another byte
    7229   00:6272  18 E6                   jr  WRFE_LOOP
    7230   00:6274                      WRFE_RSP_MATCH:
    7231   00:6274                          ; match
    7232   00:6274  DD 24                   inc ixh
    7233   00:6276  DD 7C                   ld  a,ixh
    7234   00:6278  B9                      cp  c
    7235   00:6279                          ; if a = c done and response is success
    7236   00:6279  28 02                   jr  z,WRFE_RET_OK
    7237   00:627B                          ; not done, back to get more bytes
    7238   00:627B  18 DD                   jr  WRFE_LOOP
    7239   00:627D                      WRFE_RET_OK:
    7240   00:627D  E1                      pop hl
    7241   00:627E  AF                      xor a
    7242   00:627F  C9                      ret
    7243   00:6280                      WRFE_RET_ERROR:
    7244   00:6280  E1                      pop hl
    7245   00:6281  3E 01                   ld  a,1
    7246   00:6283  C9                      ret
    7247   00:6284                      
    7248   00:6284                      ;*********************************************
    7249   00:6284                      ;***            CHECK_ESP_TYPE             ***
    7250   00:6284                      ;*** If ESP32, NZ will be set and A = 1, if***
    7251   00:6284                      ;*** not NZ will be reset and A=0          ***
    7252   00:6284                      ;*********************************************
    7253   00:6284                      CHECK_ESP_TYPE:
    7254   00:6284  E5                      push    hl
    7255   00:6285  D5                      push    de
    7256   00:6286  FD E5                   push    iy
    7257   00:6288  DD E5                   push    ix
    7258   00:628A                          CLEAR_UART                      ; Clear UART
    7258   00:628A  3E 14             >     ld  a,20
    7258   00:628C  D3 06             >     out (OUT_CMD_PORT),a
    7259   00:628E  3E 62                   ld  a,CMD_GET_FW_TYPE
    7260   00:6290                          SEND_DATA
    7260   00:6290  D3 07             >     out (OUT_TX_PORT),a
    7261   00:6292  21 06 00                ld  hl,6                        ; Wait up to 100ms
    7262   00:6295  ED 5B 76 F6             ld  de,(TXTTAB)                 ; Borrow Basic program area for now....
    7263   00:6299  DD 6B                   ld  ixl,e
    7264   00:629B  DD 62                   ld  ixh,d                       ; Address in IX
    7265   00:629D  CD 33 4B                call    WAIT_MENU_CMD_RESPONSE
    7266   00:62A0  F5                      push    af
    7267   00:62A1  CD 3F 60                call    GETSLT
    7268   00:62A4  CD AC 60                call    GETMEMPOINTERADDR       ; This is where we are going to store our memory area address
    7269   00:62A7  11 07 00                ld  de,7
    7270   00:62AA  19                      add hl,de
    7271   00:62AB  F1                      pop af
    7272   00:62AC  77                      ld  (hl),a
    7273   00:62AD  B7                      or  a
    7274   00:62AE  DD E1                   pop ix
    7275   00:62B0  FD E1                   pop iy
    7276   00:62B2  D1                      pop de
    7277   00:62B3  E1                      pop hl
    7278   00:62B4  C9                      ret
    7279   00:62B5                      
    7280   00:62B5                      ;*********************************************
    7281   00:62B5                      ;***              RESET ESP                ***
    7282   00:62B5                      ;*** If RESET ok, A will be 0, otherwise   ***
    7283   00:62B5                      ;*** failure                               ***
    7284   00:62B5                      ;*********************************************
    7285   00:62B5                      RESET_ESP:
    7286   00:62B5                          ; Is ESP installed?
    7287   00:62B5                          CLEAR_UART                      ; Clear UART
    7287   00:62B5  3E 14             >     ld  a,20
    7287   00:62B7  D3 06             >     out (OUT_CMD_PORT),a
    7288   00:62B9  3E 3F                   ld  a,CMD_QUERY_ESP
    7289   00:62BB                          SEND_DATA
    7289   00:62BB  D3 07             >     out (OUT_TX_PORT),a
    7290   00:62BD  21 4F 64                ld  hl,RSP_CMD_QUERY_ESP        ; Expected response
    7291   00:62C0  11 3C 00                ld  de,60                       ; Up to 1s @ 60Hz
    7292   00:62C3  3E 02                   ld  a,RSP_CMD_QUERY_ESP_SIZE    ; Size of response
    7293   00:62C5  CD 55 62                call    WAIT_RESPONSE_FROM_ESP
    7294   00:62C8  B7                      or  a
    7295   00:62C9  3E 01                   ld  a,1
    7296   00:62CB  28 03                   jr  z,RESET_ESP_INIT            ; ESP Found
    7297   00:62CD  06 00                   ld  b,0                         ; 0 if no response
    7298   00:62CF  C9                      ret
    7299   00:62D0                      RESET_ESP_INIT:
    7300   00:62D0  06 03                   ld  b,3                         ; Retry up to 10 times
    7301   00:62D2                      RESET_ESP_LOOP:
    7302   00:62D2                          CLEAR_UART
    7302   00:62D2  3E 14             >     ld  a,20
    7302   00:62D4  D3 06             >     out (OUT_CMD_PORT),a
    7303   00:62D6                          SET_SPEED
    7303   00:62D6  AF                >     xor a
    7303   00:62D7  D3 06             >     out (OUT_CMD_PORT),a
    7304   00:62D9  76                      halt
    7305   00:62DA  76                      halt                            ; Wait a little to make sure speed is adjusted
    7306   00:62DB  3E 57                   ld  a,CMD_WRESET_ESP
    7307   00:62DD                          SEND_DATA
    7307   00:62DD  D3 07             >     out (OUT_TX_PORT),a
    7308   00:62DF  21 4A 64                ld  hl,RSP_CMD_RESET_ESP        ; Expected response
    7309   00:62E2  11 5A 00                ld  de,90                       ; Up to 1.5s @ 60Hz
    7310   00:62E5  3E 05                   ld  a,RSP_CMD_RESET_ESP_SIZE    ; Size of response
    7311   00:62E7  C5                      push    bc                      ; Save retry counter
    7312   00:62E8  CD 55 62                call    WAIT_RESPONSE_FROM_ESP
    7313   00:62EB  C1                      pop bc                          ; restore retry counter
    7314   00:62EC  B7                      or  a                           ; Did WAIT RESPONSE return zero?
    7315   00:62ED  C8                      ret z                           ; Yes, Warm Reset Ok
    7316   00:62EE  10 E2                   djnz RESET_ESP_LOOP             ; No, decrement retry counter and let the loop check
    7317   00:62F0                          ; No more retries? Then check if it is old ESP FW
    7318   00:62F0                      RESET_CHK_IF_INSTALLED:
    7319   00:62F0                          ; No more retries? Then it is old ESP FW
    7320   00:62F0  06 01                   ld  b,1
    7321   00:62F2  C9                      ret
    7322   00:62F3                      
    7323   00:62F3                      ;*********************************************
    7324   00:62F3                      ;***              SET TIME                 ***
    7325   00:62F3                      ;*** H - Hour                              ***
    7326   00:62F3                      ;*** L - Minutes                           ***
    7327   00:62F3                      ;*** D - Seconds                           ***
    7328   00:62F3                      ;***                                       ***
    7329   00:62F3                      ;*** A - 0 if Ok otherwise invalid time    ***
    7330   00:62F3                      ;*********************************************
    7331   00:62F3                      SET_TIME:
    7332   00:62F3  7C                      ld  a,h                         ; Hour in A
    7333   00:62F4  FE 18                   cp  24                          ; Compare to 24
    7334   00:62F6  30 12                   jr  nc,SET_TIME_ERR             ; If 24 or more, invalid
    7335   00:62F8  7D                      ld  a,l                         ; Minutes in A
    7336   00:62F9  FE 3C                   cp  60                          ; Compare to 60
    7337   00:62FB  30 0D                   jr  nc,SET_TIME_ERR             ; If 60 or more, invalid
    7338   00:62FD  7A                      LD  a,d                         ; Seconds in D
    7339   00:62FE  FE 3C                   cp  60                          ; Compare to 60
    7340   00:6300  30 08                   jr  nc,SET_TIME_ERR             ; If 60 or more invalid
    7341   00:6302  44                      ld  b,h                         ; Hour in B
    7342   00:6303  4D                      ld  c,l                         ; Minutes in C
    7343   00:6304  5A                      ld  e,d                         ; Seconds in E
    7344   00:6305  CD 0D 63                call    SET_RTC_TIME            ; Set time in RTC
    7345   00:6308  AF                      xor a                           ; 0 in A
    7346   00:6309  C9                      ret                             ; Return
    7347   00:630A                      ;   Invalid parameter
    7348   00:630A                      SET_TIME_ERR:
    7349   00:630A  3E 01                   ld  a,1                         ; Invalid Time
    7350   00:630C  C9                      ret                             ; Return
    7351   00:630D                      
    7352   00:630D                      SET_RTC_TIME:
    7353   00:630D  6B                      ld  l,e                         ; Seconds in L
    7354   00:630E  61                      ld  h,c                         ; Minutes in H
    7355   00:630F  50                      ld  d,b                         ; Hour in D
    7356   00:6310  CD 68 63                call    STOP_RTC_COUNT_SET_MODE0; Select RTC Register 13, and set Mode / Page 0
    7357   00:6313  3E 0F                   ld  a,#F                        ; Register F
    7358   00:6315  D3 B4                   out (#B4),a
    7359   00:6317  3E 02                   ld  a,2
    7360   00:6319  D3 B5                   out (#B5),a                     ; Timer reset seconds and on both clock pulses
    7361   00:631B  1E 00                   ld  e,0                         ; Start at register 0
    7362   00:631D  C3 A3 63                jp  SET_RTC_DATE.1              ; And save L, H and D, function will return from there
    7363   00:6320                      
    7364   00:6320                      ;*********************************************
    7365   00:6320                      ;***              SET DATE                 ***
    7366   00:6320                      ;*** HL - Year from 1980 to 2079           ***
    7367   00:6320                      ;*** D - Month from 1 to 12                ***
    7368   00:6320                      ;*** E - Day from 1 to 31                  ***
    7369   00:6320                      ;***                                       ***
    7370   00:6320                      ;*** A - 0 if Ok otherwise invalid Date    ***
    7371   00:6320                      ;*********************************************
    7372   00:6320                      SET_DATE:
    7373   00:6320  01 44 F8                ld  bc,#F844
    7374   00:6323  09                      add hl,bc
    7375   00:6324  30 32                   jr  nc,SET_DATE_ERR             ; No carry -> Year is less than 1980, invalid date
    7376   00:6326  7C                      ld  a,h
    7377   00:6327  B7                      or  a
    7378   00:6328  20 2E                   jr  nz,SET_DATE_ERR             ; If H is set, means year is greater than 2235 ,invalid
    7379   00:632A  7D                      ld  a,l
    7380   00:632B  FE 64                   cp  100
    7381   00:632D  30 29                   jr  nc,SET_DATE_ERR             ; If L >= 100 year is greater than 2079, invalid
    7382   00:632F  47                      ld  b,a                         ; Year - 1980 in B
    7383   00:6330  7A                      ld  a,d                         ; Now test month
    7384   00:6331  3D                      dec a
    7385   00:6332  FE 0C                   cp  12                          ; If 12 or less this should carry
    7386   00:6334  30 22                   jr  nc,SET_DATE_ERR             ; otherwise invalid
    7387   00:6336  21 5B 63                ld  hl,DAYS_IN_MONTH            ; Days in Month table
    7388   00:6339  85                      add a,l                         ; add our month
    7389   00:633A  6F                      ld  l,a                         ; back in L
    7390   00:633B  30 01                   jr  nc,SET_DATE1                ; no carry done
    7391   00:633D  24                      inc h                           ; otherwise increase H
    7392   00:633E                      SET_DATE1:
    7393   00:633E  3E 1C                   ld  a,28                        ; 28 days
    7394   00:6340  BE                      cp  (hl)                        ; If month is 28 days, February, need to check if leap and limit is 29 in this year
    7395   00:6341  20 08                   jr  nz,SET_DATE2                ; if not, skip below code , so probably above check is if month is february
    7396   00:6343  78                      ld  a,b                         ; Year - 1980 in A again
    7397   00:6344  E6 03                   and 3                           ; if other than 0, non divisible per 4, so not a leap year
    7398   00:6346  20 03                   jr  nz,SET_DATE2                ; Regular year
    7399   00:6348  21 67 63                ld  hl,DAYS_IN_FEBRUARY_LEAP    ; HL has address of 29 days, maximum number of days for february in leap year
    7400   00:634B                      SET_DATE2:
    7401   00:634B  7B                      ld  a,e                         ; Day of month in A
    7402   00:634C  3D                      dec a                           ; Decrement
    7403   00:634D  BE                      cp  (hl)                        ; Compare with Days in month
    7404   00:634E  30 08                   jr  nc,SET_DATE_ERR             ; If day is greater than how many days in month, invalid
    7405   00:6350  6B                      ld  l,e                         ; Day of month in L
    7406   00:6351  62                      ld  h,d                         ; Month in H
    7407   00:6352  50                      ld  d,b                         ; Year - 1980 in D
    7408   00:6353  CD 8D 63                call    SET_RTC_DATE            ; Set date in RTC
    7409   00:6356  AF                      xor a                           ; A = 0
    7410   00:6357  C9                      ret                             ; Success
    7411   00:6358                      ;   Invalid parameter
    7412   00:6358                      SET_DATE_ERR:
    7413   00:6358  3E 01                   ld  a,1
    7414   00:635A  C9                      ret
    7415   00:635B                      
    7416   00:635B                      ; Table of top day value for each month
    7417   00:635B                      DAYS_IN_MONTH:          db  31,28,31,30,31,30,31,31,30,31,30,31
    7417   00:635B  1F 1C 1F 1E 1F 1E 1F 1F 1E 1F 1E 1F 
    7418   00:6367                      ; And top day value in February when Leap Year
    7419   00:6367  1D                  DAYS_IN_FEBRUARY_LEAP:  db  29
    7420   00:6368                      
    7421   00:6368                      ; Will select Mode 00 (Date and Time page) and stop clock counting
    7422   00:6368                      ; Register D value will be left in A
    7423   00:6368                      STOP_RTC_COUNT_SET_MODE0:
    7424   00:6368  3E 0D                   ld  a,#D
    7425   00:636A  D3 B4                   out (#B4),a                     ; Select RTC register D (mode)
    7426   00:636C  DB B5                   in  a,(#B5)                     ; read register D
    7427   00:636E  E6 04                   and 4                           ; Save Alarm EN setting, and mode register is 00 and stop counting time
    7428   00:6370  D3 B5                   out (#B5),a                     ; And save
    7429   00:6372  C9                      ret
    7430   00:6373                      
    7431   00:6373                      ; Will get a non BCD value in A, convert it to BCD and then save it in
    7432   00:6373                      ; a register pair that starts in the register indicated in E
    7433   00:6373                      ; Register E will have the next register after that register pair
    7434   00:6373                      RTC_SAVE_REGISTERPAIR:
    7435   00:6373  4F                      ld  c,a                         ; Save A in C
    7436   00:6374  AF                      xor a                           ; 0 in A
    7437   00:6375  06 08                   ld  b,8                         ; 8 in B, number of bits for conversion
    7438   00:6377                      RTC_SAVE_REGISTERPAIR.1:
    7439   00:6377  CB 01                   rlc c                           ; Leftmost bit in Carry
    7440   00:6379  8F                      adc a,a                         ; A = (A * 2) + Carry
    7441   00:637A  27                      daa                             ; decimal adjust A, shift = BCD x 2 + carry
    7442   00:637B  10 FA                   djnz    RTC_SAVE_REGISTERPAIR.1 ; Repeat for 8 bits
    7443   00:637D  CD 84 63                call    SET_RTC_REG             ; Save LSB in register and increase register address
    7444   00:6380  0F                      rrca
    7445   00:6381  0F                      rrca
    7446   00:6382  0F                      rrca
    7447   00:6383  0F                      rrca                            ; now MSB is in LSB position
    7448   00:6384                      SET_RTC_REG:
    7449   00:6384  47                      ld  b,a                         ; save value to set in B
    7450   00:6385  7B                      ld  a,e                         ; and now register address in A
    7451   00:6386  D3 B4                   out (#B4),a                     ; The register we want to set
    7452   00:6388  78                      ld  a,b                         ; restore value
    7453   00:6389  D3 B5                   out (#B5),a                     ; save it
    7454   00:638B  1C                      inc e                           ; increase register address, as this usually is done in pairs
    7455   00:638C  C9                      ret
    7456   00:638D                      
    7457   00:638D                      ; Auxiliary function for SET_DATE and SET_TIME
    7458   00:638D                      ; SET_RTC_DATE will save date, parameters:
    7459   00:638D                      ; L - Day
    7460   00:638D                      ; H - Month
    7461   00:638D                      ; D - Years since 1980
    7462   00:638D                      ; All values are regular values, this function will properly convert them
    7463   00:638D                      ;
    7464   00:638D                      ; SET_RTC_DATE.1 is used by SET_TIME as well
    7465   00:638D                      ; It will save three register pairs, starting with the register in E
    7466   00:638D                      ; First pair is updated with value in L
    7467   00:638D                      ; Second pair is updated with value in H
    7468   00:638D                      ; Third pair is updated with value in D
    7469   00:638D                      SET_RTC_DATE:
    7470   00:638D  CD 68 63                call    STOP_RTC_COUNT_SET_MODE0; Select RTC Register 13, and set Mode / Page 0
    7471   00:6390  F6 01                   or  1                           ; Set Bit 0, so Mode / Page 1
    7472   00:6392  D3 B5                   out (#B5),a                     ; save it in register 13, now page 1 selected
    7473   00:6394  3E 0B                   ld  a,#B                        ; Leap Year Counter Register
    7474   00:6396  D3 B4                   out (#B4),a                     ; Select it
    7475   00:6398  7A                      ld  a,d                         ; Load Years in leap year counter
    7476   00:6399  D3 B5                   out (#B5),a                     ; So it has count of leap years (0 is 1980, leap, and every time it is 4, leap year again)
    7477   00:639B  CD 68 63                call    STOP_RTC_COUNT_SET_MODE0; Select RTC Register 13 and set mode / page 0
    7478   00:639E  CD 68 63                call    STOP_RTC_COUNT_SET_MODE0; do it a second time... DOS does it, don't want to JYNX it :P
    7479   00:63A1  1E 07                   ld  e,7                         ; Register 7
    7480   00:63A3                      SET_RTC_DATE.1:
    7481   00:63A3  7D                      ld  a,l                         ; A has day
    7482   00:63A4  CD 73 63                call    RTC_SAVE_REGISTERPAIR   ; Will convert day to BCD and save in registers 7 and 8
    7483   00:63A7  7C                      ld  a,h                         ; A has month
    7484   00:63A8  CD 73 63                call    RTC_SAVE_REGISTERPAIR   ; Will convert month to BCD and save in register 9 and A
    7485   00:63AB  7A                      ld  a,d                         ; A has how many years since 1980
    7486   00:63AC  CD 73 63                call    RTC_SAVE_REGISTERPAIR   ; Will convert to BCD and save in register B and C
    7487   00:63AF  3E 0D                   ld  a,#D                        ; Register D
    7488   00:63B1  D3 B4                   out (#B4),a                     ; Send it
    7489   00:63B3  DB B5                   in  a,(#B5)                     ; Read its value
    7490   00:63B5  F6 08                   or  8                           ; Start counting time again
    7491   00:63B7  D3 B5                   out (#B5),a                     ; Send
    7492   00:63B9  C9                      ret
    7493   00:63BA                      
    7494   00:63BA                      ; Pattern setup routine
    7495   00:63BA                      PATTERN_SETUP:
    7496   00:63BA  AF                      xor a                           ; Bit-16, V9938 and V9958 only
    7497   00:63BB  21 88 00                ld  hl,#0088                    ; Bit-15 to 0, pattern base address = #0088
    7498   00:63BE  CD 2E 64                call SET_VDP_WRITE
    7499   00:63C1  21 CE 63                ld  hl,PATTERN_DATA             ; Point to hl
    7500   00:63C4  06 60                   ld  b,8*12                      ; Redraw 12 chars, max 12 chars are suggested
    7501   00:63C6  0E 98                   ld  c,#98                       ; port #98
    7502   00:63C8                      OUTI_TO_VRAM_TMS9918:
    7503   00:63C8  ED A3                   outi                            ; Slower than otir but useful on TMS9918 which requires 29 T-states
    7504   00:63CA  C2 C8 63                jp  nz,OUTI_TO_VRAM_TMS9918     ; Therefore, don't use 'djnz' here!
    7505   00:63CD  C9                      ret
    7506   00:63CE                      PATTERN_DATA:
    7507   00:63CE                      ; Pattern-01 is CHR$(1)+CHR$(81) = SCAN_TERMINATOR_OPEN
    7508   00:63CE  06                      db  %00000110
