    2961   00:4FCF                      ;            3: Subnet mask
    2962   00:4FCF                      ;            4: Default gateway
    2963   00:4FCF                      ;            5: Primary DNS server IP address
    2964   00:4FCF                      ;            6: Secondary DNS server IP address
    2965   00:4FCF                      ;Output: A = Error code
    2966   00:4FCF                      ;        L.H.E.D = Requested address
