    2166   00:4C3D  DD E1                   pop ix
    2167   00:4C3F  D1                      pop de
    2168   00:4C40  C9                      ret
    2169   00:4C41                      
    2170   00:4C41                      ; This routine will check if HL is 0, if it is, will return immediatelly
    2171   00:4C41                      ; If it is not, will decrease HL value and halt (wait one interrupt)
    2172   00:4C41                      HLTIMEOUT:
    2173   00:4C41  7C                      ld  a,h
    2174   00:4C42  B5                      or  l
    2175   00:4C43  C8                      ret z
    2176   00:4C44  2B                      dec hl
    2177   00:4C45  76                      halt
