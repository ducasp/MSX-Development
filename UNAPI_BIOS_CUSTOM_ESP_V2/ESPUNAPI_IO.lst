    2179   00:4C47                      
    2180   00:4C47                      ; Routine to print the string addressed by HL
    2181   00:4C47                      PRINTHL:
    2182   00:4C47  7E                      ld  a,(hl)
    2183   00:4C48  B7                      or  a
    2184   00:4C49  C8                      ret z                           ; When string is finished, done!
    2185   00:4C4A  CD A2 00                call    CHPUT
    2186   00:4C4D  23                      inc hl
    2187   00:4C4E  C3 47 4C                jp  PRINTHL
    2188   00:4C51                      
    2189   00:4C51                      ; Routine to print the string addressed by HL on a line, if exceeding it, ends with ..
    2190   00:4C51                      PRINTHLINE:
    2191   00:4C51  C5                      push    bc
    2192   00:4C52  06 18                   ld  b,24
    2193   00:4C54                      PHLINEL:
