    3044   00:503D  18 F5                   jr  TCPIP_GET_IPINFO_IP_ST4
    3045   00:503F                      TCPIP_GET_IPINFO_IP_ST4.1:
    3046   00:503F                          ; nz, get it
    3047   00:503F                          RECEIVE_DATA
    3047   00:503F  DB 06             >     in a,(IN_DATA_PORT)
    3048   00:5041  57                      ld  d,a
    3049   00:5042                          ; done
    3050   00:5042  AF                      xor a
