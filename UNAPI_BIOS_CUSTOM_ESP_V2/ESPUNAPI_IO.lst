    2116   00:4BEE  C3 41 4C                jp  WAIT_MENU_SCMD_RESPONSE_END ; If time out waiting, return
    2117   00:4BF1                      WAIT_MENU_SCMD_RESPONSE_RC.1:
    2118   00:4BF1                          RECEIVE_DATA
    2118   00:4BF1  DB 06             >     in a,(IN_DATA_PORT)
    2119   00:4BF3  B7                      or  a                           ; 0?
    2120   00:4BF4                          ; If not, done
    2121   00:4BF4  C2 45 4C                jp  nz,WAIT_MENU_SCMD_RESPONSE_END_NOK
    2122   00:4BF7                          ; Next byte is how many access points are available
    2123   00:4BF7                      WAIT_MENU_SCMD_RESPONSE_ST2A:
    2124   00:4BF7                          CHECK_DATA
    2124   00:4BF7  DB 07             >     in  a,(IN_STS_PORT)
    2124   00:4BF9  CB 47             >     bit 0,a
