    4402   00:5619                      ;=========================
    4403   00:5619                      ;===     SSH_STATE     ===
    4404   00:5619                      ;=========================
    4405   00:5619                      ;Get the state of a SSH connection.
    4406   00:5619                      ;
    4407   00:5619                      ;Input:  A = 4
