    2151   00:4C27                      WAIT_MENU_SCMD_RESPONSE_GET_ENC.1:
    2152   00:4C27                          RECEIVE_DATA            ; Get data
    2152   00:4C27  DB 06             >     in a,(IN_DATA_PORT)
    2153   00:4C29  D6 4F                   sub 'O'                         ; If O, open, will be 0, otherwise, will be notzero
