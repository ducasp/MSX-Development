    4194   00:553E                      ;=========================
    4195   00:553E                      ;===  TCPIP_TCP_CLOSE  ===
    4196   00:553E                      ;=========================
    4197   00:553E                      ;Close a TCP connection.
    4198   00:553E                      ;
    4199   00:553E                      ;Input:  A = 14
    4200   00:553E                      ;        B = Connection number
