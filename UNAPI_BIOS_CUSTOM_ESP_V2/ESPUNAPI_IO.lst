     339   00:4000                      ;************************
     340   00:4000                      ;***  MSX ROM HEADER  ***
     341   00:4000                      ;************************
     342   00:4000                          org #4000
     343   00:4000  41 42                   db                  #41,#42
     344   00:4002  10 40                   dw                  INIT        ; Initialize ESP, if not found, won't install hook
     345   00:4004  00 00                   dw                  0           ; Statement
     346   00:4006  00 00                   dw                  0           ; Device
     347   00:4008  00 00                   dw                  0           ; Text
     348   00:400A  00 (6)                  ds                  6           ; Reserved
     349   00:4010                      
     350   00:4010                      ;==================
     351   00:4010                      ;===  Start-up  ===
     352   00:4010                      ;==================
     353   00:4010                      
     354   00:4010                      INIT:
     355   00:4010  7C                      ld  a,h                         ; Let's test if we are mirrored and being executed in wrong page
     356   00:4011  FE 40                   cp  #40                         ; is MSB 0x40?
     357   00:4013  C0                      ret nz                          ; if not, return, it is a mirror
     358   00:4014                          ; Let's set some System Variables
     359   00:4014  AF                      xor a                           ; a = #00
     360   00:4015  32 A9 FC                ld  (CSRSW),a                   ; cursor display is disabled
     361   00:4018  32 DB F3                ld  (CLIKSW),a                  ; when key press, key click disabled
     362   00:401B                          ; Let's intercept [DEL] key
     363   00:401B  3E 08                   ld  a,8
     364   00:401D  CD 41 01                call    SNSMAT
     365   00:4020  CB 5F                   bit 3,a                         ; Test [DEL]
     366   00:4022  C8                      ret z                           ; If DEL is pressed, UNAPI driver is not loaded and exits
     367   00:4023                          ; Let's check the Screen Mode, ref. https://www.msx.org/wiki/VDP_Table_Base_Address_Registers
     368   00:4023  3A E1 F3                ld  a,(REG2SAV)
     369   00:4026  FE 02                   cp  2
     370   00:4028  CA 32 40                jp  z,SCREEN_SETUP              ; If yes, is SCREEN 3
     371   00:402B  3A E3 F3                ld  a,(REG4SAV)
     372   00:402E  FE 00                   cp  0
     373   00:4030  28 06                   jr  z,IS_SCREEN1                ; If yes, is SCREEN 1
     374   00:4032                      SCREEN_SETUP:
     375   00:4032                          ; Let's set the SCREEN 1
     376   00:4032  3E 01                   ld  a,1                         ; a = #01
     377   00:4034  F7                      rst #30
     378   00:4035  00                      db  0
     379   00:4036  5F 00                   dw  CHGMOD                      ; SCREEN 1
     380   00:4038                      IS_SCREEN1:
     381   00:4038  3E 1D                   ld  a,29                        ; WIDTH 29
     382   00:403A  32 B0 F3                ld  (LINLEN),a
     383   00:403D                          ; We check if the Port F2 device is available
     384   00:403D                          READ_F2                         ; a = #FF, default value if it comes from power off or hard reset
     384   00:403D  DB F2             >     in  a,(PORT_F2)
     385   00:403F  2F                      cpl                             ; a = #FF - a
     386   00:4040  4F                      ld  c,a                         ; c = #00
     387   00:4041                          WRITE_F2                        ; a = #00
     387   00:4041  D3 F2             >     out (PORT_F2),a
     388   00:4043                          ; Wait 250ms to ensure a successful hard reset even if you press the button very quickly
     389   00:4043  CD E3 49                call    WAIT_250MS_AND_THEN_CONTINUE
     390   00:4046                          READ_F2                         ; a = #00?
     390   00:4046  DB F2             >     in  a,(PORT_F2)
     391   00:4048  2F                      cpl                             ; a = #FF - a
     392   00:4049                          WRITE_F2                        ; a = #FF?
     392   00:4049  D3 F2             >     out (PORT_F2),a
     393   00:404B  F5                      push    af
     394   00:404C  3E FE                   ld  a,#FE                       ; Preset #FE, unexpected error
     395   00:404E                          WRITE_F2                        ; on port #F2
     395   00:404E  D3 F2             >     out (PORT_F2),a
     396   00:4050  F1                      pop af
     397   00:4051  B9                      cp  c                           ; If not a = c, port #F2 is writable and available
     398   00:4052  28 3C                   jr  z,BOOT_FROM_POWER_OFF       ; If a = c, port #F2 is not available, let's proceed as "boot from power off"
     399   00:4054                          ; Ok, Port F2 device available
     400   00:4054  FE EF                   cp  #EF                         ; UNAPI driver has been disabled
     401   00:4056  20 03                   jr  nz,NOT_DISABLED_BY_F2       ; No, let's continue checking
     402   00:4058                          WRITE_F2                        ; If yes, UNAPI driver is not loaded and exits, but need to restore F2 port to not have a false error
     402   00:4058  D3 F2             >     out (PORT_F2),a
     403   00:405A  C9                      ret                             ; And our work is done
     404   00:405B                      NOT_DISABLED_BY_F2:
     405   00:405B  FE F0                   cp  #F0                         ; UNAPI driver has been loaded at least once
     406   00:405D  C2 72 40                jp  nz, F2_IS_NOT_F0            ; Ok, has not been loaded
     407   00:4060                          ; Let's intercept [F1] key
     408   00:4060  3E 06                   ld  a,6
     409   00:4062  CD 41 01                call    SNSMAT
     410   00:4065  CB 6F                   bit 5,a                         ; Test [F1]
     411   00:4067  CA 2D 42                jp  z,ENTERING_ESPSETUP         ; If F1 is pressed, let's execute our setup menu
     412   00:406A                          ; F1 is not pressed, continue
     413   00:406A  CB 77                   bit 6,a                         ; Test [F2]
     414   00:406C  C2 EE 40                jp  nz,INIT_UNAPI               ; If F2 is not pressed, let's proceed to INIT_UNAPI
     415   00:406F                          ; F2 is not pressed, continue
     416   00:406F  C3 9B 41                jp  INIT_NOCLOCKUPDAT2          ; If yes, proceed without affecting the connection or the date and time
     417   00:4072                      F2_IS_NOT_F0:
     418   00:4072  FE F1                   cp  #F1                         ; User requested to go directly to Wi-Fi Setup
     419   00:4074  CA 2D 42                jp  z,ENTERING_ESPSETUP         ; If yes, let's execute our setup menu
     420   00:4077  FE F2                   cp  #F2                         ; User forces to check if ESP is installed
     421   00:4079  CA CB 40                jp  z,F2_IS_PRESSED             ; If yes, let's go check it out
     422   00:407C  FE FE                   cp  #FE                         ; Unexpected error from the previous reboot
     423   00:407E  20 10                   jr  nz,BOOT_FROM_POWER_OFF      ; If no one is confirmed, let's proceed as "boot from power off"
     424   00:4080                          ; Oops! An unexpected error occurred on the last reboot
     425   00:4080  21 1F 70                ld  hl,STR_OOPS                 ; Print Oops! An unexpected error message
     426   00:4083  CD 4C 4C                call    PRINTHL                 ; and let's proceed as "boot from power off"
     427   00:4086  06 78                   ld  b,120                       ; Wait 2 seconds with message on screen
     428   00:4088                      WAIT_2S:
     429   00:4088  76                      halt
     430   00:4089  10 FD                   djnz    WAIT_2S                 ; If not zero, our time out has not elapsed
     431   00:408B  3E 0C                   ld  a,CLS
     432   00:408D  CD A2 00                call    CHPUT
     433   00:4090                      BOOT_FROM_POWER_OFF:
     434   00:4090                          ; Let's intercept [F1] key
     435   00:4090  3E 06                   ld  a,6
     436   00:4092  CD 41 01                call    SNSMAT
     437   00:4095  CB 6F                   bit 5,a                         ; Test [F1]
     438   00:4097  CA 2D 42                jp  z,ENTERING_ESPSETUP         ; If F1 is pressed, let's execute our setup menu
     439   00:409A                          ; F1 is not pressed, continue
     440   00:409A  CD A4 60                call    CHECK_ESP_TYPE          ; Always detect ESP type and SSH support
     441   00:409D                          if  NON_VERBOSE_ROM = 0
     442   00:409D  CD ED 5F                call    GETESPFLAGS
     443   00:40A0  E6 02                   and ESPFLAG_SSH
     444   00:40A2  21 56 63                ld  hl,WELCOME
     445   00:40A5  28 03                   jr  z,NOT32_1
     446   00:40A7  21 A0 63                ld  hl,WELCOME32
     447   00:40AA                      NOT32_1:
     448   00:40AA  CD 4C 4C                call    PRINTHL
     449   00:40AD                          CHECK_QUICK_RECEIVE
     449   00:40AD  DB 07             >     in  a,(IN_STS_PORT)
     449   00:40AF  CB 5F             >     bit 3,a
     450   00:40B1  20 08                   jr  nz,BOOT_FROM_POWER_OFF.1    ; QR Supported
     451   00:40B3  21 0A 64                ld  hl,WELCOME_SF2
     452   00:40B6  CD 4C 4C                call    PRINTHL
     453   00:40B9  18 06                   jr  BOOT_FROM_POWER_OFF.2
     454   00:40BB                      BOOT_FROM_POWER_OFF.1:
     455   00:40BB  21 EE 63                ld  hl,WELCOME_SF
     456   00:40BE  CD 4C 4C                call    PRINTHL
     457   00:40C1                      BOOT_FROM_POWER_OFF.2:
     458   00:40C1                          endif
     459   00:40C1  3E 06                   ld  a,6
     460   00:40C3  CD 41 01                call    SNSMAT
     461   00:40C6  CB 77                   bit 6,a                         ; Test [F2]
     462   00:40C8  C2 EE 40                jp  nz,INIT_UNAPI               ; If F2 is not pressed, let's proceed to INIT_UNAPI
     463   00:40CB                          ; F2 is pressed, continue
     464   00:40CB                      F2_IS_PRESSED:
     465   00:40CB  CD 9E 61                call    RESET_ESP
     466   00:40CE  B7                      or  a
     467   00:40CF  20 06                   jr  nz,ESP_NOT_FOUND
     468   00:40D1  21 1E 6F                ld  hl,OK_S                     ; Properly detected
     469   00:40D4  C3 E1 40                jp  INIT_F_MSG                  ; Well, if reset successful, continue
     470   00:40D7                      ESP_NOT_FOUND:
     471   00:40D7                          ; If here, ESP was not found, so, exit with an error message
     472   00:40D7  78                      ld  a,b
     473   00:40D8  B7                      or  a
     474   00:40D9  21 9A 6F                ld  hl,FAIL_S                   ; If 0, non responsive
     475   00:40DC  28 03                   jr  z,INIT_F_MSG
     476   00:40DE  21 E4 6F                ld  hl,FAIL_F                   ; Otherwise, firmware is old
     477   00:40E1                      INIT_F_MSG:
     478   00:40E1  CD 4C 4C                call    PRINTHL
     479   00:40E4                      INIT_F_WAIT:
     480   00:40E4  06 B4                   ld  b,180                       ; 3s
     481   00:40E6                      INIT_F_LOOP_WAIT:
     482   00:40E6  76                      halt
     483   00:40E7  10 FD                   djnz    INIT_F_LOOP_WAIT
     484   00:40E9                      AND_DONE:
     485   00:40E9  3E EF                   ld  a,#EF                       ; Set #EF, ESP Not Found
     486   00:40EB                          WRITE_F2                        ; on port #F2
     486   00:40EB  D3 F2             >     out (PORT_F2),a
     487   00:40ED  C9                      ret                             ; And done
     488   00:40EE                      INIT_UNAPI:
     489   00:40EE                          CLEAR_UART
     489   00:40EE  3E 14             >     ld  a,20
     489   00:40F0  D3 06             >     out (OUT_CMD_PORT),a
     490   00:40F2  3E 63                   ld  a,CMD_QUERY_ACLK_SETTINGS
     491   00:40F4                          SEND_DATA
     491   00:40F4  D3 07             >     out (OUT_TX_PORT),a
     492   00:40F6  21 3C 00                ld  hl,60                       ; Wait Up To 1s
     493   00:40F9  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
     494   00:40FD  DD 6B                   ld  ixl,e
     495   00:40FF  DD 62                   ld  ixh,d                       ; Address in IX
     496   00:4101  CD 38 4B                call    WAIT_MENU_CMD_RESPONSE
     497   00:4104  CA 93 41                jp  z,INIT_NOCLOCKUPDATE        ; If error, just skip
     498   00:4107                          ; Response received, IX+0 and IX+1 has Auto Clock and GMT
     499   00:4107  3E 03                   ld  a,3
     500   00:4109  DD BE 00                cp  (ix+0)
     501   00:410C  20 09                   jr  nz,INIT_UNAPI2              ; If not disabled continue on INIT_UNAPI2
     502   00:410E                          ; Disabled, ok, so let's ensure connection is not locked (just in case it was setup as disabled right now)
     503   00:410E                          CLEAR_UART
     503   00:410E  3E 14             >     ld  a,20
     503   00:4110  D3 06             >     out (OUT_CMD_PORT),a
     504   00:4112  3E 68                   ld  a,CMD_WIFIRELEASE_ESP
     505   00:4114                          SEND_DATA                       ; Just send, no need to wait response
     505   00:4114  D3 07             >     out (OUT_TX_PORT),a
     506   00:4116  C9                      ret
     507   00:4117                      INIT_UNAPI2:
     508   00:4117  3A 2D 00                ld  a,(#002D)                   ; Check MSX Version
     509   00:411A  B7                      or  a
     510   00:411B  28 76                   jr  z,INIT_NOCLOCKUPDATE        ; If zero, MSX1, can't set clock
     511   00:411D  AF                      xor a
     512   00:411E  DD B6 00                or  (ix+0)
     513   00:4121  28 70                   jr  z,INIT_NOCLOCKUPDATE        ; if turned off, skip
     514   00:4123                          ; Ok, not zero, so we are going to simply request the time, it might take up to 10s
     515   00:4123  DD 23                   inc ix
     516   00:4125  DD 23                   inc ix                          ; ok, leave IX+0 and IX+1 intact
     517   00:4127                          ; b = number of response check attempts
     518   00:4127  06 05                   ld  b,5                         ; 5 * 2s = 10s
     519   00:4129                          CLEAR_UART
     519   00:4129  3E 14             >     ld  a,20
     519   00:412B  D3 06             >     out (OUT_CMD_PORT),a
     520   00:412D  3E 47                   ld  a,CMD_GET_TIME
     521   00:412F                          SEND_DATA
     521   00:412F  D3 07             >     out (OUT_TX_PORT),a
     522   00:4131                      TRY_AGAIN:
     523   00:4131  C5                      push    bc
     524   00:4132  21 78 00                ld  hl,120                      ; Wait Up To 2s per attempt
     525   00:4135  CD 38 4B                call    WAIT_MENU_CMD_RESPONSE
     526   00:4138  20 1E                   jr  nz,INIT_CLOCKUPDATE         ; if ok, follow up
     527   00:413A  21 FF 6F                ld  hl,STR_WAITING              ; Print Waiting for connection message
     528   00:413D  CD 4C 4C                call    PRINTHL
     529   00:4140  3E FF                   ld  a,#ff
     530   00:4142  B8                      cp  b                           ; Was time-out the failure reason?
     531   00:4143  C1                      pop bc                          ; Restore stack ballance and retry counter
     532   00:4144  20 04                   jr  nz,STOP_TRYING              ; If error return code and not time-out, no more checks needed
     533   00:4146  3E 47                   ld  a,CMD_GET_TIME              ; Needed for retries
     534   00:4148  10 E7                   djnz    TRY_AGAIN
     535   00:414A                      STOP_TRYING:
     536   00:414A                          ; Leave a message that clock has not been updated
     537   00:414A  21 B0 6E                ld  hl,STR_CLKUPDT_FAIL
     538   00:414D  CD 4C 4C                call    PRINTHL
     539   00:4150  3E F0                   ld  a,240                       ; Wait 4 seconds with message on screen
     540   00:4152                      WAIT_4S:
     541   00:4152  76                      halt
     542   00:4153  3D                      dec a
     543   00:4154                          ; If not zero, our time out has not elapsed
     544   00:4154  20 FC                   jr  nz,WAIT_4S
     545   00:4156  18 3B                   jr  INIT_NOCLOCKUPDATE          ; error, just skip to not set garbage in clock
     546   00:4158                      INIT_CLOCKUPDATE:
     547   00:4158  C1                      pop bc
     548   00:4159  DD 2B                   dec ix
     549   00:415B  DD 2B                   dec ix                          ; ix back where it should
     550   00:415D                          ; ix + 0 -> 0 If no need to set clock, 1 if set clock, 2 if set clock and request to turn Wi-Fi Off
     551   00:415D                          ; ix + 1 -> GMT setting, well, not going to use it
     552   00:415D                          ; ix + 2 -> Seconds
     553   00:415D                          ; ix + 3 -> Minutes
     554   00:415D                          ; ix + 4 -> Hours
     555   00:415D                          ; ix + 5 -> Day
     556   00:415D                          ; ix + 6 -> Month
     557   00:415D                          ; ix + 7 -> Year LSB
     558   00:415D                          ; ix + 8 -> Year MSB
     559   00:415D  DD 66 04                ld  h,(ix+4)
     560   00:4160  DD 6E 03                ld  l,(ix+3)
     561   00:4163  DD 56 02                ld  d,(ix+2)
     562   00:4166  CD DC 61                call    SET_TIME
     563   00:4169  20 28                   jr  nz,INIT_NOCLOCKUPDATE       ; if error, just skip
     564   00:416B  DD 66 08                ld  h,(ix+8)
     565   00:416E  DD 6E 07                ld  l,(ix+7)
     566   00:4171  DD 56 06                ld  d,(ix+6)
     567   00:4174  DD 5E 05                ld  e,(ix+5)
     568   00:4177  CD 09 62                call    SET_DATE
     569   00:417A  3E 02                   ld  a,2
     570   00:417C  DD BE 00                cp  (ix+0)
     571   00:417F  20 12                   jr  nz,INIT_NOCLOCKUPDATE
     572   00:4181                          ; First, release any hold to Wi-Fi Connection
     573   00:4181                          CLEAR_UART
     573   00:4181  3E 14             >     ld  a,20
     573   00:4183  D3 06             >     out (OUT_CMD_PORT),a
     574   00:4185  3E 68                   ld  a,CMD_WIFIRELEASE_ESP
     575   00:4187                          SEND_DATA                       ; Just send, no need to wait response
     575   00:4187  D3 07             >     out (OUT_TX_PORT),a
     576   00:4189                          ; And, turn off Wi-Fi Immediatelly
     577   00:4189                          CLEAR_UART
     577   00:4189  3E 14             >     ld  a,20
     577   00:418B  D3 06             >     out (OUT_CMD_PORT),a
     578   00:418D  3E 4F                   ld  a,CMD_WIFI_OFF
     579   00:418F                          SEND_DATA                       ; Just send, no need to wait response
     579   00:418F  D3 07             >     out (OUT_TX_PORT),a
     580   00:4191  18 08                   jr  INIT_NOCLOCKUPDAT2
     581   00:4193                      INIT_NOCLOCKUPDATE:
     582   00:4193                          ; Release any hold to Wi-Fi Connection
     583   00:4193                          CLEAR_UART
     583   00:4193  3E 14             >     ld  a,20
     583   00:4195  D3 06             >     out (OUT_CMD_PORT),a
     584   00:4197  3E 68                   ld  a,CMD_WIFIRELEASE_ESP
     585   00:4199                          SEND_DATA                       ; Just send, no need to wait response
     585   00:4199  D3 07             >     out (OUT_TX_PORT),a
     586   00:419B                      INIT_NOCLOCKUPDAT2:
     587   00:419B                          ; Save existing EXTBIO hook if it exists
     588   00:419B  3A 20 FB                ld  a,(HOKVLD)
     589   00:419E  CB 47                   bit 0,a
     590   00:41A0  20 0B                   jr  nz,SAVE_HOOK2               ; HOKVLD tells us if there is an extended BIOS already or not, if yes, save it
     591   00:41A2                          ; If here, no extended BIOS
     592   00:41A2  CD 4C 5E                call    GETSLT
     593   00:41A5  CD A5 5E                call    GETWRK                  ; Our ROM work area address is at HL (we can use up to 8 bytes)
     594   00:41A8  3E C9                   ld  a,#c9                       ; RET, as we are the first extended BIOS
     595   00:41AA  77                      ld  (hl),a
     596   00:41AB  18 13                   jr  PATCH                       ; And now all we need to do is patch the EXTBIO hook :)
     597   00:41AD                      
     598   00:41AD                      SAVE_HOOK2:
     599   00:41AD                          ; If here, we are not the first to extend bios, so we need to save the previous one
     600   00:41AD  CD 4C 5E                call    GETSLT
     601   00:41B0  CD A5 5E                call    GETWRK                  ; Our ROM work area address is at HL (we can use up to 8 bytes)
     602   00:41B3  EB                      ex  de,hl                       ; It is the destination for....
     603   00:41B4  21 CA FF                ld  hl,EXTBIO                   ; The actual EXTBIO hook
     604   00:41B7  01 05 00                ld  bc,5                        ; That is 5 bytes large
     605   00:41BA  ED B0                   ldir                            ; And move to our work area
     606   00:41BC  AF                      xor a
     607   00:41BD  12                      ld  (de),a                      ; Not initialized (de is at the sixth byte) of our slot work area
     608   00:41BE  13                      inc de
     609   00:41BF  12                      ld  (de),a                      ; Not initialized (de is at the seventh byte) of our slot work area
     610   00:41C0                      
     611   00:41C0                          ; Patch EXTBIO
     612   00:41C0                      PATCH:
     613   00:41C0  3E F7                   ld  a,#F7                       ; RST #30
     614   00:41C2  32 CA FF                ld  (EXTBIO),a                  ; In EXTBIO hook
     615   00:41C5  CD 4C 5E                call    GETSLT                  ; Our Slot in A
     616   00:41C8  32 CB FF                ld  (EXTBIO+1),a                ; Next EXTBIO hook byte
     617   00:41CB  21 A1 4C                ld  hl,DO_EXTBIO                ; Our EXTBIO routine address
     618   00:41CE  22 CC FF                ld  (EXTBIO+2),hl               ; Goes to the following two bytes in the hook
     619   00:41D1                      
     620   00:41D1  21 CF FF                ld  hl,EXTBIO+5                 ; Must patch DISINT and ENAINT as well
     621   00:41D4  06 0A                   ld  b,5*2
     622   00:41D6                      PATCH2:
     623   00:41D6  36 C9                   ld  (hl),#C9
     624   00:41D8  23                      inc hl
     625   00:41D9  10 FB                   djnz    PATCH2                  ; So patch all 10 bytes with return
     626   00:41DB                      
     627   00:41DB  21 20 FB                ld  hl,HOKVLD
     628   00:41DE  CB C6                   set 0,(hl)                      ; And set HOKVLD properly to indicate an EXTBIOS is installed
     629   00:41E0                      INIT_OK:
     630   00:41E0                          if  NON_VERBOSE_ROM = 0
     631   00:41E0  CD 40 61                call    PRINT_INSTALLED_MSG     ; All done and set, nice exit message
     632   00:41E3                          endif
     633   00:41E3  3E F0                   ld  a,#F0                       ; Set #F0, UNAPI driver has been loaded at least once
     634   00:41E5                          WRITE_F2
     634   00:41E5  D3 F2             >     out (PORT_F2),a
     635   00:41E7  C9                      ret
     636   00:41E8                      
     637   00:41E8                      ;==============================
     638   00:41E8                      ;===  TPA Memory Allocation  ==
     639   00:41E8                      ;==============================
     640   00:41E8                      HIMEM_ALLOC:
     641   00:41E8                          ; Now let's reserve memory in the 4th page for our usage
     642   00:41E8  2A 4A FC                ld hl,(HIMEM)                   ; Get HIMEM
     643   00:41EB  B7                      or  a                           ; Clear Carry
     644   00:41EC  11 1E 00                ld  de,HIMEM_RESERVED_SIZE      ; Reserve How much memory we need
     645   00:41EF  ED 52                   sbc hl,de                       ; New HIMEM
     646   00:41F1  22 4A FC                ld  (HIMEM),hl                  ; Save it
     647   00:41F4  23                      inc hl                          ; To be safe
     648   00:41F5  EB                      ex  de,hl                       ; now in DE
     649   00:41F6  CD 4C 5E                call    GETSLT
     650   00:41F9  CD B9 5E                call    GETMEMPOINTERADDR       ; This is where we are going to store our memory area address
     651   00:41FC                          ; GETSLT and GETMEMPOINTER do not change DE, so it still has the our memory area address
     652   00:41FC  73                      ld  (hl),e
     653   00:41FD  23                      inc hl
     654   00:41FE  72                      ld  (hl),d                      ; And save our memory area there
     655   00:41FF                          ; Ok, DE has our memory area, let's save old H_TIMI hook there
     656   00:41FF  21 9F FD                ld  hl,H_TIMI                   ; The actual H_TIMI hook
     657   00:4202  01 05 00                ld  bc,5                        ; That is 5 bytes large
     658   00:4205  ED B0                   ldir                            ; And move to our memory area
     659   00:4207  F3                      di                              ; Turn of interrupts as we are going to patch H_TIMI
     660   00:4208                      PATCH_H_TIMI:
     661   00:4208  3E F7                   ld  a,#F7                       ; RST #30
     662   00:420A  32 9F FD                ld  (H_TIMI),a                  ; In H_TIMI hook
     663   00:420D  CD 4C 5E                call    GETSLT                  ; Our Slot in A
     664   00:4210  32 A0 FD                ld  (H_TIMI+1),a                ; Next H_TIMI hook byte
     665   00:4213  21 8D 4C                ld  hl,DO_HTIMI                 ; Our H_TIMI routine address
     666   00:4216  22 A1 FD                ld  (H_TIMI+2),hl               ; Goes to the following two bytes in the hook
     667   00:4219  FB                      ei                              ; done, so re-enable interrupts
     668   00:421A                      
     669   00:421A                          ; Set DNS_READY to zero
     670   00:421A  AF                      xor a
     671   00:421B  CD 11 60                call    SETDNSREADY
     672   00:421E                          ; Set TIME-OUT counter to zero
     673   00:421E  21 00 00                ld  hl,0
     674   00:4221  CD EC 5E                call    SETCOUNTER
     675   00:4224  C9                      ret
     676   00:4225                      
     677   00:4225                      ;============================
     678   00:4225                      ;===  SETUP Menu Routines  ==
     679   00:4225                      ;===       Main Menu       ==
     680   00:4225                      ;============================
     681   00:4225                      ESPSETUP.EXIT:
     682   00:4225  3E 0C                   ld  a,CLS
     683   00:4227  CD A2 00                call    CHPUT
     684   00:422A  C3 EE 40                jp  INIT_UNAPI                  ; When done, resume initialization
     685   00:422D                      ENTERING_ESPSETUP:
     686   00:422D  21 3A 63                ld  hl,ENTERING_WIFI_SETUP
     687   00:4230  CD 4C 4C                call    PRINTHL
     688   00:4233  CD A3 62                call    PATTERN_SETUP
     689   00:4236  CD E3 49                call    WAIT_250MS_AND_THEN_CONTINUE
     690   00:4239                          ; Hold Wi-Fi Connection On
     691   00:4239                          CLEAR_UART
     691   00:4239  3E 14             >     ld  a,20
     691   00:423B  D3 06             >     out (OUT_CMD_PORT),a
     692   00:423D  3E 48                   ld  a,CMD_WIFIHOLD_ESP
     693   00:423F                          SEND_DATA
     693   00:423F  D3 07             >     out (OUT_TX_PORT),a
     694   00:4241  21 3C 00                ld  hl,60                       ; Up to 1s time-out
     695   00:4244  CD 38 4B                call    WAIT_MENU_CMD_RESPONSE  ; Wait response
     696   00:4247                          ; We do not want to error here, just in case user still need to upgrade ESP firmware
     697   00:4247                      ESPSETUP:
     698   00:4247  CD 9E 61                call    RESET_ESP
     699   00:424A  B7                      or  a
     700   00:424B  C2 D7 40                jp  nz,ESP_NOT_FOUND            ; Not well, ESP was not found
     701   00:424E                          ; Well, if reset successful, continue
     702   00:424E  CD A4 60                call    CHECK_ESP_TYPE          ; Detect ESP type and SSH support
     703   00:4251  CD ED 5F                call    GETESPFLAGS
     704   00:4254  E6 02                   and ESPFLAG_SSH
     705   00:4256  21 56 63                ld  hl,WELCOME
     706   00:4259  28 03                   jr  z,NOT32_2
     707   00:425B  21 A0 63                ld  hl,WELCOME32
     708   00:425E                      NOT32_2:
     709   00:425E  CD 4C 4C                call    PRINTHL
     710   00:4261                          CHECK_QUICK_RECEIVE
     710   00:4261  DB 07             >     in  a,(IN_STS_PORT)
     710   00:4263  CB 5F             >     bit 3,a
     711   00:4265  20 08                   jr  nz,ESPSETUP.2NF             ; If yes, tells Quick Receive support
     712   00:4267  21 0A 64                ld  hl,WELCOME_SF2
     713   00:426A  CD 4C 4C                call    PRINTHL                 ; Print Welcome message no QR
     714   00:426D  18 06                   jr  ESPSETUP.3NF
     715   00:426F                      ESPSETUP.2NF:
     716   00:426F  21 EE 63                ld  hl,WELCOME_SF
     717   00:4272  CD 4C 4C                call    PRINTHL                 ; Print Welcome message QR
     718   00:4275                      ESPSETUP.3NF:
     719   00:4275  21 2A 64                ld  hl,WELCOME_CS
     720   00:4278  CD 4C 4C                call    PRINTHL                 ; Print Wi-Fi is reconnecting to:
     721   00:427B                      ESPSETUP_NEXT:
     722   00:427B  CD 56 01                call    KILBUF                  ; Clear Keyboard Buffer
     723   00:427E  21 54 64                ld  hl,WELCOME_NEXT
     724   00:4281  CD 4C 4C                call    PRINTHL
     725   00:4284  21 5E 64                ld  hl,WELCOME_SF_NEXT
     726   00:4287  CD 4C 4C                call    PRINTHL                 ; Print Empty Welcome message
     727   00:428A  CD 20 43                call    GET_AP_STAT
     728   00:428D  CA C5 42                jp  z,ESPSETUP_NEXT.1G          ; Won't block in case of error
     729   00:4290                          ; Success, so connection state is in IX+0, then, zero terminated string with SSID starting at IX+1
     730   00:4290  DD 7E 00                ld  a,(ix+0)
     731   00:4293  21 61 64                ld  hl,WELCOME_CS0_NEXT
     732   00:4296  FE 00                   cp  0
     733   00:4298  28 1F                   jr  z,ESPSETUP_NEXT.2F
     734   00:429A  21 8B 64                ld  hl,WELCOME_CS1_NEXT
     735   00:429D  FE 01                   cp  1
     736   00:429F  28 18                   jr  z,ESPSETUP_NEXT.2F
     737   00:42A1  21 94 64                ld  hl,WELCOME_CS2_NEXT
     738   00:42A4  FE 02                   cp  2
     739   00:42A6  28 11                   jr  z,ESPSETUP_NEXT.2F
     740   00:42A8  21 BE 64                ld  hl,WELCOME_CS3_NEXT
     741   00:42AB  FE 03                   cp  3
     742   00:42AD  28 0A                   jr  z,ESPSETUP_NEXT.2F
     743   00:42AF  21 E8 64                ld  hl,WELCOME_CS4_NEXT
     744   00:42B2  FE 04                   cp  4
     745   00:42B4  28 03                   jr  z,ESPSETUP_NEXT.2F
     746   00:42B6  21 12 65                ld  hl,WELCOME_CS5_NEXT
     747   00:42B9                      ESPSETUP_NEXT.2F:
     748   00:42B9  FD 67                   ld  iyh,a                       ; Save current conn status in iyh
     749   00:42BB  CD 4C 4C                call    PRINTHL                 ; Print Status
     750   00:42BE  DD E5                   push    ix
     751   00:42C0  E1                      pop hl
     752   00:42C1  23                      inc hl                          ; HL has AP Name
     753   00:42C2  CD 56 4C                call    PRINTHLINE              ; Print AP Name
     754   00:42C5                      ESPSETUP_NEXT.1G:
     755   00:42C5  21 3C 65                ld  hl,MMENU_S_NEXT
     756   00:42C8  CD 4C 4C                call    PRINTHL                 ; Print Main Menu
     757   00:42CB                      MM_CURSOR_BLINK:
     758   00:42CB  CD 0C 43                call    MM_CURSOR_SW            ; Cursor On
     759   00:42CE                      CONN_CHG_LOOP:
     760   00:42CE  CD 9C 00                call    CHSNS
     761   00:42D1  20 13                   jr  nz,MM_WAIT_INPUT            ; If not zero, there is a key in buffer
     762   00:42D3                          ; Ok, there is not, we can check if connection status changed
     763   00:42D3  CD 20 43                call    GET_AP_STAT
     764   00:42D6  CA CE 42                jp  z,CONN_CHG_LOOP             ; Won't block in case of error
     765   00:42D9                          ; Success, so connection state is in IX+0
     766   00:42D9  DD 7E 00                ld  a,(ix+0)
     767   00:42DC  FD BC                   cp  iyh                         ; If same, zero
     768   00:42DE  28 EE                   jr  z,CONN_CHG_LOOP             ; Keep loop
     769   00:42E0  CD 0C 43                call    MM_CURSOR_SW            ; Cursor Off
     770   00:42E3  C3 7B 42                jp  ESPSETUP_NEXT               ; Changed, re-build menu
     771   00:42E6                      MM_WAIT_INPUT:
     772   00:42E6  CD 9F 00                call    CHGET
     773   00:42E9  FE 1B                   cp  #1b                         ; ESC?
     774   00:42EB  CA 25 42                jp  z,ESPSETUP.EXIT             ; When done, resume initialization
     775   00:42EE  FE 31                   cp  '1'                         ; Setup Nagle?
     776   00:42F0  CA D4 48                jp  z,SET_NAGLE
     777   00:42F3  FE 32                   cp  '2'                         ; Setup Wi-Fi On Period?
     778   00:42F5  CA 0E 48                jp  z,SET_WIFI_TIMEOUT
     779   00:42F8  FE 33                   cp  '3'                         ; Scan networks?
     780   00:42FA  CA 65 45                jp  z,START_WIFI_SCAN
     781   00:42FD  FE 34                   cp  '4'                         ; Automatic Setting of Clock?
     782   00:42FF  CA 87 43                jp  z,START_CLK_AUTO
     783   00:4302  CD C0 00                call    BEEP                    ; Wrong Input, beep
     784   00:4305  CD 0C 43                call    MM_CURSOR_SW            ; Cursor Off
     785   00:4308  76                      halt
     786   00:4309  C3 CB 42                jp  MM_CURSOR_BLINK             ; And return, waiting another key
     787   00:430C                      MM_CURSOR_SW:                       ; Cursor workaround for CONN_CHG_LOOP
     788   00:430C  3E 1D                   ld  a,GOLEFT
     789   00:430E  CD A2 00                call    CHPUT
     790   00:4311  3E 01                   ld  a,1
     791   00:4313  32 A9 FC                ld  (CSRSW),a
     792   00:4316  3E 20                   ld  a,' '
     793   00:4318  CD A2 00                call    CHPUT                   ; Switch the cursor display mode
     794   00:431B  AF                      xor a
     795   00:431C  32 A9 FC                ld  (CSRSW),a
     796   00:431F  C9                      ret
     797   00:4320                      GET_AP_STAT:                        ; Use 'call GET_AP_STAT'
     798   00:4320                          CLEAR_UART
     798   00:4320  3E 14             >     ld  a,20
     798   00:4322  D3 06             >     out (OUT_CMD_PORT),a
     799   00:4324  3E 67                   ld  a,CMD_AP_STS
     800   00:4326                          SEND_DATA                       ; Get AP conn status and name
     800   00:4326  D3 07             >     out (OUT_TX_PORT),a
     801   00:4328  21 3C 00                ld  hl,60                       ; Wait Up To 1s
     802   00:432B  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
     803   00:432F  DD 6B                   ld  ixl,e
     804   00:4331  DD 62                   ld  ixh,d                       ; Address in IX
     805   00:4333  C3 38 4B                jp  WAIT_MENU_CMD_RESPONSE
     806   00:4336                      
     807   00:4336                      ;============================
     808   00:4336                      ;===  SETUP Menu Routines  ==
     809   00:4336                      ;===  Wi-Fi and Clock Menu ==
     810   00:4336                      ;============================
     811   00:4336                      CLK_MSX1_GO:
     812   00:4336  21 2B 67                ld  hl,MMENU_CLOCK_MSX1
     813   00:4339  CD 4C 4C                call    PRINTHL                 ; Print Main Clock MSX1 message
     814   00:433C  CD EA 49                call    ISCLKAUTO
     815   00:433F  DD 7E 00                ld  a,(ix+0)                    ; Auto Clock Current setting
     816   00:4342  FE 03                   cp  3                           ; If 3 adapter disabled
     817   00:4344  28 08                   jr  z,CLK_MSX1_ADAPTERDIS
     818   00:4346  21 BF 67                ld  hl,MMENU_CLOCK_0
     819   00:4349  CD 4C 4C                call    PRINTHL
     820   00:434C  18 06                   jr  CLK_MSX1_OPT
     821   00:434E                      CLK_MSX1_ADAPTERDIS:
     822   00:434E  21 05 68                ld  hl,MMENU_CLOCK_3
     823   00:4351  CD 4C 4C                call    PRINTHL
     824   00:4354                      CLK_MSX1_OPT:
     825   00:4354  21 18 68                ld  hl,MMENU_CLOCK_OPT
     826   00:4357  CD 4C 4C                call    PRINTHL
     827   00:435A                      CLK_MSX1_WAIT_OPT_INPUT:
     828   00:435A  CD 9F 00                call    CHGET
     829   00:435D  FE 1B                   cp  #1b                         ; ESC?
     830   00:435F  CA 47 42                jp  z,ESPSETUP                  ; Back to main menu
     831   00:4362  FE 30                   cp  '0'
     832   00:4364  CA 72 43                jp  z,CLK_MSX1_SEND_CMD
     833   00:4367  FE 33                   cp  '3'
     834   00:4369  CA 2E 44                jp  z,CLK_AUTO_WAIT_GMT
     835   00:436C  CD C0 00                call    BEEP                    ; Wrong Input, beep
     836   00:436F  C3 5A 43                jp  CLK_MSX1_WAIT_OPT_INPUT     ; And return, waiting another key
     837   00:4372                      CLK_MSX1_SEND_CMD:
     838   00:4372  CD A2 00                call    CHPUT                   ; Print option
     839   00:4375  D6 30                   sub '0'                         ; Adjust format
     840   00:4377  DD 77 00                ld  (ix+0),a                    ; Save it
     841   00:437A  3E 0D                   ld  a,#0d
     842   00:437C  CD A2 00                call    CHPUT
     843   00:437F  3E 0A                   ld  a,#0a
     844   00:4381  CD A2 00                call    CHPUT
     845   00:4384  C3 25 45                jp  CLK_AUTO_GMT_CHK_DONE       ; And sending the command will be done there
     846   00:4387                      
     847   00:4387                      START_CLK_AUTO:
     848   00:4387  3E 34                   ld  a,'4'
     849   00:4389  CD A2 00                call    CHPUT
     850   00:438C  CD E3 49                call    WAIT_250MS_AND_THEN_CONTINUE
     851   00:438F  3A 2D 00                ld  a,(#002D)                   ; Check MSX Version
     852   00:4392  B7                      or  a
     853   00:4393  CA 36 43                jp  z,CLK_MSX1_GO               ; If zero, MSX1, so can just enable or disable adapter
     854   00:4396                      CLK_AUTO_GO:
     855   00:4396  21 CB 65                ld  hl,MMENU_CLOCK_MSX2
     856   00:4399  CD 4C 4C                call    PRINTHL                 ; Print Main Clock MSX2 message
     857   00:439C  CD EA 49                call    ISCLKAUTO
     858   00:439F  DD 7E 00                ld  a,(ix+0)                    ; Auto Clock Current setting
     859   00:43A2  B7                      or  a                           ; If zero, off
     860   00:43A3  20 08                   jr  nz,CLK_AUTO_CHK1
     861   00:43A5  21 BF 67                ld  hl,MMENU_CLOCK_0
     862   00:43A8  CD 4C 4C                call    PRINTHL
     863   00:43AB  18 59                   jr  CLK_AUTO_GMT_OPT
     864   00:43AD                      CLK_AUTO_CHK1:
     865   00:43AD  3D                      dec a                           ; If 1, on and keep wifi on
     866   00:43AE  20 08                   jr  nz,CLK_AUTO_CHK2
     867   00:43B0  21 D1 67                ld  hl,MMENU_CLOCK_1
     868   00:43B3  CD 4C 4C                call    PRINTHL
     869   00:43B6  18 13                   jr  CLK_AUTO_GMT
     870   00:43B8                      CLK_AUTO_CHK2:
     871   00:43B8  3D                      dec a                           ; If 2, on and turn wifi off
     872   00:43B9  20 08                   jr  nz,CLK_AUTO_3
     873   00:43BB  21 EB 67                ld  hl,MMENU_CLOCK_2
     874   00:43BE  CD 4C 4C                call    PRINTHL
     875   00:43C1  18 08                   jr  CLK_AUTO_GMT
     876   00:43C3                      CLK_AUTO_3:
     877   00:43C3  21 05 68                ld  hl,MMENU_CLOCK_3
     878   00:43C6  CD 4C 4C                call    PRINTHL
     879   00:43C9  18 3B                   jr  CLK_AUTO_GMT_OPT
     880   00:43CB                      CLK_AUTO_GMT:
     881   00:43CB  DD 66 01                ld  h,(ix+1)                    ; Save it for now
     882   00:43CE  DD 7E 01                ld  a,(ix+1)                    ; GMT current setting
     883   00:43D1  CB 7F                   bit 7,a                         ; If set, is -
     884   00:43D3  28 0B                   jr  z,CLK_AUTO_GMTP
     885   00:43D5  3E 2D                   ld  a,'-'
     886   00:43D7  CD A2 00                call    CHPUT
     887   00:43DA  DD CB 01 BE             res 7,(ix+1)                    ; Clear - indicator
     888   00:43DE  18 05                   jr  CLK_AUTO_GMTM
     889   00:43E0                      CLK_AUTO_GMTP:
     890   00:43E0  3E 2B                   ld  a,'+'
     891   00:43E2  CD A2 00                call    CHPUT
     892   00:43E5                      CLK_AUTO_GMTM:
     893   00:43E5  3E 09                   ld  a,9
     894   00:43E7  DD BE 01                cp  (ix+1)                      ; Greater than 9?
     895   00:43EA  30 0F                   jr  nc,CLK_AUTO_GMTD            ; If not, just print what is in A + '0'
     896   00:43EC  3E 31                   ld  a,'1'                       ; It is 1
     897   00:43EE  CD A2 00                call    CHPUT
     898   00:43F1  DD 7E 01                ld  a,(ix+1)
     899   00:43F4  C6 26                   add '0'-10                      ; Need to subtract 10 and add '0' to print
     900   00:43F6  CD A2 00                call    CHPUT
     901   00:43F9  18 0B                   jr  CLK_AUTO_GMT_OPT
     902   00:43FB                      CLK_AUTO_GMTD:
     903   00:43FB  3E 30                   ld  a,'0'
     904   00:43FD  DD 86 01                add a,(ix+1)                    ; Our value
     905   00:4400  CD A2 00                call    CHPUT
     906   00:4403  DD 74 01                ld  (ix+1),h                    ; Restore original value
     907   00:4406                      CLK_AUTO_GMT_OPT:
     908   00:4406  21 18 68                ld  hl,MMENU_CLOCK_OPT
     909   00:4409  CD 4C 4C                call    PRINTHL
     910   00:440C                      CLK_AUTO_WAIT_OPT_INPUT:
     911   00:440C  CD 9F 00                call    CHGET
     912   00:440F  FE 1B                   cp  #1b                         ; ESC?
     913   00:4411  CA 47 42                jp  z,ESPSETUP                  ; Back to main menu
     914   00:4414  FE 30                   cp  '0'
     915   00:4416  CA 2E 44                jp  z,CLK_AUTO_WAIT_GMT
     916   00:4419  FE 31                   cp  '1'
     917   00:441B  CA 2E 44                jp  z,CLK_AUTO_WAIT_GMT
     918   00:441E  FE 32                   cp  '2'
     919   00:4420  CA 2E 44                jp  z,CLK_AUTO_WAIT_GMT
     920   00:4423  FE 33                   cp  '3'
     921   00:4425  CA 2E 44                jp  z,CLK_AUTO_WAIT_GMT
     922   00:4428  CD C0 00                call    BEEP                    ; Wrong Input, beep
     923   00:442B  C3 0C 44                jp  CLK_AUTO_WAIT_OPT_INPUT     ; And return, waiting another key
     924   00:442E                      CLK_AUTO_WAIT_GMT:
     925   00:442E  CD A2 00                call    CHPUT                   ; Print option
     926   00:4431  D6 30                   sub '0'                         ; Adjust format
     927   00:4433  DD 77 00                ld  (ix+0),a                    ; Save it
     928   00:4436  B7                      or  a
     929   00:4437  CA 25 45                jp  z,CLK_AUTO_GMT_CHK_DONE     ; And send the command if just disabling clock auto set
     930   00:443A  FE 03                   cp  3
     931   00:443C  CA 25 45                jp  z,CLK_AUTO_GMT_CHK_DONE     ; Or send the command if just disabling the adapter
     932   00:443F  21 42 68                ld  hl,MMENU_GMT_OPT
     933   00:4442  CD 4C 4C                call    PRINTHL
     934   00:4445  16 00                   ld  d,0                         ; # of digits entered
     935   00:4447  1E 00                   ld  e,0                         ; # of characters printed
     936   00:4449  DD 36 01 00             ld  (ix+1),0                    ; GMT 0
     937   00:444D                      CLK_AUTO_WAIT_GMT_INPUT:
     938   00:444D  CD 9F 00                call    CHGET
     939   00:4450  FE 1B                   cp  #1b                         ; ESC?
     940   00:4452  CA 47 42                jp  z,ESPSETUP                  ; Back to main menu
     941   00:4455  FE 0D                   cp  #0d                         ; ENTER?
     942   00:4457  CA A0 44                jp  z,CLK_AUTO_GMT_CHK_INPUT    ; Check if ok to send command
     943   00:445A  FE 08                   cp  #08                         ; Backspace?
     944   00:445C  CA 71 44                jp  z,CLK_AUTO_GMT_CHK_BS       ; Check if there is something to erase
     945   00:445F  FE 2D                   cp  '-'                         ; Negative value?
     946   00:4461  CA A0 44                jp  z,CLK_AUTO_GMT_CHK_INPUT
     947   00:4464  FE 30                   cp  '0'                         ; >=0?
     948   00:4466  DA 92 44                jp  c,CLK_AUTO_GMT_BAD_INPUT    ; If not, bad input
     949   00:4469  FE 3A                   cp  '9'+1                       ; <= 9
     950   00:446B  D2 92 44                jp  nc,CLK_AUTO_GMT_BAD_INPUT   ; If not, bad input
     951   00:446E  C3 A0 44                jp  CLK_AUTO_GMT_CHK_INPUT      ; Otherwise, validate digit
     952   00:4471                      CLK_AUTO_GMT_CHK_BS:
     953   00:4471  AF                      xor a
     954   00:4472  BB                      cp  e                           ; Anything on screen?
     955   00:4473  28 1D                   jr  z,CLK_AUTO_GMT_BAD_INPUT    ; Nothing to erase
     956   00:4475  1D                      dec e                           ; One less character on the screen
     957   00:4476  BA                      cp  d                           ; Any digit?
     958   00:4477  28 03                   jr  z,CLK_AUTO_GMT_CHK_BS_MIN   ; If not, just erase - sign
     959   00:4479                          ; There is, so it is one less digit
     960   00:4479  15                      dec d
     961   00:447A  18 04                   jr  CLK_AUTO_GMT_CHK_DIGIT
     962   00:447C                      CLK_AUTO_GMT_CHK_BS_MIN:
     963   00:447C  DD 36 01 00             ld  (ix+1),0                    ; Reset sign
     964   00:4480                      CLK_AUTO_GMT_CHK_DIGIT:
     965   00:4480  3E 08                   ld  a,8                         ; Backspace
     966   00:4482  CD A2 00                call    CHPUT                   ; Print it
     967   00:4485  3E 20                   ld  a,' '                       ; Space
     968   00:4487  CD A2 00                call    CHPUT                   ; Print it
     969   00:448A  3E 08                   ld  a,8                         ; Backspace
     970   00:448C  CD A2 00                call    CHPUT                   ; Print it
     971   00:448F  C3 4D 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; Return
     972   00:4492                      CLK_AUTO_GMT_BAD_INPUT:
     973   00:4492                          ; Beep might use sub rom, and if so, all registers will be messed up, better save
     974   00:4492  C5                      push    bc
     975   00:4493  D5                      push    de
     976   00:4494  F5                      push    af
     977   00:4495  E5                      push    hl
     978   00:4496  CD C0 00                call    BEEP                    ; Wrong Input, beep
     979   00:4499  E1                      pop hl
     980   00:449A  F1                      pop af
     981   00:449B  D1                      pop de
     982   00:449C  C1                      pop bc
     983   00:449D  C3 4D 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; And return, waiting another key
     984   00:44A0                      CLK_AUTO_GMT_CHK_INPUT:
     985   00:44A0  4F                      ld  c,a                         ; Save in C for printing if needed
     986   00:44A1  FE 2D                   cp  '-'                         ; - sign?
     987   00:44A3  20 11                   jr  nz,CLK_AUTO_GMT_CHK_CR      ; If not, check if enter
     988   00:44A5                          ; - sign
     989   00:44A5  3E 00                   ld  a,0
     990   00:44A7  BB                      cp  e                           ; If not the first character, can't accept
     991   00:44A8  20 E8                   jr  nz,CLK_AUTO_GMT_BAD_INPUT
     992   00:44AA                          ; It is the first, so let's print it
     993   00:44AA  79                      ld  a,c
     994   00:44AB  CD A2 00                call    CHPUT
     995   00:44AE  DD 36 01 80             ld  (ix+1),0x80                 ; Set the - sign bit, for now rest is zero
     996   00:44B2  1C                      inc e                           ; Increase # of characters printed
     997   00:44B3  C3 4D 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; Continue waiting input
     998   00:44B6                      CLK_AUTO_GMT_CHK_CR:
     999   00:44B6  FE 0D                   cp  #0d                         ; ENTER?
    1000   00:44B8  20 0F                   jr  nz,CLK_AUTO_GMT_CHK_CD      ; If not, check if digit is valid
    1001   00:44BA                          ; Enter
    1002   00:44BA  3E 00                   ld  a,0
    1003   00:44BC  BA                      cp  d                           ; Ok, at least one digit entered?
    1004   00:44BD  28 D3                   jr  z,CLK_AUTO_GMT_BAD_INPUT    ; No, so, enter is no good now
    1005   00:44BF                          ; It is, if it had a digit entered and did not send, it was 1, so...
    1006   00:44BF  3E 01                   ld  a,1
    1007   00:44C1  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1008   00:44C4  DD 77 01                ld  (ix+1),a                    ; Save
    1009   00:44C7  18 5C                   jr  CLK_AUTO_GMT_CHK_DONE       ; Ok, ready to send
    1010   00:44C9                      CLK_AUTO_GMT_CHK_CD:
    1011   00:44C9                          ; Ok, it is a digit
    1012   00:44C9  06 30                   ld  b,'0'
    1013   00:44CB  90                      sub a,b                         ; A has digit value
    1014   00:44CC  47                      ld  b,a                         ; Save in B
    1015   00:44CD  3E 00                   ld  a,0
    1016   00:44CF  BA                      cp  d
    1017   00:44D0  20 1E                   jr  nz,CLK_AUTO_GMT_CHK_CSD     ; If not zero, it is second digit, so almost done
    1018   00:44D2                          ; 1st digit, let's check if it is other than 1, if it is, we are almost done
    1019   00:44D2  3E 01                   ld  a,1
    1020   00:44D4  B8                      cp  b
    1021   00:44D5  28 10                   jr  z,CLK_AUTO_GMT_CHK_CD.1     ; If it is 1, wait next digit or enter
    1022   00:44D7                          ; Not 1, so just adjust ix+1 and go
    1023   00:44D7  79                      ld  a,c
    1024   00:44D8  CD A2 00                call    CHPUT                   ; Print it
