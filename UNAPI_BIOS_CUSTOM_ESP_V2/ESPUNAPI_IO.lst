    5615   00:5BB6                      ;===     SSH_RCV     ===
    5616   00:5BB6                      ;=======================
    5617   00:5BB6                      ;Receive data from a SSH connection.
    5618   00:5BB6                      ;
    5619   00:5BB6                      ;Input:   A  = 6
    5620   00:5BB6                      ;         B  = Connection number
