    3049   00:504A                      ;=========================
    3050   00:504A                      ;===  TCPIP_NET_STATE  ===
    3051   00:504A                      ;=========================
    3052   00:504A                      ;Get network state.
    3053   00:504A                      ;
    3054   00:504A                      ;Input:  A = 3
    3055   00:504A                      ;Output: A = Error code
    3056   00:504A                      ;        B = Current network state:
    3057   00:504A                      ;            0: Closed
    3058   00:504A                      ;            1: Opening
    3059   00:504A                      ;            2: Open
    3060   00:504A                      ;            3: Closing
    3061   00:504A                      ;            255: Unknown
    3062   00:504A                      TCPIP_NET_STATE:
    3063   00:504A                          SEND_DATA                       ; Send the command
    3063   00:504A  D3 07             >     out (OUT_TX_PORT),a
    3064   00:504C  AF                      xor a
    3065   00:504D                          SEND_DATA                       ; Send the command size msb
    3065   00:504D  D3 07             >     out (OUT_TX_PORT),a
    3066   00:504F                          SEND_DATA                       ; Send the command size lsb
    3066   00:504F  D3 07             >     out (OUT_TX_PORT),a
    3067   00:5051                      
    3068   00:5051                          ; Now wait up to 720 ticks to get response
    3069   00:5051  21 D0 02                ld  hl,720
    3070   00:5054  CD DF 60                call    SETCOUNTER
    3071   00:5057                      TCPIP_NET_STATE_ST1:
    3072   00:5057                          CHECK_DATA
    3072   00:5057  DB 07             >     in  a,(IN_STS_PORT)
    3072   00:5059  CB 47             >     bit 0,a
    3073   00:505B  20 05                   jr  nz,TCPIP_NET_STATE_ST1.1
    3074   00:505D  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3075   00:5060  18 F5                   jr  TCPIP_NET_STATE_ST1
    3076   00:5062                      TCPIP_NET_STATE_ST1.1:
    3077   00:5062                          ; nz, check the data
    3078   00:5062                          RECEIVE_DATA
    3078   00:5062  DB 06             >     in a,(IN_DATA_PORT)
    3079   00:5064  FE 03                   cp  3                           ; Is response of our command?
    3080   00:5066  20 EF                   jr  nz,TCPIP_NET_STATE_ST1
    3081   00:5068                          ; now get return code, if return code other than 0, it is finished
    3082   00:5068                      TCPIP_NET_STATE_RC:
    3083   00:5068                          CHECK_DATA
    3083   00:5068  DB 07             >     in  a,(IN_STS_PORT)
    3083   00:506A  CB 47             >     bit 0,a
    3084   00:506C  20 05                   jr  nz,TCPIP_NET_STATE_RC.1
    3085   00:506E  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3086   00:5071  18 F5                   jr  TCPIP_NET_STATE_RC
    3087   00:5073                      TCPIP_NET_STATE_RC.1:
    3088   00:5073                          ; nz, get it
