    5712   00:5C40                          ; if it was 0, no data
    5713   00:5C40                          if USE_MEM_IO = 1
    5714   00:5C40                    ~     jp  z,TCPIP_TCP_RCV_RET_NODATA  ; not a typo, no need to make the same code again
    5715   00:5C40                    ~     else
    5716   00:5C40  CA EA 5A                jp  z,TCPIP_TCP_RCV_RET_NODATA  ; not a typo, no need to make the same code again
    5717   00:5C43                          endif
    5718   00:5C43  4D                      ld  c,l
    5719   00:5C44  44                      ld  b,h                         ; BC has effective received data size, as well as HL
    5720   00:5C45                      
