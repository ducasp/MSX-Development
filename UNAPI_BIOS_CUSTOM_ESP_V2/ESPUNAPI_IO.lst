    5572   00:5BB5  20 F9                   jr  nz,TCPIP_TCP_SEND_R
    5573   00:5BB7                      
    5574   00:5BB7                          ; Now wait up to 600 ticks to get response
    5575   00:5BB7  21 58 02                ld  hl,600
