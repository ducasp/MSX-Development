    5915   00:5D3D  DB 07             >     in  a,(IN_STS_PORT)
    5915   00:5D3F  CB 47             >     bit 0,a
    5916   00:5D41  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_FLAGSA.1
