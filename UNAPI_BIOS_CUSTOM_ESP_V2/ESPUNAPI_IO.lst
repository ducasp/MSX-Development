    4899   00:5879                    ~     ld  a,(MEM_IN_DATA_PORT)
    4900   00:5879                    ~     ld  (hl),a
    4901   00:5879                    ~     inc hl
    4902   00:5879                    ~     dec b
    4903   00:5879                    ~     endif
