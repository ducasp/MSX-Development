    3484   00:520F                      ;=========================
    3485   00:520F                      ;===  TCPIP_UDP_STATE  ===
    3486   00:520F                      ;=========================
    3487   00:520F                      ;Get the state of a UDP connection.
    3488   00:520F                      ;
    3489   00:520F                      ;Input:  A = 10
    3490   00:520F                      ;        B = Connection number
    3491   00:520F                      ;Output: A  = Error code
    3492   00:520F                      ;        HL = Local port number
    3493   00:520F                      ;        B  = Number of pending incoming datagrams
    3494   00:520F                      ;        DE = Size of oldest pending incoming datagram (data part only)
    3495   00:520F                      TCPIP_UDP_STATE:
    3496   00:520F                          SEND_DATA                       ; Send the command
    3496   00:520F  D3 07             >     out (OUT_TX_PORT),a
    3497   00:5211  AF                      xor a
    3498   00:5212                          SEND_DATA                       ; Send the command size msb
    3498   00:5212  D3 07             >     out (OUT_TX_PORT),a
