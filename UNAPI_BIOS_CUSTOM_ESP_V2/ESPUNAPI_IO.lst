    6003   00:5D9E                      ;=============================
    6004   00:5D9E                      ;===  TCPIP_CONFIG_AUTOIP  ===
    6005   00:5D9E                      ;=============================
    6006   00:5D9E                      ;Enable or disable the automatic IP addresses retrieval.
    6007   00:5D9E                      ;
    6008   00:5D9E                      ;Input:  A = 25
    6009   00:5D9E                      ;        B = 0: Get current configuration
    6010   00:5D9E                      ;            1: Set configuration
    6011   00:5D9E                      ;        C = Configuration to set (only if B=1):
    6012   00:5D9E                      ;            bit 0: Set to automatically retrieve
    6013   00:5D9E                      ;                   local IP address, subnet mask and default gateway
    6014   00:5D9E                      ;            bit 1: Set to automatically retrieve DNS servers addresses
    6015   00:5D9E                      ;            bits 2-7: Unused, must be zero
    6016   00:5D9E                      ;Output: A = Error code
    6017   00:5D9E                      ;        C = Configuration after the routine execution
    6018   00:5D9E                      ;            (same format as C at input)
    6019   00:5D9E                      TCPIP_CONFIG_AUTOIP:
    6020   00:5D9E                          SEND_DATA                       ; Send the command
    6020   00:5D9E  D3 07             >     out (OUT_TX_PORT),a
    6021   00:5DA0  AF                      xor a
    6022   00:5DA1                          SEND_DATA                       ; Send the command size msb
    6022   00:5DA1  D3 07             >     out (OUT_TX_PORT),a
    6023   00:5DA3  3E 02                   ld  a,2
    6024   00:5DA5                          SEND_DATA                       ; Send the command size lsb
    6024   00:5DA5  D3 07             >     out (OUT_TX_PORT),a
    6025   00:5DA7  78                      ld  a,b
    6026   00:5DA8                          SEND_DATA                       ; Send the command
    6026   00:5DA8  D3 07             >     out (OUT_TX_PORT),a
    6027   00:5DAA  79                      ld  a,c
    6028   00:5DAB                          SEND_DATA                       ; Send the command parameter
    6028   00:5DAB  D3 07             >     out (OUT_TX_PORT),a
    6029   00:5DAD                      
    6030   00:5DAD                          ; Now wait up to 180 ticks to get response
    6031   00:5DAD  21 B4 00                ld hl,180
    6032   00:5DB0  CD F4 5E                call    SETCOUNTER
    6033   00:5DB3                      TCPIP_CONFIG_AUTOIP_ST1:
    6034   00:5DB3                          CHECK_DATA
    6034   00:5DB3  DB 07             >     in  a,(IN_STS_PORT)
    6034   00:5DB5  CB 47             >     bit 0,a
    6035   00:5DB7  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_ST1.1
    6036   00:5DB9  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6037   00:5DBC  18 F5                   jr  TCPIP_CONFIG_AUTOIP_ST1
    6038   00:5DBE                      TCPIP_CONFIG_AUTOIP_ST1.1:
    6039   00:5DBE                          ; nz, check the data
    6040   00:5DBE                          RECEIVE_DATA
    6040   00:5DBE  DB 06             >     in a,(IN_DATA_PORT)
    6041   00:5DC0  FE 19                   cp  25                          ; Is response of our command?
    6042   00:5DC2  20 EF                   jr  nz,TCPIP_CONFIG_AUTOIP_ST1
    6043   00:5DC4                          ; now get return code, if return code other than 0, it is finished
    6044   00:5DC4                      TCPIP_CONFIG_AUTOIP_RC:
    6045   00:5DC4                          CHECK_DATA
    6045   00:5DC4  DB 07             >     in  a,(IN_STS_PORT)
    6045   00:5DC6  CB 47             >     bit 0,a
    6046   00:5DC8  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_RC.1
    6047   00:5DCA  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6048   00:5DCD  18 F5                   jr  TCPIP_CONFIG_AUTOIP_RC
    6049   00:5DCF                      TCPIP_CONFIG_AUTOIP_RC.1:
    6050   00:5DCF                          ;nz, discard
    6051   00:5DCF                          RECEIVE_DATA
    6051   00:5DCF  DB 06             >     in a,(IN_DATA_PORT)
    6052   00:5DD1  B7                      or  a                           ; 0?
    6053   00:5DD2  C0                      ret nz                          ; if not, done
    6054   00:5DD3                      
    6055   00:5DD3                          ; next two bytes are return code and size bytes, don't care, it is 1, configuration
    6056   00:5DD3  06 02                   ld  b,2
    6057   00:5DD5                      TCPIP_CONFIG_AUTOIP_ST2:
    6058   00:5DD5                          CHECK_DATA
    6058   00:5DD5  DB 07             >     in  a,(IN_STS_PORT)
    6058   00:5DD7  CB 47             >     bit 0,a
    6059   00:5DD9  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_ST2.1
    6060   00:5DDB  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6061   00:5DDE  18 F5                   jr  TCPIP_CONFIG_AUTOIP_ST2
    6062   00:5DE0                      TCPIP_CONFIG_AUTOIP_ST2.1:
    6063   00:5DE0                          ; nz, discard
    6064   00:5DE0                          RECEIVE_DATA
    6064   00:5DE0  DB 06             >     in a,(IN_DATA_PORT)
    6065   00:5DE2  05                      dec b
    6066   00:5DE3  20 F0                   jr  nz,TCPIP_CONFIG_AUTOIP_ST2
    6067   00:5DE5                      
    6068   00:5DE5                          ; now just get the 1 byte, configuration, should go to C
    6069   00:5DE5                      TCPIP_CONFIG_AUTOIP_CONF_ST1:
    6070   00:5DE5                          CHECK_DATA
    6070   00:5DE5  DB 07             >     in  a,(IN_STS_PORT)
    6070   00:5DE7  CB 47             >     bit 0,a
    6071   00:5DE9  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_CONF_ST1.1
    6072   00:5DEB  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6073   00:5DEE  18 F5                   jr  TCPIP_CONFIG_AUTOIP_CONF_ST1
    6074   00:5DF0                      TCPIP_CONFIG_AUTOIP_CONF_ST1.1:
    6075   00:5DF0                          ; nz, get it
    6076   00:5DF0                          RECEIVE_DATA
    6076   00:5DF0  DB 06             >     in a,(IN_DATA_PORT)
    6077   00:5DF2  4F                      ld  c,a
    6078   00:5DF3                          ; done
    6079   00:5DF3  AF                      xor a
    6080   00:5DF4  C9                      ret
    6081   00:5DF5                      
    6082   00:5DF5                      ;=========================
    6083   00:5DF5                      ;===  TCPIP_CONFIG_IP  ===
    6084   00:5DF5                      ;=========================
    6085   00:5DF5                      ;Manually configure an IP address.
    6086   00:5DF5                      ;
    6087   00:5DF5                      ;Input:  A = 26
    6088   00:5DF5                      ;        B = Index of address to set:
    6089   00:5DF5                      ;            1: Local IP address
    6090   00:5DF5                      ;            2: Peer IP address
    6091   00:5DF5                      ;            3: Subnet mask
    6092   00:5DF5                      ;            4: Default gateway
    6093   00:5DF5                      ;            5: Primary DNS server IP address
    6094   00:5DF5                      ;            6: Secondary DNS server IP address
    6095   00:5DF5                      ;        L.H.E.D = Address value
    6096   00:5DF5                      ;Output: A = Error code
    6097   00:5DF5                      TCPIP_CONFIG_IP:
    6098   00:5DF5                          SEND_DATA                       ; Send the command
    6098   00:5DF5  D3 07             >     out (OUT_TX_PORT),a
    6099   00:5DF7  AF                      xor a
    6100   00:5DF8                          SEND_DATA                       ; Send the command size msb
    6100   00:5DF8  D3 07             >     out (OUT_TX_PORT),a
    6101   00:5DFA  3E 05                   ld  a,5
    6102   00:5DFC                          SEND_DATA                       ; Send the command size lsb
    6102   00:5DFC  D3 07             >     out (OUT_TX_PORT),a
    6103   00:5DFE  78                      ld  a,b
    6104   00:5DFF                          SEND_DATA                       ; Send the address to set
    6104   00:5DFF  D3 07             >     out (OUT_TX_PORT),a
    6105   00:5E01  7D                      ld  a,l
    6106   00:5E02                          SEND_DATA                       ; Send the IP first byte
    6106   00:5E02  D3 07             >     out (OUT_TX_PORT),a
    6107   00:5E04  7C                      ld  a,h
    6108   00:5E05                          SEND_DATA                       ; Send the IP second byte
    6108   00:5E05  D3 07             >     out (OUT_TX_PORT),a
    6109   00:5E07  7B                      ld  a,e
    6110   00:5E08                          SEND_DATA                       ; Send the IP third byte
    6110   00:5E08  D3 07             >     out (OUT_TX_PORT),a
    6111   00:5E0A  7A                      ld  a,d
    6112   00:5E0B                          SEND_DATA                       ; Send the IP fourth byte
    6112   00:5E0B  D3 07             >     out (OUT_TX_PORT),a
    6113   00:5E0D                      
    6114   00:5E0D                          ; Now wait up to 180 ticks to get response
    6115   00:5E0D  21 B4 00                ld  hl,180
    6116   00:5E10  CD F4 5E                call    SETCOUNTER
    6117   00:5E13                      TCPIP_CONFIG_IP_ST1:
    6118   00:5E13                          CHECK_DATA
    6118   00:5E13  DB 07             >     in  a,(IN_STS_PORT)
    6118   00:5E15  CB 47             >     bit 0,a
    6119   00:5E17  20 05                   jr  nz,TCPIP_CONFIG_IP_ST1.1
    6120   00:5E19  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6121   00:5E1C  18 F5                   jr  TCPIP_CONFIG_IP_ST1
    6122   00:5E1E                      TCPIP_CONFIG_IP_ST1.1:
    6123   00:5E1E                          ; nz, check the data
    6124   00:5E1E                          RECEIVE_DATA
    6124   00:5E1E  DB 06             >     in a,(IN_DATA_PORT)
    6125   00:5E20  FE 1A                   cp  26                          ; Is response of our command?
    6126   00:5E22  20 EF                   jr  nz,TCPIP_CONFIG_IP_ST1
    6127   00:5E24                          ; now get return code, and that is it
    6128   00:5E24                      TCPIP_CONFIG_IP_RC:
    6129   00:5E24                          CHECK_DATA
    6129   00:5E24  DB 07             >     in  a,(IN_STS_PORT)
    6129   00:5E26  CB 47             >     bit 0,a
    6130   00:5E28  20 05                   jr  nz,TCPIP_CONFIG_IP_RC.1
    6131   00:5E2A  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6132   00:5E2D  18 F5                   jr  TCPIP_CONFIG_IP_RC
    6133   00:5E2F                      TCPIP_CONFIG_IP_RC.1:
    6134   00:5E2F                          ; nz, discard
    6135   00:5E2F                          RECEIVE_DATA
    6135   00:5E2F  DB 06             >     in a,(IN_DATA_PORT)
    6136   00:5E31  C9                      ret                             ; done
    6137   00:5E32                      
    6138   00:5E32                      ;==========================
    6139   00:5E32                      ;===  TCPIP_CONFIG_TTL  ===
    6140   00:5E32                      ;==========================
    6141   00:5E32                      ;Get/set the value of TTL and TOS for outgoing datagrams.
    6142   00:5E32                      ;
    6143   00:5E32                      ;Input:  A = 27
    6144   00:5E32                      ;        B = 0: Get current values (just return 255 for TTL and 0 for TOS
    6145   00:5E32                      ;               as ESP do not expose or allow configurations of it)
    6146   00:5E32                      ;            1: Set values
    6147   00:5E32                      ;        D = New value for TTL (only if B=1)
    6148   00:5E32                      ;        E = New value for ToS (only if B=1)
    6149   00:5E32                      ;Output: A = Error code
    6150   00:5E32                      ;        D = Value of TTL after the routine execution
    6151   00:5E32                      ;        E = Value of ToS after the routine execution
    6152   00:5E32                      TCPIP_CONFIG_TTL:
    6153   00:5E32  78                      ld  a,b
    6154   00:5E33  E6 FE                   and %11111110
    6155   00:5E35  B7                      or  a
    6156   00:5E36  3E 04                   ld  a,ERR_INV_PARAM
    6157   00:5E38  C0                      ret nz
    6158   00:5E39  78                      ld  a,b
    6159   00:5E3A  B7                      or  a
    6160   00:5E3B                          ; Cant set, so NOT IMP
    6161   00:5E3B  3E 01                   ld  a,ERR_NOT_IMP
    6162   00:5E3D  C0                      ret nz                          ; if not get, not implemented
    6163   00:5E3E                          ; get, so just return D = #FF, A = OK = 0 and E = 0
    6164   00:5E3E  AF                      xor a
    6165   00:5E3F  1E 00                   ld  e,0
    6166   00:5E41  16 FF                   ld  d,#FF
    6167   00:5E43  C9                      ret
    6168   00:5E44                      
    6169   00:5E44                      ;===========================
    6170   00:5E44                      ;===  TCPIP_CONFIG_PING  ===
    6171   00:5E44                      ;===========================
    6172   00:5E44                      ;Get/set the automatic PING reply flag.
    6173   00:5E44                      ;
    6174   00:5E44                      ;Input:  A = 28
    6175   00:5E44                      ;        B = 0: Get current flag value
    6176   00:5E44                      ;            1: Set flag value (ERR_NOT_IMP)
    6177   00:5E44                      ;        C = New flag value (only if B=1):
    6178   00:5E44                      ;            0: Off
    6179   00:5E44                      ;            1: On
    6180   00:5E44                      ;Output: A = Error code
    6181   00:5E44                      ;        C = Flag value after the routine execution
    6182   00:5E44                      TCPIP_CONFIG_PING:
    6183   00:5E44  78                      ld  a,b
    6184   00:5E45  E6 FE                   and %11111110
    6185   00:5E47  B7                      or  a
    6186   00:5E48  3E 04                   ld  a,ERR_INV_PARAM
    6187   00:5E4A  C0                      ret nz
    6188   00:5E4B  78                      ld  a,b
    6189   00:5E4C  B7                      or  a
    6190   00:5E4D                          ; Cant set, so NOT IMP
    6191   00:5E4D  3E 01                   ld  a,ERR_NOT_IMP
    6192   00:5E4F  C0                      ret nz                          ; if not get, not implemented
    6193   00:5E50                          ; get, so just return C = 1, A = OK = 0
    6194   00:5E50  AF                      xor a
    6195   00:5E51  0E 01                   ld  c,1
    6196   00:5E53  C9                      ret
    6197   00:5E54                      
    6198   00:5E54                      ;============================
    6199   00:5E54                      ;===  Auxiliary routines  ===
    6200   00:5E54                      ;============================
    6201   00:5E54                      
    6202   00:5E54                      ;--- Get slot connected on page 1
    6203   00:5E54                      ;    Input:  -
    6204   00:5E54                      ;    Output: A = Slot number
    6205   00:5E54                      ;    Modifies: AF, HL, E, BC
    6206   00:5E54                      
    6207   00:5E54                      GETSLT:
    6208   00:5E54  DB A8                   in  a,(#A8)
