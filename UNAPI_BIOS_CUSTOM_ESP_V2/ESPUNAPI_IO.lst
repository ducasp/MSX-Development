    3020   00:5015                          RECEIVE_DATA
    3020   00:5015  DB 06             >     in a,(IN_DATA_PORT)
    3021   00:5017  6F                      ld  l,a
    3022   00:5018                      TCPIP_GET_IPINFO_IP_ST2:
    3023   00:5018                          CHECK_DATA
