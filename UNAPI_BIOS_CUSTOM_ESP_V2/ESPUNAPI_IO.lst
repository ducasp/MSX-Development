    6001   00:5D96                      ;=============================
    6002   00:5D96                      ;===  TCPIP_CONFIG_AUTOIP  ===
    6003   00:5D96                      ;=============================
    6004   00:5D96                      ;Enable or disable the automatic IP addresses retrieval.
    6005   00:5D96                      ;
    6006   00:5D96                      ;Input:  A = 25
    6007   00:5D96                      ;        B = 0: Get current configuration
    6008   00:5D96                      ;            1: Set configuration
    6009   00:5D96                      ;        C = Configuration to set (only if B=1):
    6010   00:5D96                      ;            bit 0: Set to automatically retrieve
    6011   00:5D96                      ;                   local IP address, subnet mask and default gateway
    6012   00:5D96                      ;            bit 1: Set to automatically retrieve DNS servers addresses
    6013   00:5D96                      ;            bits 2-7: Unused, must be zero
    6014   00:5D96                      ;Output: A = Error code
    6015   00:5D96                      ;        C = Configuration after the routine execution
    6016   00:5D96                      ;            (same format as C at input)
    6017   00:5D96                      TCPIP_CONFIG_AUTOIP:
    6018   00:5D96                          SEND_DATA                       ; Send the command
    6018   00:5D96  D3 07             >     out (OUT_TX_PORT),a
    6019   00:5D98  AF                      xor a
    6020   00:5D99                          SEND_DATA                       ; Send the command size msb
    6020   00:5D99  D3 07             >     out (OUT_TX_PORT),a
    6021   00:5D9B  3E 02                   ld  a,2
    6022   00:5D9D                          SEND_DATA                       ; Send the command size lsb
    6022   00:5D9D  D3 07             >     out (OUT_TX_PORT),a
    6023   00:5D9F  78                      ld  a,b
    6024   00:5DA0                          SEND_DATA                       ; Send the command
    6024   00:5DA0  D3 07             >     out (OUT_TX_PORT),a
    6025   00:5DA2  79                      ld  a,c
    6026   00:5DA3                          SEND_DATA                       ; Send the command parameter
    6026   00:5DA3  D3 07             >     out (OUT_TX_PORT),a
    6027   00:5DA5                      
    6028   00:5DA5                          ; Now wait up to 180 ticks to get response
    6029   00:5DA5  21 B4 00                ld hl,180
    6030   00:5DA8  CD EC 5E                call    SETCOUNTER
    6031   00:5DAB                      TCPIP_CONFIG_AUTOIP_ST1:
    6032   00:5DAB                          CHECK_DATA
    6032   00:5DAB  DB 07             >     in  a,(IN_STS_PORT)
    6032   00:5DAD  CB 47             >     bit 0,a
    6033   00:5DAF  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_ST1.1
    6034   00:5DB1  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6035   00:5DB4  18 F5                   jr  TCPIP_CONFIG_AUTOIP_ST1
    6036   00:5DB6                      TCPIP_CONFIG_AUTOIP_ST1.1:
    6037   00:5DB6                          ; nz, check the data
    6038   00:5DB6                          RECEIVE_DATA
    6038   00:5DB6  DB 06             >     in a,(IN_DATA_PORT)
    6039   00:5DB8  FE 19                   cp  25                          ; Is response of our command?
    6040   00:5DBA  20 EF                   jr  nz,TCPIP_CONFIG_AUTOIP_ST1
    6041   00:5DBC                          ; now get return code, if return code other than 0, it is finished
    6042   00:5DBC                      TCPIP_CONFIG_AUTOIP_RC:
    6043   00:5DBC                          CHECK_DATA
    6043   00:5DBC  DB 07             >     in  a,(IN_STS_PORT)
    6043   00:5DBE  CB 47             >     bit 0,a
    6044   00:5DC0  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_RC.1
    6045   00:5DC2  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6046   00:5DC5  18 F5                   jr  TCPIP_CONFIG_AUTOIP_RC
    6047   00:5DC7                      TCPIP_CONFIG_AUTOIP_RC.1:
    6048   00:5DC7                          ;nz, discard
    6049   00:5DC7                          RECEIVE_DATA
    6049   00:5DC7  DB 06             >     in a,(IN_DATA_PORT)
    6050   00:5DC9  B7                      or  a                           ; 0?
    6051   00:5DCA  C0                      ret nz                          ; if not, done
    6052   00:5DCB                      
    6053   00:5DCB                          ; next two bytes are return code and size bytes, don't care, it is 1, configuration
    6054   00:5DCB  06 02                   ld  b,2
    6055   00:5DCD                      TCPIP_CONFIG_AUTOIP_ST2:
    6056   00:5DCD                          CHECK_DATA
    6056   00:5DCD  DB 07             >     in  a,(IN_STS_PORT)
    6056   00:5DCF  CB 47             >     bit 0,a
    6057   00:5DD1  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_ST2.1
    6058   00:5DD3  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6059   00:5DD6  18 F5                   jr  TCPIP_CONFIG_AUTOIP_ST2
    6060   00:5DD8                      TCPIP_CONFIG_AUTOIP_ST2.1:
    6061   00:5DD8                          ; nz, discard
    6062   00:5DD8                          RECEIVE_DATA
    6062   00:5DD8  DB 06             >     in a,(IN_DATA_PORT)
    6063   00:5DDA  05                      dec b
    6064   00:5DDB  20 F0                   jr  nz,TCPIP_CONFIG_AUTOIP_ST2
    6065   00:5DDD                      
    6066   00:5DDD                          ; now just get the 1 byte, configuration, should go to C
    6067   00:5DDD                      TCPIP_CONFIG_AUTOIP_CONF_ST1:
    6068   00:5DDD                          CHECK_DATA
    6068   00:5DDD  DB 07             >     in  a,(IN_STS_PORT)
    6068   00:5DDF  CB 47             >     bit 0,a
    6069   00:5DE1  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_CONF_ST1.1
    6070   00:5DE3  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6071   00:5DE6  18 F5                   jr  TCPIP_CONFIG_AUTOIP_CONF_ST1
    6072   00:5DE8                      TCPIP_CONFIG_AUTOIP_CONF_ST1.1:
    6073   00:5DE8                          ; nz, get it
    6074   00:5DE8                          RECEIVE_DATA
    6074   00:5DE8  DB 06             >     in a,(IN_DATA_PORT)
    6075   00:5DEA  4F                      ld  c,a
    6076   00:5DEB                          ; done
    6077   00:5DEB  AF                      xor a
    6078   00:5DEC  C9                      ret
    6079   00:5DED                      
    6080   00:5DED                      ;=========================
    6081   00:5DED                      ;===  TCPIP_CONFIG_IP  ===
    6082   00:5DED                      ;=========================
    6083   00:5DED                      ;Manually configure an IP address.
    6084   00:5DED                      ;
    6085   00:5DED                      ;Input:  A = 26
    6086   00:5DED                      ;        B = Index of address to set:
    6087   00:5DED                      ;            1: Local IP address
    6088   00:5DED                      ;            2: Peer IP address
    6089   00:5DED                      ;            3: Subnet mask
    6090   00:5DED                      ;            4: Default gateway
    6091   00:5DED                      ;            5: Primary DNS server IP address
    6092   00:5DED                      ;            6: Secondary DNS server IP address
    6093   00:5DED                      ;        L.H.E.D = Address value
    6094   00:5DED                      ;Output: A = Error code
    6095   00:5DED                      TCPIP_CONFIG_IP:
    6096   00:5DED                          SEND_DATA                       ; Send the command
    6096   00:5DED  D3 07             >     out (OUT_TX_PORT),a
    6097   00:5DEF  AF                      xor a
    6098   00:5DF0                          SEND_DATA                       ; Send the command size msb
    6098   00:5DF0  D3 07             >     out (OUT_TX_PORT),a
    6099   00:5DF2  3E 05                   ld  a,5
    6100   00:5DF4                          SEND_DATA                       ; Send the command size lsb
    6100   00:5DF4  D3 07             >     out (OUT_TX_PORT),a
    6101   00:5DF6  78                      ld  a,b
    6102   00:5DF7                          SEND_DATA                       ; Send the address to set
    6102   00:5DF7  D3 07             >     out (OUT_TX_PORT),a
    6103   00:5DF9  7D                      ld  a,l
    6104   00:5DFA                          SEND_DATA                       ; Send the IP first byte
    6104   00:5DFA  D3 07             >     out (OUT_TX_PORT),a
    6105   00:5DFC  7C                      ld  a,h
    6106   00:5DFD                          SEND_DATA                       ; Send the IP second byte
    6106   00:5DFD  D3 07             >     out (OUT_TX_PORT),a
    6107   00:5DFF  7B                      ld  a,e
    6108   00:5E00                          SEND_DATA                       ; Send the IP third byte
    6108   00:5E00  D3 07             >     out (OUT_TX_PORT),a
    6109   00:5E02  7A                      ld  a,d
    6110   00:5E03                          SEND_DATA                       ; Send the IP fourth byte
    6110   00:5E03  D3 07             >     out (OUT_TX_PORT),a
    6111   00:5E05                      
    6112   00:5E05                          ; Now wait up to 180 ticks to get response
    6113   00:5E05  21 B4 00                ld  hl,180
    6114   00:5E08  CD EC 5E                call    SETCOUNTER
    6115   00:5E0B                      TCPIP_CONFIG_IP_ST1:
    6116   00:5E0B                          CHECK_DATA
    6116   00:5E0B  DB 07             >     in  a,(IN_STS_PORT)
    6116   00:5E0D  CB 47             >     bit 0,a
    6117   00:5E0F  20 05                   jr  nz,TCPIP_CONFIG_IP_ST1.1
    6118   00:5E11  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6119   00:5E14  18 F5                   jr  TCPIP_CONFIG_IP_ST1
    6120   00:5E16                      TCPIP_CONFIG_IP_ST1.1:
    6121   00:5E16                          ; nz, check the data
    6122   00:5E16                          RECEIVE_DATA
    6122   00:5E16  DB 06             >     in a,(IN_DATA_PORT)
    6123   00:5E18  FE 1A                   cp  26                          ; Is response of our command?
    6124   00:5E1A  20 EF                   jr  nz,TCPIP_CONFIG_IP_ST1
    6125   00:5E1C                          ; now get return code, and that is it
    6126   00:5E1C                      TCPIP_CONFIG_IP_RC:
    6127   00:5E1C                          CHECK_DATA
    6127   00:5E1C  DB 07             >     in  a,(IN_STS_PORT)
    6127   00:5E1E  CB 47             >     bit 0,a
    6128   00:5E20  20 05                   jr  nz,TCPIP_CONFIG_IP_RC.1
    6129   00:5E22  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6130   00:5E25  18 F5                   jr  TCPIP_CONFIG_IP_RC
    6131   00:5E27                      TCPIP_CONFIG_IP_RC.1:
    6132   00:5E27                          ; nz, discard
    6133   00:5E27                          RECEIVE_DATA
    6133   00:5E27  DB 06             >     in a,(IN_DATA_PORT)
    6134   00:5E29  C9                      ret                             ; done
    6135   00:5E2A                      
    6136   00:5E2A                      ;==========================
    6137   00:5E2A                      ;===  TCPIP_CONFIG_TTL  ===
    6138   00:5E2A                      ;==========================
    6139   00:5E2A                      ;Get/set the value of TTL and TOS for outgoing datagrams.
    6140   00:5E2A                      ;
    6141   00:5E2A                      ;Input:  A = 27
    6142   00:5E2A                      ;        B = 0: Get current values (just return 255 for TTL and 0 for TOS
    6143   00:5E2A                      ;               as ESP do not expose or allow configurations of it)
    6144   00:5E2A                      ;            1: Set values
    6145   00:5E2A                      ;        D = New value for TTL (only if B=1)
    6146   00:5E2A                      ;        E = New value for ToS (only if B=1)
    6147   00:5E2A                      ;Output: A = Error code
    6148   00:5E2A                      ;        D = Value of TTL after the routine execution
    6149   00:5E2A                      ;        E = Value of ToS after the routine execution
    6150   00:5E2A                      TCPIP_CONFIG_TTL:
    6151   00:5E2A  78                      ld  a,b
    6152   00:5E2B  E6 FE                   and %11111110
    6153   00:5E2D  B7                      or  a
    6154   00:5E2E  3E 04                   ld  a,ERR_INV_PARAM
    6155   00:5E30  C0                      ret nz
    6156   00:5E31  78                      ld  a,b
    6157   00:5E32  B7                      or  a
    6158   00:5E33                          ; Cant set, so NOT IMP
    6159   00:5E33  3E 01                   ld  a,ERR_NOT_IMP
    6160   00:5E35  C0                      ret nz                          ; if not get, not implemented
    6161   00:5E36                          ; get, so just return D = #FF, A = OK = 0 and E = 0
    6162   00:5E36  AF                      xor a
    6163   00:5E37  1E 00                   ld  e,0
    6164   00:5E39  16 FF                   ld  d,#FF
    6165   00:5E3B  C9                      ret
    6166   00:5E3C                      
    6167   00:5E3C                      ;===========================
    6168   00:5E3C                      ;===  TCPIP_CONFIG_PING  ===
    6169   00:5E3C                      ;===========================
    6170   00:5E3C                      ;Get/set the automatic PING reply flag.
    6171   00:5E3C                      ;
    6172   00:5E3C                      ;Input:  A = 28
    6173   00:5E3C                      ;        B = 0: Get current flag value
    6174   00:5E3C                      ;            1: Set flag value (ERR_NOT_IMP)
    6175   00:5E3C                      ;        C = New flag value (only if B=1):
    6176   00:5E3C                      ;            0: Off
    6177   00:5E3C                      ;            1: On
    6178   00:5E3C                      ;Output: A = Error code
    6179   00:5E3C                      ;        C = Flag value after the routine execution
    6180   00:5E3C                      TCPIP_CONFIG_PING:
    6181   00:5E3C  78                      ld  a,b
    6182   00:5E3D  E6 FE                   and %11111110
    6183   00:5E3F  B7                      or  a
    6184   00:5E40  3E 04                   ld  a,ERR_INV_PARAM
    6185   00:5E42  C0                      ret nz
    6186   00:5E43  78                      ld  a,b
    6187   00:5E44  B7                      or  a
    6188   00:5E45                          ; Cant set, so NOT IMP
    6189   00:5E45  3E 01                   ld  a,ERR_NOT_IMP
    6190   00:5E47  C0                      ret nz                          ; if not get, not implemented
    6191   00:5E48                          ; get, so just return C = 1, A = OK = 0
    6192   00:5E48  AF                      xor a
    6193   00:5E49  0E 01                   ld  c,1
    6194   00:5E4B  C9                      ret
    6195   00:5E4C                      
    6196   00:5E4C                      ;============================
    6197   00:5E4C                      ;===  Auxiliary routines  ===
    6198   00:5E4C                      ;============================
    6199   00:5E4C                      
    6200   00:5E4C                      ;--- Get slot connected on page 1
    6201   00:5E4C                      ;    Input:  -
    6202   00:5E4C                      ;    Output: A = Slot number
    6203   00:5E4C                      ;    Modifies: AF, HL, E, BC
    6204   00:5E4C                      
    6205   00:5E4C                      GETSLT:
    6206   00:5E4C  DB A8                   in  a,(#A8)
    6207   00:5E4E  0F                      rrca
    6208   00:5E4F  0F                      rrca
    6209   00:5E50  E6 03                   and 3
    6210   00:5E52  4F                      ld  c,a                         ;C = Slot
    6211   00:5E53  06 00                   ld  b,0
    6212   00:5E55  21 C1 FC                ld  hl,EXPTBL
    6213   00:5E58  09                      add hl,bc
    6214   00:5E59  7E                      ld  a,(hl)
    6215   00:5E5A  E6 80                   and #80
    6216   00:5E5C  B1                      or  c
    6217   00:5E5D  4F                      ld  c,a
    6218   00:5E5E  23                      inc hl
    6219   00:5E5F  23                      inc hl
    6220   00:5E60  23                      inc hl
    6221   00:5E61  23                      inc hl
    6222   00:5E62  7E                      ld  a,(hl)
    6223   00:5E63  E6 0C                   and #0C
    6224   00:5E65  B1                      or  c
    6225   00:5E66  CB 7F                   bit 7,a
    6226   00:5E68  C0                      ret nz
    6227   00:5E69  E6 03                   and %11
    6228   00:5E6B  C9                      ret
    6229   00:5E6C                      
    6230   00:5E6C                      ;--- Get slot connected on page 1 and test if work area has been created, if not, create it
    6231   00:5E6C                      ;    Input:  -
    6232   00:5E6C                      ;    Output: A = Slot number
    6233   00:5E6C                      ;    Modifies: AF, HL, E, BC
    6234   00:5E6C                      
    6235   00:5E6C                      GETSLTT:
    6236   00:5E6C  DB A8                   in  a,(#A8)
    6237   00:5E6E  0F                      rrca
    6238   00:5E6F  0F                      rrca
    6239   00:5E70  E6 03                   and 3
    6240   00:5E72  4F                      ld  c,a                         ;C = Slot
    6241   00:5E73  06 00                   ld  b,0
    6242   00:5E75  21 C1 FC                ld  hl,EXPTBL
    6243   00:5E78  09                      add hl,bc
    6244   00:5E79  7E                      ld  a,(hl)
    6245   00:5E7A  E6 80                   and #80
    6246   00:5E7C  B1                      or  c
    6247   00:5E7D  4F                      ld  c,a
    6248   00:5E7E  23                      inc hl
    6249   00:5E7F  23                      inc hl
    6250   00:5E80  23                      inc hl
    6251   00:5E81  23                      inc hl
    6252   00:5E82  7E                      ld  a,(hl)
    6253   00:5E83  E6 0C                   and #0C
    6254   00:5E85  B1                      or  c
    6255   00:5E86  CB 7F                   bit 7,a
    6256   00:5E88  C2 8D 5E                jp  nz,GETSLTT1
    6257   00:5E8B  E6 03                   and %11
    6258   00:5E8D                      GETSLTT1:
    6259   00:5E8D  F5                      push    af
    6260   00:5E8E  C5                      push    bc
    6261   00:5E8F  E5                      push    hl
    6262   00:5E90  CD A5 5E                call    GETWRK
    6263   00:5E93  01 05 00                ld  bc,5
    6264   00:5E96  09                      add hl,bc
    6265   00:5E97  7E                      ld  a,(hl)
    6266   00:5E98  B7                      or  a
    6267   00:5E99  C2 A1 5E                jp  nz,GETSLTTRET
    6268   00:5E9C  3C                      inc a
    6269   00:5E9D  77                      ld  (hl),a
    6270   00:5E9E  CD E8 41                call    HIMEM_ALLOC
    6271   00:5EA1                      GETSLTTRET:
    6272   00:5EA1  E1                      pop hl
    6273   00:5EA2  C1                      pop bc
    6274   00:5EA3  F1                      pop af
    6275   00:5EA4  C9                      ret
    6276   00:5EA5                      
    6277   00:5EA5                      ;--- Obtain slot work area (8 bytes) on SLTWRK
    6278   00:5EA5                      ;    Input:  A  = Slot number
    6279   00:5EA5                      ;    Output: HL = Work area address
    6280   00:5EA5                      ;    Modifies: AF, BC
    6281   00:5EA5                      
    6282   00:5EA5                      GETWRK:
    6283   00:5EA5  47                      ld  b,a
    6284   00:5EA6  0F                      rrca
    6285   00:5EA7  0F                      rrca
    6286   00:5EA8  0F                      rrca
    6287   00:5EA9  E6 60                   and %01100000
    6288   00:5EAB  4F                      ld  c,a                         ;C = Slot * 32
    6289   00:5EAC  78                      ld  a,b
    6290   00:5EAD  07                      rlca
    6291   00:5EAE  E6 18                   and %00011000                   ;A = Subslot * 8
    6292   00:5EB0  B1                      or  c
    6293   00:5EB1  4F                      ld  c,a
