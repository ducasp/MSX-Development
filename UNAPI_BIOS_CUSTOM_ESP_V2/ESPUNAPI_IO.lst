    3508   00:5222  CB 47             >     bit 0,a
    3509   00:5224  20 05                   jr  nz,TCPIP_UDP_STATE_ST1.1
    3510   00:5226  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3511   00:5229  18 F5                   jr  TCPIP_UDP_STATE_ST1
    3512   00:522B                      TCPIP_UDP_STATE_ST1.1:
    3513   00:522B                          ; nz, check the data
