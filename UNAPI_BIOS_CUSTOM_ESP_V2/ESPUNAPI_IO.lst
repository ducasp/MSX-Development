    3089   00:5073  DB 06             >     in a,(IN_DATA_PORT)
    3090   00:5075  B7                      or  a                           ; 0?
    3091   00:5076  C0                      ret nz                          ; if not, done
    3092   00:5077                      
    3093   00:5077                          ; next two bytes are return code and size bytes, don't care, it is 1
    3094   00:5077  06 02                   ld  b,2
    3095   00:5079                      TCPIP_NET_STATE_ST2:
    3096   00:5079                          CHECK_DATA
    3096   00:5079  DB 07             >     in  a,(IN_STS_PORT)
    3096   00:507B  CB 47             >     bit 0,a
    3097   00:507D  20 05                   jr  nz,TCPIP_NET_STATE_ST2.1
