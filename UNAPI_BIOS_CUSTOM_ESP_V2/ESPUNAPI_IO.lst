    2108   00:4BE4                          RECEIVE_DATA
    2108   00:4BE4  DB 06             >     in a,(IN_DATA_PORT)
    2109   00:4BE6  B7                      or  a                           ; 0?
    2110   00:4BE7                          ; If not, done
    2111   00:4BE7  C2 38 4C                jp  nz,WAIT_MENU_SCMD_RESPONSE_END_NOK
    2112   00:4BEA                          ; Next byte is how many access points are available
