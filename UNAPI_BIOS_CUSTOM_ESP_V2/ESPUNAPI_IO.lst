    2968   00:4FCF  D3 07             >     out (OUT_TX_PORT),a
    2969   00:4FD1  AF                      xor a
    2970   00:4FD2                          SEND_DATA                       ; Send the command size msb
    2970   00:4FD2  D3 07             >     out (OUT_TX_PORT),a
    2971   00:4FD4  3C                      inc a
    2972   00:4FD5                          SEND_DATA                       ; Send the command size lsb
    2972   00:4FD5  D3 07             >     out (OUT_TX_PORT),a
    2973   00:4FD7  78                      ld  a,b
    2974   00:4FD8                          SEND_DATA
    2974   00:4FD8  D3 07             >     out (OUT_TX_PORT),a
    2975   00:4FDA                      
    2976   00:4FDA                          ; Now wait up to 600 ticks to get response
    2977   00:4FDA  21 58 02                ld  hl,600
    2978   00:4FDD  CD F4 5E                call    SETCOUNTER
    2979   00:4FE0                      TCPIP_GET_IPINFO_ST1:
    2980   00:4FE0                          CHECK_DATA
    2980   00:4FE0  DB 07             >     in  a,(IN_STS_PORT)
    2980   00:4FE2  CB 47             >     bit 0,a
    2981   00:4FE4  20 05                   jr  nz,TCPIP_GET_IPINFO_ST1.1
