    4734   00:57BE                      ;=========================
    4735   00:57BE                      ;===  TCPIP_TCP_STATE  ===
    4736   00:57BE                      ;=========================
    4737   00:57BE                      ;Get the state of a TCP connection.
    4738   00:57BE                      ;
    4739   00:57BE                      ;Input:  A = 16
    4740   00:57BE                      ;        B = Connection number
    4741   00:57BE                      ;        HL = Pointer in TPA for connection information block
    4742   00:57BE                      ;             (0 if not needed)
    4743   00:57BE                      ;Output: A  = Error code
    4744   00:57BE                      ;        B  = Connection state
    4745   00:57BE                      ;        C  = Close reason (only if ERR_NO_CONN is returned)
    4746   00:57BE                      ;        HL = Number of total available incoming bytes
    4747   00:57BE                      ;        DE = Number of urgent available incoming bytes
    4748   00:57BE                      ;        IX = Available free space in the output buffer
    4749   00:57BE                      ;             (0FFFFh = infinite)
    4750   00:57BE                      ;
    4751   00:57BE                      ;Connection information block consists of:
    4752   00:57BE                      ;
    4753   00:57BE                      ;    +0 (4): Remote IP address
    4754   00:57BE                      ;    +4 (2): Remote port
    4755   00:57BE                      ;    +6 (2): Local port
    4756   00:57BE                      TCPIP_TCP_STATE_ERROR:
    4757   00:57BE                          ; next two bytes are size bytes, don't care
    4758   00:57BE  47                      ld  b,a                         ; save error in b
    4759   00:57BF  0E 02                   ld  c,2
    4760   00:57C1                      TCPIP_TCP_STATE_ERROR2:
    4761   00:57C1                          CHECK_DATA
    4761   00:57C1  DB 07             >     in  a,(IN_STS_PORT)
    4761   00:57C3  CB 47             >     bit 0,a
    4762   00:57C5  20 05                   jr  nz,TCPIP_TCP_STATE_ERROR2.1
    4763   00:57C7  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4764   00:57CA  18 F5                   jr  TCPIP_TCP_STATE_ERROR2
    4765   00:57CC                      TCPIP_TCP_STATE_ERROR2.1:
    4766   00:57CC                          ; nz, discard
    4767   00:57CC                          RECEIVE_DATA
    4767   00:57CC  DB 06             >     in a,(IN_DATA_PORT)
    4768   00:57CE  0D                      dec c
    4769   00:57CF  20 F0                   jr  nz,TCPIP_TCP_STATE_ERROR2
    4770   00:57D1                      
    4771   00:57D1                          ; now return w/ error that is saved in b
    4772   00:57D1  78                      ld  a,b
    4773   00:57D2  06 00                   ld  b,0
    4774   00:57D4  0E 07                   ld  c,7
    4775   00:57D6  21 00 00                ld  hl,0
    4776   00:57D9  11 00 00                ld  de,0
    4777   00:57DC  DD 21 00 00             ld  ix,0
    4778   00:57E0  C9                      ret
    4779   00:57E1                      
    4780   00:57E1                      TCPIP_TCP_STATE:
    4781   00:57E1  CD 09 5D                call    SETWORD                 ; Save HL pointer in our memory
