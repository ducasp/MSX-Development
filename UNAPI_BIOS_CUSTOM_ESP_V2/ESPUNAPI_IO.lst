    3116   00:5097                          ; done
    3117   00:5097  AF                      xor a
    3118   00:5098  C9                      ret
    3119   00:5099                      
    3120   00:5099                      ;=====================
    3121   00:5099                      ;===  TCPIP_DNS_Q  ===
    3122   00:5099                      ;=====================
    3123   00:5099                      ;Start a host name resolution query.
    3124   00:5099                      ;
    3125   00:5099                      ;Input:  A  = 6
    3126   00:5099                      ;        HL = Address of the host name to be resolved, zero terminated
    3127   00:5099                      ;        B  = Flags, when set to 1 they instruct the resolver to:
    3128   00:5099                      ;             bit 0: Only abort the query currently in progress, if there is any
    3129   00:5099                      ;                    (other flags and registers are then ignored)
    3130   00:5099                      ;             bit 1: Assume that the passed name is an IP address,
    3131   00:5099                      ;                    and return an error if this is not true
    3132   00:5099                      ;             bit 2: If there is a query in progress already,
    3133   00:5099                      ;                    do NOT abort it and return an error instead
    3134   00:5099                      ;Output:  A = Error code
    3135   00:5099                      ;         B = 0 if a query to a DNS server is in progress
    3136   00:5099                      ;             1 if the name represented an IP address
    3137   00:5099                      ;             2 if the name could be resolved locally
    3138   00:5099                      ;         L.H.E.D = Resolved IP address
    3139   00:5099                      ;                   (only if no error occurred and B=1 or 2 is returned)
    3140   00:5099                      ;RAM Buffer to store names to be resolved (and used also to translate IPs from ASCII to 32bits number)
    3141   00:5099                      ;Will store the result of the last DNS query
    3142   00:5099                      TCPIP_DNS_Q:
    3143   00:5099  E5                      push    hl                      ; Save HL
    3144   00:509A  AF                      xor a
    3145   00:509B  5F                      ld  e,a
    3146   00:509C  57                      ld  d,a                         ; Zero DE
    3147   00:509D                      TCPIP_DNS_Q_SIZE_LOOP:
    3148   00:509D  7E                      ld  a,(hl)                      ; so let's check the size of dns data
    3149   00:509E  B7                      or  a                           ; it is zero terminated
    3150   00:509F  28 05                   jr  z,TCPIP_DNS_Q_SEND          ; if zero, end of string
    3151   00:50A1  13                      inc de                          ; ok, not zero, one more char
    3152   00:50A2  23                      inc hl                          ; next
    3153   00:50A3  C3 9D 50                jp  TCPIP_DNS_Q_SIZE_LOOP       ; jp is a tad bit faster and we are not worried about code size
    3154   00:50A6                      TCPIP_DNS_Q_SEND:
    3155   00:50A6                          ; Here we send the query and wait the result
    3156   00:50A6  13                      inc de                          ; add 1, we will send flag first
    3157   00:50A7  3E CE                   ld  a,206                       ; DNS_Q_NEW
    3158   00:50A9                          SEND_DATA                       ; Send the command
    3158   00:50A9  D3 07             >     out (OUT_TX_PORT),a
    3159   00:50AB  7A                      ld  a,d
    3160   00:50AC                          SEND_DATA                       ; Send the command size msb
    3160   00:50AC  D3 07             >     out (OUT_TX_PORT),a
    3161   00:50AE  7B                      ld  a,e
    3162   00:50AF                          SEND_DATA                       ; Send the command size lsb
    3162   00:50AF  D3 07             >     out (OUT_TX_PORT),a
    3163   00:50B1  78                      ld  a,b
    3164   00:50B2                          SEND_DATA                       ; Send the flag byte
    3164   00:50B2  D3 07             >     out (OUT_TX_PORT),a
    3165   00:50B4                      
    3166   00:50B4                          if USE_MEM_IO = 0
    3167   00:50B4                          ; now otir of DNS/DNS BUFFER DATA SIZE
    3168   00:50B4  0E 07                   ld  c,OUT_TX_PORT               ; our data TX port
    3169   00:50B6                          endif
    3170   00:50B6  E1                      pop hl                          ; string to try to resolve
    3171   00:50B7  1B                      dec de                          ; we are sending just data addressed by HL, so revert count
    3172   00:50B8  7A                      ld  a,d
    3173   00:50B9  B3                      or  e                           ; if de zero, no string, wrong parameters, but let the ESP answer
    3174   00:50BA  CA CA 50                jp  z,TCPIP_DNS_Q_WAIT_RSP
    3175   00:50BD  AF                      xor a
    3176   00:50BE                          ; Fast 16 bit variable size loop by GRAUW
    3177   00:50BE  43                      ld  b,e
    3178   00:50BF  1B                      dec de
    3179   00:50C0  14                      inc d
    3180   00:50C1                      TCPIP_DNS_Q_SENDLP:
    3181   00:50C1                          ; send it
    3182   00:50C1                          if USE_MEM_IO = 0
    3183   00:50C1  ED A3                   outi
    3184   00:50C3  C2 C1 50                jp  nz,TCPIP_DNS_Q_SENDLP
    3185   00:50C6                          else
    3186   00:50C6                    ~     ld  a,(hl)
    3187   00:50C6                    ~     ld  (MEM_OUT_TX_PORT),a
    3188   00:50C6                    ~     inc hl
    3189   00:50C6                    ~     djnz TCPIP_DNS_Q_SENDLP
    3190   00:50C6                    ~     endif
    3191   00:50C6  15                      dec d
    3192   00:50C7  C2 C1 50                jp  nz,TCPIP_DNS_Q_SENDLP
    3193   00:50CA                      TCPIP_DNS_Q_WAIT_RSP:
    3194   00:50CA                          ; Now wait up to 900 ticks (15s@60Hz) to get response
    3195   00:50CA  21 84 03                ld  hl,900
    3196   00:50CD  CD DF 60                call    SETCOUNTER
    3197   00:50D0                      TCPIP_DNSQ_SEND_ST1:
    3198   00:50D0                          CHECK_DATA
    3198   00:50D0  DB 07             >     in  a,(IN_STS_PORT)
    3198   00:50D2  CB 47             >     bit 0,a
    3199   00:50D4  20 05                   jr  nz,TCPIP_DNSQ_SEND_ST1.1
    3200   00:50D6  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3201   00:50D9  18 F5                   jr  TCPIP_DNSQ_SEND_ST1
    3202   00:50DB                      TCPIP_DNSQ_SEND_ST1.1:
    3203   00:50DB                          ; nz, check the data
    3204   00:50DB                          RECEIVE_DATA
    3204   00:50DB  DB 06             >     in a,(IN_DATA_PORT)
    3205   00:50DD  FE CE                   cp  206                         ; Is response of our command?
    3206   00:50DF  20 EF                   jr  nz,TCPIP_DNSQ_SEND_ST1
    3207   00:50E1                          ; now get return code, if return code other than 0, it is finished
    3208   00:50E1                      TCPIP_DNSQ_SEND_RC:
    3209   00:50E1                          CHECK_DATA
    3209   00:50E1  DB 07             >     in  a,(IN_STS_PORT)
    3209   00:50E3  CB 47             >     bit 0,a
    3210   00:50E5  20 05                   jr  nz,TCPIP_DNSQ_SEND_RC.1
    3211   00:50E7  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3212   00:50EA  18 F5                   jr  TCPIP_DNSQ_SEND_RC
    3213   00:50EC                      TCPIP_DNSQ_SEND_RC.1:
    3214   00:50EC                          ; nz, discard
    3215   00:50EC                          RECEIVE_DATA
    3215   00:50EC  DB 06             >     in a,(IN_DATA_PORT)
    3216   00:50EE  B7                      or  a                           ; 0?
    3217   00:50EF  06 00                   ld  b,0                         ; say in progress as there is no failure status
    3218   00:50F1  C0                      ret nz                          ; if not, done, ERROR won't return data
    3219   00:50F2                      
    3220   00:50F2                          ; next two bytes are return code and size bytes, don't care, it is 4, resolved IP
    3221   00:50F2  06 02                   ld  b,2
    3222   00:50F4                      TCPIP_DNSQ_SEND_RC_ST2:
    3223   00:50F4                          CHECK_DATA
    3223   00:50F4  DB 07             >     in  a,(IN_STS_PORT)
    3223   00:50F6  CB 47             >     bit 0,a
    3224   00:50F8  20 05                   jr  nz,TCPIP_DNSQ_SEND_RC_ST2.1
    3225   00:50FA  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3226   00:50FD  18 F5                   jr  TCPIP_DNSQ_SEND_RC_ST2
    3227   00:50FF                      TCPIP_DNSQ_SEND_RC_ST2.1:
    3228   00:50FF                          ; nz, discard
    3229   00:50FF                          RECEIVE_DATA
    3229   00:50FF  DB 06             >     in a,(IN_DATA_PORT)
    3230   00:5101  05                      dec b
    3231   00:5102  20 F0                   jr  nz,TCPIP_DNSQ_SEND_RC_ST2
    3232   00:5104                      
    3233   00:5104                          ; now just get the 4 bytes IP and place it in L H E D
    3234   00:5104                      TCPIP_DNSQ_IP_ST1:
    3235   00:5104                          CHECK_DATA
    3235   00:5104  DB 07             >     in  a,(IN_STS_PORT)
    3235   00:5106  CB 47             >     bit 0,a
    3236   00:5108  20 05                   jr  nz,TCPIP_DNSQ_IP_ST1.1
    3237   00:510A  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3238   00:510D  18 F5                   jr  TCPIP_DNSQ_IP_ST1
    3239   00:510F                      TCPIP_DNSQ_IP_ST1.1:
    3240   00:510F                          ; nz, get it
    3241   00:510F                          RECEIVE_DATA
    3241   00:510F  DB 06             >     in a,(IN_DATA_PORT)
    3242   00:5111  6F                      ld  l,a
    3243   00:5112                      TCPIP_DNSQ_IP_ST2:
    3244   00:5112                          CHECK_DATA
    3244   00:5112  DB 07             >     in  a,(IN_STS_PORT)
    3244   00:5114  CB 47             >     bit 0,a
    3245   00:5116  20 05                   jr  nz,TCPIP_DNSQ_IP_ST2.1
    3246   00:5118  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3247   00:511B  18 F5                   jr  TCPIP_DNSQ_IP_ST2
    3248   00:511D                      TCPIP_DNSQ_IP_ST2.1:
    3249   00:511D                          ; nz, get it
    3250   00:511D                          RECEIVE_DATA
    3250   00:511D  DB 06             >     in a,(IN_DATA_PORT)
    3251   00:511F  67                      ld  h,a
    3252   00:5120                      TCPIP_DNSQ_IP_ST3:
    3253   00:5120                          CHECK_DATA
    3253   00:5120  DB 07             >     in  a,(IN_STS_PORT)
    3253   00:5122  CB 47             >     bit 0,a
    3254   00:5124  20 05                   jr  nz,TCPIP_DNSQ_IP_ST3.1
    3255   00:5126  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3256   00:5129  18 F5                   jr  TCPIP_DNSQ_IP_ST3
    3257   00:512B                      TCPIP_DNSQ_IP_ST3.1:
    3258   00:512B                          ; nz, get it
    3259   00:512B                          RECEIVE_DATA
    3259   00:512B  DB 06             >     in a,(IN_DATA_PORT)
    3260   00:512D  5F                      ld  e,a
    3261   00:512E                      TCPIP_DNSQ_IP_ST4:
    3262   00:512E                          CHECK_DATA
    3262   00:512E  DB 07             >     in  a,(IN_STS_PORT)
    3262   00:5130  CB 47             >     bit 0,a
    3263   00:5132  20 05                   jr  nz,TCPIP_DNSQ_IP_ST4.1
    3264   00:5134  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3265   00:5137  18 F5                   jr  TCPIP_DNSQ_IP_ST4
    3266   00:5139                      TCPIP_DNSQ_IP_ST4.1:
    3267   00:5139                          ; nz, get it
