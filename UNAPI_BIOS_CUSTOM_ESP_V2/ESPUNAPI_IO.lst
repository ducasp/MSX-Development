    2072   00:4BBF                      ; WAIT an ESP Wi-Fi Scan command Response
    2073   00:4BBF                      ; Inputs:
    2074   00:4BBF                      ; A -> Command Code
    2075   00:4BBF                      ; HL -> Timeout
    2076   00:4BBF                      ; IX -> Where to store response
    2077   00:4BBF                      ;
    2078   00:4BBF                      ; Returns:
    2079   00:4BBF                      ; Flag Z is zero if failure, non zero if success
    2080   00:4BBF                      ; A is the number of access points scanned
    2081   00:4BBF                      ;
    2082   00:4BBF                      ; Response is stored as:
    2083   00:4BBF                      ; Access Point SSID zero terminated and after first 0
    2084   00:4BBF                      ; 0 if Open otherwise requires a password to join
    2085   00:4BBF                      ; And this repeats...
    2086   00:4BBF                      ;
    2087   00:4BBF                      ; Affect:
    2088   00:4BBF                      ; AF , BC and HL
    2089   00:4BBF                      ;
    2090   00:4BBF                      WAIT_MENU_SCMD_RESPONSE:
    2091   00:4BBF  D5                      push    de
    2092   00:4BC0  DD E5                   push    ix
    2093   00:4BC2  57                      ld  d,a                         ; Command to wait in D
