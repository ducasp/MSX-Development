    2229   00:4C8D                      ;===============================
    2230   00:4C8D                      ;===  HTIM_I hook execution  ===
    2231   00:4C8D                      ;===============================
    2232   00:4C8D                      DO_HTIMI:
    2233   00:4C8D  F5                      push    af                      ; HTIM hook -> need to keep A value
    2234   00:4C8E  CD DD 5E                call    GETCOUNTER              ; Counter in hl
    2235   00:4C91  7D                      ld  a,l
    2236   00:4C92  B4                      or  h                           ; In this operation, check if HL is 0
    2237   00:4C93  28 04                   jr  z,DO_HTIMI_END              ; If it is, nothing to do
    2238   00:4C95  2B                      dec hl                          ; Otherwise decrement it
    2239   00:4C96  CD EC 5E                call    SETCOUNTER              ; And save it
    2240   00:4C99                      DO_HTIMI_END:
    2241   00:4C99  CD 4C 5E                call    GETSLT
    2242   00:4C9C                          ; Slot in A, now get the address of our counter
    2243   00:4C9C  CD D5 5E                call    GETMEMPOINTER
    2244   00:4C9F                          ; HL has the address of our memory area, and there is where we should jump
    2245   00:4C9F  F1                      pop af                          ; Restore original A value
    2246   00:4CA0  E9                      jp  (hl)
    2247   00:4CA1                      
    2248   00:4CA1                      ;===============================
    2249   00:4CA1                      ;===  EXTBIO hook execution  ===
