    1065   00:4519  3E 0C                   ld  a,12                        ; So, twelve
    1066   00:451B  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1067   00:451E  DD 77 01                ld  (ix+1),a                    ; Save
    1068   00:4521  79                      ld  a,c
