    3094   00:506F                      ;=====================
    3095   00:506F                      ;===  TCPIP_DNS_Q  ===
    3096   00:506F                      ;=====================
    3097   00:506F                      ;Start a host name resolution query.
    3098   00:506F                      ;
    3099   00:506F                      ;Input:  A  = 6
    3100   00:506F                      ;        HL = Address of the host name to be resolved, zero terminated
    3101   00:506F                      ;        B  = Flags, when set to 1 they instruct the resolver to:
    3102   00:506F                      ;             bit 0: Only abort the query currently in progress, if there is any
    3103   00:506F                      ;                    (other flags and registers are then ignored)
    3104   00:506F                      ;             bit 1: Assume that the passed name is an IP address,
    3105   00:506F                      ;                    and return an error if this is not true
    3106   00:506F                      ;             bit 2: If there is a query in progress already,
    3107   00:506F                      ;                    do NOT abort it and return an error instead
    3108   00:506F                      ;Output:  A = Error code
    3109   00:506F                      ;         B = 0 if a query to a DNS server is in progress
    3110   00:506F                      ;             1 if the name represented an IP address
    3111   00:506F                      ;             2 if the name could be resolved locally
    3112   00:506F                      ;         L.H.E.D = Resolved IP address
    3113   00:506F                      ;                   (only if no error occurred and B=1 or 2 is returned)
    3114   00:506F                      ;RAM Buffer to store names to be resolved (and used also to translate IPs from ASCII to 32bits number)
    3115   00:506F                      ;Will store the result of the last DNS query
    3116   00:506F                      TCPIP_DNS_Q:
    3117   00:506F  E5                      push    hl                      ; Save HL
    3118   00:5070  AF                      xor a
    3119   00:5071  5F                      ld  e,a
    3120   00:5072  57                      ld  d,a                         ; Zero DE
    3121   00:5073                      TCPIP_DNS_Q_SIZE_LOOP:
    3122   00:5073  7E                      ld  a,(hl)                      ; so let's check the size of dns data
    3123   00:5074  B7                      or  a                           ; it is zero terminated
    3124   00:5075  28 05                   jr  z,TCPIP_DNS_Q_SEND          ; if zero, end of string
    3125   00:5077  13                      inc de                          ; ok, not zero, one more char
    3126   00:5078  23                      inc hl                          ; next
    3127   00:5079  C3 73 50                jp  TCPIP_DNS_Q_SIZE_LOOP       ; jp is a tad bit faster and we are not worried about code size
    3128   00:507C                      TCPIP_DNS_Q_SEND:
    3129   00:507C                          ; Here we send the query and wait the result
    3130   00:507C  13                      inc de                          ; add 1, we will send flag first
    3131   00:507D  3E CE                   ld  a,206                       ; DNS_Q_NEW
    3132   00:507F                          SEND_DATA                       ; Send the command
    3132   00:507F  D3 07             >     out (OUT_TX_PORT),a
    3133   00:5081  7A                      ld  a,d
    3134   00:5082                          SEND_DATA                       ; Send the command size msb
    3134   00:5082  D3 07             >     out (OUT_TX_PORT),a
    3135   00:5084  7B                      ld  a,e
    3136   00:5085                          SEND_DATA                       ; Send the command size lsb
    3136   00:5085  D3 07             >     out (OUT_TX_PORT),a
    3137   00:5087  78                      ld  a,b
    3138   00:5088                          SEND_DATA                       ; Send the flag byte
    3138   00:5088  D3 07             >     out (OUT_TX_PORT),a
    3139   00:508A                      
    3140   00:508A                          if USE_MEM_IO = 0
    3141   00:508A                          ; now otir of DNS/DNS BUFFER DATA SIZE
    3142   00:508A  0E 07                   ld  c,OUT_TX_PORT               ; our data TX port
    3143   00:508C                          endif
    3144   00:508C  E1                      pop hl                          ; string to try to resolve
    3145   00:508D  1B                      dec de                          ; we are sending just data addressed by HL, so revert count
    3146   00:508E  7A                      ld  a,d
    3147   00:508F  B3                      or  e                           ; if de zero, no string, wrong parameters, but let the ESP answer
    3148   00:5090  CA A0 50                jp  z,TCPIP_DNS_Q_WAIT_RSP
    3149   00:5093  AF                      xor a
    3150   00:5094                          ; Fast 16 bit variable size loop by GRAUW
    3151   00:5094  43                      ld  b,e
    3152   00:5095  1B                      dec de
    3153   00:5096  14                      inc d
    3154   00:5097                      TCPIP_DNS_Q_SENDLP:
    3155   00:5097                          ; send it
    3156   00:5097                          if USE_MEM_IO = 0
    3157   00:5097  ED A3                   outi
    3158   00:5099  C2 97 50                jp  nz,TCPIP_DNS_Q_SENDLP
    3159   00:509C                          else
    3160   00:509C                    ~     ld  a,(hl)
    3161   00:509C                    ~     ld  (MEM_OUT_TX_PORT),a
    3162   00:509C                    ~     inc hl
    3163   00:509C                    ~     djnz TCPIP_DNS_Q_SENDLP
    3164   00:509C                    ~     endif
    3165   00:509C  15                      dec d
    3166   00:509D  C2 97 50                jp  nz,TCPIP_DNS_Q_SENDLP
    3167   00:50A0                      TCPIP_DNS_Q_WAIT_RSP:
    3168   00:50A0                          ; Now wait up to 900 ticks (15s@60Hz) to get response
    3169   00:50A0  21 84 03                ld  hl,900
    3170   00:50A3  CD C0 5C                call    SETCOUNTER
    3171   00:50A6                      TCPIP_DNSQ_SEND_ST1:
    3172   00:50A6                          CHECK_DATA
    3172   00:50A6  DB 07             >     in  a,(IN_STS_PORT)
    3172   00:50A8  CB 47             >     bit 0,a
    3173   00:50AA  20 05                   jr  nz,TCPIP_DNSQ_SEND_ST1.1
    3174   00:50AC  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3175   00:50AF  18 F5                   jr  TCPIP_DNSQ_SEND_ST1
    3176   00:50B1                      TCPIP_DNSQ_SEND_ST1.1:
    3177   00:50B1                          ; nz, check the data
    3178   00:50B1                          RECEIVE_DATA
    3178   00:50B1  DB 06             >     in a,(IN_DATA_PORT)
    3179   00:50B3  FE CE                   cp  206                         ; Is response of our command?
    3180   00:50B5  20 EF                   jr  nz,TCPIP_DNSQ_SEND_ST1
    3181   00:50B7                          ; now get return code, if return code other than 0, it is finished
    3182   00:50B7                      TCPIP_DNSQ_SEND_RC:
    3183   00:50B7                          CHECK_DATA
    3183   00:50B7  DB 07             >     in  a,(IN_STS_PORT)
    3183   00:50B9  CB 47             >     bit 0,a
    3184   00:50BB  20 05                   jr  nz,TCPIP_DNSQ_SEND_RC.1
    3185   00:50BD  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3186   00:50C0  18 F5                   jr  TCPIP_DNSQ_SEND_RC
    3187   00:50C2                      TCPIP_DNSQ_SEND_RC.1:
    3188   00:50C2                          ; nz, discard
    3189   00:50C2                          RECEIVE_DATA
    3189   00:50C2  DB 06             >     in a,(IN_DATA_PORT)
    3190   00:50C4  B7                      or  a                           ; 0?
    3191   00:50C5  06 00                   ld  b,0                         ; say in progress as there is no failure status
    3192   00:50C7  C0                      ret nz                          ; if not, done, ERROR won't return data
    3193   00:50C8                      
    3194   00:50C8                          ; next two bytes are return code and size bytes, don't care, it is 4, resolved IP
    3195   00:50C8  06 02                   ld  b,2
    3196   00:50CA                      TCPIP_DNSQ_SEND_RC_ST2:
    3197   00:50CA                          CHECK_DATA
    3197   00:50CA  DB 07             >     in  a,(IN_STS_PORT)
    3197   00:50CC  CB 47             >     bit 0,a
    3198   00:50CE  20 05                   jr  nz,TCPIP_DNSQ_SEND_RC_ST2.1
    3199   00:50D0  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3200   00:50D3  18 F5                   jr  TCPIP_DNSQ_SEND_RC_ST2
    3201   00:50D5                      TCPIP_DNSQ_SEND_RC_ST2.1:
    3202   00:50D5                          ; nz, discard
    3203   00:50D5                          RECEIVE_DATA
    3203   00:50D5  DB 06             >     in a,(IN_DATA_PORT)
    3204   00:50D7  05                      dec b
    3205   00:50D8  20 F0                   jr  nz,TCPIP_DNSQ_SEND_RC_ST2
    3206   00:50DA                      
    3207   00:50DA                          ; now just get the 4 bytes IP and place it in L H E D
    3208   00:50DA                      TCPIP_DNSQ_IP_ST1:
    3209   00:50DA                          CHECK_DATA
    3209   00:50DA  DB 07             >     in  a,(IN_STS_PORT)
    3209   00:50DC  CB 47             >     bit 0,a
    3210   00:50DE  20 05                   jr  nz,TCPIP_DNSQ_IP_ST1.1
    3211   00:50E0  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3212   00:50E3  18 F5                   jr  TCPIP_DNSQ_IP_ST1
    3213   00:50E5                      TCPIP_DNSQ_IP_ST1.1:
    3214   00:50E5                          ; nz, get it
    3215   00:50E5                          RECEIVE_DATA
    3215   00:50E5  DB 06             >     in a,(IN_DATA_PORT)
    3216   00:50E7  6F                      ld  l,a
    3217   00:50E8                      TCPIP_DNSQ_IP_ST2:
    3218   00:50E8                          CHECK_DATA
    3218   00:50E8  DB 07             >     in  a,(IN_STS_PORT)
    3218   00:50EA  CB 47             >     bit 0,a
    3219   00:50EC  20 05                   jr  nz,TCPIP_DNSQ_IP_ST2.1
    3220   00:50EE  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3221   00:50F1  18 F5                   jr  TCPIP_DNSQ_IP_ST2
    3222   00:50F3                      TCPIP_DNSQ_IP_ST2.1:
    3223   00:50F3                          ; nz, get it
    3224   00:50F3                          RECEIVE_DATA
    3224   00:50F3  DB 06             >     in a,(IN_DATA_PORT)
    3225   00:50F5  67                      ld  h,a
    3226   00:50F6                      TCPIP_DNSQ_IP_ST3:
    3227   00:50F6                          CHECK_DATA
    3227   00:50F6  DB 07             >     in  a,(IN_STS_PORT)
    3227   00:50F8  CB 47             >     bit 0,a
    3228   00:50FA  20 05                   jr  nz,TCPIP_DNSQ_IP_ST3.1
    3229   00:50FC  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3230   00:50FF  18 F5                   jr  TCPIP_DNSQ_IP_ST3
    3231   00:5101                      TCPIP_DNSQ_IP_ST3.1:
    3232   00:5101                          ; nz, get it
    3233   00:5101                          RECEIVE_DATA
    3233   00:5101  DB 06             >     in a,(IN_DATA_PORT)
    3234   00:5103  5F                      ld  e,a
    3235   00:5104                      TCPIP_DNSQ_IP_ST4:
    3236   00:5104                          CHECK_DATA
    3236   00:5104  DB 07             >     in  a,(IN_STS_PORT)
    3236   00:5106  CB 47             >     bit 0,a
    3237   00:5108  20 05                   jr  nz,TCPIP_DNSQ_IP_ST4.1
    3238   00:510A  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3239   00:510D  18 F5                   jr  TCPIP_DNSQ_IP_ST4
    3240   00:510F                      TCPIP_DNSQ_IP_ST4.1:
    3241   00:510F                          ; nz, get it
    3242   00:510F                          RECEIVE_DATA
    3242   00:510F  DB 06             >     in a,(IN_DATA_PORT)
    3243   00:5111  57                      ld  d,a
    3244   00:5112                          ; done
    3245   00:5112  3E 01                   ld  a,1
    3246   00:5114  CD D2 5D                call    SETDNSREADY             ; DNS done
    3247   00:5117  CD FC 5D                call    SETDNSRESULT            ; DNS RESULT
    3248   00:511A  06 02                   ld  b,2
    3249   00:511C  AF                      xor a
    3250   00:511D  C9                      ret
    3251   00:511E                      
    3252   00:511E                      ;=====================
    3253   00:511E                      ;===  TCPIP_DNS_S  ===
    3254   00:511E                      ;=====================
    3255   00:511E                      ;Obtains the host name resolution process state and result.
    3256   00:511E                      ;
    3257   00:511E                      ;Input:  A = 7
    3258   00:511E                      ;        B = Flags, when set to 1 they instruct the resolver to:
    3259   00:511E                      ;            bit 0: Clear any existing result or error condition after the execution
    3260   00:511E                      ;                   (except if there is a query in progress)
    3261   00:511E                      ;Output: A = Error code
    3262   00:511E                      ;        B = DNS error code (when error is ERR_DNS)
    3263   00:511E                      ;        B = Current query status (when error is ERR_OK):
    3264   00:511E                      ;            0: There is no query in progress, nor any result nor error code available
    3265   00:511E                      ;            1: There is a query in progress
    3266   00:511E                      ;            2: Query is complete
    3267   00:511E                      ;        C = Current query sub status (when error is ERR_OK and B=1):
    3268   00:511E                      ;            0: Unknown
    3269   00:511E                      ;            1: Querying the primary DNS server
    3270   00:511E                      ;            2: Querying the secondary DNS server
    3271   00:511E                      ;            3: Querying another DNS server
    3272   00:511E                      ;        C = Resolution process type (when error is ERR_OK and B=2):
    3273   00:511E                      ;            0: The name was obtained by querying a DNS server
    3274   00:511E                      ;            1: The name was a direct representation of an IP address
    3275   00:511E                      ;            2: The name was resolved locally
    3276   00:511E                      ;       L.H.E.D = Resolved IP address (when error is ERR_OK and B=2)
    3277   00:511E                      TCPIP_DNS_S:
    3278   00:511E                          ;--- Is there a result?
    3279   00:511E  CD C0 5D                call    GETDNSREADY             ; DNS done?
    3280   00:5121  B7                      or  a
    3281   00:5122  28 23                   jr  z,TCPIP_DNS_S_NORESULT      ; No DNS result
    3282   00:5124                          ;--- Ok, we have a result, is it success?
    3283   00:5124  3D                      dec a
    3284   00:5125  28 12                   jr  z,TCPIP_DNS_S_HASRESULT     ; If it is 1, it was not an error
    3285   00:5127                          ;--- Shoot, there is an error...
    3286   00:5127                          ;--- And sure thing, ESP do not tell us details, it is always failure :-P
    3287   00:5127  CB 40                   bit 0,b                         ;--- clear error after this?
    3288   00:5129  28 09                   jr  z,TCP_IP_DNS_S_NOCLR
    3289   00:512B                          ;--- Clear
    3290   00:512B  06 00                   ld b,0                          ;--- Like I've said, no details
    3291   00:512D  AF                      xor a
    3292   00:512E  CD D2 5D                call    SETDNSREADY             ; DNS not done
    3293   00:5131  3E 08                   ld  a,ERR_DNS;
    3294   00:5133  C9                      ret
    3295   00:5134                      TCP_IP_DNS_S_NOCLR:
    3296   00:5134                          ;--- Don't clear
    3297   00:5134  3E 08                   ld  a,ERR_DNS
    3298   00:5136  06 00                   ld  b,0                         ;--- Like I've said, no details
    3299   00:5138  C9                      ret
    3300   00:5139                          ;--- There is a result available...
    3301   00:5139                      TCPIP_DNS_S_HASRESULT:
    3302   00:5139                          ;--- Copy the result
    3303   00:5139  CD E6 5D                call    GETDNSRESULT
    3304   00:513C  AF                      xor a
    3305   00:513D  CB 40                   bit 0,b                         ;--- clear result after this?
    3306   00:513F  28 03                   jr  z,TCP_IP_DNS_S_RES_NOCLR    ;--- no, just return
    3307   00:5141                          ;--- Yes, clear
    3308   00:5141  CD D2 5D                call    SETDNSREADY             ; DNS not done
    3309   00:5144                      TCP_IP_DNS_S_RES_NOCLR:
    3310   00:5144  06 02                   ld  b,2
    3311   00:5146  C9                      ret
    3312   00:5147                      
    3313   00:5147                      TCPIP_DNS_S_NORESULT:
    3314   00:5147  AF                      xor a                           ;--- OK no query in progress, no result, means nothing in progress
    3315   00:5148  06 00                   ld  b,0                         ;--- No query in progress
    3316   00:514A  C9                      ret
    3317   00:514B                      
    3318   00:514B                      ;========================
    3319   00:514B                      ;===  TCPIP_UDP_OPEN  ===
    3320   00:514B                      ;========================
    3321   00:514B                      ;Open an UDP connection.
    3322   00:514B                      ;
    3323   00:514B                      ;Input:  A  = 8
    3324   00:514B                      ;        HL = Local port number (#FFFF=random)
    3325   00:514B                      ;        B  = Intended connection lifetime:
    3326   00:514B                      ;             0: Transient
    3327   00:514B                      ;             1: Resident
    3328   00:514B                      ;Output: A = Error code
    3329   00:514B                      ;        B = Connection number
    3330   00:514B                      TCPIP_UDP_OPEN:
    3331   00:514B                          SEND_DATA                       ; Send the command
    3331   00:514B  D3 07             >     out (OUT_TX_PORT),a
    3332   00:514D  AF                      xor a
    3333   00:514E                          SEND_DATA                       ; Send the command size msb
    3333   00:514E  D3 07             >     out (OUT_TX_PORT),a
    3334   00:5150  3E 03                   ld  a,3
    3335   00:5152                          SEND_DATA                       ; Send the command size lsb
    3335   00:5152  D3 07             >     out (OUT_TX_PORT),a
    3336   00:5154  7D                      ld  a,l
    3337   00:5155                          SEND_DATA                       ; Send the port LSB
    3337   00:5155  D3 07             >     out (OUT_TX_PORT),a
    3338   00:5157  7C                      ld  a,h
    3339   00:5158                          SEND_DATA                       ; Send the port MSB
    3339   00:5158  D3 07             >     out (OUT_TX_PORT),a
    3340   00:515A  78                      ld  a,b
    3341   00:515B                          SEND_DATA                       ; Send the connection transient/resident
    3341   00:515B  D3 07             >     out (OUT_TX_PORT),a
    3342   00:515D                      
    3343   00:515D                          ; Now wait up to 180 ticks to get response
    3344   00:515D  21 B4 00                ld  hl,180
    3345   00:5160  CD C0 5C                call    SETCOUNTER
    3346   00:5163                      TCPIP_UDP_OPEN_ST1:
    3347   00:5163                          CHECK_DATA
    3347   00:5163  DB 07             >     in  a,(IN_STS_PORT)
    3347   00:5165  CB 47             >     bit 0,a
    3348   00:5167  20 05                   jr  nz,TCPIP_UDP_OPEN_ST1.1
    3349   00:5169  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3350   00:516C  18 F5                   jr  TCPIP_UDP_OPEN_ST1
    3351   00:516E                      TCPIP_UDP_OPEN_ST1.1:
    3352   00:516E                          ; nz, check the data
    3353   00:516E                          RECEIVE_DATA
    3353   00:516E  DB 06             >     in a,(IN_DATA_PORT)
    3354   00:5170  FE 08                   cp  8                           ; Is response of our command?
    3355   00:5172  20 EF                   jr  nz,TCPIP_UDP_OPEN_ST1
    3356   00:5174                          ; now get return code, if return code other than 0, it is finished
    3357   00:5174                      TCPIP_UDP_OPEN_RC:
    3358   00:5174                          CHECK_DATA
    3358   00:5174  DB 07             >     in  a,(IN_STS_PORT)
    3358   00:5176  CB 47             >     bit 0,a
    3359   00:5178  20 05                   jr  nz,TCPIP_UDP_OPEN_RC.1
    3360   00:517A  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3361   00:517D  18 F5                   jr  TCPIP_UDP_OPEN_RC
    3362   00:517F                      TCPIP_UDP_OPEN_RC.1:
    3363   00:517F                          ; nz, discard
    3364   00:517F                          RECEIVE_DATA
    3364   00:517F  DB 06             >     in a,(IN_DATA_PORT)
    3365   00:5181  B7                      or  a                           ; 0?
    3366   00:5182  C0                      ret nz                          ; if not, done
    3367   00:5183                      
    3368   00:5183                          ; next two bytes are return code and size bytes, don't care, it is 1, conn #
    3369   00:5183  06 02                   ld  b,2
    3370   00:5185                      TCPIP_UDP_OPEN_ST2:
    3371   00:5185                          CHECK_DATA
    3371   00:5185  DB 07             >     in  a,(IN_STS_PORT)
    3371   00:5187  CB 47             >     bit 0,a
    3372   00:5189  20 05                   jr  nz,TCPIP_UDP_OPEN_ST2.1
    3373   00:518B  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3374   00:518E  18 F5                   jr  TCPIP_UDP_OPEN_ST2
    3375   00:5190                      TCPIP_UDP_OPEN_ST2.1:
    3376   00:5190                          ; nz, discard
    3377   00:5190                          RECEIVE_DATA
    3377   00:5190  DB 06             >     in a,(IN_DATA_PORT)
    3378   00:5192  05                      dec b
    3379   00:5193  20 F0                   jr  nz,TCPIP_UDP_OPEN_ST2
    3380   00:5195                      
    3381   00:5195                          ; now just get the 1 byte, conn#, should go to B
    3382   00:5195                      TCPIP_UDP_OPEN_CONN_ST1:
    3383   00:5195                          CHECK_DATA
    3383   00:5195  DB 07             >     in  a,(IN_STS_PORT)
    3383   00:5197  CB 47             >     bit 0,a
    3384   00:5199  20 05                   jr  nz,TCPIP_UDP_OPEN_CONN_ST1.1
    3385   00:519B  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3386   00:519E  18 F5                   jr  TCPIP_UDP_OPEN_CONN_ST1
    3387   00:51A0                      TCPIP_UDP_OPEN_CONN_ST1.1:
    3388   00:51A0                          ; nz, get it
    3389   00:51A0                          RECEIVE_DATA
    3389   00:51A0  DB 06             >     in a,(IN_DATA_PORT)
    3390   00:51A2  47                      ld  b,a
    3391   00:51A3                          ; done
    3392   00:51A3  AF                      xor a
    3393   00:51A4  C9                      ret
    3394   00:51A5                      
    3395   00:51A5                      ;=========================
    3396   00:51A5                      ;===  TCPIP_UDP_CLOSE  ===
    3397   00:51A5                      ;=========================
    3398   00:51A5                      ;Close a UDP connection.
    3399   00:51A5                      ;
    3400   00:51A5                      ;Input:  A = 9
    3401   00:51A5                      ;        B = Connection number
    3402   00:51A5                      ;            0 to close all open transient UDP connections
    3403   00:51A5                      ;Output: A = Error code
    3404   00:51A5                      TCPIP_UDP_CLOSE:
    3405   00:51A5                          SEND_DATA                       ; Send the command
    3405   00:51A5  D3 07             >     out (OUT_TX_PORT),a
    3406   00:51A7  AF                      xor a
    3407   00:51A8                          SEND_DATA                       ; Send the command size msb
    3407   00:51A8  D3 07             >     out (OUT_TX_PORT),a
    3408   00:51AA  3E 01                   ld  a,1
    3409   00:51AC                          SEND_DATA                       ; Send the command size lsb
    3409   00:51AC  D3 07             >     out (OUT_TX_PORT),a
    3410   00:51AE  78                      ld  a,b
    3411   00:51AF                          SEND_DATA                       ; Send the connection #
    3411   00:51AF  D3 07             >     out (OUT_TX_PORT),a
    3412   00:51B1                          ; Now wait up to 180 ticks to get response
    3413   00:51B1  21 B4 00                ld  hl,180
    3414   00:51B4  CD C0 5C                call    SETCOUNTER
    3415   00:51B7                      TCPIP_UDP_CLOSE_ST1:
    3416   00:51B7                          CHECK_DATA
    3416   00:51B7  DB 07             >     in  a,(IN_STS_PORT)
    3416   00:51B9  CB 47             >     bit 0,a
    3417   00:51BB  20 05                   jr  nz,TCPIP_UDP_CLOSE_ST1.1
    3418   00:51BD  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3419   00:51C0  18 F5                   jr  TCPIP_UDP_CLOSE_ST1
    3420   00:51C2                      TCPIP_UDP_CLOSE_ST1.1:
    3421   00:51C2                          ; nz, check the data
    3422   00:51C2                          RECEIVE_DATA
    3422   00:51C2  DB 06             >     in a,(IN_DATA_PORT)
    3423   00:51C4  FE 09                   cp  9                           ; Is response of our command?
    3424   00:51C6  20 EF                   jr  nz,TCPIP_UDP_CLOSE_ST1
    3425   00:51C8                          ; now get return code, if return code other than 0, it is finished
    3426   00:51C8                      TCPIP_UDP_CLOSE_RC:
    3427   00:51C8                          CHECK_DATA
    3427   00:51C8  DB 07             >     in  a,(IN_STS_PORT)
    3427   00:51CA  CB 47             >     bit 0,a
    3428   00:51CC  20 05                   jr  nz,TCPIP_UDP_CLOSE_RC.1
    3429   00:51CE  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3430   00:51D1  18 F5                   jr  TCPIP_UDP_CLOSE_RC
    3431   00:51D3                      TCPIP_UDP_CLOSE_RC.1:
    3432   00:51D3                          ; nz, discard
    3433   00:51D3                          RECEIVE_DATA
    3433   00:51D3  DB 06             >     in a,(IN_DATA_PORT)
    3434   00:51D5  B7                      or  a                           ; 0?
    3435   00:51D6  C0                      ret nz                          ; if not, done
    3436   00:51D7                      
    3437   00:51D7                          ; next two bytes are return code and size bytes, don't care, it is 1, conn #
    3438   00:51D7  06 02                   ld  b,2
    3439   00:51D9                      TCPIP_UDP_CLOSE_ST2:
    3440   00:51D9                          CHECK_DATA
    3440   00:51D9  DB 07             >     in  a,(IN_STS_PORT)
    3440   00:51DB  CB 47             >     bit 0,a
    3441   00:51DD  20 05                   jr  nz,TCPIP_UDP_CLOSE_ST2.1
    3442   00:51DF  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3443   00:51E2  18 F5                   jr  TCPIP_UDP_CLOSE_ST2
    3444   00:51E4                      TCPIP_UDP_CLOSE_ST2.1:
    3445   00:51E4                          ; nz, discard
    3446   00:51E4                          RECEIVE_DATA
    3446   00:51E4  DB 06             >     in a,(IN_DATA_PORT)
    3447   00:51E6  05                      dec b
    3448   00:51E7  20 F0                   jr  nz,TCPIP_UDP_CLOSE_ST2
    3449   00:51E9                      
    3450   00:51E9                          ; done, no return data other than return code
    3451   00:51E9  AF                      xor a
    3452   00:51EA  C9                      ret
    3453   00:51EB                      
    3454   00:51EB                      ;=========================
    3455   00:51EB                      ;===  TCPIP_UDP_STATE  ===
    3456   00:51EB                      ;=========================
    3457   00:51EB                      ;Get the state of a UDP connection.
    3458   00:51EB                      ;
    3459   00:51EB                      ;Input:  A = 10
    3460   00:51EB                      ;        B = Connection number
    3461   00:51EB                      ;Output: A  = Error code
    3462   00:51EB                      ;        HL = Local port number
    3463   00:51EB                      ;        B  = Number of pending incoming datagrams
    3464   00:51EB                      ;        DE = Size of oldest pending incoming datagram (data part only)
    3465   00:51EB                      TCPIP_UDP_STATE:
    3466   00:51EB                          SEND_DATA                       ; Send the command
    3466   00:51EB  D3 07             >     out (OUT_TX_PORT),a
    3467   00:51ED  AF                      xor a
    3468   00:51EE                          SEND_DATA                       ; Send the command size msb
    3468   00:51EE  D3 07             >     out (OUT_TX_PORT),a
    3469   00:51F0  3C                      inc a
    3470   00:51F1                          SEND_DATA                       ; Send the command size lsb
    3470   00:51F1  D3 07             >     out (OUT_TX_PORT),a
    3471   00:51F3  78                      ld  a,b
    3472   00:51F4                          SEND_DATA                       ; Send the parameter
    3472   00:51F4  D3 07             >     out (OUT_TX_PORT),a
    3473   00:51F6                      
    3474   00:51F6                          ; Now wait up to 60 ticks to get response
    3475   00:51F6  21 3C 00                ld  hl,60
    3476   00:51F9  CD C0 5C                call    SETCOUNTER
    3477   00:51FC                      TCPIP_UDP_STATE_ST1:
    3478   00:51FC                          CHECK_DATA
    3478   00:51FC  DB 07             >     in  a,(IN_STS_PORT)
    3478   00:51FE  CB 47             >     bit 0,a
    3479   00:5200  20 05                   jr  nz,TCPIP_UDP_STATE_ST1.1
    3480   00:5202  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3481   00:5205  18 F5                   jr  TCPIP_UDP_STATE_ST1
    3482   00:5207                      TCPIP_UDP_STATE_ST1.1:
    3483   00:5207                          ; nz, check the data
    3484   00:5207                          RECEIVE_DATA
    3484   00:5207  DB 06             >     in a,(IN_DATA_PORT)
    3485   00:5209  FE 0A                   cp  10                          ; Is response of our command?
    3486   00:520B  20 EF                   jr  nz,TCPIP_UDP_STATE_ST1
    3487   00:520D                          ; now get return code, if return code other than 0, it is finished
    3488   00:520D                      TCPIP_UDP_STATE_RC:
    3489   00:520D                          CHECK_DATA
    3489   00:520D  DB 07             >     in  a,(IN_STS_PORT)
    3489   00:520F  CB 47             >     bit 0,a
    3490   00:5211  20 05                   jr  nz,TCPIP_UDP_STATE_RC.1
    3491   00:5213  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3492   00:5216  18 F5                   jr  TCPIP_UDP_STATE_RC
    3493   00:5218                      TCPIP_UDP_STATE_RC.1:
    3494   00:5218                          ; nz, discard
    3495   00:5218                          RECEIVE_DATA
    3495   00:5218  DB 06             >     in a,(IN_DATA_PORT)
    3496   00:521A  B7                      or  a                           ; 0?
    3497   00:521B  C0                      ret nz                          ; if not, done
    3498   00:521C                      
    3499   00:521C                          ; next two bytes are return code and size bytes, don't care, it is 5
    3500   00:521C  06 02                   ld  b,2
    3501   00:521E                      TCPIP_UDP_STATE_ST2:
    3502   00:521E                          CHECK_DATA
    3502   00:521E  DB 07             >     in  a,(IN_STS_PORT)
    3502   00:5220  CB 47             >     bit 0,a
    3503   00:5222  20 05                   jr  nz,TCPIP_UDP_STATE_ST2.1
    3504   00:5224  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3505   00:5227  18 F5                   jr  TCPIP_UDP_STATE_ST2
    3506   00:5229                      TCPIP_UDP_STATE_ST2.1:
    3507   00:5229                          ; nz, discard
    3508   00:5229                          RECEIVE_DATA
    3508   00:5229  DB 06             >     in a,(IN_DATA_PORT)
    3509   00:522B  05                      dec b
    3510   00:522C  20 F0                   jr  nz,TCPIP_UDP_STATE_ST2
    3511   00:522E                      
    3512   00:522E                          ; now just get the 5 bytes (Port LSB then MSB, # of packets, packet size LSB then MSB) and order it in L, H, B, E and D
    3513   00:522E                      TCPIP_UDP_STATE_RESP_ST1:
    3514   00:522E                          CHECK_DATA
    3514   00:522E  DB 07             >     in  a,(IN_STS_PORT)
    3514   00:5230  CB 47             >     bit 0,a
    3515   00:5232  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST1.1
    3516   00:5234  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3517   00:5237  18 F5                   jr  TCPIP_UDP_STATE_RESP_ST1
    3518   00:5239                      TCPIP_UDP_STATE_RESP_ST1.1:
    3519   00:5239                          ; nz, get it
    3520   00:5239                          RECEIVE_DATA
    3520   00:5239  DB 06             >     in a,(IN_DATA_PORT)
    3521   00:523B  6F                      ld  l,a
    3522   00:523C                      TCPIP_UDP_STATE_RESP_ST2:
    3523   00:523C                          CHECK_DATA
    3523   00:523C  DB 07             >     in  a,(IN_STS_PORT)
    3523   00:523E  CB 47             >     bit 0,a
    3524   00:5240  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST2.1
    3525   00:5242  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3526   00:5245  18 F5                   jr  TCPIP_UDP_STATE_RESP_ST2
    3527   00:5247                      TCPIP_UDP_STATE_RESP_ST2.1:
    3528   00:5247                          ; nz, get it
    3529   00:5247                          RECEIVE_DATA
    3529   00:5247  DB 06             >     in a,(IN_DATA_PORT)
    3530   00:5249  67                      ld  h,a
    3531   00:524A                      TCPIP_UDP_STATE_RESP_ST3:
    3532   00:524A                          CHECK_DATA
    3532   00:524A  DB 07             >     in  a,(IN_STS_PORT)
    3532   00:524C  CB 47             >     bit 0,a
    3533   00:524E  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST3.1
    3534   00:5250  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3535   00:5253  18 F5                   jr  TCPIP_UDP_STATE_RESP_ST3
    3536   00:5255                      TCPIP_UDP_STATE_RESP_ST3.1:
    3537   00:5255                          ; nz, get it
    3538   00:5255                          RECEIVE_DATA
    3538   00:5255  DB 06             >     in a,(IN_DATA_PORT)
    3539   00:5257  47                      ld  b,a
    3540   00:5258                      TCPIP_UDP_STATE_RESP_ST4:
    3541   00:5258                          CHECK_DATA
    3541   00:5258  DB 07             >     in  a,(IN_STS_PORT)
    3541   00:525A  CB 47             >     bit 0,a
    3542   00:525C  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST4.1
    3543   00:525E  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3544   00:5261  18 F5                   jr  TCPIP_UDP_STATE_RESP_ST4
    3545   00:5263                      TCPIP_UDP_STATE_RESP_ST4.1:
    3546   00:5263                          ; nz, get it
    3547   00:5263                          RECEIVE_DATA
    3547   00:5263  DB 06             >     in a,(IN_DATA_PORT)
    3548   00:5265  5F                      ld  e,a
    3549   00:5266                      TCPIP_UDP_STATE_RESP_ST5:
    3550   00:5266                          CHECK_DATA
    3550   00:5266  DB 07             >     in  a,(IN_STS_PORT)
    3550   00:5268  CB 47             >     bit 0,a
    3551   00:526A  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST5.1
    3552   00:526C  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3553   00:526F  18 F5                   jr  TCPIP_UDP_STATE_RESP_ST5
    3554   00:5271                      TCPIP_UDP_STATE_RESP_ST5.1:
    3555   00:5271                          ; nz, get it
    3556   00:5271                          RECEIVE_DATA
    3556   00:5271  DB 06             >     in a,(IN_DATA_PORT)
    3557   00:5273  57                      ld  d,a
    3558   00:5274                          ; done
    3559   00:5274  AF                      xor a
    3560   00:5275  C9                      ret
