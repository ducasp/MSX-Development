     296   00:4000  (00:000F)           MEMORY_DEBACKUP_OFFSET  equ #0F
     297   00:4000  (00:0011)           MEMORY_HLBACKUP_OFFSET  equ #11
     298   00:4000  (00:0013)           MEMORY_ESP32_OFFSET     equ #13
