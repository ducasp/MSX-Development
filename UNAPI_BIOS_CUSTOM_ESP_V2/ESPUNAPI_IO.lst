     684   00:422D  3E 0C                   ld  a,CLS
     685   00:422F  CD A2 00                call    CHPUT
     686   00:4232  C3 EE 40                jp  INIT_UNAPI                  ; When done, resume initialization
     687   00:4235                      ENTERING_ESPSETUP:
     688   00:4235  21 42 63                ld  hl,ENTERING_WIFI_SETUP
     689   00:4238  CD 54 4C                call    PRINTHL
     690   00:423B  CD AB 62                call    PATTERN_SETUP
     691   00:423E  CD EB 49                call    WAIT_250MS_AND_THEN_CONTINUE
     692   00:4241                          ; Hold Wi-Fi Connection On
     693   00:4241                          CLEAR_UART
     693   00:4241  3E 14             >     ld  a,20
     693   00:4243  D3 06             >     out (OUT_CMD_PORT),a
     694   00:4245  3E 48                   ld  a,CMD_WIFIHOLD_ESP
     695   00:4247                          SEND_DATA
     695   00:4247  D3 07             >     out (OUT_TX_PORT),a
     696   00:4249  21 3C 00                ld  hl,60                       ; Up to 1s time-out
     697   00:424C  CD 40 4B                call    WAIT_MENU_CMD_RESPONSE  ; Wait response
     698   00:424F                          ; We do not want to error here, just in case user still need to upgrade ESP firmware
     699   00:424F                      ESPSETUP:
     700   00:424F  CD A6 61                call    RESET_ESP
     701   00:4252  B7                      or  a
     702   00:4253  C2 D7 40                jp  nz,ESP_NOT_FOUND            ; Not well, ESP was not found
     703   00:4256                          ; Well, if reset successful, continue
     704   00:4256  CD AC 60                call    CHECK_ESP_TYPE          ; Detect ESP type and SSH support
     705   00:4259  CD F5 5F                call    GETESPFLAGS
     706   00:425C  E6 02                   and ESPFLAG_SSH
     707   00:425E  21 5E 63                ld  hl,WELCOME
     708   00:4261  28 03                   jr  z,NOT32_2
     709   00:4263  21 A8 63                ld  hl,WELCOME32
     710   00:4266                      NOT32_2:
     711   00:4266  CD 54 4C                call    PRINTHL
     712   00:4269                          CHECK_QUICK_RECEIVE
     712   00:4269  DB 07             >     in  a,(IN_STS_PORT)
     712   00:426B  CB 5F             >     bit 3,a
     713   00:426D  20 08                   jr  nz,ESPSETUP.2NF             ; If yes, tells Quick Receive support
     714   00:426F  21 12 64                ld  hl,WELCOME_SF2
     715   00:4272  CD 54 4C                call    PRINTHL                 ; Print Welcome message no QR
     716   00:4275  18 06                   jr  ESPSETUP.3NF
     717   00:4277                      ESPSETUP.2NF:
     718   00:4277  21 F6 63                ld  hl,WELCOME_SF
     719   00:427A  CD 54 4C                call    PRINTHL                 ; Print Welcome message QR
     720   00:427D                      ESPSETUP.3NF:
     721   00:427D  21 32 64                ld  hl,WELCOME_CS
     722   00:4280  CD 54 4C                call    PRINTHL                 ; Print Wi-Fi is reconnecting to:
     723   00:4283                      ESPSETUP_NEXT:
     724   00:4283  CD 56 01                call    KILBUF                  ; Clear Keyboard Buffer
     725   00:4286  21 5C 64                ld  hl,WELCOME_NEXT
     726   00:4289  CD 54 4C                call    PRINTHL
     727   00:428C  21 66 64                ld  hl,WELCOME_SF_NEXT
     728   00:428F  CD 54 4C                call    PRINTHL                 ; Print Empty Welcome message
     729   00:4292  CD 28 43                call    GET_AP_STAT
     730   00:4295  CA CD 42                jp  z,ESPSETUP_NEXT.1G          ; Won't block in case of error
     731   00:4298                          ; Success, so connection state is in IX+0, then, zero terminated string with SSID starting at IX+1
     732   00:4298  DD 7E 00                ld  a,(ix+0)
     733   00:429B  21 69 64                ld  hl,WELCOME_CS0_NEXT
     734   00:429E  FE 00                   cp  0
     735   00:42A0  28 1F                   jr  z,ESPSETUP_NEXT.2F
     736   00:42A2  21 93 64                ld  hl,WELCOME_CS1_NEXT
     737   00:42A5  FE 01                   cp  1
     738   00:42A7  28 18                   jr  z,ESPSETUP_NEXT.2F
     739   00:42A9  21 9C 64                ld  hl,WELCOME_CS2_NEXT
     740   00:42AC  FE 02                   cp  2
     741   00:42AE  28 11                   jr  z,ESPSETUP_NEXT.2F
     742   00:42B0  21 C6 64                ld  hl,WELCOME_CS3_NEXT
     743   00:42B3  FE 03                   cp  3
     744   00:42B5  28 0A                   jr  z,ESPSETUP_NEXT.2F
     745   00:42B7  21 F0 64                ld  hl,WELCOME_CS4_NEXT
     746   00:42BA  FE 04                   cp  4
     747   00:42BC  28 03                   jr  z,ESPSETUP_NEXT.2F
     748   00:42BE  21 1A 65                ld  hl,WELCOME_CS5_NEXT
     749   00:42C1                      ESPSETUP_NEXT.2F:
     750   00:42C1  FD 67                   ld  iyh,a                       ; Save current conn status in iyh
     751   00:42C3  CD 54 4C                call    PRINTHL                 ; Print Status
     752   00:42C6  DD E5                   push    ix
     753   00:42C8  E1                      pop hl
     754   00:42C9  23                      inc hl                          ; HL has AP Name
     755   00:42CA  CD 5E 4C                call    PRINTHLINE              ; Print AP Name
     756   00:42CD                      ESPSETUP_NEXT.1G:
     757   00:42CD  21 44 65                ld  hl,MMENU_S_NEXT
     758   00:42D0  CD 54 4C                call    PRINTHL                 ; Print Main Menu
     759   00:42D3                      MM_CURSOR_BLINK:
     760   00:42D3  CD 14 43                call    MM_CURSOR_SW            ; Cursor On
     761   00:42D6                      CONN_CHG_LOOP:
     762   00:42D6  CD 9C 00                call    CHSNS
     763   00:42D9  20 13                   jr  nz,MM_WAIT_INPUT            ; If not zero, there is a key in buffer
     764   00:42DB                          ; Ok, there is not, we can check if connection status changed
     765   00:42DB  CD 28 43                call    GET_AP_STAT
     766   00:42DE  CA D6 42                jp  z,CONN_CHG_LOOP             ; Won't block in case of error
     767   00:42E1                          ; Success, so connection state is in IX+0
     768   00:42E1  DD 7E 00                ld  a,(ix+0)
     769   00:42E4  FD BC                   cp  iyh                         ; If same, zero
     770   00:42E6  28 EE                   jr  z,CONN_CHG_LOOP             ; Keep loop
     771   00:42E8  CD 14 43                call    MM_CURSOR_SW            ; Cursor Off
     772   00:42EB  C3 83 42                jp  ESPSETUP_NEXT               ; Changed, re-build menu
     773   00:42EE                      MM_WAIT_INPUT:
     774   00:42EE  CD 9F 00                call    CHGET
     775   00:42F1  FE 1B                   cp  #1b                         ; ESC?
     776   00:42F3  CA 2D 42                jp  z,ESPSETUP.EXIT             ; When done, resume initialization
     777   00:42F6  FE 31                   cp  '1'                         ; Setup Nagle?
     778   00:42F8  CA DC 48                jp  z,SET_NAGLE
     779   00:42FB  FE 32                   cp  '2'                         ; Setup Wi-Fi On Period?
     780   00:42FD  CA 16 48                jp  z,SET_WIFI_TIMEOUT
     781   00:4300  FE 33                   cp  '3'                         ; Scan networks?
     782   00:4302  CA 6D 45                jp  z,START_WIFI_SCAN
     783   00:4305  FE 34                   cp  '4'                         ; Automatic Setting of Clock?
     784   00:4307  CA 8F 43                jp  z,START_CLK_AUTO
     785   00:430A  CD C0 00                call    BEEP                    ; Wrong Input, beep
     786   00:430D  CD 14 43                call    MM_CURSOR_SW            ; Cursor Off
     787   00:4310  76                      halt
     788   00:4311  C3 D3 42                jp  MM_CURSOR_BLINK             ; And return, waiting another key
     789   00:4314                      MM_CURSOR_SW:                       ; Cursor workaround for CONN_CHG_LOOP
     790   00:4314  3E 1D                   ld  a,GOLEFT
     791   00:4316  CD A2 00                call    CHPUT
     792   00:4319  3E 01                   ld  a,1
     793   00:431B  32 A9 FC                ld  (CSRSW),a
     794   00:431E  3E 20                   ld  a,' '
     795   00:4320  CD A2 00                call    CHPUT                   ; Switch the cursor display mode
     796   00:4323  AF                      xor a
     797   00:4324  32 A9 FC                ld  (CSRSW),a
     798   00:4327  C9                      ret
     799   00:4328                      GET_AP_STAT:                        ; Use 'call GET_AP_STAT'
     800   00:4328                          CLEAR_UART
     800   00:4328  3E 14             >     ld  a,20
     800   00:432A  D3 06             >     out (OUT_CMD_PORT),a
     801   00:432C  3E 67                   ld  a,CMD_AP_STS
     802   00:432E                          SEND_DATA                       ; Get AP conn status and name
     802   00:432E  D3 07             >     out (OUT_TX_PORT),a
     803   00:4330  21 3C 00                ld  hl,60                       ; Wait Up To 1s
     804   00:4333  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
     805   00:4337  DD 6B                   ld  ixl,e
     806   00:4339  DD 62                   ld  ixh,d                       ; Address in IX
     807   00:433B  C3 40 4B                jp  WAIT_MENU_CMD_RESPONSE
     808   00:433E                      
     809   00:433E                      ;============================
     810   00:433E                      ;===  SETUP Menu Routines  ==
     811   00:433E                      ;===  Wi-Fi and Clock Menu ==
     812   00:433E                      ;============================
     813   00:433E                      CLK_MSX1_GO:
     814   00:433E  21 33 67                ld  hl,MMENU_CLOCK_MSX1
     815   00:4341  CD 54 4C                call    PRINTHL                 ; Print Main Clock MSX1 message
     816   00:4344  CD F2 49                call    ISCLKAUTO
     817   00:4347  DD 7E 00                ld  a,(ix+0)                    ; Auto Clock Current setting
     818   00:434A  FE 03                   cp  3                           ; If 3 adapter disabled
     819   00:434C  28 08                   jr  z,CLK_MSX1_ADAPTERDIS
     820   00:434E  21 C7 67                ld  hl,MMENU_CLOCK_0
     821   00:4351  CD 54 4C                call    PRINTHL
     822   00:4354  18 06                   jr  CLK_MSX1_OPT
     823   00:4356                      CLK_MSX1_ADAPTERDIS:
     824   00:4356  21 0D 68                ld  hl,MMENU_CLOCK_3
     825   00:4359  CD 54 4C                call    PRINTHL
     826   00:435C                      CLK_MSX1_OPT:
     827   00:435C  21 20 68                ld  hl,MMENU_CLOCK_OPT
     828   00:435F  CD 54 4C                call    PRINTHL
     829   00:4362                      CLK_MSX1_WAIT_OPT_INPUT:
     830   00:4362  CD 9F 00                call    CHGET
     831   00:4365  FE 1B                   cp  #1b                         ; ESC?
     832   00:4367  CA 4F 42                jp  z,ESPSETUP                  ; Back to main menu
     833   00:436A  FE 30                   cp  '0'
     834   00:436C  CA 7A 43                jp  z,CLK_MSX1_SEND_CMD
     835   00:436F  FE 33                   cp  '3'
     836   00:4371  CA 36 44                jp  z,CLK_AUTO_WAIT_GMT
     837   00:4374  CD C0 00                call    BEEP                    ; Wrong Input, beep
     838   00:4377  C3 62 43                jp  CLK_MSX1_WAIT_OPT_INPUT     ; And return, waiting another key
     839   00:437A                      CLK_MSX1_SEND_CMD:
     840   00:437A  CD A2 00                call    CHPUT                   ; Print option
     841   00:437D  D6 30                   sub '0'                         ; Adjust format
     842   00:437F  DD 77 00                ld  (ix+0),a                    ; Save it
     843   00:4382  3E 0D                   ld  a,#0d
     844   00:4384  CD A2 00                call    CHPUT
     845   00:4387  3E 0A                   ld  a,#0a
     846   00:4389  CD A2 00                call    CHPUT
     847   00:438C  C3 2D 45                jp  CLK_AUTO_GMT_CHK_DONE       ; And sending the command will be done there
     848   00:438F                      
     849   00:438F                      START_CLK_AUTO:
     850   00:438F  3E 34                   ld  a,'4'
     851   00:4391  CD A2 00                call    CHPUT
     852   00:4394  CD EB 49                call    WAIT_250MS_AND_THEN_CONTINUE
     853   00:4397  3A 2D 00                ld  a,(#002D)                   ; Check MSX Version
     854   00:439A  B7                      or  a
     855   00:439B  CA 3E 43                jp  z,CLK_MSX1_GO               ; If zero, MSX1, so can just enable or disable adapter
     856   00:439E                      CLK_AUTO_GO:
     857   00:439E  21 D3 65                ld  hl,MMENU_CLOCK_MSX2
     858   00:43A1  CD 54 4C                call    PRINTHL                 ; Print Main Clock MSX2 message
     859   00:43A4  CD F2 49                call    ISCLKAUTO
     860   00:43A7  DD 7E 00                ld  a,(ix+0)                    ; Auto Clock Current setting
     861   00:43AA  B7                      or  a                           ; If zero, off
     862   00:43AB  20 08                   jr  nz,CLK_AUTO_CHK1
     863   00:43AD  21 C7 67                ld  hl,MMENU_CLOCK_0
     864   00:43B0  CD 54 4C                call    PRINTHL
     865   00:43B3  18 59                   jr  CLK_AUTO_GMT_OPT
     866   00:43B5                      CLK_AUTO_CHK1:
     867   00:43B5  3D                      dec a                           ; If 1, on and keep wifi on
     868   00:43B6  20 08                   jr  nz,CLK_AUTO_CHK2
     869   00:43B8  21 D9 67                ld  hl,MMENU_CLOCK_1
     870   00:43BB  CD 54 4C                call    PRINTHL
     871   00:43BE  18 13                   jr  CLK_AUTO_GMT
     872   00:43C0                      CLK_AUTO_CHK2:
     873   00:43C0  3D                      dec a                           ; If 2, on and turn wifi off
     874   00:43C1  20 08                   jr  nz,CLK_AUTO_3
     875   00:43C3  21 F3 67                ld  hl,MMENU_CLOCK_2
     876   00:43C6  CD 54 4C                call    PRINTHL
     877   00:43C9  18 08                   jr  CLK_AUTO_GMT
     878   00:43CB                      CLK_AUTO_3:
     879   00:43CB  21 0D 68                ld  hl,MMENU_CLOCK_3
     880   00:43CE  CD 54 4C                call    PRINTHL
     881   00:43D1  18 3B                   jr  CLK_AUTO_GMT_OPT
     882   00:43D3                      CLK_AUTO_GMT:
     883   00:43D3  DD 66 01                ld  h,(ix+1)                    ; Save it for now
     884   00:43D6  DD 7E 01                ld  a,(ix+1)                    ; GMT current setting
     885   00:43D9  CB 7F                   bit 7,a                         ; If set, is -
     886   00:43DB  28 0B                   jr  z,CLK_AUTO_GMTP
     887   00:43DD  3E 2D                   ld  a,'-'
     888   00:43DF  CD A2 00                call    CHPUT
     889   00:43E2  DD CB 01 BE             res 7,(ix+1)                    ; Clear - indicator
     890   00:43E6  18 05                   jr  CLK_AUTO_GMTM
     891   00:43E8                      CLK_AUTO_GMTP:
     892   00:43E8  3E 2B                   ld  a,'+'
     893   00:43EA  CD A2 00                call    CHPUT
     894   00:43ED                      CLK_AUTO_GMTM:
     895   00:43ED  3E 09                   ld  a,9
     896   00:43EF  DD BE 01                cp  (ix+1)                      ; Greater than 9?
     897   00:43F2  30 0F                   jr  nc,CLK_AUTO_GMTD            ; If not, just print what is in A + '0'
     898   00:43F4  3E 31                   ld  a,'1'                       ; It is 1
     899   00:43F6  CD A2 00                call    CHPUT
     900   00:43F9  DD 7E 01                ld  a,(ix+1)
     901   00:43FC  C6 26                   add '0'-10                      ; Need to subtract 10 and add '0' to print
     902   00:43FE  CD A2 00                call    CHPUT
     903   00:4401  18 0B                   jr  CLK_AUTO_GMT_OPT
     904   00:4403                      CLK_AUTO_GMTD:
     905   00:4403  3E 30                   ld  a,'0'
     906   00:4405  DD 86 01                add a,(ix+1)                    ; Our value
     907   00:4408  CD A2 00                call    CHPUT
     908   00:440B  DD 74 01                ld  (ix+1),h                    ; Restore original value
     909   00:440E                      CLK_AUTO_GMT_OPT:
     910   00:440E  21 20 68                ld  hl,MMENU_CLOCK_OPT
     911   00:4411  CD 54 4C                call    PRINTHL
     912   00:4414                      CLK_AUTO_WAIT_OPT_INPUT:
     913   00:4414  CD 9F 00                call    CHGET
     914   00:4417  FE 1B                   cp  #1b                         ; ESC?
     915   00:4419  CA 4F 42                jp  z,ESPSETUP                  ; Back to main menu
     916   00:441C  FE 30                   cp  '0'
     917   00:441E  CA 36 44                jp  z,CLK_AUTO_WAIT_GMT
     918   00:4421  FE 31                   cp  '1'
     919   00:4423  CA 36 44                jp  z,CLK_AUTO_WAIT_GMT
     920   00:4426  FE 32                   cp  '2'
     921   00:4428  CA 36 44                jp  z,CLK_AUTO_WAIT_GMT
     922   00:442B  FE 33                   cp  '3'
     923   00:442D  CA 36 44                jp  z,CLK_AUTO_WAIT_GMT
     924   00:4430  CD C0 00                call    BEEP                    ; Wrong Input, beep
     925   00:4433  C3 14 44                jp  CLK_AUTO_WAIT_OPT_INPUT     ; And return, waiting another key
     926   00:4436                      CLK_AUTO_WAIT_GMT:
     927   00:4436  CD A2 00                call    CHPUT                   ; Print option
     928   00:4439  D6 30                   sub '0'                         ; Adjust format
     929   00:443B  DD 77 00                ld  (ix+0),a                    ; Save it
     930   00:443E  B7                      or  a
     931   00:443F  CA 2D 45                jp  z,CLK_AUTO_GMT_CHK_DONE     ; And send the command if just disabling clock auto set
     932   00:4442  FE 03                   cp  3
     933   00:4444  CA 2D 45                jp  z,CLK_AUTO_GMT_CHK_DONE     ; Or send the command if just disabling the adapter
     934   00:4447  21 4A 68                ld  hl,MMENU_GMT_OPT
     935   00:444A  CD 54 4C                call    PRINTHL
     936   00:444D  16 00                   ld  d,0                         ; # of digits entered
     937   00:444F  1E 00                   ld  e,0                         ; # of characters printed
     938   00:4451  DD 36 01 00             ld  (ix+1),0                    ; GMT 0
     939   00:4455                      CLK_AUTO_WAIT_GMT_INPUT:
     940   00:4455  CD 9F 00                call    CHGET
     941   00:4458  FE 1B                   cp  #1b                         ; ESC?
     942   00:445A  CA 4F 42                jp  z,ESPSETUP                  ; Back to main menu
     943   00:445D  FE 0D                   cp  #0d                         ; ENTER?
     944   00:445F  CA A8 44                jp  z,CLK_AUTO_GMT_CHK_INPUT    ; Check if ok to send command
     945   00:4462  FE 08                   cp  #08                         ; Backspace?
     946   00:4464  CA 79 44                jp  z,CLK_AUTO_GMT_CHK_BS       ; Check if there is something to erase
     947   00:4467  FE 2D                   cp  '-'                         ; Negative value?
     948   00:4469  CA A8 44                jp  z,CLK_AUTO_GMT_CHK_INPUT
     949   00:446C  FE 30                   cp  '0'                         ; >=0?
     950   00:446E  DA 9A 44                jp  c,CLK_AUTO_GMT_BAD_INPUT    ; If not, bad input
     951   00:4471  FE 3A                   cp  '9'+1                       ; <= 9
     952   00:4473  D2 9A 44                jp  nc,CLK_AUTO_GMT_BAD_INPUT   ; If not, bad input
     953   00:4476  C3 A8 44                jp  CLK_AUTO_GMT_CHK_INPUT      ; Otherwise, validate digit
     954   00:4479                      CLK_AUTO_GMT_CHK_BS:
     955   00:4479  AF                      xor a
     956   00:447A  BB                      cp  e                           ; Anything on screen?
     957   00:447B  28 1D                   jr  z,CLK_AUTO_GMT_BAD_INPUT    ; Nothing to erase
     958   00:447D  1D                      dec e                           ; One less character on the screen
     959   00:447E  BA                      cp  d                           ; Any digit?
     960   00:447F  28 03                   jr  z,CLK_AUTO_GMT_CHK_BS_MIN   ; If not, just erase - sign
     961   00:4481                          ; There is, so it is one less digit
     962   00:4481  15                      dec d
     963   00:4482  18 04                   jr  CLK_AUTO_GMT_CHK_DIGIT
     964   00:4484                      CLK_AUTO_GMT_CHK_BS_MIN:
     965   00:4484  DD 36 01 00             ld  (ix+1),0                    ; Reset sign
     966   00:4488                      CLK_AUTO_GMT_CHK_DIGIT:
     967   00:4488  3E 08                   ld  a,8                         ; Backspace
     968   00:448A  CD A2 00                call    CHPUT                   ; Print it
     969   00:448D  3E 20                   ld  a,' '                       ; Space
     970   00:448F  CD A2 00                call    CHPUT                   ; Print it
     971   00:4492  3E 08                   ld  a,8                         ; Backspace
     972   00:4494  CD A2 00                call    CHPUT                   ; Print it
     973   00:4497  C3 55 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; Return
     974   00:449A                      CLK_AUTO_GMT_BAD_INPUT:
     975   00:449A                          ; Beep might use sub rom, and if so, all registers will be messed up, better save
     976   00:449A  C5                      push    bc
     977   00:449B  D5                      push    de
     978   00:449C  F5                      push    af
     979   00:449D  E5                      push    hl
     980   00:449E  CD C0 00                call    BEEP                    ; Wrong Input, beep
     981   00:44A1  E1                      pop hl
     982   00:44A2  F1                      pop af
     983   00:44A3  D1                      pop de
     984   00:44A4  C1                      pop bc
     985   00:44A5  C3 55 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; And return, waiting another key
     986   00:44A8                      CLK_AUTO_GMT_CHK_INPUT:
     987   00:44A8  4F                      ld  c,a                         ; Save in C for printing if needed
     988   00:44A9  FE 2D                   cp  '-'                         ; - sign?
     989   00:44AB  20 11                   jr  nz,CLK_AUTO_GMT_CHK_CR      ; If not, check if enter
     990   00:44AD                          ; - sign
     991   00:44AD  3E 00                   ld  a,0
     992   00:44AF  BB                      cp  e                           ; If not the first character, can't accept
     993   00:44B0  20 E8                   jr  nz,CLK_AUTO_GMT_BAD_INPUT
     994   00:44B2                          ; It is the first, so let's print it
     995   00:44B2  79                      ld  a,c
     996   00:44B3  CD A2 00                call    CHPUT
     997   00:44B6  DD 36 01 80             ld  (ix+1),0x80                 ; Set the - sign bit, for now rest is zero
     998   00:44BA  1C                      inc e                           ; Increase # of characters printed
     999   00:44BB  C3 55 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; Continue waiting input
    1000   00:44BE                      CLK_AUTO_GMT_CHK_CR:
    1001   00:44BE  FE 0D                   cp  #0d                         ; ENTER?
    1002   00:44C0  20 0F                   jr  nz,CLK_AUTO_GMT_CHK_CD      ; If not, check if digit is valid
    1003   00:44C2                          ; Enter
    1004   00:44C2  3E 00                   ld  a,0
    1005   00:44C4  BA                      cp  d                           ; Ok, at least one digit entered?
    1006   00:44C5  28 D3                   jr  z,CLK_AUTO_GMT_BAD_INPUT    ; No, so, enter is no good now
    1007   00:44C7                          ; It is, if it had a digit entered and did not send, it was 1, so...
    1008   00:44C7  3E 01                   ld  a,1
    1009   00:44C9  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1010   00:44CC  DD 77 01                ld  (ix+1),a                    ; Save
    1011   00:44CF  18 5C                   jr  CLK_AUTO_GMT_CHK_DONE       ; Ok, ready to send
    1012   00:44D1                      CLK_AUTO_GMT_CHK_CD:
    1013   00:44D1                          ; Ok, it is a digit
    1014   00:44D1  06 30                   ld  b,'0'
    1015   00:44D3  90                      sub a,b                         ; A has digit value
    1016   00:44D4  47                      ld  b,a                         ; Save in B
    1017   00:44D5  3E 00                   ld  a,0
    1018   00:44D7  BA                      cp  d
    1019   00:44D8  20 1E                   jr  nz,CLK_AUTO_GMT_CHK_CSD     ; If not zero, it is second digit, so almost done
    1020   00:44DA                          ; 1st digit, let's check if it is other than 1, if it is, we are almost done
    1021   00:44DA  3E 01                   ld  a,1
    1022   00:44DC  B8                      cp  b
    1023   00:44DD  28 10                   jr  z,CLK_AUTO_GMT_CHK_CD.1     ; If it is 1, wait next digit or enter
    1024   00:44DF                          ; Not 1, so just adjust ix+1 and go
    1025   00:44DF  79                      ld  a,c
    1026   00:44E0  CD A2 00                call    CHPUT                   ; Print it
    1027   00:44E3  78                      ld  a,b
    1028   00:44E4  B7                      or  a
    1029   00:44E5  28 03                   jr  z,CLK_AUTO_SKIP_SIGN
    1030   00:44E7  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1031   00:44EA                      CLK_AUTO_SKIP_SIGN:
    1032   00:44EA  DD 77 01                ld  (ix+1),a                    ; Save
    1033   00:44ED  18 3E                   jr  CLK_AUTO_GMT_CHK_DONE       ; Ok, ready to send
    1034   00:44EF                      CLK_AUTO_GMT_CHK_CD.1:
    1035   00:44EF  79                      ld  a,c
    1036   00:44F0  CD A2 00                call    CHPUT                   ; Print it
    1037   00:44F3  14                      inc d                           ; Digits entered now is 1
    1038   00:44F4  1C                      inc e                           ; Digits printed increased
    1039   00:44F5  C3 55 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; Continue waiting input
    1040   00:44F8                      CLK_AUTO_GMT_CHK_CSD:
    1041   00:44F8                          ; Second digit, easy... First was 1, now need to check if it is 0, 1 or 2, otherwise, bad entry
    1042   00:44F8  78                      ld  a,b
    1043   00:44F9  06 03                   ld  b,3
    1044   00:44FB  B8                      cp  b
    1045   00:44FC  D2 9A 44                jp  nc,CLK_AUTO_GMT_BAD_INPUT   ; 3 or more, so, not valid
    1046   00:44FF  B7                      or  a                           ; Is it zero?
    1047   00:4500  20 0E                   jr  nz,CLK_AUTO_GMT_CHK_CSD1    ; If not, check for 1
    1048   00:4502                          ; It was zero
    1049   00:4502  3E 0A                   ld  a,10                        ; So, 10
    1050   00:4504  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1051   00:4507  DD 77 01                ld  (ix+1),a                    ; Save
    1052   00:450A  79                      ld  a,c
    1053   00:450B  CD A2 00                call    CHPUT                   ; Print it
    1054   00:450E  18 1D                   jr  CLK_AUTO_GMT_CHK_DONE       ; Ready to
    1055   00:4510                      CLK_AUTO_GMT_CHK_CSD1:
    1056   00:4510  3D                      dec a                           ; Is it one?
    1057   00:4511  20 0E                   jr  nz,CLK_AUTO_GMT_CHK_CSD2
    1058   00:4513                          ; It was one
    1059   00:4513  3E 0B                   ld  a,11                        ; So, eleven
    1060   00:4515  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1061   00:4518  DD 77 01                ld  (ix+1),a                    ; Save
    1062   00:451B  79                      ld  a,c
    1063   00:451C  CD A2 00                call    CHPUT                   ; Print it
    1064   00:451F  18 0C                   jr  CLK_AUTO_GMT_CHK_DONE       ; Ready to send
    1065   00:4521                      CLK_AUTO_GMT_CHK_CSD2:
    1066   00:4521                          ; It was two
    1067   00:4521  3E 0C                   ld  a,12                        ; So, twelve
    1068   00:4523  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1069   00:4526  DD 77 01                ld  (ix+1),a                    ; Save
    1070   00:4529  79                      ld  a,c
    1071   00:452A  CD A2 00                call    CHPUT                   ; Print it
    1072   00:452D                          ; And send command
    1073   00:452D                      CLK_AUTO_GMT_CHK_DONE:
    1074   00:452D  3E 0D                   ld  a,#0d
    1075   00:452F  CD A2 00                call    CHPUT
    1076   00:4532  3E 0A                   ld  a,#0a
    1077   00:4534  CD A2 00                call    CHPUT
    1078   00:4537  21 0B 6E                ld  hl,STR_SENDING
    1079   00:453A  CD 54 4C                call    PRINTHL
    1080   00:453D                          CLEAR_UART
    1080   00:453D  3E 14             >     ld  a,20
    1080   00:453F  D3 06             >     out (OUT_CMD_PORT),a
    1081   00:4541  3E 43                   ld  a,CMD_SET_ACLK_SETTINGS
    1082   00:4543                          SEND_DATA
    1082   00:4543  D3 07             >     out (OUT_TX_PORT),a
    1083   00:4545  3E 00                   ld  a,0                         ; Size MSB is 0
    1084   00:4547                          SEND_DATA
    1084   00:4547  D3 07             >     out (OUT_TX_PORT),a
    1085   00:4549  3E 02                   ld  a,2                         ; Size LSB is 2
    1086   00:454B                          SEND_DATA
    1086   00:454B  D3 07             >     out (OUT_TX_PORT),a
    1087   00:454D  DD 7E 00                ld  a,(ix+0)                    ; Option
    1088   00:4550                          SEND_DATA
    1088   00:4550  D3 07             >     out (OUT_TX_PORT),a
    1089   00:4552  DD 7E 01                ld  a,(ix+1)                    ; GMT
    1090   00:4555                          SEND_DATA
    1090   00:4555  D3 07             >     out (OUT_TX_PORT),a
    1091   00:4557  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1092   00:455A  3E 43                   ld  a,CMD_SET_ACLK_SETTINGS
    1093   00:455C  CD 07 4B                call    WAIT_MENU_QCMD_RESPONSE
    1094   00:455F  21 26 6E                ld  hl,STR_SENDING_OK
    1095   00:4562  20 03                   jr  nz,CLK_AUTO_GMT_CHK_RESULT
    1096   00:4564  21 A3 6E                ld  hl,STR_SENDING_FAIL
    1097   00:4567                      CLK_AUTO_GMT_CHK_RESULT:
    1098   00:4567  CD 54 4C                call    PRINTHL
    1099   00:456A  C3 E3 49                jp  WAIT_2S_AND_THEN_MAINMENU
    1100   00:456D                      
    1101   00:456D                      ;============================
    1102   00:456D                      ;===  SETUP Menu Routines  ==
    1103   00:456D                      ;===    Wi-Fi Scan Menu    ==
    1104   00:456D                      ;============================
    1105   00:456D                      START_WIFI_SCAN:
    1106   00:456D  3E 33                   ld  a,'3'
    1107   00:456F  CD A2 00                call    CHPUT
    1108   00:4572  CD EB 49                call    WAIT_250MS_AND_THEN_CONTINUE
    1109   00:4575                      START_WIFI_RESCAN:
    1110   00:4575  21 DF 68                ld  hl,MMENU_SCAN
    1111   00:4578  CD 54 4C                call    PRINTHL                 ; Print Main Scan message
    1112   00:457B  CD 94 49                call    STARTWIFISCAN           ; Request Wi-Fi Scan to start
    1113   00:457E  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1114   00:4582  DD 6B                   ld  ixl,e
    1115   00:4584  DD 62                   ld  ixh,d                       ; Address in IX
    1116   00:4586  11 14 00                ld  de,20                       ; At least 10s waiting scan to finish, retry 20 times waiting 0.5s between attempts
    1117   00:4589                      WIFI_SCAN_WAIT_END:
    1118   00:4589                          CLEAR_UART
    1118   00:4589  3E 14             >     ld  a,20
    1118   00:458B  D3 06             >     out (OUT_CMD_PORT),a
    1119   00:458D  3E 73                   ld  a,CMD_SCAN_RESULTS
    1120   00:458F                          SEND_DATA
    1120   00:458F  D3 07             >     out (OUT_TX_PORT),a
    1121   00:4591  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1122   00:4594  CD C7 4B                call    WAIT_MENU_SCMD_RESPONSE
    1123   00:4597  C2 AF 45                jp  nz,WIFI_SCAN_SHOW_LIST      ; if success show the list
    1124   00:459A  78                      ld  a,b
    1125   00:459B  FE 02                   cp  2                           ; If 2, scan is done and nothing found
    1126   00:459D  CA 04 48                jp  z,WIFI_SCAN_NONETWORKS
    1127   00:45A0  2E 1E                   ld  l,30
    1128   00:45A2                      WIFI_SCAN_WAITHS:
    1129   00:45A2  76                      halt
    1130   00:45A3  2D                      dec l
    1131   00:45A4  20 FC                   jr  nz,WIFI_SCAN_WAITHS
    1132   00:45A6  1B                      dec de
    1133   00:45A7  7B                      ld  a,e
    1134   00:45A8  B2                      or  d
    1135   00:45A9  CA 0D 48                jp  z,WIFI_SCAN_TIMEOUT
    1136   00:45AC  C3 89 45                jp  WIFI_SCAN_WAIT_END
    1137   00:45AF                      WIFI_SCAN_SHOW_LIST:
    1138   00:45AF  57                      ld  d,a                         ; Save access point counter here
    1139   00:45B0  1E 00                   ld  e,0                         ; And here how many were printed
    1140   00:45B2  21 64 69                ld  hl,MMENU_SCANS
    1141   00:45B5  CD 54 4C                call    PRINTHL
    1142   00:45B8  DD E5                   push    ix
    1143   00:45BA  E1                      pop hl                          ; IX in HL
    1144   00:45BB                      WIFI_LIST_LOOP:
    1145   00:45BB  7B                      ld  a,e
    1146   00:45BC  C6 30                   add a,'0'                       ; Convert to number
    1147   00:45BE  CD A2 00                call    CHPUT
    1148   00:45C1  3E 20                   ld  a,' '                       ; Space
    1149   00:45C3  CD A2 00                call    CHPUT
    1150   00:45C6  3E 2D                   ld  a,'-'                       ; Dash
    1151   00:45C8  CD A2 00                call    CHPUT
    1152   00:45CB  3E 20                   ld  a,' '                       ; Space
    1153   00:45CD  CD A2 00                call    CHPUT
    1154   00:45D0  06 18                   ld  b,24                        ; Cuts AP names > 23 chars
    1155   00:45D2                      PRT_APNAMELP:
    1156   00:45D2  7E                      ld  a,(hl)
    1157   00:45D3  B7                      or  a
    1158   00:45D4  CA EE 45                jp  z,PRT_APENC
    1159   00:45D7  CD A2 00                call    CHPUT
    1160   00:45DA  23                      inc hl
    1161   00:45DB  10 F5                   djnz    PRT_APNAMELP
    1162   00:45DD  E5                      push    hl
    1163   00:45DE  21 FB 6A                ld  hl,SCAN_TERMINATOR_CUT
    1164   00:45E1  CD 54 4C                call    PRINTHL
    1165   00:45E4  E1                      pop hl
    1166   00:45E5                      PRT_APNAMELP_CUT:
    1167   00:45E5  7E                      ld  a,(hl)
    1168   00:45E6  B7                      or  a
    1169   00:45E7  CA EE 45                jp  z,PRT_APENC
    1170   00:45EA  23                      inc hl
    1171   00:45EB  C3 E5 45                jp  PRT_APNAMELP_CUT
    1172   00:45EE                      PRT_APENC:
    1173   00:45EE  23                      inc hl
    1174   00:45EF  7E                      ld  a,(hl)
    1175   00:45F0  B7                      or  a
    1176   00:45F1  CA FF 45                jp  z,PRT_APNOTENC
    1177   00:45F4  E5                      push    hl
    1178   00:45F5  21 09 6B                ld  hl,SCAN_TERMINATOR_ENC
    1179   00:45F8  CD 54 4C                call    PRINTHL
    1180   00:45FB  E1                      pop hl
    1181   00:45FC  C3 07 46                jp  PRT_AP_CHKLOOP
    1182   00:45FF                      PRT_APNOTENC:
    1183   00:45FF  E5                      push    hl
    1184   00:4600  21 02 6B                ld  hl,SCAN_TERMINATOR_OPEN
    1185   00:4603  CD 54 4C                call    PRINTHL
    1186   00:4606  E1                      pop hl
    1187   00:4607                      PRT_AP_CHKLOOP:
    1188   00:4607  23                      inc hl
    1189   00:4608  1C                      inc e
    1190   00:4609  3E 08                   ld  a,SCAN_MAX_PAGE_SIZE
    1191   00:460B  BB                      cp  e
    1192   00:460C  CA 17 46                jp  z,APLIST_OVERFLOW
    1193   00:460F  15                      dec d
    1194   00:4610  C2 BB 45                jp  nz,WIFI_LIST_LOOP
    1195   00:4613  06 00                   ld  b,0                         ; Signal no more list data
    1196   00:4615  18 10                   jr  APLIST_NO_OVERFLOW
    1197   00:4617                      APLIST_OVERFLOW:
    1198   00:4617  15                      dec d                           ; Update remaining items
    1199   00:4618  AF                      xor a
    1200   00:4619  B2                      or  d                           ; Still has items?
    1201   00:461A  28 0B                   jr  z,APLIST_NO_OVERFLOW        ; No more items
    1202   00:461C  06 01                   ld  b,1                         ; Signal that there still is data pending to list in another page
    1203   00:461E  E5                      push    hl
    1204   00:461F  FD E1                   pop iy                          ; Save in IY the address to continue from
    1205   00:4621  4A                      ld  c,d                         ; And C has the remaining AP count
    1206   00:4622  21 8C 6A                ld  hl,MMENU_SCANQM
    1207   00:4625  18 03                   jr  APLIST_NOFLW
    1208   00:4627                      APLIST_NO_OVERFLOW:
    1209   00:4627                          ; If here, current page has been printed
    1210   00:4627                          ; E has the maximum allowable AP number
    1211   00:4627                          ; B will indicate if there are more items for a next page
    1212   00:4627                          ; IY will hold the address of the following items
    1213   00:4627                          ; Let's ask which one to connect
    1214   00:4627  21 21 6A                ld  hl,MMENU_SCANQ
    1215   00:462A                      APLIST_NOFLW:
    1216   00:462A  CD 54 4C                call    PRINTHL                 ; Show message asking which network to connect
    1217   00:462D  3E 30                   ld  a,'0'
    1218   00:462F  83                      add a,e
    1219   00:4630  5F                      ld  e,a                         ; To make it easy in the selection screen
    1220   00:4631                      WIFI_SELECT_AP:
    1221   00:4631  CD 9F 00                call    CHGET
    1222   00:4634  FE 1B                   cp  #1b                         ; ESC?
    1223   00:4636  CA 4F 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1224   00:4639  FE 20                   cp  #20                         ; Spacebar?
    1225   00:463B  CA 4F 46                jp  z,WIFI_SELECT_SPACEBAR      ; Check if re-scan or next page
    1226   00:463E  FE 0D                   cp  CR                          ; ENTER?
    1227   00:4640  CA 5C 46                jp  z,WIFI_CONNECT_ME_CHOOSEN   ; Request AP Name and Password if needed
    1228   00:4643  FE 30                   cp  '0'                         ; Check if A is less than 0
    1229   00:4645  DA EE 47                jp  c,INPUT_WFSAP_BAD_INPUT     ; If it is, ignore
    1230   00:4648  BB                      cp  e                           ; Check if a is greater than what is in E
    1231   00:4649  D2 EE 47                jp  nc,INPUT_WFSAP_BAD_INPUT    ; If it is, ignore
    1232   00:464C  C3 E6 46                jp  WIFI_CONNECT_SELECTION_OK   ; Selection Ok if here
    1233   00:464F                      
    1234   00:464F                      WIFI_SELECT_SPACEBAR:
    1235   00:464F  AF                      xor a
    1236   00:4650  B2                      or  d                           ; D = AP counter
    1237   00:4651  CA 75 45                jp  z,START_WIFI_RESCAN         ; Rescan if no more items
    1238   00:4654                          ; Otherwise, more items, start at IY
    1239   00:4654  FD E5                   push    iy
    1240   00:4656  DD E1                   pop ix                          ; Restore the list from where we finished last time
    1241   00:4658  79                      ld  a,c                         ; Restore the remaining APs to list
    1242   00:4659  C3 AF 45                jp  WIFI_SCAN_SHOW_LIST         ; And show
    1243   00:465C                      
    1244   00:465C                      WIFI_CONNECT_ME_CHOOSEN:
    1245   00:465C  21 63 68                ld  hl,MMENU_MANUALENTRY
    1246   00:465F  CD 54 4C                call    PRINTHL                 ; Show message asking AP details....
    1247   00:4662                          ; IX has the AP list, we don't care, but that address is ours to use to handle SSID Entry
    1248   00:4662  DD E5                   push    ix
    1249   00:4664  E1                      pop hl                          ; HL has the address
    1250   00:4665  0E 00                   ld  c,0                         ; AP name size
    1251   00:4667                      WIFI_CONNECT_MANUAL_ENTRY:
    1252   00:4667  CD 9F 00                call    CHGET
    1253   00:466A  FE 1B                   cp  #1b                         ; ESC?
    1254   00:466C  CA 4F 42                jp  z,ESPSETUP                  ; Back to main setup
    1255   00:466F  FE 08                   cp  #08                         ; Backspace?
    1256   00:4671  28 55                   jr  z,WIFI_CONNECT_ME_BS        ; Check if there is something to erase
    1257   00:4673  FE 0D                   cp  #0d                         ; ENTER?
    1258   00:4675  28 68                   jr  z,WIFI_ME_CHECK_INPUT       ; Check if ok
    1259   00:4677                          ; Otherwise it is a digit
    1260   00:4677  77                      ld  (hl),a
    1261   00:4678  79                      ld  a,c
    1262   00:4679  D6 20                   sub 32                          ; SSID maximum is 32 characters
    1263   00:467B  28 EA                   jr  z,WIFI_CONNECT_MANUAL_ENTRY
    1264   00:467D  7E                      ld  a,(hl)
    1265   00:467E  0C                      inc c
    1266   00:467F  23                      inc hl
    1267   00:4680  FE 20                   cp  32
    1268   00:4682  30 04                   jr  nc,WIFI_CONNECT_ME_CHKPRT2  ; Ok, not below space, but is it delete?
    1269   00:4684  3E 3F                   ld  a,'?'                       ; Prints a question mark
    1270   00:4686  18 06                   jr  WIFI_CONNECT_ME_CHKPRTD
    1271   00:4688                      WIFI_CONNECT_ME_CHKPRT2:
    1272   00:4688  FE 7F                   cp  #7f
    1273   00:468A  20 02                   jr  nz,WIFI_CONNECT_ME_CHKPRTD
    1274   00:468C  3E 3F                   ld  a,'?'                       ; Prints a question mark if it is delete
    1275   00:468E                      WIFI_CONNECT_ME_CHKPRTD:
    1276   00:468E  CD A2 00                call    CHPUT                   ; Print a char
    1277   00:4691  C3 67 46                jp  WIFI_CONNECT_MANUAL_ENTRY
    1278   00:4694                      WIFI_CONNECT_ME_0_TERM:
    1279   00:4694  AF                      xor a
    1280   00:4695  77                      ld  (hl),a
    1281   00:4696  23                      inc hl
    1282   00:4697  E5                      push    hl                      ; Save it
    1283   00:4698  21 C4 68                ld  hl,MENU_MANUALENTRY_PWD
    1284   00:469B  CD 54 4C                call    PRINTHL                 ; We are asking if password is needed
    1285   00:469E  E1                      pop hl                          ; Restore it
    1286   00:469F  CD 9F 00                call    CHGET                   ; Get key, if Y or y, needed, otherwise not
    1287   00:46A2  CB AF                   res 5,a                         ; Force upper case
    1288   00:46A4  FE 59                   cp  'Y'
    1289   00:46A6  28 08                   jr  z,WIFI_CONNECT_ME_PWD_Y     ; And tell using encryption
    1290   00:46A8  3E 6E                   ld  a,'n'
    1291   00:46AA  CD A2 00                call    CHPUT                   ; Overwrite what was typed with 'n'
    1292   00:46AD  AF                      xor a                           ; Ok, if here, no pwd, so no encryption
    1293   00:46AE  18 07                   jr  WIFI_CONNECT_ME_PWD
    1294   00:46B0                      WIFI_CONNECT_ME_PWD_Y:
    1295   00:46B0  3E 79                   ld  a,'y'
    1296   00:46B2  CD A2 00                call    CHPUT                   ; Print 'y'
    1297   00:46B5  3E 01                   ld  a,1                         ; Do not change flags, pwd needed
    1298   00:46B7                      WIFI_CONNECT_ME_PWD:
    1299   00:46B7  77                      ld  (hl),a                      ; Save if encryption is expected
    1300   00:46B8  DD E5                   push    ix
    1301   00:46BA  E1                      pop hl                          ; HL containing the beginning of SSID name
    1302   00:46BB  3E 0D                   ld  a,#0d
    1303   00:46BD  CD A2 00                call    CHPUT
    1304   00:46C0  3E 0A                   ld  a,#0a
    1305   00:46C2  CD A2 00                call    CHPUT
    1306   00:46C5  C3 0A 47                jp  WIFI_CONNECT_AP_PWDQ        ; And the rest is handled like if menu selected
    1307   00:46C8                      WIFI_CONNECT_ME_BS:
    1308   00:46C8  AF                      xor a
    1309   00:46C9  B9                      cp  c                           ; Has any data to delete?
    1310   00:46CA  28 9B                   jr  z,WIFI_CONNECT_MANUAL_ENTRY ; No
    1311   00:46CC                          ; Yes
    1312   00:46CC  2B                      dec hl                          ; Decrement pointer
    1313   00:46CD  0D                      dec c                           ; Decrement counter
    1314   00:46CE  3E 08                   ld  a,8                         ; Backspace
    1315   00:46D0  CD A2 00                call    CHPUT                   ; Print it
    1316   00:46D3  3E 20                   ld  a,' '                       ; Space
    1317   00:46D5  CD A2 00                call    CHPUT                   ; Print it
    1318   00:46D8  3E 08                   ld  a,8                         ; Backspace
    1319   00:46DA  CD A2 00                call    CHPUT                   ; Print it
    1320   00:46DD  18 88                   jr  WIFI_CONNECT_MANUAL_ENTRY   ; Return
    1321   00:46DF                      WIFI_ME_CHECK_INPUT:
    1322   00:46DF  AF                      xor a
    1323   00:46E0  B9                      cp  c                           ; Has received any data?
    1324   00:46E1  28 84                   jr  z,WIFI_CONNECT_MANUAL_ENTRY ; No
    1325   00:46E3  C3 94 46                jp  WIFI_CONNECT_ME_0_TERM      ; Yes, so handle SSID input termination
    1326   00:46E6                      
    1327   00:46E6                      WIFI_CONNECT_SELECTION_OK:
    1328   00:46E6  CD A2 00                call    CHPUT                   ; Valid input, print it
    1329   00:46E9  1E 30                   ld  e,'0'
    1330   00:46EB  93                      sub a,e                         ; Get in decimal
    1331   00:46EC  5F                      ld  e,a                         ; Back in E
    1332   00:46ED                          ; IX has the AP list, A which one has been selected, now our routine will do it
    1333   00:46ED  3E 0D                   ld  a,#0d
    1334   00:46EF  CD A2 00                call    CHPUT
    1335   00:46F2  3E 0A                   ld  a,#0a
    1336   00:46F4  CD A2 00                call    CHPUT
    1337   00:46F7  DD E5                   push    ix
    1338   00:46F9  E1                      pop hl                          ; put IX in HL
    1339   00:46FA                      WIFI_CONNECT_AP_SRCH:
    1340   00:46FA  7B                      ld  a,e
    1341   00:46FB  B7                      or  a
    1342   00:46FC                      WIFI_CONNECT_AP_SRCH.1:
    1343   00:46FC  CA 0A 47                jp  z,WIFI_CONNECT_AP_PWDQ
    1344   00:46FF  7E                      ld  a,(hl)
    1345   00:4700  23                      inc hl
    1346   00:4701  B7                      or  a
    1347   00:4702  C2 FC 46                jp  nz,WIFI_CONNECT_AP_SRCH.1   ; Find string terminator
    1348   00:4705                          ; Found, jump encryption byte
    1349   00:4705  23                      inc hl
    1350   00:4706  1D                      dec e                           ; Decrement selection, if 0 we are done
    1351   00:4707  C2 FC 46                jp  nz,WIFI_CONNECT_AP_SRCH.1
    1352   00:470A                      WIFI_CONNECT_AP_PWDQ:
    1353   00:470A                          ; HL has the address of AP name string
    1354   00:470A  54                      ld  d,h
    1355   00:470B  5D                      ld  e,l                         ; Save copy in D
    1356   00:470C  01 00 00                ld  bc,0                        ; BC will have the ap connection data length
    1357   00:470F                      WIFI_CONNECT_APSIZE:
    1358   00:470F  03                      inc bc
    1359   00:4710  1A                      ld  a,(de)
    1360   00:4711  13                      inc de
    1361   00:4712  B7                      or  a
    1362   00:4713  C2 0F 47                jp  nz,WIFI_CONNECT_APSIZE      ; Count size, including zero terminator
    1363   00:4716                          ; Check for encryption
    1364   00:4716  1A                      ld  a,(de)
    1365   00:4717  B7                      or  a
    1366   00:4718  CA A9 47                jp  z,WIFI_CONNECT_SENDCMD      ; If no password requested, good to go
    1367   00:471B                          ; Shoot, need to request password, well, let's do it
    1368   00:471B  E5                      push    hl                      ; Save HL
    1369   00:471C  21 DE 69                ld  hl,MMENU_ASKPWD
    1370   00:471F  CD 54 4C                call    PRINTHL                 ; Inform that user need to input PWD
    1371   00:4722  E1                      pop hl                          ; Restore HL
    1372   00:4723  FD 21 00 00             ld  iy,0                        ; IY will help in backspacing
    1373   00:4727  DD 26 01                ld  ixh,1                       ; Start hidden
    1374   00:472A                      WIFI_CONNECT_RCV_PWD:
    1375   00:472A  CD 9F 00                call    CHGET
    1376   00:472D  FE 1B                   cp  #1b                         ; ESC?
    1377   00:472F  CA 4F 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1378   00:4732  FE 08                   cp  #08                         ; Backspace?
    1379   00:4734  CA 85 47                jp  z,WIFI_CONNECT_RCV_PWD_BS   ; Check if there is something to erase
    1380   00:4737  FE 0D                   cp  #0d                         ; ENTER?
    1381   00:4739  CA A2 47                jp  z,WIFI_PWD_CHECK_INPUT      ; Check if ok
    1382   00:473C  FE 7F                   cp  #7f                         ; Delete?
    1383   00:473E  CA 71 47                jp  z,WIFI_CONNECT_RCV_PWDH     ; Change password from clear to hidden or vice versa
    1384   00:4741                      WIFI_CONNECT_RCV_PWD_STR:
    1385   00:4741                          ; Ok, so it is a digit and store
    1386   00:4741  12                      ld  (de),a
    1387   00:4742  FD 7D                   ld  a,iyl
    1388   00:4744  D6 3F                   sub 63                          ; 63 chars password limit (WPA2 encryption)
    1389   00:4746  28 E2                   jr  z,WIFI_CONNECT_RCV_PWD
    1390   00:4748  1A                      ld  a,(de)
    1391   00:4749  03                      inc bc
    1392   00:474A  13                      inc de
    1393   00:474B  FD 23                   inc iy                          ; Increment counters and pointer
    1394   00:474D  F5                      push    af                      ; Save A
    1395   00:474E  DD 7C                   ld  a,ixh
    1396   00:4750  B7                      or  a                           ; If zero, print char, otherwise print *
    1397   00:4751  28 09                   jr  z,WIFI_CONNECT_RCV_PWD_CHAR
    1398   00:4753  F1                      pop af
    1399   00:4754  3E 2A                   ld  a,'*'                       ; Print * and keep password hidden
    1400   00:4756  CD A2 00                call    CHPUT
    1401   00:4759  C3 2A 47                jp  WIFI_CONNECT_RCV_PWD        ; And back to receiving digits
    1402   00:475C                      WIFI_CONNECT_RCV_PWD_CHAR:
    1403   00:475C  F1                      pop af
    1404   00:475D  FE 20                   cp  32
    1405   00:475F  30 04                   jr  nc,WIFI_CONNECT_RCV_CHKPRT2 ; Ok, not below space, but is it delete?
    1406   00:4761  3E 3F                   ld  a,'?'                       ; Prints a question mark
    1407   00:4763  18 06                   jr  WIFI_CONNECT_RCV_CHKPRTD
    1408   00:4765                      WIFI_CONNECT_RCV_CHKPRT2:
    1409   00:4765  FE 7F                   cp  #7f
    1410   00:4767  20 02                   jr  nz,WIFI_CONNECT_RCV_CHKPRTD
    1411   00:4769  3E 3F                   ld  a,'?'                       ; Prints a question mark if it is delete
    1412   00:476B                      WIFI_CONNECT_RCV_CHKPRTD:
    1413   00:476B  CD A2 00                call    CHPUT                   ; Print a char
    1414   00:476E  C3 2A 47                jp  WIFI_CONNECT_RCV_PWD        ; And back to receiving digits
    1415   00:4771                      
    1416   00:4771                      WIFI_CONNECT_RCV_PWDH:
    1417   00:4771  FD 7D                   ld  a,iyl
    1418   00:4773  FD B4                   or  iyh
    1419   00:4775  C2 41 47                jp  nz,WIFI_CONNECT_RCV_PWD_STR ; If digits entered, can't change password behavior, so it is a pass phrase char
    1420   00:4778  AF                      xor a
    1421   00:4779  DD B4                   or  ixh
    1422   00:477B  DD 26 01                ld  ixh,1
    1423   00:477E  28 AA                   jr  z,WIFI_CONNECT_RCV_PWD      ; Return if it was 0
    1424   00:4780  DD 26 00                ld  ixh,0
    1425   00:4783  28 A5                   jr  z,WIFI_CONNECT_RCV_PWD      ; Otherwise set to 0 and return
    1426   00:4785                      
    1427   00:4785                      WIFI_CONNECT_RCV_PWD_BS:
    1428   00:4785  FD 7D                   ld  a,iyl
    1429   00:4787  FD B4                   or  iyh
    1430   00:4789  CA 2A 47                jp  z,WIFI_CONNECT_RCV_PWD      ; If no digits entered, nothing to erase
    1431   00:478C  FD 2B                   dec iy                          ; Decrement counter
    1432   00:478E  0B                      dec bc                          ; Decrement counter
    1433   00:478F  1B                      dec de                          ; Decrement pointer
    1434   00:4790  3E 08                   ld  a,8                         ; Backspace
    1435   00:4792  CD A2 00                call    CHPUT                   ; Print it
    1436   00:4795  3E 20                   ld  a,' '                       ; Space
    1437   00:4797  CD A2 00                call    CHPUT                   ; Print it
    1438   00:479A  3E 08                   ld  a,8                         ; Backspace
    1439   00:479C  CD A2 00                call    CHPUT                   ; Print it
    1440   00:479F  C3 2A 47                jp  WIFI_CONNECT_RCV_PWD        ; Return
    1441   00:47A2                      
    1442   00:47A2                      WIFI_PWD_CHECK_INPUT:
    1443   00:47A2  FD 7D                   ld  a,iyl
    1444   00:47A4  FD B4                   or  iyh
    1445   00:47A6  CA 2A 47                jp  z,WIFI_CONNECT_RCV_PWD      ; If no digits entered, no password to send
    1446   00:47A9                          ; Otherwise done and ready to send
    1447   00:47A9                      WIFI_CONNECT_SENDCMD:
    1448   00:47A9  CD EB 49                call    WAIT_250MS_AND_THEN_CONTINUE
    1449   00:47AC  E5                      push    hl
    1450   00:47AD  21 9A 69                ld  HL,MMENU_CONNECTING
    1451   00:47B0  CD 54 4C                call    PRINTHL
    1452   00:47B3  E1                      pop hl
    1453   00:47B4                          ; Print AP name
    1454   00:47B4  E5                      push    hl
    1455   00:47B5  CD 5E 4C                call    PRINTHLINE              ; Print AP Name
    1456   00:47B8  E1                      pop hl
    1457   00:47B9                          ; HL has the address of our data, BC the data size, so it is just needed to send the command
    1458   00:47B9                          CLEAR_UART
    1458   00:47B9  3E 14             >     ld  a,20
    1458   00:47BB  D3 06             >     out (OUT_CMD_PORT),a
    1459   00:47BD  3E 41                   ld  a,CMD_WIFI_CONNECT
    1460   00:47BF                          SEND_DATA
    1460   00:47BF  D3 07             >     out (OUT_TX_PORT),a
    1461   00:47C1  78                      ld  a,b                         ; Size MSB is in B
    1462   00:47C2                          SEND_DATA
    1462   00:47C2  D3 07             >     out (OUT_TX_PORT),a
    1463   00:47C4  79                      ld  a,c                         ; Size LSB is in c
    1464   00:47C5                          SEND_DATA
    1464   00:47C5  D3 07             >     out (OUT_TX_PORT),a
    1465   00:47C7                      WIFI_CONNECT_SENDCMDLP:
    1466   00:47C7  7E                      ld  a,(hl)
    1467   00:47C8                          SEND_DATA
    1467   00:47C8  D3 07             >     out (OUT_TX_PORT),a
    1468   00:47CA  23                      inc hl
    1469   00:47CB  0B                      dec bc
    1470   00:47CC  78                      ld  a,b
    1471   00:47CD  B1                      or  c
    1472   00:47CE  C2 C7 47                jp  nz,WIFI_CONNECT_SENDCMDLP
    1473   00:47D1  21 58 02                ld  hl,600                      ; Wait Up To 10s
    1474   00:47D4  3E 41                   ld  a,CMD_WIFI_CONNECT          ; Our command
    1475   00:47D6  CD 07 4B                call    WAIT_MENU_QCMD_RESPONSE
    1476   00:47D9  CA E5 47                jp  z,WIFI_CONNECT_FAIL
    1477   00:47DC  21 3F 6E                ld  hl,STR_SENDING_OK_JN        ; Success
    1478   00:47DF  CD 54 4C                call    PRINTHL
    1479   00:47E2  C3 E3 49                jp  WAIT_2S_AND_THEN_MAINMENU
    1480   00:47E5                      WIFI_CONNECT_FAIL:
    1481   00:47E5  21 61 6E                ld  hl,STR_SENDING_NOK_JN       ; Failure
    1482   00:47E8  CD 54 4C                call    PRINTHL
    1483   00:47EB  C3 DF 49                jp  WAIT_4S_AND_THEN_MAINMENU
    1484   00:47EE                      
    1485   00:47EE                      INPUT_WFSAP_BAD_INPUT:
    1486   00:47EE  C5                      push    bc
    1487   00:47EF  D5                      push    de
    1488   00:47F0  F5                      push    af
    1489   00:47F1  E5                      push    hl
    1490   00:47F2  DD E5                   push    ix
    1491   00:47F4  FD E5                   push    iy
    1492   00:47F6  CD C0 00                call    BEEP                    ; Wrong Input, beep
    1493   00:47F9  FD E1                   pop iy
    1494   00:47FB  DD E1                   pop ix
    1495   00:47FD  E1                      pop hl
    1496   00:47FE  F1                      pop af
    1497   00:47FF  D1                      pop de
    1498   00:4800  C1                      pop bc
    1499   00:4801  C3 31 46                jp WIFI_SELECT_AP               ; Return
    1500   00:4804                      
    1501   00:4804                      WIFI_SCAN_NONETWORKS:
    1502   00:4804  21 4D 69                ld  hl,MMENU_SCANN
    1503   00:4807  CD 54 4C                call    PRINTHL
    1504   00:480A  C3 DF 49                jp  WAIT_4S_AND_THEN_MAINMENU
    1505   00:480D                      
    1506   00:480D                      WIFI_SCAN_TIMEOUT:
    1507   00:480D  21 2D 69                ld  hl,MMENU_SCANF
    1508   00:4810  CD 54 4C                call    PRINTHL
    1509   00:4813  C3 DF 49                jp  WAIT_4S_AND_THEN_MAINMENU
    1510   00:4816                      
    1511   00:4816                      SET_WIFI_TIMEOUT:
    1512   00:4816  3E 32                   ld  a,'2'
    1513   00:4818  CD A2 00                call    CHPUT
    1514   00:481B  CD EB 49                call    WAIT_250MS_AND_THEN_CONTINUE
    1515   00:481E  21 10 6B                ld  hl,MMENU_TIMEOUT
    1516   00:4821  CD 54 4C                call    PRINTHL                 ; Print Main Timeout message
    1517   00:4824  CD 58 4A                call    CHECKTIMEOUT            ; TimeOut is on or off?
    1518   00:4827  CA 3F 48                jp  z,WIFI_SET_ALWAYS_ON        ; If 0, always on
    1519   00:482A                          ; Otherwise there is a timeout
    1520   00:482A  E5                      push    hl
    1521   00:482B  21 47 6C                ld hl,MMENU_TIMEOUT_NOTALWAYSON1
    1522   00:482E  CD 54 4C                call    PRINTHL
    1523   00:4831  E1                      pop hl
    1524   00:4832  CD 54 4C                call    PRINTHL
    1525   00:4835  21 5D 6C                ld hl,MMENU_TIMEOUT_NOTALWAYSON2
    1526   00:4838  CD 54 4C                call    PRINTHL
    1527   00:483B  16 00                   ld  d,0                         ; Count digits
    1528   00:483D  18 10                   jr  INPUT_TIMEOUT
    1529   00:483F                      WIFI_SET_ALWAYS_ON:
    1530   00:483F  21 F2 6B                ld  hl,MMENU_TIMEOUT_ALWAYSON
    1531   00:4842  CD 54 4C                call    PRINTHL
    1532   00:4845  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1533   00:4849  DD 6B                   ld  ixl,e
    1534   00:484B  DD 62                   ld  ixh,d                       ; Address in IX
    1535   00:484D  16 00                   ld  d,0                         ; Count digits
    1536   00:484F                      INPUT_TIMEOUT:
    1537   00:484F  CD 9F 00                call    CHGET
    1538   00:4852  FE 1B                   cp  #1b                         ; ESC?
    1539   00:4854  CA 4F 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1540   00:4857  FE 0D                   cp  #0d                         ; ENTER?
    1541   00:4859  CA 9D 48                jp  z,SET_WIFI_CHECK_INPUT      ; Check if ok
    1542   00:485C  FE 08                   cp  #08                         ; Backspace?
    1543   00:485E  CA 83 48                jp  z,SET_WIFI_BS_INPUT         ; Check if there is something to erase
    1544   00:4861  FE 30                   cp  '0'                         ; Check if A is less than 0
    1545   00:4863  DA 7D 48                jp  c,INPUT_TIMEOUT_BAD_INPUT   ; if it is, ignore
    1546   00:4866  FE 3A                   cp  '9'+1                       ; Check if a is greater than  9
    1547   00:4868  D2 7D 48                jp  nc,INPUT_TIMEOUT_BAD_INPUT  ; If it is, ignore
    1548   00:486B  DD 77 00                ld  (ix+0),a                    ; Save it
    1549   00:486E  CD A2 00                call    CHPUT                   ; It is valid, so print it
    1550   00:4871  14                      inc d                           ; Increment digit count
    1551   00:4872  DD 23                   inc ix                          ; Increment pointer
    1552   00:4874  3E 03                   ld  a,3
    1553   00:4876  BA                      cp  d
    1554   00:4877  CA 9D 48                jp  z,SET_WIFI_CHECK_INPUT      ; All we can do is accept up to 3 digits, check if ok
    1555   00:487A  C3 4F 48                jp  INPUT_TIMEOUT               ; Not done yet, so continue
    1556   00:487D                      
    1557   00:487D                      INPUT_TIMEOUT_BAD_INPUT:
    1558   00:487D  CD C0 00                call    BEEP                    ; Wrong Input, beep
    1559   00:4880  C3 4F 48                jp INPUT_TIMEOUT                ; Return
    1560   00:4883                      
    1561   00:4883                      SET_WIFI_BS_INPUT:
    1562   00:4883  AF                      xor a
    1563   00:4884  B2                      or  d                           ; Counter has any digit?
    1564   00:4885  CA 4F 48                jp  z,INPUT_TIMEOUT             ; Nope, so just continue
    1565   00:4888  15                      dec d                           ; Decrement counter
    1566   00:4889  DD 2B                   dec ix                          ; Decrement pointer
    1567   00:488B  3E 08                   ld  a,8                         ; Backspace
    1568   00:488D  CD A2 00                call    CHPUT                   ; Print it
    1569   00:4890  3E 20                   ld  a,' '                       ; Space
    1570   00:4892  CD A2 00                call    CHPUT                   ; Print it
    1571   00:4895  3E 08                   ld  a,8                         ; Backspace
    1572   00:4897  CD A2 00                call    CHPUT                   ; Print it
    1573   00:489A  C3 4F 48                jp  INPUT_TIMEOUT               ; Return
    1574   00:489D                      
    1575   00:489D                      SET_WIFI_CHECK_INPUT:
    1576   00:489D  AF                      xor a
    1577   00:489E  B2                      or  d                           ; Counter has any digits
    1578   00:489F  CA 4F 48                jp  z,INPUT_TIMEOUT             ; Nope, so just continue
    1579   00:48A2                          ; IX is pointing one position after last digit, so revert
    1580   00:48A2  DD 2B                   dec ix
    1581   00:48A4  DD 7E 00                ld  a,(ix+0)                    ; Digit in A
    1582   00:48A7  D6 30                   sub '0'                         ; Convert it to decimal
    1583   00:48A9  26 00                   ld  h,0                         ; First digit, so H is 0
    1584   00:48AB  6F                      ld  l,a                         ; And L has the digit
    1585   00:48AC  15                      dec d                           ; If digits finished, just set
    1586   00:48AD  CA D9 48                jp  z,SET_WIFI_EXECUTE_SET_COMMAND
    1587   00:48B0  DD 2B                   dec ix
    1588   00:48B2  DD 7E 00                ld  a,(ix+0)                    ; Digit in A
    1589   00:48B5  D6 30                   sub '0'                         ; Convert it to decimal
    1590   00:48B7  87                      add a,a                         ; A*2
    1591   00:48B8  4F                      ld  c,a                         ; A*2 in C
    1592   00:48B9  87                      add a,a                         ; A*4
    1593   00:48BA  87                      add a,a                         ; A*8
    1594   00:48BB  81                      add a,c                         ; A*10
    1595   00:48BC                          ; Up to here, we can get 90 + 9, 99, won't go to H anyway, just add to L
    1596   00:48BC  85                      add a,l                         ; L has the first digit
    1597   00:48BD  6F                      ld  l,a                         ; And now L has the two digits
    1598   00:48BE  15                      dec d                           ; If digits finished, just set
    1599   00:48BF  CA D9 48                jp  z,SET_WIFI_EXECUTE_SET_COMMAND
    1600   00:48C2  DD 2B                   dec ix
    1601   00:48C4  DD 7E 00                ld  a,(ix+0)                    ; Digit in A
    1602   00:48C7  D6 30                   sub '0'                         ; Convert it to decimal
    1603   00:48C9  87                      add a,a                         ; A*2
    1604   00:48CA  4F                      ld  c,a                         ; A*2 in C
    1605   00:48CB  87                      add a,a                         ; A*4
    1606   00:48CC  87                      add a,a                         ; A*8
    1607   00:48CD  81                      add a,c                         ; A*10
    1608   00:48CE  EB                      ex  de,hl                       ; Get the two digits results in de
    1609   00:48CF  6F                      ld  l,a
    1610   00:48D0  26 00                   ld  h,0                         ; HL = A*10
    1611   00:48D2  29                      add hl,hl                       ; HL = A*20
    1612   00:48D3  4D                      ld  c,l
    1613   00:48D4  44                      ld  b,h                         ; BC = A*20
    1614   00:48D5  29                      add hl,hl                       ; HL = A*40
    1615   00:48D6  29                      add hl,hl                       ; HL = A*80
    1616   00:48D7  09                      add hl,bc                       ; HL = A*100
    1617   00:48D8  19                      add hl,de                       ; HL = three digits result
    1618   00:48D9                          ; This was the last digit, up to three
    1619   00:48D9                      SET_WIFI_EXECUTE_SET_COMMAND:
    1620   00:48D9  C3 2B 49                jp  SET_ESP_WIFI_TIMEOUT        ; And set and done
    1621   00:48DC                      
