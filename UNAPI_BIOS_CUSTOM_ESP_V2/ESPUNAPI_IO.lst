    4352   00:55E3  CB 47             >     bit 0,a
    4353   00:55E5  20 05                   jr  nz,SSH_OPEN_ST2.1
    4354   00:55E7  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4355   00:55EA  18 F5                   jr  SSH_OPEN_ST2
    4356   00:55EC                      SSH_OPEN_ST2.1:
    4357   00:55EC                          ; nz, discard
    4358   00:55EC                          RECEIVE_DATA
    4358   00:55EC  DB 06             >     in a,(IN_DATA_PORT)
    4359   00:55EE  05                      dec b
    4360   00:55EF  20 F0                   jr  nz,SSH_OPEN_ST2
    4361   00:55F1                      
    4362   00:55F1                          ; now just get the 1 byte, conn#, should go to B
    4363   00:55F1                      SSH_OPEN_CONN_ST1:
    4364   00:55F1                          CHECK_DATA
    4364   00:55F1  DB 07             >     in  a,(IN_STS_PORT)
    4364   00:55F3  CB 47             >     bit 0,a
    4365   00:55F5  20 05                   jr  nz,SSH_OPEN_CONN_ST1.1
    4366   00:55F7  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4367   00:55FA  18 F5                   jr  SSH_OPEN_CONN_ST1
    4368   00:55FC                      SSH_OPEN_CONN_ST1.1:
    4369   00:55FC                          ; nz, get it
    4370   00:55FC                          RECEIVE_DATA
    4370   00:55FC  DB 06             >     in a,(IN_DATA_PORT)
    4371   00:55FE  47                      ld  b,a
    4372   00:55FF                          ; done
    4373   00:55FF  AF                      xor a
    4374   00:5600  C9                      ret
    4375   00:5601                      
    4376   00:5601                      SSH_OPEN_HOSTHASH:
    4377   00:5601                          ; HL has memory area to write host fingerprint / hash
    4378   00:5601                          ; we will receive size, should be 33, 1 byte for connection ID
    4379   00:5601                          ; 32 bytes for fingerprint / hash
    4380   00:5601                          CHECK_DATA
    4380   00:5601  DB 07             >     in  a,(IN_STS_PORT)
    4380   00:5603  CB 47             >     bit 0,a
    4381   00:5605  20 05                   jr  nz,SSH_OPEN_HOSTHASH.1
    4382   00:5607  CD 9D 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    4383   00:560A  18 F5                   jr  SSH_OPEN_HOSTHASH
    4384   00:560C                      SSH_OPEN_HOSTHASH.1:
    4385   00:560C                          ; nz, high byte count of bytes to receive
    4386   00:560C                          RECEIVE_DATA
    4386   00:560C  DB 06             >     in a,(IN_DATA_PORT)
    4387   00:560E  67                      ld h,a
    4388   00:560F                      SSH_OPEN_HOSTHASHB:
    4389   00:560F                          CHECK_DATA
    4389   00:560F  DB 07             >     in  a,(IN_STS_PORT)
    4389   00:5611  CB 47             >     bit 0,a
    4390   00:5613  20 05                   jr  nz,SSH_OPEN_HOSTHASHB.1
    4391   00:5615  CD 9D 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    4392   00:5618  18 F5                   jr  SSH_OPEN_HOSTHASHB
    4393   00:561A                      SSH_OPEN_HOSTHASHB.1:
    4394   00:561A                          ; nz, low byte count of bytes to receive
    4395   00:561A                          RECEIVE_DATA
    4395   00:561A  DB 06             >     in a,(IN_DATA_PORT)
    4396   00:561C  6F                      ld  l,a
    4397   00:561D  B4                      or  h
    4398   00:561E                          ; if it was 0, no data
    4399   00:561E                          if USE_MEM_IO = 1
    4400   00:561E                    ~     jp  z,TCPIP_TCP_RCV_RET_NODATA  ; not a typo, no need to make the same code again
    4401   00:561E                    ~     else
    4402   00:561E  CA D2 5C                jp  z,TCPIP_TCP_RCV_RET_NODATA  ; not a typo, no need to make the same code again
    4403   00:5621                          endif
    4404   00:5621  2B                      dec hl                          ; decrement one byte, first is connection will go to B
    4405   00:5622                          ; Now get connection number and save it 
    4406   00:5622                      SSH_OPEN_HOSTHASH_CONN:
    4407   00:5622                          CHECK_DATA
    4407   00:5622  DB 07             >     in  a,(IN_STS_PORT)
    4407   00:5624  CB 47             >     bit 0,a
    4408   00:5626  20 05                   jr  nz,SSH_OPEN_HOSTHASH_CONN.1
    4409   00:5628  CD 9D 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    4410   00:562B  18 F5                   jr  SSH_OPEN_HOSTHASH_CONN
    4411   00:562D                      SSH_OPEN_HOSTHASH_CONN.1:
    4412   00:562D                          ; nz, connection number
    4413   00:562D                          RECEIVE_DATA
    4413   00:562D  DB 06             >     in a,(IN_DATA_PORT)
    4414   00:562F  47                      ld b,a
    4415   00:5630  C5                      push    bc                      ; save it
    4416   00:5631                      
    4417   00:5631  4D                      ld  c,l
    4418   00:5632  44                      ld  b,h                         ; BC has effective received data size, as well as HL
    4419   00:5633                      
    4420   00:5633                          ; put effective data size in de
    4421   00:5633  EB                      ex  de,hl
    4422   00:5634                          ; address was in de, now in HL, BC effective received size
    4423   00:5634                      
    4424   00:5634                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use ini :-D
    4425   00:5634  43                      ld  b,e                         ; Number of loops originaly in DE
    4426   00:5635  1B                      dec de
    4427   00:5636  14                      inc d
    4428   00:5637                          if USE_MEM_IO = 0
    4429   00:5637  0E 06                   ld  c,IN_DATA_PORT
    4430   00:5639                          endif
    4431   00:5639                      SSH_OPEN_HOSTHASH_NSF:
    4432   00:5639                          CHECK_DATA
    4432   00:5639  DB 07             >     in  a,(IN_STS_PORT)
    4432   00:563B  CB 47             >     bit 0,a
    4433   00:563D  20 05                   jr  nz,SSH_OPEN_HOSTHASH_NSF.1
    4434   00:563F  CD 9D 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    4435   00:5642  18 F5                   jr  SSH_OPEN_HOSTHASH_NSF
    4436   00:5644                      SSH_OPEN_HOSTHASH_NSF.1:
    4437   00:5644                          if USE_MEM_IO = 0
    4438   00:5644  ED A2                   ini
    4439   00:5646                          else
    4440   00:5646                    ~     ld  a,(MEM_IN_DATA_PORT)
    4441   00:5646                    ~     ld  (hl),a
    4442   00:5646                    ~     inc hl
    4443   00:5646                    ~     dec b
    4444   00:5646                    ~     endif
    4445   00:5646  20 F1                   jr  nz,SSH_OPEN_HOSTHASH_NSF
    4446   00:5648  15                      dec d
    4447   00:5649  20 EE                   jr nz,SSH_OPEN_HOSTHASH_NSF
    4448   00:564B                          ; restore BC to get conn # in B
    4449   00:564B  C1                      pop bc
    4450   00:564C                          ; if we are here, return code is 132, unknown host
    4451   00:564C  3E 84                   ld  a,132
    4452   00:564E  C9                      ret
    4453   00:564F                      
    4454   00:564F                      ;==========================
    4455   00:564F                      ;=== SSH_ADD_KNOWN_HOST ===
    4456   00:564F                      ;==========================
    4457   00:564F                      ;Add an unknown host whose connection we tried to open as known
    4458   00:564F                      ;
    4459   00:564F                      ;Input:  A = 11
    4460   00:564F                      ;        B = Connection number
    4461   00:564F                      ;Output: A = Error code
    4462   00:564F                      
    4463   00:564F                      SSH_ADD_KNOWN_HOST:
    4464   00:564F  CB FF                   set 7,a                         ; ESP SSH commands start at #80
    4465   00:5651                          SEND_DATA                       ; Send the command
    4465   00:5651  D3 07             >     out (OUT_TX_PORT),a
    4466   00:5653  AF                      xor a
    4467   00:5654                          SEND_DATA                       ; Send the command size msb
    4467   00:5654  D3 07             >     out (OUT_TX_PORT),a
    4468   00:5656  3E 01                   ld  a,1
    4469   00:5658                          SEND_DATA                       ; Send the command size lsb
    4469   00:5658  D3 07             >     out (OUT_TX_PORT),a
    4470   00:565A  78                      ld  a,b
    4471   00:565B                          SEND_DATA                       ; Send the connection #
    4471   00:565B  D3 07             >     out (OUT_TX_PORT),a
    4472   00:565D                          ; Now wait up to 180 ticks to get response
    4473   00:565D  21 B4 00                ld  hl,180
    4474   00:5660  CD DF 60                call    SETCOUNTER
    4475   00:5663                      SSH_ADD_KNOWN_HOST_ST1:
    4476   00:5663                          CHECK_DATA
