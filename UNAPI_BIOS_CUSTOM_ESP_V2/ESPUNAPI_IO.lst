    4247   00:5583                      ;========================
    4248   00:5583                      ;===     SSH_OPEN     ===
    4249   00:5583                      ;========================
    4250   00:5583                      ;Open a SSH connection.
    4251   00:5583                      ;
    4252   00:5583                      ;Input:  A  = 2
    4253   00:5583                      ;        HL = Address of parameters block
    4254   00:5583                      ;Output: A = Error code
    4255   00:5583                      ;        B = Connection number
    4256   00:5583                      ;
    4257   00:5583                      ;Parameters block format:
    4258   00:5583                      ;
    4259   00:5583                      ;+0 (4): Remote IP address (0.0.0.0 for unspecified remote socket)
    4260   00:5583                      ;+4 (2): Remote port (ignored if unspecified remote socket)
    4261   00:5583                      ;+6 (1): Subsystem
    4262   00:5583                      ;+7 (1): Flags
    4263   00:5583                      ;+8 (variable): username (0 terminated) and then password or public key (0 terminated)
    4264   00:5583                      ;
    4265   00:5583                      ;Parameter block MUST have at least 32 bytes available if doing host key verification
    4266   00:5583                      ;as unknown host key hash will be returned in it
    4267   00:5583                      
    4268   00:5583                      SSH_OPEN:
    4269   00:5583  E5                      push    hl                      ; save param block address
    4270   00:5584  3E 08                   ld  a,8
    4271   00:5586  85                      add a,l
    4272   00:5587  6F                      ld  l,a
    4273   00:5588  30 01                   jr  nc,SSH_OPEN_1
    4274   00:558A  24                      inc h
    4275   00:558B                      SSH_OPEN_1:
    4276   00:558B                          ; let's check how many bytes there are
    4277   00:558B  11 08 00                ld  de,8                        ; Start with 8, all params except username and password
    4278   00:558E                      SSH_OPEN_CHECK_USER:
    4279   00:558E  7E                      ld  a,(hl)
    4280   00:558F  13                      inc de                          ; Increase size count
    4281   00:5590  23                      inc hl                          ; And next byte
    4282   00:5591  B7                      or  a                           ; If zero, user terminated
    4283   00:5592                          ; Loop until terminator (0) is found
    4284   00:5592  C2 8E 55                jp  nz,SSH_OPEN_CHECK_USER
    4285   00:5595                      SSH_OPEN_CHECK_PASS:
    4286   00:5595  7E                      ld  a,(hl)
    4287   00:5596  13                      inc de                          ; Increase size count
    4288   00:5597  23                      inc hl                          ; And next byte
    4289   00:5598  B7                      or  a                           ; If zero, password terminated
    4290   00:5599                          ; Loop until terminator (0) is found
    4291   00:5599  C2 95 55                jp  nz,SSH_OPEN_CHECK_PASS
    4292   00:559C                      
    4293   00:559C                      SSH_OPEN_SENDCMD:
    4294   00:559C                          ; Ok, so, DE has the full data size, let's start sending from here
    4295   00:559C  3E 82                   ld  a,#82                       ; Function SSH OPEN
    4296   00:559E                          SEND_DATA                       ; Send the command
    4296   00:559E  D3 07             >     out (OUT_TX_PORT),a
    4297   00:55A0  7A                      ld  a,d
    4298   00:55A1                          SEND_DATA                       ; Send the command size msb
    4298   00:55A1  D3 07             >     out (OUT_TX_PORT),a
    4299   00:55A3  7B                      ld  a,e
    4300   00:55A4                          SEND_DATA                       ; Send the command size lsb
    4300   00:55A4  D3 07             >     out (OUT_TX_PORT),a
    4301   00:55A6  E1                      pop hl                          ; Restore the memory address for the parameters
    4302   00:55A7  E5                      push    hl                      ; we might need it later
    4303   00:55A8                      ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    4304   00:55A8  43                      ld  b,e                         ; Number of loops originaly in DE
    4305   00:55A9  1B                      dec de
    4306   00:55AA  14                      inc d
    4307   00:55AB                          if USE_MEM_IO = 0
    4308   00:55AB  0E 07                   ld  c,OUT_TX_PORT
    4309   00:55AD                      SSH_OPEN_SENDDATA:
    4310   00:55AD  ED A3                   outi
    4311   00:55AF  20 FC                   jr  nz,SSH_OPEN_SENDDATA
    4312   00:55B1                          else
    4313   00:55B1                    ~ SSH_OPEN_SENDDATA:
    4314   00:55B1                    ~     ld  a,(hl)
    4315   00:55B1                    ~     ld  (MEM_OUT_TX_PORT),a
    4316   00:55B1                    ~     inc hl
    4317   00:55B1                    ~     djnz SSH_OPEN_SENDDATA
    4318   00:55B1                    ~     endif
    4319   00:55B1  15                      dec d
    4320   00:55B2  20 F9                   jr  nz,SSH_OPEN_SENDDATA
    4321   00:55B4                          ; Now wait up to 3600 (1 minute @ 60Hz) ticks to get response
    4322   00:55B4  21 10 0E                ld  hl,3600
    4323   00:55B7  CD DF 60                call    SETCOUNTER
    4324   00:55BA                      SSH_OPEN_ST1:
    4325   00:55BA                          CHECK_DATA
    4325   00:55BA  DB 07             >     in  a,(IN_STS_PORT)
    4325   00:55BC  CB 47             >     bit 0,a
    4326   00:55BE  20 05                   jr  nz,SSH_OPEN_ST1.1
    4327   00:55C0  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4328   00:55C3  18 F5                   jr  SSH_OPEN_ST1
    4329   00:55C5                      SSH_OPEN_ST1.1:
    4330   00:55C5                          ; nz, check the data
    4331   00:55C5                          RECEIVE_DATA
    4331   00:55C5  DB 06             >     in a,(IN_DATA_PORT)
    4332   00:55C7  FE 82                   cp  #82                         ; Is response of our command?
    4333   00:55C9  20 EF                   jr  nz,SSH_OPEN_ST1
    4334   00:55CB                          ; now get return code, if return code other than 0, it is finished
    4335   00:55CB                      SSH_OPEN_RC:
    4336   00:55CB                          CHECK_DATA
    4336   00:55CB  DB 07             >     in  a,(IN_STS_PORT)
    4336   00:55CD  CB 47             >     bit 0,a
    4337   00:55CF  20 05                   jr  nz,SSH_OPEN_RC.1
    4338   00:55D1  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4339   00:55D4  18 F5                   jr  SSH_OPEN_RC
    4340   00:55D6                      SSH_OPEN_RC.1:
    4341   00:55D6                          ; nz, discard
    4342   00:55D6                          RECEIVE_DATA
    4342   00:55D6  DB 06             >     in a,(IN_DATA_PORT)
    4343   00:55D8  D1                      pop de                          ; restore memory area address in DE just in case it is needed
    4344   00:55D9  FE 84                   cp  132
    4345   00:55DB  28 24                   jr  z,SSH_OPEN_HOSTHASH
    4346   00:55DD  B7                      or  a                           ; 0?
    4347   00:55DE  C0                      ret nz
    4348   00:55DF                      
    4349   00:55DF                          ; next two bytes are size bytes, don't care, it is 1, conn #
    4350   00:55DF  06 02                   ld  b,2
    4351   00:55E1                      SSH_OPEN_ST2:
    4352   00:55E1                          CHECK_DATA
