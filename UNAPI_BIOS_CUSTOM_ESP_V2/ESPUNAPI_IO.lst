    4985   00:58FB  D1                      pop de
    4986   00:58FC                          ; now oti the data starting at hl, size is in DE
    4987   00:58FC                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    4988   00:58FC  43                      ld  b,e                         ;Number of loops originaly in DE
    4989   00:58FD  1B                      dec de
    4990   00:58FE  14                      inc d
