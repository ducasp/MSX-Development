    2221   00:4C88                      ;===============================
    2222   00:4C88                      ;===  HTIM_I hook execution  ===
    2223   00:4C88                      ;===============================
    2224   00:4C88                      DO_HTIMI:
    2225   00:4C88  F5                      push    af                      ; HTIM hook -> need to keep A value
    2226   00:4C89  CD B1 5C                call    GETCOUNTER              ; Counter in hl
    2227   00:4C8C  7D                      ld  a,l
    2228   00:4C8D  B4                      or  h                           ; In this operation, check if HL is 0
    2229   00:4C8E  28 04                   jr  z,DO_HTIMI_END              ; If it is, nothing to do
    2230   00:4C90  2B                      dec hl                          ; Otherwise decrement it
    2231   00:4C91  CD C0 5C                call    SETCOUNTER              ; And save it
    2232   00:4C94                      DO_HTIMI_END:
    2233   00:4C94  CD 20 5C                call    GETSLT
    2234   00:4C97                          ; Slot in A, now get the address of our counter
    2235   00:4C97  CD A9 5C                call    GETMEMPOINTER
    2236   00:4C9A                          ; HL has the address of our memory area, and there is where we should jump
    2237   00:4C9A  F1                      pop af                          ; Restore original A value
    2238   00:4C9B  E9                      jp  (hl)
    2239   00:4C9C                      
    2240   00:4C9C                      ;===============================
    2241   00:4C9C                      ;===  EXTBIO hook execution  ===
    2242   00:4C9C                      ;===============================
    2243   00:4C9C                      DO_EXTBIO:
    2244   00:4C9C  E5                      push    hl
    2245   00:4C9D  C5                      push    bc
    2246   00:4C9E  F5                      push    af
    2247   00:4C9F  7A                      ld  a,d
    2248   00:4CA0  FE 22                   cp  #22
    2249   00:4CA2  C2 30 4D                jp  nz,JUMP_OLD
