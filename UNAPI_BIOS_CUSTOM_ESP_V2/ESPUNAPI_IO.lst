    3914   00:541F  CB 67             >     bit 4,a
    3915   00:5421  C2 2D 53                jp  nz,TCPIP_TCP_UDP_RETRY_QRCV ; If yes, retry
    3916   00:5424                          ; Otherwise, done
    3917   00:5424                          ; done, restore return data in DE BC and HL
    3918   00:5424  CD 52 5F                call    REGRESTORE
    3919   00:5427  AF                      xor a
    3920   00:5428  C9                      ret
    3921   00:5429                          ; Slower route if Interface doesn't implement quick receive
    3922   00:5429                      TCPIP_UDP_RCV_R_NSF:
