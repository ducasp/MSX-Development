    7011   00:61B5                          ; Slot in A, now get the address
    7012   00:61B5  CD C8 60                call    GETMEMPOINTER
    7013   00:61B8                          ; HL has the address of our memory area, byte param is 7 bytes after start
    7014   00:61B8  11 11 00                ld  de,MEMORY_HLBACKUP_OFFSET
    7015   00:61BB  19                      add hl,de
    7016   00:61BC                          ; HL has the address of param
    7017   00:61BC  D1                      pop de                          ; Restore HL in de
    7018   00:61BD  73                      ld  (hl),e
    7019   00:61BE  23                      inc hl
    7020   00:61BF  72                      ld  (hl),d
    7021   00:61C0  EB                      ex  de,hl                       ; Restore HL
    7022   00:61C1  C1                      pop bc                          ; Restore BC
    7023   00:61C2  D1                      pop de                          ; Restore DE
    7024   00:61C3  C9                      ret
    7025   00:61C4                      
    7026   00:61C4                      ;--- Return the saved ESP TYPE
    7027   00:61C4                      ;    Input:  none
    7028   00:61C4                      ;    Output: A and F will be NZ if ESP32
    7029   00:61C4                      ;    Modifies: AF
    7030   00:61C4                      
    7031   00:61C4                      GETESPTYPE:
    7032   00:61C4  D5                      push    de
    7033   00:61C5  C5                      push    bc
    7034   00:61C6  E5                      push    hl
    7035   00:61C7  DD E5                   push    ix
    7036   00:61C9  FD E5                   push    iy
    7037   00:61CB  CD 3F 60                call    GETSLT
    7038   00:61CE  CD AC 60                call    GETMEMPOINTERADDR       ; This is where we are going to store our memory area address
    7039   00:61D1                          ; GETSLT and GETMEMPOINTER do not change DE, so it still has the our memory area address
    7040   00:61D1  11 07 00                ld  de,7
    7041   00:61D4  19                      add hl,de
    7042   00:61D5  7E                      ld  a,(hl)
    7043   00:61D6  B7                      or  a
    7044   00:61D7  FD E1                   pop iy
    7045   00:61D9  DD E1                   pop ix
    7046   00:61DB  E1                      pop hl
