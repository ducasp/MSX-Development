    3996   00:5460  18 F5                   jr  TCPIP_TCP_OPEN_ERROR3
    3997   00:5462                      TCPIP_TCP_OPEN_ERROR3.1:
    3998   00:5462                          ; nz, get it
    3999   00:5462                          RECEIVE_DATA
    3999   00:5462  DB 06             >     in a,(IN_DATA_PORT)
    4000   00:5464  4F                      ld  c,a
    4001   00:5465                      TCPIP_TCP_OPEN_ERROR4:
    4002   00:5465                          ; now return w/ error that is saved in b
    4003   00:5465  78                      ld  a,b
    4004   00:5466  06 00                   ld  b,0                         ; no connection, so 0
    4005   00:5468  C9                      ret
    4006   00:5469                      
    4007   00:5469                      TCPIP_TCP_OPEN:
    4008   00:5469  E5                      push    hl                      ; save param block address
    4009   00:546A  7C                      ld  a,h
    4010   00:546B  DD 67                   ld  ixh,a
    4011   00:546D  7D                      ld  a,l
    4012   00:546E  DD 6F                   ld  ixl,a
    4013   00:5470                          ; IX now has the parameters area
    4014   00:5470                          ; most times it will be non tls, so this is the first test case
    4015   00:5470  21 0B 00                ld  hl,11
    4016   00:5473  CD 28 61                call    SETWORD                 ; If it is non-TLS, send 11 bytes
    4017   00:5476  DD 7E 0A                ld  a,(ix+10)                   ; TCP_OPEN_CMD_FLAGS
    4018   00:5479  CB 57                   bit 2,a
    4019   00:547B  28 5A                   jr  z,TCPIP_TCP_OPEN_NO_TLS
    4020   00:547D                      
    4021   00:547D                          ; TLS, but, do we have host name?
    4022   00:547D  21 0C 00                ld  hl,12
    4023   00:5480  CD 28 61                call    SETWORD                 ; If it is TLS without host name, send 12 bytes, one zero as host name suffice
    4024   00:5483  DD 6E 0B                ld  l,(ix+11)                   ; TCP_OPEN_CMD_HOST_LSB
    4025   00:5486  DD 7E 0C                ld  a,(ix+12)                   ; TCP_OPEN_CMD_HOST_MSB
    4026   00:5489  B5                      or  l
    4027   00:548A                          ; if TLS and next two bytes are 00 no host to check
    4028   00:548A  28 4B                   jr  z,TCPIP_TCP_OPEN_NO_CHECKHOST
    4029   00:548C                          ; we are here, host to check
    4030   00:548C  DD 66 0C                ld  h,(ix+12)                   ; TCP_OPEN_CMD_HOST_MSB
    4031   00:548F  D1                      pop de                          ; Retrieve parameters address
    4032   00:5490  E5                      push    hl                      ; Save host name address
    4033   00:5491  D5                      push    de                      ; Save Parameters address (so it is in the order we are going to need)
    4034   00:5492                          ; let's check how many bytes there are
    4035   00:5492  11 0B 00                ld  de,11                       ; Start with 11, all params except host name
    4036   00:5495                      TCPIP_TCP_OPEN_CHECK_HOSTOF:
    4037   00:5495  7E                      ld  a,(hl)
    4038   00:5496  13                      inc de                          ; Not zero, so increase size count
    4039   00:5497  23                      inc hl                          ; And next hostname byte
    4040   00:5498  B7                      or  a                           ; If zero, hostname terminated
    4041   00:5499                          ; Loop until terminator (0) is found
    4042   00:5499  C2 95 54                jp  nz,TCPIP_TCP_OPEN_CHECK_HOSTOF
    4043   00:549C                      
    4044   00:549C                      TCPIP_TCP_OPEN_HOSTNAME_SENDCMDWITHHOSTNAME:
    4045   00:549C                          ; Ok, so, DE has the full hostname size, let's start sending from here
    4046   00:549C  3E 0D                   ld  a,13                        ; Function TCP OPEN
    4047   00:549E                          SEND_DATA                       ; Send the command
    4047   00:549E  D3 07             >     out (OUT_TX_PORT),a
    4048   00:54A0  7A                      ld  a,d
    4049   00:54A1                          SEND_DATA                       ; Send the command size msb
    4049   00:54A1  D3 07             >     out (OUT_TX_PORT),a
    4050   00:54A3  7B                      ld  a,e
    4051   00:54A4                          SEND_DATA                       ; Send the command size lsb
    4051   00:54A4  D3 07             >     out (OUT_TX_PORT),a
    4052   00:54A6  E1                      pop hl                          ; Restore the memory address for the parameters
    4053   00:54A7                          ; First send the 11 bytes parameters
    4054   00:54A7                          if USE_MEM_IO = 0
    4055   00:54A7  0E 07                   ld  c,OUT_TX_PORT
    4056   00:54A9  ED A3                   outi
    4057   00:54AB  ED A3                   outi
    4058   00:54AD  ED A3                   outi
    4059   00:54AF  ED A3                   outi
    4060   00:54B1  ED A3                   outi
    4061   00:54B3  ED A3                   outi
    4062   00:54B5  ED A3                   outi
    4063   00:54B7  ED A3                   outi
    4064   00:54B9  ED A3                   outi
    4065   00:54BB  ED A3                   outi
    4066   00:54BD  ED A3                   outi                            ; Unrolled outi is a bit faster :)
    4067   00:54BF                          else
    4068   00:54BF                    ~     ld  b,11                        ; Send 11 bytes
    4069   00:54BF                    ~ TCPIP_TCP_OPEN_HOSTNAME_SENDCMDWITHHOSTNAME_LOOP_PARAM:
    4070   00:54BF                    ~     ld  a,(hl)
    4071   00:54BF                    ~     ld  (MEM_OUT_TX_PORT),a
    4072   00:54BF                    ~     inc hl
    4073   00:54BF                    ~     djnz TCPIP_TCP_OPEN_HOSTNAME_SENDCMDWITHHOSTNAME_LOOP_PARAM
    4074   00:54BF                    ~     endif
    4075   00:54BF  EB                      ex  de,hl                       ; Size in HL
    4076   00:54C0  11 0B 00                ld  de,11
    4077   00:54C3  B7                      or  a                           ; zero flag
    4078   00:54C4  ED 52                   sbc hl,de
    4079   00:54C6  EB                      ex de,hl                        ; and adjusted size back in de
    4080   00:54C7  E1                      pop hl                          ; Restore the memory address for hostname
    4081   00:54C8                      ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    4082   00:54C8  43                      ld  b,e                         ; Number of loops originaly in DE
    4083   00:54C9  1B                      dec de
    4084   00:54CA  14                      inc d
    4085   00:54CB                          if USE_MEM_IO = 0
    4086   00:54CB  0E 07                   ld  c,OUT_TX_PORT
    4087   00:54CD                      TCPIP_TCP_OPEN_SENDHOSTNAME:
    4088   00:54CD  ED A3                   outi
    4089   00:54CF  20 FC                   jr  nz,TCPIP_TCP_OPEN_SENDHOSTNAME
    4090   00:54D1                          else
    4091   00:54D1                    ~ TCPIP_TCP_OPEN_SENDHOSTNAME:
    4092   00:54D1                    ~     ld  a,(hl)
    4093   00:54D1                    ~     ld  (MEM_OUT_TX_PORT),a
    4094   00:54D1                    ~     inc hl
    4095   00:54D1                    ~     djnz TCPIP_TCP_OPEN_SENDHOSTNAME
    4096   00:54D1                    ~     endif
    4097   00:54D1  15                      dec d
    4098   00:54D2  20 F9                   jr  nz,TCPIP_TCP_OPEN_SENDHOSTNAME
    4099   00:54D4  C3 F3 54                jp  TCPIP_TCP_OPEN_WAIT_RESPONSE
    4100   00:54D7                      
    4101   00:54D7                      TCPIP_TCP_OPEN_NO_TLS:
    4102   00:54D7                      TCPIP_TCP_OPEN_NO_CHECKHOST:
    4103   00:54D7  3E 0D                   ld  a,13                        ; Function TCP OPEN
    4104   00:54D9                          SEND_DATA                       ; Send the command
    4104   00:54D9  D3 07             >     out (OUT_TX_PORT),a
    4105   00:54DB  CD 15 61                call    GETWORD
    4106   00:54DE  7C                      ld  a,h
    4107   00:54DF  57                      ld  d,a
    4108   00:54E0                          SEND_DATA                       ; Send the command size msb
    4108   00:54E0  D3 07             >     out (OUT_TX_PORT),a
    4109   00:54E2  7D                      ld  a,l
    4110   00:54E3  5F                      ld  e,a
    4111   00:54E4                          SEND_DATA                       ; Send the command size lsb
    4111   00:54E4  D3 07             >     out (OUT_TX_PORT),a
    4112   00:54E6                      
    4113   00:54E6  E1                      pop hl                          ; Restore the memory address for the parameters
    4114   00:54E7                      ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    4115   00:54E7  43                      ld  b,e                         ; Number of loops originaly in DE
    4116   00:54E8  1B                      dec de
    4117   00:54E9  14                      inc d
    4118   00:54EA                          if USE_MEM_IO = 0
    4119   00:54EA  0E 07                   ld  c,OUT_TX_PORT
    4120   00:54EC                      TCPIP_TCP_OPEN_R:
    4121   00:54EC  ED A3                   outi
    4122   00:54EE  20 FC                   jr  nz,TCPIP_TCP_OPEN_R
    4123   00:54F0                          else
    4124   00:54F0                    ~ TCPIP_TCP_OPEN_R:
    4125   00:54F0                    ~     ld  a,(hl)
    4126   00:54F0                    ~     ld  (MEM_OUT_TX_PORT),a
    4127   00:54F0                    ~     inc hl
    4128   00:54F0                    ~     djnz TCPIP_TCP_OPEN_R
    4129   00:54F0                    ~     endif
    4130   00:54F0  15                      dec d
    4131   00:54F1  20 F9                   jr  nz,TCPIP_TCP_OPEN_R
    4132   00:54F3                      
    4133   00:54F3                      TCPIP_TCP_OPEN_WAIT_RESPONSE:
    4134   00:54F3                          ; Now wait up to 3600 (1 minute @ 60Hz) ticks to get response
    4135   00:54F3                          ; TLS Connections might take SEVERAL seconds on TLS Handshake
    4136   00:54F3                          ; Even more if certificates database is being indexed
    4137   00:54F3  21 10 0E                ld  hl,3600
    4138   00:54F6  CD DF 60                call    SETCOUNTER
    4139   00:54F9                      TCPIP_TCP_OPEN_ST1:
    4140   00:54F9                          CHECK_DATA
    4140   00:54F9  DB 07             >     in  a,(IN_STS_PORT)
    4140   00:54FB  CB 47             >     bit 0,a
    4141   00:54FD  20 05                   jr  nz,TCPIP_TCP_OPEN_ST1.1
    4142   00:54FF  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4143   00:5502  18 F5                   jr  TCPIP_TCP_OPEN_ST1
    4144   00:5504                      TCPIP_TCP_OPEN_ST1.1:
    4145   00:5504                          ; nz, check the data
    4146   00:5504                          RECEIVE_DATA
    4146   00:5504  DB 06             >     in a,(IN_DATA_PORT)
    4147   00:5506  FE 0D                   cp  13                          ; Is response of our command?
    4148   00:5508  20 EF                   jr  nz,TCPIP_TCP_OPEN_ST1
    4149   00:550A                          ; now get return code, if return code other than 0, it is finished
    4150   00:550A                      TCPIP_TCP_OPEN_RC:
    4151   00:550A                          CHECK_DATA
    4151   00:550A  DB 07             >     in  a,(IN_STS_PORT)
