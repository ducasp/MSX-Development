    3268   00:5139  DB 06             >     in a,(IN_DATA_PORT)
    3269   00:513B  57                      ld  d,a
    3270   00:513C                          ; done
    3271   00:513C  3E 01                   ld  a,1
    3272   00:513E  CD F1 61                call    SETDNSREADY             ; DNS done
    3273   00:5141  CD 1B 62                call    SETDNSRESULT            ; DNS RESULT
    3274   00:5144  06 02                   ld  b,2
    3275   00:5146  AF                      xor a
    3276   00:5147  C9                      ret
