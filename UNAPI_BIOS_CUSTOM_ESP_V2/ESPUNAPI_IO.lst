    3434   00:51D4  3E 01                   ld  a,1
    3435   00:51D6                          SEND_DATA                       ; Send the command size lsb
    3435   00:51D6  D3 07             >     out (OUT_TX_PORT),a
    3436   00:51D8  78                      ld  a,b
    3437   00:51D9                          SEND_DATA                       ; Send the connection #
    3437   00:51D9  D3 07             >     out (OUT_TX_PORT),a
    3438   00:51DB                          ; Now wait up to 180 ticks to get response
    3439   00:51DB  21 B4 00                ld  hl,180
    3440   00:51DE  CD DF 60                call    SETCOUNTER
    3441   00:51E1                      TCPIP_UDP_CLOSE_ST1:
    3442   00:51E1                          CHECK_DATA
    3442   00:51E1  DB 07             >     in  a,(IN_STS_PORT)
    3442   00:51E3  CB 47             >     bit 0,a
    3443   00:51E5  20 05                   jr  nz,TCPIP_UDP_CLOSE_ST1.1
    3444   00:51E7  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3445   00:51EA  18 F5                   jr  TCPIP_UDP_CLOSE_ST1
    3446   00:51EC                      TCPIP_UDP_CLOSE_ST1.1:
    3447   00:51EC                          ; nz, check the data
    3448   00:51EC                          RECEIVE_DATA
    3448   00:51EC  DB 06             >     in a,(IN_DATA_PORT)
    3449   00:51EE  FE 09                   cp  9                           ; Is response of our command?
    3450   00:51F0  20 EF                   jr  nz,TCPIP_UDP_CLOSE_ST1
    3451   00:51F2                          ; now get return code, if return code other than 0, it is finished
    3452   00:51F2                      TCPIP_UDP_CLOSE_RC:
    3453   00:51F2                          CHECK_DATA
    3453   00:51F2  DB 07             >     in  a,(IN_STS_PORT)
    3453   00:51F4  CB 47             >     bit 0,a
    3454   00:51F6  20 05                   jr  nz,TCPIP_UDP_CLOSE_RC.1
    3455   00:51F8  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3456   00:51FB  18 F5                   jr  TCPIP_UDP_CLOSE_RC
    3457   00:51FD                      TCPIP_UDP_CLOSE_RC.1:
    3458   00:51FD                          ; nz, discard
    3459   00:51FD                          RECEIVE_DATA
    3459   00:51FD  DB 06             >     in a,(IN_DATA_PORT)
    3460   00:51FF  B7                      or  a                           ; 0?
    3461   00:5200  C0                      ret nz                          ; if not, done
    3462   00:5201                      
    3463   00:5201                          ; next two bytes are return code and size bytes, don't care, it is 1, conn #
    3464   00:5201  06 02                   ld  b,2
    3465   00:5203                      TCPIP_UDP_CLOSE_ST2:
    3466   00:5203                          CHECK_DATA
    3466   00:5203  DB 07             >     in  a,(IN_STS_PORT)
    3466   00:5205  CB 47             >     bit 0,a
    3467   00:5207  20 05                   jr  nz,TCPIP_UDP_CLOSE_ST2.1
    3468   00:5209  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3469   00:520C  18 F5                   jr  TCPIP_UDP_CLOSE_ST2
    3470   00:520E                      TCPIP_UDP_CLOSE_ST2.1:
    3471   00:520E                          ; nz, discard
    3472   00:520E                          RECEIVE_DATA
    3472   00:520E  DB 06             >     in a,(IN_DATA_PORT)
    3473   00:5210  05                      dec b
    3474   00:5211  20 F0                   jr  nz,TCPIP_UDP_CLOSE_ST2
    3475   00:5213                      
    3476   00:5213                          ; done, no return data other than return code
    3477   00:5213  AF                      xor a
    3478   00:5214  C9                      ret
