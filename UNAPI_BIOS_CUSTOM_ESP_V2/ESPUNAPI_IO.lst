    6675   00:5FD5  20                      db  %00100000
    6676   00:5FD6  70                      db  %01110000
    6677   00:5FD7                      ; Pattern-06 is CHR$(1)+CHR$(86) = Wi-Fi Did not find the AP:
    6678   00:5FD7  00                      db  %00000000
    6679   00:5FD8  70                      db  %01110000
    6680   00:5FD9  88                      db  %10001000
    6681   00:5FDA  10                      db  %00010000                   ; "?"
