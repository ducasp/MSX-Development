    1055   00:4509  20 0E                   jr  nz,CLK_AUTO_GMT_CHK_CSD2
    1056   00:450B                          ; It was one
    1057   00:450B  3E 0B                   ld  a,11                        ; So, eleven
    1058   00:450D  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1059   00:4510  DD 77 01                ld  (ix+1),a                    ; Save
    1060   00:4513  79                      ld  a,c
