    2266   00:4CBB                          ; A=255: Jump to old hook
    2267   00:4CBB                      
    2268   00:4CBB  F1                      pop af
    2269   00:4CBC  F5                      push    af
    2270   00:4CBD  3C                      inc a
    2271   00:4CBE  28 26                   jr  z,SSH_CHECK
    2272   00:4CC0                      
    2273   00:4CC0                          ; A=0: B=B+1 and jump to old hook
    2274   00:4CC0                      
    2275   00:4CC0  CD 3F 60                call    GETSLT
    2276   00:4CC3  CD 98 60                call    GETWRK
    2277   00:4CC6  F1                      pop af
    2278   00:4CC7  C1                      pop bc
