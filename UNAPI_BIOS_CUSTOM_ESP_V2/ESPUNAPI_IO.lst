    3439   00:51D4  D3 07             >     out (OUT_TX_PORT),a
    3440   00:51D6  3E 01                   ld  a,1
    3441   00:51D8                          SEND_DATA                       ; Send the command size lsb
    3441   00:51D8  D3 07             >     out (OUT_TX_PORT),a
    3442   00:51DA  78                      ld  a,b
    3443   00:51DB                          SEND_DATA                       ; Send the connection #
    3443   00:51DB  D3 07             >     out (OUT_TX_PORT),a
    3444   00:51DD                          ; Now wait up to 180 ticks to get response
    3445   00:51DD  21 B4 00                ld  hl,180
    3446   00:51E0  CD F4 5E                call    SETCOUNTER
    3447   00:51E3                      TCPIP_UDP_CLOSE_ST1:
    3448   00:51E3                          CHECK_DATA
    3448   00:51E3  DB 07             >     in  a,(IN_STS_PORT)
    3448   00:51E5  CB 47             >     bit 0,a
    3449   00:51E7  20 05                   jr  nz,TCPIP_UDP_CLOSE_ST1.1
    3450   00:51E9  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3451   00:51EC  18 F5                   jr  TCPIP_UDP_CLOSE_ST1
    3452   00:51EE                      TCPIP_UDP_CLOSE_ST1.1:
    3453   00:51EE                          ; nz, check the data
    3454   00:51EE                          RECEIVE_DATA
    3454   00:51EE  DB 06             >     in a,(IN_DATA_PORT)
    3455   00:51F0  FE 09                   cp  9                           ; Is response of our command?
    3456   00:51F2  20 EF                   jr  nz,TCPIP_UDP_CLOSE_ST1
    3457   00:51F4                          ; now get return code, if return code other than 0, it is finished
    3458   00:51F4                      TCPIP_UDP_CLOSE_RC:
    3459   00:51F4                          CHECK_DATA
    3459   00:51F4  DB 07             >     in  a,(IN_STS_PORT)
    3459   00:51F6  CB 47             >     bit 0,a
    3460   00:51F8  20 05                   jr  nz,TCPIP_UDP_CLOSE_RC.1
    3461   00:51FA  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3462   00:51FD  18 F5                   jr  TCPIP_UDP_CLOSE_RC
    3463   00:51FF                      TCPIP_UDP_CLOSE_RC.1:
    3464   00:51FF                          ; nz, discard
    3465   00:51FF                          RECEIVE_DATA
    3465   00:51FF  DB 06             >     in a,(IN_DATA_PORT)
    3466   00:5201  B7                      or  a                           ; 0?
    3467   00:5202  C0                      ret nz                          ; if not, done
    3468   00:5203                      
    3469   00:5203                          ; next two bytes are return code and size bytes, don't care, it is 1, conn #
    3470   00:5203  06 02                   ld  b,2
    3471   00:5205                      TCPIP_UDP_CLOSE_ST2:
    3472   00:5205                          CHECK_DATA
    3472   00:5205  DB 07             >     in  a,(IN_STS_PORT)
    3472   00:5207  CB 47             >     bit 0,a
    3473   00:5209  20 05                   jr  nz,TCPIP_UDP_CLOSE_ST2.1
    3474   00:520B  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3475   00:520E  18 F5                   jr  TCPIP_UDP_CLOSE_ST2
    3476   00:5210                      TCPIP_UDP_CLOSE_ST2.1:
    3477   00:5210                          ; nz, discard
    3478   00:5210                          RECEIVE_DATA
    3478   00:5210  DB 06             >     in a,(IN_DATA_PORT)
    3479   00:5212  05                      dec b
    3480   00:5213  20 F0                   jr  nz,TCPIP_UDP_CLOSE_ST2
    3481   00:5215                      
    3482   00:5215                          ; done, no return data other than return code
    3483   00:5215  AF                      xor a
    3484   00:5216  C9                      ret
    3485   00:5217                      
    3486   00:5217                      ;=========================
    3487   00:5217                      ;===  TCPIP_UDP_STATE  ===
    3488   00:5217                      ;=========================
    3489   00:5217                      ;Get the state of a UDP connection.
    3490   00:5217                      ;
    3491   00:5217                      ;Input:  A = 10
    3492   00:5217                      ;        B = Connection number
    3493   00:5217                      ;Output: A  = Error code
    3494   00:5217                      ;        HL = Local port number
    3495   00:5217                      ;        B  = Number of pending incoming datagrams
    3496   00:5217                      ;        DE = Size of oldest pending incoming datagram (data part only)
    3497   00:5217                      TCPIP_UDP_STATE:
    3498   00:5217                          SEND_DATA                       ; Send the command
    3498   00:5217  D3 07             >     out (OUT_TX_PORT),a
    3499   00:5219  AF                      xor a
    3500   00:521A                          SEND_DATA                       ; Send the command size msb
    3500   00:521A  D3 07             >     out (OUT_TX_PORT),a
    3501   00:521C  3C                      inc a
    3502   00:521D                          SEND_DATA                       ; Send the command size lsb
    3502   00:521D  D3 07             >     out (OUT_TX_PORT),a
    3503   00:521F  78                      ld  a,b
    3504   00:5220                          SEND_DATA                       ; Send the parameter
    3504   00:5220  D3 07             >     out (OUT_TX_PORT),a
    3505   00:5222                      
    3506   00:5222                          ; Now wait up to 60 ticks to get response
    3507   00:5222  21 3C 00                ld  hl,60
    3508   00:5225  CD F4 5E                call    SETCOUNTER
    3509   00:5228                      TCPIP_UDP_STATE_ST1:
    3510   00:5228                          CHECK_DATA
    3510   00:5228  DB 07             >     in  a,(IN_STS_PORT)
    3510   00:522A  CB 47             >     bit 0,a
    3511   00:522C  20 05                   jr  nz,TCPIP_UDP_STATE_ST1.1
    3512   00:522E  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3513   00:5231  18 F5                   jr  TCPIP_UDP_STATE_ST1
    3514   00:5233                      TCPIP_UDP_STATE_ST1.1:
    3515   00:5233                          ; nz, check the data
    3516   00:5233                          RECEIVE_DATA
    3516   00:5233  DB 06             >     in a,(IN_DATA_PORT)
    3517   00:5235  FE 0A                   cp  10                          ; Is response of our command?
    3518   00:5237  20 EF                   jr  nz,TCPIP_UDP_STATE_ST1
    3519   00:5239                          ; now get return code, if return code other than 0, it is finished
    3520   00:5239                      TCPIP_UDP_STATE_RC:
    3521   00:5239                          CHECK_DATA
    3521   00:5239  DB 07             >     in  a,(IN_STS_PORT)
    3521   00:523B  CB 47             >     bit 0,a
    3522   00:523D  20 05                   jr  nz,TCPIP_UDP_STATE_RC.1
    3523   00:523F  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3524   00:5242  18 F5                   jr  TCPIP_UDP_STATE_RC
    3525   00:5244                      TCPIP_UDP_STATE_RC.1:
    3526   00:5244                          ; nz, discard
    3527   00:5244                          RECEIVE_DATA
    3527   00:5244  DB 06             >     in a,(IN_DATA_PORT)
    3528   00:5246  B7                      or  a                           ; 0?
    3529   00:5247  C0                      ret nz                          ; if not, done
    3530   00:5248                      
    3531   00:5248                          ; next two bytes are return code and size bytes, don't care, it is 5
    3532   00:5248  06 02                   ld  b,2
    3533   00:524A                      TCPIP_UDP_STATE_ST2:
    3534   00:524A                          CHECK_DATA
    3534   00:524A  DB 07             >     in  a,(IN_STS_PORT)
    3534   00:524C  CB 47             >     bit 0,a
    3535   00:524E  20 05                   jr  nz,TCPIP_UDP_STATE_ST2.1
    3536   00:5250  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3537   00:5253  18 F5                   jr  TCPIP_UDP_STATE_ST2
    3538   00:5255                      TCPIP_UDP_STATE_ST2.1:
    3539   00:5255                          ; nz, discard
    3540   00:5255                          RECEIVE_DATA
    3540   00:5255  DB 06             >     in a,(IN_DATA_PORT)
    3541   00:5257  05                      dec b
    3542   00:5258  20 F0                   jr  nz,TCPIP_UDP_STATE_ST2
    3543   00:525A                      
    3544   00:525A                          ; now just get the 5 bytes (Port LSB then MSB, # of packets, packet size LSB then MSB) and order it in L, H, B, E and D
    3545   00:525A                      TCPIP_UDP_STATE_RESP_ST1:
    3546   00:525A                          CHECK_DATA
    3546   00:525A  DB 07             >     in  a,(IN_STS_PORT)
    3546   00:525C  CB 47             >     bit 0,a
    3547   00:525E  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST1.1
    3548   00:5260  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3549   00:5263  18 F5                   jr  TCPIP_UDP_STATE_RESP_ST1
    3550   00:5265                      TCPIP_UDP_STATE_RESP_ST1.1:
    3551   00:5265                          ; nz, get it
    3552   00:5265                          RECEIVE_DATA
    3552   00:5265  DB 06             >     in a,(IN_DATA_PORT)
    3553   00:5267  6F                      ld  l,a
    3554   00:5268                      TCPIP_UDP_STATE_RESP_ST2:
    3555   00:5268                          CHECK_DATA
    3555   00:5268  DB 07             >     in  a,(IN_STS_PORT)
    3555   00:526A  CB 47             >     bit 0,a
    3556   00:526C  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST2.1
    3557   00:526E  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3558   00:5271  18 F5                   jr  TCPIP_UDP_STATE_RESP_ST2
    3559   00:5273                      TCPIP_UDP_STATE_RESP_ST2.1:
    3560   00:5273                          ; nz, get it
    3561   00:5273                          RECEIVE_DATA
    3561   00:5273  DB 06             >     in a,(IN_DATA_PORT)
    3562   00:5275  67                      ld  h,a
    3563   00:5276                      TCPIP_UDP_STATE_RESP_ST3:
    3564   00:5276                          CHECK_DATA
    3564   00:5276  DB 07             >     in  a,(IN_STS_PORT)
    3564   00:5278  CB 47             >     bit 0,a
    3565   00:527A  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST3.1
    3566   00:527C  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3567   00:527F  18 F5                   jr  TCPIP_UDP_STATE_RESP_ST3
    3568   00:5281                      TCPIP_UDP_STATE_RESP_ST3.1:
    3569   00:5281                          ; nz, get it
    3570   00:5281                          RECEIVE_DATA
    3570   00:5281  DB 06             >     in a,(IN_DATA_PORT)
    3571   00:5283  47                      ld  b,a
    3572   00:5284                      TCPIP_UDP_STATE_RESP_ST4:
    3573   00:5284                          CHECK_DATA
    3573   00:5284  DB 07             >     in  a,(IN_STS_PORT)
    3573   00:5286  CB 47             >     bit 0,a
    3574   00:5288  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST4.1
    3575   00:528A  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3576   00:528D  18 F5                   jr  TCPIP_UDP_STATE_RESP_ST4
    3577   00:528F                      TCPIP_UDP_STATE_RESP_ST4.1:
    3578   00:528F                          ; nz, get it
    3579   00:528F                          RECEIVE_DATA
    3579   00:528F  DB 06             >     in a,(IN_DATA_PORT)
    3580   00:5291  5F                      ld  e,a
    3581   00:5292                      TCPIP_UDP_STATE_RESP_ST5:
    3582   00:5292                          CHECK_DATA
    3582   00:5292  DB 07             >     in  a,(IN_STS_PORT)
    3582   00:5294  CB 47             >     bit 0,a
    3583   00:5296  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST5.1
    3584   00:5298  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3585   00:529B  18 F5                   jr  TCPIP_UDP_STATE_RESP_ST5
    3586   00:529D                      TCPIP_UDP_STATE_RESP_ST5.1:
    3587   00:529D                          ; nz, get it
    3588   00:529D                          RECEIVE_DATA
    3588   00:529D  DB 06             >     in a,(IN_DATA_PORT)
    3589   00:529F  57                      ld  d,a
    3590   00:52A0                          ; done
    3591   00:52A0  AF                      xor a
    3592   00:52A1  C9                      ret
    3593   00:52A2                      
    3594   00:52A2                      ;========================
    3595   00:52A2                      ;===  TCPIP_UDP_SEND  ===
    3596   00:52A2                      ;========================
    3597   00:52A2                      ;Send an UDP datagram.
    3598   00:52A2                      ;
    3599   00:52A2                      ;Input:  A = 11
    3600   00:52A2                      ;        B = Connection number
    3601   00:52A2                      ;        HL = Address of datagram data
    3602   00:52A2                      ;        DE = Address of parameters block
    3603   00:52A2                      ;Output: A = Error code
    3604   00:52A2                      ;
    3605   00:52A2                      ;Parameters block:
    3606   00:52A2                      ;
    3607   00:52A2                      ;    +0 (4): Destination IP address
    3608   00:52A2                      ;    +4 (2): Destination port
    3609   00:52A2                      ;    +6 (2): Data length
    3610   00:52A2                      TCPIP_UDP_SEND:
    3611   00:52A2  E5                      push    hl
    3612   00:52A3  D5                      push    de
    3613   00:52A4                          SEND_DATA                       ; Send the command
    3613   00:52A4  D3 07             >     out (OUT_TX_PORT),a
    3614   00:52A6                          ; prepare new data size, adding our 7 bytes overhead
    3615   00:52A6  DD 62                   ld  ixh,d
    3616   00:52A8  DD 6B                   ld  ixl,e
    3617   00:52AA  11 07 00                ld  de,7
    3618   00:52AD  DD 6E 06                ld  l,(ix+6)
    3619   00:52B0  DD 66 07                ld  h,(ix+7)
    3620   00:52B3  19                      add hl,de
    3621   00:52B4  7C                      ld  a,h
    3622   00:52B5                          SEND_DATA                       ; Send the command size msb
    3622   00:52B5  D3 07             >     out (OUT_TX_PORT),a
    3623   00:52B7  7D                      ld  a,l
    3624   00:52B8                          SEND_DATA                       ; Send the command size lsb
    3624   00:52B8  D3 07             >     out (OUT_TX_PORT),a
    3625   00:52BA  78                      ld  a,b
    3626   00:52BB                          SEND_DATA                       ; Send the connection #
    3626   00:52BB  D3 07             >     out (OUT_TX_PORT),a
    3627   00:52BD  D1                      pop de
    3628   00:52BE  E1                      pop hl
    3629   00:52BF  1A                      ld  a,(de)
    3630   00:52C0                          SEND_DATA                       ; Send IP byte 1
    3630   00:52C0  D3 07             >     out (OUT_TX_PORT),a
    3631   00:52C2  13                      inc de
    3632   00:52C3  1A                      ld  a,(de)
    3633   00:52C4                          SEND_DATA                       ; Send IP byte 2
    3633   00:52C4  D3 07             >     out (OUT_TX_PORT),a
    3634   00:52C6  13                      inc de
    3635   00:52C7  1A                      ld  a,(de)
    3636   00:52C8                          SEND_DATA                       ; Send IP byte 3
    3636   00:52C8  D3 07             >     out (OUT_TX_PORT),a
    3637   00:52CA  13                      inc de
    3638   00:52CB  1A                      ld  a,(de)
    3639   00:52CC                          SEND_DATA                       ; Send IP byte 4
    3639   00:52CC  D3 07             >     out (OUT_TX_PORT),a
    3640   00:52CE  13                      inc de
    3641   00:52CF  1A                      ld  a,(de)
    3642   00:52D0                          SEND_DATA                       ; Send Port LSB
    3642   00:52D0  D3 07             >     out (OUT_TX_PORT),a
    3643   00:52D2  13                      inc de
    3644   00:52D3  1A                      ld  a,(de)
    3645   00:52D4                          SEND_DATA                       ; Send Port MSB
    3645   00:52D4  D3 07             >     out (OUT_TX_PORT),a
    3646   00:52D6                          ; now oti the data starting at hl, size is in next DE position
    3647   00:52D6  13                      inc de
    3648   00:52D7  1A                      ld  a,(de)
    3649   00:52D8  47                      ld  b,a                         ; save lsb in b
    3650   00:52D9  13                      inc de
    3651   00:52DA  1A                      ld  a,(de)                      ; msb
    3652   00:52DB  57                      ld  d,a                         ; put in D, there is no ld d,(de)
    3653   00:52DC  58                      ld  e,b                         ; lsb
    3654   00:52DD                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    3655   00:52DD                          ;ld b,e                         ; Number of loops originaly in DE, not needed, b already has e
    3656   00:52DD  1B                      dec de
    3657   00:52DE  14                      inc d
    3658   00:52DF                          if USE_MEM_IO = 0
    3659   00:52DF  0E 07                   ld  c,OUT_TX_PORT
    3660   00:52E1                      TCPIP_UDP_SEND_R:
    3661   00:52E1  ED B3                   otir                            ; Send until B is 0
    3662   00:52E3                          else
    3663   00:52E3                    ~ TCPIP_UDP_SEND_R:
    3664   00:52E3                    ~     ld  a,(hl)
    3665   00:52E3                    ~     ld  (MEM_OUT_TX_PORT),a
    3666   00:52E3                    ~     inc hl
    3667   00:52E3                    ~     djnz TCPIP_UDP_SEND_R
    3668   00:52E3                    ~     endif
    3669   00:52E3  15                      dec d                           ; decrement secondary counter
    3670   00:52E4  20 FB                   jr  nz,TCPIP_UDP_SEND_R         ; If still have another round, do it
    3671   00:52E6                          ; Now wait up to 600 ticks to get response
    3672   00:52E6  21 58 02                ld  hl,600
    3673   00:52E9  CD F4 5E                call    SETCOUNTER
    3674   00:52EC                      TCPIP_UDP_SEND_ST1:
    3675   00:52EC                          CHECK_DATA
    3675   00:52EC  DB 07             >     in  a,(IN_STS_PORT)
    3675   00:52EE  CB 47             >     bit 0,a
    3676   00:52F0  20 05                   jr  nz,TCPIP_UDP_SEND_ST1.1
    3677   00:52F2  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3678   00:52F5  18 F5                   jr  TCPIP_UDP_SEND_ST1
    3679   00:52F7                      TCPIP_UDP_SEND_ST1.1:
    3680   00:52F7                          ; nz, check the data
    3681   00:52F7                          RECEIVE_DATA
    3681   00:52F7  DB 06             >     in a,(IN_DATA_PORT)
    3682   00:52F9  FE 0B                   cp  11                          ; Is response of our command?
    3683   00:52FB  20 EF                   jr  nz,TCPIP_UDP_SEND_ST1
    3684   00:52FD                          ; now get return code, if return code other than 0, it is finished
    3685   00:52FD                      TCPIP_UDP_SEND_RC:
    3686   00:52FD                          CHECK_DATA
    3686   00:52FD  DB 07             >     in  a,(IN_STS_PORT)
    3686   00:52FF  CB 47             >     bit 0,a
    3687   00:5301  20 05                   jr  nz,TCPIP_UDP_SEND_RC.1
    3688   00:5303  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3689   00:5306  18 F5                   jr  TCPIP_UDP_SEND_RC
    3690   00:5308                      TCPIP_UDP_SEND_RC.1:
    3691   00:5308                          ; nz, discard
    3692   00:5308                          RECEIVE_DATA
    3692   00:5308  DB 06             >     in a,(IN_DATA_PORT)
    3693   00:530A  B7                      or  a                           ; 0?
    3694   00:530B  C0                      ret nz                          ; if not, done
    3695   00:530C                      
    3696   00:530C                          ; next two bytes are return code and size bytes, don't care, it is 0
    3697   00:530C  06 02                   ld  b,2
    3698   00:530E                      TCPIP_UDP_SEND_ST2:
    3699   00:530E                          CHECK_DATA
    3699   00:530E  DB 07             >     in  a,(IN_STS_PORT)
    3699   00:5310  CB 47             >     bit 0,a
    3700   00:5312  20 05                   jr  nz,TCPIP_UDP_SEND_ST2.1
    3701   00:5314  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3702   00:5317  18 F5                   jr  TCPIP_UDP_SEND_ST2
    3703   00:5319                      TCPIP_UDP_SEND_ST2.1:
    3704   00:5319                          ; nz, discard
    3705   00:5319                          RECEIVE_DATA
    3705   00:5319  DB 06             >     in a,(IN_DATA_PORT)
    3706   00:531B  05                      dec b
    3707   00:531C  20 F0                   jr  nz,TCPIP_UDP_SEND_ST2
    3708   00:531E                      
    3709   00:531E                          ; done, no return data other than return code
    3710   00:531E  AF                      xor a
    3711   00:531F  C9                      ret
    3712   00:5320                      
    3713   00:5320                      ;=======================
    3714   00:5320                      ;===  TCPIP_UDP_RCV  ===
    3715   00:5320                      ;=======================
    3716   00:5320                      ;Retrieve an incoming UDP datagram.
    3717   00:5320                      ;
    3718   00:5320                      ;Input:  A = 12
    3719   00:5320                      ;        B = Connection number
    3720   00:5320                      ;        HL = Address for datagram data
    3721   00:5320                      ;        DE = Maximum data size to retrieve
    3722   00:5320                      ;Output: A = Error code
    3723   00:5320                      ;        L.H.E.D = Source IP address
    3724   00:5320                      ;        IX = Source port
    3725   00:5320                      ;        BC = Actual received data size
    3726   00:5320                      
    3727   00:5320                      ; Customized TIME OUT routine: If time out receiving data, retry as received data
    3728   00:5320                      ; won't be re-sent as host is unaware of this
    3729   00:5320                      TCPIP_UDP_RCV_CHECK_TIME_OUT:
    3730   00:5320                          ; Save registers other than AF
    3731   00:5320  C5                      push bc
    3732   00:5321  D5                      push de
    3733   00:5322  E5                      push hl
    3734   00:5323  CD E5 5E                call    GETCOUNTER
    3735   00:5326  7D                      ld  a,l
    3736   00:5327  B4                      or  h
    3737   00:5328                          ; Restore registers, we are returning
    3738   00:5328  E1                      pop hl
    3739   00:5329  D1                      pop de
    3740   00:532A  C1                      pop bc
    3741   00:532B  C0                      ret nz
    3742   00:532C                          ; Ok, timeout...
    3743   00:532C  F1                      pop af                          ; Get return address of who called this out of the stack, we will return from the function or re-start
    3744   00:532D                      TCPIP_TCP_UDP_RETRY_QRCV:
    3745   00:532D  CD 04 5F                call    GETBYTE
    3746   00:5330  B7                      or  a
    3747   00:5331  28 0B                   jr  z,TCPIP_UDP_RCV_CHECK_TIME_OUT.NORXRETRY
    3748   00:5333                          ; Ok, so let's ask ESP to re-send the data and retry receiving it
    3749   00:5333  3D                      dec a
    3750   00:5334  CD 16 5F                call    SETBYTE                 ; we are retrying it
    3751   00:5337  3E 72                   ld  a,'r'                       ; retry transmission command
    3752   00:5339                          SEND_DATA
    3752   00:5339  D3 07             >     out (OUT_TX_PORT),a
    3753   00:533B  C3 5D 53                jp  TCPIP_UDP_RCV.RXRETRY       ; and retry it
    3754   00:533E                      TCPIP_UDP_RCV_CHECK_TIME_OUT.NORXRETRY:
    3755   00:533E  3E 0F                   ld  a,ERR_INV_OPER
    3756   00:5340  C9                      ret                             ; and return the function itself
    3757   00:5341                      
    3758   00:5341                      TCPIP_UDP_RCV:
    3759   00:5341  CD 3D 5F                call    SETWORD                 ; Save for later the datagram address
    3760   00:5344  3E 0C                   ld  a,12
    3761   00:5346                          SEND_DATA                       ; Send the command
    3761   00:5346  D3 07             >     out (OUT_TX_PORT),a
    3762   00:5348  AF                      xor a
    3763   00:5349                          SEND_DATA                       ; Send the command size msb
    3763   00:5349  D3 07             >     out (OUT_TX_PORT),a
    3764   00:534B  3E 03                   ld  a,3
    3765   00:534D                          SEND_DATA                       ; Send the command size lsb
    3765   00:534D  D3 07             >     out (OUT_TX_PORT),a
    3766   00:534F  78                      ld  a,b
    3767   00:5350                          SEND_DATA                       ; Send the connection #
    3767   00:5350  D3 07             >     out (OUT_TX_PORT),a
    3768   00:5352  7B                      ld  a,e
    3769   00:5353                          SEND_DATA                       ; Send MAX rcv size LSB
    3769   00:5353  D3 07             >     out (OUT_TX_PORT),a
    3770   00:5355  7A                      ld  a,d
    3771   00:5356                          SEND_DATA                       ; Send MAX rcv size MSB
    3771   00:5356  D3 07             >     out (OUT_TX_PORT),a
    3772   00:5358  3E 03                   ld  a,3
    3773   00:535A  CD 16 5F                call    SETBYTE                 ; Ok, retry up to three times
    3774   00:535D                      TCPIP_UDP_RCV.RXRETRY:
    3775   00:535D                          ; Now wait up to 600 ticks to get response
    3776   00:535D  21 58 02                ld  hl,600
    3777   00:5360  CD F4 5E                call    SETCOUNTER
    3778   00:5363                      TCPIP_UDP_RCV_ST1:
    3779   00:5363                          CHECK_DATA
    3779   00:5363  DB 07             >     in  a,(IN_STS_PORT)
    3779   00:5365  CB 47             >     bit 0,a
    3780   00:5367  20 05                   jr  nz,TCPIP_UDP_RCV_ST1.1
    3781   00:5369  CD 20 53                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3782   00:536C  18 F5                   jr  TCPIP_UDP_RCV_ST1
    3783   00:536E                      TCPIP_UDP_RCV_ST1.1:
    3784   00:536E                          ; nz, check the data
    3785   00:536E                          RECEIVE_DATA
    3785   00:536E  DB 06             >     in a,(IN_DATA_PORT)
    3786   00:5370  FE 0C                   cp  12                          ; Is response of our command?
    3787   00:5372  20 EF                   jr  nz,TCPIP_UDP_RCV_ST1
    3788   00:5374                          ; At this point, all data is being buffered, so 30 ticks, half second, is more than enough time-out
    3789   00:5374  F3                      di
    3790   00:5375  21 1E 00                ld  hl,30
    3791   00:5378  CD F4 5E                call    SETCOUNTER
    3792   00:537B  FB                      ei
    3793   00:537C                          ; now get return code, if return code other than 0, it is finished
    3794   00:537C                      TCPIP_UDP_RCV_RC:
    3795   00:537C                          CHECK_DATA
    3795   00:537C  DB 07             >     in  a,(IN_STS_PORT)
    3795   00:537E  CB 47             >     bit 0,a
    3796   00:5380  20 05                   jr  nz,TCPIP_UDP_RCV_RC.1
    3797   00:5382  CD 20 53                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3798   00:5385  18 F5                   jr  TCPIP_UDP_RCV_RC
    3799   00:5387                      TCPIP_UDP_RCV_RC.1:
    3800   00:5387                          ; nz, discard
    3801   00:5387                          RECEIVE_DATA
    3801   00:5387  DB 06             >     in a,(IN_DATA_PORT)
    3802   00:5389  B7                      or  a                           ; 0?
    3803   00:538A  C0                      ret nz                          ; if not, done
    3804   00:538B                          ; next two bytes are return code and size bytes, save it to BC
    3805   00:538B                      TCPIP_UDP_RCV_ST2A:
    3806   00:538B                          CHECK_DATA
    3806   00:538B  DB 07             >     in  a,(IN_STS_PORT)
    3806   00:538D  CB 47             >     bit 0,a
    3807   00:538F  20 05                   jr  nz,TCPIP_UDP_RCV_ST2A.1
    3808   00:5391  CD 20 53                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3809   00:5394  18 F5                   jr  TCPIP_UDP_RCV_ST2A
    3810   00:5396                      TCPIP_UDP_RCV_ST2A.1:
    3811   00:5396                          ; nz, discard
    3812   00:5396                          RECEIVE_DATA
    3812   00:5396  DB 06             >     in a,(IN_DATA_PORT)
    3813   00:5398  67                      ld  h,a
    3814   00:5399                      TCPIP_UDP_RCV_ST2B:
    3815   00:5399                          CHECK_DATA
    3815   00:5399  DB 07             >     in  a,(IN_STS_PORT)
    3815   00:539B  CB 47             >     bit 0,a
    3816   00:539D  20 05                   jr  nz,TCPIP_UDP_RCV_ST2B.1
    3817   00:539F  CD 20 53                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3818   00:53A2  18 F5                   jr  TCPIP_UDP_RCV_ST2B
    3819   00:53A4                      TCPIP_UDP_RCV_ST2B.1:
    3820   00:53A4                          ; nz, discard
    3821   00:53A4                          RECEIVE_DATA
    3821   00:53A4  DB 06             >     in a,(IN_DATA_PORT)
    3822   00:53A6  6F                      ld  l,a
    3823   00:53A7  01 06 00                ld  bc,6
    3824   00:53AA                          ; subtract 6 (IP and PORT)
    3825   00:53AA  AF                      xor a                           ; zero carry
    3826   00:53AB  ED 42                   sbc hl,bc
    3827   00:53AD  4D                      ld  c,l
    3828   00:53AE  44                      ld  b,h                         ; BC has effective received data size
    3829   00:53AF                          ; now just get the 4 bytes IP and place it in L H E D
    3830   00:53AF                      TCPIP_UDP_RCV_IP_ST1:
    3831   00:53AF                          CHECK_DATA
    3831   00:53AF  DB 07             >     in  a,(IN_STS_PORT)
    3831   00:53B1  CB 47             >     bit 0,a
    3832   00:53B3  20 05                   jr  nz,TCPIP_UDP_RCV_IP_ST1.1
    3833   00:53B5  CD 20 53                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3834   00:53B8  18 F5                   jr  TCPIP_UDP_RCV_IP_ST1
    3835   00:53BA                      TCPIP_UDP_RCV_IP_ST1.1:
