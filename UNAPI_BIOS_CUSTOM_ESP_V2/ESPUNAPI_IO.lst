    2994   00:4FF4                          ; nz, discard
    2995   00:4FF4                          RECEIVE_DATA
    2995   00:4FF4  DB 06             >     in a,(IN_DATA_PORT)
    2996   00:4FF6  B7                      or  a                           ; 0?
    2997   00:4FF7  C0                      ret nz                          ; if not, done
    2998   00:4FF8                      
    2999   00:4FF8                          ; next two bytes are return code and size bytes, don't care, it is 4
    3000   00:4FF8  06 02                   ld  b,2
