    2143   00:4C1C  DD 23                   inc ix                          ; Increment pointer
    2144   00:4C1E  B7                      or  a                           ; Terminator of AP Name?
    2145   00:4C1F  20 E8                   jr  nz,WAIT_MENU_SCMD_RESPONSE_ST2B
    2146   00:4C21                          ; Get encryption
    2147   00:4C21                      WAIT_MENU_SCMD_RESPONSE_GET_ENC:
    2148   00:4C21                          CHECK_DATA
    2148   00:4C21  DB 07             >     in  a,(IN_STS_PORT)
    2148   00:4C23  CB 47             >     bit 0,a
    2149   00:4C25  20 08                   jr  nz,WAIT_MENU_SCMD_RESPONSE_GET_ENC.1
