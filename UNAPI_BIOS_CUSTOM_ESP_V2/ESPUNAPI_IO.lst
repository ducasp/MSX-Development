    1197   00:4610  AF                      xor a
    1198   00:4611  B2                      or  d                           ; Still has items?
    1199   00:4612  28 0B                   jr  z,APLIST_NO_OVERFLOW        ; No more items
    1200   00:4614  06 01                   ld  b,1                         ; Signal that there still is data pending to list in another page
    1201   00:4616  E5                      push    hl
    1202   00:4617  FD E1                   pop iy                          ; Save in IY the address to continue from
    1203   00:4619  4A                      ld  c,d                         ; And C has the remaining AP count
    1204   00:461A  21 84 6A                ld  hl,MMENU_SCANQM
    1205   00:461D  18 03                   jr  APLIST_NOFLW
    1206   00:461F                      APLIST_NO_OVERFLOW:
    1207   00:461F                          ; If here, current page has been printed
    1208   00:461F                          ; E has the maximum allowable AP number
    1209   00:461F                          ; B will indicate if there are more items for a next page
    1210   00:461F                          ; IY will hold the address of the following items
    1211   00:461F                          ; Let's ask which one to connect
    1212   00:461F  21 19 6A                ld  hl,MMENU_SCANQ
    1213   00:4622                      APLIST_NOFLW:
