    1742   00:49DF                      
    1743   00:49DF                      WAIT_4S_AND_THEN_MAINMENU:
    1744   00:49DF  3E F0                   ld  a,240                       ; Wait 4 seconds with message on screen
    1745   00:49E1  18 02                   jr  WAIT_AND_THEN_MAINMENU
    1746   00:49E3                      WAIT_2S_AND_THEN_MAINMENU:
    1747   00:49E3  3E 78                   ld  a,120                       ; Wait 2 seconds with message on screen
    1748   00:49E5                      WAIT_AND_THEN_MAINMENU:
    1749   00:49E5  CD ED 49                call    WAIT_BEFORE_CONTINUING
    1750   00:49E8  C3 4F 42                jp  ESPSETUP                    ; When done, back to main setup
    1751   00:49EB                      WAIT_250MS_AND_THEN_CONTINUE:
    1752   00:49EB  3E 0F                   ld  a,15                        ; Wait 250 ms then continue
    1753   00:49ED                      WAIT_BEFORE_CONTINUING:
    1754   00:49ED  76                      halt
    1755   00:49EE  3D                      dec a
    1756   00:49EF                          ; If not zero, our time out has not elapsed
    1757   00:49EF  20 FC                   jr  nz,WAIT_BEFORE_CONTINUING
    1758   00:49F1  C9                      ret                             ; Time out and continue
    1759   00:49F2                      
    1760   00:49F2                      ; Check Auto Clock
    1761   00:49F2                      ISCLKAUTO:
    1762   00:49F2                          CLEAR_UART
    1762   00:49F2  3E 14             >     ld  a,20
    1762   00:49F4  D3 06             >     out (OUT_CMD_PORT),a
    1763   00:49F6  3E 63                   ld  a,CMD_QUERY_ACLK_SETTINGS
    1764   00:49F8                          SEND_DATA
    1764   00:49F8  D3 07             >     out (OUT_TX_PORT),a
    1765   00:49FA  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1766   00:49FD  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1767   00:4A01  DD 6B                   ld  ixl,e
    1768   00:4A03  DD 62                   ld  ixh,d                       ; address in IX
    1769   00:4A05  CD 40 4B                call    WAIT_MENU_CMD_RESPONSE
    1770   00:4A08  CA FD 4A                jp  z,MENU_SUB_BAD_END
    1771   00:4A0B                          ; Response received, IX+0 and IX+1 has Auto Clock and GMT, A
    1772   00:4A0B  C9                      ret
    1773   00:4A0C                      
    1774   00:4A0C                      ; Check what is the current NAGLE setting
    1775   00:4A0C                      CHECKNAGLE:
    1776   00:4A0C                          CLEAR_UART
    1776   00:4A0C  3E 14             >     ld  a,20
    1776   00:4A0E  D3 06             >     out (OUT_CMD_PORT),a
    1777   00:4A10  3E 51                   ld  a,CMD_QUERY_ESP_SETTINGS
    1778   00:4A12                          SEND_DATA
    1778   00:4A12  D3 07             >     out (OUT_TX_PORT),a
    1779   00:4A14  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1780   00:4A17  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1781   00:4A1B  DD 6B                   ld  ixl,e
    1782   00:4A1D  DD 62                   ld  ixh,d                       ; Address in IX
    1783   00:4A1F  CD 40 4B                call    WAIT_MENU_CMD_RESPONSE
    1784   00:4A22  CA FD 4A                jp  z,MENU_SUB_BAD_END
    1785   00:4A25                          ; Response received, nagle is the first one, ON: or OFF:
    1786   00:4A25  3E 4F                   ld  a,'O'
    1787   00:4A27  DD BE 00                cp  (ix+0)
    1788   00:4A2A  C2 FD 4A                jp  nz,MENU_SUB_BAD_END
    1789   00:4A2D  3E 4E                   ld  a,'N'
    1790   00:4A2F  DD BE 01                cp  (ix+1)
    1791   00:4A32  C2 3F 4A                jp  nz,CHECK_NAGLE_OFF
    1792   00:4A35  3E 3A                   ld  a,':'
    1793   00:4A37  DD BE 02                cp  (ix+2)
    1794   00:4A3A  C2 FD 4A                jp  nz,MENU_SUB_BAD_END
    1795   00:4A3D  B7                      or  a                           ; It will make it NZ
    1796   00:4A3E  C9                      ret
    1797   00:4A3F                      CHECK_NAGLE_OFF:
    1798   00:4A3F  3E 46                   ld  a,'F'
    1799   00:4A41  DD BE 01                cp  (ix+1)
    1800   00:4A44  C2 FD 4A                jp  nz,MENU_SUB_BAD_END
    1801   00:4A47  3E 46                   ld  a,'F'
    1802   00:4A49  DD BE 02                cp  (ix+2)
    1803   00:4A4C  C2 FD 4A                jp  nz,MENU_SUB_BAD_END
    1804   00:4A4F  3E 3A                   ld  a,':'
    1805   00:4A51  DD BE 03                cp  (ix+3)
    1806   00:4A54  C2 FD 4A                jp  nz,MENU_SUB_BAD_END
    1807   00:4A57                          ; Already has zero, so just ret
    1808   00:4A57  C9                      ret
    1809   00:4A58                      
    1810   00:4A58                      ; Check what is the current TIMEOUT setting, return 0 if always on, otherwise there is a timeout
    1811   00:4A58                      ; Will return a zero terminated string @ HL that can be printed
    1812   00:4A58                      ; Will return the value in DE
    1813   00:4A58                      CHECKTIMEOUT:
    1814   00:4A58                          CLEAR_UART
    1814   00:4A58  3E 14             >     ld  a,20
    1814   00:4A5A  D3 06             >     out (OUT_CMD_PORT),a
    1815   00:4A5C  3E 51                   ld  a,CMD_QUERY_ESP_SETTINGS
    1816   00:4A5E                          SEND_DATA
    1816   00:4A5E  D3 07             >     out (OUT_TX_PORT),a
    1817   00:4A60  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1818   00:4A63  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1819   00:4A67  DD 6B                   ld  ixl,e
    1820   00:4A69  DD 62                   ld  ixh,d                       ; Address in IX
    1821   00:4A6B  CD 40 4B                call    WAIT_MENU_CMD_RESPONSE
    1822   00:4A6E  CA FD 4A                jp  z,MENU_SUB_BAD_END
    1823   00:4A71                          ; Response received, nagle is the first one, ON: or OFF:
    1824   00:4A71  3E 3A                   ld  a,':'
    1825   00:4A73  DD 23                   inc ix
    1826   00:4A75  DD 23                   inc ix                          ; Nagle response is two or three bytes long, let's check
    1827   00:4A77  0B                      dec bc
    1828   00:4A78  0B                      dec bc                          ; Remaining bytes
    1829   00:4A79  DD BE 00                cp  (ix+0)
    1830   00:4A7C  CA 88 4A                jp  z,CHECKTIMEOUT.1
    1831   00:4A7F  DD 23                   inc ix
    1832   00:4A81  0B                      dec bc                          ; Remaining bytes
    1833   00:4A82  DD BE 00                cp  (ix+0)
    1834   00:4A85  C2 FD 4A                jp  nz,MENU_SUB_BAD_END         ; If not here, sorry to say it is an error
    1835   00:4A88                      CHECKTIMEOUT.1:
    1836   00:4A88  78                      ld  a,b
    1837   00:4A89  B1                      or  c                           ; All data read?
    1838   00:4A8A  CA FD 4A                jp  z,MENU_SUB_BAD_END          ; If so, sorry to say it is an error
    1839   00:4A8D  DD 23                   inc ix                          ; At the first digit
    1840   00:4A8F  0B                      dec bc                          ; Remaining bytes
    1841   00:4A90  78                      ld  a,b
    1842   00:4A91  B1                      or  c                           ; All data read?
    1843   00:4A92  CA FD 4A                jp  z,MENU_SUB_BAD_END          ; If so, sorry to say it is an error
    1844   00:4A95  DD E5                   push    ix                      ; This is the start of the string, save it
    1845   00:4A97  26 00                   ld  h,0                         ; No digit so far
    1846   00:4A99                          ; It can have up to three digits
    1847   00:4A99                      CHECKTIMEOUT.2:
    1848   00:4A99  3E 3A                   ld  a,':'
    1849   00:4A9B  DD BE 00                cp  (ix+0)                      ; Check if it is the separator
    1850   00:4A9E  CA BF 4A                jp  z,CHECKTIMEOUT.3            ; If it is routine will follow through
    1851   00:4AA1  DD 7E 00                ld  a,(ix+0)                    ; Get the supposed digit in A
    1852   00:4AA4  2E 3A                   ld  l,'9'+1
    1853   00:4AA6  BD                      cp  l
    1854   00:4AA7  D2 FC 4A                jp  nc,MENU_SUB_BAD_END_1S      ; If more than '9', sorry to say it is an error
    1855   00:4AAA  2E 30                   ld  l,'0'
    1856   00:4AAC  BD                      cp  l
    1857   00:4AAD  DA FC 4A                jp  c,MENU_SUB_BAD_END_1S       ; If less than '0', sorry to say it is an error
    1858   00:4AB0  24                      inc h                           ; It is not, so it is a digit
    1859   00:4AB1  3E 03                   ld  a,3
    1860   00:4AB3  BC                      cp  h
    1861   00:4AB4  DA FC 4A                jp  c,MENU_SUB_BAD_END_1S       ; If more than three digits, sorry to say it is an error
    1862   00:4AB7  DD 23                   inc ix                          ; Increase pointer
    1863   00:4AB9  0B                      dec bc                          ; Decrease remaining
    1864   00:4ABA  78                      ld  a,b
    1865   00:4ABB  B1                      or  c                           ; All data read?
    1866   00:4ABC  C2 99 4A                jp  nz,CHECKTIMEOUT.2           ; Not, so rinse and repeat
    1867   00:4ABF                      CHECKTIMEOUT.3:
    1868   00:4ABF  DD 36 00 00             ld  (ix+0),0                    ; Null terminate string value
    1869   00:4AC3  DD 2B                   dec ix
    1870   00:4AC5  DD 7E 00                ld  a,(ix+0)                    ; 1st Digit in A
    1871   00:4AC8  D6 30                   sub '0'                         ; Convert it to decimal value
    1872   00:4ACA  5F                      ld  e,a
    1873   00:4ACB  16 00                   ld  d,0                         ; DE has first digit
    1874   00:4ACD  25                      dec h                           ; Decrement digit counter
    1875   00:4ACE  28 28                   jr  z,CHECKTIMEOUT.END          ; If all digits, done
    1876   00:4AD0                          ; Now second digit, multiply it by 10 and add to E, even if 90 + 9, still fits E
    1877   00:4AD0  DD 2B                   dec ix
    1878   00:4AD2  DD 7E 00                ld  a,(ix+0)                    ; 2nd Digit
    1879   00:4AD5  D6 30                   sub '0'                         ; Convert it to decimal value
    1880   00:4AD7  87                      add a,a                         ; A has *2
    1881   00:4AD8  4F                      ld  c,a                         ; C has *2
    1882   00:4AD9  87                      add a,a                         ; A has *4
    1883   00:4ADA  87                      add a,a                         ; A has *8
    1884   00:4ADB  81                      add a,c                         ; A has *10
    1885   00:4ADC  83                      add a,e                         ; A has two digits result
    1886   00:4ADD  5F                      ld  e,a                         ; Back to E, DE has two digits results
    1887   00:4ADE  25                      dec h                           ; Decrement digit counter
    1888   00:4ADF  28 17                   jr  z,CHECKTIMEOUT.END          ; If all digits, done
    1889   00:4AE1                          ; Now Third digit, multiply it by 100 and add to DE
    1890   00:4AE1  DD 2B                   dec ix
    1891   00:4AE3  DD 7E 00                ld  a,(ix+0)                    ; 3rd Digit
    1892   00:4AE6  D6 30                   sub '0'                         ; Convert it to decimal value
    1893   00:4AE8  87                      add a,a                         ; A has *2
    1894   00:4AE9  4F                      ld  c,a                         ; C has *2
    1895   00:4AEA  87                      add a,a                         ; A has *4
    1896   00:4AEB  87                      add a,a                         ; A has *8
    1897   00:4AEC  81                      add a,c                         ; A has *10
    1898   00:4AED  26 00                   ld  h,0
    1899   00:4AEF  6F                      ld  l,a                         ; HL has *10
    1900   00:4AF0  29                      add hl,hl                       ; HL has *20
    1901   00:4AF1  44                      ld  b,h
    1902   00:4AF2  4D                      ld  c,l                         ; BC has *20
    1903   00:4AF3  29                      add hl,hl                       ; HL has *40
    1904   00:4AF4  29                      add hl,hl                       ; HL has *80
    1905   00:4AF5  09                      add hl,bc                       ; HL has *100
    1906   00:4AF6  19                      add hl,de                       ; HL has three digit value
    1907   00:4AF7  EB                      ex  de,hl                       ; now in DE
    1908   00:4AF8                      CHECKTIMEOUT.END:
    1909   00:4AF8  E1                      pop hl                          ; Restore address of string version of time count
    1910   00:4AF9  7A                      ld  a,d
    1911   00:4AFA  B3                      or  e                           ; Set zero flag according to the time out set
    1912   00:4AFB  C9                      ret
    1913   00:4AFC                      
    1914   00:4AFC                      MENU_SUB_BAD_END_1S:
    1915   00:4AFC  F1                      pop af                          ; 1 register was stacked, pop it
    1916   00:4AFD                      MENU_SUB_BAD_END:
    1917   00:4AFD  F1                      pop af                          ; It was a sub, so clear stack
    1918   00:4AFE                      MENU_BAD_END:
    1919   00:4AFE  21 A3 6E                ld  hl,STR_SENDING_FAIL         ; error message
    1920   00:4B01  CD 54 4C                call    PRINTHL
    1921   00:4B04  C3 E3 49                jp  WAIT_2S_AND_THEN_MAINMENU
    1922   00:4B07                      
    1923   00:4B07                      ; WAIT an ESP quick command Response
    1924   00:4B07                      ; Inputs:
    1925   00:4B07                      ; A -> Command Code
    1926   00:4B07                      ; HL -> Timeout
    1927   00:4B07                      ;
    1928   00:4B07                      ; Returns:
    1929   00:4B07                      ; Flag Z is zero if failure, non zero if success
    1930   00:4B07                      ;
    1931   00:4B07                      ; Affect:
    1932   00:4B07                      ; AF and HL
    1933   00:4B07                      ;
    1934   00:4B07                      WAIT_MENU_QCMD_RESPONSE:
    1935   00:4B07  D5                      push    de
    1936   00:4B08  57                      ld  d,a                         ; Command to wait in D
    1937   00:4B09                      WAIT_MENU_QCMD_RESPONSE_ST1:
    1938   00:4B09                          LOAD_STS_PORT_IN_A
    1938   00:4B09  DB 07             >     in  a,(IN_STS_PORT)
    1939   00:4B0B  CB 6F                   bit 5,a                         ; If nz Port #07 is not available
    1940   00:4B0D  C2 3A 4B                jp  nz,WAIT_MENU_QCMD_RESPONSE_END_NOK
    1941   00:4B10  CB 47                   bit 0,a                         ; If nz has data
    1942   00:4B12  20 08                   jr  nz,WAIT_MENU_QCMD_RESPONSE_ST1.1
    1943   00:4B14  CD 4E 4C                call    HLTIMEOUT
    1944   00:4B17  20 F0                   jr  nz,WAIT_MENU_QCMD_RESPONSE_ST1
    1945   00:4B19  C3 38 4B                jp  WAIT_MENU_QCMD_RESPONSE_END ; If time out waiting, return
    1946   00:4B1C                      WAIT_MENU_QCMD_RESPONSE_ST1.1:
    1947   00:4B1C                          ; nz, check the data
    1948   00:4B1C                          RECEIVE_DATA
    1948   00:4B1C  DB 06             >     in a,(IN_DATA_PORT)
    1949   00:4B1E  BA                      cp  d                           ; Is response of our command?
    1950   00:4B1F  20 E8                   jr  nz,WAIT_MENU_QCMD_RESPONSE_ST1
    1951   00:4B21                          ; Now get return code, if return code other than 0, it is failure, otherwise success
    1952   00:4B21                      WAIT_MENU_QCMD_RESPONSE_RC:
    1953   00:4B21                          CHECK_DATA
    1953   00:4B21  DB 07             >     in  a,(IN_STS_PORT)
    1953   00:4B23  CB 47             >     bit 0,a
    1954   00:4B25  20 08                   jr  nz,WAIT_MENU_QCMD_RESPONSE_RC.1
    1955   00:4B27  CD 4E 4C                call    HLTIMEOUT
    1956   00:4B2A  20 F5                   jr  nz,WAIT_MENU_QCMD_RESPONSE_RC
    1957   00:4B2C  C3 38 4B                jp  WAIT_MENU_QCMD_RESPONSE_END ; If time-out waiting, return
    1958   00:4B2F                      WAIT_MENU_QCMD_RESPONSE_RC.1:
    1959   00:4B2F                          RECEIVE_DATA
    1959   00:4B2F  DB 06             >     in a,(IN_DATA_PORT)
    1960   00:4B31  B7                      or  a                           ; 0?
    1961   00:4B32                          ; If not, done
    1962   00:4B32  C2 3A 4B                jp  nz,WAIT_MENU_QCMD_RESPONSE_END_NOK
    1963   00:4B35                      WAIT_MENU_QCMD_RESPONSE_END_OK:
    1964   00:4B35  3E 01                   ld  a,1
    1965   00:4B37  B7                      or  a                           ; NZ to indicate success
    1966   00:4B38                      WAIT_MENU_QCMD_RESPONSE_END:
    1967   00:4B38  D1                      pop de
    1968   00:4B39  C9                      ret
    1969   00:4B3A                      WAIT_MENU_QCMD_RESPONSE_END_NOK:
    1970   00:4B3A  21 00 00                ld  hl,0
    1971   00:4B3D  AF                      xor a
    1972   00:4B3E  D1                      pop de
    1973   00:4B3F  C9                      ret
    1974   00:4B40                      
    1975   00:4B40                      ; WAIT an ESP regular command Response
    1976   00:4B40                      ; Inputs:
    1977   00:4B40                      ; A -> Command Code
    1978   00:4B40                      ; HL -> Timeout
    1979   00:4B40                      ; IX -> Where to store response
    1980   00:4B40                      ;
    1981   00:4B40                      ; Returns:
    1982   00:4B40                      ; Flag Z is zero if failure, non zero if success
    1983   00:4B40                      ; BC is the response size
    1984   00:4B40                      ;
    1985   00:4B40                      ; Affect:
    1986   00:4B40                      ; AF , BC and HL
