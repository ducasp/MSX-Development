    2706   00:4E9D                      ;=========================
    2707   00:4E9D                      ;===  TCPIP_GET_CAPAB  ===
    2708   00:4E9D                      ;=========================
    2709   00:4E9D                      ; Get information about the TCP/IP capabilities and features.
    2710   00:4E9D                      ;
    2711   00:4E9D                      ;    Input:  A = 1
    2712   00:4E9D                      ;            B = Index of information block to retrieve:
    2713   00:4E9D                      ;                1: Capabilities and features flags, link level protocol
    2714   00:4E9D                      ;                2: Connection pool size and status
    2715   00:4E9D                      ;                3: Maximum datagram size allowed
    2716   00:4E9D                      ;                4: Second set of capabilities and features flags
    2717   00:4E9D                      ;    Output: A = Error code
    2718   00:4E9D                      ;        When information block 1 requested:
    2719   00:4E9D                      ;            HL = Capabilities flags
    2720   00:4E9D                      ;            DE = Features flags
    2721   00:4E9D                      ;            B  = Link level protocol used
    2722   00:4E9D                      ;        When information block 2 requested:
    2723   00:4E9D                      ;            B = Maximum simultaneous TCP connections supported
    2724   00:4E9D                      ;            C = Maximum simultaneous UDP connections supported
    2725   00:4E9D                      ;            D = Free TCP connections currently available
    2726   00:4E9D                      ;            E = Free UDP connections currently available
    2727   00:4E9D                      ;            H = Maximum simultaneous raw IP connections supported
    2728   00:4E9D                      ;            L = Free raw IP connections currently available
    2729   00:4E9D                      ;        When information block 3 requested:
    2730   00:4E9D                      ;            HL = Maximum incoming datagram size supported
    2731   00:4E9D                      ;            DE = Maximum outgoing datagram size supported
    2732   00:4E9D                      ;        When information block 4 requested:
    2733   00:4E9D                      ;            HL = Second set of capabilities flags
    2734   00:4E9D                      ;            DE = Second set of features flags (currently unused, always zero)
    2735   00:4E9D                      TCPIP_GET_CAPAB:
    2736   00:4E9D                          SEND_DATA                       ; Send the command
    2736   00:4E9D  D3 07             >     out (OUT_TX_PORT),a
    2737   00:4E9F  AF                      xor a
    2738   00:4EA0                          SEND_DATA                       ; Send the command size msb
    2738   00:4EA0  D3 07             >     out (OUT_TX_PORT),a
    2739   00:4EA2  3C                      inc a
    2740   00:4EA3                          SEND_DATA                       ; Send the command size lsb
    2740   00:4EA3  D3 07             >     out (OUT_TX_PORT),a
    2741   00:4EA5  78                      ld  a,b
    2742   00:4EA6  CD 01 61                call    SETBYTE                 ; Save it, we are going to need it later
    2743   00:4EA9                          SEND_DATA                       ; Send the parameter
    2743   00:4EA9  D3 07             >     out (OUT_TX_PORT),a
    2744   00:4EAB                      
    2745   00:4EAB                          ; Now wait up to 120 ticks to get response
    2746   00:4EAB  21 78 00                ld  hl,120
    2747   00:4EAE  CD DF 60                call    SETCOUNTER
    2748   00:4EB1                      TCPIP_GET_CAPAB_ST1:
    2749   00:4EB1                          CHECK_DATA
    2749   00:4EB1  DB 07             >     in  a,(IN_STS_PORT)
    2749   00:4EB3  CB 47             >     bit 0,a
    2750   00:4EB5  20 05                   jr  nz,TCPIP_GET_CAPAB_ST1.1
    2751   00:4EB7  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2752   00:4EBA  18 F5                   jr  TCPIP_GET_CAPAB_ST1
    2753   00:4EBC                      TCPIP_GET_CAPAB_ST1.1:
    2754   00:4EBC                          ; nz, check the data
    2755   00:4EBC                          RECEIVE_DATA
    2755   00:4EBC  DB 06             >     in a,(IN_DATA_PORT)
    2756   00:4EBE  FE 01                   cp  1                           ; Is response of our command?
    2757   00:4EC0  20 EF                   jr  nz,TCPIP_GET_CAPAB_ST1
    2758   00:4EC2                          ; Now get return code, if return code other than 0, it is finished
    2759   00:4EC2                      TCPIP_GET_CAPAB_RC:
    2760   00:4EC2                          CHECK_DATA
    2760   00:4EC2  DB 07             >     in  a,(IN_STS_PORT)
    2760   00:4EC4  CB 47             >     bit 0,a
    2761   00:4EC6  20 05                   jr  nz,TCPIP_GET_CAPAB_RC.1
    2762   00:4EC8  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2763   00:4ECB  18 F5                   jr  TCPIP_GET_CAPAB_RC
    2764   00:4ECD                      TCPIP_GET_CAPAB_RC.1:
    2765   00:4ECD                          ; nz, discard
    2766   00:4ECD                          RECEIVE_DATA
    2766   00:4ECD  DB 06             >     in a,(IN_DATA_PORT)
    2767   00:4ECF  B7                      or  a                           ; 0?
    2768   00:4ED0  C0                      ret nz                          ; If not, done
    2769   00:4ED1                      
    2770   00:4ED1                          ; Next two bytes are return code and size bytes, don't care
    2771   00:4ED1  06 02                   ld  b,2
    2772   00:4ED3                      TCPIP_GET_CAPAB_ST2:
    2773   00:4ED3                          CHECK_DATA
    2773   00:4ED3  DB 07             >     in  a,(IN_STS_PORT)
    2773   00:4ED5  CB 47             >     bit 0,a
    2774   00:4ED7  20 05                   jr  nz,TCPIP_GET_CAPAB_ST2.1
    2775   00:4ED9  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2776   00:4EDC  18 F5                   jr  TCPIP_GET_CAPAB_ST2
    2777   00:4EDE                      TCPIP_GET_CAPAB_ST2.1:
    2778   00:4EDE                          ; Nz, discard
    2779   00:4EDE                          RECEIVE_DATA
    2779   00:4EDE  DB 06             >     in a,(IN_DATA_PORT)
    2780   00:4EE0  05                      dec b
    2781   00:4EE1  20 F0                   jr  nz,TCPIP_GET_CAPAB_ST2
    2782   00:4EE3                      
    2783   00:4EE3                          ; Now check if block 1, 2 or 3
    2784   00:4EE3  CD EF 60                call    GETBYTE                 ; Get the parameter we saved at the start
    2785   00:4EE6  3D                      dec a
    2786   00:4EE7  CA 85 4F                jp  z,TCPIP_GET_CAPAB_BLK1      ; 1
    2787   00:4EEA  3D                      dec a
    2788   00:4EEB  CA 2F 4F                jp  z,TCPIP_GET_CAPAB_BLK2      ; 2
    2789   00:4EEE  3D                      dec a
    2790   00:4EEF  CA F5 4E                jp  z,TCPIP_GET_CAPAB_BLK3      ; 3
    2791   00:4EF2                          ; Else, only block four, same as block 1
    2792   00:4EF2  C3 85 4F                jp  TCPIP_GET_CAPAB_BLK1        ; 1
    2793   00:4EF5                          ; Block 3 Handling, we will receive L, H, E and D
    2794   00:4EF5                      TCPIP_GET_CAPAB_BLK3:
    2795   00:4EF5                      TCPIP_GET_CAPAB_BLK3_ST1:
