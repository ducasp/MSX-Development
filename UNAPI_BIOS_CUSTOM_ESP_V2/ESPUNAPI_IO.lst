    6210   00:5E57  0F                      rrca
    6211   00:5E58  E6 03                   and 3
    6212   00:5E5A  4F                      ld  c,a                         ;C = Slot
    6213   00:5E5B  06 00                   ld  b,0
    6214   00:5E5D  21 C1 FC                ld  hl,EXPTBL
    6215   00:5E60  09                      add hl,bc
    6216   00:5E61  7E                      ld  a,(hl)
    6217   00:5E62  E6 80                   and #80
    6218   00:5E64  B1                      or  c
    6219   00:5E65  4F                      ld  c,a
    6220   00:5E66  23                      inc hl
    6221   00:5E67  23                      inc hl
    6222   00:5E68  23                      inc hl
    6223   00:5E69  23                      inc hl
    6224   00:5E6A  7E                      ld  a,(hl)
    6225   00:5E6B  E6 0C                   and #0C
    6226   00:5E6D  B1                      or  c
    6227   00:5E6E  CB 7F                   bit 7,a
    6228   00:5E70  C0                      ret nz
    6229   00:5E71  E6 03                   and %11
    6230   00:5E73  C9                      ret
    6231   00:5E74                      
    6232   00:5E74                      ;--- Get slot connected on page 1 and test if work area has been created, if not, create it
    6233   00:5E74                      ;    Input:  -
    6234   00:5E74                      ;    Output: A = Slot number
    6235   00:5E74                      ;    Modifies: AF, HL, E, BC
    6236   00:5E74                      
    6237   00:5E74                      GETSLTT:
    6238   00:5E74  DB A8                   in  a,(#A8)
    6239   00:5E76  0F                      rrca
    6240   00:5E77  0F                      rrca
    6241   00:5E78  E6 03                   and 3
    6242   00:5E7A  4F                      ld  c,a                         ;C = Slot
    6243   00:5E7B  06 00                   ld  b,0
    6244   00:5E7D  21 C1 FC                ld  hl,EXPTBL
    6245   00:5E80  09                      add hl,bc
    6246   00:5E81  7E                      ld  a,(hl)
    6247   00:5E82  E6 80                   and #80
    6248   00:5E84  B1                      or  c
    6249   00:5E85  4F                      ld  c,a
    6250   00:5E86  23                      inc hl
    6251   00:5E87  23                      inc hl
    6252   00:5E88  23                      inc hl
    6253   00:5E89  23                      inc hl
