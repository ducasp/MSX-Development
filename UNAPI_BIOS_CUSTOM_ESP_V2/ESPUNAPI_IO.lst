    2283   00:4CCD                          ; A=0: B=B+1 and jump to old hook
    2284   00:4CCD                      
    2285   00:4CCD  CD 54 5E                call    GETSLT
    2286   00:4CD0  CD AD 5E                call    GETWRK
    2287   00:4CD3  F1                      pop af
