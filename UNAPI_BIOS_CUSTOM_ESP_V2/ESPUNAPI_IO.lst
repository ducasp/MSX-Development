    4411   00:5619                      ;       HL = Number of available bytes
    4412   00:5619                      SSH_STATE:
    4413   00:5619  CB FF                   set 7,a                         ; ESP SSH commands start at #80
    4414   00:561B                          SEND_DATA                       ; Send the command
    4414   00:561B  D3 07             >     out (OUT_TX_PORT),a
    4415   00:561D  AF                      xor a
    4416   00:561E                          SEND_DATA                       ; Send the command size msb
    4416   00:561E  D3 07             >     out (OUT_TX_PORT),a
    4417   00:5620  3E 01                   ld  a,1
    4418   00:5622                          SEND_DATA                       ; Send the command size lsb
    4418   00:5622  D3 07             >     out (OUT_TX_PORT),a
    4419   00:5624  78                      ld  a,b
    4420   00:5625                          SEND_DATA                       ; Send the connection #
    4420   00:5625  D3 07             >     out (OUT_TX_PORT),a
