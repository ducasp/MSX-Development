    2952   00:4FC7                      ;==========================
    2953   00:4FC7                      ;Get IP address.
    2954   00:4FC7                      ;
    2955   00:4FC7                      ;Input:  A = 2
    2956   00:4FC7                      ;        B = Index of address to obtain:
    2957   00:4FC7                      ;            1: Local IP address
    2958   00:4FC7                      ;            2: Peer IP address
    2959   00:4FC7                      ;            3: Subnet mask
    2960   00:4FC7                      ;            4: Default gateway
    2961   00:4FC7                      ;            5: Primary DNS server IP address
    2962   00:4FC7                      ;            6: Secondary DNS server IP address
    2963   00:4FC7                      ;Output: A = Error code
    2964   00:4FC7                      ;        L.H.E.D = Requested address
