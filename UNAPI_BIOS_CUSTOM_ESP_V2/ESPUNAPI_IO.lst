    3876   00:53F6                      TCPIP_UDP_RCV_PORT_ST2:
    3877   00:53F6                          CHECK_DATA
    3877   00:53F6  DB 07             >     in  a,(IN_STS_PORT)
    3877   00:53F8  CB 47             >     bit 0,a
    3878   00:53FA  20 05                   jr  nz,TCPIP_UDP_RCV_PORT_ST2.1
