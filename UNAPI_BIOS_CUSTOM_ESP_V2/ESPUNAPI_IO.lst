    5395   00:5AB5                      ;=======================
    5396   00:5AB5                      ;===  TCPIP_TCP_RCV  ===
    5397   00:5AB5                      ;=======================
    5398   00:5AB5                      ;Receive data from a TCP connection.
    5399   00:5AB5                      ;
    5400   00:5AB5                      ;Input:   A  = 18
    5401   00:5AB5                      ;         B  = Connection number
    5402   00:5AB5                      ;         DE = Address for the retrieved data
    5403   00:5AB5                      ;         HL = Length of the data to be obtained
