    5063   00:593A                      ;===   SSH_TERM_TYPE   ===
    5064   00:593A                      ;=========================
    5065   00:593A                      ;Get or set the terminal type requested on PTY connection.
    5066   00:593A                      ;
    5067   00:593A                      ;Input:  A = 7
    5068   00:593A                      ;        C = Operation ( 0 - Get / 1 - Set)
    5069   00:593A                      ;        D = Terminal Type when Set
