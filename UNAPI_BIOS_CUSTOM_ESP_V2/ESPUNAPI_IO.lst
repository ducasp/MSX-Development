    4200   00:5540  D3 07             >     out (OUT_TX_PORT),a
    4201   00:5542  3E 01                   ld  a,1
    4202   00:5544                          SEND_DATA                       ; Send the command size lsb
    4202   00:5544  D3 07             >     out (OUT_TX_PORT),a
