    4417   00:5626  DB 06             >     in a,(IN_DATA_PORT)
    4418   00:5628  47                      ld b,a
    4419   00:5629  C5                      push    bc                      ; save it
    4420   00:562A                      
    4421   00:562A  4D                      ld  c,l
    4422   00:562B  44                      ld  b,h                         ; BC has effective received data size, as well as HL
    4423   00:562C                      
    4424   00:562C                          ; put effective data size in de
    4425   00:562C  EB                      ex  de,hl
    4426   00:562D                          ; address was in de, now in HL, BC effective received size
    4427   00:562D                      
    4428   00:562D                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use ini :-D
    4429   00:562D  43                      ld  b,e                         ; Number of loops originaly in DE
    4430   00:562E  1B                      dec de
    4431   00:562F  14                      inc d
    4432   00:5630                          if USE_MEM_IO = 0
    4433   00:5630  0E 06                   ld  c,IN_DATA_PORT
    4434   00:5632                          endif
    4435   00:5632                      SSH_OPEN_HOSTHASH_NSF:
