    1721   00:49A8                      
    1722   00:49A8                      SET_NAGLE_ON:
    1723   00:49A8  3E 4F                   ld  a,'O'
    1724   00:49AA  CD A2 00                call    CHPUT
    1725   00:49AD  3E 0D                   ld  a,#0d
    1726   00:49AF  CD A2 00                call    CHPUT
    1727   00:49B2  3E 0A                   ld  a,#0a
    1728   00:49B4  CD A2 00                call    CHPUT
    1729   00:49B7  21 03 6E                ld  hl,STR_SENDING              ; Indicate it is sending a command
