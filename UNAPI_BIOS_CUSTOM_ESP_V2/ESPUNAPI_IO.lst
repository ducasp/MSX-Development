    2270   00:4CBD  3C                      inc a
    2271   00:4CBE  28 26                   jr  z,SSH_CHECK
    2272   00:4CC0                      
    2273   00:4CC0                          ; A=0: B=B+1 and jump to old hook
    2274   00:4CC0                      
    2275   00:4CC0  CD 20 5C                call    GETSLT
    2276   00:4CC3  CD 79 5C                call    GETWRK
    2277   00:4CC6  F1                      pop af
    2278   00:4CC7  C1                      pop bc
    2279   00:4CC8  B7                      or  a
    2280   00:4CC9  20 06                   jr  nz,DO_EXTBIO2
