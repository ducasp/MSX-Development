    4666   00:5766  F5                      push    af                      ; Save H flags on stack
    4667   00:5767                          ; Now receive BC bytes of data into buffer
    4668   00:5767  CD 88 61                call    BCBACKUP                ; save BC (bytes written count)
    4669   00:576A  78                      ld  a,b
