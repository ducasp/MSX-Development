    2712   00:4E9F                      ;=========================
    2713   00:4E9F                      ;===  TCPIP_GET_CAPAB  ===
    2714   00:4E9F                      ;=========================
    2715   00:4E9F                      ; Get information about the TCP/IP capabilities and features.
    2716   00:4E9F                      ;
    2717   00:4E9F                      ;    Input:  A = 1
    2718   00:4E9F                      ;            B = Index of information block to retrieve:
    2719   00:4E9F                      ;                1: Capabilities and features flags, link level protocol
    2720   00:4E9F                      ;                2: Connection pool size and status
    2721   00:4E9F                      ;                3: Maximum datagram size allowed
    2722   00:4E9F                      ;                4: Second set of capabilities and features flags
    2723   00:4E9F                      ;    Output: A = Error code
    2724   00:4E9F                      ;        When information block 1 requested:
    2725   00:4E9F                      ;            HL = Capabilities flags
    2726   00:4E9F                      ;            DE = Features flags
    2727   00:4E9F                      ;            B  = Link level protocol used
    2728   00:4E9F                      ;        When information block 2 requested:
    2729   00:4E9F                      ;            B = Maximum simultaneous TCP connections supported
    2730   00:4E9F                      ;            C = Maximum simultaneous UDP connections supported
    2731   00:4E9F                      ;            D = Free TCP connections currently available
    2732   00:4E9F                      ;            E = Free UDP connections currently available
    2733   00:4E9F                      ;            H = Maximum simultaneous raw IP connections supported
    2734   00:4E9F                      ;            L = Free raw IP connections currently available
    2735   00:4E9F                      ;        When information block 3 requested:
    2736   00:4E9F                      ;            HL = Maximum incoming datagram size supported
    2737   00:4E9F                      ;            DE = Maximum outgoing datagram size supported
    2738   00:4E9F                      ;        When information block 4 requested:
    2739   00:4E9F                      ;            HL = Second set of capabilities flags
    2740   00:4E9F                      ;            DE = Second set of features flags (currently unused, always zero)
    2741   00:4E9F                      TCPIP_GET_CAPAB:
    2742   00:4E9F                          SEND_DATA                       ; Send the command
    2742   00:4E9F  D3 07             >     out (OUT_TX_PORT),a
    2743   00:4EA1  AF                      xor a
    2744   00:4EA2                          SEND_DATA                       ; Send the command size msb
    2744   00:4EA2  D3 07             >     out (OUT_TX_PORT),a
    2745   00:4EA4  3C                      inc a
    2746   00:4EA5                          SEND_DATA                       ; Send the command size lsb
    2746   00:4EA5  D3 07             >     out (OUT_TX_PORT),a
    2747   00:4EA7  78                      ld  a,b
    2748   00:4EA8  CD 16 5F                call    SETBYTE                 ; Save it, we are going to need it later
    2749   00:4EAB                          SEND_DATA                       ; Send the parameter
    2749   00:4EAB  D3 07             >     out (OUT_TX_PORT),a
    2750   00:4EAD                      
    2751   00:4EAD                          ; Now wait up to 120 ticks to get response
    2752   00:4EAD  21 78 00                ld  hl,120
    2753   00:4EB0  CD F4 5E                call    SETCOUNTER
    2754   00:4EB3                      TCPIP_GET_CAPAB_ST1:
    2755   00:4EB3                          CHECK_DATA
    2755   00:4EB3  DB 07             >     in  a,(IN_STS_PORT)
    2755   00:4EB5  CB 47             >     bit 0,a
    2756   00:4EB7  20 05                   jr  nz,TCPIP_GET_CAPAB_ST1.1
    2757   00:4EB9  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2758   00:4EBC  18 F5                   jr  TCPIP_GET_CAPAB_ST1
    2759   00:4EBE                      TCPIP_GET_CAPAB_ST1.1:
    2760   00:4EBE                          ; nz, check the data
    2761   00:4EBE                          RECEIVE_DATA
    2761   00:4EBE  DB 06             >     in a,(IN_DATA_PORT)
    2762   00:4EC0  FE 01                   cp  1                           ; Is response of our command?
    2763   00:4EC2  20 EF                   jr  nz,TCPIP_GET_CAPAB_ST1
    2764   00:4EC4                          ; Now get return code, if return code other than 0, it is finished
    2765   00:4EC4                      TCPIP_GET_CAPAB_RC:
    2766   00:4EC4                          CHECK_DATA
    2766   00:4EC4  DB 07             >     in  a,(IN_STS_PORT)
    2766   00:4EC6  CB 47             >     bit 0,a
    2767   00:4EC8  20 05                   jr  nz,TCPIP_GET_CAPAB_RC.1
    2768   00:4ECA  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2769   00:4ECD  18 F5                   jr  TCPIP_GET_CAPAB_RC
    2770   00:4ECF                      TCPIP_GET_CAPAB_RC.1:
    2771   00:4ECF                          ; nz, discard
    2772   00:4ECF                          RECEIVE_DATA
    2772   00:4ECF  DB 06             >     in a,(IN_DATA_PORT)
    2773   00:4ED1  B7                      or  a                           ; 0?
    2774   00:4ED2  C0                      ret nz                          ; If not, done
    2775   00:4ED3                      
    2776   00:4ED3                          ; Next two bytes are return code and size bytes, don't care
    2777   00:4ED3  06 02                   ld  b,2
    2778   00:4ED5                      TCPIP_GET_CAPAB_ST2:
    2779   00:4ED5                          CHECK_DATA
    2779   00:4ED5  DB 07             >     in  a,(IN_STS_PORT)
    2779   00:4ED7  CB 47             >     bit 0,a
    2780   00:4ED9  20 05                   jr  nz,TCPIP_GET_CAPAB_ST2.1
    2781   00:4EDB  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2782   00:4EDE  18 F5                   jr  TCPIP_GET_CAPAB_ST2
    2783   00:4EE0                      TCPIP_GET_CAPAB_ST2.1:
    2784   00:4EE0                          ; Nz, discard
    2785   00:4EE0                          RECEIVE_DATA
    2785   00:4EE0  DB 06             >     in a,(IN_DATA_PORT)
    2786   00:4EE2  05                      dec b
    2787   00:4EE3  20 F0                   jr  nz,TCPIP_GET_CAPAB_ST2
    2788   00:4EE5                      
    2789   00:4EE5                          ; Now check if block 1, 2 or 3
    2790   00:4EE5  CD 04 5F                call    GETBYTE                 ; Get the parameter we saved at the start
    2791   00:4EE8  3D                      dec a
    2792   00:4EE9  CA 87 4F                jp  z,TCPIP_GET_CAPAB_BLK1      ; 1
    2793   00:4EEC  3D                      dec a
    2794   00:4EED  CA 31 4F                jp  z,TCPIP_GET_CAPAB_BLK2      ; 2
    2795   00:4EF0  3D                      dec a
    2796   00:4EF1  CA F7 4E                jp  z,TCPIP_GET_CAPAB_BLK3      ; 3
    2797   00:4EF4                          ; Else, only block four, same as block 1
    2798   00:4EF4  C3 87 4F                jp  TCPIP_GET_CAPAB_BLK1        ; 1
    2799   00:4EF7                          ; Block 3 Handling, we will receive L, H, E and D
