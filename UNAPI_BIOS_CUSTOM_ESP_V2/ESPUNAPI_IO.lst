    2788   00:4EE7                          CHECK_DATA
    2788   00:4EE7  DB 07             >     in  a,(IN_STS_PORT)
    2788   00:4EE9  CB 47             >     bit 0,a
    2789   00:4EEB  20 05                   jr  nz,TCPIP_GET_CAPAB_BLK3_ST3.1
    2790   00:4EED  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2791   00:4EF0  18 F5                   jr  TCPIP_GET_CAPAB_BLK3_ST3
