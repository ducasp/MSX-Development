    6699   00:6011                      ;--- Set DNS redy in high memory
    6700   00:6011                      ;    Input:  A = new value
    6701   00:6011                      ;    Output: none
    6702   00:6011                      ;    Modifies: AF
    6703   00:6011                      
    6704   00:6011                      SETDNSREADY:
    6705   00:6011  C5                      push    bc
    6706   00:6012  D5                      push    de
    6707   00:6013  E5                      push    hl
    6708   00:6014  F5                      push    af                      ; Save parameter
    6709   00:6015  CD 4C 5E                call    GETSLT
    6710   00:6018                          ; Slot in A, now get the address
    6711   00:6018  CD D5 5E                call    GETMEMPOINTER
    6712   00:601B                          ; HL has the address of our memory area, DNS ready is 8 bytes after start
    6713   00:601B  11 08 00                ld  de,MEMORY_DNS_READY_OFFSET
    6714   00:601E  19                      add hl,de
    6715   00:601F                          ; HL has the address of DNS ready
    6716   00:601F  F1                      pop af                          ; Restore parameter
    6717   00:6020  77                      ld  (hl),a
    6718   00:6021  E1                      pop hl
    6719   00:6022  D1                      pop de
    6720   00:6023  C1                      pop bc
    6721   00:6024  C9                      ret
    6722   00:6025                      
    6723   00:6025                      ;--- Obtain DNS result saved in high memory
    6724   00:6025                      ;    Input:  none
    6725   00:6025                      ;    Output: HL DE = DNS result
    6726   00:6025                      ;    Modifies: AF
    6727   00:6025                      
    6728   00:6025                      GETDNSRESULT:
    6729   00:6025  C5                      push    bc
    6730   00:6026  CD 4C 5E                call    GETSLT
    6731   00:6029                          ; Slot in A, now get the address
    6732   00:6029  CD D5 5E                call    GETMEMPOINTER
    6733   00:602C                          ; HL has the address of our memory area, DNS result is 9 bytes after start
    6734   00:602C  11 09 00                ld  de,MEMORY_DNS_RES_OFFSET
    6735   00:602F  19                      add hl,de
    6736   00:6030                          ; Ok, get it, first bytes are hl
    6737   00:6030  5E                      ld  e,(hl)
    6738   00:6031  23                      inc hl
    6739   00:6032  56                      ld  d,(hl)
    6740   00:6033  D5                      push    de                      ; for now, save in stack, so we can restore to HL later
    6741   00:6034  23                      inc hl
    6742   00:6035  5E                      ld  e,(hl)
    6743   00:6036  23                      inc hl
    6744   00:6037  56                      ld  d,(hl)
    6745   00:6038  E1                      pop hl                          ; and now restore HL value from stack
    6746   00:6039  C1                      pop bc
    6747   00:603A  C9                      ret
    6748   00:603B                      
    6749   00:603B                      ;--- Set DNS result in high memory
    6750   00:603B                      ;    Input:  HL DE = new value
    6751   00:603B                      ;    Output: none
    6752   00:603B                      ;    Modifies: AF
    6753   00:603B                      
    6754   00:603B                      SETDNSRESULT:
    6755   00:603B  C5                      push    bc
    6756   00:603C  D5                      push    de
    6757   00:603D  E5                      push    hl
    6758   00:603E  CD 4C 5E                call    GETSLT
    6759   00:6041                          ; Slot in A, now get the address
    6760   00:6041  CD D5 5E                call    GETMEMPOINTER
    6761   00:6044                          ; HL has the address of our memory area, DNS result is 9 bytes after start
    6762   00:6044  11 09 00                ld  de,MEMORY_DNS_RES_OFFSET
    6763   00:6047  19                      add hl,de
    6764   00:6048                          ; HL has the address of DNS result
    6765   00:6048  C1                      pop bc                          ; Restore parameter HL in BC
    6766   00:6049  71                      ld  (hl),c
    6767   00:604A  23                      inc hl
    6768   00:604B  70                      ld  (hl),b
    6769   00:604C  D1                      pop de                          ; Restore parameter DE in DE
    6770   00:604D  23                      inc hl
    6771   00:604E  73                      ld  (hl),e
    6772   00:604F  23                      inc hl
    6773   00:6050  72                      ld  (hl),d
    6774   00:6051  69                      ld  l,c
    6775   00:6052  60                      ld  h,b                         ; And HL is restored
    6776   00:6053  C1                      pop bc                          ; Restore BC
    6777   00:6054  C9                      ret
    6778   00:6055                      
    6779   00:6055                      ;--- Convert a character to upper-case if it is a lower-case letter
    6780   00:6055                      TOUPPER:
    6781   00:6055  FE 61                   cp  "a"
    6782   00:6057  D8                      ret c
    6783   00:6058  FE 7B                   cp  "z"+1
    6784   00:605A  D0                      ret nc
    6785   00:605B  E6 DF                   and #DF
    6786   00:605D  C9                      ret
    6787   00:605E                      
    6788   00:605E                      ;*********************************************
    6789   00:605E                      ;***       WAIT_RESPONSE_FROM_ESP          ***
    6790   00:605E                      ;*** Will wait ESP to send a response,     ***
    6791   00:605E                      ;*** discarding all data until it is found.***
    6792   00:605E                      ;***                                       ***
    6793   00:605E                      ;*** Inputs:                               ***
    6794   00:605E                      ;*** HL - Expected response string         ***
    6795   00:605E                      ;*** A - Response Size                     ***
    6796   00:605E                      ;*** DE - TimeOut in ticks                 ***
    6797   00:605E                      ;***                                       ***
    6798   00:605E                      ;*** Output:                               ***
    6799   00:605E                      ;*** A - 0 if response received            ***
    6800   00:605E                      ;*** otherwise response not received and   ***
    6801   00:605E                      ;*** timed-out.                            ***
    6802   00:605E                      ;***                                       ***
    6803   00:605E                      ;*** Changes HL, BC, AF, DE, IX            ***
    6804   00:605E                      ;*********************************************
    6805   00:605E                      WRFE_WAIT_DATA:
    6806   00:605E                          LOAD_STS_PORT_IN_A
    6806   00:605E  DB 07             >     in  a,(IN_STS_PORT)
    6807   00:6060  CB 6F                   bit 5,a                         ; If nz Port #07 is not available
    6808   00:6062  20 06                   jr  nz,WRFE_STS_NOT_AVAILABLE
    6809   00:6064  CB 47                   bit 0,a                         ; if nz has data
    6810   00:6066  C0                      ret nz
    6811   00:6067  1B                      dec de
    6812   00:6068  76                      halt
    6813   00:6069  C9                      ret
    6814   00:606A                      WRFE_STS_NOT_AVAILABLE:
    6815   00:606A  11 00 00                ld  de,0
    6816   00:606D  AF                      xor a
    6817   00:606E  C9                      ret
    6818   00:606F                      
    6819   00:606F                      WRFE_COMPARE:
    6820   00:606F  47                      ld  b,a
    6821   00:6070  7E                      ld  a,(hl)
    6822   00:6071  B8                      cp  b
    6823   00:6072  C0                      ret nz
    6824   00:6073  23                      inc hl
    6825   00:6074  C9                      ret
    6826   00:6075                      
    6827   00:6075                      WAIT_RESPONSE_FROM_ESP:
    6828   00:6075  4F                      ld  c,a                         ; Response size in C
    6829   00:6076  E5                      push    hl                      ; Save HL
    6830   00:6077  AF                      xor a
    6831   00:6078                      WRFE_ST1:
    6832   00:6078  DD 67                   ld  ixh,a                       ; We start at index 0
    6833   00:607A                      
    6834   00:607A                      WRFE_LOOP:
    6835   00:607A  CD 5E 60                call    WRFE_WAIT_DATA
    6836   00:607D  20 07                   jr  nz,WRFE_LOOP.1
    6837   00:607F  7B                      ld  a,e
    6838   00:6080  B2                      or  d
    6839   00:6081  CA A0 60                jp  z,WRFE_RET_ERROR
    6840   00:6084  18 F4                   jr  WRFE_LOOP
    6841   00:6086                      WRFE_LOOP.1:
    6842   00:6086                          ; nz, check the data
    6843   00:6086                          RECEIVE_DATA
    6843   00:6086  DB 06             >     in a,(IN_DATA_PORT)
    6844   00:6088                          ; Ok, now the byte is in A, let's compare
    6845   00:6088                      WRFE_IDXCMD:
    6846   00:6088  CD 6F 60                call WRFE_COMPARE
    6847   00:608B                          ; if match
    6848   00:608B  28 07                   jr  z,WRFE_RSP_MATCH
    6849   00:608D                          ; did not match, let's zero the rsp index
    6850   00:608D  AF                      xor a
    6851   00:608E  DD 67                   ld  ixh,a                       ; re-start at index 0
    6852   00:6090  E1                      pop hl                          ; restore the response index
    6853   00:6091  E5                      push    hl                      ; and keep it in stack
    6854   00:6092                          ; back to get another byte
    6855   00:6092  18 E6                   jr  WRFE_LOOP
    6856   00:6094                      WRFE_RSP_MATCH:
    6857   00:6094                          ; match
    6858   00:6094  DD 24                   inc ixh
    6859   00:6096  DD 7C                   ld  a,ixh
    6860   00:6098  B9                      cp  c
    6861   00:6099                          ; if a = c done and response is success
    6862   00:6099  28 02                   jr  z,WRFE_RET_OK
    6863   00:609B                          ; not done, back to get more bytes
    6864   00:609B  18 DD                   jr  WRFE_LOOP
    6865   00:609D                      WRFE_RET_OK:
    6866   00:609D  E1                      pop hl
    6867   00:609E  AF                      xor a
    6868   00:609F  C9                      ret
    6869   00:60A0                      WRFE_RET_ERROR:
    6870   00:60A0  E1                      pop hl
    6871   00:60A1  3E 01                   ld  a,1
    6872   00:60A3  C9                      ret
    6873   00:60A4                      
    6874   00:60A4                      ;*********************************************
    6875   00:60A4                      ;***            CHECK_ESP_TYPE             ***
    6876   00:60A4                      ;*** Always flags the SSH check as done.   ***
    6877   00:60A4                      ;*** If ESP32, flags it and probes if SSH  ***
    6878   00:60A4                      ;*** commands are supported.               ***
    6879   00:60A4                      ;*** If ESP32, NZ will be set and A = 1, if***
    6880   00:60A4                      ;*** not NZ will be reset and A=0          ***
    6881   00:60A4                      ;*********************************************
    6882   00:60A4                      CHECK_ESP_TYPE:
    6883   00:60A4  E5                      push    hl
    6884   00:60A5  D5                      push    de
    6885   00:60A6  FD E5                   push    iy
    6886   00:60A8  DD E5                   push    ix
    6887   00:60AA                          CLEAR_UART                      ; Clear UART
    6887   00:60AA  3E 14             >     ld  a,20
    6887   00:60AC  D3 06             >     out (OUT_CMD_PORT),a
    6888   00:60AE  3E 62                   ld  a,CMD_GET_FW_TYPE
    6889   00:60B0                          SEND_DATA
    6889   00:60B0  D3 07             >     out (OUT_TX_PORT),a
    6890   00:60B2  21 06 00                ld  hl,6                        ; Wait up to 100ms
    6891   00:60B5  ED 5B 76 F6             ld  de,(TXTTAB)                 ; Borrow Basic program area for now....
    6892   00:60B9  DD 6B                   ld  ixl,e
    6893   00:60BB  DD 62                   ld  ixh,d                       ; Address in IX
    6894   00:60BD  CD 38 4B                call    WAIT_MENU_CMD_RESPONSE
    6895   00:60C0  F5                      push    af                      ; Keep result (1 = ESP32, 0 = not)
    6896   00:60C1  CD 4C 5E                call    GETSLT
    6897   00:60C4  CD B9 5E                call    GETMEMPOINTERADDR       ; This is where we are going to store our memory area address
    6898   00:60C7  11 02 00                ld  de,2
    6899   00:60CA  19                      add hl,de                       ; HL = our flags byte
    6900   00:60CB  F1                      pop af
    6901   00:60CC  28 0A                   jr  z,CHECK_ESP_TYPE_NO32
    6902   00:60CE                          ; ESP32 found: probed + ESP32, then check SSH support
    6903   00:60CE  36 81                   ld  (hl),ESPFLAG_SSH_PROBED+ESPFLAG_ESP32
    6904   00:60D0  CD E2 60                call    PROBE_ESP_SSH           ; Sets/clears ESPFLAG_SSH
    6905   00:60D3  3E 01                   ld  a,1
    6906   00:60D5  B7                      or  a                           ; NZ = ESP32, as before
    6907   00:60D6  18 03                   jr  CHECK_ESP_TYPE_END
    6908   00:60D8                      CHECK_ESP_TYPE_NO32:
    6909   00:60D8                          ; No ESP32 means no SSH support either, and SSH was probed
    6910   00:60D8  36 80                   ld  (hl),ESPFLAG_SSH_PROBED
    6911   00:60DA  AF                      xor a                           ; Z = not ESP32, as before
    6912   00:60DB                      CHECK_ESP_TYPE_END:
    6913   00:60DB  DD E1                   pop ix
    6914   00:60DD  FD E1                   pop iy
    6915   00:60DF  D1                      pop de
    6916   00:60E0  E1                      pop hl
    6917   00:60E1  C9                      ret
    6918   00:60E2                      
    6919   00:60E2                      ;*********************************************
    6920   00:60E2                      ;***             PROBE_ESP_SSH             ***
    6921   00:60E2                      ;*** Sends an SSH GET_CAPAB request for    ***
    6922   00:60E2                      ;*** block 1 (81h 00h 01h 01h) and accepts ***
    6923   00:60E2                      ;*** 81h 00h or 81h 04h as SSH support.    ***
    6924   00:60E2                      ;*** Sets/clears ESPFLAG_SSH and marks the ***
    6925   00:60E2                      ;*** check as done. Called from boot only. ***
    6926   00:60E2                      ;*** Output: NZ if SSH is supported        ***
    6927   00:60E2                      ;*********************************************
    6928   00:60E2                      PROBE_ESP_SSH:
    6929   00:60E2  C5                      push    bc
    6930   00:60E3  D5                      push    de
    6931   00:60E4  E5                      push    hl
    6932   00:60E5  CD 4C 5E                call    GETSLT
    6933   00:60E8  CD B9 5E                call    GETMEMPOINTERADDR
    6934   00:60EB  11 02 00                ld  de,2
    6935   00:60EE  19                      add hl,de                       ; Our flags byte
    6936   00:60EF  E5                      push    hl                      ; Keep its address
    6937   00:60F0  CB FE                   set 7,(hl)                      ; SSH check is done
    6938   00:60F2  CB 8E                   res 1,(hl)                      ; Assume SSH is not supported
    6939   00:60F4                          CLEAR_UART                      ; Clear UART
    6939   00:60F4  3E 14             >     ld  a,20
    6939   00:60F6  D3 06             >     out (OUT_CMD_PORT),a
    6940   00:60F8  3E 81                   ld  a,#81                       ; SSH GET_CAPAB command
    6941   00:60FA                          SEND_DATA
    6941   00:60FA  D3 07             >     out (OUT_TX_PORT),a
    6942   00:60FC  AF                      xor a
    6943   00:60FD                          SEND_DATA                       ; Command size MSB
    6943   00:60FD  D3 07             >     out (OUT_TX_PORT),a
    6944   00:60FF  3C                      inc a
    6945   00:6100                          SEND_DATA                       ; Command size LSB
    6945   00:6100  D3 07             >     out (OUT_TX_PORT),a
    6946   00:6102                          SEND_DATA                       ; Block index (1)
    6946   00:6102  D3 07             >     out (OUT_TX_PORT),a
    6947   00:6104  21 02 00                ld  hl,2                        ; Wait up to 2 frames
    6948   00:6107                      PROBE_ESP_SSH_ST1:
    6949   00:6107                          CHECK_DATA
    6949   00:6107  DB 07             >     in  a,(IN_STS_PORT)
    6949   00:6109  CB 47             >     bit 0,a
    6950   00:610B  20 07                   jr  nz,PROBE_ESP_SSH_ST1.1
    6951   00:610D  CD 46 4C                call    HLTIMEOUT
    6952   00:6110  20 F5                   jr  nz,PROBE_ESP_SSH_ST1
    6953   00:6112  18 20                   jr  PROBE_ESP_SSH_END           ; Time-out, not supported
    6954   00:6114                      PROBE_ESP_SSH_ST1.1:
    6955   00:6114                          RECEIVE_DATA
    6955   00:6114  DB 06             >     in a,(IN_DATA_PORT)
    6956   00:6116  FE 81                   cp  #81                         ; Is response of our command?
    6957   00:6118  20 ED                   jr  nz,PROBE_ESP_SSH_ST1
    6958   00:611A                      PROBE_ESP_SSH_ST2:
    6959   00:611A                          CHECK_DATA
    6959   00:611A  DB 07             >     in  a,(IN_STS_PORT)
    6959   00:611C  CB 47             >     bit 0,a
    6960   00:611E  20 07                   jr  nz,PROBE_ESP_SSH_ST2.1
    6961   00:6120  CD 46 4C                call    HLTIMEOUT
    6962   00:6123  20 F5                   jr  nz,PROBE_ESP_SSH_ST2
    6963   00:6125  18 0D                   jr  PROBE_ESP_SSH_END           ; Time-out, not supported
    6964   00:6127                      PROBE_ESP_SSH_ST2.1:
    6965   00:6127                          RECEIVE_DATA
    6965   00:6127  DB 06             >     in a,(IN_DATA_PORT)
    6966   00:6129  B7                      or  a                           ; Error code 0?
    6967   00:612A  28 04                   jr  z,PROBE_ESP_SSH_OK
    6968   00:612C  FE 04                   cp  4                           ; Error code 4?
    6969   00:612E  20 04                   jr  nz,PROBE_ESP_SSH_END        ; Anything else, not supported
    6970   00:6130                      PROBE_ESP_SSH_OK:
    6971   00:6130  E1                      pop hl
    6972   00:6131  CB CE                   set 1,(hl)                      ; SSH is supported
    6973   00:6133  E5                      push    hl
    6974   00:6134                      PROBE_ESP_SSH_END:
    6975   00:6134                          CLEAR_UART                      ; Consume/discard remaining response
    6975   00:6134  3E 14             >     ld  a,20
    6975   00:6136  D3 06             >     out (OUT_CMD_PORT),a
    6976   00:6138  E1                      pop hl
    6977   00:6139  7E                      ld  a,(hl)
    6978   00:613A  E6 02                   and ESPFLAG_SSH
    6979   00:613C  E1                      pop hl
    6980   00:613D  D1                      pop de
    6981   00:613E  C1                      pop bc
    6982   00:613F  C9                      ret
    6983   00:6140                      
    6984   00:6140                      ;*********************************************
    6985   00:6140                      ;***         PRINT_INSTALLED_MSG           ***
    6986   00:6140                      ;*** ESP8266: prints installed message.    ***
    6987   00:6140                      ;*** ESP32: uses the 'b' (Get Board)       ***
    6988   00:6140                      ;*** command to print the board ID.        ***
    6989   00:6140                      ;*********************************************
    6990   00:6140                      PRINT_INSTALLED_MSG:
    6991   00:6140  C5                      push    bc
    6992   00:6141  D5                      push    de
    6993   00:6142  FD E5                   push    iy
    6994   00:6144  DD E5                   push    ix
    6995   00:6146  CD D1 5F                call    GETESPTYPE
    6996   00:6149  28 46                   jr  z,PRINT_INST_8266           ; Not an ESP32, no need to ask
    6997   00:614B                          ; ESP32, let's get the board identification string
    6998   00:614B                          CLEAR_UART                      ; Clear UART
    6998   00:614B  3E 14             >     ld  a,20
    6998   00:614D  D3 06             >     out (OUT_CMD_PORT),a
    6999   00:614F  3E 62                   ld  a,CMD_GET_FW_TYPE           ; 'b' Get Board, ESP32 only
    7000   00:6151                          SEND_DATA
    7000   00:6151  D3 07             >     out (OUT_TX_PORT),a
    7001   00:6153  21 06 00                ld  hl,6                        ; Wait up to 100ms
    7002   00:6156  ED 5B 76 F6             ld  de,(TXTTAB)                 ; Borrow Basic program area for now....
    7003   00:615A  DD 6B                   ld  ixl,e
    7004   00:615C  DD 62                   ld  ixh,d                       ; Address in IX
    7005   00:615E  CD 38 4B                call    WAIT_MENU_CMD_RESPONSE
    7006   00:6161  28 26                   jr  z,PRINT_INST_32             ; No answer, just tell it is an ESP32
    7007   00:6163                          ; Response size is in BC, board ID copied at (TXTTAB)
    7008   00:6163  78                      ld  a,b
    7009   00:6164  B7                      or  a                           ; Size above 255?
    7010   00:6165  20 22                   jr  nz,PRINT_INST_32            ; Then just tell it is an ESP32
    7011   00:6167  79                      ld  a,c
    7012   00:6168  B7                      or  a                           ; Size zero?
    7013   00:6169  28 1E                   jr  z,PRINT_INST_32             ; Then just tell it is an ESP32
    7014   00:616B  FE 18                   cp  24                          ; More than 23 chars?
    7015   00:616D  30 1A                   jr  nc,PRINT_INST_32            ; Then just tell it is an ESP32
    7016   00:616F  2A 76 F6                ld  hl,(TXTTAB)
    7017   00:6172  09                      add hl,bc
    7018   00:6173  36 00                   ld  (hl),0                      ; Ensure the string is terminated
    7019   00:6175  21 7D 6F                ld  hl,OK_INST_PRE              ; "Installed "
    7020   00:6178  CD 4C 4C                call    PRINTHL
    7021   00:617B  2A 76 F6                ld  hl,(TXTTAB)
    7022   00:617E  CD 4C 4C                call    PRINTHL                 ; Board identification string
    7023   00:6181  21 88 6F                ld  hl,OK_INST_SUF              ; " successfully!"
    7024   00:6184  CD 4C 4C                call    PRINTHL
    7025   00:6187  18 0E                   jr  PRINT_INST_END
    7026   00:6189                      PRINT_INST_32:
    7027   00:6189  21 5C 6F                ld  hl,OK_ESP32                 ; Installed ESP32 successfully!
    7028   00:618C  CD 4C 4C                call    PRINTHL
    7029   00:618F  18 06                   jr  PRINT_INST_END
    7030   00:6191                      PRINT_INST_8266:
    7031   00:6191  21 39 6F                ld  hl,OK_ESP8266               ; Installed ESP8266 successfully!
    7032   00:6194  CD 4C 4C                call    PRINTHL
    7033   00:6197                      PRINT_INST_END:
    7034   00:6197  DD E1                   pop ix
    7035   00:6199  FD E1                   pop iy
    7036   00:619B  D1                      pop de
    7037   00:619C  C1                      pop bc
    7038   00:619D  C9                      ret
    7039   00:619E                      
    7040   00:619E                      ;*********************************************
    7041   00:619E                      ;***              RESET ESP                ***
    7042   00:619E                      ;*** If RESET ok, A will be 0, otherwise   ***
    7043   00:619E                      ;*** failure                               ***
    7044   00:619E                      ;*********************************************
    7045   00:619E                      RESET_ESP:
    7046   00:619E                          ; Is ESP installed?
    7047   00:619E                          CLEAR_UART                      ; Clear UART
    7047   00:619E  3E 14             >     ld  a,20
    7047   00:61A0  D3 06             >     out (OUT_CMD_PORT),a
    7048   00:61A2  3E 3F                   ld  a,CMD_QUERY_ESP
    7049   00:61A4                          SEND_DATA
    7049   00:61A4  D3 07             >     out (OUT_TX_PORT),a
    7050   00:61A6  21 38 63                ld  hl,RSP_CMD_QUERY_ESP        ; Expected response
    7051   00:61A9  11 3C 00                ld  de,60                       ; Up to 1s @ 60Hz
    7052   00:61AC  3E 02                   ld  a,RSP_CMD_QUERY_ESP_SIZE    ; Size of response
    7053   00:61AE  CD 75 60                call    WAIT_RESPONSE_FROM_ESP
    7054   00:61B1  B7                      or  a
    7055   00:61B2  3E 01                   ld  a,1
    7056   00:61B4  28 03                   jr  z,RESET_ESP_INIT            ; ESP Found
    7057   00:61B6  06 00                   ld  b,0                         ; 0 if no response
    7058   00:61B8  C9                      ret
    7059   00:61B9                      RESET_ESP_INIT:
    7060   00:61B9  06 03                   ld  b,3                         ; Retry up to 10 times
    7061   00:61BB                      RESET_ESP_LOOP:
    7062   00:61BB                          CLEAR_UART
    7062   00:61BB  3E 14             >     ld  a,20
    7062   00:61BD  D3 06             >     out (OUT_CMD_PORT),a
    7063   00:61BF                          SET_SPEED
    7063   00:61BF  AF                >     xor a
    7063   00:61C0  D3 06             >     out (OUT_CMD_PORT),a
    7064   00:61C2  76                      halt
    7065   00:61C3  76                      halt                            ; Wait a little to make sure speed is adjusted
    7066   00:61C4  3E 57                   ld  a,CMD_WRESET_ESP
    7067   00:61C6                          SEND_DATA
    7067   00:61C6  D3 07             >     out (OUT_TX_PORT),a
    7068   00:61C8  21 33 63                ld  hl,RSP_CMD_RESET_ESP        ; Expected response
    7069   00:61CB  11 5A 00                ld  de,90                       ; Up to 1.5s @ 60Hz
    7070   00:61CE  3E 05                   ld  a,RSP_CMD_RESET_ESP_SIZE    ; Size of response
    7071   00:61D0  C5                      push    bc                      ; Save retry counter
    7072   00:61D1  CD 75 60                call    WAIT_RESPONSE_FROM_ESP
    7073   00:61D4  C1                      pop bc                          ; restore retry counter
    7074   00:61D5  B7                      or  a                           ; Did WAIT RESPONSE return zero?
    7075   00:61D6  C8                      ret z                           ; Yes, Warm Reset Ok
    7076   00:61D7  10 E2                   djnz RESET_ESP_LOOP             ; No, decrement retry counter and let the loop check
    7077   00:61D9                          ; No more retries? Then check if it is old ESP FW
    7078   00:61D9                      RESET_CHK_IF_INSTALLED:
    7079   00:61D9                          ; No more retries? Then it is old ESP FW
    7080   00:61D9  06 01                   ld  b,1
    7081   00:61DB  C9                      ret
    7082   00:61DC                      
    7083   00:61DC                      ;*********************************************
    7084   00:61DC                      ;***              SET TIME                 ***
    7085   00:61DC                      ;*** H - Hour                              ***
    7086   00:61DC                      ;*** L - Minutes                           ***
    7087   00:61DC                      ;*** D - Seconds                           ***
    7088   00:61DC                      ;***                                       ***
    7089   00:61DC                      ;*** A - 0 if Ok otherwise invalid time    ***
    7090   00:61DC                      ;*********************************************
    7091   00:61DC                      SET_TIME:
    7092   00:61DC  7C                      ld  a,h                         ; Hour in A
    7093   00:61DD  FE 18                   cp  24                          ; Compare to 24
    7094   00:61DF  30 12                   jr  nc,SET_TIME_ERR             ; If 24 or more, invalid
    7095   00:61E1  7D                      ld  a,l                         ; Minutes in A
    7096   00:61E2  FE 3C                   cp  60                          ; Compare to 60
    7097   00:61E4  30 0D                   jr  nc,SET_TIME_ERR             ; If 60 or more, invalid
    7098   00:61E6  7A                      LD  a,d                         ; Seconds in D
    7099   00:61E7  FE 3C                   cp  60                          ; Compare to 60
    7100   00:61E9  30 08                   jr  nc,SET_TIME_ERR             ; If 60 or more invalid
    7101   00:61EB  44                      ld  b,h                         ; Hour in B
    7102   00:61EC  4D                      ld  c,l                         ; Minutes in C
    7103   00:61ED  5A                      ld  e,d                         ; Seconds in E
    7104   00:61EE  CD F6 61                call    SET_RTC_TIME            ; Set time in RTC
    7105   00:61F1  AF                      xor a                           ; 0 in A
    7106   00:61F2  C9                      ret                             ; Return
    7107   00:61F3                      ;   Invalid parameter
    7108   00:61F3                      SET_TIME_ERR:
    7109   00:61F3  3E 01                   ld  a,1                         ; Invalid Time
    7110   00:61F5  C9                      ret                             ; Return
    7111   00:61F6                      
    7112   00:61F6                      SET_RTC_TIME:
    7113   00:61F6  6B                      ld  l,e                         ; Seconds in L
    7114   00:61F7  61                      ld  h,c                         ; Minutes in H
    7115   00:61F8  50                      ld  d,b                         ; Hour in D
    7116   00:61F9  CD 51 62                call    STOP_RTC_COUNT_SET_MODE0; Select RTC Register 13, and set Mode / Page 0
    7117   00:61FC  3E 0F                   ld  a,#F                        ; Register F
    7118   00:61FE  D3 B4                   out (#B4),a
    7119   00:6200  3E 02                   ld  a,2
    7120   00:6202  D3 B5                   out (#B5),a                     ; Timer reset seconds and on both clock pulses
    7121   00:6204  1E 00                   ld  e,0                         ; Start at register 0
    7122   00:6206  C3 8C 62                jp  SET_RTC_DATE.1              ; And save L, H and D, function will return from there
    7123   00:6209                      
    7124   00:6209                      ;*********************************************
    7125   00:6209                      ;***              SET DATE                 ***
    7126   00:6209                      ;*** HL - Year from 1980 to 2079           ***
    7127   00:6209                      ;*** D - Month from 1 to 12                ***
    7128   00:6209                      ;*** E - Day from 1 to 31                  ***
    7129   00:6209                      ;***                                       ***
    7130   00:6209                      ;*** A - 0 if Ok otherwise invalid Date    ***
    7131   00:6209                      ;*********************************************
    7132   00:6209                      SET_DATE:
    7133   00:6209  01 44 F8                ld  bc,#F844
    7134   00:620C  09                      add hl,bc
    7135   00:620D  30 32                   jr  nc,SET_DATE_ERR             ; No carry -> Year is less than 1980, invalid date
    7136   00:620F  7C                      ld  a,h
    7137   00:6210  B7                      or  a
    7138   00:6211  20 2E                   jr  nz,SET_DATE_ERR             ; If H is set, means year is greater than 2235 ,invalid
    7139   00:6213  7D                      ld  a,l
    7140   00:6214  FE 64                   cp  100
    7141   00:6216  30 29                   jr  nc,SET_DATE_ERR             ; If L >= 100 year is greater than 2079, invalid
    7142   00:6218  47                      ld  b,a                         ; Year - 1980 in B
    7143   00:6219  7A                      ld  a,d                         ; Now test month
    7144   00:621A  3D                      dec a
    7145   00:621B  FE 0C                   cp  12                          ; If 12 or less this should carry
    7146   00:621D  30 22                   jr  nc,SET_DATE_ERR             ; otherwise invalid
    7147   00:621F  21 44 62                ld  hl,DAYS_IN_MONTH            ; Days in Month table
    7148   00:6222  85                      add a,l                         ; add our month
    7149   00:6223  6F                      ld  l,a                         ; back in L
    7150   00:6224  30 01                   jr  nc,SET_DATE1                ; no carry done
    7151   00:6226  24                      inc h                           ; otherwise increase H
    7152   00:6227                      SET_DATE1:
    7153   00:6227  3E 1C                   ld  a,28                        ; 28 days
    7154   00:6229  BE                      cp  (hl)                        ; If month is 28 days, February, need to check if leap and limit is 29 in this year
    7155   00:622A  20 08                   jr  nz,SET_DATE2                ; if not, skip below code , so probably above check is if month is february
    7156   00:622C  78                      ld  a,b                         ; Year - 1980 in A again
    7157   00:622D  E6 03                   and 3                           ; if other than 0, non divisible per 4, so not a leap year
    7158   00:622F  20 03                   jr  nz,SET_DATE2                ; Regular year
    7159   00:6231  21 50 62                ld  hl,DAYS_IN_FEBRUARY_LEAP    ; HL has address of 29 days, maximum number of days for february in leap year
    7160   00:6234                      SET_DATE2:
    7161   00:6234  7B                      ld  a,e                         ; Day of month in A
    7162   00:6235  3D                      dec a                           ; Decrement
    7163   00:6236  BE                      cp  (hl)                        ; Compare with Days in month
    7164   00:6237  30 08                   jr  nc,SET_DATE_ERR             ; If day is greater than how many days in month, invalid
    7165   00:6239  6B                      ld  l,e                         ; Day of month in L
    7166   00:623A  62                      ld  h,d                         ; Month in H
    7167   00:623B  50                      ld  d,b                         ; Year - 1980 in D
    7168   00:623C  CD 76 62                call    SET_RTC_DATE            ; Set date in RTC
    7169   00:623F  AF                      xor a                           ; A = 0
    7170   00:6240  C9                      ret                             ; Success
    7171   00:6241                      ;   Invalid parameter
    7172   00:6241                      SET_DATE_ERR:
    7173   00:6241  3E 01                   ld  a,1
    7174   00:6243  C9                      ret
    7175   00:6244                      
    7176   00:6244                      ; Table of top day value for each month
    7177   00:6244                      DAYS_IN_MONTH:          db  31,28,31,30,31,30,31,31,30,31,30,31
    7177   00:6244  1F 1C 1F 1E 1F 1E 1F 1F 1E 1F 1E 1F 
    7178   00:6250                      ; And top day value in February when Leap Year
    7179   00:6250  1D                  DAYS_IN_FEBRUARY_LEAP:  db  29
    7180   00:6251                      
    7181   00:6251                      ; Will select Mode 00 (Date and Time page) and stop clock counting
    7182   00:6251                      ; Register D value will be left in A
    7183   00:6251                      STOP_RTC_COUNT_SET_MODE0:
    7184   00:6251  3E 0D                   ld  a,#D
    7185   00:6253  D3 B4                   out (#B4),a                     ; Select RTC register D (mode)
    7186   00:6255  DB B5                   in  a,(#B5)                     ; read register D
    7187   00:6257  E6 04                   and 4                           ; Save Alarm EN setting, and mode register is 00 and stop counting time
    7188   00:6259  D3 B5                   out (#B5),a                     ; And save
    7189   00:625B  C9                      ret
    7190   00:625C                      
    7191   00:625C                      ; Will get a non BCD value in A, convert it to BCD and then save it in
    7192   00:625C                      ; a register pair that starts in the register indicated in E
    7193   00:625C                      ; Register E will have the next register after that register pair
    7194   00:625C                      RTC_SAVE_REGISTERPAIR:
    7195   00:625C  4F                      ld  c,a                         ; Save A in C
    7196   00:625D  AF                      xor a                           ; 0 in A
    7197   00:625E  06 08                   ld  b,8                         ; 8 in B, number of bits for conversion
    7198   00:6260                      RTC_SAVE_REGISTERPAIR.1:
    7199   00:6260  CB 01                   rlc c                           ; Leftmost bit in Carry
    7200   00:6262  8F                      adc a,a                         ; A = (A * 2) + Carry
    7201   00:6263  27                      daa                             ; decimal adjust A, shift = BCD x 2 + carry
    7202   00:6264  10 FA                   djnz    RTC_SAVE_REGISTERPAIR.1 ; Repeat for 8 bits
    7203   00:6266  CD 6D 62                call    SET_RTC_REG             ; Save LSB in register and increase register address
    7204   00:6269  0F                      rrca
    7205   00:626A  0F                      rrca
    7206   00:626B  0F                      rrca
    7207   00:626C  0F                      rrca                            ; now MSB is in LSB position
    7208   00:626D                      SET_RTC_REG:
    7209   00:626D  47                      ld  b,a                         ; save value to set in B
    7210   00:626E  7B                      ld  a,e                         ; and now register address in A
    7211   00:626F  D3 B4                   out (#B4),a                     ; The register we want to set
    7212   00:6271  78                      ld  a,b                         ; restore value
    7213   00:6272  D3 B5                   out (#B5),a                     ; save it
    7214   00:6274  1C                      inc e                           ; increase register address, as this usually is done in pairs
    7215   00:6275  C9                      ret
    7216   00:6276                      
    7217   00:6276                      ; Auxiliary function for SET_DATE and SET_TIME
    7218   00:6276                      ; SET_RTC_DATE will save date, parameters:
    7219   00:6276                      ; L - Day
    7220   00:6276                      ; H - Month
    7221   00:6276                      ; D - Years since 1980
    7222   00:6276                      ; All values are regular values, this function will properly convert them
    7223   00:6276                      ;
    7224   00:6276                      ; SET_RTC_DATE.1 is used by SET_TIME as well
    7225   00:6276                      ; It will save three register pairs, starting with the register in E
    7226   00:6276                      ; First pair is updated with value in L
    7227   00:6276                      ; Second pair is updated with value in H
    7228   00:6276                      ; Third pair is updated with value in D
    7229   00:6276                      SET_RTC_DATE:
    7230   00:6276  CD 51 62                call    STOP_RTC_COUNT_SET_MODE0; Select RTC Register 13, and set Mode / Page 0
    7231   00:6279  F6 01                   or  1                           ; Set Bit 0, so Mode / Page 1
    7232   00:627B  D3 B5                   out (#B5),a                     ; save it in register 13, now page 1 selected
    7233   00:627D  3E 0B                   ld  a,#B                        ; Leap Year Counter Register
    7234   00:627F  D3 B4                   out (#B4),a                     ; Select it
    7235   00:6281  7A                      ld  a,d                         ; Load Years in leap year counter
    7236   00:6282  D3 B5                   out (#B5),a                     ; So it has count of leap years (0 is 1980, leap, and every time it is 4, leap year again)
    7237   00:6284  CD 51 62                call    STOP_RTC_COUNT_SET_MODE0; Select RTC Register 13 and set mode / page 0
    7238   00:6287  CD 51 62                call    STOP_RTC_COUNT_SET_MODE0; do it a second time... DOS does it, don't want to JYNX it :P
    7239   00:628A  1E 07                   ld  e,7                         ; Register 7
    7240   00:628C                      SET_RTC_DATE.1:
    7241   00:628C  7D                      ld  a,l                         ; A has day
    7242   00:628D  CD 5C 62                call    RTC_SAVE_REGISTERPAIR   ; Will convert day to BCD and save in registers 7 and 8
    7243   00:6290  7C                      ld  a,h                         ; A has month
    7244   00:6291  CD 5C 62                call    RTC_SAVE_REGISTERPAIR   ; Will convert month to BCD and save in register 9 and A
    7245   00:6294  7A                      ld  a,d                         ; A has how many years since 1980
    7246   00:6295  CD 5C 62                call    RTC_SAVE_REGISTERPAIR   ; Will convert to BCD and save in register B and C
    7247   00:6298  3E 0D                   ld  a,#D                        ; Register D
    7248   00:629A  D3 B4                   out (#B4),a                     ; Send it
    7249   00:629C  DB B5                   in  a,(#B5)                     ; Read its value
    7250   00:629E  F6 08                   or  8                           ; Start counting time again
    7251   00:62A0  D3 B5                   out (#B5),a                     ; Send
    7252   00:62A2  C9                      ret
    7253   00:62A3                      
    7254   00:62A3                      ; Pattern setup routine
    7255   00:62A3                      PATTERN_SETUP:
    7256   00:62A3  AF                      xor a                           ; Bit-16, V9938 and V9958 only
    7257   00:62A4  21 88 00                ld  hl,#0088                    ; Bit-15 to 0, pattern base address = #0088
    7258   00:62A7  CD 17 63                call SET_VDP_WRITE
    7259   00:62AA  21 B7 62                ld  hl,PATTERN_DATA             ; Point to hl
    7260   00:62AD  06 60                   ld  b,8*12                      ; Redraw 12 chars, max 12 chars are suggested
    7261   00:62AF  0E 98                   ld  c,#98                       ; port #98
    7262   00:62B1                      OUTI_TO_VRAM_TMS9918:
    7263   00:62B1  ED A3                   outi                            ; Slower than otir but useful on TMS9918 which requires 29 T-states
    7264   00:62B3  C2 B1 62                jp  nz,OUTI_TO_VRAM_TMS9918     ; Therefore, don't use 'djnz' here!
    7265   00:62B6  C9                      ret
