    5074   00:5953  1B                      dec de
    5075   00:5954  14                      inc d
    5076   00:5955                          if USE_MEM_IO = 0
    5077   00:5955  0E 07                   ld  c,OUT_TX_PORT
    5078   00:5957                      SSH_SEND_R:
    5079   00:5957  ED A3                   outi
    5080   00:5959  20 FC                   jr  nz,SSH_SEND_R
