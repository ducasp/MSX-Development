    4448   00:563F                    ~     endif
    4449   00:563F  20 F1                   jr  nz,SSH_OPEN_HOSTHASH_NSF
    4450   00:5641  15                      dec d
    4451   00:5642  20 EE                   jr nz,SSH_OPEN_HOSTHASH_NSF
    4452   00:5644                          ; restore BC to get conn # in B
    4453   00:5644  C1                      pop bc
    4454   00:5645                          ; if we are here, return code is 132, unknown host
    4455   00:5645  3E 84                   ld  a,132
    4456   00:5647  C9                      ret
