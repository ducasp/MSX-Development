    2416   00:4D5D                      ;===  Functions addresses table  ===
    2417   00:4D5D                      ;===            TCP/IP           ===
    2418   00:4D5D                      ;===================================
    2419   00:4D5D                      ;--- Implementation-specific routines addresses table
    2420   00:4D5D                      FN_TABLE:
    2421   00:4D5D  EC 4D               FN_0:                   dw  UNAPI_GET_INFO
    2422   00:4D5F  9D 4E               FN_1:                   dw  TCPIP_GET_CAPAB
    2423   00:4D61  CD 4F               FN_2:                   dw  TCPIP_GET_IPINFO
    2424   00:4D63  4A 50               FN_3:                   dw  TCPIP_NET_STATE
    2425   00:4D65                      ; TCPIP_SEND_ECHO not going to be implemented, ESP do not support ping like UNAPI specify
    2426   00:4D65  D7 4D               FN_4:                   dw  FN_NOT_IMP
    2427   00:4D67                      ; TCPIP_RCV_ECHO not going to be implemented as SEND_ECHO is not implemented
    2428   00:4D67  D7 4D               FN_5:                   dw  FN_NOT_IMP
    2429   00:4D69  99 50               FN_6:                   dw  TCPIP_DNS_Q
    2430   00:4D6B  48 51               FN_7:                   dw  TCPIP_DNS_S
    2431   00:4D6D  75 51               FN_8:                   dw  TCPIP_UDP_OPEN
    2432   00:4D6F  CF 51               FN_9:                   dw  TCPIP_UDP_CLOSE
    2433   00:4D71  15 52               FN_10:                  dw  TCPIP_UDP_STATE
    2434   00:4D73  A0 52               FN_11:                  dw  TCPIP_UDP_SEND
    2435   00:4D75  3F 53               FN_12:                  dw  TCPIP_UDP_RCV
    2436   00:4D77  69 54               FN_13:                  dw  TCPIP_TCP_OPEN
    2437   00:4D79  3D 55               FN_14:                  dw  TCPIP_TCP_CLOSE
    2438   00:4D7B  27 5A               FN_15:                  dw  TCPIP_TCP_ABORT
    2439   00:4D7D  90 5A               FN_16:                  dw  TCPIP_TCP_STATE
    2440   00:4D7F  95 5B               FN_17:                  dw  TCPIP_TCP_SEND
    2441   00:4D81  D9 5C               FN_18:                  dw  TCPIP_TCP_RCV
    2442   00:4D83                      ; TCPIP_TCP_FLUSH makes no sense as we do not use buffers to send, any buffer is internal to ESP and we can't delete
    2443   00:4D83  D7 4D               FN_19:                  dw  FN_NOT_IMP
    2444   00:4D85                      ; TCPIP_RAW_OPEN not going to be implemented, ESP do not support RAW connections
    2445   00:4D85  D7 4D               FN_20:                  dw  FN_NOT_IMP
    2446   00:4D87                      ; TCPIP_RAW_CLOSE not going to be implemented, ESP do not support RAW connections
    2447   00:4D87  D7 4D               FN_21:                  dw  FN_NOT_IMP
    2448   00:4D89                      ; TCPIP_RAW_STATE not going to be implemented, ESP do not support RAW connections
    2449   00:4D89  D7 4D               FN_22:                  dw  FN_NOT_IMP
    2450   00:4D8B                      ; TCPIP_RAW_SEND not going to be implemented, ESP do not support RAW connections
    2451   00:4D8B  D7 4D               FN_23:                  dw  FN_NOT_IMP
    2452   00:4D8D                      ; TCPIP_RAW_RCV not going to be implemented, ESP do not support RAW connections
    2453   00:4D8D  D7 4D               FN_24:                  dw  FN_NOT_IMP
    2454   00:4D8F  89 5F               FN_25:                  dw  TCPIP_CONFIG_AUTOIP
    2455   00:4D91  E0 5F               FN_26:                  dw  TCPIP_CONFIG_IP
    2456   00:4D93  1D 60               FN_27:                  dw  TCPIP_CONFIG_TTL
    2457   00:4D95  2F 60               FN_28:                  dw  TCPIP_CONFIG_PING
    2458   00:4D97                      ; TCPIP_WAIT not needed for our implementation
    2459   00:4D97  DA 4D               FN_29:                  dw  END_OK
    2460   00:4D99                      
    2461   00:4D99                      ;====================================
    2462   00:4D99                      ;===  Functions entry point code  ===
    2463   00:4D99                      ;===             SSH              ===
    2464   00:4D99                      ;====================================
    2465   00:4D99                      UNAPI2_ENTRY:
    2466   00:4D99  FB                      ei
    2467   00:4D9A  E5                      push    hl
    2468   00:4D9B  F5                      push    af
    2469   00:4D9C  21 B7 4D                ld  hl,FN_TABLE_S
    2470   00:4D9F  CB 7F                   bit 7,a
    2471   00:4DA1  20 B7                   jr  nz,UNDEFINED
    2472   00:4DA3                      
    2473   00:4DA3  FE 0F                   cp  MAX_FN_S
    2474   00:4DA5  28 02                   jr  z,OK_FNUM_S
    2475   00:4DA7  30 B1                   jr  nc,UNDEFINED
    2476   00:4DA9                      
    2477   00:4DA9                      OK_FNUM_S:
    2478   00:4DA9  87                      add a,a
    2479   00:4DAA  D5                      push    de
    2480   00:4DAB  5F                      ld  e,a
    2481   00:4DAC  16 00                   ld  d,0
    2482   00:4DAE  19                      add hl,de
    2483   00:4DAF  D1                      pop de
    2484   00:4DB0                      
    2485   00:4DB0  7E                      ld  a,(hl)
    2486   00:4DB1  23                      inc hl
    2487   00:4DB2  66                      ld  h,(hl)
    2488   00:4DB3  6F                      ld  l,a
    2489   00:4DB4                      
    2490   00:4DB4  F1                      pop af
    2491   00:4DB5  E3                      ex  (sp),hl
    2492   00:4DB6  C9                      ret
    2493   00:4DB7                      
    2494   00:4DB7                      ;===================================
    2495   00:4DB7                      ;===  Functions addresses table  ===
    2496   00:4DB7                      ;===             SSH             ===
    2497   00:4DB7                      ;===================================
    2498   00:4DB7                      ;--- Implementation-specific routines addresses table
    2499   00:4DB7                      
    2500   00:4DB7                      FN_TABLE_S:
    2501   00:4DB7  F7 4D               FN_0_S:                 dw  UNAPI_GET_INFO_SSH
    2502   00:4DB9  02 4E               FN_1_S:                 dw  SSH_GET_CAPAB
    2503   00:4DBB  83 55               FN_2_S:                 dw  SSH_OPEN
    2504   00:4DBD  80 58               FN_3_S:                 dw  SSH_CLOSE
    2505   00:4DBF  C8 58               FN_4_S:                 dw  SSH_STATE
    2506   00:4DC1  F1 5B               FN_5_S:                 dw  SSH_SEND
    2507   00:4DC3  BB 5D               FN_6_S:                 dw  SSH_RCV
    2508   00:4DC5  3A 59               FN_7_S:                 dw  SSH_TERM_TYPE
    2509   00:4DC7  A8 59               FN_8_S:                 dw  SSH_WIN_SIZE
    2510   00:4DC9  83 5E               FN_9_S:                 dw  SSH_AUTH_GET_CHALLENGE
    2511   00:4DCB  47 5C               FN_10_S:                dw  SSH_AUTH_RESPOND
    2512   00:4DCD  4F 56               FN_11_S:                dw  SSH_ADD_KNOWN_HOST
    2513   00:4DCF  97 56               FN_12_S:                dw  SSH_KEY_GEN
    2514   00:4DD1  DA 56               FN_13_S:                dw  SSH_KEY_EXPORT
    2515   00:4DD3  90 57               FN_14_S:                dw  SSH_KEY_IMPORT
    2516   00:4DD5  F5 57               FN_15_S:                dw  SSH_KEY_INFO
    2517   00:4DD7                      
    2518   00:4DD7                      ;========================
    2519   00:4DD7                      ;===  Functions code  ===
    2520   00:4DD7                      ;========================
    2521   00:4DD7                      FN_NOT_IMP:
    2522   00:4DD7  3E 01                   ld  a,ERR_NOT_IMP
    2523   00:4DD9  C9                      ret
    2524   00:4DDA                      
    2525   00:4DDA                      END_OK:
    2526   00:4DDA  AF                      xor a
    2527   00:4DDB  C9                      ret
    2528   00:4DDC                      
    2529   00:4DDC                      ; Most functions do not have special handling on time out and can use this.
    2530   00:4DDC                      ; If there is a need to retry sending or receiving on time-out, then a custom
    2531   00:4DDC                      ; time-out function must be done, check the examples of UDP and TCP receive
    2532   00:4DDC                      TCPIP_GENERIC_CHECK_TIME_OUT:
    2533   00:4DDC                          ; Save registers other than AF
    2534   00:4DDC  C5                      push bc
    2535   00:4DDD  D5                      push de
    2536   00:4DDE  E5                      push hl
    2537   00:4DDF  CD D0 60                call    GETCOUNTER
    2538   00:4DE2  7D                      ld  a,l
    2539   00:4DE3  B4                      or  h
    2540   00:4DE4                          ; Restore registers, we are returning
    2541   00:4DE4  E1                      pop hl
    2542   00:4DE5  D1                      pop de
    2543   00:4DE6  C1                      pop bc
    2544   00:4DE7  C0                      ret nz
    2545   00:4DE8                          ; Ok, timeout...
    2546   00:4DE8  F1                      pop af                          ; Get return address of who called this out of the stack
    2547   00:4DE9  3E 0F                   ld  a,ERR_INV_OPER
    2548   00:4DEB  C9                      ret                             ; and return the function itself
    2549   00:4DEC                      
    2550   00:4DEC                      ;========================
    2551   00:4DEC                      ;===  UNAPI_GET_INFO  ===
    2552   00:4DEC                      ;========================
    2553   00:4DEC                      ; Obtain the implementation name and version for TCP/IP.
    2554   00:4DEC                      ;
    2555   00:4DEC                      ;    Input:  A  = 0
    2556   00:4DEC                      ;    Output: HL = Descriptive string for this implementation, on this slot, zero terminated
    2557   00:4DEC                      ;            DE = API version supported, D.E
    2558   00:4DEC                      ;            BC = This implementation version, B.C.
    2559   00:4DEC                      ;            A  = 0 and Cy = 0
    2560   00:4DEC                      UNAPI_GET_INFO:
    2561   00:4DEC  01 03 01                ld  bc,256*ROM_V_P+ROM_V_S
    2562   00:4DEF  11 02 01                ld  de,256*API_V_P+API_V_S
    2563   00:4DF2  21 1B 71                ld  hl,APIINFO
    2564   00:4DF5  AF                      xor a
    2565   00:4DF6  C9                      ret
    2566   00:4DF7                      
    2567   00:4DF7                      ;========================
    2568   00:4DF7                      ;===  UNAPI_GET_INFO  ===
    2569   00:4DF7                      ;========================
    2570   00:4DF7                      ; Obtain the implementation name and version for SSH.
    2571   00:4DF7                      ;
    2572   00:4DF7                      ;    Input:  A  = 0
    2573   00:4DF7                      ;    Output: HL = Descriptive string for this implementation, on this slot, zero terminated
    2574   00:4DF7                      ;            DE = API version supported, D.E
    2575   00:4DF7                      ;            BC = This implementation version, B.C.
    2576   00:4DF7                      ;            A  = 0 and Cy = 0
    2577   00:4DF7                      UNAPI_GET_INFO_SSH:
    2578   00:4DF7  01 03 01                ld  bc,256*ROM_V_P+ROM_V_S
    2579   00:4DFA  11 02 01                ld  de,256*API_V_P+API_V_S
    2580   00:4DFD  21 2C 71                ld  hl,APIINFO_SSH
    2581   00:4E00  AF                      xor a
    2582   00:4E01  C9                      ret
    2583   00:4E02                      
    2584   00:4E02                      ;=========================
    2585   00:4E02                      ;===   SSH_GET_CAPAB   ===
    2586   00:4E02                      ;=========================
    2587   00:4E02                      ; Get information about the SSH capabilities and features.
    2588   00:4E02                      ;
    2589   00:4E02                      ;    Input:  A = 1
    2590   00:4E02                      ;            B = Index of information block to retrieve:
    2591   00:4E02                      ;                1: Block 1 (only block supported, other blocks reserved for expansion)
    2592   00:4E02                      ;    Output: A = Error code
    2593   00:4E02                      ;        When information block 1 requested:
    2594   00:4E02                      ;            HL = Capabilities flags
    2595   00:4E02                      ;            B  = Maximum simultaneous SSH connections supported
    2596   00:4E02                      ;            C  = Free SSH connections currently available
    2597   00:4E02                      ;            DE = Maximum data per command
    2598   00:4E02                      SSH_GET_CAPAB:
    2599   00:4E02                          ; SSH functions start at 127 on ESP
    2600   00:4E02  CB FF                   set 7,a
    2601   00:4E04                          SEND_DATA                       ; Send the command
    2601   00:4E04  D3 07             >     out (OUT_TX_PORT),a
    2602   00:4E06  AF                      xor a
    2603   00:4E07                          SEND_DATA                       ; Send the command size msb
    2603   00:4E07  D3 07             >     out (OUT_TX_PORT),a
    2604   00:4E09  3C                      inc a
    2605   00:4E0A                          SEND_DATA                       ; Send the command size lsb
    2605   00:4E0A  D3 07             >     out (OUT_TX_PORT),a
    2606   00:4E0C  78                      ld  a,b
    2607   00:4E0D                          SEND_DATA                       ; Send the parameter
    2607   00:4E0D  D3 07             >     out (OUT_TX_PORT),a
    2608   00:4E0F                      
    2609   00:4E0F                          ; Now wait up to 120 ticks to get response
    2610   00:4E0F  21 78 00                ld  hl,120
    2611   00:4E12  CD DF 60                call    SETCOUNTER
    2612   00:4E15                      SSH_GET_CAPAB_ST1:
    2613   00:4E15                          CHECK_DATA
    2613   00:4E15  DB 07             >     in  a,(IN_STS_PORT)
    2613   00:4E17  CB 47             >     bit 0,a
    2614   00:4E19  20 05                   jr  nz,SSH_GET_CAPAB_ST1.1
    2615   00:4E1B  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2616   00:4E1E  18 F5                   jr  SSH_GET_CAPAB_ST1
    2617   00:4E20                      SSH_GET_CAPAB_ST1.1:
    2618   00:4E20                          ; nz, check the data
    2619   00:4E20                          RECEIVE_DATA
    2619   00:4E20  DB 06             >     in a,(IN_DATA_PORT)
    2620   00:4E22  FE 81                   cp  #81                         ; Is response of our command?
    2621   00:4E24  20 EF                   jr  nz,SSH_GET_CAPAB_ST1
    2622   00:4E26                          ; Now get return code, if return code other than 0, it is finished
    2623   00:4E26                      SSH_GET_CAPAB_RC:
    2624   00:4E26                          CHECK_DATA
    2624   00:4E26  DB 07             >     in  a,(IN_STS_PORT)
    2624   00:4E28  CB 47             >     bit 0,a
    2625   00:4E2A  20 05                   jr  nz,SSH_GET_CAPAB_RC.1
    2626   00:4E2C  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2627   00:4E2F  18 F5                   jr  SSH_GET_CAPAB_RC
    2628   00:4E31                      SSH_GET_CAPAB_RC.1:
    2629   00:4E31                          ; nz, discard
    2630   00:4E31                          RECEIVE_DATA
    2630   00:4E31  DB 06             >     in a,(IN_DATA_PORT)
    2631   00:4E33  B7                      or  a                           ; 0?
    2632   00:4E34  C0                      ret nz                          ; If not, done
    2633   00:4E35                      
    2634   00:4E35                          ; Next two bytes are size bytes, don't care
    2635   00:4E35  06 02                   ld  b,2
    2636   00:4E37                      SSH_GET_CAPAB_ST2:
    2637   00:4E37                          CHECK_DATA
    2637   00:4E37  DB 07             >     in  a,(IN_STS_PORT)
    2637   00:4E39  CB 47             >     bit 0,a
    2638   00:4E3B  20 05                   jr  nz,SSH_GET_CAPAB_ST2.1
    2639   00:4E3D  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2640   00:4E40  18 F5                   jr  SSH_GET_CAPAB_ST2
    2641   00:4E42                      SSH_GET_CAPAB_ST2.1:
    2642   00:4E42                          ; Nz, discard
    2643   00:4E42                          RECEIVE_DATA
    2643   00:4E42  DB 06             >     in a,(IN_DATA_PORT)
    2644   00:4E44  05                      dec b
    2645   00:4E45  20 F0                   jr  nz,SSH_GET_CAPAB_ST2
    2646   00:4E47                      
    2647   00:4E47                      SSH_GET_CAPAB_BLK1_ST1:
    2648   00:4E47                          CHECK_DATA
    2648   00:4E47  DB 07             >     in  a,(IN_STS_PORT)
    2648   00:4E49  CB 47             >     bit 0,a
    2649   00:4E4B  20 05                   jr  nz,SSH_GET_CAPAB_BLK1_ST1.1
    2650   00:4E4D  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2651   00:4E50  18 F5                   jr  SSH_GET_CAPAB_BLK1_ST1
    2652   00:4E52                      SSH_GET_CAPAB_BLK1_ST1.1:
    2653   00:4E52                          ; nz, get it
    2654   00:4E52                          RECEIVE_DATA
    2654   00:4E52  DB 06             >     in a,(IN_DATA_PORT)
    2655   00:4E54  6F                      ld  l,a
    2656   00:4E55                      SSH_GET_CAPAB_BLK1_ST2:
    2657   00:4E55                          CHECK_DATA
