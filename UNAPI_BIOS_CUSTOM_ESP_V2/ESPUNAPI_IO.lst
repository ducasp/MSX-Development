    3441   00:51D3  D3 07             >     out (OUT_TX_PORT),a
    3442   00:51D5                          ; Now wait up to 180 ticks to get response
    3443   00:51D5  21 B4 00                ld  hl,180
    3444   00:51D8  CD EC 5E                call    SETCOUNTER
    3445   00:51DB                      TCPIP_UDP_CLOSE_ST1:
    3446   00:51DB                          CHECK_DATA
