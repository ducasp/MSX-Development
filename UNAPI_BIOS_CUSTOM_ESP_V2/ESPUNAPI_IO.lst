    1480   00:47E0  CD 4C 4C                call    PRINTHL
    1481   00:47E3  C3 D7 49                jp  WAIT_4S_AND_THEN_MAINMENU
    1482   00:47E6                      
    1483   00:47E6                      INPUT_WFSAP_BAD_INPUT:
    1484   00:47E6  C5                      push    bc
    1485   00:47E7  D5                      push    de
    1486   00:47E8  F5                      push    af
    1487   00:47E9  E5                      push    hl
    1488   00:47EA  DD E5                   push    ix
    1489   00:47EC  FD E5                   push    iy
    1490   00:47EE  CD C0 00                call    BEEP                    ; Wrong Input, beep
    1491   00:47F1  FD E1                   pop iy
    1492   00:47F3  DD E1                   pop ix
    1493   00:47F5  E1                      pop hl
    1494   00:47F6  F1                      pop af
    1495   00:47F7  D1                      pop de
    1496   00:47F8  C1                      pop bc
    1497   00:47F9  C3 29 46                jp WIFI_SELECT_AP               ; Return
    1498   00:47FC                      
    1499   00:47FC                      WIFI_SCAN_NONETWORKS:
    1500   00:47FC  21 45 69                ld  hl,MMENU_SCANN
    1501   00:47FF  CD 4C 4C                call    PRINTHL
    1502   00:4802  C3 D7 49                jp  WAIT_4S_AND_THEN_MAINMENU
    1503   00:4805                      
    1504   00:4805                      WIFI_SCAN_TIMEOUT:
    1505   00:4805  21 25 69                ld  hl,MMENU_SCANF
    1506   00:4808  CD 4C 4C                call    PRINTHL
    1507   00:480B  C3 D7 49                jp  WAIT_4S_AND_THEN_MAINMENU
    1508   00:480E                      
    1509   00:480E                      SET_WIFI_TIMEOUT:
    1510   00:480E  3E 32                   ld  a,'2'
    1511   00:4810  CD A2 00                call    CHPUT
    1512   00:4813  CD E3 49                call    WAIT_250MS_AND_THEN_CONTINUE
    1513   00:4816  21 08 6B                ld  hl,MMENU_TIMEOUT
    1514   00:4819  CD 4C 4C                call    PRINTHL                 ; Print Main Timeout message
    1515   00:481C  CD 50 4A                call    CHECKTIMEOUT            ; TimeOut is on or off?
    1516   00:481F  CA 37 48                jp  z,WIFI_SET_ALWAYS_ON        ; If 0, always on
    1517   00:4822                          ; Otherwise there is a timeout
    1518   00:4822  E5                      push    hl
    1519   00:4823  21 3F 6C                ld hl,MMENU_TIMEOUT_NOTALWAYSON1
    1520   00:4826  CD 4C 4C                call    PRINTHL
    1521   00:4829  E1                      pop hl
    1522   00:482A  CD 4C 4C                call    PRINTHL
    1523   00:482D  21 55 6C                ld hl,MMENU_TIMEOUT_NOTALWAYSON2
    1524   00:4830  CD 4C 4C                call    PRINTHL
    1525   00:4833  16 00                   ld  d,0                         ; Count digits
    1526   00:4835  18 10                   jr  INPUT_TIMEOUT
    1527   00:4837                      WIFI_SET_ALWAYS_ON:
    1528   00:4837  21 EA 6B                ld  hl,MMENU_TIMEOUT_ALWAYSON
    1529   00:483A  CD 4C 4C                call    PRINTHL
    1530   00:483D  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1531   00:4841  DD 6B                   ld  ixl,e
    1532   00:4843  DD 62                   ld  ixh,d                       ; Address in IX
    1533   00:4845  16 00                   ld  d,0                         ; Count digits
    1534   00:4847                      INPUT_TIMEOUT:
    1535   00:4847  CD 9F 00                call    CHGET
    1536   00:484A  FE 1B                   cp  #1b                         ; ESC?
    1537   00:484C  CA 47 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1538   00:484F  FE 0D                   cp  #0d                         ; ENTER?
    1539   00:4851  CA 95 48                jp  z,SET_WIFI_CHECK_INPUT      ; Check if ok
    1540   00:4854  FE 08                   cp  #08                         ; Backspace?
    1541   00:4856  CA 7B 48                jp  z,SET_WIFI_BS_INPUT         ; Check if there is something to erase
    1542   00:4859  FE 30                   cp  '0'                         ; Check if A is less than 0
    1543   00:485B  DA 75 48                jp  c,INPUT_TIMEOUT_BAD_INPUT   ; if it is, ignore
    1544   00:485E  FE 3A                   cp  '9'+1                       ; Check if a is greater than  9
    1545   00:4860  D2 75 48                jp  nc,INPUT_TIMEOUT_BAD_INPUT  ; If it is, ignore
    1546   00:4863  DD 77 00                ld  (ix+0),a                    ; Save it
    1547   00:4866  CD A2 00                call    CHPUT                   ; It is valid, so print it
    1548   00:4869  14                      inc d                           ; Increment digit count
    1549   00:486A  DD 23                   inc ix                          ; Increment pointer
    1550   00:486C  3E 03                   ld  a,3
    1551   00:486E  BA                      cp  d
    1552   00:486F  CA 95 48                jp  z,SET_WIFI_CHECK_INPUT      ; All we can do is accept up to 3 digits, check if ok
    1553   00:4872  C3 47 48                jp  INPUT_TIMEOUT               ; Not done yet, so continue
    1554   00:4875                      
    1555   00:4875                      INPUT_TIMEOUT_BAD_INPUT:
    1556   00:4875  CD C0 00                call    BEEP                    ; Wrong Input, beep
    1557   00:4878  C3 47 48                jp INPUT_TIMEOUT                ; Return
    1558   00:487B                      
    1559   00:487B                      SET_WIFI_BS_INPUT:
    1560   00:487B  AF                      xor a
    1561   00:487C  B2                      or  d                           ; Counter has any digit?
    1562   00:487D  CA 47 48                jp  z,INPUT_TIMEOUT             ; Nope, so just continue
    1563   00:4880  15                      dec d                           ; Decrement counter
    1564   00:4881  DD 2B                   dec ix                          ; Decrement pointer
    1565   00:4883  3E 08                   ld  a,8                         ; Backspace
    1566   00:4885  CD A2 00                call    CHPUT                   ; Print it
    1567   00:4888  3E 20                   ld  a,' '                       ; Space
    1568   00:488A  CD A2 00                call    CHPUT                   ; Print it
    1569   00:488D  3E 08                   ld  a,8                         ; Backspace
    1570   00:488F  CD A2 00                call    CHPUT                   ; Print it
    1571   00:4892  C3 47 48                jp  INPUT_TIMEOUT               ; Return
    1572   00:4895                      
    1573   00:4895                      SET_WIFI_CHECK_INPUT:
    1574   00:4895  AF                      xor a
    1575   00:4896  B2                      or  d                           ; Counter has any digits
    1576   00:4897  CA 47 48                jp  z,INPUT_TIMEOUT             ; Nope, so just continue
    1577   00:489A                          ; IX is pointing one position after last digit, so revert
    1578   00:489A  DD 2B                   dec ix
    1579   00:489C  DD 7E 00                ld  a,(ix+0)                    ; Digit in A
    1580   00:489F  D6 30                   sub '0'                         ; Convert it to decimal
    1581   00:48A1  26 00                   ld  h,0                         ; First digit, so H is 0
    1582   00:48A3  6F                      ld  l,a                         ; And L has the digit
    1583   00:48A4  15                      dec d                           ; If digits finished, just set
    1584   00:48A5  CA D1 48                jp  z,SET_WIFI_EXECUTE_SET_COMMAND
    1585   00:48A8  DD 2B                   dec ix
    1586   00:48AA  DD 7E 00                ld  a,(ix+0)                    ; Digit in A
    1587   00:48AD  D6 30                   sub '0'                         ; Convert it to decimal
    1588   00:48AF  87                      add a,a                         ; A*2
    1589   00:48B0  4F                      ld  c,a                         ; A*2 in C
    1590   00:48B1  87                      add a,a                         ; A*4
    1591   00:48B2  87                      add a,a                         ; A*8
    1592   00:48B3  81                      add a,c                         ; A*10
    1593   00:48B4                          ; Up to here, we can get 90 + 9, 99, won't go to H anyway, just add to L
    1594   00:48B4  85                      add a,l                         ; L has the first digit
    1595   00:48B5  6F                      ld  l,a                         ; And now L has the two digits
    1596   00:48B6  15                      dec d                           ; If digits finished, just set
    1597   00:48B7  CA D1 48                jp  z,SET_WIFI_EXECUTE_SET_COMMAND
    1598   00:48BA  DD 2B                   dec ix
    1599   00:48BC  DD 7E 00                ld  a,(ix+0)                    ; Digit in A
    1600   00:48BF  D6 30                   sub '0'                         ; Convert it to decimal
    1601   00:48C1  87                      add a,a                         ; A*2
    1602   00:48C2  4F                      ld  c,a                         ; A*2 in C
    1603   00:48C3  87                      add a,a                         ; A*4
    1604   00:48C4  87                      add a,a                         ; A*8
    1605   00:48C5  81                      add a,c                         ; A*10
    1606   00:48C6  EB                      ex  de,hl                       ; Get the two digits results in de
    1607   00:48C7  6F                      ld  l,a
    1608   00:48C8  26 00                   ld  h,0                         ; HL = A*10
    1609   00:48CA  29                      add hl,hl                       ; HL = A*20
    1610   00:48CB  4D                      ld  c,l
    1611   00:48CC  44                      ld  b,h                         ; BC = A*20
    1612   00:48CD  29                      add hl,hl                       ; HL = A*40
    1613   00:48CE  29                      add hl,hl                       ; HL = A*80
    1614   00:48CF  09                      add hl,bc                       ; HL = A*100
    1615   00:48D0  19                      add hl,de                       ; HL = three digits result
    1616   00:48D1                          ; This was the last digit, up to three
    1617   00:48D1                      SET_WIFI_EXECUTE_SET_COMMAND:
    1618   00:48D1  C3 23 49                jp  SET_ESP_WIFI_TIMEOUT        ; And set and done
    1619   00:48D4                      
