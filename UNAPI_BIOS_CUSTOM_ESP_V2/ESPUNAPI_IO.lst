    3875   00:53F0  CB 47             >     bit 0,a
    3876   00:53F2  20 05                   jr  nz,TCPIP_UDP_RCV_PORT_ST2.1
    3877   00:53F4  CD 18 53                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3878   00:53F7  18 F5                   jr  TCPIP_UDP_RCV_PORT_ST2
    3879   00:53F9                      TCPIP_UDP_RCV_PORT_ST2.1:
