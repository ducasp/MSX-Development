    2283   00:4CCD  11 22 22                ld  de,#2222
    2284   00:4CD0  C9                      ret
    2285   00:4CD1                      
    2286   00:4CD1                      DO_EXTBIO2:
    2287   00:4CD1                          ; A=1: Return A=Slot, B=Segment, HL=UNAPI entry address
    2288   00:4CD1                      
    2289   00:4CD1  3D                      dec a
    2290   00:4CD2  20 0D                   jr  nz,DO_EXTBIO3
    2291   00:4CD4  E1                      pop hl
    2292   00:4CD5  CD 5F 60                call    GETSLTT                 ; GETSLTT is GETSLT that checks if our memory area @ HIMEM has been allocated, if not, allocate it
    2293   00:4CD8  06 FF                   ld  b,#FF
    2294   00:4CDA  21 3C 4D                ld  hl,UNAPI_ENTRY
    2295   00:4CDD  11 22 22                ld  de,#2222
