    4674   00:5772  D1                      pop     de                      ; DE = bytes to receive
    4675   00:5773                          ; Grauw Optimized 16 bit loop, regular receive only
    4676   00:5773  43                      ld  b,e                         ; B = LSB of count
    4677   00:5774  1B                      dec de
