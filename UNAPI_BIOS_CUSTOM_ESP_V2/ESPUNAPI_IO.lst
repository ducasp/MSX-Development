    3480   00:5215                      ;=========================
    3481   00:5215                      ;===  TCPIP_UDP_STATE  ===
    3482   00:5215                      ;=========================
    3483   00:5215                      ;Get the state of a UDP connection.
    3484   00:5215                      ;
    3485   00:5215                      ;Input:  A = 10
    3486   00:5215                      ;        B = Connection number
    3487   00:5215                      ;Output: A  = Error code
    3488   00:5215                      ;        HL = Local port number
    3489   00:5215                      ;        B  = Number of pending incoming datagrams
    3490   00:5215                      ;        DE = Size of oldest pending incoming datagram (data part only)
    3491   00:5215                      TCPIP_UDP_STATE:
    3492   00:5215                          SEND_DATA                       ; Send the command
    3492   00:5215  D3 07             >     out (OUT_TX_PORT),a
    3493   00:5217  AF                      xor a
    3494   00:5218                          SEND_DATA                       ; Send the command size msb
    3494   00:5218  D3 07             >     out (OUT_TX_PORT),a
