    1313   00:46D3  B9                      cp  c                           ; Has received any data?
    1314   00:46D4  28 84                   jr  z,WIFI_CONNECT_MANUAL_ENTRY ; No
    1315   00:46D6  C3 87 46                jp  WIFI_CONNECT_ME_0_TERM      ; Yes, so handle SSID input termination
    1316   00:46D9                      
    1317   00:46D9                      WIFI_CONNECT_SELECTION_OK:
    1318   00:46D9  CD A2 00                call    CHPUT                   ; Valid input, print it
    1319   00:46DC  1E 30                   ld  e,'0'
    1320   00:46DE  93                      sub a,e                         ; Get in decimal
    1321   00:46DF  5F                      ld  e,a                         ; Back in E
    1322   00:46E0                          ; IX has the AP list, A which one has been selected, now our routine will do it
    1323   00:46E0  3E 0D                   ld  a,#0d
    1324   00:46E2  CD A2 00                call    CHPUT
    1325   00:46E5  3E 0A                   ld  a,#0a
    1326   00:46E7  CD A2 00                call    CHPUT
    1327   00:46EA  DD E5                   push    ix
    1328   00:46EC  E1                      pop hl                          ; put IX in HL
    1329   00:46ED                      WIFI_CONNECT_AP_SRCH:
