    3032   00:5020                      ;            1: Opening
    3033   00:5020                      ;            2: Open
    3034   00:5020                      ;            3: Closing
    3035   00:5020                      ;            255: Unknown
    3036   00:5020                      TCPIP_NET_STATE:
    3037   00:5020                          SEND_DATA                       ; Send the command
    3037   00:5020  D3 07             >     out (OUT_TX_PORT),a
