     173   00:4000  (00:7F06)           MEM_IN_DATA_PORT:       equ #7F06
     174   00:4000  (00:7F07)           MEM_IN_STS_PORT:        equ #7F07
     175   00:4000  (00:7F05)           MEM_PORT_F2:            equ #7F05
     176   00:4000                      
