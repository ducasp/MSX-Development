    2134   00:4C11  B7                      or  a                           ; Terminator of AP Name?
    2135   00:4C12  20 E8                   jr  nz,WAIT_MENU_SCMD_RESPONSE_ST2B
    2136   00:4C14                          ; Get encryption
    2137   00:4C14                      WAIT_MENU_SCMD_RESPONSE_GET_ENC:
    2138   00:4C14                          CHECK_DATA
    2138   00:4C14  DB 07             >     in  a,(IN_STS_PORT)
    2138   00:4C16  CB 47             >     bit 0,a
    2139   00:4C18  20 08                   jr  nz,WAIT_MENU_SCMD_RESPONSE_GET_ENC.1
