    1732   00:49C1  3E 44                   ld  a,CMD_NAGLE_ON
    1733   00:49C3                          SEND_DATA
    1733   00:49C3  D3 07             >     out (OUT_TX_PORT),a
    1734   00:49C5  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1735   00:49C8  CD FF 4A                call    WAIT_MENU_QCMD_RESPONSE
    1736   00:49CB  CA F6 4A                jp  z,MENU_BAD_END
    1737   00:49CE  21 1E 6E                ld  hl,STR_SENDING_OK           ; Success
    1738   00:49D1  CD 4C 4C                call    PRINTHL
