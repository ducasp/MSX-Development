    1720   00:49AF  CD A2 00                call    CHPUT
    1721   00:49B2  21 1A 6F                ld  hl,STR_SENDING              ; Indicate it is sending a command
    1722   00:49B5  CD 47 4C                call    PRINTHL
    1723   00:49B8                          CLEAR_UART
    1723   00:49B8  3E 14             >     ld  a,20
