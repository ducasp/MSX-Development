    5901   00:5D2A                          RECEIVE_DATA
    5901   00:5D2A  DB 06             >     in a,(IN_DATA_PORT)
    5902   00:5D2C  47                      ld  b,a
    5903   00:5D2D  3E 0D                   ld  a,13                        ; ERR BUFF
    5904   00:5D2F  C9                      ret
    5905   00:5D30                          ; If here, should be ok and will get the data
    5906   00:5D30                      SSH_AUTH_GET_CHALLENGE_ST2BB.1:
    5907   00:5D30  7D                      ld  a,l
    5908   00:5D31  B4                      or  h
    5909   00:5D32                          ; if it was 0, no data
    5910   00:5D32  CA E2 5A                jp  z,TCPIP_TCP_RCV_RET_NODATA  ; not a typo, no need to make the same code again
    5911   00:5D35                          ; Ok, we need to get the flags that will go to HL, we get it in BC and then push to the stack
