    4945   00:5895  0D                      dec c
    4946   00:5896  20 F0                   jr  nz,TCPIP_TCP_STATE_ERROR2
    4947   00:5898                      
    4948   00:5898                          ; now return w/ error that is saved in b
    4949   00:5898  78                      ld  a,b
    4950   00:5899  06 00                   ld  b,0
    4951   00:589B  0E 07                   ld  c,7
    4952   00:589D  21 00 00                ld  hl,0
