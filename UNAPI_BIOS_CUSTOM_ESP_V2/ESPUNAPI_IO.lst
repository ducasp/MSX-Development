    1149   00:45C0  CD A2 00                call    CHPUT
    1150   00:45C3  3E 20                   ld  a,' '                       ; Space
    1151   00:45C5  CD A2 00                call    CHPUT
    1152   00:45C8  06 18                   ld  b,24                        ; Cuts AP names > 23 chars
    1153   00:45CA                      PRT_APNAMELP:
