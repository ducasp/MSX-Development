    1349   00:46FF  C2 F4 46                jp  nz,WIFI_CONNECT_AP_SRCH.1
    1350   00:4702                      WIFI_CONNECT_AP_PWDQ:
    1351   00:4702                          ; HL has the address of AP name string
    1352   00:4702  54                      ld  d,h
    1353   00:4703  5D                      ld  e,l                         ; Save copy in D
    1354   00:4704  01 00 00                ld  bc,0                        ; BC will have the ap connection data length
    1355   00:4707                      WIFI_CONNECT_APSIZE:
    1356   00:4707  03                      inc bc
    1357   00:4708  1A                      ld  a,(de)
    1358   00:4709  13                      inc de
    1359   00:470A  B7                      or  a
    1360   00:470B  C2 07 47                jp  nz,WIFI_CONNECT_APSIZE      ; Count size, including zero terminator
    1361   00:470E                          ; Check for encryption
    1362   00:470E  1A                      ld  a,(de)
    1363   00:470F  B7                      or  a
    1364   00:4710  CA A1 47                jp  z,WIFI_CONNECT_SENDCMD      ; If no password requested, good to go
    1365   00:4713                          ; Shoot, need to request password, well, let's do it
    1366   00:4713  E5                      push    hl                      ; Save HL
    1367   00:4714  21 D6 69                ld  hl,MMENU_ASKPWD
    1368   00:4717  CD 4C 4C                call    PRINTHL                 ; Inform that user need to input PWD
    1369   00:471A  E1                      pop hl                          ; Restore HL
    1370   00:471B  FD 21 00 00             ld  iy,0                        ; IY will help in backspacing
    1371   00:471F  DD 26 01                ld  ixh,1                       ; Start hidden
    1372   00:4722                      WIFI_CONNECT_RCV_PWD:
    1373   00:4722  CD 9F 00                call    CHGET
    1374   00:4725  FE 1B                   cp  #1b                         ; ESC?
    1375   00:4727  CA 47 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1376   00:472A  FE 08                   cp  #08                         ; Backspace?
    1377   00:472C  CA 7D 47                jp  z,WIFI_CONNECT_RCV_PWD_BS   ; Check if there is something to erase
    1378   00:472F  FE 0D                   cp  #0d                         ; ENTER?
    1379   00:4731  CA 9A 47                jp  z,WIFI_PWD_CHECK_INPUT      ; Check if ok
    1380   00:4734  FE 7F                   cp  #7f                         ; Delete?
    1381   00:4736  CA 69 47                jp  z,WIFI_CONNECT_RCV_PWDH     ; Change password from clear to hidden or vice versa
    1382   00:4739                      WIFI_CONNECT_RCV_PWD_STR:
    1383   00:4739                          ; Ok, so it is a digit and store
    1384   00:4739  12                      ld  (de),a
    1385   00:473A  FD 7D                   ld  a,iyl
    1386   00:473C  D6 3F                   sub 63                          ; 63 chars password limit (WPA2 encryption)
    1387   00:473E  28 E2                   jr  z,WIFI_CONNECT_RCV_PWD
    1388   00:4740  1A                      ld  a,(de)
    1389   00:4741  03                      inc bc
    1390   00:4742  13                      inc de
    1391   00:4743  FD 23                   inc iy                          ; Increment counters and pointer
    1392   00:4745  F5                      push    af                      ; Save A
    1393   00:4746  DD 7C                   ld  a,ixh
    1394   00:4748  B7                      or  a                           ; If zero, print char, otherwise print *
    1395   00:4749  28 09                   jr  z,WIFI_CONNECT_RCV_PWD_CHAR
    1396   00:474B  F1                      pop af
    1397   00:474C  3E 2A                   ld  a,'*'                       ; Print * and keep password hidden
    1398   00:474E  CD A2 00                call    CHPUT
    1399   00:4751  C3 22 47                jp  WIFI_CONNECT_RCV_PWD        ; And back to receiving digits
    1400   00:4754                      WIFI_CONNECT_RCV_PWD_CHAR:
    1401   00:4754  F1                      pop af
    1402   00:4755  FE 20                   cp  32
    1403   00:4757  30 04                   jr  nc,WIFI_CONNECT_RCV_CHKPRT2 ; Ok, not below space, but is it delete?
    1404   00:4759  3E 3F                   ld  a,'?'                       ; Prints a question mark
    1405   00:475B  18 06                   jr  WIFI_CONNECT_RCV_CHKPRTD
    1406   00:475D                      WIFI_CONNECT_RCV_CHKPRT2:
    1407   00:475D  FE 7F                   cp  #7f
    1408   00:475F  20 02                   jr  nz,WIFI_CONNECT_RCV_CHKPRTD
    1409   00:4761  3E 3F                   ld  a,'?'                       ; Prints a question mark if it is delete
    1410   00:4763                      WIFI_CONNECT_RCV_CHKPRTD:
    1411   00:4763  CD A2 00                call    CHPUT                   ; Print a char
    1412   00:4766  C3 22 47                jp  WIFI_CONNECT_RCV_PWD        ; And back to receiving digits
    1413   00:4769                      
    1414   00:4769                      WIFI_CONNECT_RCV_PWDH:
    1415   00:4769  FD 7D                   ld  a,iyl
    1416   00:476B  FD B4                   or  iyh
    1417   00:476D  C2 39 47                jp  nz,WIFI_CONNECT_RCV_PWD_STR ; If digits entered, can't change password behavior, so it is a pass phrase char
    1418   00:4770  AF                      xor a
    1419   00:4771  DD B4                   or  ixh
    1420   00:4773  DD 26 01                ld  ixh,1
    1421   00:4776  28 AA                   jr  z,WIFI_CONNECT_RCV_PWD      ; Return if it was 0
    1422   00:4778  DD 26 00                ld  ixh,0
    1423   00:477B  28 A5                   jr  z,WIFI_CONNECT_RCV_PWD      ; Otherwise set to 0 and return
    1424   00:477D                      
    1425   00:477D                      WIFI_CONNECT_RCV_PWD_BS:
    1426   00:477D  FD 7D                   ld  a,iyl
    1427   00:477F  FD B4                   or  iyh
    1428   00:4781  CA 22 47                jp  z,WIFI_CONNECT_RCV_PWD      ; If no digits entered, nothing to erase
    1429   00:4784  FD 2B                   dec iy                          ; Decrement counter
    1430   00:4786  0B                      dec bc                          ; Decrement counter
    1431   00:4787  1B                      dec de                          ; Decrement pointer
    1432   00:4788  3E 08                   ld  a,8                         ; Backspace
    1433   00:478A  CD A2 00                call    CHPUT                   ; Print it
    1434   00:478D  3E 20                   ld  a,' '                       ; Space
    1435   00:478F  CD A2 00                call    CHPUT                   ; Print it
    1436   00:4792  3E 08                   ld  a,8                         ; Backspace
    1437   00:4794  CD A2 00                call    CHPUT                   ; Print it
    1438   00:4797  C3 22 47                jp  WIFI_CONNECT_RCV_PWD        ; Return
    1439   00:479A                      
    1440   00:479A                      WIFI_PWD_CHECK_INPUT:
    1441   00:479A  FD 7D                   ld  a,iyl
    1442   00:479C  FD B4                   or  iyh
    1443   00:479E  CA 22 47                jp  z,WIFI_CONNECT_RCV_PWD      ; If no digits entered, no password to send
    1444   00:47A1                          ; Otherwise done and ready to send
    1445   00:47A1                      WIFI_CONNECT_SENDCMD:
    1446   00:47A1  CD E3 49                call    WAIT_250MS_AND_THEN_CONTINUE
    1447   00:47A4  E5                      push    hl
    1448   00:47A5  21 92 69                ld  HL,MMENU_CONNECTING
    1449   00:47A8  CD 4C 4C                call    PRINTHL
    1450   00:47AB  E1                      pop hl
    1451   00:47AC                          ; Print AP name
    1452   00:47AC  E5                      push    hl
    1453   00:47AD  CD 56 4C                call    PRINTHLINE              ; Print AP Name
    1454   00:47B0  E1                      pop hl
    1455   00:47B1                          ; HL has the address of our data, BC the data size, so it is just needed to send the command
    1456   00:47B1                          CLEAR_UART
    1456   00:47B1  3E 14             >     ld  a,20
    1456   00:47B3  D3 06             >     out (OUT_CMD_PORT),a
    1457   00:47B5  3E 41                   ld  a,CMD_WIFI_CONNECT
    1458   00:47B7                          SEND_DATA
    1458   00:47B7  D3 07             >     out (OUT_TX_PORT),a
    1459   00:47B9  78                      ld  a,b                         ; Size MSB is in B
    1460   00:47BA                          SEND_DATA
    1460   00:47BA  D3 07             >     out (OUT_TX_PORT),a
    1461   00:47BC  79                      ld  a,c                         ; Size LSB is in c
    1462   00:47BD                          SEND_DATA
    1462   00:47BD  D3 07             >     out (OUT_TX_PORT),a
    1463   00:47BF                      WIFI_CONNECT_SENDCMDLP:
    1464   00:47BF  7E                      ld  a,(hl)
    1465   00:47C0                          SEND_DATA
    1465   00:47C0  D3 07             >     out (OUT_TX_PORT),a
    1466   00:47C2  23                      inc hl
    1467   00:47C3  0B                      dec bc
    1468   00:47C4  78                      ld  a,b
    1469   00:47C5  B1                      or  c
    1470   00:47C6  C2 BF 47                jp  nz,WIFI_CONNECT_SENDCMDLP
    1471   00:47C9  21 58 02                ld  hl,600                      ; Wait Up To 10s
    1472   00:47CC  3E 41                   ld  a,CMD_WIFI_CONNECT          ; Our command
    1473   00:47CE  CD FF 4A                call    WAIT_MENU_QCMD_RESPONSE
    1474   00:47D1  CA DD 47                jp  z,WIFI_CONNECT_FAIL
    1475   00:47D4  21 37 6E                ld  hl,STR_SENDING_OK_JN        ; Success
    1476   00:47D7  CD 4C 4C                call    PRINTHL
