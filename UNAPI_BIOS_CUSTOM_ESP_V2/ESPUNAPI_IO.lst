    3105   00:507E                          ; nz, discard
    3106   00:507E                          RECEIVE_DATA
    3106   00:507E  DB 06             >     in a,(IN_DATA_PORT)
    3107   00:5080  05                      dec b
    3108   00:5081  20 F0                   jr  nz,TCPIP_NET_STATE_ST2
    3109   00:5083                      
    3110   00:5083                          ; now just get the 1 byte (NET STATE) IP and place it in B
    3111   00:5083                      TCPIP_NET_STATE_NS_ST1:
    3112   00:5083                          CHECK_DATA
    3112   00:5083  DB 07             >     in  a,(IN_STS_PORT)
    3112   00:5085  CB 47             >     bit 0,a
    3113   00:5087  20 05                   jr  nz,TCPIP_NET_STATE_NS_ST1.1
    3114   00:5089  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3115   00:508C  18 F5                   jr  TCPIP_NET_STATE_NS_ST1
    3116   00:508E                      TCPIP_NET_STATE_NS_ST1.1:
