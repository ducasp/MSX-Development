    3278   00:5148                      ;=====================
    3279   00:5148                      ;===  TCPIP_DNS_S  ===
    3280   00:5148                      ;=====================
    3281   00:5148                      ;Obtains the host name resolution process state and result.
    3282   00:5148                      ;
    3283   00:5148                      ;Input:  A = 7
    3284   00:5148                      ;        B = Flags, when set to 1 they instruct the resolver to:
    3285   00:5148                      ;            bit 0: Clear any existing result or error condition after the execution
    3286   00:5148                      ;                   (except if there is a query in progress)
    3287   00:5148                      ;Output: A = Error code
    3288   00:5148                      ;        B = DNS error code (when error is ERR_DNS)
    3289   00:5148                      ;        B = Current query status (when error is ERR_OK):
    3290   00:5148                      ;            0: There is no query in progress, nor any result nor error code available
    3291   00:5148                      ;            1: There is a query in progress
    3292   00:5148                      ;            2: Query is complete
    3293   00:5148                      ;        C = Current query sub status (when error is ERR_OK and B=1):
    3294   00:5148                      ;            0: Unknown
    3295   00:5148                      ;            1: Querying the primary DNS server
    3296   00:5148                      ;            2: Querying the secondary DNS server
    3297   00:5148                      ;            3: Querying another DNS server
    3298   00:5148                      ;        C = Resolution process type (when error is ERR_OK and B=2):
    3299   00:5148                      ;            0: The name was obtained by querying a DNS server
    3300   00:5148                      ;            1: The name was a direct representation of an IP address
    3301   00:5148                      ;            2: The name was resolved locally
    3302   00:5148                      ;       L.H.E.D = Resolved IP address (when error is ERR_OK and B=2)
    3303   00:5148                      TCPIP_DNS_S:
    3304   00:5148                          ;--- Is there a result?
    3305   00:5148  CD DF 61                call    GETDNSREADY             ; DNS done?
    3306   00:514B  B7                      or  a
    3307   00:514C  28 23                   jr  z,TCPIP_DNS_S_NORESULT      ; No DNS result
    3308   00:514E                          ;--- Ok, we have a result, is it success?
    3309   00:514E  3D                      dec a
    3310   00:514F  28 12                   jr  z,TCPIP_DNS_S_HASRESULT     ; If it is 1, it was not an error
    3311   00:5151                          ;--- Shoot, there is an error...
    3312   00:5151                          ;--- And sure thing, ESP do not tell us details, it is always failure :-P
    3313   00:5151  CB 40                   bit 0,b                         ;--- clear error after this?
    3314   00:5153  28 09                   jr  z,TCP_IP_DNS_S_NOCLR
    3315   00:5155                          ;--- Clear
    3316   00:5155  06 00                   ld b,0                          ;--- Like I've said, no details
    3317   00:5157  AF                      xor a
    3318   00:5158  CD F1 61                call    SETDNSREADY             ; DNS not done
    3319   00:515B  3E 08                   ld  a,ERR_DNS;
    3320   00:515D  C9                      ret
    3321   00:515E                      TCP_IP_DNS_S_NOCLR:
    3322   00:515E                          ;--- Don't clear
    3323   00:515E  3E 08                   ld  a,ERR_DNS
    3324   00:5160  06 00                   ld  b,0                         ;--- Like I've said, no details
    3325   00:5162  C9                      ret
    3326   00:5163                          ;--- There is a result available...
    3327   00:5163                      TCPIP_DNS_S_HASRESULT:
    3328   00:5163                          ;--- Copy the result
    3329   00:5163  CD 05 62                call    GETDNSRESULT
    3330   00:5166  AF                      xor a
    3331   00:5167  CB 40                   bit 0,b                         ;--- clear result after this?
    3332   00:5169  28 03                   jr  z,TCP_IP_DNS_S_RES_NOCLR    ;--- no, just return
    3333   00:516B                          ;--- Yes, clear
    3334   00:516B  CD F1 61                call    SETDNSREADY             ; DNS not done
    3335   00:516E                      TCP_IP_DNS_S_RES_NOCLR:
    3336   00:516E  06 02                   ld  b,2
    3337   00:5170  C9                      ret
    3338   00:5171                      
    3339   00:5171                      TCPIP_DNS_S_NORESULT:
    3340   00:5171  AF                      xor a                           ;--- OK no query in progress, no result, means nothing in progress
    3341   00:5172  06 00                   ld  b,0                         ;--- No query in progress
    3342   00:5174  C9                      ret
    3343   00:5175                      
    3344   00:5175                      ;========================
    3345   00:5175                      ;===  TCPIP_UDP_OPEN  ===
    3346   00:5175                      ;========================
    3347   00:5175                      ;Open an UDP connection.
    3348   00:5175                      ;
    3349   00:5175                      ;Input:  A  = 8
    3350   00:5175                      ;        HL = Local port number (#FFFF=random)
    3351   00:5175                      ;        B  = Intended connection lifetime:
    3352   00:5175                      ;             0: Transient
    3353   00:5175                      ;             1: Resident
    3354   00:5175                      ;Output: A = Error code
    3355   00:5175                      ;        B = Connection number
    3356   00:5175                      TCPIP_UDP_OPEN:
    3357   00:5175                          SEND_DATA                       ; Send the command
    3357   00:5175  D3 07             >     out (OUT_TX_PORT),a
    3358   00:5177  AF                      xor a
    3359   00:5178                          SEND_DATA                       ; Send the command size msb
    3359   00:5178  D3 07             >     out (OUT_TX_PORT),a
    3360   00:517A  3E 03                   ld  a,3
    3361   00:517C                          SEND_DATA                       ; Send the command size lsb
    3361   00:517C  D3 07             >     out (OUT_TX_PORT),a
    3362   00:517E  7D                      ld  a,l
    3363   00:517F                          SEND_DATA                       ; Send the port LSB
    3363   00:517F  D3 07             >     out (OUT_TX_PORT),a
    3364   00:5181  7C                      ld  a,h
    3365   00:5182                          SEND_DATA                       ; Send the port MSB
    3365   00:5182  D3 07             >     out (OUT_TX_PORT),a
    3366   00:5184  78                      ld  a,b
    3367   00:5185                          SEND_DATA                       ; Send the connection transient/resident
    3367   00:5185  D3 07             >     out (OUT_TX_PORT),a
    3368   00:5187                      
    3369   00:5187                          ; Now wait up to 180 ticks to get response
    3370   00:5187  21 B4 00                ld  hl,180
    3371   00:518A  CD DF 60                call    SETCOUNTER
    3372   00:518D                      TCPIP_UDP_OPEN_ST1:
    3373   00:518D                          CHECK_DATA
    3373   00:518D  DB 07             >     in  a,(IN_STS_PORT)
    3373   00:518F  CB 47             >     bit 0,a
    3374   00:5191  20 05                   jr  nz,TCPIP_UDP_OPEN_ST1.1
    3375   00:5193  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3376   00:5196  18 F5                   jr  TCPIP_UDP_OPEN_ST1
    3377   00:5198                      TCPIP_UDP_OPEN_ST1.1:
    3378   00:5198                          ; nz, check the data
    3379   00:5198                          RECEIVE_DATA
    3379   00:5198  DB 06             >     in a,(IN_DATA_PORT)
    3380   00:519A  FE 08                   cp  8                           ; Is response of our command?
    3381   00:519C  20 EF                   jr  nz,TCPIP_UDP_OPEN_ST1
    3382   00:519E                          ; now get return code, if return code other than 0, it is finished
    3383   00:519E                      TCPIP_UDP_OPEN_RC:
    3384   00:519E                          CHECK_DATA
    3384   00:519E  DB 07             >     in  a,(IN_STS_PORT)
    3384   00:51A0  CB 47             >     bit 0,a
    3385   00:51A2  20 05                   jr  nz,TCPIP_UDP_OPEN_RC.1
    3386   00:51A4  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3387   00:51A7  18 F5                   jr  TCPIP_UDP_OPEN_RC
    3388   00:51A9                      TCPIP_UDP_OPEN_RC.1:
    3389   00:51A9                          ; nz, discard
    3390   00:51A9                          RECEIVE_DATA
    3390   00:51A9  DB 06             >     in a,(IN_DATA_PORT)
    3391   00:51AB  B7                      or  a                           ; 0?
    3392   00:51AC  C0                      ret nz                          ; if not, done
    3393   00:51AD                      
    3394   00:51AD                          ; next two bytes are return code and size bytes, don't care, it is 1, conn #
    3395   00:51AD  06 02                   ld  b,2
    3396   00:51AF                      TCPIP_UDP_OPEN_ST2:
    3397   00:51AF                          CHECK_DATA
    3397   00:51AF  DB 07             >     in  a,(IN_STS_PORT)
    3397   00:51B1  CB 47             >     bit 0,a
    3398   00:51B3  20 05                   jr  nz,TCPIP_UDP_OPEN_ST2.1
    3399   00:51B5  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3400   00:51B8  18 F5                   jr  TCPIP_UDP_OPEN_ST2
    3401   00:51BA                      TCPIP_UDP_OPEN_ST2.1:
    3402   00:51BA                          ; nz, discard
    3403   00:51BA                          RECEIVE_DATA
    3403   00:51BA  DB 06             >     in a,(IN_DATA_PORT)
    3404   00:51BC  05                      dec b
    3405   00:51BD  20 F0                   jr  nz,TCPIP_UDP_OPEN_ST2
    3406   00:51BF                      
    3407   00:51BF                          ; now just get the 1 byte, conn#, should go to B
    3408   00:51BF                      TCPIP_UDP_OPEN_CONN_ST1:
    3409   00:51BF                          CHECK_DATA
    3409   00:51BF  DB 07             >     in  a,(IN_STS_PORT)
    3409   00:51C1  CB 47             >     bit 0,a
    3410   00:51C3  20 05                   jr  nz,TCPIP_UDP_OPEN_CONN_ST1.1
    3411   00:51C5  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3412   00:51C8  18 F5                   jr  TCPIP_UDP_OPEN_CONN_ST1
    3413   00:51CA                      TCPIP_UDP_OPEN_CONN_ST1.1:
    3414   00:51CA                          ; nz, get it
    3415   00:51CA                          RECEIVE_DATA
    3415   00:51CA  DB 06             >     in a,(IN_DATA_PORT)
    3416   00:51CC  47                      ld  b,a
    3417   00:51CD                          ; done
    3418   00:51CD  AF                      xor a
    3419   00:51CE  C9                      ret
    3420   00:51CF                      
    3421   00:51CF                      ;=========================
    3422   00:51CF                      ;===  TCPIP_UDP_CLOSE  ===
    3423   00:51CF                      ;=========================
    3424   00:51CF                      ;Close a UDP connection.
    3425   00:51CF                      ;
    3426   00:51CF                      ;Input:  A = 9
    3427   00:51CF                      ;        B = Connection number
    3428   00:51CF                      ;            0 to close all open transient UDP connections
    3429   00:51CF                      ;Output: A = Error code
    3430   00:51CF                      TCPIP_UDP_CLOSE:
    3431   00:51CF                          SEND_DATA                       ; Send the command
    3431   00:51CF  D3 07             >     out (OUT_TX_PORT),a
