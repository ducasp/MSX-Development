    5779   00:5C7D                      ;==============================
    5780   00:5C7D                      ;=== SSH_AUTH_GET_CHALLENGE ===
    5781   00:5C7D                      ;==============================
    5782   00:5C7D                      ;Receive keyboard interactive challenge data from a SSH connection.
    5783   00:5C7D                      ;
    5784   00:5C7D                      ;Input:   A  = 9
    5785   00:5C7D                      ;         B  = Connection number
    5786   00:5C7D                      ;         DE = Address for the retrieved data
    5787   00:5C7D                      ;         HL = Max Length of the data to be obtained
    5788   00:5C7D                      ;Output:  A  = Error code
    5789   00:5C7D                      ;         BC = Total number of bytes that have been actually retrieved
    5790   00:5C7D                      ;         H  = Number of prompts
    5791   00:5C7D                      ;         L  = Echo flag bitmap
    5792   00:5C7D                      ; Save registers other than AF
    5793   00:5C7D                      SSH_AUTH_GET_CHALLENGE_RETRY_QRCV:
    5794   00:5C7D  CD FC 5E                call    GETBYTE
    5795   00:5C80  B7                      or  a
    5796   00:5C81  28 0B                   jr  z,SSH_AUTH_GET_CHALLENGE_CHECK_TIME_OUT.NORXRETRY
    5797   00:5C83                          ; Ok, so let's ask ESP to re-send the data and retry receiving it
    5798   00:5C83  3D                      dec a
    5799   00:5C84  CD 0E 5F                call    SETBYTE                 ; we are retrying it
    5800   00:5C87  3E 72                   ld  a,'r'                       ; retry transmission command
    5801   00:5C89                          SEND_DATA
    5801   00:5C89  D3 07             >     out (OUT_TX_PORT),a
    5802   00:5C8B  C3 AF 5C                jp  SSH_AUTH_GET_CHALLENGE.RXRETRY             ; and retry it
    5803   00:5C8E                      SSH_AUTH_GET_CHALLENGE_CHECK_TIME_OUT.NORXRETRY:
    5804   00:5C8E  3E 0F                   ld  a,ERR_INV_OPER
    5805   00:5C90  C9                      ret                             ; and return the function itself
    5806   00:5C91                      
    5807   00:5C91                      SSH_AUTH_GET_CHALLENGE:
    5808   00:5C91  EB                      ex  de,hl
    5809   00:5C92  CD 35 5F                call    SETWORD
    5810   00:5C95  EB                      ex  de,hl
    5811   00:5C96  3E 89                   ld  a,#89
    5812   00:5C98                          SEND_DATA                       ; Send the command
    5812   00:5C98  D3 07             >     out (OUT_TX_PORT),a
    5813   00:5C9A  AF                      xor a
    5814   00:5C9B                          SEND_DATA                       ; Send the command size msb
    5814   00:5C9B  D3 07             >     out (OUT_TX_PORT),a
    5815   00:5C9D  3E 03                   ld  a,3
    5816   00:5C9F                          SEND_DATA                       ; Send the command size lsb
    5816   00:5C9F  D3 07             >     out (OUT_TX_PORT),a
    5817   00:5CA1  78                      ld  a,b
    5818   00:5CA2                          SEND_DATA                       ; Send the connection #
    5818   00:5CA2  D3 07             >     out (OUT_TX_PORT),a
    5819   00:5CA4  7D                      ld  a,l
    5820   00:5CA5                          SEND_DATA                       ; Send MAX rcv size LSB
    5820   00:5CA5  D3 07             >     out (OUT_TX_PORT),a
    5821   00:5CA7  7C                      ld  a,h
    5822   00:5CA8                          SEND_DATA                       ; Send MAX rcv size MSB
    5822   00:5CA8  D3 07             >     out (OUT_TX_PORT),a
    5823   00:5CAA  3E 03                   ld  a,3
    5824   00:5CAC  CD 0E 5F                call    SETBYTE                 ; Ok, retry up to three times
    5825   00:5CAF                      SSH_AUTH_GET_CHALLENGE.RXRETRY:
    5826   00:5CAF                          ; Now wait up to 600 ticks to get response
    5827   00:5CAF  21 58 02                ld  hl,600
    5828   00:5CB2  CD EC 5E                call    SETCOUNTER
