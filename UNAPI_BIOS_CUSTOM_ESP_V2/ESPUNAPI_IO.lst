    2296   00:4CD6                      
    2297   00:4CD6  3D                      dec a
    2298   00:4CD7  20 0D                   jr  nz,DO_EXTBIO3
    2299   00:4CD9  E1                      pop hl
    2300   00:4CDA  CD 6C 5E                call    GETSLTT                 ; GETSLTT is GETSLT that checks if our memory area @ HIMEM has been allocated, if not, allocate it
    2301   00:4CDD  06 FF                   ld  b,#FF
    2302   00:4CDF  21 3E 4D                ld  hl,UNAPI_ENTRY
    2303   00:4CE2  11 22 22                ld  de,#2222
    2304   00:4CE5  C9                      ret
    2305   00:4CE6                      
    2306   00:4CE6                          ; A>1: A=A-1, and jump to old hook
    2307   00:4CE6                      
    2308   00:4CE6                      DO_EXTBIO3:                         ; A=A-1 already done
    2309   00:4CE6  E3                      ex  (sp),hl
    2310   00:4CE7  11 22 22                ld   de,#2222
    2311   00:4CEA  C9                      ret
    2312   00:4CEB                      
    2313   00:4CEB                      SSH_CHECK:
    2314   00:4CEB                          ; Check API ID SSH
    2315   00:4CEB  21 61 70                ld  hl,UNAPI_ID2
    2316   00:4CEE  11 47 F8                ld  de,ARG
    2317   00:4CF1                      LOOPSSH:
    2318   00:4CF1  1A                      ld  a,(de)
    2319   00:4CF2  CD 55 60                call    TOUPPER
    2320   00:4CF5  BE                      cp  (hl)
    2321   00:4CF6  20 37                   jr  nz,JUMP_OLD2
    2322   00:4CF8  23                      inc hl
    2323   00:4CF9  13                      inc de
    2324   00:4CFA  B7                      or  a
    2325   00:4CFB  20 F4                   jr  nz,LOOPSSH
    2326   00:4CFD                      
    2327   00:4CFD                          ; API ID matched, offer only if SSH support was determined at boot
    2328   00:4CFD  CD ED 5F                call    GETESPFLAGS
    2329   00:4D00  E6 02                   and ESPFLAG_SSH
    2330   00:4D02  28 2B                   jr  z,JUMP_OLD2
    2331   00:4D04                      
    2332   00:4D04                          ; A=255: Jump to old hook
    2333   00:4D04                      
    2334   00:4D04  F1                      pop af
    2335   00:4D05  F5                      push    af
    2336   00:4D06  3C                      inc a
    2337   00:4D07  28 26                   jr  z,JUMP_OLD2
    2338   00:4D09                      
    2339   00:4D09                          ; A=0: B=B+1 and jump to old hook
    2340   00:4D09                      
    2341   00:4D09  CD 4C 5E                call    GETSLT
    2342   00:4D0C  CD A5 5E                call    GETWRK
    2343   00:4D0F  F1                      pop af
    2344   00:4D10  C1                      pop bc
    2345   00:4D11  B7                      or  a
    2346   00:4D12  20 06                   jr  nz,DO_EXTBIO2SSH
    2347   00:4D14  04                      inc b
    2348   00:4D15  E3                      ex  (sp),hl
    2349   00:4D16  11 22 22                ld  de,#2222
    2350   00:4D19  C9                      ret
    2351   00:4D1A                      
    2352   00:4D1A                      DO_EXTBIO2SSH:
    2353   00:4D1A                          ; A=1: Return A=Slot, B=Segment, HL=UNAPI entry address
    2354   00:4D1A                      
    2355   00:4D1A  3D                      dec a
    2356   00:4D1B  20 0D                   jr  nz,DO_EXTBIO3SSH
    2357   00:4D1D  E1                      pop hl
    2358   00:4D1E  CD 6C 5E                call    GETSLTT                 ; GETSLTT is GETSLT that checks if our memory area @ HIMEM has been allocated, if not, allocate it
    2359   00:4D21  06 FF                   ld  b,#FF
    2360   00:4D23  21 9B 4D                ld  hl,UNAPI2_ENTRY
    2361   00:4D26  11 22 22                ld  de,#2222
    2362   00:4D29  C9                      ret
    2363   00:4D2A                      
    2364   00:4D2A                          ; A>1: A=A-1, and jump to old hook
    2365   00:4D2A                      
    2366   00:4D2A                      DO_EXTBIO3SSH:                         ; A=A-1 already done
    2367   00:4D2A  E3                      ex  (sp),hl
    2368   00:4D2B  11 22 22                ld  de,#2222
    2369   00:4D2E  C9                      ret
    2370   00:4D2F                      
    2371   00:4D2F                      ; Jump here to execute old EXTBIO code
    2372   00:4D2F                      JUMP_OLD2:
    2373   00:4D2F  11 22 22                ld  de,#2222
    2374   00:4D32                      JUMP_OLD:                           ; Assumes "push hl,bc,af" done
    2375   00:4D32  D5                      push    de
    2376   00:4D33  CD 4C 5E                call    GETSLT
    2377   00:4D36  CD A5 5E                call    GETWRK
    2378   00:4D39  D1                      pop de
    2379   00:4D3A  F1                      pop af
    2380   00:4D3B  C1                      pop bc
    2381   00:4D3C  E3                      ex  (sp),hl
    2382   00:4D3D  C9                      ret
    2383   00:4D3E                      
    2384   00:4D3E                      ;====================================
    2385   00:4D3E                      ;===  Functions entry point code  ===
    2386   00:4D3E                      ;===            TCP/IP            ===
    2387   00:4D3E                      ;====================================
    2388   00:4D3E                      UNAPI_ENTRY:
    2389   00:4D3E  FB                      ei
    2390   00:4D3F  E5                      push    hl
    2391   00:4D40  F5                      push    af
    2392   00:4D41  21 5F 4D                ld  hl,FN_TABLE
    2393   00:4D44  CB 7F                   bit 7,a
    2394   00:4D46  20 14                   jr  nz,UNDEFINED
    2395   00:4D48                      
    2396   00:4D48  FE 1D                   cp  MAX_FN
    2397   00:4D4A  28 02                   jr  z,OK_FNUM
    2398   00:4D4C  30 0E                   jr  nc,UNDEFINED
    2399   00:4D4E                      
    2400   00:4D4E                      OK_FNUM:
    2401   00:4D4E  87                      add a,a
    2402   00:4D4F  D5                      push    de
    2403   00:4D50  5F                      ld  e,a
    2404   00:4D51  16 00                   ld  d,0
    2405   00:4D53  19                      add hl,de
    2406   00:4D54  D1                      pop de
    2407   00:4D55                      
    2408   00:4D55  7E                      ld  a,(hl)
    2409   00:4D56  23                      inc hl
    2410   00:4D57  66                      ld  h,(hl)
    2411   00:4D58  6F                      ld  l,a
    2412   00:4D59                      
    2413   00:4D59  F1                      pop af
    2414   00:4D5A  E3                      ex  (sp),hl
    2415   00:4D5B  C9                      ret
    2416   00:4D5C                      
    2417   00:4D5C                      ; Undefined function: return with registers unmodified
    2418   00:4D5C                      UNDEFINED:
    2419   00:4D5C  F1                      pop af
    2420   00:4D5D  E1                      pop hl
    2421   00:4D5E  C9                      ret
    2422   00:4D5F                      
    2423   00:4D5F                      ;===================================
    2424   00:4D5F                      ;===  Functions addresses table  ===
    2425   00:4D5F                      ;===            TCP/IP           ===
    2426   00:4D5F                      ;===================================
    2427   00:4D5F                      ;--- Implementation-specific routines addresses table
    2428   00:4D5F                      FN_TABLE:
    2429   00:4D5F  E6 4D               FN_0:                   dw  UNAPI_GET_INFO
    2430   00:4D61  97 4E               FN_1:                   dw  TCPIP_GET_CAPAB
    2431   00:4D63  C7 4F               FN_2:                   dw  TCPIP_GET_IPINFO
    2432   00:4D65  44 50               FN_3:                   dw  TCPIP_NET_STATE
    2433   00:4D67                      ; TCPIP_SEND_ECHO not going to be implemented, ESP do not support ping like UNAPI specify
    2434   00:4D67  D1 4D               FN_4:                   dw  FN_NOT_IMP
    2435   00:4D69                      ; TCPIP_RCV_ECHO not going to be implemented as SEND_ECHO is not implemented
    2436   00:4D69  D1 4D               FN_5:                   dw  FN_NOT_IMP
    2437   00:4D6B  93 50               FN_6:                   dw  TCPIP_DNS_Q
    2438   00:4D6D  42 51               FN_7:                   dw  TCPIP_DNS_S
    2439   00:4D6F  6F 51               FN_8:                   dw  TCPIP_UDP_OPEN
    2440   00:4D71  C9 51               FN_9:                   dw  TCPIP_UDP_CLOSE
    2441   00:4D73  0F 52               FN_10:                  dw  TCPIP_UDP_STATE
    2442   00:4D75  9A 52               FN_11:                  dw  TCPIP_UDP_SEND
    2443   00:4D77  39 53               FN_12:                  dw  TCPIP_UDP_RCV
    2444   00:4D79  62 54               FN_13:                  dw  TCPIP_TCP_OPEN
    2445   00:4D7B  36 55               FN_14:                  dw  TCPIP_TCP_CLOSE
    2446   00:4D7D  37 58               FN_15:                  dw  TCPIP_TCP_ABORT
    2447   00:4D7F  A0 58               FN_16:                  dw  TCPIP_TCP_STATE
    2448   00:4D81  A5 59               FN_17:                  dw  TCPIP_TCP_SEND
    2449   00:4D83  E9 5A               FN_18:                  dw  TCPIP_TCP_RCV
    2450   00:4D85                      ; TCPIP_TCP_FLUSH makes no sense as we do not use buffers to send, any buffer is internal to ESP and we can't delete
    2451   00:4D85  D1 4D               FN_19:                  dw  FN_NOT_IMP
    2452   00:4D87                      ; TCPIP_RAW_OPEN not going to be implemented, ESP do not support RAW connections
    2453   00:4D87  D1 4D               FN_20:                  dw  FN_NOT_IMP
    2454   00:4D89                      ; TCPIP_RAW_CLOSE not going to be implemented, ESP do not support RAW connections
    2455   00:4D89  D1 4D               FN_21:                  dw  FN_NOT_IMP
    2456   00:4D8B                      ; TCPIP_RAW_STATE not going to be implemented, ESP do not support RAW connections
    2457   00:4D8B  D1 4D               FN_22:                  dw  FN_NOT_IMP
    2458   00:4D8D                      ; TCPIP_RAW_SEND not going to be implemented, ESP do not support RAW connections
    2459   00:4D8D  D1 4D               FN_23:                  dw  FN_NOT_IMP
    2460   00:4D8F                      ; TCPIP_RAW_RCV not going to be implemented, ESP do not support RAW connections
    2461   00:4D8F  D1 4D               FN_24:                  dw  FN_NOT_IMP
    2462   00:4D91  96 5D               FN_25:                  dw  TCPIP_CONFIG_AUTOIP
    2463   00:4D93  ED 5D               FN_26:                  dw  TCPIP_CONFIG_IP
    2464   00:4D95  2A 5E               FN_27:                  dw  TCPIP_CONFIG_TTL
    2465   00:4D97  3C 5E               FN_28:                  dw  TCPIP_CONFIG_PING
    2466   00:4D99                      ; TCPIP_WAIT not needed for our implementation
    2467   00:4D99  D4 4D               FN_29:                  dw  END_OK
    2468   00:4D9B                      
    2469   00:4D9B                      ;====================================
    2470   00:4D9B                      ;===  Functions entry point code  ===
    2471   00:4D9B                      ;===             SSH              ===
    2472   00:4D9B                      ;====================================
    2473   00:4D9B                      UNAPI2_ENTRY:
    2474   00:4D9B  FB                      ei
    2475   00:4D9C  E5                      push    hl
    2476   00:4D9D  F5                      push    af
    2477   00:4D9E  21 B9 4D                ld  hl,FN_TABLE_S
    2478   00:4DA1  CB 7F                   bit 7,a
    2479   00:4DA3  20 B7                   jr  nz,UNDEFINED
    2480   00:4DA5                      
    2481   00:4DA5  FE 0B                   cp  MAX_FN_S
    2482   00:4DA7  28 02                   jr  z,OK_FNUM_S
    2483   00:4DA9  30 B1                   jr  nc,UNDEFINED
    2484   00:4DAB                      
    2485   00:4DAB                      OK_FNUM_S:
    2486   00:4DAB  87                      add a,a
    2487   00:4DAC  D5                      push    de
    2488   00:4DAD  5F                      ld  e,a
    2489   00:4DAE  16 00                   ld  d,0
    2490   00:4DB0  19                      add hl,de
    2491   00:4DB1  D1                      pop de
    2492   00:4DB2                      
    2493   00:4DB2  7E                      ld  a,(hl)
    2494   00:4DB3  23                      inc hl
    2495   00:4DB4  66                      ld  h,(hl)
    2496   00:4DB5  6F                      ld  l,a
    2497   00:4DB6                      
    2498   00:4DB6  F1                      pop af
    2499   00:4DB7  E3                      ex  (sp),hl
    2500   00:4DB8  C9                      ret
    2501   00:4DB9                      
    2502   00:4DB9                      ;===================================
    2503   00:4DB9                      ;===  Functions addresses table  ===
    2504   00:4DB9                      ;===             SSH             ===
    2505   00:4DB9                      ;===================================
    2506   00:4DB9                      ;--- Implementation-specific routines addresses table
    2507   00:4DB9                      
    2508   00:4DB9                      FN_TABLE_S:
    2509   00:4DB9  F1 4D               FN_0_S:                 dw  UNAPI_GET_INFO_SSH
    2510   00:4DBB  FC 4D               FN_1_S:                 dw  SSH_GET_CAPAB
    2511   00:4DBD  7C 55               FN_2_S:                 dw  SSH_OPEN
    2512   00:4DBF  90 56               FN_3_S:                 dw  SSH_CLOSE
    2513   00:4DC1  D8 56               FN_4_S:                 dw  SSH_STATE
    2514   00:4DC3  01 5A               FN_5_S:                 dw  SSH_SEND
    2515   00:4DC5  CA 5B               FN_6_S:                 dw  SSH_RCV
    2516   00:4DC7  4A 57               FN_7_S:                 dw  SSH_TERM_TYPE
    2517   00:4DC9  B8 57               FN_8_S:                 dw  SSH_WIN_SIZE
    2518   00:4DCB  91 5C               FN_9_S:                 dw  SSH_AUTH_GET_CHALLENGE
    2519   00:4DCD  57 5A               FN_10_S:                dw  SSH_AUTH_RESPOND
    2520   00:4DCF  48 56               FN_11_S:                dw  SSH_ADD_KNOWN_HOST
    2521   00:4DD1                      
    2522   00:4DD1                      ;========================
    2523   00:4DD1                      ;===  Functions code  ===
    2524   00:4DD1                      ;========================
    2525   00:4DD1                      FN_NOT_IMP:
    2526   00:4DD1  3E 01                   ld  a,ERR_NOT_IMP
    2527   00:4DD3  C9                      ret
    2528   00:4DD4                      
    2529   00:4DD4                      END_OK:
    2530   00:4DD4  AF                      xor a
    2531   00:4DD5  C9                      ret
    2532   00:4DD6                      
    2533   00:4DD6                      ; Most functions do not have special handling on time out and can use this.
    2534   00:4DD6                      ; If there is a need to retry sending or receiving on time-out, then a custom
    2535   00:4DD6                      ; time-out function must be done, check the examples of UDP and TCP receive
    2536   00:4DD6                      TCPIP_GENERIC_CHECK_TIME_OUT:
    2537   00:4DD6                          ; Save registers other than AF
    2538   00:4DD6  C5                      push bc
    2539   00:4DD7  D5                      push de
    2540   00:4DD8  E5                      push hl
    2541   00:4DD9  CD DD 5E                call    GETCOUNTER
    2542   00:4DDC  7D                      ld  a,l
    2543   00:4DDD  B4                      or  h
    2544   00:4DDE                          ; Restore registers, we are returning
    2545   00:4DDE  E1                      pop hl
    2546   00:4DDF  D1                      pop de
    2547   00:4DE0  C1                      pop bc
    2548   00:4DE1  C0                      ret nz
    2549   00:4DE2                          ; Ok, timeout...
    2550   00:4DE2  F1                      pop af                          ; Get return address of who called this out of the stack
    2551   00:4DE3  3E 0F                   ld  a,ERR_INV_OPER
    2552   00:4DE5  C9                      ret                             ; and return the function itself
    2553   00:4DE6                      
    2554   00:4DE6                      ;========================
    2555   00:4DE6                      ;===  UNAPI_GET_INFO  ===
    2556   00:4DE6                      ;========================
    2557   00:4DE6                      ; Obtain the implementation name and version for TCP/IP.
    2558   00:4DE6                      ;
    2559   00:4DE6                      ;    Input:  A  = 0
    2560   00:4DE6                      ;    Output: HL = Descriptive string for this implementation, on this slot, zero terminated
    2561   00:4DE6                      ;            DE = API version supported, D.E
    2562   00:4DE6                      ;            BC = This implementation version, B.C.
    2563   00:4DE6                      ;            A  = 0 and Cy = 0
    2564   00:4DE6                      UNAPI_GET_INFO:
    2565   00:4DE6  01 03 01                ld  bc,256*ROM_V_P+ROM_V_S
    2566   00:4DE9  11 02 01                ld  de,256*API_V_P+API_V_S
    2567   00:4DEC  21 65 70                ld  hl,APIINFO
    2568   00:4DEF  AF                      xor a
    2569   00:4DF0  C9                      ret
    2570   00:4DF1                      
    2571   00:4DF1                      ;========================
    2572   00:4DF1                      ;===  UNAPI_GET_INFO  ===
    2573   00:4DF1                      ;========================
    2574   00:4DF1                      ; Obtain the implementation name and version for SSH.
    2575   00:4DF1                      ;
    2576   00:4DF1                      ;    Input:  A  = 0
    2577   00:4DF1                      ;    Output: HL = Descriptive string for this implementation, on this slot, zero terminated
    2578   00:4DF1                      ;            DE = API version supported, D.E
    2579   00:4DF1                      ;            BC = This implementation version, B.C.
    2580   00:4DF1                      ;            A  = 0 and Cy = 0
    2581   00:4DF1                      UNAPI_GET_INFO_SSH:
    2582   00:4DF1  01 03 01                ld  bc,256*ROM_V_P+ROM_V_S
    2583   00:4DF4  11 02 01                ld  de,256*API_V_P+API_V_S
    2584   00:4DF7  21 76 70                ld  hl,APIINFO_SSH
    2585   00:4DFA  AF                      xor a
    2586   00:4DFB  C9                      ret
    2587   00:4DFC                      
    2588   00:4DFC                      ;=========================
    2589   00:4DFC                      ;===   SSH_GET_CAPAB   ===
    2590   00:4DFC                      ;=========================
    2591   00:4DFC                      ; Get information about the SSH capabilities and features.
    2592   00:4DFC                      ;
    2593   00:4DFC                      ;    Input:  A = 1
    2594   00:4DFC                      ;            B = Index of information block to retrieve:
    2595   00:4DFC                      ;                1: Block 1 (only block supported, other blocks reserved for expansion)
    2596   00:4DFC                      ;    Output: A = Error code
    2597   00:4DFC                      ;        When information block 1 requested:
    2598   00:4DFC                      ;            HL = Capabilities flags
    2599   00:4DFC                      ;            B  = Maximum simultaneous SSH connections supported
    2600   00:4DFC                      ;            C  = Free SSH connections currently available
    2601   00:4DFC                      ;            DE = Maximum data per command
    2602   00:4DFC                      SSH_GET_CAPAB:
    2603   00:4DFC                          ; SSH functions start at 127 on ESP
    2604   00:4DFC  CB FF                   set 7,a
    2605   00:4DFE                          SEND_DATA                       ; Send the command
    2605   00:4DFE  D3 07             >     out (OUT_TX_PORT),a
    2606   00:4E00  AF                      xor a
    2607   00:4E01                          SEND_DATA                       ; Send the command size msb
    2607   00:4E01  D3 07             >     out (OUT_TX_PORT),a
    2608   00:4E03  3C                      inc a
    2609   00:4E04                          SEND_DATA                       ; Send the command size lsb
    2609   00:4E04  D3 07             >     out (OUT_TX_PORT),a
    2610   00:4E06  78                      ld  a,b
    2611   00:4E07                          SEND_DATA                       ; Send the parameter
    2611   00:4E07  D3 07             >     out (OUT_TX_PORT),a
    2612   00:4E09                      
    2613   00:4E09                          ; Now wait up to 120 ticks to get response
    2614   00:4E09  21 78 00                ld  hl,120
    2615   00:4E0C  CD EC 5E                call    SETCOUNTER
    2616   00:4E0F                      SSH_GET_CAPAB_ST1:
    2617   00:4E0F                          CHECK_DATA
    2617   00:4E0F  DB 07             >     in  a,(IN_STS_PORT)
    2617   00:4E11  CB 47             >     bit 0,a
    2618   00:4E13  20 05                   jr  nz,SSH_GET_CAPAB_ST1.1
    2619   00:4E15  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2620   00:4E18  18 F5                   jr  SSH_GET_CAPAB_ST1
    2621   00:4E1A                      SSH_GET_CAPAB_ST1.1:
    2622   00:4E1A                          ; nz, check the data
    2623   00:4E1A                          RECEIVE_DATA
    2623   00:4E1A  DB 06             >     in a,(IN_DATA_PORT)
    2624   00:4E1C  FE 81                   cp  #81                         ; Is response of our command?
    2625   00:4E1E  20 EF                   jr  nz,SSH_GET_CAPAB_ST1
    2626   00:4E20                          ; Now get return code, if return code other than 0, it is finished
    2627   00:4E20                      SSH_GET_CAPAB_RC:
    2628   00:4E20                          CHECK_DATA
    2628   00:4E20  DB 07             >     in  a,(IN_STS_PORT)
    2628   00:4E22  CB 47             >     bit 0,a
    2629   00:4E24  20 05                   jr  nz,SSH_GET_CAPAB_RC.1
    2630   00:4E26  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2631   00:4E29  18 F5                   jr  SSH_GET_CAPAB_RC
    2632   00:4E2B                      SSH_GET_CAPAB_RC.1:
    2633   00:4E2B                          ; nz, discard
    2634   00:4E2B                          RECEIVE_DATA
    2634   00:4E2B  DB 06             >     in a,(IN_DATA_PORT)
    2635   00:4E2D  B7                      or  a                           ; 0?
    2636   00:4E2E  C0                      ret nz                          ; If not, done
    2637   00:4E2F                      
    2638   00:4E2F                          ; Next two bytes are size bytes, don't care
    2639   00:4E2F  06 02                   ld  b,2
    2640   00:4E31                      SSH_GET_CAPAB_ST2:
    2641   00:4E31                          CHECK_DATA
    2641   00:4E31  DB 07             >     in  a,(IN_STS_PORT)
    2641   00:4E33  CB 47             >     bit 0,a
    2642   00:4E35  20 05                   jr  nz,SSH_GET_CAPAB_ST2.1
    2643   00:4E37  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2644   00:4E3A  18 F5                   jr  SSH_GET_CAPAB_ST2
    2645   00:4E3C                      SSH_GET_CAPAB_ST2.1:
    2646   00:4E3C                          ; Nz, discard
    2647   00:4E3C                          RECEIVE_DATA
    2647   00:4E3C  DB 06             >     in a,(IN_DATA_PORT)
    2648   00:4E3E  05                      dec b
    2649   00:4E3F  20 F0                   jr  nz,SSH_GET_CAPAB_ST2
    2650   00:4E41                      
    2651   00:4E41                      SSH_GET_CAPAB_BLK1_ST1:
    2652   00:4E41                          CHECK_DATA
    2652   00:4E41  DB 07             >     in  a,(IN_STS_PORT)
    2652   00:4E43  CB 47             >     bit 0,a
    2653   00:4E45  20 05                   jr  nz,SSH_GET_CAPAB_BLK1_ST1.1
