    5701   00:5C2B  CB 47             >     bit 0,a
    5702   00:5C2D  20 05                   jr  nz,SSH_RCV_ST2B.1
    5703   00:5C2F  CD AD 5A                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5704   00:5C32  18 F5                   jr  SSH_RCV_ST2B
    5705   00:5C34                      SSH_RCV_ST2B.1:
    5706   00:5C34                          ; nz, low byte count of bytes to receive
    5707   00:5C34                          RECEIVE_DATA
    5707   00:5C34  DB 06             >     in a,(IN_DATA_PORT)
    5708   00:5C36  6F                      ld  l,a
    5709   00:5C37  B4                      or  h
    5710   00:5C38                          ; if it was 0, no data
