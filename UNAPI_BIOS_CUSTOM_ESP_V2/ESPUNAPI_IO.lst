    6268   00:5EF4  CD 9D 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    6269   00:5EF7  18 F5                   jr  SSH_AUTH_GET_CHALLENGE_ST2B
    6270   00:5EF9                      SSH_AUTH_GET_CHALLENGE_ST2B.1:
    6271   00:5EF9                          ; nz, low byte count of bytes to receive
    6272   00:5EF9                          RECEIVE_DATA
    6272   00:5EF9  DB 06             >     in a,(IN_DATA_PORT)
    6273   00:5EFB  6F                      ld  l,a
    6274   00:5EFC  CD EF 60                call    GETBYTE                 ; if return was err buff...
    6275   00:5EFF  D6 0D                   sub 13
    6276   00:5F01  20 1F                   jr  nz,SSH_AUTH_GET_CHALLENGE_ST2BB.1
    6277   00:5F03                          ; If here we need to have A as 13, B and C with needed buffer size
    6278   00:5F03                      SSH_AUTH_GET_CHALLENGE_BUFERRA:
    6279   00:5F03                          CHECK_DATA
    6279   00:5F03  DB 07             >     in  a,(IN_STS_PORT)
    6279   00:5F05  CB 47             >     bit 0,a
    6280   00:5F07  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_BUFERRA.1
    6281   00:5F09  CD 9D 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    6282   00:5F0C  18 F5                   jr  SSH_AUTH_GET_CHALLENGE_BUFERRA
    6283   00:5F0E                      SSH_AUTH_GET_CHALLENGE_BUFERRA.1:
    6284   00:5F0E                          ; nz, low byte count of bytes to receive
    6285   00:5F0E                          RECEIVE_DATA
    6285   00:5F0E  DB 06             >     in a,(IN_DATA_PORT)
    6286   00:5F10  4F                      ld c,a
    6287   00:5F11                      SSH_AUTH_GET_CHALLENGE_BUFERRB:
    6288   00:5F11                          CHECK_DATA
    6288   00:5F11  DB 07             >     in  a,(IN_STS_PORT)
    6288   00:5F13  CB 47             >     bit 0,a
    6289   00:5F15  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_BUFERRB.1
    6290   00:5F17  CD 9D 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    6291   00:5F1A  18 F5                   jr  SSH_AUTH_GET_CHALLENGE_BUFERRB
    6292   00:5F1C                      SSH_AUTH_GET_CHALLENGE_BUFERRB.1:
    6293   00:5F1C                          ; nz, high byte count of bytes to receive
    6294   00:5F1C                          RECEIVE_DATA
    6294   00:5F1C  DB 06             >     in a,(IN_DATA_PORT)
    6295   00:5F1E  47                      ld  b,a
    6296   00:5F1F  3E 0D                   ld  a,13                        ; ERR BUFF
    6297   00:5F21  C9                      ret
    6298   00:5F22                          ; If here, should be ok and will get the data
    6299   00:5F22                      SSH_AUTH_GET_CHALLENGE_ST2BB.1:
    6300   00:5F22  7D                      ld  a,l
    6301   00:5F23  B4                      or  h
    6302   00:5F24                          ; if it was 0, no data
    6303   00:5F24  CA D2 5C                jp  z,TCPIP_TCP_RCV_RET_NODATA  ; not a typo, no need to make the same code again
    6304   00:5F27                          ; Ok, we need to get the flags that will go to HL, we get it in BC and then push to the stack
    6305   00:5F27                      SSH_AUTH_GET_CHALLENGE_FLAGSA:
    6306   00:5F27                          CHECK_DATA
    6306   00:5F27  DB 07             >     in  a,(IN_STS_PORT)
    6306   00:5F29  CB 47             >     bit 0,a
    6307   00:5F2B  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_FLAGSA.1
    6308   00:5F2D  CD 9D 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    6309   00:5F30  18 F5                   jr  SSH_AUTH_GET_CHALLENGE_FLAGSA
    6310   00:5F32                      SSH_AUTH_GET_CHALLENGE_FLAGSA.1:
    6311   00:5F32                          ; nz, prompts, B to later go to H
    6312   00:5F32                          RECEIVE_DATA
    6312   00:5F32  DB 06             >     in a,(IN_DATA_PORT)
    6313   00:5F34  47                      ld b,a
    6314   00:5F35                      SSH_AUTH_GET_CHALLENGE_FLAGSB:
    6315   00:5F35                          CHECK_DATA
    6315   00:5F35  DB 07             >     in  a,(IN_STS_PORT)
    6315   00:5F37  CB 47             >     bit 0,a
    6316   00:5F39  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_FLAGSB.1
    6317   00:5F3B  CD 9D 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    6318   00:5F3E  18 F5                   jr  SSH_AUTH_GET_CHALLENGE_FLAGSB
    6319   00:5F40                      SSH_AUTH_GET_CHALLENGE_FLAGSB.1:
    6320   00:5F40                          ; nz, prompts, C to later go to L
    6321   00:5F40                          RECEIVE_DATA
    6321   00:5F40  DB 06             >     in a,(IN_DATA_PORT)
    6322   00:5F42  4F                      ld c,a
    6323   00:5F43  C5                      push    bc                      ; stack has the flags
    6324   00:5F44                          ; Now let's decrease HL as we've read 2 bytes
    6325   00:5F44  2B                      dec hl
    6326   00:5F45  2B                      dec hl
    6327   00:5F46                          ; And loop for the whole remaining response
    6328   00:5F46  4D                      ld  c,l
    6329   00:5F47  44                      ld  b,h                         ; BC has effective received data size, as well as HL
    6330   00:5F48                          ; put effective data size in de
    6331   00:5F48  EB                      ex  de,hl
    6332   00:5F49                          ; will start moving at address in stack (we've pushed the adress in WORD)
    6333   00:5F49  CD 15 61                call    GETWORD
    6334   00:5F4C  CD 88 61                call    BCBACKUP                ; save count (BC)
    6335   00:5F4F                      
    6336   00:5F4F                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use ini :-D
    6337   00:5F4F  43                      ld  b,e                         ; Number of loops originaly in DE
    6338   00:5F50  1B                      dec de
    6339   00:5F51  14                      inc d
    6340   00:5F52                          if USE_MEM_IO = 0
    6341   00:5F52  0E 06                   ld  c,IN_DATA_PORT
    6342   00:5F54                          CHECK_QUICK_RECEIVE
    6342   00:5F54  3A 07 00          >     ld  a,(IN_STS_PORT)
    6342   00:5F57  CB 5F             >     bit 3,a
    6343   00:5F59  28 14                   jr  z,SSH_AUTH_GET_CHALLENGE_R_NSF             ; If not, go to the old, slower route
    6344   00:5F5B                          ; Otherwise, let's speed it up baby!
    6345   00:5F5B                      SSH_AUTH_GET_CHALLENGE_R:
    6346   00:5F5B  ED B2                   inir
    6347   00:5F5D                          else
    6348   00:5F5D                    ~     CHECK_QUICK_RECEIVE
    6349   00:5F5D                    ~     jr  z,SSH_AUTH_GET_CHALLENGE_R_NSF       ; If not, go to the old, slower route
    6350   00:5F5D                    ~     ; Otherwise, let's speed it up baby!
    6351   00:5F5D                    ~ SSH_AUTH_GET_CHALLENGE_R:
    6352   00:5F5D                    ~     ld  a,(MEM_IN_DATA_PORT)
    6353   00:5F5D                    ~     ld  (hl),a
    6354   00:5F5D                    ~     inc hl
    6355   00:5F5D                    ~     djnz SSH_AUTH_GET_CHALLENGE_R
    6356   00:5F5D                    ~     endif
    6357   00:5F5D  15                      dec d
    6358   00:5F5E  20 FB                   jr nz,SSH_AUTH_GET_CHALLENGE_R
    6359   00:5F60                          CHECK_BUFFER_UNDERRUN
    6359   00:5F60  DB 07             >     in  a,(IN_STS_PORT)
    6359   00:5F62  CB 67             >     bit 4,a
    6360   00:5F64  C2 6F 5E                jp  nz,SSH_AUTH_GET_CHALLENGE_RETRY_QRCV ; If yes, retry
    6361   00:5F67                          ; Otherwise, done
    6362   00:5F67  CD 76 61                call    BCRESTORE               ; done, restore return data in BC
    6363   00:5F6A  03                      inc bc
    6364   00:5F6B  03                      inc bc
    6365   00:5F6C                          ; get flags back from stack
    6366   00:5F6C  E1                      pop hl
    6367   00:5F6D  AF                      xor a
    6368   00:5F6E  C9                      ret
    6369   00:5F6F                      SSH_AUTH_GET_CHALLENGE_R_NSF:
    6370   00:5F6F                          CHECK_DATA
    6370   00:5F6F  DB 07             >     in  a,(IN_STS_PORT)
    6370   00:5F71  CB 47             >     bit 0,a
    6371   00:5F73  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_R_NSF.1
    6372   00:5F75  CD 9D 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    6373   00:5F78  18 F5                   jr  SSH_AUTH_GET_CHALLENGE_R_NSF
    6374   00:5F7A                      SSH_AUTH_GET_CHALLENGE_R_NSF.1:
    6375   00:5F7A                          if USE_MEM_IO = 0
    6376   00:5F7A  ED A2                   ini
    6377   00:5F7C                          else
    6378   00:5F7C                    ~     ld  a,(MEM_IN_DATA_PORT)
    6379   00:5F7C                    ~     ld  (hl),a
    6380   00:5F7C                    ~     inc hl
    6381   00:5F7C                    ~     dec b
    6382   00:5F7C                    ~     endif
    6383   00:5F7C  20 F1                   jr  nz,SSH_AUTH_GET_CHALLENGE_R_NSF
    6384   00:5F7E  15                      dec d
    6385   00:5F7F  20 EE                   jr nz,SSH_AUTH_GET_CHALLENGE_R_NSF
    6386   00:5F81  CD 76 61                call    BCRESTORE               ; done, restore return data in BC
    6387   00:5F84  03                      inc bc
    6388   00:5F85  03                      inc bc
    6389   00:5F86                          ; get flags back from stack
    6390   00:5F86  E1                      pop hl
    6391   00:5F87  AF                      xor a
    6392   00:5F88  C9                      ret
    6393   00:5F89                      
    6394   00:5F89                      ;=============================
    6395   00:5F89                      ;===  TCPIP_CONFIG_AUTOIP  ===
    6396   00:5F89                      ;=============================
    6397   00:5F89                      ;Enable or disable the automatic IP addresses retrieval.
    6398   00:5F89                      ;
    6399   00:5F89                      ;Input:  A = 25
    6400   00:5F89                      ;        B = 0: Get current configuration
    6401   00:5F89                      ;            1: Set configuration
    6402   00:5F89                      ;        C = Configuration to set (only if B=1):
    6403   00:5F89                      ;            bit 0: Set to automatically retrieve
    6404   00:5F89                      ;                   local IP address, subnet mask and default gateway
    6405   00:5F89                      ;            bit 1: Set to automatically retrieve DNS servers addresses
    6406   00:5F89                      ;            bits 2-7: Unused, must be zero
    6407   00:5F89                      ;Output: A = Error code
    6408   00:5F89                      ;        C = Configuration after the routine execution
    6409   00:5F89                      ;            (same format as C at input)
    6410   00:5F89                      TCPIP_CONFIG_AUTOIP:
    6411   00:5F89                          SEND_DATA                       ; Send the command
    6411   00:5F89  D3 07             >     out (OUT_TX_PORT),a
    6412   00:5F8B  AF                      xor a
    6413   00:5F8C                          SEND_DATA                       ; Send the command size msb
    6413   00:5F8C  D3 07             >     out (OUT_TX_PORT),a
    6414   00:5F8E  3E 02                   ld  a,2
    6415   00:5F90                          SEND_DATA                       ; Send the command size lsb
    6415   00:5F90  D3 07             >     out (OUT_TX_PORT),a
    6416   00:5F92  78                      ld  a,b
    6417   00:5F93                          SEND_DATA                       ; Send the command
    6417   00:5F93  D3 07             >     out (OUT_TX_PORT),a
    6418   00:5F95  79                      ld  a,c
    6419   00:5F96                          SEND_DATA                       ; Send the command parameter
    6419   00:5F96  D3 07             >     out (OUT_TX_PORT),a
    6420   00:5F98                      
    6421   00:5F98                          ; Now wait up to 180 ticks to get response
    6422   00:5F98  21 B4 00                ld hl,180
    6423   00:5F9B  CD DF 60                call    SETCOUNTER
    6424   00:5F9E                      TCPIP_CONFIG_AUTOIP_ST1:
    6425   00:5F9E                          CHECK_DATA
    6425   00:5F9E  DB 07             >     in  a,(IN_STS_PORT)
    6425   00:5FA0  CB 47             >     bit 0,a
    6426   00:5FA2  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_ST1.1
    6427   00:5FA4  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6428   00:5FA7  18 F5                   jr  TCPIP_CONFIG_AUTOIP_ST1
    6429   00:5FA9                      TCPIP_CONFIG_AUTOIP_ST1.1:
    6430   00:5FA9                          ; nz, check the data
    6431   00:5FA9                          RECEIVE_DATA
    6431   00:5FA9  DB 06             >     in a,(IN_DATA_PORT)
    6432   00:5FAB  FE 19                   cp  25                          ; Is response of our command?
    6433   00:5FAD  20 EF                   jr  nz,TCPIP_CONFIG_AUTOIP_ST1
    6434   00:5FAF                          ; now get return code, if return code other than 0, it is finished
    6435   00:5FAF                      TCPIP_CONFIG_AUTOIP_RC:
    6436   00:5FAF                          CHECK_DATA
    6436   00:5FAF  DB 07             >     in  a,(IN_STS_PORT)
    6436   00:5FB1  CB 47             >     bit 0,a
    6437   00:5FB3  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_RC.1
    6438   00:5FB5  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6439   00:5FB8  18 F5                   jr  TCPIP_CONFIG_AUTOIP_RC
    6440   00:5FBA                      TCPIP_CONFIG_AUTOIP_RC.1:
    6441   00:5FBA                          ;nz, discard
    6442   00:5FBA                          RECEIVE_DATA
    6442   00:5FBA  DB 06             >     in a,(IN_DATA_PORT)
    6443   00:5FBC  B7                      or  a                           ; 0?
    6444   00:5FBD  C0                      ret nz                          ; if not, done
    6445   00:5FBE                      
    6446   00:5FBE                          ; next two bytes are return code and size bytes, don't care, it is 1, configuration
    6447   00:5FBE  06 02                   ld  b,2
    6448   00:5FC0                      TCPIP_CONFIG_AUTOIP_ST2:
    6449   00:5FC0                          CHECK_DATA
    6449   00:5FC0  DB 07             >     in  a,(IN_STS_PORT)
    6449   00:5FC2  CB 47             >     bit 0,a
    6450   00:5FC4  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_ST2.1
    6451   00:5FC6  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6452   00:5FC9  18 F5                   jr  TCPIP_CONFIG_AUTOIP_ST2
    6453   00:5FCB                      TCPIP_CONFIG_AUTOIP_ST2.1:
    6454   00:5FCB                          ; nz, discard
    6455   00:5FCB                          RECEIVE_DATA
    6455   00:5FCB  DB 06             >     in a,(IN_DATA_PORT)
    6456   00:5FCD  05                      dec b
    6457   00:5FCE  20 F0                   jr  nz,TCPIP_CONFIG_AUTOIP_ST2
    6458   00:5FD0                      
    6459   00:5FD0                          ; now just get the 1 byte, configuration, should go to C
    6460   00:5FD0                      TCPIP_CONFIG_AUTOIP_CONF_ST1:
    6461   00:5FD0                          CHECK_DATA
    6461   00:5FD0  DB 07             >     in  a,(IN_STS_PORT)
    6461   00:5FD2  CB 47             >     bit 0,a
    6462   00:5FD4  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_CONF_ST1.1
    6463   00:5FD6  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6464   00:5FD9  18 F5                   jr  TCPIP_CONFIG_AUTOIP_CONF_ST1
    6465   00:5FDB                      TCPIP_CONFIG_AUTOIP_CONF_ST1.1:
    6466   00:5FDB                          ; nz, get it
    6467   00:5FDB                          RECEIVE_DATA
    6467   00:5FDB  DB 06             >     in a,(IN_DATA_PORT)
    6468   00:5FDD  4F                      ld  c,a
    6469   00:5FDE                          ; done
    6470   00:5FDE  AF                      xor a
    6471   00:5FDF  C9                      ret
    6472   00:5FE0                      
    6473   00:5FE0                      ;=========================
    6474   00:5FE0                      ;===  TCPIP_CONFIG_IP  ===
    6475   00:5FE0                      ;=========================
    6476   00:5FE0                      ;Manually configure an IP address.
    6477   00:5FE0                      ;
    6478   00:5FE0                      ;Input:  A = 26
    6479   00:5FE0                      ;        B = Index of address to set:
    6480   00:5FE0                      ;            1: Local IP address
    6481   00:5FE0                      ;            2: Peer IP address
    6482   00:5FE0                      ;            3: Subnet mask
    6483   00:5FE0                      ;            4: Default gateway
    6484   00:5FE0                      ;            5: Primary DNS server IP address
    6485   00:5FE0                      ;            6: Secondary DNS server IP address
    6486   00:5FE0                      ;        L.H.E.D = Address value
    6487   00:5FE0                      ;Output: A = Error code
    6488   00:5FE0                      TCPIP_CONFIG_IP:
    6489   00:5FE0                          SEND_DATA                       ; Send the command
    6489   00:5FE0  D3 07             >     out (OUT_TX_PORT),a
    6490   00:5FE2  AF                      xor a
    6491   00:5FE3                          SEND_DATA                       ; Send the command size msb
    6491   00:5FE3  D3 07             >     out (OUT_TX_PORT),a
    6492   00:5FE5  3E 05                   ld  a,5
    6493   00:5FE7                          SEND_DATA                       ; Send the command size lsb
    6493   00:5FE7  D3 07             >     out (OUT_TX_PORT),a
    6494   00:5FE9  78                      ld  a,b
    6495   00:5FEA                          SEND_DATA                       ; Send the address to set
    6495   00:5FEA  D3 07             >     out (OUT_TX_PORT),a
    6496   00:5FEC  7D                      ld  a,l
    6497   00:5FED                          SEND_DATA                       ; Send the IP first byte
    6497   00:5FED  D3 07             >     out (OUT_TX_PORT),a
    6498   00:5FEF  7C                      ld  a,h
    6499   00:5FF0                          SEND_DATA                       ; Send the IP second byte
    6499   00:5FF0  D3 07             >     out (OUT_TX_PORT),a
    6500   00:5FF2  7B                      ld  a,e
    6501   00:5FF3                          SEND_DATA                       ; Send the IP third byte
    6501   00:5FF3  D3 07             >     out (OUT_TX_PORT),a
    6502   00:5FF5  7A                      ld  a,d
    6503   00:5FF6                          SEND_DATA                       ; Send the IP fourth byte
    6503   00:5FF6  D3 07             >     out (OUT_TX_PORT),a
    6504   00:5FF8                      
    6505   00:5FF8                          ; Now wait up to 180 ticks to get response
    6506   00:5FF8  21 B4 00                ld  hl,180
    6507   00:5FFB  CD DF 60                call    SETCOUNTER
    6508   00:5FFE                      TCPIP_CONFIG_IP_ST1:
    6509   00:5FFE                          CHECK_DATA
    6509   00:5FFE  DB 07             >     in  a,(IN_STS_PORT)
    6509   00:6000  CB 47             >     bit 0,a
    6510   00:6002  20 05                   jr  nz,TCPIP_CONFIG_IP_ST1.1
    6511   00:6004  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6512   00:6007  18 F5                   jr  TCPIP_CONFIG_IP_ST1
    6513   00:6009                      TCPIP_CONFIG_IP_ST1.1:
    6514   00:6009                          ; nz, check the data
    6515   00:6009                          RECEIVE_DATA
    6515   00:6009  DB 06             >     in a,(IN_DATA_PORT)
    6516   00:600B  FE 1A                   cp  26                          ; Is response of our command?
    6517   00:600D  20 EF                   jr  nz,TCPIP_CONFIG_IP_ST1
    6518   00:600F                          ; now get return code, and that is it
    6519   00:600F                      TCPIP_CONFIG_IP_RC:
    6520   00:600F                          CHECK_DATA
    6520   00:600F  DB 07             >     in  a,(IN_STS_PORT)
    6520   00:6011  CB 47             >     bit 0,a
    6521   00:6013  20 05                   jr  nz,TCPIP_CONFIG_IP_RC.1
    6522   00:6015  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6523   00:6018  18 F5                   jr  TCPIP_CONFIG_IP_RC
    6524   00:601A                      TCPIP_CONFIG_IP_RC.1:
    6525   00:601A                          ; nz, discard
    6526   00:601A                          RECEIVE_DATA
    6526   00:601A  DB 06             >     in a,(IN_DATA_PORT)
    6527   00:601C  C9                      ret                             ; done
    6528   00:601D                      
    6529   00:601D                      ;==========================
    6530   00:601D                      ;===  TCPIP_CONFIG_TTL  ===
    6531   00:601D                      ;==========================
    6532   00:601D                      ;Get/set the value of TTL and TOS for outgoing datagrams.
    6533   00:601D                      ;
    6534   00:601D                      ;Input:  A = 27
    6535   00:601D                      ;        B = 0: Get current values (just return 255 for TTL and 0 for TOS
    6536   00:601D                      ;               as ESP do not expose or allow configurations of it)
    6537   00:601D                      ;            1: Set values
    6538   00:601D                      ;        D = New value for TTL (only if B=1)
    6539   00:601D                      ;        E = New value for ToS (only if B=1)
    6540   00:601D                      ;Output: A = Error code
    6541   00:601D                      ;        D = Value of TTL after the routine execution
    6542   00:601D                      ;        E = Value of ToS after the routine execution
    6543   00:601D                      TCPIP_CONFIG_TTL:
    6544   00:601D  78                      ld  a,b
    6545   00:601E  E6 FE                   and %11111110
    6546   00:6020  B7                      or  a
    6547   00:6021  3E 04                   ld  a,ERR_INV_PARAM
    6548   00:6023  C0                      ret nz
    6549   00:6024  78                      ld  a,b
    6550   00:6025  B7                      or  a
    6551   00:6026                          ; Cant set, so NOT IMP
    6552   00:6026  3E 01                   ld  a,ERR_NOT_IMP
    6553   00:6028  C0                      ret nz                          ; if not get, not implemented
    6554   00:6029                          ; get, so just return D = #FF, A = OK = 0 and E = 0
    6555   00:6029  AF                      xor a
    6556   00:602A  1E 00                   ld  e,0
    6557   00:602C  16 FF                   ld  d,#FF
    6558   00:602E  C9                      ret
    6559   00:602F                      
    6560   00:602F                      ;===========================
    6561   00:602F                      ;===  TCPIP_CONFIG_PING  ===
    6562   00:602F                      ;===========================
    6563   00:602F                      ;Get/set the automatic PING reply flag.
    6564   00:602F                      ;
    6565   00:602F                      ;Input:  A = 28
    6566   00:602F                      ;        B = 0: Get current flag value
    6567   00:602F                      ;            1: Set flag value (ERR_NOT_IMP)
    6568   00:602F                      ;        C = New flag value (only if B=1):
