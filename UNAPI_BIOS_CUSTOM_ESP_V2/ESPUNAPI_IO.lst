    3562   00:5276                      ;========================
    3563   00:5276                      ;===  TCPIP_UDP_SEND  ===
    3564   00:5276                      ;========================
    3565   00:5276                      ;Send an UDP datagram.
    3566   00:5276                      ;
    3567   00:5276                      ;Input:  A = 11
    3568   00:5276                      ;        B = Connection number
    3569   00:5276                      ;        HL = Address of datagram data
    3570   00:5276                      ;        DE = Address of parameters block
    3571   00:5276                      ;Output: A = Error code
    3572   00:5276                      ;
    3573   00:5276                      ;Parameters block:
    3574   00:5276                      ;
    3575   00:5276                      ;    +0 (4): Destination IP address
    3576   00:5276                      ;    +4 (2): Destination port
    3577   00:5276                      ;    +6 (2): Data length
    3578   00:5276                      TCPIP_UDP_SEND:
    3579   00:5276  E5                      push    hl
    3580   00:5277  D5                      push    de
    3581   00:5278                          SEND_DATA                       ; Send the command
    3581   00:5278  D3 07             >     out (OUT_TX_PORT),a
    3582   00:527A                          ; prepare new data size, adding our 7 bytes overhead
    3583   00:527A  DD 62                   ld  ixh,d
    3584   00:527C  DD 6B                   ld  ixl,e
    3585   00:527E  11 07 00                ld  de,7
    3586   00:5281  DD 6E 06                ld  l,(ix+6)
    3587   00:5284  DD 66 07                ld  h,(ix+7)
    3588   00:5287  19                      add hl,de
    3589   00:5288  7C                      ld  a,h
    3590   00:5289                          SEND_DATA                       ; Send the command size msb
    3590   00:5289  D3 07             >     out (OUT_TX_PORT),a
    3591   00:528B  7D                      ld  a,l
    3592   00:528C                          SEND_DATA                       ; Send the command size lsb
    3592   00:528C  D3 07             >     out (OUT_TX_PORT),a
    3593   00:528E  78                      ld  a,b
    3594   00:528F                          SEND_DATA                       ; Send the connection #
    3594   00:528F  D3 07             >     out (OUT_TX_PORT),a
    3595   00:5291  D1                      pop de
    3596   00:5292  E1                      pop hl
    3597   00:5293  1A                      ld  a,(de)
    3598   00:5294                          SEND_DATA                       ; Send IP byte 1
    3598   00:5294  D3 07             >     out (OUT_TX_PORT),a
    3599   00:5296  13                      inc de
    3600   00:5297  1A                      ld  a,(de)
    3601   00:5298                          SEND_DATA                       ; Send IP byte 2
    3601   00:5298  D3 07             >     out (OUT_TX_PORT),a
    3602   00:529A  13                      inc de
    3603   00:529B  1A                      ld  a,(de)
    3604   00:529C                          SEND_DATA                       ; Send IP byte 3
    3604   00:529C  D3 07             >     out (OUT_TX_PORT),a
    3605   00:529E  13                      inc de
    3606   00:529F  1A                      ld  a,(de)
    3607   00:52A0                          SEND_DATA                       ; Send IP byte 4
    3607   00:52A0  D3 07             >     out (OUT_TX_PORT),a
    3608   00:52A2  13                      inc de
    3609   00:52A3  1A                      ld  a,(de)
    3610   00:52A4                          SEND_DATA                       ; Send Port LSB
    3610   00:52A4  D3 07             >     out (OUT_TX_PORT),a
    3611   00:52A6  13                      inc de
    3612   00:52A7  1A                      ld  a,(de)
    3613   00:52A8                          SEND_DATA                       ; Send Port MSB
    3613   00:52A8  D3 07             >     out (OUT_TX_PORT),a
    3614   00:52AA                          ; now oti the data starting at hl, size is in next DE position
    3615   00:52AA  13                      inc de
    3616   00:52AB  1A                      ld  a,(de)
    3617   00:52AC  47                      ld  b,a                         ; save lsb in b
    3618   00:52AD  13                      inc de
    3619   00:52AE  1A                      ld  a,(de)                      ; msb
    3620   00:52AF  57                      ld  d,a                         ; put in D, there is no ld d,(de)
    3621   00:52B0  58                      ld  e,b                         ; lsb
    3622   00:52B1                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    3623   00:52B1                          ;ld b,e                         ; Number of loops originaly in DE, not needed, b already has e
    3624   00:52B1  1B                      dec de
    3625   00:52B2  14                      inc d
    3626   00:52B3                          if USE_MEM_IO = 0
    3627   00:52B3  0E 07                   ld  c,OUT_TX_PORT
    3628   00:52B5                      TCPIP_UDP_SEND_R:
    3629   00:52B5  ED B3                   otir                            ; Send until B is 0
    3630   00:52B7                          else
    3631   00:52B7                    ~ TCPIP_UDP_SEND_R:
    3632   00:52B7                    ~     ld  a,(hl)
    3633   00:52B7                    ~     ld  (MEM_OUT_TX_PORT),a
    3634   00:52B7                    ~     inc hl
    3635   00:52B7                    ~     djnz TCPIP_UDP_SEND_R
    3636   00:52B7                    ~     endif
    3637   00:52B7  15                      dec d                           ; decrement secondary counter
    3638   00:52B8  20 FB                   jr  nz,TCPIP_UDP_SEND_R         ; If still have another round, do it
    3639   00:52BA                          ; Now wait up to 600 ticks to get response
    3640   00:52BA  21 58 02                ld  hl,600
    3641   00:52BD  CD C0 5C                call    SETCOUNTER
    3642   00:52C0                      TCPIP_UDP_SEND_ST1:
    3643   00:52C0                          CHECK_DATA
    3643   00:52C0  DB 07             >     in  a,(IN_STS_PORT)
    3643   00:52C2  CB 47             >     bit 0,a
    3644   00:52C4  20 05                   jr  nz,TCPIP_UDP_SEND_ST1.1
    3645   00:52C6  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3646   00:52C9  18 F5                   jr  TCPIP_UDP_SEND_ST1
    3647   00:52CB                      TCPIP_UDP_SEND_ST1.1:
    3648   00:52CB                          ; nz, check the data
    3649   00:52CB                          RECEIVE_DATA
    3649   00:52CB  DB 06             >     in a,(IN_DATA_PORT)
    3650   00:52CD  FE 0B                   cp  11                          ; Is response of our command?
    3651   00:52CF  20 EF                   jr  nz,TCPIP_UDP_SEND_ST1
    3652   00:52D1                          ; now get return code, if return code other than 0, it is finished
    3653   00:52D1                      TCPIP_UDP_SEND_RC:
    3654   00:52D1                          CHECK_DATA
    3654   00:52D1  DB 07             >     in  a,(IN_STS_PORT)
    3654   00:52D3  CB 47             >     bit 0,a
    3655   00:52D5  20 05                   jr  nz,TCPIP_UDP_SEND_RC.1
    3656   00:52D7  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3657   00:52DA  18 F5                   jr  TCPIP_UDP_SEND_RC
    3658   00:52DC                      TCPIP_UDP_SEND_RC.1:
    3659   00:52DC                          ; nz, discard
    3660   00:52DC                          RECEIVE_DATA
    3660   00:52DC  DB 06             >     in a,(IN_DATA_PORT)
    3661   00:52DE  B7                      or  a                           ; 0?
    3662   00:52DF  C0                      ret nz                          ; if not, done
    3663   00:52E0                      
    3664   00:52E0                          ; next two bytes are return code and size bytes, don't care, it is 0
    3665   00:52E0  06 02                   ld  b,2
    3666   00:52E2                      TCPIP_UDP_SEND_ST2:
    3667   00:52E2                          CHECK_DATA
    3667   00:52E2  DB 07             >     in  a,(IN_STS_PORT)
    3667   00:52E4  CB 47             >     bit 0,a
    3668   00:52E6  20 05                   jr  nz,TCPIP_UDP_SEND_ST2.1
    3669   00:52E8  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3670   00:52EB  18 F5                   jr  TCPIP_UDP_SEND_ST2
    3671   00:52ED                      TCPIP_UDP_SEND_ST2.1:
    3672   00:52ED                          ; nz, discard
    3673   00:52ED                          RECEIVE_DATA
    3673   00:52ED  DB 06             >     in a,(IN_DATA_PORT)
    3674   00:52EF  05                      dec b
    3675   00:52F0  20 F0                   jr  nz,TCPIP_UDP_SEND_ST2
    3676   00:52F2                      
    3677   00:52F2                          ; done, no return data other than return code
    3678   00:52F2  AF                      xor a
    3679   00:52F3  C9                      ret
    3680   00:52F4                      
    3681   00:52F4                      ;=======================
    3682   00:52F4                      ;===  TCPIP_UDP_RCV  ===
    3683   00:52F4                      ;=======================
    3684   00:52F4                      ;Retrieve an incoming UDP datagram.
    3685   00:52F4                      ;
    3686   00:52F4                      ;Input:  A = 12
    3687   00:52F4                      ;        B = Connection number
    3688   00:52F4                      ;        HL = Address for datagram data
    3689   00:52F4                      ;        DE = Maximum data size to retrieve
    3690   00:52F4                      ;Output: A = Error code
    3691   00:52F4                      ;        L.H.E.D = Source IP address
    3692   00:52F4                      ;        IX = Source port
    3693   00:52F4                      ;        BC = Actual received data size
    3694   00:52F4                      
    3695   00:52F4                      ; Customized TIME OUT routine: If time out receiving data, retry as received data
    3696   00:52F4                      ; won't be re-sent as host is unaware of this
    3697   00:52F4                      TCPIP_UDP_RCV_CHECK_TIME_OUT:
    3698   00:52F4                          ; Save registers other than AF
    3699   00:52F4  C5                      push bc
    3700   00:52F5  D5                      push de
    3701   00:52F6  E5                      push hl
    3702   00:52F7  CD B1 5C                call    GETCOUNTER
    3703   00:52FA  7D                      ld  a,l
    3704   00:52FB  B4                      or  h
    3705   00:52FC                          ; Restore registers, we are returning
    3706   00:52FC  E1                      pop hl
    3707   00:52FD  D1                      pop de
    3708   00:52FE  C1                      pop bc
    3709   00:52FF  C0                      ret nz
    3710   00:5300                          ; Ok, timeout...
    3711   00:5300  F1                      pop af                          ; Get return address of who called this out of the stack, we will return from the function or re-start
    3712   00:5301                      TCPIP_TCP_UDP_RETRY_QRCV:
    3713   00:5301  CD D0 5C                call    GETBYTE
    3714   00:5304  B7                      or  a
    3715   00:5305  28 0B                   jr  z,TCPIP_UDP_RCV_CHECK_TIME_OUT.NORXRETRY
    3716   00:5307                          ; Ok, so let's ask ESP to re-send the data and retry receiving it
    3717   00:5307  3D                      dec a
    3718   00:5308  CD E2 5C                call    SETBYTE                 ; we are retrying it
    3719   00:530B  3E 72                   ld  a,'r'                       ; retry transmission command
    3720   00:530D                          SEND_DATA
    3720   00:530D  D3 07             >     out (OUT_TX_PORT),a
    3721   00:530F  C3 31 53                jp  TCPIP_UDP_RCV.RXRETRY       ; and retry it
    3722   00:5312                      TCPIP_UDP_RCV_CHECK_TIME_OUT.NORXRETRY:
    3723   00:5312  3E 0F                   ld  a,ERR_INV_OPER
    3724   00:5314  C9                      ret                             ; and return the function itself
    3725   00:5315                      
    3726   00:5315                      TCPIP_UDP_RCV:
    3727   00:5315  CD 09 5D                call    SETWORD                 ; Save for later the datagram address
    3728   00:5318  3E 0C                   ld  a,12
    3729   00:531A                          SEND_DATA                       ; Send the command
    3729   00:531A  D3 07             >     out (OUT_TX_PORT),a
    3730   00:531C  AF                      xor a
    3731   00:531D                          SEND_DATA                       ; Send the command size msb
    3731   00:531D  D3 07             >     out (OUT_TX_PORT),a
    3732   00:531F  3E 03                   ld  a,3
    3733   00:5321                          SEND_DATA                       ; Send the command size lsb
    3733   00:5321  D3 07             >     out (OUT_TX_PORT),a
    3734   00:5323  78                      ld  a,b
    3735   00:5324                          SEND_DATA                       ; Send the connection #
    3735   00:5324  D3 07             >     out (OUT_TX_PORT),a
    3736   00:5326  7B                      ld  a,e
    3737   00:5327                          SEND_DATA                       ; Send MAX rcv size LSB
    3737   00:5327  D3 07             >     out (OUT_TX_PORT),a
    3738   00:5329  7A                      ld  a,d
    3739   00:532A                          SEND_DATA                       ; Send MAX rcv size MSB
    3739   00:532A  D3 07             >     out (OUT_TX_PORT),a
    3740   00:532C  3E 03                   ld  a,3
    3741   00:532E  CD E2 5C                call    SETBYTE                 ; Ok, retry up to three times
    3742   00:5331                      TCPIP_UDP_RCV.RXRETRY:
    3743   00:5331                          ; Now wait up to 600 ticks to get response
    3744   00:5331  21 58 02                ld  hl,600
    3745   00:5334  CD C0 5C                call    SETCOUNTER
    3746   00:5337                      TCPIP_UDP_RCV_ST1:
    3747   00:5337                          CHECK_DATA
    3747   00:5337  DB 07             >     in  a,(IN_STS_PORT)
    3747   00:5339  CB 47             >     bit 0,a
    3748   00:533B  20 05                   jr  nz,TCPIP_UDP_RCV_ST1.1
    3749   00:533D  CD F4 52                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3750   00:5340  18 F5                   jr  TCPIP_UDP_RCV_ST1
    3751   00:5342                      TCPIP_UDP_RCV_ST1.1:
    3752   00:5342                          ; nz, check the data
    3753   00:5342                          RECEIVE_DATA
    3753   00:5342  DB 06             >     in a,(IN_DATA_PORT)
    3754   00:5344  FE 0C                   cp  12                          ; Is response of our command?
    3755   00:5346  20 EF                   jr  nz,TCPIP_UDP_RCV_ST1
    3756   00:5348                          ; At this point, all data is being buffered, so 30 ticks, half second, is more than enough time-out
    3757   00:5348  F3                      di
    3758   00:5349  21 1E 00                ld  hl,30
    3759   00:534C  CD C0 5C                call    SETCOUNTER
    3760   00:534F  FB                      ei
    3761   00:5350                          ; now get return code, if return code other than 0, it is finished
    3762   00:5350                      TCPIP_UDP_RCV_RC:
    3763   00:5350                          CHECK_DATA
    3763   00:5350  DB 07             >     in  a,(IN_STS_PORT)
    3763   00:5352  CB 47             >     bit 0,a
    3764   00:5354  20 05                   jr  nz,TCPIP_UDP_RCV_RC.1
    3765   00:5356  CD F4 52                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3766   00:5359  18 F5                   jr  TCPIP_UDP_RCV_RC
    3767   00:535B                      TCPIP_UDP_RCV_RC.1:
    3768   00:535B                          ; nz, discard
    3769   00:535B                          RECEIVE_DATA
    3769   00:535B  DB 06             >     in a,(IN_DATA_PORT)
    3770   00:535D  B7                      or  a                           ; 0?
    3771   00:535E  C0                      ret nz                          ; if not, done
    3772   00:535F                          ; next two bytes are return code and size bytes, save it to BC
    3773   00:535F                      TCPIP_UDP_RCV_ST2A:
    3774   00:535F                          CHECK_DATA
    3774   00:535F  DB 07             >     in  a,(IN_STS_PORT)
    3774   00:5361  CB 47             >     bit 0,a
    3775   00:5363  20 05                   jr  nz,TCPIP_UDP_RCV_ST2A.1
    3776   00:5365  CD F4 52                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3777   00:5368  18 F5                   jr  TCPIP_UDP_RCV_ST2A
    3778   00:536A                      TCPIP_UDP_RCV_ST2A.1:
    3779   00:536A                          ; nz, discard
    3780   00:536A                          RECEIVE_DATA
    3780   00:536A  DB 06             >     in a,(IN_DATA_PORT)
    3781   00:536C  67                      ld  h,a
    3782   00:536D                      TCPIP_UDP_RCV_ST2B:
    3783   00:536D                          CHECK_DATA
    3783   00:536D  DB 07             >     in  a,(IN_STS_PORT)
    3783   00:536F  CB 47             >     bit 0,a
    3784   00:5371  20 05                   jr  nz,TCPIP_UDP_RCV_ST2B.1
    3785   00:5373  CD F4 52                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3786   00:5376  18 F5                   jr  TCPIP_UDP_RCV_ST2B
    3787   00:5378                      TCPIP_UDP_RCV_ST2B.1:
    3788   00:5378                          ; nz, discard
    3789   00:5378                          RECEIVE_DATA
    3789   00:5378  DB 06             >     in a,(IN_DATA_PORT)
    3790   00:537A  6F                      ld  l,a
    3791   00:537B  01 06 00                ld  bc,6
    3792   00:537E                          ; subtract 6 (IP and PORT)
    3793   00:537E  AF                      xor a                           ; zero carry
    3794   00:537F  ED 42                   sbc hl,bc
    3795   00:5381  4D                      ld  c,l
    3796   00:5382  44                      ld  b,h                         ; BC has effective received data size
    3797   00:5383                          ; now just get the 4 bytes IP and place it in L H E D
    3798   00:5383                      TCPIP_UDP_RCV_IP_ST1:
    3799   00:5383                          CHECK_DATA
    3799   00:5383  DB 07             >     in  a,(IN_STS_PORT)
    3799   00:5385  CB 47             >     bit 0,a
    3800   00:5387  20 05                   jr  nz,TCPIP_UDP_RCV_IP_ST1.1
    3801   00:5389  CD F4 52                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3802   00:538C  18 F5                   jr  TCPIP_UDP_RCV_IP_ST1
    3803   00:538E                      TCPIP_UDP_RCV_IP_ST1.1:
    3804   00:538E                          ; nz, get it
    3805   00:538E                          RECEIVE_DATA
    3805   00:538E  DB 06             >     in a,(IN_DATA_PORT)
    3806   00:5390  6F                      ld  l,a
    3807   00:5391                      TCPIP_UDP_RCV_IP_ST2:
    3808   00:5391                          CHECK_DATA
    3808   00:5391  DB 07             >     in  a,(IN_STS_PORT)
    3808   00:5393  CB 47             >     bit 0,a
    3809   00:5395  20 05                   jr  nz,TCPIP_UDP_RCV_IP_ST2.1
    3810   00:5397  CD F4 52                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3811   00:539A  18 F5                   jr  TCPIP_UDP_RCV_IP_ST2
    3812   00:539C                      TCPIP_UDP_RCV_IP_ST2.1:
    3813   00:539C                          ; nz, get it
    3814   00:539C                          RECEIVE_DATA
    3814   00:539C  DB 06             >     in a,(IN_DATA_PORT)
    3815   00:539E  67                      ld  h,a
    3816   00:539F                      TCPIP_UDP_RCV_IP_ST3:
    3817   00:539F                          CHECK_DATA
    3817   00:539F  DB 07             >     in  a,(IN_STS_PORT)
    3817   00:53A1  CB 47             >     bit 0,a
    3818   00:53A3  20 05                   jr  nz,TCPIP_UDP_RCV_IP_ST3.1
    3819   00:53A5  CD F4 52                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3820   00:53A8  18 F5                   jr  TCPIP_UDP_RCV_IP_ST3
    3821   00:53AA                      TCPIP_UDP_RCV_IP_ST3.1:
    3822   00:53AA                          ; nz, get it
    3823   00:53AA                          RECEIVE_DATA
    3823   00:53AA  DB 06             >     in a,(IN_DATA_PORT)
    3824   00:53AC  5F                      ld  e,a
    3825   00:53AD                      TCPIP_UDP_RCV_IP_ST4:
    3826   00:53AD                          CHECK_DATA
    3826   00:53AD  DB 07             >     in  a,(IN_STS_PORT)
    3826   00:53AF  CB 47             >     bit 0,a
    3827   00:53B1  20 05                   jr  nz,TCPIP_UDP_RCV_IP_ST4.1
    3828   00:53B3  CD F4 52                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3829   00:53B6  18 F5                   jr  TCPIP_UDP_RCV_IP_ST4
    3830   00:53B8                      TCPIP_UDP_RCV_IP_ST4.1:
    3831   00:53B8                          ; nz, get it
    3832   00:53B8                          RECEIVE_DATA
    3832   00:53B8  DB 06             >     in a,(IN_DATA_PORT)
    3833   00:53BA  57                      ld  d,a
    3834   00:53BB                          ; now get the 2 bytes port and place in IXL and IXH
    3835   00:53BB                      TCPIP_UDP_RCV_PORT_ST1:
    3836   00:53BB                          CHECK_DATA
    3836   00:53BB  DB 07             >     in  a,(IN_STS_PORT)
    3836   00:53BD  CB 47             >     bit 0,a
    3837   00:53BF  20 05                   jr  nz,TCPIP_UDP_RCV_PORT_ST1.1
    3838   00:53C1  CD F4 52                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3839   00:53C4  18 F5                   jr  TCPIP_UDP_RCV_PORT_ST1
    3840   00:53C6                      TCPIP_UDP_RCV_PORT_ST1.1:
    3841   00:53C6                          ; nz, get it
    3842   00:53C6                          RECEIVE_DATA
    3842   00:53C6  DB 06             >     in a,(IN_DATA_PORT)
    3843   00:53C8  DD 6F                   ld  ixl,a
    3844   00:53CA                      TCPIP_UDP_RCV_PORT_ST2:
    3845   00:53CA                          CHECK_DATA
    3845   00:53CA  DB 07             >     in  a,(IN_STS_PORT)
    3845   00:53CC  CB 47             >     bit 0,a
    3846   00:53CE  20 05                   jr  nz,TCPIP_UDP_RCV_PORT_ST2.1
    3847   00:53D0  CD F4 52                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3848   00:53D3  18 F5                   jr  TCPIP_UDP_RCV_PORT_ST2
    3849   00:53D5                      TCPIP_UDP_RCV_PORT_ST2.1:
    3850   00:53D5                          ; nz, get it
    3851   00:53D5                          RECEIVE_DATA
    3851   00:53D5  DB 06             >     in a,(IN_DATA_PORT)
    3852   00:53D7  DD 67                   ld  ixh,a
    3853   00:53D9                      
    3854   00:53D9                          ; save the received data in memory
    3855   00:53D9  CD 35 5D                call    REGBACKUP               ; Save the data received so far, registers will change
    3856   00:53DC                          ; will start moving at RCV_ADDRESS that was stored in our WORD
    3857   00:53DC  CD F6 5C                call    GETWORD
    3858   00:53DF                          ; size goes to DE
    3859   00:53DF  50                      ld  d,b
    3860   00:53E0  59                      ld  e,c
    3861   00:53E1                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use ini :-D
    3862   00:53E1  43                      ld  b,e                         ; Number of loops originaly in DE
    3863   00:53E2  1B                      dec de
    3864   00:53E3  14                      inc d
    3865   00:53E4                          if USE_MEM_IO = 0
    3866   00:53E4  0E 06                   ld  c,IN_DATA_PORT
    3867   00:53E6                          endif
    3868   00:53E6                          CHECK_QUICK_RECEIVE
    3868   00:53E6  3A 07 00          >     ld  a,(IN_STS_PORT)
    3868   00:53E9  CB 5F             >     bit 3,a
    3869   00:53EB  28 11                   jr  z,TCPIP_UDP_RCV_R_NSF       ; If not, go to the old, slower route
    3870   00:53ED                          ; Otherwise, let's speed it up baby!
    3871   00:53ED                      TCPIP_UDP_RCV_R:
    3872   00:53ED                          if USE_MEM_IO = 0
    3873   00:53ED  ED B2                   inir
    3874   00:53EF                          else
    3875   00:53EF                    ~     ld  a,(MEM_IN_DATA_PORT)
    3876   00:53EF                    ~     ld  (hl),a
    3877   00:53EF                    ~     inc hl
    3878   00:53EF                    ~     djnz TCPIP_UDP_RCV_R
    3879   00:53EF                    ~     endif
    3880   00:53EF  15                      dec d
    3881   00:53F0  20 FB                   jr  nz,TCPIP_UDP_RCV_R
    3882   00:53F2                          CHECK_BUFFER_UNDERRUN
    3882   00:53F2  DB 07             >     in  a,(IN_STS_PORT)
    3882   00:53F4  CB 67             >     bit 4,a
    3883   00:53F6  C2 01 53                jp  nz,TCPIP_TCP_UDP_RETRY_QRCV ; If yes, retry
    3884   00:53F9                          ; Otherwise, done
    3885   00:53F9                          ; done, restore return data in DE BC and HL
    3886   00:53F9  CD 1E 5D                call    REGRESTORE
    3887   00:53FC  AF                      xor a
    3888   00:53FD  C9                      ret
    3889   00:53FE                          ; Slower route if Interface doesn't implement quick receive
    3890   00:53FE                      TCPIP_UDP_RCV_R_NSF:
    3891   00:53FE                          CHECK_DATA
    3891   00:53FE  DB 07             >     in  a,(IN_STS_PORT)
    3891   00:5400  CB 47             >     bit 0,a
    3892   00:5402  20 05                   jr  nz,TCPIP_UDP_RCV_R_NSF.1
    3893   00:5404  CD F4 52                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3894   00:5407  18 F5                   jr  TCPIP_UDP_RCV_R_NSF
    3895   00:5409                      TCPIP_UDP_RCV_R_NSF.1:
    3896   00:5409                          if USE_MEM_IO = 0
    3897   00:5409  ED A2                   ini
    3898   00:540B                          else
    3899   00:540B                    ~     ld  a,(MEM_IN_DATA_PORT)
    3900   00:540B                    ~     ld  (hl),a
    3901   00:540B                    ~     inc hl
    3902   00:540B                    ~     dec b
    3903   00:540B                    ~     endif
    3904   00:540B  20 F1                   jr  nz,TCPIP_UDP_RCV_R_NSF          ; We do not use INIR because we don't know if there is more data, avoiding geting a junk 0xFF
    3905   00:540D  15                      dec d
    3906   00:540E  20 EE                   jr  nz,TCPIP_UDP_RCV_R_NSF
    3907   00:5410                          ; done, restore return data in DE BC and HL
    3908   00:5410  CD 1E 5D                call    REGRESTORE
    3909   00:5413  AF                      xor a
    3910   00:5414  C9                      ret
    3911   00:5415                      
    3912   00:5415                      ;========================
    3913   00:5415                      ;===  TCPIP_TCP_OPEN  ===
    3914   00:5415                      ;========================
    3915   00:5415                      ;Open a TCP connection.
    3916   00:5415                      ;
    3917   00:5415                      ;Input:  A  = 13
    3918   00:5415                      ;        HL = Address of parameters block
    3919   00:5415                      ;Output: A = Error code
    3920   00:5415                      ;        B = Connection number
    3921   00:5415                      ;        C = Connection not open reason (mostly for TLS)
    3922   00:5415                      ;
    3923   00:5415                      ;Parameters block format:
    3924   00:5415                      ;
    3925   00:5415                      ;+0 (4): Remote IP address (0.0.0.0 for unspecified remote socket)
    3926   00:5415                      ;+4 (2): Remote port (ignored if unspecified remote socket)
    3927   00:5415                      ;+6 (2): Local port, 0FFFFh for a random value
    3928   00:5415                      ;+8 (2): Suggestion for user timeout value
    3929   00:5415                      ;+10 (1): Flags:
    3930   00:5415                      ;         bit 0: Set for passive connection
    3931   00:5415                      ;         bit 1: Set for resident connection
    3932   00:5415                      ;         bit 2: Set for TLS connection
    3933   00:5415                      ;         bit 3: Set for TLS connection validating host certificate
    3934   00:5415                      ;+11 (2): If 0000 no host name validation, otherwise the hostname string address (zero terminated)
    3935   00:5415                      ;TCP_OPEN_IP1               (ix+0)
    3936   00:5415                      ;TCP_OPEN_IP2               (ix+1)
    3937   00:5415                      ;TCP_OPEN_IP3               (ix+2)
    3938   00:5415                      ;TCP_OPEN_IP4               (ix+3)
    3939   00:5415                      ;TCP_OPEN_RP                (ix+4)
    3940   00:5415                      ;TCP_OPEN_LP                (ix+6)
    3941   00:5415                      ;TCP_OPEN_TO                (ix+8)
    3942   00:5415                      ;TCP_OPEN_CMD_FLAGS         (ix+10)
    3943   00:5415                      ;TCP_OPEN_CMD_HOST_LSB      (ix+11)
    3944   00:5415                      ;TCP_OPEN_CMD_HOST_MSB      (ix+12)
    3945   00:5415                      
    3946   00:5415                      ; When no connection, let's get the reason and put in register C, as agreed
    3947   00:5415                      ; with Nestor this will be the way to go in the next UNAPI revision
    3948   00:5415                      TCPIP_TCP_OPEN_ERROR:
    3949   00:5415                          ; next two bytes are return code and size bytes, don't care, it is 1, conn close reason
    3950   00:5415  47                      ld  b,a                         ; save error in b
    3951   00:5416  0E 02                   ld  c,2
    3952   00:5418                      TCPIP_TCP_OPEN_ERROR2:
    3953   00:5418                          CHECK_DATA
    3953   00:5418  DB 07             >     in  a,(IN_STS_PORT)
    3953   00:541A  CB 47             >     bit 0,a
    3954   00:541C  20 05                   jr  nz,TCPIP_TCP_OPEN_ERROR2.1
    3955   00:541E  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3956   00:5421  18 F5                   jr  TCPIP_TCP_OPEN_ERROR2
    3957   00:5423                      TCPIP_TCP_OPEN_ERROR2.1:
    3958   00:5423                          ; nz, discard
    3959   00:5423                          RECEIVE_DATA
    3959   00:5423  DB 06             >     in a,(IN_DATA_PORT)
    3960   00:5425  0D                      dec c
    3961   00:5426  20 F0                   jr  nz,TCPIP_TCP_OPEN_ERROR2
    3962   00:5428  78                      ld  a,b
    3963   00:5429  FE 0B                   cp  ERR_NO_CONN
    3964   00:542B  20 0E                   jr  nz,TCPIP_TCP_OPEN_ERROR4    ; other errors do not have extra bytes as result
    3965   00:542D                      ; now just get the 1 byte, close reason, should go to C
    3966   00:542D                      TCPIP_TCP_OPEN_ERROR3:
    3967   00:542D                          CHECK_DATA
    3967   00:542D  DB 07             >     in  a,(IN_STS_PORT)
    3967   00:542F  CB 47             >     bit 0,a
    3968   00:5431  20 05                   jr  nz,TCPIP_TCP_OPEN_ERROR3.1
    3969   00:5433  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3970   00:5436  18 F5                   jr  TCPIP_TCP_OPEN_ERROR3
    3971   00:5438                      TCPIP_TCP_OPEN_ERROR3.1:
    3972   00:5438                          ; nz, get it
    3973   00:5438                          RECEIVE_DATA
    3973   00:5438  DB 06             >     in a,(IN_DATA_PORT)
    3974   00:543A  4F                      ld  c,a
    3975   00:543B                      TCPIP_TCP_OPEN_ERROR4:
    3976   00:543B                          ; now return w/ error that is saved in b
    3977   00:543B  78                      ld  a,b
    3978   00:543C  06 00                   ld  b,0                         ; no connection, so 0
    3979   00:543E  C9                      ret
    3980   00:543F                      
    3981   00:543F                      TCPIP_TCP_OPEN:
    3982   00:543F  E5                      push    hl                      ; save param block address
    3983   00:5440  7C                      ld  a,h
    3984   00:5441  DD 67                   ld  ixh,a
    3985   00:5443  7D                      ld  a,l
    3986   00:5444  DD 6F                   ld  ixl,a
    3987   00:5446                          ; IX now has the parameters area
    3988   00:5446                          ; most times it will be non tls, so this is the first test case
    3989   00:5446  21 0B 00                ld  hl,11
    3990   00:5449  CD 09 5D                call    SETWORD                 ; If it is non-TLS, send 11 bytes
    3991   00:544C  DD 7E 0A                ld  a,(ix+10)                   ; TCP_OPEN_CMD_FLAGS
    3992   00:544F  CB 57                   bit 2,a
    3993   00:5451  28 5A                   jr  z,TCPIP_TCP_OPEN_NO_TLS
    3994   00:5453                      
    3995   00:5453                          ; TLS, but, do we have host name?
    3996   00:5453  21 0C 00                ld  hl,12
    3997   00:5456  CD 09 5D                call    SETWORD                 ; If it is TLS without host name, send 12 bytes, one zero as host name suffice
    3998   00:5459  DD 6E 0B                ld  l,(ix+11)                   ; TCP_OPEN_CMD_HOST_LSB
    3999   00:545C  DD 7E 0C                ld  a,(ix+12)                   ; TCP_OPEN_CMD_HOST_MSB
    4000   00:545F  B5                      or  l
    4001   00:5460                          ; if TLS and next two bytes are 00 no host to check
    4002   00:5460  28 4B                   jr  z,TCPIP_TCP_OPEN_NO_CHECKHOST
    4003   00:5462                          ; we are here, host to check
    4004   00:5462  DD 66 0C                ld  h,(ix+12)                   ; TCP_OPEN_CMD_HOST_MSB
    4005   00:5465  D1                      pop de                          ; Retrieve parameters address
    4006   00:5466  E5                      push    hl                      ; Save host name address
    4007   00:5467  D5                      push    de                      ; Save Parameters address (so it is in the order we are going to need)
    4008   00:5468                          ; let's check how many bytes there are
    4009   00:5468  11 0B 00                ld  de,11                       ; Start with 11, all params except host name
    4010   00:546B                      TCPIP_TCP_OPEN_CHECK_HOSTOF:
    4011   00:546B  7E                      ld  a,(hl)
    4012   00:546C  13                      inc de                          ; Not zero, so increase size count
    4013   00:546D  23                      inc hl                          ; And next hostname byte
    4014   00:546E  B7                      or  a                           ; If zero, hostname terminated
    4015   00:546F                          ; Loop until terminator (0) is found
    4016   00:546F  C2 6B 54                jp  nz,TCPIP_TCP_OPEN_CHECK_HOSTOF
    4017   00:5472                      
    4018   00:5472                      TCPIP_TCP_OPEN_HOSTNAME_SENDCMDWITHHOSTNAME:
    4019   00:5472                          ; Ok, so, DE has the full hostname size, let's start sending from here
    4020   00:5472  3E 0D                   ld  a,13                        ; Function TCP OPEN
    4021   00:5474                          SEND_DATA                       ; Send the command
    4021   00:5474  D3 07             >     out (OUT_TX_PORT),a
    4022   00:5476  7A                      ld  a,d
    4023   00:5477                          SEND_DATA                       ; Send the command size msb
    4023   00:5477  D3 07             >     out (OUT_TX_PORT),a
    4024   00:5479  7B                      ld  a,e
    4025   00:547A                          SEND_DATA                       ; Send the command size lsb
    4025   00:547A  D3 07             >     out (OUT_TX_PORT),a
    4026   00:547C  E1                      pop hl                          ; Restore the memory address for the parameters
    4027   00:547D                          ; First send the 11 bytes parameters
    4028   00:547D                          if USE_MEM_IO = 0
    4029   00:547D  0E 07                   ld  c,OUT_TX_PORT
    4030   00:547F  ED A3                   outi
    4031   00:5481  ED A3                   outi
    4032   00:5483  ED A3                   outi
    4033   00:5485  ED A3                   outi
    4034   00:5487  ED A3                   outi
    4035   00:5489  ED A3                   outi
    4036   00:548B  ED A3                   outi
    4037   00:548D  ED A3                   outi
    4038   00:548F  ED A3                   outi
    4039   00:5491  ED A3                   outi
    4040   00:5493  ED A3                   outi                            ; Unrolled outi is a bit faster :)
    4041   00:5495                          else
    4042   00:5495                    ~     ld  b,11                        ; Send 11 bytes
    4043   00:5495                    ~ TCPIP_TCP_OPEN_HOSTNAME_SENDCMDWITHHOSTNAME_LOOP_PARAM:
    4044   00:5495                    ~     ld  a,(hl)
    4045   00:5495                    ~     ld  (MEM_OUT_TX_PORT),a
    4046   00:5495                    ~     inc hl
    4047   00:5495                    ~     djnz TCPIP_TCP_OPEN_HOSTNAME_SENDCMDWITHHOSTNAME_LOOP_PARAM
    4048   00:5495                    ~     endif
    4049   00:5495  EB                      ex  de,hl                       ; Size in HL
    4050   00:5496  11 0B 00                ld  de,11
    4051   00:5499  B7                      or  a                           ; zero flag
    4052   00:549A  ED 52                   sbc hl,de
    4053   00:549C  EB                      ex de,hl                        ; and adjusted size back in de
    4054   00:549D  E1                      pop hl                          ; Restore the memory address for hostname
    4055   00:549E                      ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    4056   00:549E  43                      ld  b,e                         ; Number of loops originaly in DE
    4057   00:549F  1B                      dec de
    4058   00:54A0  14                      inc d
    4059   00:54A1                          if USE_MEM_IO = 0
    4060   00:54A1  0E 07                   ld  c,OUT_TX_PORT
    4061   00:54A3                      TCPIP_TCP_OPEN_SENDHOSTNAME:
    4062   00:54A3  ED A3                   outi
    4063   00:54A5  20 FC                   jr  nz,TCPIP_TCP_OPEN_SENDHOSTNAME
    4064   00:54A7                          else
    4065   00:54A7                    ~ TCPIP_TCP_OPEN_SENDHOSTNAME:
    4066   00:54A7                    ~     ld  a,(hl)
    4067   00:54A7                    ~     ld  (MEM_OUT_TX_PORT),a
    4068   00:54A7                    ~     inc hl
    4069   00:54A7                    ~     djnz TCPIP_TCP_OPEN_SENDHOSTNAME
    4070   00:54A7                    ~     endif
    4071   00:54A7  15                      dec d
    4072   00:54A8  20 F9                   jr  nz,TCPIP_TCP_OPEN_SENDHOSTNAME
    4073   00:54AA  C3 C9 54                jp  TCPIP_TCP_OPEN_WAIT_RESPONSE
    4074   00:54AD                      
    4075   00:54AD                      TCPIP_TCP_OPEN_NO_TLS:
    4076   00:54AD                      TCPIP_TCP_OPEN_NO_CHECKHOST:
    4077   00:54AD  3E 0D                   ld  a,13                        ; Function TCP OPEN
    4078   00:54AF                          SEND_DATA                       ; Send the command
    4078   00:54AF  D3 07             >     out (OUT_TX_PORT),a
    4079   00:54B1  CD F6 5C                call    GETWORD
    4080   00:54B4  7C                      ld  a,h
    4081   00:54B5  57                      ld  d,a
    4082   00:54B6                          SEND_DATA                       ; Send the command size msb
    4082   00:54B6  D3 07             >     out (OUT_TX_PORT),a
    4083   00:54B8  7D                      ld  a,l
    4084   00:54B9  5F                      ld  e,a
    4085   00:54BA                          SEND_DATA                       ; Send the command size lsb
    4085   00:54BA  D3 07             >     out (OUT_TX_PORT),a
    4086   00:54BC                      
    4087   00:54BC  E1                      pop hl                          ; Restore the memory address for the parameters
    4088   00:54BD                      ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    4089   00:54BD  43                      ld  b,e                         ; Number of loops originaly in DE
    4090   00:54BE  1B                      dec de
    4091   00:54BF  14                      inc d
    4092   00:54C0                          if USE_MEM_IO = 0
    4093   00:54C0  0E 07                   ld  c,OUT_TX_PORT
    4094   00:54C2                      TCPIP_TCP_OPEN_R:
    4095   00:54C2  ED A3                   outi
    4096   00:54C4  20 FC                   jr  nz,TCPIP_TCP_OPEN_R
    4097   00:54C6                          else
    4098   00:54C6                    ~ TCPIP_TCP_OPEN_R:
    4099   00:54C6                    ~     ld  a,(hl)
    4100   00:54C6                    ~     ld  (MEM_OUT_TX_PORT),a
    4101   00:54C6                    ~     inc hl
    4102   00:54C6                    ~     djnz TCPIP_TCP_OPEN_R
    4103   00:54C6                    ~     endif
    4104   00:54C6  15                      dec d
    4105   00:54C7  20 F9                   jr  nz,TCPIP_TCP_OPEN_R
    4106   00:54C9                      
    4107   00:54C9                      TCPIP_TCP_OPEN_WAIT_RESPONSE:
    4108   00:54C9                          ; Now wait up to 3600 (1 minute @ 60Hz) ticks to get response
    4109   00:54C9                          ; TLS Connections might take SEVERAL seconds on TLS Handshake
    4110   00:54C9                          ; Even more if certificates database is being indexed
    4111   00:54C9  21 10 0E                ld  hl,3600
    4112   00:54CC  CD C0 5C                call    SETCOUNTER
    4113   00:54CF                      TCPIP_TCP_OPEN_ST1:
    4114   00:54CF                          CHECK_DATA
    4114   00:54CF  DB 07             >     in  a,(IN_STS_PORT)
    4114   00:54D1  CB 47             >     bit 0,a
    4115   00:54D3  20 05                   jr  nz,TCPIP_TCP_OPEN_ST1.1
    4116   00:54D5  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4117   00:54D8  18 F5                   jr  TCPIP_TCP_OPEN_ST1
    4118   00:54DA                      TCPIP_TCP_OPEN_ST1.1:
    4119   00:54DA                          ; nz, check the data
    4120   00:54DA                          RECEIVE_DATA
    4120   00:54DA  DB 06             >     in a,(IN_DATA_PORT)
    4121   00:54DC  FE 0D                   cp  13                          ; Is response of our command?
    4122   00:54DE  20 EF                   jr  nz,TCPIP_TCP_OPEN_ST1
    4123   00:54E0                          ; now get return code, if return code other than 0, it is finished
    4124   00:54E0                      TCPIP_TCP_OPEN_RC:
    4125   00:54E0                          CHECK_DATA
    4125   00:54E0  DB 07             >     in  a,(IN_STS_PORT)
    4125   00:54E2  CB 47             >     bit 0,a
    4126   00:54E4  20 05                   jr  nz,TCPIP_TCP_OPEN_RC.1
    4127   00:54E6  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4128   00:54E9  18 F5                   jr  TCPIP_TCP_OPEN_RC
    4129   00:54EB                      TCPIP_TCP_OPEN_RC.1:
    4130   00:54EB                          ; nz, discard
    4131   00:54EB                          RECEIVE_DATA
    4131   00:54EB  DB 06             >     in a,(IN_DATA_PORT)
    4132   00:54ED  B7                      or  a                           ; 0?
    4133   00:54EE  C2 15 54                jp  nz,TCPIP_TCP_OPEN_ERROR
    4134   00:54F1                      
    4135   00:54F1                          ; next two bytes are size bytes, don't care, it is 1, conn #
    4136   00:54F1  06 02                   ld  b,2
    4137   00:54F3                      TCPIP_TCP_OPEN_ST2:
    4138   00:54F3                          CHECK_DATA
    4138   00:54F3  DB 07             >     in  a,(IN_STS_PORT)
    4138   00:54F5  CB 47             >     bit 0,a
    4139   00:54F7  20 05                   jr  nz,TCPIP_TCP_OPEN_ST2.1
    4140   00:54F9  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4141   00:54FC  18 F5                   jr  TCPIP_TCP_OPEN_ST2
    4142   00:54FE                      TCPIP_TCP_OPEN_ST2.1:
    4143   00:54FE                          ; nz, discard
    4144   00:54FE                          RECEIVE_DATA
    4144   00:54FE  DB 06             >     in a,(IN_DATA_PORT)
    4145   00:5500  05                      dec b
    4146   00:5501  20 F0                   jr  nz,TCPIP_TCP_OPEN_ST2
    4147   00:5503                      
    4148   00:5503                          ; now just get the 1 byte, conn#, should go to B
    4149   00:5503                      TCPIP_TCP_OPEN_CONN_ST1:
    4150   00:5503                          CHECK_DATA
    4150   00:5503  DB 07             >     in  a,(IN_STS_PORT)
    4150   00:5505  CB 47             >     bit 0,a
    4151   00:5507  20 05                   jr  nz,TCPIP_TCP_OPEN_CONN_ST1.1
    4152   00:5509  CD CE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4153   00:550C  18 F5                   jr  TCPIP_TCP_OPEN_CONN_ST1
    4154   00:550E                      TCPIP_TCP_OPEN_CONN_ST1.1:
    4155   00:550E                          ; nz, get it
    4156   00:550E                          RECEIVE_DATA
