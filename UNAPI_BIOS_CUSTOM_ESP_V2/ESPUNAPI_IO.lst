    7003   00:61AF                      ;    Output: none
    7004   00:61AF                      ;    Modifies: AF
    7005   00:61AF                      
    7006   00:61AF                      HLBACKUP:
    7007   00:61AF  D5                      push    de
    7008   00:61B0  C5                      push    bc
    7009   00:61B1  E5                      push    hl
