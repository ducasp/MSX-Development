    3517   00:523D  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3518   00:5240  18 F5                   jr  TCPIP_UDP_STATE_RC
    3519   00:5242                      TCPIP_UDP_STATE_RC.1:
    3520   00:5242                          ; nz, discard
