    3938   00:543F                      ;========================
    3939   00:543F                      ;===  TCPIP_TCP_OPEN  ===
    3940   00:543F                      ;========================
    3941   00:543F                      ;Open a TCP connection.
    3942   00:543F                      ;
    3943   00:543F                      ;Input:  A  = 13
    3944   00:543F                      ;        HL = Address of parameters block
    3945   00:543F                      ;Output: A = Error code
    3946   00:543F                      ;        B = Connection number
    3947   00:543F                      ;        C = Connection not open reason (mostly for TLS)
    3948   00:543F                      ;
    3949   00:543F                      ;Parameters block format:
    3950   00:543F                      ;
    3951   00:543F                      ;+0 (4): Remote IP address (0.0.0.0 for unspecified remote socket)
    3952   00:543F                      ;+4 (2): Remote port (ignored if unspecified remote socket)
    3953   00:543F                      ;+6 (2): Local port, 0FFFFh for a random value
    3954   00:543F                      ;+8 (2): Suggestion for user timeout value
    3955   00:543F                      ;+10 (1): Flags:
    3956   00:543F                      ;         bit 0: Set for passive connection
    3957   00:543F                      ;         bit 1: Set for resident connection
    3958   00:543F                      ;         bit 2: Set for TLS connection
    3959   00:543F                      ;         bit 3: Set for TLS connection validating host certificate
    3960   00:543F                      ;+11 (2): If 0000 no host name validation, otherwise the hostname string address (zero terminated)
    3961   00:543F                      ;TCP_OPEN_IP1               (ix+0)
    3962   00:543F                      ;TCP_OPEN_IP2               (ix+1)
    3963   00:543F                      ;TCP_OPEN_IP3               (ix+2)
    3964   00:543F                      ;TCP_OPEN_IP4               (ix+3)
    3965   00:543F                      ;TCP_OPEN_RP                (ix+4)
    3966   00:543F                      ;TCP_OPEN_LP                (ix+6)
    3967   00:543F                      ;TCP_OPEN_TO                (ix+8)
    3968   00:543F                      ;TCP_OPEN_CMD_FLAGS         (ix+10)
    3969   00:543F                      ;TCP_OPEN_CMD_HOST_LSB      (ix+11)
    3970   00:543F                      ;TCP_OPEN_CMD_HOST_MSB      (ix+12)
    3971   00:543F                      
    3972   00:543F                      ; When no connection, let's get the reason and put in register C, as agreed
    3973   00:543F                      ; with Nestor this will be the way to go in the next UNAPI revision
    3974   00:543F                      TCPIP_TCP_OPEN_ERROR:
    3975   00:543F                          ; next two bytes are return code and size bytes, don't care, it is 1, conn close reason
    3976   00:543F  47                      ld  b,a                         ; save error in b
    3977   00:5440  0E 02                   ld  c,2
    3978   00:5442                      TCPIP_TCP_OPEN_ERROR2:
    3979   00:5442                          CHECK_DATA
    3979   00:5442  DB 07             >     in  a,(IN_STS_PORT)
    3979   00:5444  CB 47             >     bit 0,a
    3980   00:5446  20 05                   jr  nz,TCPIP_TCP_OPEN_ERROR2.1
    3981   00:5448  CD DC 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3982   00:544B  18 F5                   jr  TCPIP_TCP_OPEN_ERROR2
    3983   00:544D                      TCPIP_TCP_OPEN_ERROR2.1:
    3984   00:544D                          ; nz, discard
    3985   00:544D                          RECEIVE_DATA
    3985   00:544D  DB 06             >     in a,(IN_DATA_PORT)
    3986   00:544F  0D                      dec c
    3987   00:5450  20 F0                   jr  nz,TCPIP_TCP_OPEN_ERROR2
    3988   00:5452  78                      ld  a,b
    3989   00:5453  FE 0B                   cp  ERR_NO_CONN
    3990   00:5455  20 0E                   jr  nz,TCPIP_TCP_OPEN_ERROR4    ; other errors do not have extra bytes as result
    3991   00:5457                      ; now just get the 1 byte, close reason, should go to C
    3992   00:5457                      TCPIP_TCP_OPEN_ERROR3:
    3993   00:5457                          CHECK_DATA
    3993   00:5457  DB 07             >     in  a,(IN_STS_PORT)
    3993   00:5459  CB 47             >     bit 0,a
    3994   00:545B  20 05                   jr  nz,TCPIP_TCP_OPEN_ERROR3.1
