    1215   00:4625  3E 30                   ld  a,'0'
    1216   00:4627  83                      add a,e
    1217   00:4628  5F                      ld  e,a                         ; To make it easy in the selection screen
    1218   00:4629                      WIFI_SELECT_AP:
    1219   00:4629  CD 9F 00                call    CHGET
    1220   00:462C  FE 1B                   cp  #1b                         ; ESC?
