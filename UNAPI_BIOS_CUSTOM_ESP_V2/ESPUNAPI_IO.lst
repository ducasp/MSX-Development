    5836   00:5CC0                          RECEIVE_DATA
    5836   00:5CC0  DB 06             >     in a,(IN_DATA_PORT)
    5837   00:5CC2  FE 89                   cp #89                          ; Is response of our command?
    5838   00:5CC4  20 EF                   jr  nz,SSH_AUTH_GET_CHALLENGE_ST1
    5839   00:5CC6                          ; At this point, all data is being buffered, so 15 ticks, quarter second, is more than enough time-out
    5840   00:5CC6  F3                      di
    5841   00:5CC7  21 1E 00                ld  hl,30
    5842   00:5CCA  CD EC 5E                call    SETCOUNTER
    5843   00:5CCD  FB                      ei
    5844   00:5CCE                          ; now get return code, if return code other than 0, it is finished
    5845   00:5CCE                      SSH_AUTH_GET_CHALLENGE_RC:
    5846   00:5CCE                          CHECK_DATA
    5846   00:5CCE  DB 07             >     in  a,(IN_STS_PORT)
    5846   00:5CD0  CB 47             >     bit 0,a
    5847   00:5CD2  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_RC.1
    5848   00:5CD4  CD AD 5A                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5849   00:5CD7  18 F5                   jr  SSH_AUTH_GET_CHALLENGE_RC
    5850   00:5CD9                      SSH_AUTH_GET_CHALLENGE_RC.1:
    5851   00:5CD9                          ; nz, discard
    5852   00:5CD9                          RECEIVE_DATA
    5852   00:5CD9  DB 06             >     in a,(IN_DATA_PORT)
    5853   00:5CDB  CD 0E 5F                call    SETBYTE                 ; Save return just in case
    5854   00:5CDE  B7                      or  a                           ; 0?
    5855   00:5CDF  28 0D                   jr  z,SSH_AUTH_GET_CHALLENGE_ST2A              ; if not, done
    5856   00:5CE1  D6 0D                   sub 13                          ; 13? ERR BUFF will return the desired buffer size
    5857   00:5CE3  28 09                   jr  z,SSH_AUTH_GET_CHALLENGE_ST2A;
    5858   00:5CE5  C6 0D                   add 13                          ; restore error code
    5859   00:5CE7  01 00 00                ld  bc,0                        ; no data received
    5860   00:5CEA  21 00 00                ld  hl,0
    5861   00:5CED  C9                      ret
    5862   00:5CEE                          ; next two bytes are response size bytes save it to BC
    5863   00:5CEE                      SSH_AUTH_GET_CHALLENGE_ST2A:
    5864   00:5CEE                          CHECK_DATA
