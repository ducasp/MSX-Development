    2295   00:4CDE                      
    2296   00:4CDE                      DO_EXTBIO2:
    2297   00:4CDE                          ; A=1: Return A=Slot, B=Segment, HL=UNAPI entry address
    2298   00:4CDE                      
    2299   00:4CDE  3D                      dec a
    2300   00:4CDF  20 0D                   jr  nz,DO_EXTBIO3
    2301   00:4CE1  E1                      pop hl
    2302   00:4CE2  CD 74 5E                call    GETSLTT                 ; GETSLTT is GETSLT that checks if our memory area @ HIMEM has been allocated, if not, allocate it
    2303   00:4CE5  06 FF                   ld  b,#FF
    2304   00:4CE7  21 46 4D                ld  hl,UNAPI_ENTRY
    2305   00:4CEA  11 22 22                ld  de,#2222
    2306   00:4CED  C9                      ret
    2307   00:4CEE                      
    2308   00:4CEE                          ; A>1: A=A-1, and jump to old hook
    2309   00:4CEE                      
    2310   00:4CEE                      DO_EXTBIO3:                         ; A=A-1 already done
    2311   00:4CEE  E3                      ex  (sp),hl
    2312   00:4CEF  11 22 22                ld   de,#2222
    2313   00:4CF2  C9                      ret
    2314   00:4CF3                      
    2315   00:4CF3                      SSH_CHECK:
    2316   00:4CF3                          ; Check API ID SSH
    2317   00:4CF3  21 69 70                ld  hl,UNAPI_ID2
    2318   00:4CF6  11 47 F8                ld  de,ARG
    2319   00:4CF9                      LOOPSSH:
    2320   00:4CF9  1A                      ld  a,(de)
    2321   00:4CFA  CD 5D 60                call    TOUPPER
    2322   00:4CFD  BE                      cp  (hl)
    2323   00:4CFE  20 37                   jr  nz,JUMP_OLD2
    2324   00:4D00  23                      inc hl
    2325   00:4D01  13                      inc de
    2326   00:4D02  B7                      or  a
    2327   00:4D03  20 F4                   jr  nz,LOOPSSH
    2328   00:4D05                      
    2329   00:4D05                          ; API ID matched, offer only if SSH support was determined at boot
    2330   00:4D05  CD F5 5F                call    GETESPFLAGS
    2331   00:4D08  E6 02                   and ESPFLAG_SSH
    2332   00:4D0A  28 2B                   jr  z,JUMP_OLD2
    2333   00:4D0C                      
    2334   00:4D0C                          ; A=255: Jump to old hook
    2335   00:4D0C                      
    2336   00:4D0C  F1                      pop af
    2337   00:4D0D  F5                      push    af
    2338   00:4D0E  3C                      inc a
    2339   00:4D0F  28 26                   jr  z,JUMP_OLD2
    2340   00:4D11                      
    2341   00:4D11                          ; A=0: B=B+1 and jump to old hook
    2342   00:4D11                      
    2343   00:4D11  CD 54 5E                call    GETSLT
    2344   00:4D14  CD AD 5E                call    GETWRK
    2345   00:4D17  F1                      pop af
    2346   00:4D18  C1                      pop bc
    2347   00:4D19  B7                      or  a
    2348   00:4D1A  20 06                   jr  nz,DO_EXTBIO2SSH
    2349   00:4D1C  04                      inc b
    2350   00:4D1D  E3                      ex  (sp),hl
    2351   00:4D1E  11 22 22                ld  de,#2222
    2352   00:4D21  C9                      ret
    2353   00:4D22                      
    2354   00:4D22                      DO_EXTBIO2SSH:
    2355   00:4D22                          ; A=1: Return A=Slot, B=Segment, HL=UNAPI entry address
    2356   00:4D22                      
    2357   00:4D22  3D                      dec a
    2358   00:4D23  20 0D                   jr  nz,DO_EXTBIO3SSH
    2359   00:4D25  E1                      pop hl
    2360   00:4D26  CD 74 5E                call    GETSLTT                 ; GETSLTT is GETSLT that checks if our memory area @ HIMEM has been allocated, if not, allocate it
    2361   00:4D29  06 FF                   ld  b,#FF
    2362   00:4D2B  21 A3 4D                ld  hl,UNAPI2_ENTRY
    2363   00:4D2E  11 22 22                ld  de,#2222
    2364   00:4D31  C9                      ret
    2365   00:4D32                      
    2366   00:4D32                          ; A>1: A=A-1, and jump to old hook
    2367   00:4D32                      
    2368   00:4D32                      DO_EXTBIO3SSH:                         ; A=A-1 already done
    2369   00:4D32  E3                      ex  (sp),hl
    2370   00:4D33  11 22 22                ld  de,#2222
    2371   00:4D36  C9                      ret
    2372   00:4D37                      
    2373   00:4D37                      ; Jump here to execute old EXTBIO code
    2374   00:4D37                      JUMP_OLD2:
    2375   00:4D37  11 22 22                ld  de,#2222
    2376   00:4D3A                      JUMP_OLD:                           ; Assumes "push hl,bc,af" done
    2377   00:4D3A  D5                      push    de
    2378   00:4D3B  CD 54 5E                call    GETSLT
    2379   00:4D3E  CD AD 5E                call    GETWRK
    2380   00:4D41  D1                      pop de
    2381   00:4D42  F1                      pop af
    2382   00:4D43  C1                      pop bc
    2383   00:4D44  E3                      ex  (sp),hl
    2384   00:4D45  C9                      ret
    2385   00:4D46                      
    2386   00:4D46                      ;====================================
    2387   00:4D46                      ;===  Functions entry point code  ===
    2388   00:4D46                      ;===            TCP/IP            ===
    2389   00:4D46                      ;====================================
    2390   00:4D46                      UNAPI_ENTRY:
    2391   00:4D46  FB                      ei
    2392   00:4D47  E5                      push    hl
    2393   00:4D48  F5                      push    af
    2394   00:4D49  21 67 4D                ld  hl,FN_TABLE
    2395   00:4D4C  CB 7F                   bit 7,a
    2396   00:4D4E  20 14                   jr  nz,UNDEFINED
    2397   00:4D50                      
    2398   00:4D50  FE 1D                   cp  MAX_FN
    2399   00:4D52  28 02                   jr  z,OK_FNUM
    2400   00:4D54  30 0E                   jr  nc,UNDEFINED
    2401   00:4D56                      
    2402   00:4D56                      OK_FNUM:
    2403   00:4D56  87                      add a,a
    2404   00:4D57  D5                      push    de
    2405   00:4D58  5F                      ld  e,a
    2406   00:4D59  16 00                   ld  d,0
    2407   00:4D5B  19                      add hl,de
    2408   00:4D5C  D1                      pop de
    2409   00:4D5D                      
    2410   00:4D5D  7E                      ld  a,(hl)
    2411   00:4D5E  23                      inc hl
    2412   00:4D5F  66                      ld  h,(hl)
    2413   00:4D60  6F                      ld  l,a
    2414   00:4D61                      
    2415   00:4D61  F1                      pop af
    2416   00:4D62  E3                      ex  (sp),hl
    2417   00:4D63  C9                      ret
    2418   00:4D64                      
    2419   00:4D64                      ; Undefined function: return with registers unmodified
    2420   00:4D64                      UNDEFINED:
    2421   00:4D64  F1                      pop af
    2422   00:4D65  E1                      pop hl
    2423   00:4D66  C9                      ret
    2424   00:4D67                      
    2425   00:4D67                      ;===================================
    2426   00:4D67                      ;===  Functions addresses table  ===
    2427   00:4D67                      ;===            TCP/IP           ===
    2428   00:4D67                      ;===================================
    2429   00:4D67                      ;--- Implementation-specific routines addresses table
    2430   00:4D67                      FN_TABLE:
    2431   00:4D67  EE 4D               FN_0:                   dw  UNAPI_GET_INFO
    2432   00:4D69  9F 4E               FN_1:                   dw  TCPIP_GET_CAPAB
    2433   00:4D6B  CF 4F               FN_2:                   dw  TCPIP_GET_IPINFO
    2434   00:4D6D  4C 50               FN_3:                   dw  TCPIP_NET_STATE
    2435   00:4D6F                      ; TCPIP_SEND_ECHO not going to be implemented, ESP do not support ping like UNAPI specify
    2436   00:4D6F  D9 4D               FN_4:                   dw  FN_NOT_IMP
    2437   00:4D71                      ; TCPIP_RCV_ECHO not going to be implemented as SEND_ECHO is not implemented
    2438   00:4D71  D9 4D               FN_5:                   dw  FN_NOT_IMP
    2439   00:4D73  9B 50               FN_6:                   dw  TCPIP_DNS_Q
    2440   00:4D75  4A 51               FN_7:                   dw  TCPIP_DNS_S
    2441   00:4D77  77 51               FN_8:                   dw  TCPIP_UDP_OPEN
    2442   00:4D79  D1 51               FN_9:                   dw  TCPIP_UDP_CLOSE
    2443   00:4D7B  17 52               FN_10:                  dw  TCPIP_UDP_STATE
    2444   00:4D7D  A2 52               FN_11:                  dw  TCPIP_UDP_SEND
    2445   00:4D7F  41 53               FN_12:                  dw  TCPIP_UDP_RCV
    2446   00:4D81  6A 54               FN_13:                  dw  TCPIP_TCP_OPEN
    2447   00:4D83  3E 55               FN_14:                  dw  TCPIP_TCP_CLOSE
    2448   00:4D85  3F 58               FN_15:                  dw  TCPIP_TCP_ABORT
    2449   00:4D87  A8 58               FN_16:                  dw  TCPIP_TCP_STATE
    2450   00:4D89  AD 59               FN_17:                  dw  TCPIP_TCP_SEND
    2451   00:4D8B  F1 5A               FN_18:                  dw  TCPIP_TCP_RCV
    2452   00:4D8D                      ; TCPIP_TCP_FLUSH makes no sense as we do not use buffers to send, any buffer is internal to ESP and we can't delete
    2453   00:4D8D  D9 4D               FN_19:                  dw  FN_NOT_IMP
    2454   00:4D8F                      ; TCPIP_RAW_OPEN not going to be implemented, ESP do not support RAW connections
    2455   00:4D8F  D9 4D               FN_20:                  dw  FN_NOT_IMP
    2456   00:4D91                      ; TCPIP_RAW_CLOSE not going to be implemented, ESP do not support RAW connections
    2457   00:4D91  D9 4D               FN_21:                  dw  FN_NOT_IMP
    2458   00:4D93                      ; TCPIP_RAW_STATE not going to be implemented, ESP do not support RAW connections
    2459   00:4D93  D9 4D               FN_22:                  dw  FN_NOT_IMP
    2460   00:4D95                      ; TCPIP_RAW_SEND not going to be implemented, ESP do not support RAW connections
    2461   00:4D95  D9 4D               FN_23:                  dw  FN_NOT_IMP
    2462   00:4D97                      ; TCPIP_RAW_RCV not going to be implemented, ESP do not support RAW connections
    2463   00:4D97  D9 4D               FN_24:                  dw  FN_NOT_IMP
    2464   00:4D99  9E 5D               FN_25:                  dw  TCPIP_CONFIG_AUTOIP
    2465   00:4D9B  F5 5D               FN_26:                  dw  TCPIP_CONFIG_IP
    2466   00:4D9D  32 5E               FN_27:                  dw  TCPIP_CONFIG_TTL
    2467   00:4D9F  44 5E               FN_28:                  dw  TCPIP_CONFIG_PING
    2468   00:4DA1                      ; TCPIP_WAIT not needed for our implementation
    2469   00:4DA1  DC 4D               FN_29:                  dw  END_OK
    2470   00:4DA3                      
    2471   00:4DA3                      ;====================================
    2472   00:4DA3                      ;===  Functions entry point code  ===
    2473   00:4DA3                      ;===             SSH              ===
    2474   00:4DA3                      ;====================================
    2475   00:4DA3                      UNAPI2_ENTRY:
    2476   00:4DA3  FB                      ei
    2477   00:4DA4  E5                      push    hl
    2478   00:4DA5  F5                      push    af
    2479   00:4DA6  21 C1 4D                ld  hl,FN_TABLE_S
    2480   00:4DA9  CB 7F                   bit 7,a
    2481   00:4DAB  20 B7                   jr  nz,UNDEFINED
    2482   00:4DAD                      
    2483   00:4DAD  FE 0B                   cp  MAX_FN_S
    2484   00:4DAF  28 02                   jr  z,OK_FNUM_S
    2485   00:4DB1  30 B1                   jr  nc,UNDEFINED
    2486   00:4DB3                      
    2487   00:4DB3                      OK_FNUM_S:
    2488   00:4DB3  87                      add a,a
    2489   00:4DB4  D5                      push    de
    2490   00:4DB5  5F                      ld  e,a
    2491   00:4DB6  16 00                   ld  d,0
    2492   00:4DB8  19                      add hl,de
    2493   00:4DB9  D1                      pop de
    2494   00:4DBA                      
    2495   00:4DBA  7E                      ld  a,(hl)
    2496   00:4DBB  23                      inc hl
    2497   00:4DBC  66                      ld  h,(hl)
    2498   00:4DBD  6F                      ld  l,a
    2499   00:4DBE                      
    2500   00:4DBE  F1                      pop af
    2501   00:4DBF  E3                      ex  (sp),hl
    2502   00:4DC0  C9                      ret
    2503   00:4DC1                      
    2504   00:4DC1                      ;===================================
    2505   00:4DC1                      ;===  Functions addresses table  ===
    2506   00:4DC1                      ;===             SSH             ===
    2507   00:4DC1                      ;===================================
    2508   00:4DC1                      ;--- Implementation-specific routines addresses table
    2509   00:4DC1                      
    2510   00:4DC1                      FN_TABLE_S:
    2511   00:4DC1  F9 4D               FN_0_S:                 dw  UNAPI_GET_INFO_SSH
    2512   00:4DC3  04 4E               FN_1_S:                 dw  SSH_GET_CAPAB
    2513   00:4DC5  84 55               FN_2_S:                 dw  SSH_OPEN
    2514   00:4DC7  98 56               FN_3_S:                 dw  SSH_CLOSE
    2515   00:4DC9  E0 56               FN_4_S:                 dw  SSH_STATE
    2516   00:4DCB  09 5A               FN_5_S:                 dw  SSH_SEND
    2517   00:4DCD  D2 5B               FN_6_S:                 dw  SSH_RCV
    2518   00:4DCF  52 57               FN_7_S:                 dw  SSH_TERM_TYPE
    2519   00:4DD1  C0 57               FN_8_S:                 dw  SSH_WIN_SIZE
    2520   00:4DD3  99 5C               FN_9_S:                 dw  SSH_AUTH_GET_CHALLENGE
    2521   00:4DD5  5F 5A               FN_10_S:                dw  SSH_AUTH_RESPOND
    2522   00:4DD7  50 56               FN_11_S:                dw  SSH_ADD_KNOWN_HOST
    2523   00:4DD9                      
    2524   00:4DD9                      ;========================
    2525   00:4DD9                      ;===  Functions code  ===
    2526   00:4DD9                      ;========================
    2527   00:4DD9                      FN_NOT_IMP:
    2528   00:4DD9  3E 01                   ld  a,ERR_NOT_IMP
    2529   00:4DDB  C9                      ret
    2530   00:4DDC                      
    2531   00:4DDC                      END_OK:
    2532   00:4DDC  AF                      xor a
    2533   00:4DDD  C9                      ret
    2534   00:4DDE                      
    2535   00:4DDE                      ; Most functions do not have special handling on time out and can use this.
    2536   00:4DDE                      ; If there is a need to retry sending or receiving on time-out, then a custom
    2537   00:4DDE                      ; time-out function must be done, check the examples of UDP and TCP receive
    2538   00:4DDE                      TCPIP_GENERIC_CHECK_TIME_OUT:
    2539   00:4DDE                          ; Save registers other than AF
    2540   00:4DDE  C5                      push bc
    2541   00:4DDF  D5                      push de
    2542   00:4DE0  E5                      push hl
    2543   00:4DE1  CD E5 5E                call    GETCOUNTER
    2544   00:4DE4  7D                      ld  a,l
    2545   00:4DE5  B4                      or  h
    2546   00:4DE6                          ; Restore registers, we are returning
    2547   00:4DE6  E1                      pop hl
    2548   00:4DE7  D1                      pop de
    2549   00:4DE8  C1                      pop bc
    2550   00:4DE9  C0                      ret nz
    2551   00:4DEA                          ; Ok, timeout...
    2552   00:4DEA  F1                      pop af                          ; Get return address of who called this out of the stack
    2553   00:4DEB  3E 0F                   ld  a,ERR_INV_OPER
    2554   00:4DED  C9                      ret                             ; and return the function itself
    2555   00:4DEE                      
    2556   00:4DEE                      ;========================
    2557   00:4DEE                      ;===  UNAPI_GET_INFO  ===
    2558   00:4DEE                      ;========================
    2559   00:4DEE                      ; Obtain the implementation name and version for TCP/IP.
    2560   00:4DEE                      ;
    2561   00:4DEE                      ;    Input:  A  = 0
    2562   00:4DEE                      ;    Output: HL = Descriptive string for this implementation, on this slot, zero terminated
    2563   00:4DEE                      ;            DE = API version supported, D.E
    2564   00:4DEE                      ;            BC = This implementation version, B.C.
    2565   00:4DEE                      ;            A  = 0 and Cy = 0
    2566   00:4DEE                      UNAPI_GET_INFO:
    2567   00:4DEE  01 04 01                ld  bc,256*ROM_V_P+ROM_V_S
    2568   00:4DF1  11 02 01                ld  de,256*API_V_P+API_V_S
    2569   00:4DF4  21 6D 70                ld  hl,APIINFO
    2570   00:4DF7  AF                      xor a
    2571   00:4DF8  C9                      ret
    2572   00:4DF9                      
    2573   00:4DF9                      ;========================
    2574   00:4DF9                      ;===  UNAPI_GET_INFO  ===
    2575   00:4DF9                      ;========================
    2576   00:4DF9                      ; Obtain the implementation name and version for SSH.
    2577   00:4DF9                      ;
    2578   00:4DF9                      ;    Input:  A  = 0
    2579   00:4DF9                      ;    Output: HL = Descriptive string for this implementation, on this slot, zero terminated
    2580   00:4DF9                      ;            DE = API version supported, D.E
    2581   00:4DF9                      ;            BC = This implementation version, B.C.
    2582   00:4DF9                      ;            A  = 0 and Cy = 0
    2583   00:4DF9                      UNAPI_GET_INFO_SSH:
    2584   00:4DF9  01 04 01                ld  bc,256*ROM_V_P+ROM_V_S
    2585   00:4DFC  11 02 01                ld  de,256*API_V_P+API_V_S
    2586   00:4DFF  21 7E 70                ld  hl,APIINFO_SSH
    2587   00:4E02  AF                      xor a
    2588   00:4E03  C9                      ret
    2589   00:4E04                      
    2590   00:4E04                      ;=========================
    2591   00:4E04                      ;===   SSH_GET_CAPAB   ===
    2592   00:4E04                      ;=========================
    2593   00:4E04                      ; Get information about the SSH capabilities and features.
    2594   00:4E04                      ;
    2595   00:4E04                      ;    Input:  A = 1
    2596   00:4E04                      ;            B = Index of information block to retrieve:
    2597   00:4E04                      ;                1: Block 1 (only block supported, other blocks reserved for expansion)
    2598   00:4E04                      ;    Output: A = Error code
    2599   00:4E04                      ;        When information block 1 requested:
    2600   00:4E04                      ;            HL = Capabilities flags
    2601   00:4E04                      ;            B  = Maximum simultaneous SSH connections supported
    2602   00:4E04                      ;            C  = Free SSH connections currently available
    2603   00:4E04                      ;            DE = Maximum data per command
    2604   00:4E04                      SSH_GET_CAPAB:
    2605   00:4E04                          ; SSH functions start at 127 on ESP
    2606   00:4E04  CB FF                   set 7,a
    2607   00:4E06                          SEND_DATA                       ; Send the command
    2607   00:4E06  D3 07             >     out (OUT_TX_PORT),a
    2608   00:4E08  AF                      xor a
    2609   00:4E09                          SEND_DATA                       ; Send the command size msb
    2609   00:4E09  D3 07             >     out (OUT_TX_PORT),a
    2610   00:4E0B  3C                      inc a
    2611   00:4E0C                          SEND_DATA                       ; Send the command size lsb
    2611   00:4E0C  D3 07             >     out (OUT_TX_PORT),a
    2612   00:4E0E  78                      ld  a,b
    2613   00:4E0F                          SEND_DATA                       ; Send the parameter
    2613   00:4E0F  D3 07             >     out (OUT_TX_PORT),a
    2614   00:4E11                      
    2615   00:4E11                          ; Now wait up to 120 ticks to get response
    2616   00:4E11  21 78 00                ld  hl,120
    2617   00:4E14  CD F4 5E                call    SETCOUNTER
    2618   00:4E17                      SSH_GET_CAPAB_ST1:
    2619   00:4E17                          CHECK_DATA
    2619   00:4E17  DB 07             >     in  a,(IN_STS_PORT)
    2619   00:4E19  CB 47             >     bit 0,a
    2620   00:4E1B  20 05                   jr  nz,SSH_GET_CAPAB_ST1.1
    2621   00:4E1D  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2622   00:4E20  18 F5                   jr  SSH_GET_CAPAB_ST1
    2623   00:4E22                      SSH_GET_CAPAB_ST1.1:
    2624   00:4E22                          ; nz, check the data
    2625   00:4E22                          RECEIVE_DATA
    2625   00:4E22  DB 06             >     in a,(IN_DATA_PORT)
    2626   00:4E24  FE 81                   cp  #81                         ; Is response of our command?
    2627   00:4E26  20 EF                   jr  nz,SSH_GET_CAPAB_ST1
    2628   00:4E28                          ; Now get return code, if return code other than 0, it is finished
    2629   00:4E28                      SSH_GET_CAPAB_RC:
    2630   00:4E28                          CHECK_DATA
    2630   00:4E28  DB 07             >     in  a,(IN_STS_PORT)
    2630   00:4E2A  CB 47             >     bit 0,a
    2631   00:4E2C  20 05                   jr  nz,SSH_GET_CAPAB_RC.1
    2632   00:4E2E  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2633   00:4E31  18 F5                   jr  SSH_GET_CAPAB_RC
    2634   00:4E33                      SSH_GET_CAPAB_RC.1:
    2635   00:4E33                          ; nz, discard
    2636   00:4E33                          RECEIVE_DATA
    2636   00:4E33  DB 06             >     in a,(IN_DATA_PORT)
    2637   00:4E35  B7                      or  a                           ; 0?
    2638   00:4E36  C0                      ret nz                          ; If not, done
    2639   00:4E37                      
    2640   00:4E37                          ; Next two bytes are size bytes, don't care
    2641   00:4E37  06 02                   ld  b,2
    2642   00:4E39                      SSH_GET_CAPAB_ST2:
    2643   00:4E39                          CHECK_DATA
    2643   00:4E39  DB 07             >     in  a,(IN_STS_PORT)
    2643   00:4E3B  CB 47             >     bit 0,a
    2644   00:4E3D  20 05                   jr  nz,SSH_GET_CAPAB_ST2.1
    2645   00:4E3F  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2646   00:4E42  18 F5                   jr  SSH_GET_CAPAB_ST2
    2647   00:4E44                      SSH_GET_CAPAB_ST2.1:
    2648   00:4E44                          ; Nz, discard
    2649   00:4E44                          RECEIVE_DATA
    2649   00:4E44  DB 06             >     in a,(IN_DATA_PORT)
    2650   00:4E46  05                      dec b
    2651   00:4E47  20 F0                   jr  nz,SSH_GET_CAPAB_ST2
    2652   00:4E49                      
    2653   00:4E49                      SSH_GET_CAPAB_BLK1_ST1:
    2654   00:4E49                          CHECK_DATA
    2654   00:4E49  DB 07             >     in  a,(IN_STS_PORT)
    2654   00:4E4B  CB 47             >     bit 0,a
    2655   00:4E4D  20 05                   jr  nz,SSH_GET_CAPAB_BLK1_ST1.1
    2656   00:4E4F  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2657   00:4E52  18 F5                   jr  SSH_GET_CAPAB_BLK1_ST1
