    7400   00:633B                      ;*********************************************
    7401   00:633B                      ;***    ESP Specific Commands/Responses    ***
    7402   00:633B                      ;*********************************************
    7403   00:633B                      ; Cold reset of ESP firmware
    7404   00:633B  (00:0052)           CMD_RESET_ESP           equ 'R'
    7405   00:633B                      ; ESP32 only, Get Board, returns board identification string
    7406   00:633B  (00:0062)           CMD_GET_FW_TYPE         equ 'b'
    7407   00:633B                      ; Warm reset of ESP firmware
    7408   00:633B  (00:0057)           CMD_WRESET_ESP          equ 'W'
    7409   00:633B                      ; Hold Wi-Fi Connection On
    7410   00:633B  (00:0048)           CMD_WIFIHOLD_ESP        equ 'H'
    7411   00:633B                      ; Release Wi-Fi Connection Hold
