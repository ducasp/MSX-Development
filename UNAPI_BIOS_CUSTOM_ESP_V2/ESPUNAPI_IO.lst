    3522   00:523A  18 F5                   jr  TCPIP_UDP_STATE_RC
    3523   00:523C                      TCPIP_UDP_STATE_RC.1:
    3524   00:523C                          ; nz, discard
    3525   00:523C                          RECEIVE_DATA
    3525   00:523C  DB 06             >     in a,(IN_DATA_PORT)
    3526   00:523E  B7                      or  a                           ; 0?
    3527   00:523F  C0                      ret nz                          ; if not, done
    3528   00:5240                      
    3529   00:5240                          ; next two bytes are return code and size bytes, don't care, it is 5
    3530   00:5240  06 02                   ld  b,2
    3531   00:5242                      TCPIP_UDP_STATE_ST2:
    3532   00:5242                          CHECK_DATA
    3532   00:5242  DB 07             >     in  a,(IN_STS_PORT)
    3532   00:5244  CB 47             >     bit 0,a
    3533   00:5246  20 05                   jr  nz,TCPIP_UDP_STATE_ST2.1
    3534   00:5248  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3535   00:524B  18 F5                   jr  TCPIP_UDP_STATE_ST2
    3536   00:524D                      TCPIP_UDP_STATE_ST2.1:
    3537   00:524D                          ; nz, discard
    3538   00:524D                          RECEIVE_DATA
    3538   00:524D  DB 06             >     in a,(IN_DATA_PORT)
    3539   00:524F  05                      dec b
    3540   00:5250  20 F0                   jr  nz,TCPIP_UDP_STATE_ST2
    3541   00:5252                      
    3542   00:5252                          ; now just get the 5 bytes (Port LSB then MSB, # of packets, packet size LSB then MSB) and order it in L, H, B, E and D
    3543   00:5252                      TCPIP_UDP_STATE_RESP_ST1:
    3544   00:5252                          CHECK_DATA
    3544   00:5252  DB 07             >     in  a,(IN_STS_PORT)
    3544   00:5254  CB 47             >     bit 0,a
    3545   00:5256  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST1.1
    3546   00:5258  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3547   00:525B  18 F5                   jr  TCPIP_UDP_STATE_RESP_ST1
    3548   00:525D                      TCPIP_UDP_STATE_RESP_ST1.1:
    3549   00:525D                          ; nz, get it
    3550   00:525D                          RECEIVE_DATA
    3550   00:525D  DB 06             >     in a,(IN_DATA_PORT)
    3551   00:525F  6F                      ld  l,a
    3552   00:5260                      TCPIP_UDP_STATE_RESP_ST2:
    3553   00:5260                          CHECK_DATA
    3553   00:5260  DB 07             >     in  a,(IN_STS_PORT)
    3553   00:5262  CB 47             >     bit 0,a
    3554   00:5264  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST2.1
    3555   00:5266  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3556   00:5269  18 F5                   jr  TCPIP_UDP_STATE_RESP_ST2
    3557   00:526B                      TCPIP_UDP_STATE_RESP_ST2.1:
    3558   00:526B                          ; nz, get it
    3559   00:526B                          RECEIVE_DATA
    3559   00:526B  DB 06             >     in a,(IN_DATA_PORT)
    3560   00:526D  67                      ld  h,a
    3561   00:526E                      TCPIP_UDP_STATE_RESP_ST3:
    3562   00:526E                          CHECK_DATA
    3562   00:526E  DB 07             >     in  a,(IN_STS_PORT)
    3562   00:5270  CB 47             >     bit 0,a
    3563   00:5272  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST3.1
    3564   00:5274  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3565   00:5277  18 F5                   jr  TCPIP_UDP_STATE_RESP_ST3
    3566   00:5279                      TCPIP_UDP_STATE_RESP_ST3.1:
    3567   00:5279                          ; nz, get it
    3568   00:5279                          RECEIVE_DATA
    3568   00:5279  DB 06             >     in a,(IN_DATA_PORT)
    3569   00:527B  47                      ld  b,a
    3570   00:527C                      TCPIP_UDP_STATE_RESP_ST4:
    3571   00:527C                          CHECK_DATA
    3571   00:527C  DB 07             >     in  a,(IN_STS_PORT)
    3571   00:527E  CB 47             >     bit 0,a
    3572   00:5280  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST4.1
    3573   00:5282  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3574   00:5285  18 F5                   jr  TCPIP_UDP_STATE_RESP_ST4
    3575   00:5287                      TCPIP_UDP_STATE_RESP_ST4.1:
    3576   00:5287                          ; nz, get it
    3577   00:5287                          RECEIVE_DATA
    3577   00:5287  DB 06             >     in a,(IN_DATA_PORT)
    3578   00:5289  5F                      ld  e,a
    3579   00:528A                      TCPIP_UDP_STATE_RESP_ST5:
    3580   00:528A                          CHECK_DATA
    3580   00:528A  DB 07             >     in  a,(IN_STS_PORT)
    3580   00:528C  CB 47             >     bit 0,a
    3581   00:528E  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST5.1
    3582   00:5290  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3583   00:5293  18 F5                   jr  TCPIP_UDP_STATE_RESP_ST5
    3584   00:5295                      TCPIP_UDP_STATE_RESP_ST5.1:
    3585   00:5295                          ; nz, get it
    3586   00:5295                          RECEIVE_DATA
    3586   00:5295  DB 06             >     in a,(IN_DATA_PORT)
    3587   00:5297  57                      ld  d,a
    3588   00:5298                          ; done
    3589   00:5298  AF                      xor a
    3590   00:5299  C9                      ret
    3591   00:529A                      
    3592   00:529A                      ;========================
    3593   00:529A                      ;===  TCPIP_UDP_SEND  ===
    3594   00:529A                      ;========================
    3595   00:529A                      ;Send an UDP datagram.
    3596   00:529A                      ;
    3597   00:529A                      ;Input:  A = 11
    3598   00:529A                      ;        B = Connection number
    3599   00:529A                      ;        HL = Address of datagram data
    3600   00:529A                      ;        DE = Address of parameters block
    3601   00:529A                      ;Output: A = Error code
    3602   00:529A                      ;
    3603   00:529A                      ;Parameters block:
    3604   00:529A                      ;
    3605   00:529A                      ;    +0 (4): Destination IP address
    3606   00:529A                      ;    +4 (2): Destination port
    3607   00:529A                      ;    +6 (2): Data length
    3608   00:529A                      TCPIP_UDP_SEND:
    3609   00:529A  E5                      push    hl
    3610   00:529B  D5                      push    de
    3611   00:529C                          SEND_DATA                       ; Send the command
    3611   00:529C  D3 07             >     out (OUT_TX_PORT),a
    3612   00:529E                          ; prepare new data size, adding our 7 bytes overhead
    3613   00:529E  DD 62                   ld  ixh,d
    3614   00:52A0  DD 6B                   ld  ixl,e
    3615   00:52A2  11 07 00                ld  de,7
    3616   00:52A5  DD 6E 06                ld  l,(ix+6)
    3617   00:52A8  DD 66 07                ld  h,(ix+7)
    3618   00:52AB  19                      add hl,de
    3619   00:52AC  7C                      ld  a,h
    3620   00:52AD                          SEND_DATA                       ; Send the command size msb
    3620   00:52AD  D3 07             >     out (OUT_TX_PORT),a
    3621   00:52AF  7D                      ld  a,l
    3622   00:52B0                          SEND_DATA                       ; Send the command size lsb
    3622   00:52B0  D3 07             >     out (OUT_TX_PORT),a
    3623   00:52B2  78                      ld  a,b
    3624   00:52B3                          SEND_DATA                       ; Send the connection #
    3624   00:52B3  D3 07             >     out (OUT_TX_PORT),a
    3625   00:52B5  D1                      pop de
    3626   00:52B6  E1                      pop hl
    3627   00:52B7  1A                      ld  a,(de)
    3628   00:52B8                          SEND_DATA                       ; Send IP byte 1
    3628   00:52B8  D3 07             >     out (OUT_TX_PORT),a
    3629   00:52BA  13                      inc de
    3630   00:52BB  1A                      ld  a,(de)
    3631   00:52BC                          SEND_DATA                       ; Send IP byte 2
    3631   00:52BC  D3 07             >     out (OUT_TX_PORT),a
    3632   00:52BE  13                      inc de
    3633   00:52BF  1A                      ld  a,(de)
    3634   00:52C0                          SEND_DATA                       ; Send IP byte 3
    3634   00:52C0  D3 07             >     out (OUT_TX_PORT),a
    3635   00:52C2  13                      inc de
    3636   00:52C3  1A                      ld  a,(de)
    3637   00:52C4                          SEND_DATA                       ; Send IP byte 4
    3637   00:52C4  D3 07             >     out (OUT_TX_PORT),a
    3638   00:52C6  13                      inc de
    3639   00:52C7  1A                      ld  a,(de)
    3640   00:52C8                          SEND_DATA                       ; Send Port LSB
    3640   00:52C8  D3 07             >     out (OUT_TX_PORT),a
    3641   00:52CA  13                      inc de
    3642   00:52CB  1A                      ld  a,(de)
    3643   00:52CC                          SEND_DATA                       ; Send Port MSB
    3643   00:52CC  D3 07             >     out (OUT_TX_PORT),a
    3644   00:52CE                          ; now oti the data starting at hl, size is in next DE position
    3645   00:52CE  13                      inc de
    3646   00:52CF  1A                      ld  a,(de)
    3647   00:52D0  47                      ld  b,a                         ; save lsb in b
    3648   00:52D1  13                      inc de
    3649   00:52D2  1A                      ld  a,(de)                      ; msb
    3650   00:52D3  57                      ld  d,a                         ; put in D, there is no ld d,(de)
    3651   00:52D4  58                      ld  e,b                         ; lsb
    3652   00:52D5                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    3653   00:52D5                          ;ld b,e                         ; Number of loops originaly in DE, not needed, b already has e
    3654   00:52D5  1B                      dec de
    3655   00:52D6  14                      inc d
    3656   00:52D7                          if USE_MEM_IO = 0
    3657   00:52D7  0E 07                   ld  c,OUT_TX_PORT
    3658   00:52D9                      TCPIP_UDP_SEND_R:
    3659   00:52D9  ED B3                   otir                            ; Send until B is 0
    3660   00:52DB                          else
    3661   00:52DB                    ~ TCPIP_UDP_SEND_R:
    3662   00:52DB                    ~     ld  a,(hl)
    3663   00:52DB                    ~     ld  (MEM_OUT_TX_PORT),a
    3664   00:52DB                    ~     inc hl
    3665   00:52DB                    ~     djnz TCPIP_UDP_SEND_R
    3666   00:52DB                    ~     endif
    3667   00:52DB  15                      dec d                           ; decrement secondary counter
    3668   00:52DC  20 FB                   jr  nz,TCPIP_UDP_SEND_R         ; If still have another round, do it
    3669   00:52DE                          ; Now wait up to 600 ticks to get response
    3670   00:52DE  21 58 02                ld  hl,600
    3671   00:52E1  CD EC 5E                call    SETCOUNTER
    3672   00:52E4                      TCPIP_UDP_SEND_ST1:
    3673   00:52E4                          CHECK_DATA
    3673   00:52E4  DB 07             >     in  a,(IN_STS_PORT)
    3673   00:52E6  CB 47             >     bit 0,a
    3674   00:52E8  20 05                   jr  nz,TCPIP_UDP_SEND_ST1.1
    3675   00:52EA  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3676   00:52ED  18 F5                   jr  TCPIP_UDP_SEND_ST1
    3677   00:52EF                      TCPIP_UDP_SEND_ST1.1:
    3678   00:52EF                          ; nz, check the data
    3679   00:52EF                          RECEIVE_DATA
    3679   00:52EF  DB 06             >     in a,(IN_DATA_PORT)
    3680   00:52F1  FE 0B                   cp  11                          ; Is response of our command?
    3681   00:52F3  20 EF                   jr  nz,TCPIP_UDP_SEND_ST1
    3682   00:52F5                          ; now get return code, if return code other than 0, it is finished
    3683   00:52F5                      TCPIP_UDP_SEND_RC:
    3684   00:52F5                          CHECK_DATA
    3684   00:52F5  DB 07             >     in  a,(IN_STS_PORT)
    3684   00:52F7  CB 47             >     bit 0,a
    3685   00:52F9  20 05                   jr  nz,TCPIP_UDP_SEND_RC.1
    3686   00:52FB  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3687   00:52FE  18 F5                   jr  TCPIP_UDP_SEND_RC
    3688   00:5300                      TCPIP_UDP_SEND_RC.1:
    3689   00:5300                          ; nz, discard
    3690   00:5300                          RECEIVE_DATA
    3690   00:5300  DB 06             >     in a,(IN_DATA_PORT)
    3691   00:5302  B7                      or  a                           ; 0?
    3692   00:5303  C0                      ret nz                          ; if not, done
    3693   00:5304                      
    3694   00:5304                          ; next two bytes are return code and size bytes, don't care, it is 0
    3695   00:5304  06 02                   ld  b,2
    3696   00:5306                      TCPIP_UDP_SEND_ST2:
    3697   00:5306                          CHECK_DATA
    3697   00:5306  DB 07             >     in  a,(IN_STS_PORT)
    3697   00:5308  CB 47             >     bit 0,a
    3698   00:530A  20 05                   jr  nz,TCPIP_UDP_SEND_ST2.1
    3699   00:530C  CD D6 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3700   00:530F  18 F5                   jr  TCPIP_UDP_SEND_ST2
    3701   00:5311                      TCPIP_UDP_SEND_ST2.1:
    3702   00:5311                          ; nz, discard
    3703   00:5311                          RECEIVE_DATA
    3703   00:5311  DB 06             >     in a,(IN_DATA_PORT)
    3704   00:5313  05                      dec b
    3705   00:5314  20 F0                   jr  nz,TCPIP_UDP_SEND_ST2
    3706   00:5316                      
    3707   00:5316                          ; done, no return data other than return code
    3708   00:5316  AF                      xor a
    3709   00:5317  C9                      ret
    3710   00:5318                      
    3711   00:5318                      ;=======================
    3712   00:5318                      ;===  TCPIP_UDP_RCV  ===
    3713   00:5318                      ;=======================
    3714   00:5318                      ;Retrieve an incoming UDP datagram.
    3715   00:5318                      ;
    3716   00:5318                      ;Input:  A = 12
    3717   00:5318                      ;        B = Connection number
    3718   00:5318                      ;        HL = Address for datagram data
    3719   00:5318                      ;        DE = Maximum data size to retrieve
    3720   00:5318                      ;Output: A = Error code
    3721   00:5318                      ;        L.H.E.D = Source IP address
    3722   00:5318                      ;        IX = Source port
    3723   00:5318                      ;        BC = Actual received data size
    3724   00:5318                      
    3725   00:5318                      ; Customized TIME OUT routine: If time out receiving data, retry as received data
    3726   00:5318                      ; won't be re-sent as host is unaware of this
    3727   00:5318                      TCPIP_UDP_RCV_CHECK_TIME_OUT:
    3728   00:5318                          ; Save registers other than AF
    3729   00:5318  C5                      push bc
    3730   00:5319  D5                      push de
    3731   00:531A  E5                      push hl
    3732   00:531B  CD DD 5E                call    GETCOUNTER
    3733   00:531E  7D                      ld  a,l
    3734   00:531F  B4                      or  h
    3735   00:5320                          ; Restore registers, we are returning
    3736   00:5320  E1                      pop hl
    3737   00:5321  D1                      pop de
    3738   00:5322  C1                      pop bc
    3739   00:5323  C0                      ret nz
    3740   00:5324                          ; Ok, timeout...
    3741   00:5324  F1                      pop af                          ; Get return address of who called this out of the stack, we will return from the function or re-start
    3742   00:5325                      TCPIP_TCP_UDP_RETRY_QRCV:
    3743   00:5325  CD FC 5E                call    GETBYTE
    3744   00:5328  B7                      or  a
    3745   00:5329  28 0B                   jr  z,TCPIP_UDP_RCV_CHECK_TIME_OUT.NORXRETRY
    3746   00:532B                          ; Ok, so let's ask ESP to re-send the data and retry receiving it
    3747   00:532B  3D                      dec a
    3748   00:532C  CD 0E 5F                call    SETBYTE                 ; we are retrying it
    3749   00:532F  3E 72                   ld  a,'r'                       ; retry transmission command
    3750   00:5331                          SEND_DATA
    3750   00:5331  D3 07             >     out (OUT_TX_PORT),a
    3751   00:5333  C3 55 53                jp  TCPIP_UDP_RCV.RXRETRY       ; and retry it
    3752   00:5336                      TCPIP_UDP_RCV_CHECK_TIME_OUT.NORXRETRY:
    3753   00:5336  3E 0F                   ld  a,ERR_INV_OPER
    3754   00:5338  C9                      ret                             ; and return the function itself
    3755   00:5339                      
    3756   00:5339                      TCPIP_UDP_RCV:
    3757   00:5339  CD 35 5F                call    SETWORD                 ; Save for later the datagram address
    3758   00:533C  3E 0C                   ld  a,12
    3759   00:533E                          SEND_DATA                       ; Send the command
    3759   00:533E  D3 07             >     out (OUT_TX_PORT),a
    3760   00:5340  AF                      xor a
    3761   00:5341                          SEND_DATA                       ; Send the command size msb
    3761   00:5341  D3 07             >     out (OUT_TX_PORT),a
    3762   00:5343  3E 03                   ld  a,3
    3763   00:5345                          SEND_DATA                       ; Send the command size lsb
    3763   00:5345  D3 07             >     out (OUT_TX_PORT),a
    3764   00:5347  78                      ld  a,b
    3765   00:5348                          SEND_DATA                       ; Send the connection #
    3765   00:5348  D3 07             >     out (OUT_TX_PORT),a
    3766   00:534A  7B                      ld  a,e
    3767   00:534B                          SEND_DATA                       ; Send MAX rcv size LSB
    3767   00:534B  D3 07             >     out (OUT_TX_PORT),a
    3768   00:534D  7A                      ld  a,d
    3769   00:534E                          SEND_DATA                       ; Send MAX rcv size MSB
    3769   00:534E  D3 07             >     out (OUT_TX_PORT),a
    3770   00:5350  3E 03                   ld  a,3
    3771   00:5352  CD 0E 5F                call    SETBYTE                 ; Ok, retry up to three times
    3772   00:5355                      TCPIP_UDP_RCV.RXRETRY:
    3773   00:5355                          ; Now wait up to 600 ticks to get response
    3774   00:5355  21 58 02                ld  hl,600
    3775   00:5358  CD EC 5E                call    SETCOUNTER
    3776   00:535B                      TCPIP_UDP_RCV_ST1:
    3777   00:535B                          CHECK_DATA
    3777   00:535B  DB 07             >     in  a,(IN_STS_PORT)
    3777   00:535D  CB 47             >     bit 0,a
    3778   00:535F  20 05                   jr  nz,TCPIP_UDP_RCV_ST1.1
    3779   00:5361  CD 18 53                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3780   00:5364  18 F5                   jr  TCPIP_UDP_RCV_ST1
    3781   00:5366                      TCPIP_UDP_RCV_ST1.1:
    3782   00:5366                          ; nz, check the data
    3783   00:5366                          RECEIVE_DATA
    3783   00:5366  DB 06             >     in a,(IN_DATA_PORT)
    3784   00:5368  FE 0C                   cp  12                          ; Is response of our command?
    3785   00:536A  20 EF                   jr  nz,TCPIP_UDP_RCV_ST1
    3786   00:536C                          ; At this point, all data is being buffered, so 30 ticks, half second, is more than enough time-out
    3787   00:536C  F3                      di
    3788   00:536D  21 1E 00                ld  hl,30
    3789   00:5370  CD EC 5E                call    SETCOUNTER
    3790   00:5373  FB                      ei
    3791   00:5374                          ; now get return code, if return code other than 0, it is finished
    3792   00:5374                      TCPIP_UDP_RCV_RC:
    3793   00:5374                          CHECK_DATA
    3793   00:5374  DB 07             >     in  a,(IN_STS_PORT)
    3793   00:5376  CB 47             >     bit 0,a
    3794   00:5378  20 05                   jr  nz,TCPIP_UDP_RCV_RC.1
    3795   00:537A  CD 18 53                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3796   00:537D  18 F5                   jr  TCPIP_UDP_RCV_RC
    3797   00:537F                      TCPIP_UDP_RCV_RC.1:
    3798   00:537F                          ; nz, discard
    3799   00:537F                          RECEIVE_DATA
    3799   00:537F  DB 06             >     in a,(IN_DATA_PORT)
    3800   00:5381  B7                      or  a                           ; 0?
    3801   00:5382  C0                      ret nz                          ; if not, done
    3802   00:5383                          ; next two bytes are return code and size bytes, save it to BC
    3803   00:5383                      TCPIP_UDP_RCV_ST2A:
    3804   00:5383                          CHECK_DATA
    3804   00:5383  DB 07             >     in  a,(IN_STS_PORT)
    3804   00:5385  CB 47             >     bit 0,a
    3805   00:5387  20 05                   jr  nz,TCPIP_UDP_RCV_ST2A.1
    3806   00:5389  CD 18 53                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3807   00:538C  18 F5                   jr  TCPIP_UDP_RCV_ST2A
    3808   00:538E                      TCPIP_UDP_RCV_ST2A.1:
    3809   00:538E                          ; nz, discard
    3810   00:538E                          RECEIVE_DATA
    3810   00:538E  DB 06             >     in a,(IN_DATA_PORT)
    3811   00:5390  67                      ld  h,a
    3812   00:5391                      TCPIP_UDP_RCV_ST2B:
    3813   00:5391                          CHECK_DATA
    3813   00:5391  DB 07             >     in  a,(IN_STS_PORT)
    3813   00:5393  CB 47             >     bit 0,a
    3814   00:5395  20 05                   jr  nz,TCPIP_UDP_RCV_ST2B.1
    3815   00:5397  CD 18 53                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3816   00:539A  18 F5                   jr  TCPIP_UDP_RCV_ST2B
    3817   00:539C                      TCPIP_UDP_RCV_ST2B.1:
    3818   00:539C                          ; nz, discard
    3819   00:539C                          RECEIVE_DATA
    3819   00:539C  DB 06             >     in a,(IN_DATA_PORT)
    3820   00:539E  6F                      ld  l,a
    3821   00:539F  01 06 00                ld  bc,6
    3822   00:53A2                          ; subtract 6 (IP and PORT)
    3823   00:53A2  AF                      xor a                           ; zero carry
    3824   00:53A3  ED 42                   sbc hl,bc
    3825   00:53A5  4D                      ld  c,l
    3826   00:53A6  44                      ld  b,h                         ; BC has effective received data size
    3827   00:53A7                          ; now just get the 4 bytes IP and place it in L H E D
    3828   00:53A7                      TCPIP_UDP_RCV_IP_ST1:
    3829   00:53A7                          CHECK_DATA
    3829   00:53A7  DB 07             >     in  a,(IN_STS_PORT)
    3829   00:53A9  CB 47             >     bit 0,a
