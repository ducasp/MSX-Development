    1735   00:49D4  18 02                   jr  WAIT_AND_THEN_MAINMENU
    1736   00:49D6                      WAIT_2S_AND_THEN_MAINMENU:
    1737   00:49D6  3E 78                   ld  a,120                       ; Wait 2 seconds with message on screen
    1738   00:49D8                      WAIT_AND_THEN_MAINMENU:
    1739   00:49D8  CD E0 49                call    WAIT_BEFORE_CONTINUING
    1740   00:49DB  C3 46 42                jp  ESPSETUP                    ; When done, back to main setup
    1741   00:49DE                      WAIT_250MS_AND_THEN_CONTINUE:
    1742   00:49DE  3E 0F                   ld  a,15                        ; Wait 250 ms then continue
    1743   00:49E0                      WAIT_BEFORE_CONTINUING:
    1744   00:49E0  76                      halt
