    1638   00:48F8  FE 1B                   cp  #1b                         ; ESC?
    1639   00:48FA  CA 4F 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1640   00:48FD  FE 4F                   cp  'O'                         ; Toggle Nagle On
    1641   00:48FF  CA B0 49                jp  z,SET_NAGLE_ON              ;
    1642   00:4902  FE 6F                   cp  'o'                         ; Toggle Nagle On
    1643   00:4904  CA B0 49                jp  z,SET_NAGLE_ON              ;
    1644   00:4907  CD C0 00                call    BEEP                    ; Wrong Input, beep
    1645   00:490A  C3 F5 48                jp  SET_NAGLE_WI_ON             ; And return waiting key
    1646   00:490D                      
