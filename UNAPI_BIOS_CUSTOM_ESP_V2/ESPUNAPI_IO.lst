    5593   00:5BD9                      TCPIP_TCP_SEND_RC.1:
    5594   00:5BD9                          ; nz, discard
    5595   00:5BD9                          RECEIVE_DATA
    5595   00:5BD9  DB 06             >     in a,(IN_DATA_PORT)
    5596   00:5BDB  B7                      or  a                           ; 0?
    5597   00:5BDC  C0                      ret nz                          ; if not, done
    5598   00:5BDD                      
    5599   00:5BDD                          ; next two bytes are return code and size bytes, don't care, it is 0
    5600   00:5BDD  06 02                   ld  b,2
    5601   00:5BDF                      TCPIP_TCP_SEND_ST2:
    5602   00:5BDF                          CHECK_DATA
    5602   00:5BDF  DB 07             >     in  a,(IN_STS_PORT)
    5602   00:5BE1  CB 47             >     bit 0,a
    5603   00:5BE3  20 05                   jr  nz,TCPIP_TCP_SEND_ST2.1
