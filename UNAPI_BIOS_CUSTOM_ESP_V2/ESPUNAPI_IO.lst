    2231   00:4C95                      ;===============================
    2232   00:4C95                      ;===  HTIM_I hook execution  ===
    2233   00:4C95                      ;===============================
    2234   00:4C95                      DO_HTIMI:
    2235   00:4C95  F5                      push    af                      ; HTIM hook -> need to keep A value
    2236   00:4C96  CD E5 5E                call    GETCOUNTER              ; Counter in hl
    2237   00:4C99  7D                      ld  a,l
    2238   00:4C9A  B4                      or  h                           ; In this operation, check if HL is 0
    2239   00:4C9B  28 04                   jr  z,DO_HTIMI_END              ; If it is, nothing to do
    2240   00:4C9D  2B                      dec hl                          ; Otherwise decrement it
    2241   00:4C9E  CD F4 5E                call    SETCOUNTER              ; And save it
    2242   00:4CA1                      DO_HTIMI_END:
    2243   00:4CA1  CD 54 5E                call    GETSLT
    2244   00:4CA4                          ; Slot in A, now get the address of our counter
    2245   00:4CA4  CD DD 5E                call    GETMEMPOINTER
    2246   00:4CA7                          ; HL has the address of our memory area, and there is where we should jump
    2247   00:4CA7  F1                      pop af                          ; Restore original A value
    2248   00:4CA8  E9                      jp  (hl)
    2249   00:4CA9                      
    2250   00:4CA9                      ;===============================
    2251   00:4CA9                      ;===  EXTBIO hook execution  ===
    2252   00:4CA9                      ;===============================
