    2010   00:4B65  20 F5                   jr  nz,WAIT_MENU_CMD_RESPONSE_RC
    2011   00:4B67  C3 B8 4B                jp  WAIT_MENU_CMD_RESPONSE_END  ; If time out waiting, return
