    3046   00:5045  18 F5                   jr  TCPIP_GET_IPINFO_IP_ST4
    3047   00:5047                      TCPIP_GET_IPINFO_IP_ST4.1:
    3048   00:5047                          ; nz, get it
    3049   00:5047                          RECEIVE_DATA
    3049   00:5047  DB 06             >     in a,(IN_DATA_PORT)
    3050   00:5049  57                      ld  d,a
    3051   00:504A                          ; done
    3052   00:504A  AF                      xor a
    3053   00:504B  C9                      ret
    3054   00:504C                      
    3055   00:504C                      ;=========================
    3056   00:504C                      ;===  TCPIP_NET_STATE  ===
    3057   00:504C                      ;=========================
    3058   00:504C                      ;Get network state.
    3059   00:504C                      ;
    3060   00:504C                      ;Input:  A = 3
    3061   00:504C                      ;Output: A = Error code
    3062   00:504C                      ;        B = Current network state:
    3063   00:504C                      ;            0: Closed
    3064   00:504C                      ;            1: Opening
    3065   00:504C                      ;            2: Open
    3066   00:504C                      ;            3: Closing
    3067   00:504C                      ;            255: Unknown
    3068   00:504C                      TCPIP_NET_STATE:
    3069   00:504C                          SEND_DATA                       ; Send the command
    3069   00:504C  D3 07             >     out (OUT_TX_PORT),a
    3070   00:504E  AF                      xor a
    3071   00:504F                          SEND_DATA                       ; Send the command size msb
    3071   00:504F  D3 07             >     out (OUT_TX_PORT),a
    3072   00:5051                          SEND_DATA                       ; Send the command size lsb
    3072   00:5051  D3 07             >     out (OUT_TX_PORT),a
    3073   00:5053                      
    3074   00:5053                          ; Now wait up to 720 ticks to get response
    3075   00:5053  21 D0 02                ld  hl,720
    3076   00:5056  CD F4 5E                call    SETCOUNTER
    3077   00:5059                      TCPIP_NET_STATE_ST1:
    3078   00:5059                          CHECK_DATA
    3078   00:5059  DB 07             >     in  a,(IN_STS_PORT)
    3078   00:505B  CB 47             >     bit 0,a
    3079   00:505D  20 05                   jr  nz,TCPIP_NET_STATE_ST1.1
    3080   00:505F  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3081   00:5062  18 F5                   jr  TCPIP_NET_STATE_ST1
    3082   00:5064                      TCPIP_NET_STATE_ST1.1:
    3083   00:5064                          ; nz, check the data
    3084   00:5064                          RECEIVE_DATA
    3084   00:5064  DB 06             >     in a,(IN_DATA_PORT)
    3085   00:5066  FE 03                   cp  3                           ; Is response of our command?
    3086   00:5068  20 EF                   jr  nz,TCPIP_NET_STATE_ST1
    3087   00:506A                          ; now get return code, if return code other than 0, it is finished
    3088   00:506A                      TCPIP_NET_STATE_RC:
    3089   00:506A                          CHECK_DATA
    3089   00:506A  DB 07             >     in  a,(IN_STS_PORT)
    3089   00:506C  CB 47             >     bit 0,a
    3090   00:506E  20 05                   jr  nz,TCPIP_NET_STATE_RC.1
    3091   00:5070  CD DE 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3092   00:5073  18 F5                   jr  TCPIP_NET_STATE_RC
    3093   00:5075                      TCPIP_NET_STATE_RC.1:
    3094   00:5075                          ; nz, get it
    3095   00:5075                          RECEIVE_DATA
    3095   00:5075  DB 06             >     in a,(IN_DATA_PORT)
    3096   00:5077  B7                      or  a                           ; 0?
    3097   00:5078  C0                      ret nz                          ; if not, done
    3098   00:5079                      
    3099   00:5079                          ; next two bytes are return code and size bytes, don't care, it is 1
    3100   00:5079  06 02                   ld  b,2
    3101   00:507B                      TCPIP_NET_STATE_ST2:
    3102   00:507B                          CHECK_DATA
    3102   00:507B  DB 07             >     in  a,(IN_STS_PORT)
    3102   00:507D  CB 47             >     bit 0,a
    3103   00:507F  20 05                   jr  nz,TCPIP_NET_STATE_ST2.1
