    2921   00:4FA3                      ;===  TCPIP_GET_IPINFO  ===
    2922   00:4FA3                      ;==========================
    2923   00:4FA3                      ;Get IP address.
    2924   00:4FA3                      ;
    2925   00:4FA3                      ;Input:  A = 2
