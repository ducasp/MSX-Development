    3869   00:53EB  20 05                   jr  nz,TCPIP_UDP_RCV_PORT_ST1.1
    3870   00:53ED  CD 20 53                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3871   00:53F0  18 F5                   jr  TCPIP_UDP_RCV_PORT_ST1
    3872   00:53F2                      TCPIP_UDP_RCV_PORT_ST1.1:
