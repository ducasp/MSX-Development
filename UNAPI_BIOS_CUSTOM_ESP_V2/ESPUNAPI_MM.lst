    1340   00:471C  7B                      ld  a,e
    1341   00:471D  B7                      or  a
    1342   00:471E                      WIFI_CONNECT_AP_SRCH.1:
    1343   00:471E  CA 2C 47                jp  z,WIFI_CONNECT_AP_PWDQ
    1344   00:4721  7E                      ld  a,(hl)
    1345   00:4722  23                      inc hl
    1346   00:4723  B7                      or  a
    1347   00:4724  C2 1E 47                jp  nz,WIFI_CONNECT_AP_SRCH.1   ; Find string terminator
    1348   00:4727                          ; Found, jump encryption byte
    1349   00:4727  23                      inc hl
    1350   00:4728  1D                      dec e                           ; Decrement selection, if 0 we are done
    1351   00:4729  C2 1E 47                jp  nz,WIFI_CONNECT_AP_SRCH.1
    1352   00:472C                      WIFI_CONNECT_AP_PWDQ:
    1353   00:472C                          ; HL has the address of AP name string
    1354   00:472C  54                      ld  d,h
    1355   00:472D  5D                      ld  e,l                         ; Save copy in D
    1356   00:472E  01 00 00                ld  bc,0                        ; BC will have the ap connection data length
    1357   00:4731                      WIFI_CONNECT_APSIZE:
    1358   00:4731  03                      inc bc
    1359   00:4732  1A                      ld  a,(de)
    1360   00:4733  13                      inc de
    1361   00:4734  B7                      or  a
    1362   00:4735  C2 31 47                jp  nz,WIFI_CONNECT_APSIZE      ; Count size, including zero terminator
    1363   00:4738                          ; Check for encryption
    1364   00:4738  1A                      ld  a,(de)
    1365   00:4739  B7                      or  a
    1366   00:473A  CA CB 47                jp  z,WIFI_CONNECT_SENDCMD      ; If no password requested, good to go
    1367   00:473D                          ; Shoot, need to request password, well, let's do it
    1368   00:473D  E5                      push    hl                      ; Save HL
    1369   00:473E  21 3D 6C                ld  hl,MMENU_ASKPWD
    1370   00:4741  CD A5 4C                call    PRINTHL                 ; Inform that user need to input PWD
    1371   00:4744  E1                      pop hl                          ; Restore HL
    1372   00:4745  FD 21 00 00             ld  iy,0                        ; IY will help in backspacing
    1373   00:4749  DD 26 01                ld  ixh,1                       ; Start hidden
    1374   00:474C                      WIFI_CONNECT_RCV_PWD:
    1375   00:474C  CD 9F 00                call    CHGET
    1376   00:474F  FE 1B                   cp  #1b                         ; ESC?
    1377   00:4751  CA 66 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1378   00:4754  FE 08                   cp  #08                         ; Backspace?
    1379   00:4756  CA A7 47                jp  z,WIFI_CONNECT_RCV_PWD_BS   ; Check if there is something to erase
    1380   00:4759  FE 0D                   cp  #0d                         ; ENTER?
    1381   00:475B  CA C4 47                jp  z,WIFI_PWD_CHECK_INPUT      ; Check if ok
    1382   00:475E  FE 7F                   cp  #7f                         ; Delete?
    1383   00:4760  CA 93 47                jp  z,WIFI_CONNECT_RCV_PWDH     ; Change password from clear to hidden or vice versa
    1384   00:4763                      WIFI_CONNECT_RCV_PWD_STR:
    1385   00:4763                          ; Ok, so it is a digit and store
    1386   00:4763  12                      ld  (de),a
    1387   00:4764  FD 7D                   ld  a,iyl
    1388   00:4766  D6 3F                   sub 63                          ; 63 chars password limit (WPA2 encryption)
    1389   00:4768  28 E2                   jr  z,WIFI_CONNECT_RCV_PWD
    1390   00:476A  1A                      ld  a,(de)
    1391   00:476B  03                      inc bc
    1392   00:476C  13                      inc de
    1393   00:476D  FD 23                   inc iy                          ; Increment counters and pointer
    1394   00:476F  F5                      push    af                      ; Save A
    1395   00:4770  DD 7C                   ld  a,ixh
    1396   00:4772  B7                      or  a                           ; If zero, print char, otherwise print *
    1397   00:4773  28 09                   jr  z,WIFI_CONNECT_RCV_PWD_CHAR
    1398   00:4775  F1                      pop af
    1399   00:4776  3E 2A                   ld  a,'*'                       ; Print * and keep password hidden
    1400   00:4778  CD A2 00                call    CHPUT
    1401   00:477B  C3 4C 47                jp  WIFI_CONNECT_RCV_PWD        ; And back to receiving digits
    1402   00:477E                      WIFI_CONNECT_RCV_PWD_CHAR:
    1403   00:477E  F1                      pop af
    1404   00:477F  FE 20                   cp  32
    1405   00:4781  30 04                   jr  nc,WIFI_CONNECT_RCV_CHKPRT2 ; Ok, not below space, but is it delete?
    1406   00:4783  3E 3F                   ld  a,'?'                       ; Prints a question mark
    1407   00:4785  18 06                   jr  WIFI_CONNECT_RCV_CHKPRTD
    1408   00:4787                      WIFI_CONNECT_RCV_CHKPRT2:
    1409   00:4787  FE 7F                   cp  #7f
    1410   00:4789  20 02                   jr  nz,WIFI_CONNECT_RCV_CHKPRTD
    1411   00:478B  3E 3F                   ld  a,'?'                       ; Prints a question mark if it is delete
    1412   00:478D                      WIFI_CONNECT_RCV_CHKPRTD:
    1413   00:478D  CD A2 00                call    CHPUT                   ; Print a char
    1414   00:4790  C3 4C 47                jp  WIFI_CONNECT_RCV_PWD        ; And back to receiving digits
    1415   00:4793                      
    1416   00:4793                      WIFI_CONNECT_RCV_PWDH:
    1417   00:4793  FD 7D                   ld  a,iyl
    1418   00:4795  FD B4                   or  iyh
    1419   00:4797  C2 63 47                jp  nz,WIFI_CONNECT_RCV_PWD_STR ; If digits entered, can't change password behavior, so it is a pass phrase char
    1420   00:479A  AF                      xor a
    1421   00:479B  DD B4                   or  ixh
    1422   00:479D  DD 26 01                ld  ixh,1
    1423   00:47A0  28 AA                   jr  z,WIFI_CONNECT_RCV_PWD      ; Return if it was 0
    1424   00:47A2  DD 26 00                ld  ixh,0
    1425   00:47A5  28 A5                   jr  z,WIFI_CONNECT_RCV_PWD      ; Otherwise set to 0 and return
    1426   00:47A7                      
    1427   00:47A7                      WIFI_CONNECT_RCV_PWD_BS:
    1428   00:47A7  FD 7D                   ld  a,iyl
    1429   00:47A9  FD B4                   or  iyh
    1430   00:47AB  CA 4C 47                jp  z,WIFI_CONNECT_RCV_PWD      ; If no digits entered, nothing to erase
    1431   00:47AE  FD 2B                   dec iy                          ; Decrement counter
    1432   00:47B0  0B                      dec bc                          ; Decrement counter
    1433   00:47B1  1B                      dec de                          ; Decrement pointer
    1434   00:47B2  3E 08                   ld  a,8                         ; Backspace
    1435   00:47B4  CD A2 00                call    CHPUT                   ; Print it
    1436   00:47B7  3E 20                   ld  a,' '                       ; Space
    1437   00:47B9  CD A2 00                call    CHPUT                   ; Print it
    1438   00:47BC  3E 08                   ld  a,8                         ; Backspace
    1439   00:47BE  CD A2 00                call    CHPUT                   ; Print it
    1440   00:47C1  C3 4C 47                jp  WIFI_CONNECT_RCV_PWD        ; Return
    1441   00:47C4                      
    1442   00:47C4                      WIFI_PWD_CHECK_INPUT:
    1443   00:47C4  FD 7D                   ld  a,iyl
    1444   00:47C6  FD B4                   or  iyh
    1445   00:47C8  CA 4C 47                jp  z,WIFI_CONNECT_RCV_PWD      ; If no digits entered, no password to send
    1446   00:47CB                          ; Otherwise done and ready to send
    1447   00:47CB                      WIFI_CONNECT_SENDCMD:
    1448   00:47CB  CD 1E 4A                call    WAIT_250MS_AND_THEN_CONTINUE
    1449   00:47CE  E5                      push    hl
    1450   00:47CF  21 F9 6B                ld  HL,MMENU_CONNECTING
    1451   00:47D2  CD A5 4C                call    PRINTHL
    1452   00:47D5  E1                      pop hl
    1453   00:47D6                          ; Print AP name
    1454   00:47D6  E5                      push    hl
    1455   00:47D7  CD AF 4C                call    PRINTHLINE              ; Print AP Name
    1456   00:47DA  E1                      pop hl
    1457   00:47DB                          ; HL has the address of our data, BC the data size, so it is just needed to send the command
    1458   00:47DB                          CLEAR_UART
    1458   00:47DB  3E 14             >     ld  a,20
    1458   00:47DD  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    1459   00:47E0  3E 41                   ld  a,CMD_WIFI_CONNECT
    1460   00:47E2                          SEND_DATA
    1460   00:47E2  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1461   00:47E5  78                      ld  a,b                         ; Size MSB is in B
    1462   00:47E6                          SEND_DATA
    1462   00:47E6  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1463   00:47E9  79                      ld  a,c                         ; Size LSB is in c
    1464   00:47EA                          SEND_DATA
    1464   00:47EA  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1465   00:47ED                      WIFI_CONNECT_SENDCMDLP:
    1466   00:47ED  7E                      ld  a,(hl)
    1467   00:47EE                          SEND_DATA
    1467   00:47EE  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1468   00:47F1  23                      inc hl
    1469   00:47F2  0B                      dec bc
    1470   00:47F3  78                      ld  a,b
    1471   00:47F4  B1                      or  c
    1472   00:47F5  C2 ED 47                jp  nz,WIFI_CONNECT_SENDCMDLP
    1473   00:47F8  21 58 02                ld  hl,600                      ; Wait Up To 10s
    1474   00:47FB  3E 41                   ld  a,CMD_WIFI_CONNECT          ; Our command
    1475   00:47FD  CD 40 4B                call    WAIT_MENU_QCMD_RESPONSE
    1476   00:4800  CA 0C 48                jp  z,WIFI_CONNECT_FAIL
    1477   00:4803  21 9E 70                ld  hl,STR_SENDING_OK_JN        ; Success
    1478   00:4806  CD A5 4C                call    PRINTHL
    1479   00:4809  C3 16 4A                jp  WAIT_2S_AND_THEN_MAINMENU
    1480   00:480C                      WIFI_CONNECT_FAIL:
    1481   00:480C  21 C0 70                ld  hl,STR_SENDING_NOK_JN       ; Failure
    1482   00:480F  CD A5 4C                call    PRINTHL
    1483   00:4812  C3 12 4A                jp  WAIT_4S_AND_THEN_MAINMENU
    1484   00:4815                      
    1485   00:4815                      INPUT_WFSAP_BAD_INPUT:
    1486   00:4815  C5                      push    bc
    1487   00:4816  D5                      push    de
    1488   00:4817  F5                      push    af
    1489   00:4818  E5                      push    hl
    1490   00:4819  DD E5                   push    ix
    1491   00:481B  FD E5                   push    iy
    1492   00:481D  CD C0 00                call    BEEP                    ; Wrong Input, beep
    1493   00:4820  FD E1                   pop iy
    1494   00:4822  DD E1                   pop ix
    1495   00:4824  E1                      pop hl
    1496   00:4825  F1                      pop af
    1497   00:4826  D1                      pop de
    1498   00:4827  C1                      pop bc
    1499   00:4828  C3 53 46                jp WIFI_SELECT_AP               ; Return
    1500   00:482B                      
    1501   00:482B                      WIFI_SCAN_NONETWORKS:
    1502   00:482B  21 AC 6B                ld  hl,MMENU_SCANN
    1503   00:482E  CD A5 4C                call    PRINTHL
    1504   00:4831  C3 12 4A                jp  WAIT_4S_AND_THEN_MAINMENU
    1505   00:4834                      
    1506   00:4834                      WIFI_SCAN_TIMEOUT:
    1507   00:4834  21 8C 6B                ld  hl,MMENU_SCANF
    1508   00:4837  CD A5 4C                call    PRINTHL
    1509   00:483A  C3 12 4A                jp  WAIT_4S_AND_THEN_MAINMENU
    1510   00:483D                      
    1511   00:483D                      SET_WIFI_TIMEOUT:
    1512   00:483D  3E 32                   ld  a,'2'
    1513   00:483F  CD A2 00                call    CHPUT
    1514   00:4842  CD 1E 4A                call    WAIT_250MS_AND_THEN_CONTINUE
    1515   00:4845  21 6F 6D                ld  hl,MMENU_TIMEOUT
    1516   00:4848  CD A5 4C                call    PRINTHL                 ; Print Main Timeout message
    1517   00:484B  CD 8F 4A                call    CHECKTIMEOUT            ; TimeOut is on or off?
    1518   00:484E  CA 66 48                jp  z,WIFI_SET_ALWAYS_ON        ; If 0, always on
    1519   00:4851                          ; Otherwise there is a timeout
    1520   00:4851  E5                      push    hl
    1521   00:4852  21 A6 6E                ld hl,MMENU_TIMEOUT_NOTALWAYSON1
    1522   00:4855  CD A5 4C                call    PRINTHL
    1523   00:4858  E1                      pop hl
    1524   00:4859  CD A5 4C                call    PRINTHL
    1525   00:485C  21 BC 6E                ld hl,MMENU_TIMEOUT_NOTALWAYSON2
    1526   00:485F  CD A5 4C                call    PRINTHL
    1527   00:4862  16 00                   ld  d,0                         ; Count digits
    1528   00:4864  18 10                   jr  INPUT_TIMEOUT
    1529   00:4866                      WIFI_SET_ALWAYS_ON:
    1530   00:4866  21 51 6E                ld  hl,MMENU_TIMEOUT_ALWAYSON
    1531   00:4869  CD A5 4C                call    PRINTHL
    1532   00:486C  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1533   00:4870  DD 6B                   ld  ixl,e
    1534   00:4872  DD 62                   ld  ixh,d                       ; Address in IX
    1535   00:4874  16 00                   ld  d,0                         ; Count digits
    1536   00:4876                      INPUT_TIMEOUT:
    1537   00:4876  CD 9F 00                call    CHGET
    1538   00:4879  FE 1B                   cp  #1b                         ; ESC?
    1539   00:487B  CA 66 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1540   00:487E  FE 0D                   cp  #0d                         ; ENTER?
    1541   00:4880  CA C4 48                jp  z,SET_WIFI_CHECK_INPUT      ; Check if ok
    1542   00:4883  FE 08                   cp  #08                         ; Backspace?
    1543   00:4885  CA AA 48                jp  z,SET_WIFI_BS_INPUT         ; Check if there is something to erase
    1544   00:4888  FE 30                   cp  '0'                         ; Check if A is less than 0
    1545   00:488A  DA A4 48                jp  c,INPUT_TIMEOUT_BAD_INPUT   ; if it is, ignore
    1546   00:488D  FE 3A                   cp  '9'+1                       ; Check if a is greater than  9
    1547   00:488F  D2 A4 48                jp  nc,INPUT_TIMEOUT_BAD_INPUT  ; If it is, ignore
    1548   00:4892  DD 77 00                ld  (ix+0),a                    ; Save it
    1549   00:4895  CD A2 00                call    CHPUT                   ; It is valid, so print it
    1550   00:4898  14                      inc d                           ; Increment digit count
    1551   00:4899  DD 23                   inc ix                          ; Increment pointer
    1552   00:489B  3E 03                   ld  a,3
    1553   00:489D  BA                      cp  d
    1554   00:489E  CA C4 48                jp  z,SET_WIFI_CHECK_INPUT      ; All we can do is accept up to 3 digits, check if ok
    1555   00:48A1  C3 76 48                jp  INPUT_TIMEOUT               ; Not done yet, so continue
    1556   00:48A4                      
    1557   00:48A4                      INPUT_TIMEOUT_BAD_INPUT:
    1558   00:48A4  CD C0 00                call    BEEP                    ; Wrong Input, beep
    1559   00:48A7  C3 76 48                jp INPUT_TIMEOUT                ; Return
    1560   00:48AA                      
    1561   00:48AA                      SET_WIFI_BS_INPUT:
    1562   00:48AA  AF                      xor a
    1563   00:48AB  B2                      or  d                           ; Counter has any digit?
    1564   00:48AC  CA 76 48                jp  z,INPUT_TIMEOUT             ; Nope, so just continue
    1565   00:48AF  15                      dec d                           ; Decrement counter
    1566   00:48B0  DD 2B                   dec ix                          ; Decrement pointer
    1567   00:48B2  3E 08                   ld  a,8                         ; Backspace
    1568   00:48B4  CD A2 00                call    CHPUT                   ; Print it
    1569   00:48B7  3E 20                   ld  a,' '                       ; Space
    1570   00:48B9  CD A2 00                call    CHPUT                   ; Print it
    1571   00:48BC  3E 08                   ld  a,8                         ; Backspace
    1572   00:48BE  CD A2 00                call    CHPUT                   ; Print it
    1573   00:48C1  C3 76 48                jp  INPUT_TIMEOUT               ; Return
    1574   00:48C4                      
    1575   00:48C4                      SET_WIFI_CHECK_INPUT:
    1576   00:48C4  AF                      xor a
    1577   00:48C5  B2                      or  d                           ; Counter has any digits
    1578   00:48C6  CA 76 48                jp  z,INPUT_TIMEOUT             ; Nope, so just continue
    1579   00:48C9                          ; IX is pointing one position after last digit, so revert
    1580   00:48C9  DD 2B                   dec ix
    1581   00:48CB  DD 7E 00                ld  a,(ix+0)                    ; Digit in A
    1582   00:48CE  D6 30                   sub '0'                         ; Convert it to decimal
    1583   00:48D0  26 00                   ld  h,0                         ; First digit, so H is 0
    1584   00:48D2  6F                      ld  l,a                         ; And L has the digit
    1585   00:48D3  15                      dec d                           ; If digits finished, just set
    1586   00:48D4  CA 00 49                jp  z,SET_WIFI_EXECUTE_SET_COMMAND
    1587   00:48D7  DD 2B                   dec ix
    1588   00:48D9  DD 7E 00                ld  a,(ix+0)                    ; Digit in A
    1589   00:48DC  D6 30                   sub '0'                         ; Convert it to decimal
    1590   00:48DE  87                      add a,a                         ; A*2
    1591   00:48DF  4F                      ld  c,a                         ; A*2 in C
    1592   00:48E0  87                      add a,a                         ; A*4
    1593   00:48E1  87                      add a,a                         ; A*8
    1594   00:48E2  81                      add a,c                         ; A*10
    1595   00:48E3                          ; Up to here, we can get 90 + 9, 99, won't go to H anyway, just add to L
    1596   00:48E3  85                      add a,l                         ; L has the first digit
    1597   00:48E4  6F                      ld  l,a                         ; And now L has the two digits
    1598   00:48E5  15                      dec d                           ; If digits finished, just set
    1599   00:48E6  CA 00 49                jp  z,SET_WIFI_EXECUTE_SET_COMMAND
    1600   00:48E9  DD 2B                   dec ix
    1601   00:48EB  DD 7E 00                ld  a,(ix+0)                    ; Digit in A
    1602   00:48EE  D6 30                   sub '0'                         ; Convert it to decimal
    1603   00:48F0  87                      add a,a                         ; A*2
    1604   00:48F1  4F                      ld  c,a                         ; A*2 in C
    1605   00:48F2  87                      add a,a                         ; A*4
    1606   00:48F3  87                      add a,a                         ; A*8
    1607   00:48F4  81                      add a,c                         ; A*10
    1608   00:48F5  EB                      ex  de,hl                       ; Get the two digits results in de
    1609   00:48F6  6F                      ld  l,a
    1610   00:48F7  26 00                   ld  h,0                         ; HL = A*10
    1611   00:48F9  29                      add hl,hl                       ; HL = A*20
    1612   00:48FA  4D                      ld  c,l
    1613   00:48FB  44                      ld  b,h                         ; BC = A*20
    1614   00:48FC  29                      add hl,hl                       ; HL = A*40
    1615   00:48FD  29                      add hl,hl                       ; HL = A*80
    1616   00:48FE  09                      add hl,bc                       ; HL = A*100
    1617   00:48FF  19                      add hl,de                       ; HL = three digits result
    1618   00:4900                          ; This was the last digit, up to three
    1619   00:4900                      SET_WIFI_EXECUTE_SET_COMMAND:
    1620   00:4900  C3 52 49                jp  SET_ESP_WIFI_TIMEOUT        ; And set and done
    1621   00:4903                      
