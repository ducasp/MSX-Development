    5616   00:5DB5                      ;=======================
    5617   00:5DB5                      ;===     SSH_RCV     ===
    5618   00:5DB5                      ;=======================
    5619   00:5DB5                      ;Receive data from a SSH connection.
    5620   00:5DB5                      ;
    5621   00:5DB5                      ;Input:   A  = 6
    5622   00:5DB5                      ;         B  = Connection number
    5623   00:5DB5                      ;         DE = Address for the retrieved data
    5624   00:5DB5                      ;         HL = Length of the data to be obtained
    5625   00:5DB5                      ;Output:  A  = Error code
    5626   00:5DB5                      ;         BC = Total number of bytes that have been actually retrieved
    5627   00:5DB5                      ; Save registers other than AF
    5628   00:5DB5                      SSH_RCV_RETRY_QRCV:
    5629   00:5DB5  CD 4E 61                call    GETBYTE
    5630   00:5DB8  B7                      or  a
    5631   00:5DB9  28 0C                   jr  z,SSH_RCV_CHECK_TIME_OUT.NORXRETRY
    5632   00:5DBB                          ; Ok, so let's ask ESP to re-send the data and retry receiving it
    5633   00:5DBB  3D                      dec a
    5634   00:5DBC  CD 60 61                call    SETBYTE                 ; we are retrying it
    5635   00:5DBF  3E 72                   ld  a,'r'                       ; retry transmission command
    5636   00:5DC1                          SEND_DATA
    5636   00:5DC1  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5637   00:5DC4  C3 EE 5D                jp  SSH_RCV.RXRETRY             ; and retry it
    5638   00:5DC7                      SSH_RCV_CHECK_TIME_OUT.NORXRETRY:
    5639   00:5DC7  3E 0F                   ld  a,ERR_INV_OPER
    5640   00:5DC9  C9                      ret                             ; and return the function itself
    5641   00:5DCA                      
