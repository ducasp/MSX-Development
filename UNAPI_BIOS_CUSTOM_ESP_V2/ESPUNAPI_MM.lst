    2908   00:5018                      TCPIP_GET_CAPAB_BLK1_ST1.1:
    2909   00:5018                          ; nz, get it
    2910   00:5018                          RECEIVE_DATA
    2910   00:5018  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2911   00:501B  6F                      ld  l,a
    2912   00:501C                      TCPIP_GET_CAPAB_BLK1_ST2:
    2913   00:501C                          CHECK_DATA
    2913   00:501C  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2913   00:501F  CB 47             >     bit 0,a
    2914   00:5021  20 05                   jr  nz,TCPIP_GET_CAPAB_BLK1_ST2.1
    2915   00:5023  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2916   00:5026  18 F4                   jr  TCPIP_GET_CAPAB_BLK1_ST2
    2917   00:5028                      TCPIP_GET_CAPAB_BLK1_ST2.1:
    2918   00:5028                          ; nz, get it
    2919   00:5028                          RECEIVE_DATA
    2919   00:5028  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2920   00:502B  67                      ld  h,a
    2921   00:502C                      TCPIP_GET_CAPAB_BLK1_ST3:
    2922   00:502C                          CHECK_DATA
    2922   00:502C  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2922   00:502F  CB 47             >     bit 0,a
    2923   00:5031  20 05                   jr  nz,TCPIP_GET_CAPAB_BLK1_ST3.1
    2924   00:5033  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2925   00:5036  18 F4                   jr  TCPIP_GET_CAPAB_BLK1_ST3
    2926   00:5038                      TCPIP_GET_CAPAB_BLK1_ST3.1:
    2927   00:5038                          ; nz, get it
    2928   00:5038                          RECEIVE_DATA
    2928   00:5038  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2929   00:503B  5F                      ld  e,a
    2930   00:503C                      TCPIP_GET_CAPAB_BLK1_ST4:
