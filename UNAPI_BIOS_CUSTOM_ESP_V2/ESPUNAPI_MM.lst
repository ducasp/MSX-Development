    6173   00:60B8                      ;=== SSH_AUTH_GET_CHALLENGE ===
    6174   00:60B8                      ;==============================
    6175   00:60B8                      ;Receive keyboard interactive challenge data from a SSH connection.
    6176   00:60B8                      ;
    6177   00:60B8                      ;Input:   A  = 9
    6178   00:60B8                      ;         B  = Connection number
    6179   00:60B8                      ;         DE = Address for the retrieved data
    6180   00:60B8                      ;         HL = Max Length of the data to be obtained
    6181   00:60B8                      ;Output:  A  = Error code
    6182   00:60B8                      ;         BC = Total number of bytes that have been actually retrieved
    6183   00:60B8                      ;         H  = Number of prompts
    6184   00:60B8                      ;         L  = Echo flag bitmap
    6185   00:60B8                      ; Save registers other than AF
    6186   00:60B8                      SSH_AUTH_GET_CHALLENGE_RETRY_QRCV:
    6187   00:60B8  CD 71 63                call    GETBYTE
    6188   00:60BB  B7                      or  a
    6189   00:60BC  28 0C                   jr  z,SSH_AUTH_GET_CHALLENGE_CHECK_TIME_OUT.NORXRETRY
    6190   00:60BE                          ; Ok, so let's ask ESP to re-send the data and retry receiving it
    6191   00:60BE  3D                      dec a
    6192   00:60BF  CD 83 63                call    SETBYTE                 ; we are retrying it
    6193   00:60C2  3E 72                   ld  a,'r'                       ; retry transmission command
    6194   00:60C4                          SEND_DATA
    6194   00:60C4  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6195   00:60C7  C3 F1 60                jp  SSH_AUTH_GET_CHALLENGE.RXRETRY             ; and retry it
    6196   00:60CA                      SSH_AUTH_GET_CHALLENGE_CHECK_TIME_OUT.NORXRETRY:
    6197   00:60CA  3E 0F                   ld  a,ERR_INV_OPER
    6198   00:60CC  C9                      ret                             ; and return the function itself
    6199   00:60CD                      
    6200   00:60CD                      SSH_AUTH_GET_CHALLENGE:
    6201   00:60CD  EB                      ex  de,hl
    6202   00:60CE  CD AA 63                call    SETWORD
    6203   00:60D1  EB                      ex  de,hl
    6204   00:60D2  3E 89                   ld  a,#89
    6205   00:60D4                          SEND_DATA                       ; Send the command
    6205   00:60D4  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6206   00:60D7  AF                      xor a
    6207   00:60D8                          SEND_DATA                       ; Send the command size msb
    6207   00:60D8  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6208   00:60DB  3E 03                   ld  a,3
    6209   00:60DD                          SEND_DATA                       ; Send the command size lsb
    6209   00:60DD  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6210   00:60E0  78                      ld  a,b
    6211   00:60E1                          SEND_DATA                       ; Send the connection #
    6211   00:60E1  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6212   00:60E4  7D                      ld  a,l
    6213   00:60E5                          SEND_DATA                       ; Send MAX rcv size LSB
    6213   00:60E5  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6214   00:60E8  7C                      ld  a,h
    6215   00:60E9                          SEND_DATA                       ; Send MAX rcv size MSB
    6215   00:60E9  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6216   00:60EC  3E 03                   ld  a,3
    6217   00:60EE  CD 83 63                call    SETBYTE                 ; Ok, retry up to three times
    6218   00:60F1                      SSH_AUTH_GET_CHALLENGE.RXRETRY:
    6219   00:60F1                          ; Now wait up to 600 ticks to get response
    6220   00:60F1  21 58 02                ld  hl,600
    6221   00:60F4  CD 61 63                call    SETCOUNTER
    6222   00:60F7                      SSH_AUTH_GET_CHALLENGE_ST1:
    6223   00:60F7                          CHECK_DATA
    6223   00:60F7  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6223   00:60FA  CB 47             >     bit 0,a
    6224   00:60FC  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_ST1.1
    6225   00:60FE  CD AF 5E                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    6226   00:6101  18 F4                   jr  SSH_AUTH_GET_CHALLENGE_ST1
    6227   00:6103                      SSH_AUTH_GET_CHALLENGE_ST1.1:
    6228   00:6103                          ; nz, check the data
    6229   00:6103                          RECEIVE_DATA
    6229   00:6103  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6230   00:6106  FE 89                   cp #89                          ; Is response of our command?
    6231   00:6108  20 ED                   jr  nz,SSH_AUTH_GET_CHALLENGE_ST1
    6232   00:610A                          ; At this point, all data is being buffered, so 15 ticks, quarter second, is more than enough time-out
    6233   00:610A  F3                      di
    6234   00:610B  21 1E 00                ld  hl,30
    6235   00:610E  CD 61 63                call    SETCOUNTER
    6236   00:6111  FB                      ei
    6237   00:6112                          ; now get return code, if return code other than 0, it is finished
    6238   00:6112                      SSH_AUTH_GET_CHALLENGE_RC:
    6239   00:6112                          CHECK_DATA
    6239   00:6112  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6239   00:6115  CB 47             >     bit 0,a
    6240   00:6117  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_RC.1
    6241   00:6119  CD AF 5E                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    6242   00:611C  18 F4                   jr  SSH_AUTH_GET_CHALLENGE_RC
    6243   00:611E                      SSH_AUTH_GET_CHALLENGE_RC.1:
    6244   00:611E                          ; nz, discard
    6245   00:611E                          RECEIVE_DATA
    6245   00:611E  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6246   00:6121  CD 83 63                call    SETBYTE                 ; Save return just in case
    6247   00:6124  B7                      or  a                           ; 0?
    6248   00:6125  28 0D                   jr  z,SSH_AUTH_GET_CHALLENGE_ST2A              ; if not, done
    6249   00:6127  D6 0D                   sub 13                          ; 13? ERR BUFF will return the desired buffer size
    6250   00:6129  28 09                   jr  z,SSH_AUTH_GET_CHALLENGE_ST2A;
    6251   00:612B  C6 0D                   add 13                          ; restore error code
    6252   00:612D  01 00 00                ld  bc,0                        ; no data received
    6253   00:6130  21 00 00                ld  hl,0
    6254   00:6133  C9                      ret
    6255   00:6134                          ; next two bytes are response size bytes save it to BC
    6256   00:6134                      SSH_AUTH_GET_CHALLENGE_ST2A:
    6257   00:6134                          CHECK_DATA
    6257   00:6134  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6257   00:6137  CB 47             >     bit 0,a
    6258   00:6139  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_ST2A.1
    6259   00:613B  CD AF 5E                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    6260   00:613E  18 F4                   jr  SSH_AUTH_GET_CHALLENGE_ST2A
    6261   00:6140                      SSH_AUTH_GET_CHALLENGE_ST2A.1:
    6262   00:6140                          ; nz, high byte count of bytes to receive
    6263   00:6140                          RECEIVE_DATA
    6263   00:6140  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6264   00:6143  67                      ld h,a
    6265   00:6144                      SSH_AUTH_GET_CHALLENGE_ST2B:
    6266   00:6144                          CHECK_DATA
    6266   00:6144  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6266   00:6147  CB 47             >     bit 0,a
    6267   00:6149  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_ST2B.1
    6268   00:614B  CD AF 5E                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    6269   00:614E  18 F4                   jr  SSH_AUTH_GET_CHALLENGE_ST2B
    6270   00:6150                      SSH_AUTH_GET_CHALLENGE_ST2B.1:
    6271   00:6150                          ; nz, low byte count of bytes to receive
    6272   00:6150                          RECEIVE_DATA
    6272   00:6150  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6273   00:6153  6F                      ld  l,a
    6274   00:6154  CD 71 63                call    GETBYTE                 ; if return was err buff...
    6275   00:6157  D6 0D                   sub 13
    6276   00:6159  20 23                   jr  nz,SSH_AUTH_GET_CHALLENGE_ST2BB.1
    6277   00:615B                          ; If here we need to have A as 13, B and C with needed buffer size
    6278   00:615B                      SSH_AUTH_GET_CHALLENGE_BUFERRA:
    6279   00:615B                          CHECK_DATA
    6279   00:615B  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6279   00:615E  CB 47             >     bit 0,a
    6280   00:6160  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_BUFERRA.1
    6281   00:6162  CD AF 5E                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    6282   00:6165  18 F4                   jr  SSH_AUTH_GET_CHALLENGE_BUFERRA
    6283   00:6167                      SSH_AUTH_GET_CHALLENGE_BUFERRA.1:
    6284   00:6167                          ; nz, low byte count of bytes to receive
    6285   00:6167                          RECEIVE_DATA
    6285   00:6167  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6286   00:616A  4F                      ld c,a
    6287   00:616B                      SSH_AUTH_GET_CHALLENGE_BUFERRB:
    6288   00:616B                          CHECK_DATA
    6288   00:616B  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6288   00:616E  CB 47             >     bit 0,a
    6289   00:6170  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_BUFERRB.1
    6290   00:6172  CD AF 5E                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    6291   00:6175  18 F4                   jr  SSH_AUTH_GET_CHALLENGE_BUFERRB
    6292   00:6177                      SSH_AUTH_GET_CHALLENGE_BUFERRB.1:
    6293   00:6177                          ; nz, high byte count of bytes to receive
    6294   00:6177                          RECEIVE_DATA
    6294   00:6177  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6295   00:617A  47                      ld  b,a
    6296   00:617B  3E 0D                   ld  a,13                        ; ERR BUFF
    6297   00:617D  C9                      ret
    6298   00:617E                          ; If here, should be ok and will get the data
    6299   00:617E                      SSH_AUTH_GET_CHALLENGE_ST2BB.1:
    6300   00:617E  7D                      ld  a,l
    6301   00:617F  B4                      or  h
    6302   00:6180                          ; if it was 0, no data
    6303   00:6180  CA E7 5E                jp  z,TCPIP_TCP_RCV_RET_NODATA  ; not a typo, no need to make the same code again
    6304   00:6183                          ; Ok, we need to get the flags that will go to HL, we get it in BC and then push to the stack
    6305   00:6183                      SSH_AUTH_GET_CHALLENGE_FLAGSA:
    6306   00:6183                          CHECK_DATA
    6306   00:6183  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6306   00:6186  CB 47             >     bit 0,a
    6307   00:6188  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_FLAGSA.1
    6308   00:618A  CD AF 5E                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    6309   00:618D  18 F4                   jr  SSH_AUTH_GET_CHALLENGE_FLAGSA
    6310   00:618F                      SSH_AUTH_GET_CHALLENGE_FLAGSA.1:
    6311   00:618F                          ; nz, prompts, B to later go to H
    6312   00:618F                          RECEIVE_DATA
    6312   00:618F  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6313   00:6192  47                      ld b,a
    6314   00:6193                      SSH_AUTH_GET_CHALLENGE_FLAGSB:
    6315   00:6193                          CHECK_DATA
    6315   00:6193  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6315   00:6196  CB 47             >     bit 0,a
    6316   00:6198  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_FLAGSB.1
    6317   00:619A  CD AF 5E                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    6318   00:619D  18 F4                   jr  SSH_AUTH_GET_CHALLENGE_FLAGSB
    6319   00:619F                      SSH_AUTH_GET_CHALLENGE_FLAGSB.1:
    6320   00:619F                          ; nz, prompts, C to later go to L
    6321   00:619F                          RECEIVE_DATA
    6321   00:619F  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6322   00:61A2  4F                      ld c,a
    6323   00:61A3  C5                      push    bc                      ; stack has the flags
    6324   00:61A4                          ; Now let's decrease HL as we've read 2 bytes
    6325   00:61A4  2B                      dec hl
    6326   00:61A5  2B                      dec hl
    6327   00:61A6                          ; And loop for the whole remaining response
    6328   00:61A6  4D                      ld  c,l
    6329   00:61A7  44                      ld  b,h                         ; BC has effective received data size, as well as HL
    6330   00:61A8                          ; put effective data size in de
    6331   00:61A8  EB                      ex  de,hl
    6332   00:61A9                          ; will start moving at address in stack (we've pushed the adress in WORD)
    6333   00:61A9  CD 97 63                call    GETWORD
    6334   00:61AC  CD 0A 64                call    BCBACKUP                ; save count (BC)
    6335   00:61AF                      
    6336   00:61AF                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use ini :-D
    6337   00:61AF  43                      ld  b,e                         ; Number of loops originaly in DE
    6338   00:61B0  1B                      dec de
    6339   00:61B1  14                      inc d
    6340   00:61B2                          if USE_MEM_IO = 0
    6341   00:61B2                    ~     ld  c,IN_DATA_PORT
    6342   00:61B2                    ~     CHECK_QUICK_RECEIVE
    6343   00:61B2                    ~     jr  z,SSH_AUTH_GET_CHALLENGE_R_NSF             ; If not, go to the old, slower route
    6344   00:61B2                    ~     ; Otherwise, let's speed it up baby!
    6345   00:61B2                    ~ SSH_AUTH_GET_CHALLENGE_R:
    6346   00:61B2                    ~     inir
    6347   00:61B2                    ~     else
    6348   00:61B2                          CHECK_QUICK_RECEIVE
    6348   00:61B2  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6348   00:61B5  CB 5F             >     bit 3,a
    6349   00:61B7  28 1A                   jr  z,SSH_AUTH_GET_CHALLENGE_R_NSF       ; If not, go to the old, slower route
    6350   00:61B9                          ; Otherwise, let's speed it up baby!
    6351   00:61B9                      SSH_AUTH_GET_CHALLENGE_R:
    6352   00:61B9  3A 06 7F                ld  a,(MEM_IN_DATA_PORT)
    6353   00:61BC  77                      ld  (hl),a
    6354   00:61BD  23                      inc hl
    6355   00:61BE  10 F9                   djnz SSH_AUTH_GET_CHALLENGE_R
    6356   00:61C0                          endif
    6357   00:61C0  15                      dec d
    6358   00:61C1  20 F6                   jr nz,SSH_AUTH_GET_CHALLENGE_R
    6359   00:61C3                          CHECK_BUFFER_UNDERRUN
    6359   00:61C3  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6359   00:61C6  CB 67             >     bit 4,a
    6360   00:61C8  C2 B8 60                jp  nz,SSH_AUTH_GET_CHALLENGE_RETRY_QRCV ; If yes, retry
    6361   00:61CB                          ; Otherwise, done
    6362   00:61CB  CD F8 63                call    BCRESTORE               ; done, restore return data in BC
    6363   00:61CE  03                      inc bc
    6364   00:61CF  03                      inc bc
    6365   00:61D0                          ; get flags back from stack
    6366   00:61D0  E1                      pop hl
    6367   00:61D1  AF                      xor a
    6368   00:61D2  C9                      ret
    6369   00:61D3                      SSH_AUTH_GET_CHALLENGE_R_NSF:
    6370   00:61D3                          CHECK_DATA
    6370   00:61D3  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6370   00:61D6  CB 47             >     bit 0,a
    6371   00:61D8  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_R_NSF.1
    6372   00:61DA  CD AF 5E                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    6373   00:61DD  18 F4                   jr  SSH_AUTH_GET_CHALLENGE_R_NSF
    6374   00:61DF                      SSH_AUTH_GET_CHALLENGE_R_NSF.1:
    6375   00:61DF                          if USE_MEM_IO = 0
    6376   00:61DF                    ~     ini
    6377   00:61DF                    ~     else
    6378   00:61DF  3A 06 7F                ld  a,(MEM_IN_DATA_PORT)
    6379   00:61E2  77                      ld  (hl),a
    6380   00:61E3  23                      inc hl
    6381   00:61E4  05                      dec b
    6382   00:61E5                          endif
    6383   00:61E5  20 EC                   jr  nz,SSH_AUTH_GET_CHALLENGE_R_NSF
    6384   00:61E7  15                      dec d
    6385   00:61E8  20 E9                   jr nz,SSH_AUTH_GET_CHALLENGE_R_NSF
    6386   00:61EA  CD F8 63                call    BCRESTORE               ; done, restore return data in BC
    6387   00:61ED  03                      inc bc
    6388   00:61EE  03                      inc bc
    6389   00:61EF                          ; get flags back from stack
    6390   00:61EF  E1                      pop hl
    6391   00:61F0  AF                      xor a
    6392   00:61F1  C9                      ret
    6393   00:61F2                      
    6394   00:61F2                      ;=============================
    6395   00:61F2                      ;===  TCPIP_CONFIG_AUTOIP  ===
    6396   00:61F2                      ;=============================
    6397   00:61F2                      ;Enable or disable the automatic IP addresses retrieval.
    6398   00:61F2                      ;
    6399   00:61F2                      ;Input:  A = 25
    6400   00:61F2                      ;        B = 0: Get current configuration
    6401   00:61F2                      ;            1: Set configuration
    6402   00:61F2                      ;        C = Configuration to set (only if B=1):
    6403   00:61F2                      ;            bit 0: Set to automatically retrieve
    6404   00:61F2                      ;                   local IP address, subnet mask and default gateway
    6405   00:61F2                      ;            bit 1: Set to automatically retrieve DNS servers addresses
    6406   00:61F2                      ;            bits 2-7: Unused, must be zero
    6407   00:61F2                      ;Output: A = Error code
    6408   00:61F2                      ;        C = Configuration after the routine execution
    6409   00:61F2                      ;            (same format as C at input)
    6410   00:61F2                      TCPIP_CONFIG_AUTOIP:
    6411   00:61F2                          SEND_DATA                       ; Send the command
    6411   00:61F2  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6412   00:61F5  AF                      xor a
    6413   00:61F6                          SEND_DATA                       ; Send the command size msb
    6413   00:61F6  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6414   00:61F9  3E 02                   ld  a,2
    6415   00:61FB                          SEND_DATA                       ; Send the command size lsb
    6415   00:61FB  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6416   00:61FE  78                      ld  a,b
    6417   00:61FF                          SEND_DATA                       ; Send the command
    6417   00:61FF  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6418   00:6202  79                      ld  a,c
    6419   00:6203                          SEND_DATA                       ; Send the command parameter
    6419   00:6203  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6420   00:6206                      
    6421   00:6206                          ; Now wait up to 180 ticks to get response
    6422   00:6206  21 B4 00                ld hl,180
    6423   00:6209  CD 61 63                call    SETCOUNTER
    6424   00:620C                      TCPIP_CONFIG_AUTOIP_ST1:
    6425   00:620C                          CHECK_DATA
    6425   00:620C  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6425   00:620F  CB 47             >     bit 0,a
    6426   00:6211  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_ST1.1
    6427   00:6213  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6428   00:6216  18 F4                   jr  TCPIP_CONFIG_AUTOIP_ST1
    6429   00:6218                      TCPIP_CONFIG_AUTOIP_ST1.1:
    6430   00:6218                          ; nz, check the data
    6431   00:6218                          RECEIVE_DATA
    6431   00:6218  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6432   00:621B  FE 19                   cp  25                          ; Is response of our command?
    6433   00:621D  20 ED                   jr  nz,TCPIP_CONFIG_AUTOIP_ST1
    6434   00:621F                          ; now get return code, if return code other than 0, it is finished
    6435   00:621F                      TCPIP_CONFIG_AUTOIP_RC:
    6436   00:621F                          CHECK_DATA
    6436   00:621F  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6436   00:6222  CB 47             >     bit 0,a
    6437   00:6224  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_RC.1
    6438   00:6226  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6439   00:6229  18 F4                   jr  TCPIP_CONFIG_AUTOIP_RC
    6440   00:622B                      TCPIP_CONFIG_AUTOIP_RC.1:
    6441   00:622B                          ;nz, discard
    6442   00:622B                          RECEIVE_DATA
    6442   00:622B  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6443   00:622E  B7                      or  a                           ; 0?
    6444   00:622F  C0                      ret nz                          ; if not, done
    6445   00:6230                      
    6446   00:6230                          ; next two bytes are return code and size bytes, don't care, it is 1, configuration
    6447   00:6230  06 02                   ld  b,2
    6448   00:6232                      TCPIP_CONFIG_AUTOIP_ST2:
    6449   00:6232                          CHECK_DATA
    6449   00:6232  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6449   00:6235  CB 47             >     bit 0,a
    6450   00:6237  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_ST2.1
    6451   00:6239  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6452   00:623C  18 F4                   jr  TCPIP_CONFIG_AUTOIP_ST2
    6453   00:623E                      TCPIP_CONFIG_AUTOIP_ST2.1:
    6454   00:623E                          ; nz, discard
    6455   00:623E                          RECEIVE_DATA
    6455   00:623E  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6456   00:6241  05                      dec b
    6457   00:6242  20 EE                   jr  nz,TCPIP_CONFIG_AUTOIP_ST2
    6458   00:6244                      
    6459   00:6244                          ; now just get the 1 byte, configuration, should go to C
    6460   00:6244                      TCPIP_CONFIG_AUTOIP_CONF_ST1:
    6461   00:6244                          CHECK_DATA
    6461   00:6244  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
