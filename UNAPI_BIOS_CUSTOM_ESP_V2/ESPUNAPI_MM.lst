    2321   00:4D4B  CD A7 62                call    TOUPPER
    2322   00:4D4E  BE                      cp  (hl)
    2323   00:4D4F  20 37                   jr  nz,JUMP_OLD2
    2324   00:4D51  23                      inc hl
    2325   00:4D52  13                      inc de
    2326   00:4D53  B7                      or  a
    2327   00:4D54  20 F4                   jr  nz,LOOPSSH
    2328   00:4D56                      
