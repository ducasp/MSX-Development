    2680   00:4ED4                      ;=========================
    2681   00:4ED4                      ;===  TCPIP_GET_CAPAB  ===
    2682   00:4ED4                      ;=========================
    2683   00:4ED4                      ; Get information about the TCP/IP capabilities and features.
    2684   00:4ED4                      ;
    2685   00:4ED4                      ;    Input:  A = 1
    2686   00:4ED4                      ;            B = Index of information block to retrieve:
    2687   00:4ED4                      ;                1: Capabilities and features flags, link level protocol
    2688   00:4ED4                      ;                2: Connection pool size and status
    2689   00:4ED4                      ;                3: Maximum datagram size allowed
    2690   00:4ED4                      ;                4: Second set of capabilities and features flags
    2691   00:4ED4                      ;    Output: A = Error code
    2692   00:4ED4                      ;        When information block 1 requested:
    2693   00:4ED4                      ;            HL = Capabilities flags
    2694   00:4ED4                      ;            DE = Features flags
    2695   00:4ED4                      ;            B  = Link level protocol used
    2696   00:4ED4                      ;        When information block 2 requested:
    2697   00:4ED4                      ;            B = Maximum simultaneous TCP connections supported
    2698   00:4ED4                      ;            C = Maximum simultaneous UDP connections supported
    2699   00:4ED4                      ;            D = Free TCP connections currently available
    2700   00:4ED4                      ;            E = Free UDP connections currently available
    2701   00:4ED4                      ;            H = Maximum simultaneous raw IP connections supported
    2702   00:4ED4                      ;            L = Free raw IP connections currently available
    2703   00:4ED4                      ;        When information block 3 requested:
    2704   00:4ED4                      ;            HL = Maximum incoming datagram size supported
    2705   00:4ED4                      ;            DE = Maximum outgoing datagram size supported
    2706   00:4ED4                      ;        When information block 4 requested:
    2707   00:4ED4                      ;            HL = Second set of capabilities flags
    2708   00:4ED4                      ;            DE = Second set of features flags (currently unused, always zero)
    2709   00:4ED4                      TCPIP_GET_CAPAB:
    2710   00:4ED4                          SEND_DATA                       ; Send the command
    2710   00:4ED4  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2711   00:4ED7  AF                      xor a
    2712   00:4ED8                          SEND_DATA                       ; Send the command size msb
    2712   00:4ED8  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2713   00:4EDB  3C                      inc a
    2714   00:4EDC                          SEND_DATA                       ; Send the command size lsb
    2714   00:4EDC  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2715   00:4EDF  78                      ld  a,b
    2716   00:4EE0  CD E4 5E                call    SETBYTE                 ; Save it, we are going to need it later
    2717   00:4EE3                          SEND_DATA                       ; Send the parameter
    2717   00:4EE3  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2718   00:4EE6                      
    2719   00:4EE6                          ; Now wait up to 120 ticks to get response
    2720   00:4EE6  21 78 00                ld  hl,120
    2721   00:4EE9  CD C2 5E                call    SETCOUNTER
    2722   00:4EEC                      TCPIP_GET_CAPAB_ST1:
    2723   00:4EEC                          CHECK_DATA
    2723   00:4EEC  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2723   00:4EEF  CB 47             >     bit 0,a
    2724   00:4EF1  20 05                   jr  nz,TCPIP_GET_CAPAB_ST1.1
    2725   00:4EF3  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2726   00:4EF6  18 F4                   jr  TCPIP_GET_CAPAB_ST1
    2727   00:4EF8                      TCPIP_GET_CAPAB_ST1.1:
    2728   00:4EF8                          ; nz, check the data
    2729   00:4EF8                          RECEIVE_DATA
    2729   00:4EF8  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2730   00:4EFB  FE 01                   cp  1                           ; Is response of our command?
    2731   00:4EFD  20 ED                   jr  nz,TCPIP_GET_CAPAB_ST1
    2732   00:4EFF                          ; Now get return code, if return code other than 0, it is finished
    2733   00:4EFF                      TCPIP_GET_CAPAB_RC:
    2734   00:4EFF                          CHECK_DATA
    2734   00:4EFF  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2734   00:4F02  CB 47             >     bit 0,a
    2735   00:4F04  20 05                   jr  nz,TCPIP_GET_CAPAB_RC.1
    2736   00:4F06  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2737   00:4F09  18 F4                   jr  TCPIP_GET_CAPAB_RC
    2738   00:4F0B                      TCPIP_GET_CAPAB_RC.1:
    2739   00:4F0B                          ; nz, discard
    2740   00:4F0B                          RECEIVE_DATA
    2740   00:4F0B  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2741   00:4F0E  B7                      or  a                           ; 0?
    2742   00:4F0F  C0                      ret nz                          ; If not, done
    2743   00:4F10                      
    2744   00:4F10                          ; Next two bytes are return code and size bytes, don't care
    2745   00:4F10  06 02                   ld  b,2
    2746   00:4F12                      TCPIP_GET_CAPAB_ST2:
    2747   00:4F12                          CHECK_DATA
    2747   00:4F12  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2747   00:4F15  CB 47             >     bit 0,a
    2748   00:4F17  20 05                   jr  nz,TCPIP_GET_CAPAB_ST2.1
    2749   00:4F19  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2750   00:4F1C  18 F4                   jr  TCPIP_GET_CAPAB_ST2
    2751   00:4F1E                      TCPIP_GET_CAPAB_ST2.1:
    2752   00:4F1E                          ; Nz, discard
    2753   00:4F1E                          RECEIVE_DATA
    2753   00:4F1E  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2754   00:4F21  05                      dec b
    2755   00:4F22  20 EE                   jr  nz,TCPIP_GET_CAPAB_ST2
    2756   00:4F24                      
    2757   00:4F24                          ; Now check if block 1, 2 or 3
    2758   00:4F24  CD D2 5E                call    GETBYTE                 ; Get the parameter we saved at the start
    2759   00:4F27  3D                      dec a
    2760   00:4F28  CA DA 4F                jp  z,TCPIP_GET_CAPAB_BLK1      ; 1
    2761   00:4F2B  3D                      dec a
    2762   00:4F2C  CA 78 4F                jp  z,TCPIP_GET_CAPAB_BLK2      ; 2
    2763   00:4F2F  3D                      dec a
    2764   00:4F30  CA 36 4F                jp  z,TCPIP_GET_CAPAB_BLK3      ; 3
    2765   00:4F33                          ; Else, only block four, same as block 1
    2766   00:4F33  C3 DA 4F                jp  TCPIP_GET_CAPAB_BLK1        ; 1
    2767   00:4F36                          ; Block 3 Handling, we will receive L, H, E and D
