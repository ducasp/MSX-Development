    5226   00:5BCA                      ;===     SSH_SEND     ===
    5227   00:5BCA                      ;========================
    5228   00:5BCA                      ;Send data to a SSH connection.
    5229   00:5BCA                      ;
    5230   00:5BCA                      ;Input:  A  = 5
    5231   00:5BCA                      ;        B  = Connection number
    5232   00:5BCA                      ;        DE = Address of the data to be sent
    5233   00:5BCA                      ;        HL = Length of the data to be sent
    5234   00:5BCA                      ;Output: A  = Error code
    5235   00:5BCA                      SSH_SEND:
    5236   00:5BCA  CB FF                   set 7,a                         ; ESP SSH commands start at #80
    5237   00:5BCC                          SEND_DATA                       ; Send the command
    5237   00:5BCC  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5238   00:5BCF                          ; prepare new data size, adding our 1 byte overhead (connection #)
    5239   00:5BCF  23                      inc hl
