    4913   00:5A40  06 08                   ld  b,8                         ; prepare in advance for 8 bytes being transferred
    4914   00:5A42  CD D2 5E                call    GETBYTE                 ; Let's check if we have flagged need for INFOBLOCK
    4915   00:5A45  B7                      or  a
    4916   00:5A46  20 17                   jr  nz,TCPIP_TCP_STATE_GET_IBLOCK
    4917   00:5A48                      
