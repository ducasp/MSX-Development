    3053   00:50E5                      ;=========================
    3054   00:50E5                      ;===  TCPIP_NET_STATE  ===
    3055   00:50E5                      ;=========================
    3056   00:50E5                      ;Get network state.
    3057   00:50E5                      ;
    3058   00:50E5                      ;Input:  A = 3
    3059   00:50E5                      ;Output: A = Error code
    3060   00:50E5                      ;        B = Current network state:
    3061   00:50E5                      ;            0: Closed
    3062   00:50E5                      ;            1: Opening
    3063   00:50E5                      ;            2: Open
    3064   00:50E5                      ;            3: Closing
    3065   00:50E5                      ;            255: Unknown
    3066   00:50E5                      TCPIP_NET_STATE:
    3067   00:50E5                          SEND_DATA                       ; Send the command
    3067   00:50E5  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3068   00:50E8  AF                      xor a
    3069   00:50E9                          SEND_DATA                       ; Send the command size msb
    3069   00:50E9  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3070   00:50EC                          SEND_DATA                       ; Send the command size lsb
    3070   00:50EC  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3071   00:50EF                      
    3072   00:50EF                          ; Now wait up to 720 ticks to get response
    3073   00:50EF  21 D0 02                ld  hl,720
    3074   00:50F2  CD 36 61                call    SETCOUNTER
    3075   00:50F5                      TCPIP_NET_STATE_ST1:
    3076   00:50F5                          CHECK_DATA
    3076   00:50F5  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3076   00:50F8  CB 47             >     bit 0,a
    3077   00:50FA  20 05                   jr  nz,TCPIP_NET_STATE_ST1.1
    3078   00:50FC  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3079   00:50FF  18 F4                   jr  TCPIP_NET_STATE_ST1
    3080   00:5101                      TCPIP_NET_STATE_ST1.1:
    3081   00:5101                          ; nz, check the data
    3082   00:5101                          RECEIVE_DATA
    3082   00:5101  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3083   00:5104  FE 03                   cp  3                           ; Is response of our command?
    3084   00:5106  20 ED                   jr  nz,TCPIP_NET_STATE_ST1
    3085   00:5108                          ; now get return code, if return code other than 0, it is finished
    3086   00:5108                      TCPIP_NET_STATE_RC:
    3087   00:5108                          CHECK_DATA
    3087   00:5108  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3087   00:510B  CB 47             >     bit 0,a
    3088   00:510D  20 05                   jr  nz,TCPIP_NET_STATE_RC.1
    3089   00:510F  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3090   00:5112  18 F4                   jr  TCPIP_NET_STATE_RC
    3091   00:5114                      TCPIP_NET_STATE_RC.1:
    3092   00:5114                          ; nz, get it
    3093   00:5114                          RECEIVE_DATA
    3093   00:5114  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3094   00:5117  B7                      or  a                           ; 0?
    3095   00:5118  C0                      ret nz                          ; if not, done
    3096   00:5119                      
    3097   00:5119                          ; next two bytes are return code and size bytes, don't care, it is 1
    3098   00:5119  06 02                   ld  b,2
    3099   00:511B                      TCPIP_NET_STATE_ST2:
    3100   00:511B                          CHECK_DATA
    3100   00:511B  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3100   00:511E  CB 47             >     bit 0,a
    3101   00:5120  20 05                   jr  nz,TCPIP_NET_STATE_ST2.1
    3102   00:5122  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3103   00:5125  18 F4                   jr  TCPIP_NET_STATE_ST2
