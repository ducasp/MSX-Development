    6180   00:608E                      ;Output: A = Error code
    6181   00:608E                      ;        C = Flag value after the routine execution
    6182   00:608E                      TCPIP_CONFIG_PING:
    6183   00:608E  78                      ld  a,b
    6184   00:608F  E6 FE                   and %11111110
    6185   00:6091  B7                      or  a
    6186   00:6092  3E 04                   ld  a,ERR_INV_PARAM
