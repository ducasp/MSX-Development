    5862   00:5F0D  21 00 00                ld  hl,0
    5863   00:5F10  C9                      ret
    5864   00:5F11                          ; next two bytes are response size bytes save it to BC
    5865   00:5F11                      SSH_AUTH_GET_CHALLENGE_ST2A:
    5866   00:5F11                          CHECK_DATA
    5866   00:5F11  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
