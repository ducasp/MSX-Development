    1168   00:4608  B7                      or  a
    1169   00:4609  CA 10 46                jp  z,PRT_APENC
    1170   00:460C  23                      inc hl
    1171   00:460D  C3 07 46                jp  PRT_APNAMELP_CUT
    1172   00:4610                      PRT_APENC:
