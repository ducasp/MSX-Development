    3075   00:5103  18 F4                   jr  TCPIP_NET_STATE_ST1
    3076   00:5105                      TCPIP_NET_STATE_ST1.1:
    3077   00:5105                          ; nz, check the data
    3078   00:5105                          RECEIVE_DATA
    3078   00:5105  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3079   00:5108  FE 03                   cp  3                           ; Is response of our command?
    3080   00:510A  20 ED                   jr  nz,TCPIP_NET_STATE_ST1
    3081   00:510C                          ; now get return code, if return code other than 0, it is finished
    3082   00:510C                      TCPIP_NET_STATE_RC:
