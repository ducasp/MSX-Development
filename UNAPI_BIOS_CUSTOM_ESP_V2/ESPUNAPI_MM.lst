    2712   00:4F06                      ;=========================
    2713   00:4F06                      ;===  TCPIP_GET_CAPAB  ===
    2714   00:4F06                      ;=========================
    2715   00:4F06                      ; Get information about the TCP/IP capabilities and features.
    2716   00:4F06                      ;
    2717   00:4F06                      ;    Input:  A = 1
    2718   00:4F06                      ;            B = Index of information block to retrieve:
    2719   00:4F06                      ;                1: Capabilities and features flags, link level protocol
    2720   00:4F06                      ;                2: Connection pool size and status
    2721   00:4F06                      ;                3: Maximum datagram size allowed
    2722   00:4F06                      ;                4: Second set of capabilities and features flags
    2723   00:4F06                      ;    Output: A = Error code
    2724   00:4F06                      ;        When information block 1 requested:
    2725   00:4F06                      ;            HL = Capabilities flags
    2726   00:4F06                      ;            DE = Features flags
    2727   00:4F06                      ;            B  = Link level protocol used
    2728   00:4F06                      ;        When information block 2 requested:
    2729   00:4F06                      ;            B = Maximum simultaneous TCP connections supported
    2730   00:4F06                      ;            C = Maximum simultaneous UDP connections supported
    2731   00:4F06                      ;            D = Free TCP connections currently available
    2732   00:4F06                      ;            E = Free UDP connections currently available
    2733   00:4F06                      ;            H = Maximum simultaneous raw IP connections supported
    2734   00:4F06                      ;            L = Free raw IP connections currently available
    2735   00:4F06                      ;        When information block 3 requested:
    2736   00:4F06                      ;            HL = Maximum incoming datagram size supported
    2737   00:4F06                      ;            DE = Maximum outgoing datagram size supported
    2738   00:4F06                      ;        When information block 4 requested:
    2739   00:4F06                      ;            HL = Second set of capabilities flags
    2740   00:4F06                      ;            DE = Second set of features flags (currently unused, always zero)
    2741   00:4F06                      TCPIP_GET_CAPAB:
    2742   00:4F06                          SEND_DATA                       ; Send the command
    2742   00:4F06  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2743   00:4F09  AF                      xor a
    2744   00:4F0A                          SEND_DATA                       ; Send the command size msb
    2744   00:4F0A  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2745   00:4F0D  3C                      inc a
    2746   00:4F0E                          SEND_DATA                       ; Send the command size lsb
    2746   00:4F0E  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2747   00:4F11  78                      ld  a,b
    2748   00:4F12  CD 60 61                call    SETBYTE                 ; Save it, we are going to need it later
    2749   00:4F15                          SEND_DATA                       ; Send the parameter
    2749   00:4F15  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2750   00:4F18                      
    2751   00:4F18                          ; Now wait up to 120 ticks to get response
    2752   00:4F18  21 78 00                ld  hl,120
    2753   00:4F1B  CD 3E 61                call    SETCOUNTER
    2754   00:4F1E                      TCPIP_GET_CAPAB_ST1:
    2755   00:4F1E                          CHECK_DATA
    2755   00:4F1E  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2755   00:4F21  CB 47             >     bit 0,a
    2756   00:4F23  20 05                   jr  nz,TCPIP_GET_CAPAB_ST1.1
    2757   00:4F25  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2758   00:4F28  18 F4                   jr  TCPIP_GET_CAPAB_ST1
    2759   00:4F2A                      TCPIP_GET_CAPAB_ST1.1:
    2760   00:4F2A                          ; nz, check the data
    2761   00:4F2A                          RECEIVE_DATA
    2761   00:4F2A  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2762   00:4F2D  FE 01                   cp  1                           ; Is response of our command?
    2763   00:4F2F  20 ED                   jr  nz,TCPIP_GET_CAPAB_ST1
    2764   00:4F31                          ; Now get return code, if return code other than 0, it is finished
    2765   00:4F31                      TCPIP_GET_CAPAB_RC:
    2766   00:4F31                          CHECK_DATA
    2766   00:4F31  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2766   00:4F34  CB 47             >     bit 0,a
    2767   00:4F36  20 05                   jr  nz,TCPIP_GET_CAPAB_RC.1
    2768   00:4F38  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2769   00:4F3B  18 F4                   jr  TCPIP_GET_CAPAB_RC
    2770   00:4F3D                      TCPIP_GET_CAPAB_RC.1:
    2771   00:4F3D                          ; nz, discard
    2772   00:4F3D                          RECEIVE_DATA
    2772   00:4F3D  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2773   00:4F40  B7                      or  a                           ; 0?
    2774   00:4F41  C0                      ret nz                          ; If not, done
    2775   00:4F42                      
    2776   00:4F42                          ; Next two bytes are return code and size bytes, don't care
    2777   00:4F42  06 02                   ld  b,2
    2778   00:4F44                      TCPIP_GET_CAPAB_ST2:
    2779   00:4F44                          CHECK_DATA
    2779   00:4F44  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2779   00:4F47  CB 47             >     bit 0,a
    2780   00:4F49  20 05                   jr  nz,TCPIP_GET_CAPAB_ST2.1
    2781   00:4F4B  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2782   00:4F4E  18 F4                   jr  TCPIP_GET_CAPAB_ST2
    2783   00:4F50                      TCPIP_GET_CAPAB_ST2.1:
    2784   00:4F50                          ; Nz, discard
    2785   00:4F50                          RECEIVE_DATA
    2785   00:4F50  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2786   00:4F53  05                      dec b
    2787   00:4F54  20 EE                   jr  nz,TCPIP_GET_CAPAB_ST2
    2788   00:4F56                      
    2789   00:4F56                          ; Now check if block 1, 2 or 3
    2790   00:4F56  CD 4E 61                call    GETBYTE                 ; Get the parameter we saved at the start
    2791   00:4F59  3D                      dec a
    2792   00:4F5A  CA 0C 50                jp  z,TCPIP_GET_CAPAB_BLK1      ; 1
    2793   00:4F5D  3D                      dec a
    2794   00:4F5E  CA AA 4F                jp  z,TCPIP_GET_CAPAB_BLK2      ; 2
    2795   00:4F61  3D                      dec a
    2796   00:4F62  CA 68 4F                jp  z,TCPIP_GET_CAPAB_BLK3      ; 3
    2797   00:4F65                          ; Else, only block four, same as block 1
    2798   00:4F65  C3 0C 50                jp  TCPIP_GET_CAPAB_BLK1        ; 1
    2799   00:4F68                          ; Block 3 Handling, we will receive L, H, E and D
