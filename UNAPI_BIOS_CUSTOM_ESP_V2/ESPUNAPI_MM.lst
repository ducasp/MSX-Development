    4221   00:5683                      ;========================
    4222   00:5683                      ;===     SSH_OPEN     ===
    4223   00:5683                      ;========================
    4224   00:5683                      ;Open a SSH connection.
    4225   00:5683                      ;
    4226   00:5683                      ;Input:  A  = 2
    4227   00:5683                      ;        HL = Address of parameters block
    4228   00:5683                      ;Output: A = Error code
    4229   00:5683                      ;        B = Connection number
    4230   00:5683                      ;
    4231   00:5683                      ;Parameters block format:
    4232   00:5683                      ;
    4233   00:5683                      ;+0 (4): Remote IP address (0.0.0.0 for unspecified remote socket)
    4234   00:5683                      ;+4 (2): Remote port (ignored if unspecified remote socket)
    4235   00:5683                      ;+6 (1): Subsystem
    4236   00:5683                      ;+7 (1): Flags
    4237   00:5683                      ;+8 (variable): username (0 terminated) and then password or public key (0 terminated)
    4238   00:5683                      
    4239   00:5683                      SSH_OPEN:
    4240   00:5683  E5                      push    hl                      ; save param block address
    4241   00:5684  3E 08                   ld  a,8
    4242   00:5686  85                      add a,l
    4243   00:5687  6F                      ld  l,a
    4244   00:5688  30 01                   jr  nc,SSH_OPEN_1
    4245   00:568A  24                      inc h
    4246   00:568B                      SSH_OPEN_1:
    4247   00:568B                          ; let's check how many bytes there are
    4248   00:568B  11 08 00                ld  de,8                        ; Start with 8, all params except username and password
    4249   00:568E                      SSH_OPEN_CHECK_USER:
    4250   00:568E  7E                      ld  a,(hl)
    4251   00:568F  13                      inc de                          ; Increase size count
    4252   00:5690  23                      inc hl                          ; And next byte
    4253   00:5691  B7                      or  a                           ; If zero, user terminated
    4254   00:5692                          ; Loop until terminator (0) is found
    4255   00:5692  C2 8E 56                jp  nz,SSH_OPEN_CHECK_USER
    4256   00:5695                      SSH_OPEN_CHECK_PASS:
    4257   00:5695  7E                      ld  a,(hl)
    4258   00:5696  13                      inc de                          ; Increase size count
    4259   00:5697  23                      inc hl                          ; And next byte
    4260   00:5698  B7                      or  a                           ; If zero, password terminated
    4261   00:5699                          ; Loop until terminator (0) is found
    4262   00:5699  C2 95 56                jp  nz,SSH_OPEN_CHECK_PASS
