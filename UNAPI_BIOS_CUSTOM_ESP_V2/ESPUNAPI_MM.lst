    4281   00:56B5  11 08 00                ld  de,8                        ; Start with 8, all params except username and password
    4282   00:56B8                      SSH_OPEN_CHECK_USER:
    4283   00:56B8  7E                      ld  a,(hl)
    4284   00:56B9  13                      inc de                          ; Increase size count
    4285   00:56BA  23                      inc hl                          ; And next byte
    4286   00:56BB  B7                      or  a                           ; If zero, user terminated
    4287   00:56BC                          ; Loop until terminator (0) is found
    4288   00:56BC  C2 B8 56                jp  nz,SSH_OPEN_CHECK_USER
    4289   00:56BF                      SSH_OPEN_CHECK_PASS:
    4290   00:56BF  7E                      ld  a,(hl)
    4291   00:56C0  13                      inc de                          ; Increase size count
    4292   00:56C1  23                      inc hl                          ; And next byte
    4293   00:56C2  B7                      or  a                           ; If zero, password terminated
    4294   00:56C3                          ; Loop until terminator (0) is found
    4295   00:56C3  C2 BF 56                jp  nz,SSH_OPEN_CHECK_PASS
