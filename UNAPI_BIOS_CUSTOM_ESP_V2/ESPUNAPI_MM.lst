    3092   00:511D                      
    3093   00:511D                          ; next two bytes are return code and size bytes, don't care, it is 1
    3094   00:511D  06 02                   ld  b,2
    3095   00:511F                      TCPIP_NET_STATE_ST2:
    3096   00:511F                          CHECK_DATA
