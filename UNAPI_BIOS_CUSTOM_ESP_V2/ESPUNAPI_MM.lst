    4911   00:5A1A                      ;=========================
    4912   00:5A1A                      ;===  TCPIP_TCP_STATE  ===
    4913   00:5A1A                      ;=========================
    4914   00:5A1A                      ;Get the state of a TCP connection.
    4915   00:5A1A                      ;
    4916   00:5A1A                      ;Input:  A = 16
    4917   00:5A1A                      ;        B = Connection number
    4918   00:5A1A                      ;        HL = Pointer in TPA for connection information block
    4919   00:5A1A                      ;             (0 if not needed)
    4920   00:5A1A                      ;Output: A  = Error code
    4921   00:5A1A                      ;        B  = Connection state
    4922   00:5A1A                      ;        C  = Close reason (only if ERR_NO_CONN is returned)
    4923   00:5A1A                      ;        HL = Number of total available incoming bytes
    4924   00:5A1A                      ;        DE = Number of urgent available incoming bytes
    4925   00:5A1A                      ;        IX = Available free space in the output buffer
    4926   00:5A1A                      ;             (0FFFFh = infinite)
    4927   00:5A1A                      ;
    4928   00:5A1A                      ;Connection information block consists of:
    4929   00:5A1A                      ;
    4930   00:5A1A                      ;    +0 (4): Remote IP address
    4931   00:5A1A                      ;    +4 (2): Remote port
    4932   00:5A1A                      ;    +6 (2): Local port
    4933   00:5A1A                      TCPIP_TCP_STATE_ERROR:
    4934   00:5A1A                          ; next two bytes are size bytes, don't care
    4935   00:5A1A  47                      ld  b,a                         ; save error in b
    4936   00:5A1B  0E 02                   ld  c,2
