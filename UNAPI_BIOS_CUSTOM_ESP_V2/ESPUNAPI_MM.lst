    4957   00:5A3F                      TCPIP_TCP_STATE:
    4958   00:5A3F  CD 87 61                call    SETWORD                 ; Save HL pointer in our memory
    4959   00:5A42  7C                      ld  a,h
    4960   00:5A43  B5                      or  l                           ; Information block required?
    4961   00:5A44  3E 00                   ld  a,0                         ; do not want to mess with flags, let's say no need
    4962   00:5A46  28 01                   jr  z,TCPIP_TCP_STATE_NOINFOBLOCK
    4963   00:5A48  3C                      inc a                           ; otherwise there is a need
    4964   00:5A49                      TCPIP_TCP_STATE_NOINFOBLOCK:
    4965   00:5A49  CD 60 61                call    SETBYTE                 ; Save for later
    4966   00:5A4C  3E 10                   ld  a,16                        ; Our command
    4967   00:5A4E                          SEND_DATA                       ; Send the command
    4967   00:5A4E  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4968   00:5A51  AF                      xor a
