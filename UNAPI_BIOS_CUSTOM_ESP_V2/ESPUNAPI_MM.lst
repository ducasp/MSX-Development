    3998   00:5584                          ; nz, get it
    3999   00:5584                          RECEIVE_DATA
    3999   00:5584  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4000   00:5587  4F                      ld  c,a
    4001   00:5588                      TCPIP_TCP_OPEN_ERROR4:
    4002   00:5588                          ; now return w/ error that is saved in b
    4003   00:5588  78                      ld  a,b
    4004   00:5589  06 00                   ld  b,0                         ; no connection, so 0
    4005   00:558B  C9                      ret
    4006   00:558C                      
    4007   00:558C                      TCPIP_TCP_OPEN:
    4008   00:558C  E5                      push    hl                      ; save param block address
    4009   00:558D  7C                      ld  a,h
    4010   00:558E  DD 67                   ld  ixh,a
    4011   00:5590  7D                      ld  a,l
    4012   00:5591  DD 6F                   ld  ixl,a
    4013   00:5593                          ; IX now has the parameters area
    4014   00:5593                          ; most times it will be non tls, so this is the first test case
    4015   00:5593  21 0B 00                ld  hl,11
    4016   00:5596  CD AA 63                call    SETWORD                 ; If it is non-TLS, send 11 bytes
    4017   00:5599  DD 7E 0A                ld  a,(ix+10)                   ; TCP_OPEN_CMD_FLAGS
    4018   00:559C  CB 57                   bit 2,a
    4019   00:559E  28 4F                   jr  z,TCPIP_TCP_OPEN_NO_TLS
    4020   00:55A0                      
    4021   00:55A0                          ; TLS, but, do we have host name?
    4022   00:55A0  21 0C 00                ld  hl,12
    4023   00:55A3  CD AA 63                call    SETWORD                 ; If it is TLS without host name, send 12 bytes, one zero as host name suffice
    4024   00:55A6  DD 6E 0B                ld  l,(ix+11)                   ; TCP_OPEN_CMD_HOST_LSB
    4025   00:55A9  DD 7E 0C                ld  a,(ix+12)                   ; TCP_OPEN_CMD_HOST_MSB
    4026   00:55AC  B5                      or  l
    4027   00:55AD                          ; if TLS and next two bytes are 00 no host to check
    4028   00:55AD  28 40                   jr  z,TCPIP_TCP_OPEN_NO_CHECKHOST
    4029   00:55AF                          ; we are here, host to check
    4030   00:55AF  DD 66 0C                ld  h,(ix+12)                   ; TCP_OPEN_CMD_HOST_MSB
    4031   00:55B2  D1                      pop de                          ; Retrieve parameters address
    4032   00:55B3  E5                      push    hl                      ; Save host name address
    4033   00:55B4  D5                      push    de                      ; Save Parameters address (so it is in the order we are going to need)
    4034   00:55B5                          ; let's check how many bytes there are
    4035   00:55B5  11 0B 00                ld  de,11                       ; Start with 11, all params except host name
    4036   00:55B8                      TCPIP_TCP_OPEN_CHECK_HOSTOF:
    4037   00:55B8  7E                      ld  a,(hl)
    4038   00:55B9  13                      inc de                          ; Not zero, so increase size count
    4039   00:55BA  23                      inc hl                          ; And next hostname byte
    4040   00:55BB  B7                      or  a                           ; If zero, hostname terminated
    4041   00:55BC                          ; Loop until terminator (0) is found
    4042   00:55BC  C2 B8 55                jp  nz,TCPIP_TCP_OPEN_CHECK_HOSTOF
    4043   00:55BF                      
    4044   00:55BF                      TCPIP_TCP_OPEN_HOSTNAME_SENDCMDWITHHOSTNAME:
    4045   00:55BF                          ; Ok, so, DE has the full hostname size, let's start sending from here
    4046   00:55BF  3E 0D                   ld  a,13                        ; Function TCP OPEN
    4047   00:55C1                          SEND_DATA                       ; Send the command
    4047   00:55C1  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4048   00:55C4  7A                      ld  a,d
    4049   00:55C5                          SEND_DATA                       ; Send the command size msb
    4049   00:55C5  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4050   00:55C8  7B                      ld  a,e
    4051   00:55C9                          SEND_DATA                       ; Send the command size lsb
    4051   00:55C9  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4052   00:55CC  E1                      pop hl                          ; Restore the memory address for the parameters
    4053   00:55CD                          ; First send the 11 bytes parameters
    4054   00:55CD                          if USE_MEM_IO = 0
    4055   00:55CD                    ~     ld  c,OUT_TX_PORT
    4056   00:55CD                    ~     outi
    4057   00:55CD                    ~     outi
    4058   00:55CD                    ~     outi
    4059   00:55CD                    ~     outi
    4060   00:55CD                    ~     outi
    4061   00:55CD                    ~     outi
    4062   00:55CD                    ~     outi
    4063   00:55CD                    ~     outi
    4064   00:55CD                    ~     outi
    4065   00:55CD                    ~     outi
    4066   00:55CD                    ~     outi                            ; Unrolled outi is a bit faster :)
    4067   00:55CD                    ~     else
    4068   00:55CD  06 0B                   ld  b,11                        ; Send 11 bytes
    4069   00:55CF                      TCPIP_TCP_OPEN_HOSTNAME_SENDCMDWITHHOSTNAME_LOOP_PARAM:
    4070   00:55CF  7E                      ld  a,(hl)
    4071   00:55D0  32 07 7F                ld  (MEM_OUT_TX_PORT),a
    4072   00:55D3  23                      inc hl
    4073   00:55D4  10 F9                   djnz TCPIP_TCP_OPEN_HOSTNAME_SENDCMDWITHHOSTNAME_LOOP_PARAM
    4074   00:55D6                          endif
    4075   00:55D6  EB                      ex  de,hl                       ; Size in HL
    4076   00:55D7  11 0B 00                ld  de,11
    4077   00:55DA  B7                      or  a                           ; zero flag
    4078   00:55DB  ED 52                   sbc hl,de
    4079   00:55DD  EB                      ex de,hl                        ; and adjusted size back in de
    4080   00:55DE  E1                      pop hl                          ; Restore the memory address for hostname
    4081   00:55DF                      ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    4082   00:55DF  43                      ld  b,e                         ; Number of loops originaly in DE
    4083   00:55E0  1B                      dec de
    4084   00:55E1  14                      inc d
    4085   00:55E2                          if USE_MEM_IO = 0
    4086   00:55E2                    ~     ld  c,OUT_TX_PORT
    4087   00:55E2                    ~ TCPIP_TCP_OPEN_SENDHOSTNAME:
    4088   00:55E2                    ~     outi
    4089   00:55E2                    ~     jr  nz,TCPIP_TCP_OPEN_SENDHOSTNAME
    4090   00:55E2                    ~     else
    4091   00:55E2                      TCPIP_TCP_OPEN_SENDHOSTNAME:
    4092   00:55E2  7E                      ld  a,(hl)
    4093   00:55E3  32 07 7F                ld  (MEM_OUT_TX_PORT),a
    4094   00:55E6  23                      inc hl
    4095   00:55E7  10 F9                   djnz TCPIP_TCP_OPEN_SENDHOSTNAME
    4096   00:55E9                          endif
    4097   00:55E9  15                      dec d
    4098   00:55EA  20 F6                   jr  nz,TCPIP_TCP_OPEN_SENDHOSTNAME
    4099   00:55EC  C3 0F 56                jp  TCPIP_TCP_OPEN_WAIT_RESPONSE
    4100   00:55EF                      
    4101   00:55EF                      TCPIP_TCP_OPEN_NO_TLS:
    4102   00:55EF                      TCPIP_TCP_OPEN_NO_CHECKHOST:
    4103   00:55EF  3E 0D                   ld  a,13                        ; Function TCP OPEN
    4104   00:55F1                          SEND_DATA                       ; Send the command
    4104   00:55F1  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4105   00:55F4  CD 97 63                call    GETWORD
    4106   00:55F7  7C                      ld  a,h
    4107   00:55F8  57                      ld  d,a
