    4300   00:56D4                          SEND_DATA                       ; Send the command size lsb
    4300   00:56D4  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4301   00:56D7  E1                      pop hl                          ; Restore the memory address for the parameters
    4302   00:56D8  E5                      push    hl                      ; we might need it later
    4303   00:56D9                      ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    4304   00:56D9  43                      ld  b,e                         ; Number of loops originaly in DE
    4305   00:56DA  1B                      dec de
    4306   00:56DB  14                      inc d
    4307   00:56DC                          if USE_MEM_IO = 0
    4308   00:56DC                    ~     ld  c,OUT_TX_PORT
    4309   00:56DC                    ~ SSH_OPEN_SENDDATA:
    4310   00:56DC                    ~     outi
    4311   00:56DC                    ~     jr  nz,SSH_OPEN_SENDDATA
    4312   00:56DC                    ~     else
