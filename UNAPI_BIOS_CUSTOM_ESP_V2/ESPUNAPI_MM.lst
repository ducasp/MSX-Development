    2424   00:4DB2  BB 50               FN_3:                   dw  TCPIP_NET_STATE
    2425   00:4DB4                      ; TCPIP_SEND_ECHO not going to be implemented, ESP do not support ping like UNAPI specify
    2426   00:4DB4  18 4E               FN_4:                   dw  FN_NOT_IMP
    2427   00:4DB6                      ; TCPIP_RCV_ECHO not going to be implemented as SEND_ECHO is not implemented
    2428   00:4DB6  18 4E               FN_5:                   dw  FN_NOT_IMP
    2429   00:4DB8  15 51               FN_6:                   dw  TCPIP_DNS_Q
    2430   00:4DBA  D6 51               FN_7:                   dw  TCPIP_DNS_S
    2431   00:4DBC  03 52               FN_8:                   dw  TCPIP_UDP_OPEN
    2432   00:4DBE  6B 52               FN_9:                   dw  TCPIP_UDP_CLOSE
    2433   00:4DC0  BB 52               FN_10:                  dw  TCPIP_UDP_STATE
    2434   00:4DC2  5A 53               FN_11:                  dw  TCPIP_UDP_SEND
    2435   00:4DC4  0D 54               FN_12:                  dw  TCPIP_UDP_RCV
    2436   00:4DC6  5E 55               FN_13:                  dw  TCPIP_TCP_OPEN
    2437   00:4DC8  33 56               FN_14:                  dw  TCPIP_TCP_CLOSE
    2438   00:4DCA  E9 58               FN_15:                  dw  TCPIP_TCP_ABORT
