    4980   00:5A65  18 F4                   jr  TCPIP_TCP_STATE_ST1
    4981   00:5A67                      TCPIP_TCP_STATE_ST1.1:
    4982   00:5A67                          ; nz, check the data
    4983   00:5A67                          RECEIVE_DATA
    4983   00:5A67  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4984   00:5A6A  FE 10                   cp  16                          ; Is response of our command?
