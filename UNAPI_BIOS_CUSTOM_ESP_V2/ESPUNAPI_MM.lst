    3972   00:5556                          ; nz, get it
    3973   00:5556                          RECEIVE_DATA
    3973   00:5556  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3974   00:5559  4F                      ld  c,a
    3975   00:555A                      TCPIP_TCP_OPEN_ERROR4:
    3976   00:555A                          ; now return w/ error that is saved in b
    3977   00:555A  78                      ld  a,b
    3978   00:555B  06 00                   ld  b,0                         ; no connection, so 0
    3979   00:555D  C9                      ret
    3980   00:555E                      
    3981   00:555E                      TCPIP_TCP_OPEN:
    3982   00:555E  E5                      push    hl                      ; save param block address
    3983   00:555F  7C                      ld  a,h
    3984   00:5560  DD 67                   ld  ixh,a
    3985   00:5562  7D                      ld  a,l
    3986   00:5563  DD 6F                   ld  ixl,a
    3987   00:5565                          ; IX now has the parameters area
    3988   00:5565                          ; most times it will be non tls, so this is the first test case
    3989   00:5565  21 0B 00                ld  hl,11
    3990   00:5568  CD 0B 5F                call    SETWORD                 ; If it is non-TLS, send 11 bytes
    3991   00:556B  DD 7E 0A                ld  a,(ix+10)                   ; TCP_OPEN_CMD_FLAGS
    3992   00:556E  CB 57                   bit 2,a
    3993   00:5570  28 4F                   jr  z,TCPIP_TCP_OPEN_NO_TLS
    3994   00:5572                      
    3995   00:5572                          ; TLS, but, do we have host name?
    3996   00:5572  21 0C 00                ld  hl,12
    3997   00:5575  CD 0B 5F                call    SETWORD                 ; If it is TLS without host name, send 12 bytes, one zero as host name suffice
    3998   00:5578  DD 6E 0B                ld  l,(ix+11)                   ; TCP_OPEN_CMD_HOST_LSB
    3999   00:557B  DD 7E 0C                ld  a,(ix+12)                   ; TCP_OPEN_CMD_HOST_MSB
    4000   00:557E  B5                      or  l
    4001   00:557F                          ; if TLS and next two bytes are 00 no host to check
    4002   00:557F  28 40                   jr  z,TCPIP_TCP_OPEN_NO_CHECKHOST
    4003   00:5581                          ; we are here, host to check
    4004   00:5581  DD 66 0C                ld  h,(ix+12)                   ; TCP_OPEN_CMD_HOST_MSB
    4005   00:5584  D1                      pop de                          ; Retrieve parameters address
    4006   00:5585  E5                      push    hl                      ; Save host name address
    4007   00:5586  D5                      push    de                      ; Save Parameters address (so it is in the order we are going to need)
    4008   00:5587                          ; let's check how many bytes there are
    4009   00:5587  11 0B 00                ld  de,11                       ; Start with 11, all params except host name
    4010   00:558A                      TCPIP_TCP_OPEN_CHECK_HOSTOF:
    4011   00:558A  7E                      ld  a,(hl)
    4012   00:558B  13                      inc de                          ; Not zero, so increase size count
    4013   00:558C  23                      inc hl                          ; And next hostname byte
    4014   00:558D  B7                      or  a                           ; If zero, hostname terminated
    4015   00:558E                          ; Loop until terminator (0) is found
    4016   00:558E  C2 8A 55                jp  nz,TCPIP_TCP_OPEN_CHECK_HOSTOF
    4017   00:5591                      
    4018   00:5591                      TCPIP_TCP_OPEN_HOSTNAME_SENDCMDWITHHOSTNAME:
    4019   00:5591                          ; Ok, so, DE has the full hostname size, let's start sending from here
    4020   00:5591  3E 0D                   ld  a,13                        ; Function TCP OPEN
    4021   00:5593                          SEND_DATA                       ; Send the command
    4021   00:5593  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4022   00:5596  7A                      ld  a,d
    4023   00:5597                          SEND_DATA                       ; Send the command size msb
    4023   00:5597  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4024   00:559A  7B                      ld  a,e
    4025   00:559B                          SEND_DATA                       ; Send the command size lsb
    4025   00:559B  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4026   00:559E  E1                      pop hl                          ; Restore the memory address for the parameters
    4027   00:559F                          ; First send the 11 bytes parameters
    4028   00:559F                          if USE_MEM_IO = 0
    4029   00:559F                    ~     ld  c,OUT_TX_PORT
    4030   00:559F                    ~     outi
    4031   00:559F                    ~     outi
    4032   00:559F                    ~     outi
    4033   00:559F                    ~     outi
    4034   00:559F                    ~     outi
    4035   00:559F                    ~     outi
    4036   00:559F                    ~     outi
    4037   00:559F                    ~     outi
    4038   00:559F                    ~     outi
    4039   00:559F                    ~     outi
    4040   00:559F                    ~     outi                            ; Unrolled outi is a bit faster :)
    4041   00:559F                    ~     else
    4042   00:559F  06 0B                   ld  b,11                        ; Send 11 bytes
    4043   00:55A1                      TCPIP_TCP_OPEN_HOSTNAME_SENDCMDWITHHOSTNAME_LOOP_PARAM:
    4044   00:55A1  7E                      ld  a,(hl)
    4045   00:55A2  32 07 7F                ld  (MEM_OUT_TX_PORT),a
    4046   00:55A5  23                      inc hl
    4047   00:55A6  10 F9                   djnz TCPIP_TCP_OPEN_HOSTNAME_SENDCMDWITHHOSTNAME_LOOP_PARAM
    4048   00:55A8                          endif
    4049   00:55A8  EB                      ex  de,hl                       ; Size in HL
    4050   00:55A9  11 0B 00                ld  de,11
    4051   00:55AC  B7                      or  a                           ; zero flag
    4052   00:55AD  ED 52                   sbc hl,de
    4053   00:55AF  EB                      ex de,hl                        ; and adjusted size back in de
    4054   00:55B0  E1                      pop hl                          ; Restore the memory address for hostname
    4055   00:55B1                      ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    4056   00:55B1  43                      ld  b,e                         ; Number of loops originaly in DE
    4057   00:55B2  1B                      dec de
    4058   00:55B3  14                      inc d
    4059   00:55B4                          if USE_MEM_IO = 0
    4060   00:55B4                    ~     ld  c,OUT_TX_PORT
    4061   00:55B4                    ~ TCPIP_TCP_OPEN_SENDHOSTNAME:
    4062   00:55B4                    ~     outi
    4063   00:55B4                    ~     jr  nz,TCPIP_TCP_OPEN_SENDHOSTNAME
    4064   00:55B4                    ~     else
    4065   00:55B4                      TCPIP_TCP_OPEN_SENDHOSTNAME:
    4066   00:55B4  7E                      ld  a,(hl)
    4067   00:55B5  32 07 7F                ld  (MEM_OUT_TX_PORT),a
    4068   00:55B8  23                      inc hl
    4069   00:55B9  10 F9                   djnz TCPIP_TCP_OPEN_SENDHOSTNAME
    4070   00:55BB                          endif
    4071   00:55BB  15                      dec d
    4072   00:55BC  20 F6                   jr  nz,TCPIP_TCP_OPEN_SENDHOSTNAME
    4073   00:55BE  C3 E1 55                jp  TCPIP_TCP_OPEN_WAIT_RESPONSE
    4074   00:55C1                      
    4075   00:55C1                      TCPIP_TCP_OPEN_NO_TLS:
    4076   00:55C1                      TCPIP_TCP_OPEN_NO_CHECKHOST:
    4077   00:55C1  3E 0D                   ld  a,13                        ; Function TCP OPEN
    4078   00:55C3                          SEND_DATA                       ; Send the command
    4078   00:55C3  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4079   00:55C6  CD F8 5E                call    GETWORD
    4080   00:55C9  7C                      ld  a,h
    4081   00:55CA  57                      ld  d,a
    4082   00:55CB                          SEND_DATA                       ; Send the command size msb
    4082   00:55CB  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4083   00:55CE  7D                      ld  a,l
    4084   00:55CF  5F                      ld  e,a
    4085   00:55D0                          SEND_DATA                       ; Send the command size lsb
    4085   00:55D0  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4086   00:55D3                      
    4087   00:55D3  E1                      pop hl                          ; Restore the memory address for the parameters
    4088   00:55D4                      ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    4089   00:55D4  43                      ld  b,e                         ; Number of loops originaly in DE
    4090   00:55D5  1B                      dec de
    4091   00:55D6  14                      inc d
    4092   00:55D7                          if USE_MEM_IO = 0
    4093   00:55D7                    ~     ld  c,OUT_TX_PORT
    4094   00:55D7                    ~ TCPIP_TCP_OPEN_R:
    4095   00:55D7                    ~     outi
    4096   00:55D7                    ~     jr  nz,TCPIP_TCP_OPEN_R
    4097   00:55D7                    ~     else
    4098   00:55D7                      TCPIP_TCP_OPEN_R:
    4099   00:55D7  7E                      ld  a,(hl)
    4100   00:55D8  32 07 7F                ld  (MEM_OUT_TX_PORT),a
    4101   00:55DB  23                      inc hl
    4102   00:55DC  10 F9                   djnz TCPIP_TCP_OPEN_R
    4103   00:55DE                          endif
    4104   00:55DE  15                      dec d
    4105   00:55DF  20 F6                   jr  nz,TCPIP_TCP_OPEN_R
    4106   00:55E1                      
    4107   00:55E1                      TCPIP_TCP_OPEN_WAIT_RESPONSE:
    4108   00:55E1                          ; Now wait up to 3600 (1 minute @ 60Hz) ticks to get response
    4109   00:55E1                          ; TLS Connections might take SEVERAL seconds on TLS Handshake
    4110   00:55E1                          ; Even more if certificates database is being indexed
    4111   00:55E1  21 10 0E                ld  hl,3600
