    6512   00:6286  18 F4                   jr  TCPIP_CONFIG_IP_ST1
    6513   00:6288                      TCPIP_CONFIG_IP_ST1.1:
    6514   00:6288                          ; nz, check the data
    6515   00:6288                          RECEIVE_DATA
    6515   00:6288  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6516   00:628B  FE 1A                   cp  26                          ; Is response of our command?
    6517   00:628D  20 ED                   jr  nz,TCPIP_CONFIG_IP_ST1
    6518   00:628F                          ; now get return code, and that is it
    6519   00:628F                      TCPIP_CONFIG_IP_RC:
    6520   00:628F                          CHECK_DATA
    6520   00:628F  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6520   00:6292  CB 47             >     bit 0,a
