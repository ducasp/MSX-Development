    6604   00:6203  D1                      pop de
    6605   00:6204  C1                      pop bc
    6606   00:6205  C9                      ret
    6607   00:6206                      
    6608   00:6206                      ;--- Backups HL in high memory
    6609   00:6206                      ;    Input:  HL
    6610   00:6206                      ;    Output: none
    6611   00:6206                      ;    Modifies: AF
    6612   00:6206                      
    6613   00:6206                      HLBACKUP:
    6614   00:6206  D5                      push    de
    6615   00:6207  C5                      push    bc
    6616   00:6208  E5                      push    hl
    6617   00:6209  CD 96 60                call    GETSLT
    6618   00:620C                          ; Slot in A, now get the address
    6619   00:620C  CD 1F 61                call    GETMEMPOINTER
    6620   00:620F                          ; HL has the address of our memory area, byte param is 7 bytes after start
    6621   00:620F  11 11 00                ld  de,MEMORY_HLBACKUP_OFFSET
    6622   00:6212  19                      add hl,de
    6623   00:6213                          ; HL has the address of param
    6624   00:6213  D1                      pop de                          ; Restore HL in de
    6625   00:6214  73                      ld  (hl),e
    6626   00:6215  23                      inc hl
    6627   00:6216  72                      ld  (hl),d
    6628   00:6217  EB                      ex  de,hl                       ; Restore HL
    6629   00:6218  C1                      pop bc                          ; Restore BC
    6630   00:6219  D1                      pop de                          ; Restore DE
    6631   00:621A  C9                      ret
    6632   00:621B                      
    6633   00:621B                      ;--- Return the saved ESP TYPE
    6634   00:621B                      ;    Input:  none
    6635   00:621B                      ;    Output: A and F will be NZ if ESP32
    6636   00:621B                      ;    Modifies: AF
    6637   00:621B                      
    6638   00:621B                      GETESPTYPE:
    6639   00:621B  D5                      push    de
    6640   00:621C  C5                      push    bc
    6641   00:621D  E5                      push    hl
    6642   00:621E  DD E5                   push    ix
    6643   00:6220  FD E5                   push    iy
    6644   00:6222  CD 96 60                call    GETSLT
    6645   00:6225  CD 03 61                call    GETMEMPOINTERADDR       ; This is where we are going to store our memory area address
    6646   00:6228                          ; GETSLT and GETMEMPOINTER do not change DE, so it still has the our memory area address
    6647   00:6228  11 02 00                ld  de,2
    6648   00:622B  19                      add hl,de
    6649   00:622C  7E                      ld  a,(hl)
    6650   00:622D  E6 01                   and ESPFLAG_ESP32               ; NZ only if ESP32
    6651   00:622F  FD E1                   pop iy
    6652   00:6231  DD E1                   pop ix
    6653   00:6233  E1                      pop hl
    6654   00:6234  C1                      pop bc
    6655   00:6235  D1                      pop de
    6656   00:6236  C9                      ret
    6657   00:6237                      
    6658   00:6237                      ;--- Return our ESP flags byte (work area offset 7)
    6659   00:6237                      ;    Input:  none
    6660   00:6237                      ;    Output: A = flags
    6661   00:6237                      ;    Modifies: AF
    6662   00:6237                      
    6663   00:6237                      GETESPFLAGS:
    6664   00:6237  C5                      push    bc
    6665   00:6238  D5                      push    de
    6666   00:6239  E5                      push    hl
    6667   00:623A  CD 96 60                call    GETSLT
    6668   00:623D  CD 03 61                call    GETMEMPOINTERADDR
    6669   00:6240  11 02 00                ld  de,2
    6670   00:6243  19                      add hl,de                       ; Our flags byte
    6671   00:6244  7E                      ld  a,(hl)
    6672   00:6245  E1                      pop hl
    6673   00:6246  D1                      pop de
    6674   00:6247  C1                      pop bc
    6675   00:6248  C9                      ret
    6676   00:6249                      
    6677   00:6249                      ;--- Obtain if DNS is ready saved in high memory
    6678   00:6249                      ;    Input:  none
    6679   00:6249                      ;    Output: A = DNS ready value
    6680   00:6249                      ;    Modifies: AF
    6681   00:6249                      
    6682   00:6249                      GETDNSREADY:
    6683   00:6249  C5                      push    bc
    6684   00:624A  D5                      push    de
    6685   00:624B  E5                      push    hl
    6686   00:624C  CD 96 60                call    GETSLT
    6687   00:624F                          ; Slot in A, now get the address
    6688   00:624F  CD 1F 61                call    GETMEMPOINTER
    6689   00:6252                          ; HL has the address of our memory area, DNS ready is 8 bytes after start
    6690   00:6252  11 08 00                ld  de,MEMORY_DNS_READY_OFFSET
    6691   00:6255  19                      add hl,de
    6692   00:6256                          ; Ok, get it
    6693   00:6256  7E                      ld  a,(hl)
    6694   00:6257  E1                      pop hl
    6695   00:6258  D1                      pop de
    6696   00:6259  C1                      pop bc
    6697   00:625A  C9                      ret
    6698   00:625B                      
    6699   00:625B                      ;--- Set DNS redy in high memory
    6700   00:625B                      ;    Input:  A = new value
    6701   00:625B                      ;    Output: none
    6702   00:625B                      ;    Modifies: AF
    6703   00:625B                      
    6704   00:625B                      SETDNSREADY:
    6705   00:625B  C5                      push    bc
    6706   00:625C  D5                      push    de
    6707   00:625D  E5                      push    hl
    6708   00:625E  F5                      push    af                      ; Save parameter
    6709   00:625F  CD 96 60                call    GETSLT
    6710   00:6262                          ; Slot in A, now get the address
    6711   00:6262  CD 1F 61                call    GETMEMPOINTER
    6712   00:6265                          ; HL has the address of our memory area, DNS ready is 8 bytes after start
    6713   00:6265  11 08 00                ld  de,MEMORY_DNS_READY_OFFSET
    6714   00:6268  19                      add hl,de
    6715   00:6269                          ; HL has the address of DNS ready
    6716   00:6269  F1                      pop af                          ; Restore parameter
    6717   00:626A  77                      ld  (hl),a
    6718   00:626B  E1                      pop hl
    6719   00:626C  D1                      pop de
    6720   00:626D  C1                      pop bc
    6721   00:626E  C9                      ret
    6722   00:626F                      
    6723   00:626F                      ;--- Obtain DNS result saved in high memory
    6724   00:626F                      ;    Input:  none
    6725   00:626F                      ;    Output: HL DE = DNS result
    6726   00:626F                      ;    Modifies: AF
    6727   00:626F                      
    6728   00:626F                      GETDNSRESULT:
    6729   00:626F  C5                      push    bc
    6730   00:6270  CD 96 60                call    GETSLT
    6731   00:6273                          ; Slot in A, now get the address
    6732   00:6273  CD 1F 61                call    GETMEMPOINTER
    6733   00:6276                          ; HL has the address of our memory area, DNS result is 9 bytes after start
    6734   00:6276  11 09 00                ld  de,MEMORY_DNS_RES_OFFSET
    6735   00:6279  19                      add hl,de
    6736   00:627A                          ; Ok, get it, first bytes are hl
    6737   00:627A  5E                      ld  e,(hl)
    6738   00:627B  23                      inc hl
    6739   00:627C  56                      ld  d,(hl)
    6740   00:627D  D5                      push    de                      ; for now, save in stack, so we can restore to HL later
    6741   00:627E  23                      inc hl
    6742   00:627F  5E                      ld  e,(hl)
    6743   00:6280  23                      inc hl
    6744   00:6281  56                      ld  d,(hl)
    6745   00:6282  E1                      pop hl                          ; and now restore HL value from stack
    6746   00:6283  C1                      pop bc
    6747   00:6284  C9                      ret
    6748   00:6285                      
    6749   00:6285                      ;--- Set DNS result in high memory
    6750   00:6285                      ;    Input:  HL DE = new value
    6751   00:6285                      ;    Output: none
    6752   00:6285                      ;    Modifies: AF
    6753   00:6285                      
    6754   00:6285                      SETDNSRESULT:
    6755   00:6285  C5                      push    bc
    6756   00:6286  D5                      push    de
    6757   00:6287  E5                      push    hl
    6758   00:6288  CD 96 60                call    GETSLT
    6759   00:628B                          ; Slot in A, now get the address
    6760   00:628B  CD 1F 61                call    GETMEMPOINTER
    6761   00:628E                          ; HL has the address of our memory area, DNS result is 9 bytes after start
    6762   00:628E  11 09 00                ld  de,MEMORY_DNS_RES_OFFSET
    6763   00:6291  19                      add hl,de
    6764   00:6292                          ; HL has the address of DNS result
    6765   00:6292  C1                      pop bc                          ; Restore parameter HL in BC
    6766   00:6293  71                      ld  (hl),c
    6767   00:6294  23                      inc hl
    6768   00:6295  70                      ld  (hl),b
    6769   00:6296  D1                      pop de                          ; Restore parameter DE in DE
    6770   00:6297  23                      inc hl
    6771   00:6298  73                      ld  (hl),e
    6772   00:6299  23                      inc hl
    6773   00:629A  72                      ld  (hl),d
    6774   00:629B  69                      ld  l,c
    6775   00:629C  60                      ld  h,b                         ; And HL is restored
    6776   00:629D  C1                      pop bc                          ; Restore BC
    6777   00:629E  C9                      ret
    6778   00:629F                      
    6779   00:629F                      ;--- Convert a character to upper-case if it is a lower-case letter
    6780   00:629F                      TOUPPER:
    6781   00:629F  FE 61                   cp  "a"
    6782   00:62A1  D8                      ret c
    6783   00:62A2  FE 7B                   cp  "z"+1
    6784   00:62A4  D0                      ret nc
    6785   00:62A5  E6 DF                   and #DF
    6786   00:62A7  C9                      ret
    6787   00:62A8                      
    6788   00:62A8                      ;*********************************************
    6789   00:62A8                      ;***       WAIT_RESPONSE_FROM_ESP          ***
    6790   00:62A8                      ;*** Will wait ESP to send a response,     ***
    6791   00:62A8                      ;*** discarding all data until it is found.***
    6792   00:62A8                      ;***                                       ***
    6793   00:62A8                      ;*** Inputs:                               ***
    6794   00:62A8                      ;*** HL - Expected response string         ***
    6795   00:62A8                      ;*** A - Response Size                     ***
    6796   00:62A8                      ;*** DE - TimeOut in ticks                 ***
    6797   00:62A8                      ;***                                       ***
    6798   00:62A8                      ;*** Output:                               ***
    6799   00:62A8                      ;*** A - 0 if response received            ***
    6800   00:62A8                      ;*** otherwise response not received and   ***
    6801   00:62A8                      ;*** timed-out.                            ***
    6802   00:62A8                      ;***                                       ***
    6803   00:62A8                      ;*** Changes HL, BC, AF, DE, IX            ***
    6804   00:62A8                      ;*********************************************
    6805   00:62A8                      WRFE_WAIT_DATA:
    6806   00:62A8                          LOAD_STS_PORT_IN_A
    6806   00:62A8  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6807   00:62AB  CB 6F                   bit 5,a                         ; If nz Port #07 is not available
    6808   00:62AD  20 06                   jr  nz,WRFE_STS_NOT_AVAILABLE
    6809   00:62AF  CB 47                   bit 0,a                         ; if nz has data
    6810   00:62B1  C0                      ret nz
    6811   00:62B2  1B                      dec de
    6812   00:62B3  76                      halt
    6813   00:62B4  C9                      ret
    6814   00:62B5                      WRFE_STS_NOT_AVAILABLE:
    6815   00:62B5  11 00 00                ld  de,0
    6816   00:62B8  AF                      xor a
    6817   00:62B9  C9                      ret
    6818   00:62BA                      
    6819   00:62BA                      WRFE_COMPARE:
    6820   00:62BA  47                      ld  b,a
    6821   00:62BB  7E                      ld  a,(hl)
    6822   00:62BC  B8                      cp  b
    6823   00:62BD  C0                      ret nz
    6824   00:62BE  23                      inc hl
    6825   00:62BF  C9                      ret
    6826   00:62C0                      
    6827   00:62C0                      WAIT_RESPONSE_FROM_ESP:
    6828   00:62C0  4F                      ld  c,a                         ; Response size in C
    6829   00:62C1  E5                      push    hl                      ; Save HL
    6830   00:62C2  AF                      xor a
    6831   00:62C3                      WRFE_ST1:
    6832   00:62C3  DD 67                   ld  ixh,a                       ; We start at index 0
    6833   00:62C5                      
    6834   00:62C5                      WRFE_LOOP:
    6835   00:62C5  CD A8 62                call    WRFE_WAIT_DATA
    6836   00:62C8  20 07                   jr  nz,WRFE_LOOP.1
    6837   00:62CA  7B                      ld  a,e
    6838   00:62CB  B2                      or  d
    6839   00:62CC  CA EC 62                jp  z,WRFE_RET_ERROR
    6840   00:62CF  18 F4                   jr  WRFE_LOOP
    6841   00:62D1                      WRFE_LOOP.1:
    6842   00:62D1                          ; nz, check the data
    6843   00:62D1                          RECEIVE_DATA
    6843   00:62D1  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6844   00:62D4                          ; Ok, now the byte is in A, let's compare
    6845   00:62D4                      WRFE_IDXCMD:
    6846   00:62D4  CD BA 62                call WRFE_COMPARE
    6847   00:62D7                          ; if match
    6848   00:62D7  28 07                   jr  z,WRFE_RSP_MATCH
    6849   00:62D9                          ; did not match, let's zero the rsp index
    6850   00:62D9  AF                      xor a
    6851   00:62DA  DD 67                   ld  ixh,a                       ; re-start at index 0
    6852   00:62DC  E1                      pop hl                          ; restore the response index
    6853   00:62DD  E5                      push    hl                      ; and keep it in stack
    6854   00:62DE                          ; back to get another byte
    6855   00:62DE  18 E5                   jr  WRFE_LOOP
    6856   00:62E0                      WRFE_RSP_MATCH:
    6857   00:62E0                          ; match
    6858   00:62E0  DD 24                   inc ixh
    6859   00:62E2  DD 7C                   ld  a,ixh
    6860   00:62E4  B9                      cp  c
    6861   00:62E5                          ; if a = c done and response is success
    6862   00:62E5  28 02                   jr  z,WRFE_RET_OK
    6863   00:62E7                          ; not done, back to get more bytes
    6864   00:62E7  18 DC                   jr  WRFE_LOOP
    6865   00:62E9                      WRFE_RET_OK:
    6866   00:62E9  E1                      pop hl
    6867   00:62EA  AF                      xor a
    6868   00:62EB  C9                      ret
    6869   00:62EC                      WRFE_RET_ERROR:
    6870   00:62EC  E1                      pop hl
    6871   00:62ED  3E 01                   ld  a,1
    6872   00:62EF  C9                      ret
    6873   00:62F0                      
    6874   00:62F0                      ;*********************************************
    6875   00:62F0                      ;***            CHECK_ESP_TYPE             ***
    6876   00:62F0                      ;*** Always flags the SSH check as done.   ***
    6877   00:62F0                      ;*** If ESP32, flags it and probes if SSH  ***
    6878   00:62F0                      ;*** commands are supported.               ***
    6879   00:62F0                      ;*** If ESP32, NZ will be set and A = 1, if***
    6880   00:62F0                      ;*** not NZ will be reset and A=0          ***
    6881   00:62F0                      ;*********************************************
    6882   00:62F0                      CHECK_ESP_TYPE:
    6883   00:62F0  E5                      push    hl
    6884   00:62F1  D5                      push    de
    6885   00:62F2  FD E5                   push    iy
    6886   00:62F4  DD E5                   push    ix
    6887   00:62F6                          CLEAR_UART                      ; Clear UART
    6887   00:62F6  3E 14             >     ld  a,20
    6887   00:62F8  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    6888   00:62FB  3E 62                   ld  a,CMD_GET_FW_TYPE
    6889   00:62FD                          SEND_DATA
    6889   00:62FD  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6890   00:6300  21 06 00                ld  hl,6                        ; Wait up to 100ms
    6891   00:6303  ED 5B 76 F6             ld  de,(TXTTAB)                 ; Borrow Basic program area for now....
    6892   00:6307  DD 6B                   ld  ixl,e
    6893   00:6309  DD 62                   ld  ixh,d                       ; Address in IX
    6894   00:630B  CD 75 4B                call    WAIT_MENU_CMD_RESPONSE
    6895   00:630E  F5                      push    af                      ; Keep result (1 = ESP32, 0 = not)
    6896   00:630F  CD 96 60                call    GETSLT
    6897   00:6312  CD 03 61                call    GETMEMPOINTERADDR       ; This is where we are going to store our memory area address
    6898   00:6315  11 02 00                ld  de,2
    6899   00:6318  19                      add hl,de                       ; HL = our flags byte
    6900   00:6319  F1                      pop af
    6901   00:631A  28 0A                   jr  z,CHECK_ESP_TYPE_NO32
    6902   00:631C                          ; ESP32 found: probed + ESP32, then check SSH support
    6903   00:631C  36 81                   ld  (hl),ESPFLAG_SSH_PROBED+ESPFLAG_ESP32
    6904   00:631E  CD 30 63                call    PROBE_ESP_SSH           ; Sets/clears ESPFLAG_SSH
    6905   00:6321  3E 01                   ld  a,1
    6906   00:6323  B7                      or  a                           ; NZ = ESP32, as before
    6907   00:6324  18 03                   jr  CHECK_ESP_TYPE_END
    6908   00:6326                      CHECK_ESP_TYPE_NO32:
    6909   00:6326                          ; No ESP32 means no SSH support either, and SSH was probed
    6910   00:6326  36 80                   ld  (hl),ESPFLAG_SSH_PROBED
    6911   00:6328  AF                      xor a                           ; Z = not ESP32, as before
    6912   00:6329                      CHECK_ESP_TYPE_END:
    6913   00:6329  DD E1                   pop ix
    6914   00:632B  FD E1                   pop iy
    6915   00:632D  D1                      pop de
    6916   00:632E  E1                      pop hl
    6917   00:632F  C9                      ret
    6918   00:6330                      
    6919   00:6330                      ;*********************************************
    6920   00:6330                      ;***             PROBE_ESP_SSH             ***
    6921   00:6330                      ;*** Sends an SSH GET_CAPAB request for    ***
    6922   00:6330                      ;*** block 1 (81h 00h 01h 01h) and accepts ***
    6923   00:6330                      ;*** 81h 00h or 81h 04h as SSH support.    ***
    6924   00:6330                      ;*** Sets/clears ESPFLAG_SSH and marks the ***
    6925   00:6330                      ;*** check as done. Called from boot only. ***
    6926   00:6330                      ;*** Output: NZ if SSH is supported        ***
    6927   00:6330                      ;*********************************************
    6928   00:6330                      PROBE_ESP_SSH:
    6929   00:6330  C5                      push    bc
    6930   00:6331  D5                      push    de
    6931   00:6332  E5                      push    hl
    6932   00:6333  CD 96 60                call    GETSLT
    6933   00:6336  CD 03 61                call    GETMEMPOINTERADDR
    6934   00:6339  11 02 00                ld  de,2
    6935   00:633C  19                      add hl,de                       ; Our flags byte
    6936   00:633D  E5                      push    hl                      ; Keep its address
    6937   00:633E  CB FE                   set 7,(hl)                      ; SSH check is done
    6938   00:6340  CB 8E                   res 1,(hl)                      ; Assume SSH is not supported
    6939   00:6342                          CLEAR_UART                      ; Clear UART
    6939   00:6342  3E 14             >     ld  a,20
    6939   00:6344  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    6940   00:6347  3E 81                   ld  a,#81                       ; SSH GET_CAPAB command
    6941   00:6349                          SEND_DATA
    6941   00:6349  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6942   00:634C  AF                      xor a
    6943   00:634D                          SEND_DATA                       ; Command size MSB
    6943   00:634D  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6944   00:6350  3C                      inc a
    6945   00:6351                          SEND_DATA                       ; Command size LSB
    6945   00:6351  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6946   00:6354                          SEND_DATA                       ; Block index (1)
    6946   00:6354  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6947   00:6357  21 02 00                ld  hl,2                        ; Wait up to 2 frames
    6948   00:635A                      PROBE_ESP_SSH_ST1:
    6949   00:635A                          CHECK_DATA
    6949   00:635A  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6949   00:635D  CB 47             >     bit 0,a
    6950   00:635F  20 07                   jr  nz,PROBE_ESP_SSH_ST1.1
    6951   00:6361  CD 97 4C                call    HLTIMEOUT
    6952   00:6364  20 F4                   jr  nz,PROBE_ESP_SSH_ST1
    6953   00:6366  18 23                   jr  PROBE_ESP_SSH_END           ; Time-out, not supported
    6954   00:6368                      PROBE_ESP_SSH_ST1.1:
    6955   00:6368                          RECEIVE_DATA
    6955   00:6368  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6956   00:636B  FE 81                   cp  #81                         ; Is response of our command?
    6957   00:636D  20 EB                   jr  nz,PROBE_ESP_SSH_ST1
    6958   00:636F                      PROBE_ESP_SSH_ST2:
    6959   00:636F                          CHECK_DATA
    6959   00:636F  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6959   00:6372  CB 47             >     bit 0,a
    6960   00:6374  20 07                   jr  nz,PROBE_ESP_SSH_ST2.1
    6961   00:6376  CD 97 4C                call    HLTIMEOUT
    6962   00:6379  20 F4                   jr  nz,PROBE_ESP_SSH_ST2
    6963   00:637B  18 0E                   jr  PROBE_ESP_SSH_END           ; Time-out, not supported
    6964   00:637D                      PROBE_ESP_SSH_ST2.1:
    6965   00:637D                          RECEIVE_DATA
    6965   00:637D  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6966   00:6380  B7                      or  a                           ; Error code 0?
    6967   00:6381  28 04                   jr  z,PROBE_ESP_SSH_OK
    6968   00:6383  FE 04                   cp  4                           ; Error code 4?
    6969   00:6385  20 04                   jr  nz,PROBE_ESP_SSH_END        ; Anything else, not supported
    6970   00:6387                      PROBE_ESP_SSH_OK:
    6971   00:6387  E1                      pop hl
    6972   00:6388  CB CE                   set 1,(hl)                      ; SSH is supported
    6973   00:638A  E5                      push    hl
    6974   00:638B                      PROBE_ESP_SSH_END:
    6975   00:638B                          CLEAR_UART                      ; Consume/discard remaining response
    6975   00:638B  3E 14             >     ld  a,20
    6975   00:638D  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    6976   00:6390  E1                      pop hl
    6977   00:6391  7E                      ld  a,(hl)
    6978   00:6392  E6 02                   and ESPFLAG_SSH
    6979   00:6394  E1                      pop hl
    6980   00:6395  D1                      pop de
    6981   00:6396  C1                      pop bc
    6982   00:6397  C9                      ret
    6983   00:6398                      
    6984   00:6398                      ;*********************************************
    6985   00:6398                      ;***         PRINT_INSTALLED_MSG           ***
    6986   00:6398                      ;*** ESP8266: prints installed message.    ***
    6987   00:6398                      ;*** ESP32: uses the 'b' (Get Board)       ***
    6988   00:6398                      ;*** command to print the board ID.        ***
    6989   00:6398                      ;*********************************************
    6990   00:6398                      PRINT_INSTALLED_MSG:
    6991   00:6398  C5                      push    bc
    6992   00:6399  D5                      push    de
    6993   00:639A  FD E5                   push    iy
    6994   00:639C  DD E5                   push    ix
    6995   00:639E  CD 1B 62                call    GETESPTYPE
    6996   00:63A1  28 48                   jr  z,PRINT_INST_8266           ; Not an ESP32, no need to ask
    6997   00:63A3                          ; ESP32, let's get the board identification string
    6998   00:63A3                          CLEAR_UART                      ; Clear UART
    6998   00:63A3  3E 14             >     ld  a,20
    6998   00:63A5  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    6999   00:63A8  3E 62                   ld  a,CMD_GET_FW_TYPE           ; 'b' Get Board, ESP32 only
    7000   00:63AA                          SEND_DATA
    7000   00:63AA  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    7001   00:63AD  21 06 00                ld  hl,6                        ; Wait up to 100ms
    7002   00:63B0  ED 5B 76 F6             ld  de,(TXTTAB)                 ; Borrow Basic program area for now....
    7003   00:63B4  DD 6B                   ld  ixl,e
    7004   00:63B6  DD 62                   ld  ixh,d                       ; Address in IX
    7005   00:63B8  CD 75 4B                call    WAIT_MENU_CMD_RESPONSE
    7006   00:63BB  28 26                   jr  z,PRINT_INST_32             ; No answer, just tell it is an ESP32
    7007   00:63BD                          ; Response size is in BC, board ID copied at (TXTTAB)
    7008   00:63BD  78                      ld  a,b
    7009   00:63BE  B7                      or  a                           ; Size above 255?
    7010   00:63BF  20 22                   jr  nz,PRINT_INST_32            ; Then just tell it is an ESP32
    7011   00:63C1  79                      ld  a,c
    7012   00:63C2  B7                      or  a                           ; Size zero?
    7013   00:63C3  28 1E                   jr  z,PRINT_INST_32             ; Then just tell it is an ESP32
    7014   00:63C5  FE 18                   cp  24                          ; More than 23 chars?
    7015   00:63C7  30 1A                   jr  nc,PRINT_INST_32            ; Then just tell it is an ESP32
    7016   00:63C9  2A 76 F6                ld  hl,(TXTTAB)
    7017   00:63CC  09                      add hl,bc
    7018   00:63CD  36 00                   ld  (hl),0                      ; Ensure the string is terminated
    7019   00:63CF  21 DC 71                ld  hl,OK_INST_PRE              ; "Installed "
    7020   00:63D2  CD 9D 4C                call    PRINTHL
    7021   00:63D5  2A 76 F6                ld  hl,(TXTTAB)
    7022   00:63D8  CD 9D 4C                call    PRINTHL                 ; Board identification string
    7023   00:63DB  21 E7 71                ld  hl,OK_INST_SUF              ; " successfully!"
    7024   00:63DE  CD 9D 4C                call    PRINTHL
    7025   00:63E1  18 0E                   jr  PRINT_INST_END
    7026   00:63E3                      PRINT_INST_32:
    7027   00:63E3  21 BB 71                ld  hl,OK_ESP32                 ; Installed ESP32 successfully!
    7028   00:63E6  CD 9D 4C                call    PRINTHL
    7029   00:63E9  18 06                   jr  PRINT_INST_END
    7030   00:63EB                      PRINT_INST_8266:
    7031   00:63EB  21 98 71                ld  hl,OK_ESP8266               ; Installed ESP8266 successfully!
    7032   00:63EE  CD 9D 4C                call    PRINTHL
    7033   00:63F1                      PRINT_INST_END:
    7034   00:63F1  DD E1                   pop ix
    7035   00:63F3  FD E1                   pop iy
    7036   00:63F5  D1                      pop de
    7037   00:63F6  C1                      pop bc
    7038   00:63F7  C9                      ret
    7039   00:63F8                      
    7040   00:63F8                      ;*********************************************
    7041   00:63F8                      ;***              RESET ESP                ***
    7042   00:63F8                      ;*** If RESET ok, A will be 0, otherwise   ***
    7043   00:63F8                      ;*** failure                               ***
    7044   00:63F8                      ;*********************************************
    7045   00:63F8                      RESET_ESP:
    7046   00:63F8                          ; Is ESP installed?
    7047   00:63F8                          CLEAR_UART                      ; Clear UART
    7047   00:63F8  3E 14             >     ld  a,20
    7047   00:63FA  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    7048   00:63FD  3E 3F                   ld  a,CMD_QUERY_ESP
    7049   00:63FF                          SEND_DATA
    7049   00:63FF  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    7050   00:6402  21 97 65                ld  hl,RSP_CMD_QUERY_ESP        ; Expected response
    7051   00:6405  11 3C 00                ld  de,60                       ; Up to 1s @ 60Hz
    7052   00:6408  3E 02                   ld  a,RSP_CMD_QUERY_ESP_SIZE    ; Size of response
    7053   00:640A  CD C0 62                call    WAIT_RESPONSE_FROM_ESP
    7054   00:640D  B7                      or  a
    7055   00:640E  3E 01                   ld  a,1
    7056   00:6410  28 03                   jr  z,RESET_ESP_INIT            ; ESP Found
    7057   00:6412  06 00                   ld  b,0                         ; 0 if no response
    7058   00:6414  C9                      ret
    7059   00:6415                      RESET_ESP_INIT:
    7060   00:6415  06 03                   ld  b,3                         ; Retry up to 10 times
    7061   00:6417                      RESET_ESP_LOOP:
    7062   00:6417                          CLEAR_UART
    7062   00:6417  3E 14             >     ld  a,20
    7062   00:6419  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    7063   00:641C                          SET_SPEED
    7063   00:641C  AF                >     xor a
    7063   00:641D  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    7064   00:6420  76                      halt
    7065   00:6421  76                      halt                            ; Wait a little to make sure speed is adjusted
    7066   00:6422  3E 57                   ld  a,CMD_WRESET_ESP
    7067   00:6424                          SEND_DATA
    7067   00:6424  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    7068   00:6427  21 92 65                ld  hl,RSP_CMD_RESET_ESP        ; Expected response
    7069   00:642A  11 5A 00                ld  de,90                       ; Up to 1.5s @ 60Hz
    7070   00:642D  3E 05                   ld  a,RSP_CMD_RESET_ESP_SIZE    ; Size of response
    7071   00:642F  C5                      push    bc                      ; Save retry counter
    7072   00:6430  CD C0 62                call    WAIT_RESPONSE_FROM_ESP
    7073   00:6433  C1                      pop bc                          ; restore retry counter
    7074   00:6434  B7                      or  a                           ; Did WAIT RESPONSE return zero?
    7075   00:6435  C8                      ret z                           ; Yes, Warm Reset Ok
    7076   00:6436  10 DF                   djnz RESET_ESP_LOOP             ; No, decrement retry counter and let the loop check
    7077   00:6438                          ; No more retries? Then check if it is old ESP FW
    7078   00:6438                      RESET_CHK_IF_INSTALLED:
    7079   00:6438                          ; No more retries? Then it is old ESP FW
    7080   00:6438  06 01                   ld  b,1
    7081   00:643A  C9                      ret
    7082   00:643B                      
    7083   00:643B                      ;*********************************************
    7084   00:643B                      ;***              SET TIME                 ***
    7085   00:643B                      ;*** H - Hour                              ***
    7086   00:643B                      ;*** L - Minutes                           ***
    7087   00:643B                      ;*** D - Seconds                           ***
    7088   00:643B                      ;***                                       ***
    7089   00:643B                      ;*** A - 0 if Ok otherwise invalid time    ***
    7090   00:643B                      ;*********************************************
    7091   00:643B                      SET_TIME:
    7092   00:643B  7C                      ld  a,h                         ; Hour in A
    7093   00:643C  FE 18                   cp  24                          ; Compare to 24
    7094   00:643E  30 12                   jr  nc,SET_TIME_ERR             ; If 24 or more, invalid
    7095   00:6440  7D                      ld  a,l                         ; Minutes in A
    7096   00:6441  FE 3C                   cp  60                          ; Compare to 60
    7097   00:6443  30 0D                   jr  nc,SET_TIME_ERR             ; If 60 or more, invalid
    7098   00:6445  7A                      LD  a,d                         ; Seconds in D
    7099   00:6446  FE 3C                   cp  60                          ; Compare to 60
    7100   00:6448  30 08                   jr  nc,SET_TIME_ERR             ; If 60 or more invalid
    7101   00:644A  44                      ld  b,h                         ; Hour in B
    7102   00:644B  4D                      ld  c,l                         ; Minutes in C
    7103   00:644C  5A                      ld  e,d                         ; Seconds in E
    7104   00:644D  CD 55 64                call    SET_RTC_TIME            ; Set time in RTC
    7105   00:6450  AF                      xor a                           ; 0 in A
    7106   00:6451  C9                      ret                             ; Return
    7107   00:6452                      ;   Invalid parameter
    7108   00:6452                      SET_TIME_ERR:
    7109   00:6452  3E 01                   ld  a,1                         ; Invalid Time
    7110   00:6454  C9                      ret                             ; Return
    7111   00:6455                      
    7112   00:6455                      SET_RTC_TIME:
    7113   00:6455  6B                      ld  l,e                         ; Seconds in L
    7114   00:6456  61                      ld  h,c                         ; Minutes in H
    7115   00:6457  50                      ld  d,b                         ; Hour in D
    7116   00:6458  CD B0 64                call    STOP_RTC_COUNT_SET_MODE0; Select RTC Register 13, and set Mode / Page 0
    7117   00:645B  3E 0F                   ld  a,#F                        ; Register F
    7118   00:645D  D3 B4                   out (#B4),a
    7119   00:645F  3E 02                   ld  a,2
    7120   00:6461  D3 B5                   out (#B5),a                     ; Timer reset seconds and on both clock pulses
    7121   00:6463  1E 00                   ld  e,0                         ; Start at register 0
    7122   00:6465  C3 EB 64                jp  SET_RTC_DATE.1              ; And save L, H and D, function will return from there
    7123   00:6468                      
    7124   00:6468                      ;*********************************************
    7125   00:6468                      ;***              SET DATE                 ***
    7126   00:6468                      ;*** HL - Year from 1980 to 2079           ***
    7127   00:6468                      ;*** D - Month from 1 to 12                ***
    7128   00:6468                      ;*** E - Day from 1 to 31                  ***
    7129   00:6468                      ;***                                       ***
    7130   00:6468                      ;*** A - 0 if Ok otherwise invalid Date    ***
    7131   00:6468                      ;*********************************************
    7132   00:6468                      SET_DATE:
    7133   00:6468  01 44 F8                ld  bc,#F844
    7134   00:646B  09                      add hl,bc
    7135   00:646C  30 32                   jr  nc,SET_DATE_ERR             ; No carry -> Year is less than 1980, invalid date
    7136   00:646E  7C                      ld  a,h
    7137   00:646F  B7                      or  a
    7138   00:6470  20 2E                   jr  nz,SET_DATE_ERR             ; If H is set, means year is greater than 2235 ,invalid
    7139   00:6472  7D                      ld  a,l
    7140   00:6473  FE 64                   cp  100
    7141   00:6475  30 29                   jr  nc,SET_DATE_ERR             ; If L >= 100 year is greater than 2079, invalid
    7142   00:6477  47                      ld  b,a                         ; Year - 1980 in B
    7143   00:6478  7A                      ld  a,d                         ; Now test month
    7144   00:6479  3D                      dec a
    7145   00:647A  FE 0C                   cp  12                          ; If 12 or less this should carry
    7146   00:647C  30 22                   jr  nc,SET_DATE_ERR             ; otherwise invalid
    7147   00:647E  21 A3 64                ld  hl,DAYS_IN_MONTH            ; Days in Month table
    7148   00:6481  85                      add a,l                         ; add our month
    7149   00:6482  6F                      ld  l,a                         ; back in L
    7150   00:6483  30 01                   jr  nc,SET_DATE1                ; no carry done
    7151   00:6485  24                      inc h                           ; otherwise increase H
    7152   00:6486                      SET_DATE1:
    7153   00:6486  3E 1C                   ld  a,28                        ; 28 days
    7154   00:6488  BE                      cp  (hl)                        ; If month is 28 days, February, need to check if leap and limit is 29 in this year
    7155   00:6489  20 08                   jr  nz,SET_DATE2                ; if not, skip below code , so probably above check is if month is february
    7156   00:648B  78                      ld  a,b                         ; Year - 1980 in A again
    7157   00:648C  E6 03                   and 3                           ; if other than 0, non divisible per 4, so not a leap year
    7158   00:648E  20 03                   jr  nz,SET_DATE2                ; Regular year
    7159   00:6490  21 AF 64                ld  hl,DAYS_IN_FEBRUARY_LEAP    ; HL has address of 29 days, maximum number of days for february in leap year
    7160   00:6493                      SET_DATE2:
    7161   00:6493  7B                      ld  a,e                         ; Day of month in A
    7162   00:6494  3D                      dec a                           ; Decrement
    7163   00:6495  BE                      cp  (hl)                        ; Compare with Days in month
    7164   00:6496  30 08                   jr  nc,SET_DATE_ERR             ; If day is greater than how many days in month, invalid
    7165   00:6498  6B                      ld  l,e                         ; Day of month in L
    7166   00:6499  62                      ld  h,d                         ; Month in H
    7167   00:649A  50                      ld  d,b                         ; Year - 1980 in D
    7168   00:649B  CD D5 64                call    SET_RTC_DATE            ; Set date in RTC
    7169   00:649E  AF                      xor a                           ; A = 0
    7170   00:649F  C9                      ret                             ; Success
    7171   00:64A0                      ;   Invalid parameter
    7172   00:64A0                      SET_DATE_ERR:
    7173   00:64A0  3E 01                   ld  a,1
    7174   00:64A2  C9                      ret
    7175   00:64A3                      
    7176   00:64A3                      ; Table of top day value for each month
    7177   00:64A3                      DAYS_IN_MONTH:          db  31,28,31,30,31,30,31,31,30,31,30,31
    7177   00:64A3  1F 1C 1F 1E 1F 1E 1F 1F 1E 1F 1E 1F 
    7178   00:64AF                      ; And top day value in February when Leap Year
    7179   00:64AF  1D                  DAYS_IN_FEBRUARY_LEAP:  db  29
    7180   00:64B0                      
    7181   00:64B0                      ; Will select Mode 00 (Date and Time page) and stop clock counting
    7182   00:64B0                      ; Register D value will be left in A
    7183   00:64B0                      STOP_RTC_COUNT_SET_MODE0:
    7184   00:64B0  3E 0D                   ld  a,#D
    7185   00:64B2  D3 B4                   out (#B4),a                     ; Select RTC register D (mode)
    7186   00:64B4  DB B5                   in  a,(#B5)                     ; read register D
    7187   00:64B6  E6 04                   and 4                           ; Save Alarm EN setting, and mode register is 00 and stop counting time
    7188   00:64B8  D3 B5                   out (#B5),a                     ; And save
    7189   00:64BA  C9                      ret
    7190   00:64BB                      
    7191   00:64BB                      ; Will get a non BCD value in A, convert it to BCD and then save it in
    7192   00:64BB                      ; a register pair that starts in the register indicated in E
    7193   00:64BB                      ; Register E will have the next register after that register pair
    7194   00:64BB                      RTC_SAVE_REGISTERPAIR:
    7195   00:64BB  4F                      ld  c,a                         ; Save A in C
    7196   00:64BC  AF                      xor a                           ; 0 in A
    7197   00:64BD  06 08                   ld  b,8                         ; 8 in B, number of bits for conversion
    7198   00:64BF                      RTC_SAVE_REGISTERPAIR.1:
    7199   00:64BF  CB 01                   rlc c                           ; Leftmost bit in Carry
    7200   00:64C1  8F                      adc a,a                         ; A = (A * 2) + Carry
    7201   00:64C2  27                      daa                             ; decimal adjust A, shift = BCD x 2 + carry
    7202   00:64C3  10 FA                   djnz    RTC_SAVE_REGISTERPAIR.1 ; Repeat for 8 bits
    7203   00:64C5  CD CC 64                call    SET_RTC_REG             ; Save LSB in register and increase register address
    7204   00:64C8  0F                      rrca
    7205   00:64C9  0F                      rrca
    7206   00:64CA  0F                      rrca
    7207   00:64CB  0F                      rrca                            ; now MSB is in LSB position
    7208   00:64CC                      SET_RTC_REG:
    7209   00:64CC  47                      ld  b,a                         ; save value to set in B
    7210   00:64CD  7B                      ld  a,e                         ; and now register address in A
    7211   00:64CE  D3 B4                   out (#B4),a                     ; The register we want to set
    7212   00:64D0  78                      ld  a,b                         ; restore value
    7213   00:64D1  D3 B5                   out (#B5),a                     ; save it
    7214   00:64D3  1C                      inc e                           ; increase register address, as this usually is done in pairs
    7215   00:64D4  C9                      ret
    7216   00:64D5                      
    7217   00:64D5                      ; Auxiliary function for SET_DATE and SET_TIME
    7218   00:64D5                      ; SET_RTC_DATE will save date, parameters:
    7219   00:64D5                      ; L - Day
    7220   00:64D5                      ; H - Month
    7221   00:64D5                      ; D - Years since 1980
    7222   00:64D5                      ; All values are regular values, this function will properly convert them
    7223   00:64D5                      ;
    7224   00:64D5                      ; SET_RTC_DATE.1 is used by SET_TIME as well
    7225   00:64D5                      ; It will save three register pairs, starting with the register in E
    7226   00:64D5                      ; First pair is updated with value in L
    7227   00:64D5                      ; Second pair is updated with value in H
    7228   00:64D5                      ; Third pair is updated with value in D
    7229   00:64D5                      SET_RTC_DATE:
    7230   00:64D5  CD B0 64                call    STOP_RTC_COUNT_SET_MODE0; Select RTC Register 13, and set Mode / Page 0
    7231   00:64D8  F6 01                   or  1                           ; Set Bit 0, so Mode / Page 1
    7232   00:64DA  D3 B5                   out (#B5),a                     ; save it in register 13, now page 1 selected
    7233   00:64DC  3E 0B                   ld  a,#B                        ; Leap Year Counter Register
    7234   00:64DE  D3 B4                   out (#B4),a                     ; Select it
    7235   00:64E0  7A                      ld  a,d                         ; Load Years in leap year counter
    7236   00:64E1  D3 B5                   out (#B5),a                     ; So it has count of leap years (0 is 1980, leap, and every time it is 4, leap year again)
    7237   00:64E3  CD B0 64                call    STOP_RTC_COUNT_SET_MODE0; Select RTC Register 13 and set mode / page 0
    7238   00:64E6  CD B0 64                call    STOP_RTC_COUNT_SET_MODE0; do it a second time... DOS does it, don't want to JYNX it :P
    7239   00:64E9  1E 07                   ld  e,7                         ; Register 7
    7240   00:64EB                      SET_RTC_DATE.1:
    7241   00:64EB  7D                      ld  a,l                         ; A has day
    7242   00:64EC  CD BB 64                call    RTC_SAVE_REGISTERPAIR   ; Will convert day to BCD and save in registers 7 and 8
    7243   00:64EF  7C                      ld  a,h                         ; A has month
    7244   00:64F0  CD BB 64                call    RTC_SAVE_REGISTERPAIR   ; Will convert month to BCD and save in register 9 and A
    7245   00:64F3  7A                      ld  a,d                         ; A has how many years since 1980
    7246   00:64F4  CD BB 64                call    RTC_SAVE_REGISTERPAIR   ; Will convert to BCD and save in register B and C
    7247   00:64F7  3E 0D                   ld  a,#D                        ; Register D
    7248   00:64F9  D3 B4                   out (#B4),a                     ; Send it
    7249   00:64FB  DB B5                   in  a,(#B5)                     ; Read its value
    7250   00:64FD  F6 08                   or  8                           ; Start counting time again
    7251   00:64FF  D3 B5                   out (#B5),a                     ; Send
    7252   00:6501  C9                      ret
    7253   00:6502                      
    7254   00:6502                      ; Pattern setup routine
    7255   00:6502                      PATTERN_SETUP:
    7256   00:6502  AF                      xor a                           ; Bit-16, V9938 and V9958 only
    7257   00:6503  21 88 00                ld  hl,#0088                    ; Bit-15 to 0, pattern base address = #0088
    7258   00:6506  CD 76 65                call SET_VDP_WRITE
    7259   00:6509  21 16 65                ld  hl,PATTERN_DATA             ; Point to hl
    7260   00:650C  06 60                   ld  b,8*12                      ; Redraw 12 chars, max 12 chars are suggested
    7261   00:650E  0E 98                   ld  c,#98                       ; port #98
    7262   00:6510                      OUTI_TO_VRAM_TMS9918:
    7263   00:6510  ED A3                   outi                            ; Slower than otir but useful on TMS9918 which requires 29 T-states
    7264   00:6512  C2 10 65                jp  nz,OUTI_TO_VRAM_TMS9918     ; Therefore, don't use 'djnz' here!
    7265   00:6515  C9                      ret
    7266   00:6516                      PATTERN_DATA:
    7267   00:6516                      ; Pattern-01 is CHR$(1)+CHR$(81) = SCAN_TERMINATOR_OPEN
    7268   00:6516  06                      db  %00000110
    7269   00:6517  09                      db  %00001001
    7270   00:6518  09                      db  %00001001
    7271   00:6519  FC                      db  %11111100                   ; "Opened Padlock"
    7272   00:651A  FC                      db  %11111100
    7273   00:651B  FC                      db  %11111100
    7274   00:651C  FC                      db  %11111100
    7275   00:651D  00                      db  %00000000
    7276   00:651E                      ; Pattern-02 is CHR$(1)+CHR$(82) = SCAN_TERMINATOR_ENC
    7277   00:651E  30                      db  %00110000
    7278   00:651F  48                      db  %01001000
    7279   00:6520  48                      db  %01001000
    7280   00:6521  FC                      db  %11111100                   ; "Closed Padlock"
    7281   00:6522  FC                      db  %11111100
    7282   00:6523  FC                      db  %11111100
    7283   00:6524  FC                      db  %11111100
    7284   00:6525  00                      db  %00000000
    7285   00:6526                      ; Pattern-03 is CHR$(1)+CHR$(83) = Wi-Fi Connected to the AP:
    7286   00:6526  00                      db  %00000000
    7287   00:6527  00                      db  %00000000
    7288   00:6528  70                      db  %01110000
    7289   00:6529  70                      db  %01110000                   ; "Full Access Point"
    7290   00:652A  70                      db  %01110000
    7291   00:652B  20                      db  %00100000
    7292   00:652C  20                      db  %00100000
    7293   00:652D  70                      db  %01110000
    7294   00:652E                      ; Pattern-04 is CHR$(1)+CHR$(84) = Wi-Fi Failed to connect to:
    7295   00:652E  00                      db  %00000000
    7296   00:652F  88                      db  %10001000
    7297   00:6530  50                      db  %01010000
    7298   00:6531  20                      db  %00100000                   ; "X"
    7299   00:6532  50                      db  %01010000
    7300   00:6533  88                      db  %10001000
    7301   00:6534  00                      db  %00000000
    7302   00:6535  00                      db  %00000000
    7303   00:6536                      ; Pattern-05 is CHR$(1)+CHR$(85) = Requesting connection to:
    7304   00:6536  00                      db  %00000000
    7305   00:6537  00                      db  %00000000
    7306   00:6538  50                      db  %01010000
    7307   00:6539  20                      db  %00100000                   ; "Partial Access Point"
    7308   00:653A  50                      db  %01010000
