    1124   00:45BC  78                      ld  a,b
    1125   00:45BD  FE 02                   cp  2                           ; If 2, scan is done and nothing found
    1126   00:45BF  CA 2B 48                jp  z,WIFI_SCAN_NONETWORKS
    1127   00:45C2  2E 1E                   ld  l,30
    1128   00:45C4                      WIFI_SCAN_WAITHS:
    1129   00:45C4  76                      halt
    1130   00:45C5  2D                      dec l
    1131   00:45C6  20 FC                   jr  nz,WIFI_SCAN_WAITHS
    1132   00:45C8  1B                      dec de
    1133   00:45C9  7B                      ld  a,e
    1134   00:45CA  B2                      or  d
    1135   00:45CB  CA 34 48                jp  z,WIFI_SCAN_TIMEOUT
    1136   00:45CE  C3 A9 45                jp  WIFI_SCAN_WAIT_END
    1137   00:45D1                      WIFI_SCAN_SHOW_LIST:
    1138   00:45D1  57                      ld  d,a                         ; Save access point counter here
    1139   00:45D2  1E 00                   ld  e,0                         ; And here how many were printed
    1140   00:45D4  21 C3 6B                ld  hl,MMENU_SCANS
    1141   00:45D7  CD A5 4C                call    PRINTHL
    1142   00:45DA  DD E5                   push    ix
    1143   00:45DC  E1                      pop hl                          ; IX in HL
    1144   00:45DD                      WIFI_LIST_LOOP:
