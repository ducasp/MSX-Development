    3912   00:5530                      ;========================
    3913   00:5530                      ;===  TCPIP_TCP_OPEN  ===
    3914   00:5530                      ;========================
    3915   00:5530                      ;Open a TCP connection.
    3916   00:5530                      ;
    3917   00:5530                      ;Input:  A  = 13
    3918   00:5530                      ;        HL = Address of parameters block
    3919   00:5530                      ;Output: A = Error code
    3920   00:5530                      ;        B = Connection number
    3921   00:5530                      ;        C = Connection not open reason (mostly for TLS)
    3922   00:5530                      ;
    3923   00:5530                      ;Parameters block format:
    3924   00:5530                      ;
    3925   00:5530                      ;+0 (4): Remote IP address (0.0.0.0 for unspecified remote socket)
    3926   00:5530                      ;+4 (2): Remote port (ignored if unspecified remote socket)
    3927   00:5530                      ;+6 (2): Local port, 0FFFFh for a random value
    3928   00:5530                      ;+8 (2): Suggestion for user timeout value
    3929   00:5530                      ;+10 (1): Flags:
    3930   00:5530                      ;         bit 0: Set for passive connection
    3931   00:5530                      ;         bit 1: Set for resident connection
    3932   00:5530                      ;         bit 2: Set for TLS connection
    3933   00:5530                      ;         bit 3: Set for TLS connection validating host certificate
    3934   00:5530                      ;+11 (2): If 0000 no host name validation, otherwise the hostname string address (zero terminated)
    3935   00:5530                      ;TCP_OPEN_IP1               (ix+0)
    3936   00:5530                      ;TCP_OPEN_IP2               (ix+1)
    3937   00:5530                      ;TCP_OPEN_IP3               (ix+2)
    3938   00:5530                      ;TCP_OPEN_IP4               (ix+3)
    3939   00:5530                      ;TCP_OPEN_RP                (ix+4)
    3940   00:5530                      ;TCP_OPEN_LP                (ix+6)
    3941   00:5530                      ;TCP_OPEN_TO                (ix+8)
    3942   00:5530                      ;TCP_OPEN_CMD_FLAGS         (ix+10)
    3943   00:5530                      ;TCP_OPEN_CMD_HOST_LSB      (ix+11)
    3944   00:5530                      ;TCP_OPEN_CMD_HOST_MSB      (ix+12)
    3945   00:5530                      
    3946   00:5530                      ; When no connection, let's get the reason and put in register C, as agreed
    3947   00:5530                      ; with Nestor this will be the way to go in the next UNAPI revision
    3948   00:5530                      TCPIP_TCP_OPEN_ERROR:
    3949   00:5530                          ; next two bytes are return code and size bytes, don't care, it is 1, conn close reason
    3950   00:5530  47                      ld  b,a                         ; save error in b
    3951   00:5531  0E 02                   ld  c,2
    3952   00:5533                      TCPIP_TCP_OPEN_ERROR2:
    3953   00:5533                          CHECK_DATA
    3953   00:5533  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3953   00:5536  CB 47             >     bit 0,a
    3954   00:5538  20 05                   jr  nz,TCPIP_TCP_OPEN_ERROR2.1
    3955   00:553A  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3956   00:553D  18 F4                   jr  TCPIP_TCP_OPEN_ERROR2
    3957   00:553F                      TCPIP_TCP_OPEN_ERROR2.1:
    3958   00:553F                          ; nz, discard
    3959   00:553F                          RECEIVE_DATA
    3959   00:553F  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3960   00:5542  0D                      dec c
    3961   00:5543  20 EE                   jr  nz,TCPIP_TCP_OPEN_ERROR2
    3962   00:5545  78                      ld  a,b
    3963   00:5546  FE 0B                   cp  ERR_NO_CONN
    3964   00:5548  20 10                   jr  nz,TCPIP_TCP_OPEN_ERROR4    ; other errors do not have extra bytes as result
    3965   00:554A                      ; now just get the 1 byte, close reason, should go to C
    3966   00:554A                      TCPIP_TCP_OPEN_ERROR3:
    3967   00:554A                          CHECK_DATA
    3967   00:554A  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3967   00:554D  CB 47             >     bit 0,a
    3968   00:554F  20 05                   jr  nz,TCPIP_TCP_OPEN_ERROR3.1
