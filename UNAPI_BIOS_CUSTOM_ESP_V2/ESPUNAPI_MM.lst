    7615   00:66B9                      ; http://map.grauw.nl/articles/vdp_tut.php
    7616   00:66B9                      ; Set VDP address counter to write from address AHL (17-bits)
    7617   00:66B9                      ; Enables the interrupts
    7618   00:66B9                      SET_VDP_WRITE:
    7619   00:66B9  CB 04                   rlc h
    7620   00:66BB  17                      rla
    7621   00:66BC  CB 04                   rlc h
    7622   00:66BE  17                      rla
    7623   00:66BF  CB 3C                   srl h
    7624   00:66C1  CB 3C                   srl h
    7625   00:66C3  F3                      di
    7626   00:66C4  D3 99                   out (#99),a
    7627   00:66C6  3E 8E                   ld  a,14+128
    7628   00:66C8  D3 99                   out (#99),a
    7629   00:66CA  7D                      ld  a,l
    7630   00:66CB  00                      nop                             ; Do not remove this 'nop' here!
    7631   00:66CC  D3 99                   out (#99),a
    7632   00:66CE  7C                      ld  a,h
    7633   00:66CF  F6 40                   or  64
    7634   00:66D1  FB                      ei
    7635   00:66D2  D3 99                   out (#99),a
    7636   00:66D4  C9                      ret
