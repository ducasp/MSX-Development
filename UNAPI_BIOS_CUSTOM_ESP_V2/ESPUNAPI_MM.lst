    5390   00:5CAB                      
    5391   00:5CAB                          ; next two bytes are return code and size bytes, don't care, it is 16
    5392   00:5CAB  06 02                   ld  b,2
    5393   00:5CAD                      TCPIP_TCP_STATE_ST2:
    5394   00:5CAD                          CHECK_DATA
