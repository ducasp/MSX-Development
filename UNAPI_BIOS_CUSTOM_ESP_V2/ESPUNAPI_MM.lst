    6001   00:5FC7                      ;=============================
    6002   00:5FC7                      ;===  TCPIP_CONFIG_AUTOIP  ===
    6003   00:5FC7                      ;=============================
    6004   00:5FC7                      ;Enable or disable the automatic IP addresses retrieval.
    6005   00:5FC7                      ;
    6006   00:5FC7                      ;Input:  A = 25
    6007   00:5FC7                      ;        B = 0: Get current configuration
    6008   00:5FC7                      ;            1: Set configuration
    6009   00:5FC7                      ;        C = Configuration to set (only if B=1):
    6010   00:5FC7                      ;            bit 0: Set to automatically retrieve
    6011   00:5FC7                      ;                   local IP address, subnet mask and default gateway
    6012   00:5FC7                      ;            bit 1: Set to automatically retrieve DNS servers addresses
    6013   00:5FC7                      ;            bits 2-7: Unused, must be zero
    6014   00:5FC7                      ;Output: A = Error code
    6015   00:5FC7                      ;        C = Configuration after the routine execution
    6016   00:5FC7                      ;            (same format as C at input)
    6017   00:5FC7                      TCPIP_CONFIG_AUTOIP:
    6018   00:5FC7                          SEND_DATA                       ; Send the command
    6018   00:5FC7  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6019   00:5FCA  AF                      xor a
    6020   00:5FCB                          SEND_DATA                       ; Send the command size msb
    6020   00:5FCB  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6021   00:5FCE  3E 02                   ld  a,2
    6022   00:5FD0                          SEND_DATA                       ; Send the command size lsb
    6022   00:5FD0  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6023   00:5FD3  78                      ld  a,b
    6024   00:5FD4                          SEND_DATA                       ; Send the command
    6024   00:5FD4  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6025   00:5FD7  79                      ld  a,c
    6026   00:5FD8                          SEND_DATA                       ; Send the command parameter
    6026   00:5FD8  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6027   00:5FDB                      
    6028   00:5FDB                          ; Now wait up to 180 ticks to get response
    6029   00:5FDB  21 B4 00                ld hl,180
    6030   00:5FDE  CD 36 61                call    SETCOUNTER
    6031   00:5FE1                      TCPIP_CONFIG_AUTOIP_ST1:
    6032   00:5FE1                          CHECK_DATA
    6032   00:5FE1  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6032   00:5FE4  CB 47             >     bit 0,a
    6033   00:5FE6  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_ST1.1
    6034   00:5FE8  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6035   00:5FEB  18 F4                   jr  TCPIP_CONFIG_AUTOIP_ST1
    6036   00:5FED                      TCPIP_CONFIG_AUTOIP_ST1.1:
    6037   00:5FED                          ; nz, check the data
    6038   00:5FED                          RECEIVE_DATA
    6038   00:5FED  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6039   00:5FF0  FE 19                   cp  25                          ; Is response of our command?
    6040   00:5FF2  20 ED                   jr  nz,TCPIP_CONFIG_AUTOIP_ST1
    6041   00:5FF4                          ; now get return code, if return code other than 0, it is finished
    6042   00:5FF4                      TCPIP_CONFIG_AUTOIP_RC:
    6043   00:5FF4                          CHECK_DATA
    6043   00:5FF4  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6043   00:5FF7  CB 47             >     bit 0,a
    6044   00:5FF9  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_RC.1
    6045   00:5FFB  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6046   00:5FFE  18 F4                   jr  TCPIP_CONFIG_AUTOIP_RC
    6047   00:6000                      TCPIP_CONFIG_AUTOIP_RC.1:
    6048   00:6000                          ;nz, discard
    6049   00:6000                          RECEIVE_DATA
    6049   00:6000  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6050   00:6003  B7                      or  a                           ; 0?
    6051   00:6004  C0                      ret nz                          ; if not, done
    6052   00:6005                      
    6053   00:6005                          ; next two bytes are return code and size bytes, don't care, it is 1, configuration
    6054   00:6005  06 02                   ld  b,2
    6055   00:6007                      TCPIP_CONFIG_AUTOIP_ST2:
    6056   00:6007                          CHECK_DATA
    6056   00:6007  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6056   00:600A  CB 47             >     bit 0,a
    6057   00:600C  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_ST2.1
    6058   00:600E  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6059   00:6011  18 F4                   jr  TCPIP_CONFIG_AUTOIP_ST2
    6060   00:6013                      TCPIP_CONFIG_AUTOIP_ST2.1:
    6061   00:6013                          ; nz, discard
    6062   00:6013                          RECEIVE_DATA
    6062   00:6013  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6063   00:6016  05                      dec b
    6064   00:6017  20 EE                   jr  nz,TCPIP_CONFIG_AUTOIP_ST2
    6065   00:6019                      
    6066   00:6019                          ; now just get the 1 byte, configuration, should go to C
    6067   00:6019                      TCPIP_CONFIG_AUTOIP_CONF_ST1:
    6068   00:6019                          CHECK_DATA
    6068   00:6019  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6068   00:601C  CB 47             >     bit 0,a
    6069   00:601E  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_CONF_ST1.1
    6070   00:6020  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6071   00:6023  18 F4                   jr  TCPIP_CONFIG_AUTOIP_CONF_ST1
    6072   00:6025                      TCPIP_CONFIG_AUTOIP_CONF_ST1.1:
    6073   00:6025                          ; nz, get it
    6074   00:6025                          RECEIVE_DATA
    6074   00:6025  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6075   00:6028  4F                      ld  c,a
    6076   00:6029                          ; done
    6077   00:6029  AF                      xor a
    6078   00:602A  C9                      ret
    6079   00:602B                      
    6080   00:602B                      ;=========================
    6081   00:602B                      ;===  TCPIP_CONFIG_IP  ===
    6082   00:602B                      ;=========================
    6083   00:602B                      ;Manually configure an IP address.
    6084   00:602B                      ;
    6085   00:602B                      ;Input:  A = 26
    6086   00:602B                      ;        B = Index of address to set:
    6087   00:602B                      ;            1: Local IP address
    6088   00:602B                      ;            2: Peer IP address
    6089   00:602B                      ;            3: Subnet mask
    6090   00:602B                      ;            4: Default gateway
    6091   00:602B                      ;            5: Primary DNS server IP address
    6092   00:602B                      ;            6: Secondary DNS server IP address
    6093   00:602B                      ;        L.H.E.D = Address value
    6094   00:602B                      ;Output: A = Error code
    6095   00:602B                      TCPIP_CONFIG_IP:
    6096   00:602B                          SEND_DATA                       ; Send the command
    6096   00:602B  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6097   00:602E  AF                      xor a
    6098   00:602F                          SEND_DATA                       ; Send the command size msb
    6098   00:602F  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6099   00:6032  3E 05                   ld  a,5
    6100   00:6034                          SEND_DATA                       ; Send the command size lsb
    6100   00:6034  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6101   00:6037  78                      ld  a,b
    6102   00:6038                          SEND_DATA                       ; Send the address to set
    6102   00:6038  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6103   00:603B  7D                      ld  a,l
    6104   00:603C                          SEND_DATA                       ; Send the IP first byte
    6104   00:603C  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6105   00:603F  7C                      ld  a,h
    6106   00:6040                          SEND_DATA                       ; Send the IP second byte
    6106   00:6040  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6107   00:6043  7B                      ld  a,e
    6108   00:6044                          SEND_DATA                       ; Send the IP third byte
    6108   00:6044  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6109   00:6047  7A                      ld  a,d
    6110   00:6048                          SEND_DATA                       ; Send the IP fourth byte
    6110   00:6048  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6111   00:604B                      
    6112   00:604B                          ; Now wait up to 180 ticks to get response
    6113   00:604B  21 B4 00                ld  hl,180
    6114   00:604E  CD 36 61                call    SETCOUNTER
    6115   00:6051                      TCPIP_CONFIG_IP_ST1:
    6116   00:6051                          CHECK_DATA
    6116   00:6051  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6116   00:6054  CB 47             >     bit 0,a
    6117   00:6056  20 05                   jr  nz,TCPIP_CONFIG_IP_ST1.1
    6118   00:6058  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6119   00:605B  18 F4                   jr  TCPIP_CONFIG_IP_ST1
    6120   00:605D                      TCPIP_CONFIG_IP_ST1.1:
    6121   00:605D                          ; nz, check the data
    6122   00:605D                          RECEIVE_DATA
    6122   00:605D  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6123   00:6060  FE 1A                   cp  26                          ; Is response of our command?
    6124   00:6062  20 ED                   jr  nz,TCPIP_CONFIG_IP_ST1
    6125   00:6064                          ; now get return code, and that is it
    6126   00:6064                      TCPIP_CONFIG_IP_RC:
    6127   00:6064                          CHECK_DATA
    6127   00:6064  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6127   00:6067  CB 47             >     bit 0,a
    6128   00:6069  20 05                   jr  nz,TCPIP_CONFIG_IP_RC.1
    6129   00:606B  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6130   00:606E  18 F4                   jr  TCPIP_CONFIG_IP_RC
    6131   00:6070                      TCPIP_CONFIG_IP_RC.1:
    6132   00:6070                          ; nz, discard
    6133   00:6070                          RECEIVE_DATA
    6133   00:6070  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6134   00:6073  C9                      ret                             ; done
    6135   00:6074                      
    6136   00:6074                      ;==========================
    6137   00:6074                      ;===  TCPIP_CONFIG_TTL  ===
    6138   00:6074                      ;==========================
    6139   00:6074                      ;Get/set the value of TTL and TOS for outgoing datagrams.
    6140   00:6074                      ;
    6141   00:6074                      ;Input:  A = 27
    6142   00:6074                      ;        B = 0: Get current values (just return 255 for TTL and 0 for TOS
    6143   00:6074                      ;               as ESP do not expose or allow configurations of it)
    6144   00:6074                      ;            1: Set values
    6145   00:6074                      ;        D = New value for TTL (only if B=1)
    6146   00:6074                      ;        E = New value for ToS (only if B=1)
    6147   00:6074                      ;Output: A = Error code
    6148   00:6074                      ;        D = Value of TTL after the routine execution
    6149   00:6074                      ;        E = Value of ToS after the routine execution
    6150   00:6074                      TCPIP_CONFIG_TTL:
    6151   00:6074  78                      ld  a,b
    6152   00:6075  E6 FE                   and %11111110
    6153   00:6077  B7                      or  a
    6154   00:6078  3E 04                   ld  a,ERR_INV_PARAM
    6155   00:607A  C0                      ret nz
    6156   00:607B  78                      ld  a,b
    6157   00:607C  B7                      or  a
    6158   00:607D                          ; Cant set, so NOT IMP
    6159   00:607D  3E 01                   ld  a,ERR_NOT_IMP
    6160   00:607F  C0                      ret nz                          ; if not get, not implemented
    6161   00:6080                          ; get, so just return D = #FF, A = OK = 0 and E = 0
    6162   00:6080  AF                      xor a
    6163   00:6081  1E 00                   ld  e,0
    6164   00:6083  16 FF                   ld  d,#FF
    6165   00:6085  C9                      ret
    6166   00:6086                      
    6167   00:6086                      ;===========================
    6168   00:6086                      ;===  TCPIP_CONFIG_PING  ===
    6169   00:6086                      ;===========================
    6170   00:6086                      ;Get/set the automatic PING reply flag.
    6171   00:6086                      ;
    6172   00:6086                      ;Input:  A = 28
    6173   00:6086                      ;        B = 0: Get current flag value
    6174   00:6086                      ;            1: Set flag value (ERR_NOT_IMP)
    6175   00:6086                      ;        C = New flag value (only if B=1):
    6176   00:6086                      ;            0: Off
    6177   00:6086                      ;            1: On
    6178   00:6086                      ;Output: A = Error code
