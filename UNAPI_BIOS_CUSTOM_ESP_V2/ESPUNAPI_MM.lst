    1348   00:4722  03                      inc bc
    1349   00:4723  1A                      ld  a,(de)
    1350   00:4724  13                      inc de
    1351   00:4725  B7                      or  a
    1352   00:4726  C2 22 47                jp  nz,WIFI_CONNECT_APSIZE      ; Count size, including zero terminator
    1353   00:4729                          ; Check for encryption
    1354   00:4729  1A                      ld  a,(de)
    1355   00:472A  B7                      or  a
    1356   00:472B  CA BC 47                jp  z,WIFI_CONNECT_SENDCMD      ; If no password requested, good to go
    1357   00:472E                          ; Shoot, need to request password, well, let's do it
    1358   00:472E  E5                      push    hl                      ; Save HL
    1359   00:472F  21 78 6D                ld  hl,MMENU_ASKPWD
    1360   00:4732  CD 96 4C                call    PRINTHL                 ; Inform that user need to input PWD
    1361   00:4735  E1                      pop hl                          ; Restore HL
    1362   00:4736  FD 21 00 00             ld  iy,0                        ; IY will help in backspacing
    1363   00:473A  DD 26 01                ld  ixh,1                       ; Start hidden
    1364   00:473D                      WIFI_CONNECT_RCV_PWD:
    1365   00:473D  CD 9F 00                call    CHGET
    1366   00:4740  FE 1B                   cp  #1b                         ; ESC?
    1367   00:4742  CA 5C 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1368   00:4745  FE 08                   cp  #08                         ; Backspace?
    1369   00:4747  CA 98 47                jp  z,WIFI_CONNECT_RCV_PWD_BS   ; Check if there is something to erase
    1370   00:474A  FE 0D                   cp  #0d                         ; ENTER?
    1371   00:474C  CA B5 47                jp  z,WIFI_PWD_CHECK_INPUT      ; Check if ok
    1372   00:474F  FE 7F                   cp  #7f                         ; Delete?
    1373   00:4751  CA 84 47                jp  z,WIFI_CONNECT_RCV_PWDH     ; Change password from clear to hidden or vice versa
    1374   00:4754                      WIFI_CONNECT_RCV_PWD_STR:
    1375   00:4754                          ; Ok, so it is a digit and store
    1376   00:4754  12                      ld  (de),a
    1377   00:4755  FD 7D                   ld  a,iyl
    1378   00:4757  D6 3F                   sub 63                          ; 63 chars password limit (WPA2 encryption)
    1379   00:4759  28 E2                   jr  z,WIFI_CONNECT_RCV_PWD
    1380   00:475B  1A                      ld  a,(de)
    1381   00:475C  03                      inc bc
    1382   00:475D  13                      inc de
    1383   00:475E  FD 23                   inc iy                          ; Increment counters and pointer
    1384   00:4760  F5                      push    af                      ; Save A
    1385   00:4761  DD 7C                   ld  a,ixh
    1386   00:4763  B7                      or  a                           ; If zero, print char, otherwise print *
    1387   00:4764  28 09                   jr  z,WIFI_CONNECT_RCV_PWD_CHAR
    1388   00:4766  F1                      pop af
    1389   00:4767  3E 2A                   ld  a,'*'                       ; Print * and keep password hidden
    1390   00:4769  CD A2 00                call    CHPUT
    1391   00:476C  C3 3D 47                jp  WIFI_CONNECT_RCV_PWD        ; And back to receiving digits
    1392   00:476F                      WIFI_CONNECT_RCV_PWD_CHAR:
    1393   00:476F  F1                      pop af
    1394   00:4770  FE 20                   cp  32
    1395   00:4772  30 04                   jr  nc,WIFI_CONNECT_RCV_CHKPRT2 ; Ok, not below space, but is it delete?
    1396   00:4774  3E 3F                   ld  a,'?'                       ; Prints a question mark
    1397   00:4776  18 06                   jr  WIFI_CONNECT_RCV_CHKPRTD
    1398   00:4778                      WIFI_CONNECT_RCV_CHKPRT2:
    1399   00:4778  FE 7F                   cp  #7f
    1400   00:477A  20 02                   jr  nz,WIFI_CONNECT_RCV_CHKPRTD
    1401   00:477C  3E 3F                   ld  a,'?'                       ; Prints a question mark if it is delete
    1402   00:477E                      WIFI_CONNECT_RCV_CHKPRTD:
    1403   00:477E  CD A2 00                call    CHPUT                   ; Print a char
    1404   00:4781  C3 3D 47                jp  WIFI_CONNECT_RCV_PWD        ; And back to receiving digits
    1405   00:4784                      
    1406   00:4784                      WIFI_CONNECT_RCV_PWDH:
    1407   00:4784  FD 7D                   ld  a,iyl
    1408   00:4786  FD B4                   or  iyh
    1409   00:4788  C2 54 47                jp  nz,WIFI_CONNECT_RCV_PWD_STR ; If digits entered, can't change password behavior, so it is a pass phrase char
    1410   00:478B  AF                      xor a
    1411   00:478C  DD B4                   or  ixh
    1412   00:478E  DD 26 01                ld  ixh,1
    1413   00:4791  28 AA                   jr  z,WIFI_CONNECT_RCV_PWD      ; Return if it was 0
    1414   00:4793  DD 26 00                ld  ixh,0
    1415   00:4796  28 A5                   jr  z,WIFI_CONNECT_RCV_PWD      ; Otherwise set to 0 and return
    1416   00:4798                      
    1417   00:4798                      WIFI_CONNECT_RCV_PWD_BS:
    1418   00:4798  FD 7D                   ld  a,iyl
    1419   00:479A  FD B4                   or  iyh
    1420   00:479C  CA 3D 47                jp  z,WIFI_CONNECT_RCV_PWD      ; If no digits entered, nothing to erase
    1421   00:479F  FD 2B                   dec iy                          ; Decrement counter
    1422   00:47A1  0B                      dec bc                          ; Decrement counter
    1423   00:47A2  1B                      dec de                          ; Decrement pointer
    1424   00:47A3  3E 08                   ld  a,8                         ; Backspace
    1425   00:47A5  CD A2 00                call    CHPUT                   ; Print it
    1426   00:47A8  3E 20                   ld  a,' '                       ; Space
    1427   00:47AA  CD A2 00                call    CHPUT                   ; Print it
    1428   00:47AD  3E 08                   ld  a,8                         ; Backspace
    1429   00:47AF  CD A2 00                call    CHPUT                   ; Print it
    1430   00:47B2  C3 3D 47                jp  WIFI_CONNECT_RCV_PWD        ; Return
    1431   00:47B5                      
    1432   00:47B5                      WIFI_PWD_CHECK_INPUT:
    1433   00:47B5  FD 7D                   ld  a,iyl
    1434   00:47B7  FD B4                   or  iyh
    1435   00:47B9  CA 3D 47                jp  z,WIFI_CONNECT_RCV_PWD      ; If no digits entered, no password to send
    1436   00:47BC                          ; Otherwise done and ready to send
    1437   00:47BC                      WIFI_CONNECT_SENDCMD:
    1438   00:47BC  CD 0F 4A                call    WAIT_250MS_AND_THEN_CONTINUE
    1439   00:47BF  E5                      push    hl
    1440   00:47C0  21 34 6D                ld  HL,MMENU_CONNECTING
    1441   00:47C3  CD 96 4C                call    PRINTHL
    1442   00:47C6  E1                      pop hl
    1443   00:47C7                          ; Print AP name
    1444   00:47C7  E5                      push    hl
    1445   00:47C8  CD A0 4C                call    PRINTHLINE              ; Print AP Name
    1446   00:47CB  E1                      pop hl
    1447   00:47CC                          ; HL has the address of our data, BC the data size, so it is just needed to send the command
    1448   00:47CC                          CLEAR_UART
    1448   00:47CC  3E 14             >     ld  a,20
    1448   00:47CE  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    1449   00:47D1  3E 41                   ld  a,CMD_WIFI_CONNECT
    1450   00:47D3                          SEND_DATA
    1450   00:47D3  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1451   00:47D6  78                      ld  a,b                         ; Size MSB is in B
    1452   00:47D7                          SEND_DATA
    1452   00:47D7  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1453   00:47DA  79                      ld  a,c                         ; Size LSB is in c
    1454   00:47DB                          SEND_DATA
    1454   00:47DB  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1455   00:47DE                      WIFI_CONNECT_SENDCMDLP:
    1456   00:47DE  7E                      ld  a,(hl)
    1457   00:47DF                          SEND_DATA
    1457   00:47DF  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1458   00:47E2  23                      inc hl
    1459   00:47E3  0B                      dec bc
    1460   00:47E4  78                      ld  a,b
    1461   00:47E5  B1                      or  c
    1462   00:47E6  C2 DE 47                jp  nz,WIFI_CONNECT_SENDCMDLP
    1463   00:47E9  21 58 02                ld  hl,600                      ; Wait Up To 10s
    1464   00:47EC  3E 41                   ld  a,CMD_WIFI_CONNECT          ; Our command
    1465   00:47EE  CD 31 4B                call    WAIT_MENU_QCMD_RESPONSE
    1466   00:47F1  CA FD 47                jp  z,WIFI_CONNECT_FAIL
    1467   00:47F4  21 D9 71                ld  hl,STR_SENDING_OK_JN        ; Success
    1468   00:47F7  CD 96 4C                call    PRINTHL
    1469   00:47FA  C3 07 4A                jp  WAIT_2S_AND_THEN_MAINMENU
    1470   00:47FD                      WIFI_CONNECT_FAIL:
    1471   00:47FD  21 FB 71                ld  hl,STR_SENDING_NOK_JN       ; Failure
    1472   00:4800  CD 96 4C                call    PRINTHL
    1473   00:4803  C3 03 4A                jp  WAIT_4S_AND_THEN_MAINMENU
    1474   00:4806                      
    1475   00:4806                      INPUT_WFSAP_BAD_INPUT:
    1476   00:4806  C5                      push    bc
    1477   00:4807  D5                      push    de
    1478   00:4808  F5                      push    af
    1479   00:4809  E5                      push    hl
    1480   00:480A  DD E5                   push    ix
    1481   00:480C  FD E5                   push    iy
    1482   00:480E  CD C0 00                call    BEEP                    ; Wrong Input, beep
    1483   00:4811  FD E1                   pop iy
    1484   00:4813  DD E1                   pop ix
    1485   00:4815  E1                      pop hl
    1486   00:4816  F1                      pop af
    1487   00:4817  D1                      pop de
    1488   00:4818  C1                      pop bc
    1489   00:4819  C3 44 46                jp WIFI_SELECT_AP               ; Return
    1490   00:481C                      
    1491   00:481C                      WIFI_SCAN_NONETWORKS:
    1492   00:481C  21 E7 6C                ld  hl,MMENU_SCANN
    1493   00:481F  CD 96 4C                call    PRINTHL
    1494   00:4822  C3 03 4A                jp  WAIT_4S_AND_THEN_MAINMENU
    1495   00:4825                      
    1496   00:4825                      WIFI_SCAN_TIMEOUT:
    1497   00:4825  21 C7 6C                ld  hl,MMENU_SCANF
    1498   00:4828  CD 96 4C                call    PRINTHL
    1499   00:482B  C3 03 4A                jp  WAIT_4S_AND_THEN_MAINMENU
    1500   00:482E                      
    1501   00:482E                      SET_WIFI_TIMEOUT:
    1502   00:482E  3E 32                   ld  a,'2'
    1503   00:4830  CD A2 00                call    CHPUT
    1504   00:4833  CD 0F 4A                call    WAIT_250MS_AND_THEN_CONTINUE
    1505   00:4836  21 AA 6E                ld  hl,MMENU_TIMEOUT
    1506   00:4839  CD 96 4C                call    PRINTHL                 ; Print Main Timeout message
    1507   00:483C  CD 80 4A                call    CHECKTIMEOUT            ; TimeOut is on or off?
    1508   00:483F  CA 57 48                jp  z,WIFI_SET_ALWAYS_ON        ; If 0, always on
    1509   00:4842                          ; Otherwise there is a timeout
    1510   00:4842  E5                      push    hl
    1511   00:4843  21 E1 6F                ld hl,MMENU_TIMEOUT_NOTALWAYSON1
    1512   00:4846  CD 96 4C                call    PRINTHL
    1513   00:4849  E1                      pop hl
    1514   00:484A  CD 96 4C                call    PRINTHL
    1515   00:484D  21 F7 6F                ld hl,MMENU_TIMEOUT_NOTALWAYSON2
    1516   00:4850  CD 96 4C                call    PRINTHL
    1517   00:4853  16 00                   ld  d,0                         ; Count digits
    1518   00:4855  18 10                   jr  INPUT_TIMEOUT
    1519   00:4857                      WIFI_SET_ALWAYS_ON:
    1520   00:4857  21 8C 6F                ld  hl,MMENU_TIMEOUT_ALWAYSON
    1521   00:485A  CD 96 4C                call    PRINTHL
    1522   00:485D  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1523   00:4861  DD 6B                   ld  ixl,e
    1524   00:4863  DD 62                   ld  ixh,d                       ; Address in IX
    1525   00:4865  16 00                   ld  d,0                         ; Count digits
    1526   00:4867                      INPUT_TIMEOUT:
    1527   00:4867  CD 9F 00                call    CHGET
    1528   00:486A  FE 1B                   cp  #1b                         ; ESC?
    1529   00:486C  CA 5C 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1530   00:486F  FE 0D                   cp  #0d                         ; ENTER?
    1531   00:4871  CA B5 48                jp  z,SET_WIFI_CHECK_INPUT      ; Check if ok
    1532   00:4874  FE 08                   cp  #08                         ; Backspace?
    1533   00:4876  CA 9B 48                jp  z,SET_WIFI_BS_INPUT         ; Check if there is something to erase
    1534   00:4879  FE 30                   cp  '0'                         ; Check if A is less than 0
    1535   00:487B  DA 95 48                jp  c,INPUT_TIMEOUT_BAD_INPUT   ; if it is, ignore
    1536   00:487E  FE 3A                   cp  '9'+1                       ; Check if a is greater than  9
    1537   00:4880  D2 95 48                jp  nc,INPUT_TIMEOUT_BAD_INPUT  ; If it is, ignore
    1538   00:4883  DD 77 00                ld  (ix+0),a                    ; Save it
    1539   00:4886  CD A2 00                call    CHPUT                   ; It is valid, so print it
    1540   00:4889  14                      inc d                           ; Increment digit count
    1541   00:488A  DD 23                   inc ix                          ; Increment pointer
    1542   00:488C  3E 03                   ld  a,3
    1543   00:488E  BA                      cp  d
    1544   00:488F  CA B5 48                jp  z,SET_WIFI_CHECK_INPUT      ; All we can do is accept up to 3 digits, check if ok
    1545   00:4892  C3 67 48                jp  INPUT_TIMEOUT               ; Not done yet, so continue
    1546   00:4895                      
    1547   00:4895                      INPUT_TIMEOUT_BAD_INPUT:
    1548   00:4895  CD C0 00                call    BEEP                    ; Wrong Input, beep
    1549   00:4898  C3 67 48                jp INPUT_TIMEOUT                ; Return
    1550   00:489B                      
    1551   00:489B                      SET_WIFI_BS_INPUT:
    1552   00:489B  AF                      xor a
    1553   00:489C  B2                      or  d                           ; Counter has any digit?
    1554   00:489D  CA 67 48                jp  z,INPUT_TIMEOUT             ; Nope, so just continue
    1555   00:48A0  15                      dec d                           ; Decrement counter
    1556   00:48A1  DD 2B                   dec ix                          ; Decrement pointer
    1557   00:48A3  3E 08                   ld  a,8                         ; Backspace
    1558   00:48A5  CD A2 00                call    CHPUT                   ; Print it
    1559   00:48A8  3E 20                   ld  a,' '                       ; Space
    1560   00:48AA  CD A2 00                call    CHPUT                   ; Print it
    1561   00:48AD  3E 08                   ld  a,8                         ; Backspace
    1562   00:48AF  CD A2 00                call    CHPUT                   ; Print it
    1563   00:48B2  C3 67 48                jp  INPUT_TIMEOUT               ; Return
    1564   00:48B5                      
    1565   00:48B5                      SET_WIFI_CHECK_INPUT:
    1566   00:48B5  AF                      xor a
    1567   00:48B6  B2                      or  d                           ; Counter has any digits
    1568   00:48B7  CA 67 48                jp  z,INPUT_TIMEOUT             ; Nope, so just continue
    1569   00:48BA                          ; IX is pointing one position after last digit, so revert
    1570   00:48BA  DD 2B                   dec ix
    1571   00:48BC  DD 7E 00                ld  a,(ix+0)                    ; Digit in A
    1572   00:48BF  D6 30                   sub '0'                         ; Convert it to decimal
    1573   00:48C1  26 00                   ld  h,0                         ; First digit, so H is 0
    1574   00:48C3  6F                      ld  l,a                         ; And L has the digit
    1575   00:48C4  15                      dec d                           ; If digits finished, just set
    1576   00:48C5  CA F1 48                jp  z,SET_WIFI_EXECUTE_SET_COMMAND
    1577   00:48C8  DD 2B                   dec ix
    1578   00:48CA  DD 7E 00                ld  a,(ix+0)                    ; Digit in A
    1579   00:48CD  D6 30                   sub '0'                         ; Convert it to decimal
    1580   00:48CF  87                      add a,a                         ; A*2
    1581   00:48D0  4F                      ld  c,a                         ; A*2 in C
    1582   00:48D1  87                      add a,a                         ; A*4
    1583   00:48D2  87                      add a,a                         ; A*8
    1584   00:48D3  81                      add a,c                         ; A*10
    1585   00:48D4                          ; Up to here, we can get 90 + 9, 99, won't go to H anyway, just add to L
    1586   00:48D4  85                      add a,l                         ; L has the first digit
    1587   00:48D5  6F                      ld  l,a                         ; And now L has the two digits
    1588   00:48D6  15                      dec d                           ; If digits finished, just set
    1589   00:48D7  CA F1 48                jp  z,SET_WIFI_EXECUTE_SET_COMMAND
    1590   00:48DA  DD 2B                   dec ix
    1591   00:48DC  DD 7E 00                ld  a,(ix+0)                    ; Digit in A
    1592   00:48DF  D6 30                   sub '0'                         ; Convert it to decimal
    1593   00:48E1  87                      add a,a                         ; A*2
    1594   00:48E2  4F                      ld  c,a                         ; A*2 in C
    1595   00:48E3  87                      add a,a                         ; A*4
    1596   00:48E4  87                      add a,a                         ; A*8
    1597   00:48E5  81                      add a,c                         ; A*10
    1598   00:48E6  EB                      ex  de,hl                       ; Get the two digits results in de
    1599   00:48E7  6F                      ld  l,a
    1600   00:48E8  26 00                   ld  h,0                         ; HL = A*10
    1601   00:48EA  29                      add hl,hl                       ; HL = A*20
    1602   00:48EB  4D                      ld  c,l
    1603   00:48EC  44                      ld  b,h                         ; BC = A*20
    1604   00:48ED  29                      add hl,hl                       ; HL = A*40
    1605   00:48EE  29                      add hl,hl                       ; HL = A*80
    1606   00:48EF  09                      add hl,bc                       ; HL = A*100
    1607   00:48F0  19                      add hl,de                       ; HL = three digits result
    1608   00:48F1                          ; This was the last digit, up to three
    1609   00:48F1                      SET_WIFI_EXECUTE_SET_COMMAND:
    1610   00:48F1  C3 43 49                jp  SET_ESP_WIFI_TIMEOUT        ; And set and done
    1611   00:48F4                      
