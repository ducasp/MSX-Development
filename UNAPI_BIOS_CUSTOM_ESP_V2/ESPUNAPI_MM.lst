    1630   00:490B  21 F4 6E                ld  hl,MMENU_NAGLE
    1631   00:490E  CD A5 4C                call    PRINTHL                 ; Print Main Nagle message
    1632   00:4911  CD 41 4A                call    CHECKNAGLE              ; Nagle is on or off?
    1633   00:4914  20 1E                   jr  nz,NAGLE_IS_ON              ;
    1634   00:4916  21 29 70                ld  hl,MMENU_NAGLE_OFF          ; Show the menu telling nagle is off
    1635   00:4919  CD A5 4C                call    PRINTHL                 ; Print options
    1636   00:491C                      SET_NAGLE_WI_ON:
