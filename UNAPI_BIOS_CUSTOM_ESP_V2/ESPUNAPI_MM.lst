    4957   00:5A81                      ;===  TCPIP_TCP_SEND  ===
    4958   00:5A81                      ;========================
    4959   00:5A81                      ;Send data to a TCP connection.
    4960   00:5A81                      ;
    4961   00:5A81                      ;Input:  A  = 17
    4962   00:5A81                      ;        B  = Connection number
    4963   00:5A81                      ;        DE = Address of the data to be sent
    4964   00:5A81                      ;        HL = Length of the data to be sent
    4965   00:5A81                      ;        C  = Flags:
    4966   00:5A81                      ;             bit 0: Send the data PUSHed
