    5324   00:5C30  23                      inc hl
    5325   00:5C31  7C                      ld  a,h
    5326   00:5C32                          SEND_DATA                       ; Send the command size msb
    5326   00:5C32  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5327   00:5C35  7D                      ld  a,l
    5328   00:5C36                          SEND_DATA                       ; Send the command size lsb
    5328   00:5C36  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5329   00:5C39  78                      ld  a,b
    5330   00:5C3A                          SEND_DATA                       ; Send the connection #
    5330   00:5C3A  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5331   00:5C3D  2B                      dec hl
    5332   00:5C3E  EB                      ex  de,hl
    5333   00:5C3F                          ; now oti the data starting at hl, size is in DE
    5334   00:5C3F                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    5335   00:5C3F  43                      ld  b,e                         ;Number of loops originaly in DE
    5336   00:5C40  1B                      dec de
    5337   00:5C41  14                      inc d
    5338   00:5C42                          if USE_MEM_IO = 0
    5339   00:5C42                    ~     ld  c,OUT_TX_PORT
