    2498   00:4E06                      ;--- Implementation-specific routines addresses table
    2499   00:4E06                      
    2500   00:4E06                      FN_TABLE_S:
    2501   00:4E06  38 4E               FN_0_S:                 dw  UNAPI_GET_INFO_SSH
    2502   00:4E08  43 4E               FN_1_S:                 dw  SSH_GET_CAPAB
    2503   00:4E0A  83 56               FN_2_S:                 dw  SSH_OPEN
    2504   00:4E0C  07 57               FN_3_S:                 dw  SSH_CLOSE
    2505   00:4E0E  59 57               FN_4_S:                 dw  SSH_STATE
    2506   00:4E10  E9 5A               FN_5_S:                 dw  SSH_SEND
