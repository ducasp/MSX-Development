    4253   00:56B5                      ;========================
    4254   00:56B5                      ;===     SSH_OPEN     ===
    4255   00:56B5                      ;========================
    4256   00:56B5                      ;Open a SSH connection.
    4257   00:56B5                      ;
    4258   00:56B5                      ;Input:  A  = 2
    4259   00:56B5                      ;        HL = Address of parameters block
    4260   00:56B5                      ;Output: A = Error code
    4261   00:56B5                      ;        B = Connection number
    4262   00:56B5                      ;
    4263   00:56B5                      ;Parameters block format:
    4264   00:56B5                      ;
    4265   00:56B5                      ;+0 (4): Remote IP address (0.0.0.0 for unspecified remote socket)
    4266   00:56B5                      ;+4 (2): Remote port (ignored if unspecified remote socket)
    4267   00:56B5                      ;+6 (1): Subsystem
    4268   00:56B5                      ;+7 (1): Flags
    4269   00:56B5                      ;+8 (variable): username (0 terminated) and then password or public key (0 terminated)
    4270   00:56B5                      ;
    4271   00:56B5                      ;Parameter block MUST have at least 32 bytes available if doing host key verification
    4272   00:56B5                      ;as unknown host key hash will be returned in it
    4273   00:56B5                      
    4274   00:56B5                      SSH_OPEN:
    4275   00:56B5  E5                      push    hl                      ; save param block address
    4276   00:56B6  3E 08                   ld  a,8
