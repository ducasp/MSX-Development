    4452   00:578A                          ; restore BC to get conn # in B
    4453   00:578A  C1                      pop bc
    4454   00:578B                          ; if we are here, return code is 132, unknown host
    4455   00:578B  3E 84                   ld  a,132
    4456   00:578D  C9                      ret
