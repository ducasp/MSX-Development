    6675   00:61E0  20                      db  %00100000
    6676   00:61E1  70                      db  %01110000
    6677   00:61E2                      ; Pattern-06 is CHR$(1)+CHR$(86) = Wi-Fi Did not find the AP:
    6678   00:61E2  00                      db  %00000000
    6679   00:61E3  70                      db  %01110000
    6680   00:61E4  88                      db  %10001000
    6681   00:61E5  10                      db  %00010000                   ; "?"
    6682   00:61E6  20                      db  %00100000
    6683   00:61E7  00                      db  %00000000
    6684   00:61E8  20                      db  %00100000
    6685   00:61E9  00                      db  %00000000
    6686   00:61EA                      ; Pattern-07 is CHR$(1)+CHR$(87) = Wi-Fi is Idle, AP configured:
    6687   00:61EA  00                      db  %00000000
    6688   00:61EB  00                      db  %00000000
    6689   00:61EC  00                      db  %00000000
    6690   00:61ED  20                      db  %00100000                   ; "i"
    6691   00:61EE  00                      db  %00000000
    6692   00:61EF  20                      db  %00100000
    6693   00:61F0  20                      db  %00100000
    6694   00:61F1  70                      db  %01110000
    6695   00:61F2                      ; Pattern-08 is CHR$(1)+CHR$(88) = Left Middle Wave
    6696   00:61F2  00                      db  %00000000
