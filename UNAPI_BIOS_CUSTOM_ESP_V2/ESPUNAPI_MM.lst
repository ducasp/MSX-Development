    1132   00:45C2  B2                      or  d
    1133   00:45C3  CA 2C 48                jp  z,WIFI_SCAN_TIMEOUT
    1134   00:45C6  C3 A1 45                jp  WIFI_SCAN_WAIT_END
    1135   00:45C9                      WIFI_SCAN_SHOW_LIST:
