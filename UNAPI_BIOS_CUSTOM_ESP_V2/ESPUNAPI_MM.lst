    2443   00:4DC8  37 54               FN_12:                  dw  TCPIP_UDP_RCV
    2444   00:4DCA  88 55               FN_13:                  dw  TCPIP_TCP_OPEN
    2445   00:4DCC  5D 56               FN_14:                  dw  TCPIP_TCP_CLOSE
    2446   00:4DCE  C2 59               FN_15:                  dw  TCPIP_TCP_ABORT
