    4969   00:5A52  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4970   00:5A55  3C                      inc a
    4971   00:5A56                          SEND_DATA                       ; Send the command size lsb
    4971   00:5A56  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4972   00:5A59  78                      ld  a,b
    4973   00:5A5A                          SEND_DATA                       ; Send the parameter
    4973   00:5A5A  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4974   00:5A5D                      
    4975   00:5A5D                          ; Now wait up to 180 ticks to get response
    4976   00:5A5D  21 B4 00                ld  hl,180
