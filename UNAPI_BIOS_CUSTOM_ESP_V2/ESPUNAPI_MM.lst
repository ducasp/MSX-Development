    2336   00:4D57  3C                      inc a
    2337   00:4D58  28 26                   jr  z,JUMP_OLD2
    2338   00:4D5A                      
    2339   00:4D5A                          ; A=0: B=B+1 and jump to old hook
    2340   00:4D5A                      
    2341   00:4D5A  CD 96 60                call    GETSLT
    2342   00:4D5D  CD EF 60                call    GETWRK
