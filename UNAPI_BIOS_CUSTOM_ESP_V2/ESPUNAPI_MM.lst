    4417   00:5768                          RECEIVE_DATA
    4417   00:5768  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4418   00:576B  47                      ld b,a
    4419   00:576C  C5                      push    bc                      ; save it
    4420   00:576D                      
    4421   00:576D  4D                      ld  c,l
    4422   00:576E  44                      ld  b,h                         ; BC has effective received data size, as well as HL
    4423   00:576F                      
    4424   00:576F                          ; put effective data size in de
    4425   00:576F  EB                      ex  de,hl
    4426   00:5770                          ; address was in de, now in HL, BC effective received size
    4427   00:5770                      
    4428   00:5770                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use ini :-D
