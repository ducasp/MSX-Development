    5653   00:5DDE                          SEND_DATA                       ; Send the connection #
    5653   00:5DDE  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5654   00:5DE1  7D                      ld  a,l
    5655   00:5DE2                          SEND_DATA                       ; Send MAX rcv size LSB
    5655   00:5DE2  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5656   00:5DE5  7C                      ld  a,h
    5657   00:5DE6                          SEND_DATA                       ; Send MAX rcv size MSB
    5657   00:5DE6  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5658   00:5DE9  3E 03                   ld  a,3
    5659   00:5DEB  CD 60 61                call    SETBYTE                 ; Ok, retry up to three times
    5660   00:5DEE                      SSH_RCV.RXRETRY:
    5661   00:5DEE                          ; Now wait up to 600 ticks to get response
    5662   00:5DEE  21 58 02                ld  hl,600
    5663   00:5DF1  CD 3E 61                call    SETCOUNTER
