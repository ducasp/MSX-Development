     339   00:4000                      ;************************
     340   00:4000                      ;***  MSX ROM HEADER  ***
     341   00:4000                      ;************************
     342   00:4000                          org #4000
     343   00:4000  41 42                   db                  #41,#42
     344   00:4002  10 40                   dw                  INIT        ; Initialize ESP, if not found, won't install hook
     345   00:4004  00 00                   dw                  0           ; Statement
     346   00:4006  00 00                   dw                  0           ; Device
     347   00:4008  00 00                   dw                  0           ; Text
     348   00:400A  00 (6)                  ds                  6           ; Reserved
     349   00:4010                      
     350   00:4010                      ;==================
     351   00:4010                      ;===  Start-up  ===
     352   00:4010                      ;==================
     353   00:4010                      
     354   00:4010                      INIT:
     355   00:4010  7C                      ld  a,h                         ; Let's test if we are mirrored and being executed in wrong page
     356   00:4011  FE 40                   cp  #40                         ; is MSB 0x40?
     357   00:4013  C0                      ret nz                          ; if not, return, it is a mirror
     358   00:4014                          ; Let's set some System Variables
     359   00:4014  AF                      xor a                           ; a = #00
     360   00:4015  32 A9 FC                ld  (CSRSW),a                   ; cursor display is disabled
     361   00:4018  32 DB F3                ld  (CLIKSW),a                  ; when key press, key click disabled
     362   00:401B                          ; Let's intercept [DEL] key
     363   00:401B  3E 08                   ld  a,8
     364   00:401D  CD 41 01                call    SNSMAT
     365   00:4020  CB 5F                   bit 3,a                         ; Test [DEL]
     366   00:4022  C8                      ret z                           ; If DEL is pressed, UNAPI driver is not loaded and exits
     367   00:4023                          ; Let's check the Screen Mode, ref. https://www.msx.org/wiki/VDP_Table_Base_Address_Registers
     368   00:4023  3A E1 F3                ld  a,(REG2SAV)
     369   00:4026  FE 02                   cp  2
     370   00:4028  CA 32 40                jp  z,SCREEN_SETUP              ; If yes, is SCREEN 3
     371   00:402B  3A E3 F3                ld  a,(REG4SAV)
     372   00:402E  FE 00                   cp  0
     373   00:4030  28 06                   jr  z,IS_SCREEN1                ; If yes, is SCREEN 1
     374   00:4032                      SCREEN_SETUP:
     375   00:4032                          ; Let's set the SCREEN 1
     376   00:4032  3E 01                   ld  a,1                         ; a = #01
     377   00:4034  F7                      rst #30
     378   00:4035  00                      db  0
     379   00:4036  5F 00                   dw  CHGMOD                      ; SCREEN 1
     380   00:4038                      IS_SCREEN1:
     381   00:4038  3E 1D                   ld  a,29                        ; WIDTH 29
     382   00:403A  32 B0 F3                ld  (LINLEN),a
     383   00:403D                          ; We check if the Port F2 device is available
     384   00:403D                          READ_F2                         ; a = #FF, default value if it comes from power off or hard reset
     384   00:403D  3A 05 7F          >     ld  a,(MEM_PORT_F2)
     385   00:4040  2F                      cpl                             ; a = #FF - a
     386   00:4041  4F                      ld  c,a                         ; c = #00
     387   00:4042                          WRITE_F2                        ; a = #00
     387   00:4042  32 05 7F          >     ld  (MEM_PORT_F2),a
     388   00:4045                          ; Wait 250ms to ensure a successful hard reset even if you press the button very quickly
     389   00:4045  CD 1E 4A                call    WAIT_250MS_AND_THEN_CONTINUE
     390   00:4048                          READ_F2                         ; a = #00?
     390   00:4048  3A 05 7F          >     ld  a,(MEM_PORT_F2)
     391   00:404B  2F                      cpl                             ; a = #FF - a
     392   00:404C                          WRITE_F2                        ; a = #FF?
     392   00:404C  32 05 7F          >     ld  (MEM_PORT_F2),a
     393   00:404F  F5                      push    af
     394   00:4050  3E FE                   ld  a,#FE                       ; Preset #FE, unexpected error
     395   00:4052                          WRITE_F2                        ; on port #F2
     395   00:4052  32 05 7F          >     ld  (MEM_PORT_F2),a
     396   00:4055  F1                      pop af
     397   00:4056  B9                      cp  c                           ; If not a = c, port #F2 is writable and available
     398   00:4057  28 3D                   jr  z,BOOT_FROM_POWER_OFF       ; If a = c, port #F2 is not available, let's proceed as "boot from power off"
     399   00:4059                          ; Ok, Port F2 device available
     400   00:4059  FE EF                   cp  #EF                         ; UNAPI driver has been disabled
     401   00:405B  20 04                   jr  nz,NOT_DISABLED_BY_F2       ; No, let's continue checking
     402   00:405D                          WRITE_F2                        ; If yes, UNAPI driver is not loaded and exits, but need to restore F2 port to not have a false error
     402   00:405D  32 05 7F          >     ld  (MEM_PORT_F2),a
     403   00:4060  C9                      ret                             ; And our work is done
     404   00:4061                      NOT_DISABLED_BY_F2:
     405   00:4061  FE F0                   cp  #F0                         ; UNAPI driver has been loaded at least once
     406   00:4063  C2 78 40                jp  nz, F2_IS_NOT_F0            ; Ok, has not been loaded
     407   00:4066                          ; Let's intercept [F1] key
     408   00:4066  3E 06                   ld  a,6
     409   00:4068  CD 41 01                call    SNSMAT
     410   00:406B  CB 6F                   bit 5,a                         ; Test [F1]
     411   00:406D  CA 4A 42                jp  z,ENTERING_ESPSETUP         ; If F1 is pressed, let's execute our setup menu
     412   00:4070                          ; F1 is not pressed, continue
     413   00:4070  CB 77                   bit 6,a                         ; Test [F2]
     414   00:4072  C2 F6 40                jp  nz,INIT_UNAPI               ; If F2 is not pressed, let's proceed to INIT_UNAPI
     415   00:4075                          ; F2 is not pressed, continue
     416   00:4075  C3 AF 41                jp  INIT_NOCLOCKUPDAT2          ; If yes, proceed without affecting the connection or the date and time
     417   00:4078                      F2_IS_NOT_F0:
     418   00:4078  FE F1                   cp  #F1                         ; User requested to go directly to Wi-Fi Setup
     419   00:407A  CA 4A 42                jp  z,ENTERING_ESPSETUP         ; If yes, let's execute our setup menu
     420   00:407D  FE F2                   cp  #F2                         ; User forces to check if ESP is installed
     421   00:407F  CA D2 40                jp  z,F2_IS_PRESSED             ; If yes, let's go check it out
     422   00:4082  FE FE                   cp  #FE                         ; Unexpected error from the previous reboot
     423   00:4084  20 10                   jr  nz,BOOT_FROM_POWER_OFF      ; If no one is confirmed, let's proceed as "boot from power off"
     424   00:4086                          ; Oops! An unexpected error occurred on the last reboot
     425   00:4086  21 86 72                ld  hl,STR_OOPS                 ; Print Oops! An unexpected error message
     426   00:4089  CD A5 4C                call    PRINTHL                 ; and let's proceed as "boot from power off"
     427   00:408C  06 78                   ld  b,120                       ; Wait 2 seconds with message on screen
     428   00:408E                      WAIT_2S:
     429   00:408E  76                      halt
     430   00:408F  10 FD                   djnz    WAIT_2S                 ; If not zero, our time out has not elapsed
     431   00:4091  3E 0C                   ld  a,CLS
     432   00:4093  CD A2 00                call    CHPUT
     433   00:4096                      BOOT_FROM_POWER_OFF:
     434   00:4096                          ; Let's intercept [F1] key
     435   00:4096  3E 06                   ld  a,6
     436   00:4098  CD 41 01                call    SNSMAT
     437   00:409B  CB 6F                   bit 5,a                         ; Test [F1]
     438   00:409D  CA 4A 42                jp  z,ENTERING_ESPSETUP         ; If F1 is pressed, let's execute our setup menu
     439   00:40A0                          ; F1 is not pressed, continue
     440   00:40A0  CD F8 62                call    CHECK_ESP_TYPE          ; Always detect ESP type and SSH support
     441   00:40A3                          if  NON_VERBOSE_ROM = 0
     442   00:40A3  CD 3F 62                call    GETESPFLAGS
     443   00:40A6  E6 02                   and ESPFLAG_SSH
     444   00:40A8  21 BD 65                ld  hl,WELCOME
     445   00:40AB  28 03                   jr  z,NOT32_1
     446   00:40AD  21 07 66                ld  hl,WELCOME32
     447   00:40B0                      NOT32_1:
     448   00:40B0  CD A5 4C                call    PRINTHL
     449   00:40B3                          CHECK_QUICK_RECEIVE
     449   00:40B3  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
     449   00:40B6  CB 5F             >     bit 3,a
     450   00:40B8  20 08                   jr  nz,BOOT_FROM_POWER_OFF.1    ; QR Supported
     451   00:40BA  21 71 66                ld  hl,WELCOME_SF2
     452   00:40BD  CD A5 4C                call    PRINTHL
     453   00:40C0  18 06                   jr  BOOT_FROM_POWER_OFF.2
     454   00:40C2                      BOOT_FROM_POWER_OFF.1:
     455   00:40C2  21 55 66                ld  hl,WELCOME_SF
     456   00:40C5  CD A5 4C                call    PRINTHL
     457   00:40C8                      BOOT_FROM_POWER_OFF.2:
     458   00:40C8                          endif
     459   00:40C8  3E 06                   ld  a,6
     460   00:40CA  CD 41 01                call    SNSMAT
     461   00:40CD  CB 77                   bit 6,a                         ; Test [F2]
     462   00:40CF  C2 F6 40                jp  nz,INIT_UNAPI               ; If F2 is not pressed, let's proceed to INIT_UNAPI
     463   00:40D2                          ; F2 is pressed, continue
     464   00:40D2                      F2_IS_PRESSED:
     465   00:40D2  CD 00 64                call    RESET_ESP
     466   00:40D5  B7                      or  a
     467   00:40D6  20 06                   jr  nz,ESP_NOT_FOUND
     468   00:40D8  21 85 71                ld  hl,OK_S                     ; Properly detected
     469   00:40DB  C3 E8 40                jp  INIT_F_MSG                  ; Well, if reset successful, continue
     470   00:40DE                      ESP_NOT_FOUND:
     471   00:40DE                          ; If here, ESP was not found, so, exit with an error message
     472   00:40DE  78                      ld  a,b
     473   00:40DF  B7                      or  a
     474   00:40E0  21 01 72                ld  hl,FAIL_S                   ; If 0, non responsive
     475   00:40E3  28 03                   jr  z,INIT_F_MSG
     476   00:40E5  21 4B 72                ld  hl,FAIL_F                   ; Otherwise, firmware is old
     477   00:40E8                      INIT_F_MSG:
     478   00:40E8  CD A5 4C                call    PRINTHL
     479   00:40EB                      INIT_F_WAIT:
     480   00:40EB  06 B4                   ld  b,180                       ; 3s
     481   00:40ED                      INIT_F_LOOP_WAIT:
     482   00:40ED  76                      halt
     483   00:40EE  10 FD                   djnz    INIT_F_LOOP_WAIT
     484   00:40F0                      AND_DONE:
     485   00:40F0  3E EF                   ld  a,#EF                       ; Set #EF, ESP Not Found
     486   00:40F2                          WRITE_F2                        ; on port #F2
     486   00:40F2  32 05 7F          >     ld  (MEM_PORT_F2),a
     487   00:40F5  C9                      ret                             ; And done
     488   00:40F6                      INIT_UNAPI:
     489   00:40F6                          CLEAR_UART
     489   00:40F6  3E 14             >     ld  a,20
     489   00:40F8  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     490   00:40FB  3E 63                   ld  a,CMD_QUERY_ACLK_SETTINGS
     491   00:40FD                          SEND_DATA
     491   00:40FD  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     492   00:4100  21 3C 00                ld  hl,60                       ; Wait Up To 1s
     493   00:4103  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
     494   00:4107  DD 6B                   ld  ixl,e
     495   00:4109  DD 62                   ld  ixh,d                       ; Address in IX
     496   00:410B  CD 7D 4B                call    WAIT_MENU_CMD_RESPONSE
     497   00:410E  CA A5 41                jp  z,INIT_NOCLOCKUPDATE        ; If error, just skip
     498   00:4111                          ; Response received, IX+0 and IX+1 has Auto Clock and GMT
     499   00:4111  3E 03                   ld  a,3
     500   00:4113  DD BE 00                cp  (ix+0)
     501   00:4116  20 0B                   jr  nz,INIT_UNAPI2              ; If not disabled continue on INIT_UNAPI2
     502   00:4118                          ; Disabled, ok, so let's ensure connection is not locked (just in case it was setup as disabled right now)
     503   00:4118                          CLEAR_UART
     503   00:4118  3E 14             >     ld  a,20
     503   00:411A  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     504   00:411D  3E 68                   ld  a,CMD_WIFIRELEASE_ESP
     505   00:411F                          SEND_DATA                       ; Just send, no need to wait response
     505   00:411F  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     506   00:4122  C9                      ret
     507   00:4123                      INIT_UNAPI2:
     508   00:4123  3A 2D 00                ld  a,(#002D)                   ; Check MSX Version
     509   00:4126  B7                      or  a
     510   00:4127  28 7C                   jr  z,INIT_NOCLOCKUPDATE        ; If zero, MSX1, can't set clock
     511   00:4129  AF                      xor a
     512   00:412A  DD B6 00                or  (ix+0)
     513   00:412D  28 76                   jr  z,INIT_NOCLOCKUPDATE        ; if turned off, skip
     514   00:412F                          ; Ok, not zero, so we are going to simply request the time, it might take up to 10s
     515   00:412F  DD 23                   inc ix
     516   00:4131  DD 23                   inc ix                          ; ok, leave IX+0 and IX+1 intact
     517   00:4133                          ; b = number of response check attempts
     518   00:4133  06 05                   ld  b,5                         ; 5 * 2s = 10s
     519   00:4135                          CLEAR_UART
     519   00:4135  3E 14             >     ld  a,20
     519   00:4137  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     520   00:413A  3E 47                   ld  a,CMD_GET_TIME
     521   00:413C                          SEND_DATA
     521   00:413C  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     522   00:413F                      TRY_AGAIN:
     523   00:413F  C5                      push    bc
     524   00:4140  21 78 00                ld  hl,120                      ; Wait Up To 2s per attempt
     525   00:4143  CD 7D 4B                call    WAIT_MENU_CMD_RESPONSE
     526   00:4146  20 1E                   jr  nz,INIT_CLOCKUPDATE         ; if ok, follow up
     527   00:4148  21 66 72                ld  hl,STR_WAITING              ; Print Waiting for connection message
     528   00:414B  CD A5 4C                call    PRINTHL
     529   00:414E  3E FF                   ld  a,#ff
     530   00:4150  B8                      cp  b                           ; Was time-out the failure reason?
     531   00:4151  C1                      pop bc                          ; Restore stack ballance and retry counter
     532   00:4152  20 04                   jr  nz,STOP_TRYING              ; If error return code and not time-out, no more checks needed
     533   00:4154  3E 47                   ld  a,CMD_GET_TIME              ; Needed for retries
     534   00:4156  10 E7                   djnz    TRY_AGAIN
     535   00:4158                      STOP_TRYING:
     536   00:4158                          ; Leave a message that clock has not been updated
     537   00:4158  21 17 71                ld  hl,STR_CLKUPDT_FAIL
     538   00:415B  CD A5 4C                call    PRINTHL
     539   00:415E  3E F0                   ld  a,240                       ; Wait 4 seconds with message on screen
     540   00:4160                      WAIT_4S:
     541   00:4160  76                      halt
     542   00:4161  3D                      dec a
     543   00:4162                          ; If not zero, our time out has not elapsed
     544   00:4162  20 FC                   jr  nz,WAIT_4S
     545   00:4164  18 3F                   jr  INIT_NOCLOCKUPDATE          ; error, just skip to not set garbage in clock
     546   00:4166                      INIT_CLOCKUPDATE:
     547   00:4166  C1                      pop bc
     548   00:4167  DD 2B                   dec ix
     549   00:4169  DD 2B                   dec ix                          ; ix back where it should
     550   00:416B                          ; ix + 0 -> 0 If no need to set clock, 1 if set clock, 2 if set clock and request to turn Wi-Fi Off
     551   00:416B                          ; ix + 1 -> GMT setting, well, not going to use it
     552   00:416B                          ; ix + 2 -> Seconds
     553   00:416B                          ; ix + 3 -> Minutes
     554   00:416B                          ; ix + 4 -> Hours
     555   00:416B                          ; ix + 5 -> Day
     556   00:416B                          ; ix + 6 -> Month
     557   00:416B                          ; ix + 7 -> Year LSB
     558   00:416B                          ; ix + 8 -> Year MSB
     559   00:416B  DD 66 04                ld  h,(ix+4)
     560   00:416E  DD 6E 03                ld  l,(ix+3)
     561   00:4171  DD 56 02                ld  d,(ix+2)
     562   00:4174  CD 43 64                call    SET_TIME
     563   00:4177  20 2C                   jr  nz,INIT_NOCLOCKUPDATE       ; if error, just skip
     564   00:4179  DD 66 08                ld  h,(ix+8)
     565   00:417C  DD 6E 07                ld  l,(ix+7)
     566   00:417F  DD 56 06                ld  d,(ix+6)
     567   00:4182  DD 5E 05                ld  e,(ix+5)
     568   00:4185  CD 70 64                call    SET_DATE
     569   00:4188  3E 02                   ld  a,2
     570   00:418A  DD BE 00                cp  (ix+0)
     571   00:418D  20 16                   jr  nz,INIT_NOCLOCKUPDATE
     572   00:418F                          ; First, release any hold to Wi-Fi Connection
     573   00:418F                          CLEAR_UART
     573   00:418F  3E 14             >     ld  a,20
     573   00:4191  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     574   00:4194  3E 68                   ld  a,CMD_WIFIRELEASE_ESP
     575   00:4196                          SEND_DATA                       ; Just send, no need to wait response
     575   00:4196  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     576   00:4199                          ; And, turn off Wi-Fi Immediatelly
     577   00:4199                          CLEAR_UART
     577   00:4199  3E 14             >     ld  a,20
     577   00:419B  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     578   00:419E  3E 4F                   ld  a,CMD_WIFI_OFF
     579   00:41A0                          SEND_DATA                       ; Just send, no need to wait response
     579   00:41A0  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     580   00:41A3  18 0A                   jr  INIT_NOCLOCKUPDAT2
     581   00:41A5                      INIT_NOCLOCKUPDATE:
     582   00:41A5                          ; Release any hold to Wi-Fi Connection
     583   00:41A5                          CLEAR_UART
     583   00:41A5  3E 14             >     ld  a,20
     583   00:41A7  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     584   00:41AA  3E 68                   ld  a,CMD_WIFIRELEASE_ESP
     585   00:41AC                          SEND_DATA                       ; Just send, no need to wait response
     585   00:41AC  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     586   00:41AF                      INIT_NOCLOCKUPDAT2:
     587   00:41AF                          ; Save existing EXTBIO hook if it exists
     588   00:41AF  3A 20 FB                ld  a,(HOKVLD)
     589   00:41B2  CB 47                   bit 0,a
     590   00:41B4  20 18                   jr  nz,SAVE_HOOK2               ; HOKVLD tells us if there is an extended BIOS already or not, if yes, save it
     591   00:41B6                          ; If here, no extended BIOS, initialize EXTBIO, H.BGFD and H.ENFD
     592   00:41B6  21 CA FF                ld  hl,EXTBIO
     593   00:41B9  11 CB FF                ld  de,EXTBIO+1
     594   00:41BC  01 0E 00                ld  bc,15-1
     595   00:41BF  36 C9                   ld  (hl),#C9
     596   00:41C1  ED B0                   ldir
     597   00:41C3                          ; No previous hook, work area byte 0 = RET
     598   00:41C3  CD 9E 60                call    GETSLT
     599   00:41C6  CD F7 60                call    GETWRK                  ; Our ROM work area address is at HL (we can use up to 8 bytes)
     600   00:41C9  3E C9                   ld  a,#c9                       ; RET, as we are the first extended BIOS
     601   00:41CB  77                      ld  (hl),a
     602   00:41CC  18 13                   jr  PATCH                       ; And now all we need to do is patch the EXTBIO hook :)
     603   00:41CE                      
     604   00:41CE                      SAVE_HOOK2:
     605   00:41CE                          ; If here, we are not the first to extend bios, so we need to save the previous one
     606   00:41CE  CD 9E 60                call    GETSLT
     607   00:41D1  CD F7 60                call    GETWRK                  ; Our ROM work area address is at HL (we can use up to 8 bytes)
     608   00:41D4  EB                      ex  de,hl                       ; It is the destination for....
     609   00:41D5  21 CA FF                ld  hl,EXTBIO                   ; The actual EXTBIO hook
     610   00:41D8  01 05 00                ld  bc,5                        ; That is 5 bytes large
     611   00:41DB  ED B0                   ldir                            ; And move to our work area
     612   00:41DD  AF                      xor a
     613   00:41DE  12                      ld  (de),a                      ; Not initialized (de is at the sixth byte) of our slot work area
     614   00:41DF  13                      inc de
     615   00:41E0  12                      ld  (de),a                      ; Not initialized (de is at the seventh byte) of our slot work area
     616   00:41E1                      
     617   00:41E1                          ; Patch EXTBIO
     618   00:41E1                      PATCH:
     619   00:41E1  3E F7                   ld  a,#F7                       ; RST #30
     620   00:41E3  32 CA FF                ld  (EXTBIO),a                  ; In EXTBIO hook
     621   00:41E6  CD 9E 60                call    GETSLT                  ; Our Slot in A
     622   00:41E9  32 CB FF                ld  (EXTBIO+1),a                ; Next EXTBIO hook byte
     623   00:41EC  21 FA 4C                ld  hl,DO_EXTBIO                ; Our EXTBIO routine address
     624   00:41EF  22 CC FF                ld  (EXTBIO+2),hl               ; Goes to the following two bytes in the hook
     625   00:41F2                      
     626   00:41F2  3E C9                   ld  a,#C9                       ; EXTBIO hook 5th byte must be RET
     627   00:41F4  32 CE FF                ld  (EXTBIO+4),a                ; (H.BGFD/H.ENFD follow at +5, keep them)
     628   00:41F7                      
     629   00:41F7  21 20 FB                ld  hl,HOKVLD
     630   00:41FA  CB C6                   set 0,(hl)                      ; And set HOKVLD properly to indicate an EXTBIOS is installed
     631   00:41FC                      INIT_OK:
     632   00:41FC                          if  NON_VERBOSE_ROM = 0
     633   00:41FC  CD A0 63                call    PRINT_INSTALLED_MSG     ; All done and set, nice exit message
     634   00:41FF                          endif
     635   00:41FF  3E F0                   ld  a,#F0                       ; Set #F0, UNAPI driver has been loaded at least once
     636   00:4201                          WRITE_F2
     636   00:4201  32 05 7F          >     ld  (MEM_PORT_F2),a
     637   00:4204  C9                      ret
     638   00:4205                      
     639   00:4205                      ;==============================
     640   00:4205                      ;===  TPA Memory Allocation  ==
     641   00:4205                      ;==============================
     642   00:4205                      HIMEM_ALLOC:
     643   00:4205                          ; Now let's reserve memory in the 4th page for our usage
     644   00:4205  2A 4A FC                ld hl,(HIMEM)                   ; Get HIMEM
     645   00:4208  B7                      or  a                           ; Clear Carry
     646   00:4209  11 1E 00                ld  de,HIMEM_RESERVED_SIZE      ; Reserve How much memory we need
     647   00:420C  ED 52                   sbc hl,de                       ; New HIMEM
     648   00:420E  22 4A FC                ld  (HIMEM),hl                  ; Save it
     649   00:4211  23                      inc hl                          ; To be safe
     650   00:4212  EB                      ex  de,hl                       ; now in DE
     651   00:4213  CD 9E 60                call    GETSLT
     652   00:4216  CD 0B 61                call    GETMEMPOINTERADDR       ; This is where we are going to store our memory area address
     653   00:4219                          ; GETSLT and GETMEMPOINTER do not change DE, so it still has the our memory area address
     654   00:4219  73                      ld  (hl),e
     655   00:421A  23                      inc hl
     656   00:421B  72                      ld  (hl),d                      ; And save our memory area there
     657   00:421C                          ; Ok, DE has our memory area, let's save old H_TIMI hook there
     658   00:421C  21 9F FD                ld  hl,H_TIMI                   ; The actual H_TIMI hook
     659   00:421F  01 05 00                ld  bc,5                        ; That is 5 bytes large
     660   00:4222  ED B0                   ldir                            ; And move to our memory area
     661   00:4224  F3                      di                              ; Turn of interrupts as we are going to patch H_TIMI
     662   00:4225                      PATCH_H_TIMI:
     663   00:4225  3E F7                   ld  a,#F7                       ; RST #30
     664   00:4227  32 9F FD                ld  (H_TIMI),a                  ; In H_TIMI hook
     665   00:422A  CD 9E 60                call    GETSLT                  ; Our Slot in A
     666   00:422D  32 A0 FD                ld  (H_TIMI+1),a                ; Next H_TIMI hook byte
     667   00:4230  21 E6 4C                ld  hl,DO_HTIMI                 ; Our H_TIMI routine address
     668   00:4233  22 A1 FD                ld  (H_TIMI+2),hl               ; Goes to the following two bytes in the hook
     669   00:4236  FB                      ei                              ; done, so re-enable interrupts
     670   00:4237                      
     671   00:4237                          ; Set DNS_READY to zero
     672   00:4237  AF                      xor a
     673   00:4238  CD 63 62                call    SETDNSREADY
     674   00:423B                          ; Set TIME-OUT counter to zero
     675   00:423B  21 00 00                ld  hl,0
     676   00:423E  CD 3E 61                call    SETCOUNTER
     677   00:4241  C9                      ret
     678   00:4242                      
     679   00:4242                      ;============================
     680   00:4242                      ;===  SETUP Menu Routines  ==
     681   00:4242                      ;===       Main Menu       ==
     682   00:4242                      ;============================
     683   00:4242                      ESPSETUP.EXIT:
     684   00:4242  3E 0C                   ld  a,CLS
     685   00:4244  CD A2 00                call    CHPUT
     686   00:4247  C3 F6 40                jp  INIT_UNAPI                  ; When done, resume initialization
     687   00:424A                      ENTERING_ESPSETUP:
     688   00:424A  21 A1 65                ld  hl,ENTERING_WIFI_SETUP
     689   00:424D  CD A5 4C                call    PRINTHL
     690   00:4250  CD 0A 65                call    PATTERN_SETUP
     691   00:4253  CD 1E 4A                call    WAIT_250MS_AND_THEN_CONTINUE
     692   00:4256                          ; Hold Wi-Fi Connection On
     693   00:4256                          CLEAR_UART
     693   00:4256  3E 14             >     ld  a,20
     693   00:4258  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     694   00:425B  3E 48                   ld  a,CMD_WIFIHOLD_ESP
     695   00:425D                          SEND_DATA
     695   00:425D  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     696   00:4260  21 3C 00                ld  hl,60                       ; Up to 1s time-out
     697   00:4263  CD 7D 4B                call    WAIT_MENU_CMD_RESPONSE  ; Wait response
     698   00:4266                          ; We do not want to error here, just in case user still need to upgrade ESP firmware
     699   00:4266                      ESPSETUP:
     700   00:4266  CD 00 64                call    RESET_ESP
     701   00:4269  B7                      or  a
     702   00:426A  C2 DE 40                jp  nz,ESP_NOT_FOUND            ; Not well, ESP was not found
     703   00:426D                          ; Well, if reset successful, continue
     704   00:426D  CD F8 62                call    CHECK_ESP_TYPE          ; Detect ESP type and SSH support
     705   00:4270  CD 3F 62                call    GETESPFLAGS
     706   00:4273  E6 02                   and ESPFLAG_SSH
     707   00:4275  21 BD 65                ld  hl,WELCOME
     708   00:4278  28 03                   jr  z,NOT32_2
     709   00:427A  21 07 66                ld  hl,WELCOME32
     710   00:427D                      NOT32_2:
     711   00:427D  CD A5 4C                call    PRINTHL
     712   00:4280                          CHECK_QUICK_RECEIVE
     712   00:4280  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
     712   00:4283  CB 5F             >     bit 3,a
     713   00:4285  20 08                   jr  nz,ESPSETUP.2NF             ; If yes, tells Quick Receive support
     714   00:4287  21 71 66                ld  hl,WELCOME_SF2
     715   00:428A  CD A5 4C                call    PRINTHL                 ; Print Welcome message no QR
     716   00:428D  18 06                   jr  ESPSETUP.3NF
     717   00:428F                      ESPSETUP.2NF:
     718   00:428F  21 55 66                ld  hl,WELCOME_SF
     719   00:4292  CD A5 4C                call    PRINTHL                 ; Print Welcome message QR
     720   00:4295                      ESPSETUP.3NF:
     721   00:4295  21 91 66                ld  hl,WELCOME_CS
     722   00:4298  CD A5 4C                call    PRINTHL                 ; Print Wi-Fi is reconnecting to:
     723   00:429B                      ESPSETUP_NEXT:
     724   00:429B  CD 56 01                call    KILBUF                  ; Clear Keyboard Buffer
     725   00:429E  21 BB 66                ld  hl,WELCOME_NEXT
     726   00:42A1  CD A5 4C                call    PRINTHL
     727   00:42A4  21 C5 66                ld  hl,WELCOME_SF_NEXT
     728   00:42A7  CD A5 4C                call    PRINTHL                 ; Print Empty Welcome message
     729   00:42AA  CD 40 43                call    GET_AP_STAT
     730   00:42AD  CA E5 42                jp  z,ESPSETUP_NEXT.1G          ; Won't block in case of error
     731   00:42B0                          ; Success, so connection state is in IX+0, then, zero terminated string with SSID starting at IX+1
     732   00:42B0  DD 7E 00                ld  a,(ix+0)
     733   00:42B3  21 C8 66                ld  hl,WELCOME_CS0_NEXT
     734   00:42B6  FE 00                   cp  0
     735   00:42B8  28 1F                   jr  z,ESPSETUP_NEXT.2F
     736   00:42BA  21 F2 66                ld  hl,WELCOME_CS1_NEXT
     737   00:42BD  FE 01                   cp  1
     738   00:42BF  28 18                   jr  z,ESPSETUP_NEXT.2F
     739   00:42C1  21 FB 66                ld  hl,WELCOME_CS2_NEXT
     740   00:42C4  FE 02                   cp  2
     741   00:42C6  28 11                   jr  z,ESPSETUP_NEXT.2F
     742   00:42C8  21 25 67                ld  hl,WELCOME_CS3_NEXT
     743   00:42CB  FE 03                   cp  3
     744   00:42CD  28 0A                   jr  z,ESPSETUP_NEXT.2F
     745   00:42CF  21 4F 67                ld  hl,WELCOME_CS4_NEXT
     746   00:42D2  FE 04                   cp  4
     747   00:42D4  28 03                   jr  z,ESPSETUP_NEXT.2F
     748   00:42D6  21 79 67                ld  hl,WELCOME_CS5_NEXT
     749   00:42D9                      ESPSETUP_NEXT.2F:
     750   00:42D9  FD 67                   ld  iyh,a                       ; Save current conn status in iyh
     751   00:42DB  CD A5 4C                call    PRINTHL                 ; Print Status
     752   00:42DE  DD E5                   push    ix
     753   00:42E0  E1                      pop hl
     754   00:42E1  23                      inc hl                          ; HL has AP Name
     755   00:42E2  CD AF 4C                call    PRINTHLINE              ; Print AP Name
     756   00:42E5                      ESPSETUP_NEXT.1G:
     757   00:42E5  21 A3 67                ld  hl,MMENU_S_NEXT
     758   00:42E8  CD A5 4C                call    PRINTHL                 ; Print Main Menu
     759   00:42EB                      MM_CURSOR_BLINK:
     760   00:42EB  CD 2C 43                call    MM_CURSOR_SW            ; Cursor On
     761   00:42EE                      CONN_CHG_LOOP:
     762   00:42EE  CD 9C 00                call    CHSNS
     763   00:42F1  20 13                   jr  nz,MM_WAIT_INPUT            ; If not zero, there is a key in buffer
     764   00:42F3                          ; Ok, there is not, we can check if connection status changed
     765   00:42F3  CD 40 43                call    GET_AP_STAT
     766   00:42F6  CA EE 42                jp  z,CONN_CHG_LOOP             ; Won't block in case of error
     767   00:42F9                          ; Success, so connection state is in IX+0
     768   00:42F9  DD 7E 00                ld  a,(ix+0)
     769   00:42FC  FD BC                   cp  iyh                         ; If same, zero
     770   00:42FE  28 EE                   jr  z,CONN_CHG_LOOP             ; Keep loop
     771   00:4300  CD 2C 43                call    MM_CURSOR_SW            ; Cursor Off
     772   00:4303  C3 9B 42                jp  ESPSETUP_NEXT               ; Changed, re-build menu
     773   00:4306                      MM_WAIT_INPUT:
     774   00:4306  CD 9F 00                call    CHGET
     775   00:4309  FE 1B                   cp  #1b                         ; ESC?
     776   00:430B  CA 42 42                jp  z,ESPSETUP.EXIT             ; When done, resume initialization
     777   00:430E  FE 31                   cp  '1'                         ; Setup Nagle?
     778   00:4310  CA 03 49                jp  z,SET_NAGLE
     779   00:4313  FE 32                   cp  '2'                         ; Setup Wi-Fi On Period?
     780   00:4315  CA 3D 48                jp  z,SET_WIFI_TIMEOUT
     781   00:4318  FE 33                   cp  '3'                         ; Scan networks?
     782   00:431A  CA 8D 45                jp  z,START_WIFI_SCAN
     783   00:431D  FE 34                   cp  '4'                         ; Automatic Setting of Clock?
     784   00:431F  CA A9 43                jp  z,START_CLK_AUTO
     785   00:4322  CD C0 00                call    BEEP                    ; Wrong Input, beep
     786   00:4325  CD 2C 43                call    MM_CURSOR_SW            ; Cursor Off
     787   00:4328  76                      halt
     788   00:4329  C3 EB 42                jp  MM_CURSOR_BLINK             ; And return, waiting another key
     789   00:432C                      MM_CURSOR_SW:                       ; Cursor workaround for CONN_CHG_LOOP
     790   00:432C  3E 1D                   ld  a,GOLEFT
     791   00:432E  CD A2 00                call    CHPUT
     792   00:4331  3E 01                   ld  a,1
     793   00:4333  32 A9 FC                ld  (CSRSW),a
     794   00:4336  3E 20                   ld  a,' '
     795   00:4338  CD A2 00                call    CHPUT                   ; Switch the cursor display mode
     796   00:433B  AF                      xor a
     797   00:433C  32 A9 FC                ld  (CSRSW),a
     798   00:433F  C9                      ret
     799   00:4340                      GET_AP_STAT:                        ; Use 'call GET_AP_STAT'
     800   00:4340                          CLEAR_UART
     800   00:4340  3E 14             >     ld  a,20
     800   00:4342  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     801   00:4345  3E 67                   ld  a,CMD_AP_STS
     802   00:4347                          SEND_DATA                       ; Get AP conn status and name
     802   00:4347  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     803   00:434A  21 3C 00                ld  hl,60                       ; Wait Up To 1s
     804   00:434D  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
     805   00:4351  DD 6B                   ld  ixl,e
     806   00:4353  DD 62                   ld  ixh,d                       ; Address in IX
     807   00:4355  C3 7D 4B                jp  WAIT_MENU_CMD_RESPONSE
     808   00:4358                      
     809   00:4358                      ;============================
     810   00:4358                      ;===  SETUP Menu Routines  ==
     811   00:4358                      ;===  Wi-Fi and Clock Menu ==
     812   00:4358                      ;============================
     813   00:4358                      CLK_MSX1_GO:
     814   00:4358  21 92 69                ld  hl,MMENU_CLOCK_MSX1
     815   00:435B  CD A5 4C                call    PRINTHL                 ; Print Main Clock MSX1 message
     816   00:435E  CD 25 4A                call    ISCLKAUTO
     817   00:4361  DD 7E 00                ld  a,(ix+0)                    ; Auto Clock Current setting
     818   00:4364  FE 03                   cp  3                           ; If 3 adapter disabled
     819   00:4366  28 08                   jr  z,CLK_MSX1_ADAPTERDIS
     820   00:4368  21 26 6A                ld  hl,MMENU_CLOCK_0
     821   00:436B  CD A5 4C                call    PRINTHL
     822   00:436E  18 06                   jr  CLK_MSX1_OPT
     823   00:4370                      CLK_MSX1_ADAPTERDIS:
     824   00:4370  21 6C 6A                ld  hl,MMENU_CLOCK_3
     825   00:4373  CD A5 4C                call    PRINTHL
     826   00:4376                      CLK_MSX1_OPT:
     827   00:4376  21 7F 6A                ld  hl,MMENU_CLOCK_OPT
     828   00:4379  CD A5 4C                call    PRINTHL
     829   00:437C                      CLK_MSX1_WAIT_OPT_INPUT:
     830   00:437C  CD 9F 00                call    CHGET
     831   00:437F  FE 1B                   cp  #1b                         ; ESC?
     832   00:4381  CA 66 42                jp  z,ESPSETUP                  ; Back to main menu
     833   00:4384  FE 30                   cp  '0'
     834   00:4386  CA 94 43                jp  z,CLK_MSX1_SEND_CMD
     835   00:4389  FE 33                   cp  '3'
     836   00:438B  CA 50 44                jp  z,CLK_AUTO_WAIT_GMT
     837   00:438E  CD C0 00                call    BEEP                    ; Wrong Input, beep
     838   00:4391  C3 7C 43                jp  CLK_MSX1_WAIT_OPT_INPUT     ; And return, waiting another key
     839   00:4394                      CLK_MSX1_SEND_CMD:
     840   00:4394  CD A2 00                call    CHPUT                   ; Print option
     841   00:4397  D6 30                   sub '0'                         ; Adjust format
     842   00:4399  DD 77 00                ld  (ix+0),a                    ; Save it
     843   00:439C  3E 0D                   ld  a,#0d
     844   00:439E  CD A2 00                call    CHPUT
     845   00:43A1  3E 0A                   ld  a,#0a
     846   00:43A3  CD A2 00                call    CHPUT
     847   00:43A6  C3 47 45                jp  CLK_AUTO_GMT_CHK_DONE       ; And sending the command will be done there
     848   00:43A9                      
     849   00:43A9                      START_CLK_AUTO:
     850   00:43A9  3E 34                   ld  a,'4'
     851   00:43AB  CD A2 00                call    CHPUT
     852   00:43AE  CD 1E 4A                call    WAIT_250MS_AND_THEN_CONTINUE
     853   00:43B1  3A 2D 00                ld  a,(#002D)                   ; Check MSX Version
     854   00:43B4  B7                      or  a
     855   00:43B5  CA 58 43                jp  z,CLK_MSX1_GO               ; If zero, MSX1, so can just enable or disable adapter
     856   00:43B8                      CLK_AUTO_GO:
     857   00:43B8  21 32 68                ld  hl,MMENU_CLOCK_MSX2
     858   00:43BB  CD A5 4C                call    PRINTHL                 ; Print Main Clock MSX2 message
     859   00:43BE  CD 25 4A                call    ISCLKAUTO
     860   00:43C1  DD 7E 00                ld  a,(ix+0)                    ; Auto Clock Current setting
     861   00:43C4  B7                      or  a                           ; If zero, off
     862   00:43C5  20 08                   jr  nz,CLK_AUTO_CHK1
     863   00:43C7  21 26 6A                ld  hl,MMENU_CLOCK_0
     864   00:43CA  CD A5 4C                call    PRINTHL
     865   00:43CD  18 59                   jr  CLK_AUTO_GMT_OPT
     866   00:43CF                      CLK_AUTO_CHK1:
     867   00:43CF  3D                      dec a                           ; If 1, on and keep wifi on
     868   00:43D0  20 08                   jr  nz,CLK_AUTO_CHK2
     869   00:43D2  21 38 6A                ld  hl,MMENU_CLOCK_1
     870   00:43D5  CD A5 4C                call    PRINTHL
     871   00:43D8  18 13                   jr  CLK_AUTO_GMT
     872   00:43DA                      CLK_AUTO_CHK2:
     873   00:43DA  3D                      dec a                           ; If 2, on and turn wifi off
     874   00:43DB  20 08                   jr  nz,CLK_AUTO_3
     875   00:43DD  21 52 6A                ld  hl,MMENU_CLOCK_2
     876   00:43E0  CD A5 4C                call    PRINTHL
     877   00:43E3  18 08                   jr  CLK_AUTO_GMT
     878   00:43E5                      CLK_AUTO_3:
     879   00:43E5  21 6C 6A                ld  hl,MMENU_CLOCK_3
     880   00:43E8  CD A5 4C                call    PRINTHL
     881   00:43EB  18 3B                   jr  CLK_AUTO_GMT_OPT
     882   00:43ED                      CLK_AUTO_GMT:
     883   00:43ED  DD 66 01                ld  h,(ix+1)                    ; Save it for now
     884   00:43F0  DD 7E 01                ld  a,(ix+1)                    ; GMT current setting
     885   00:43F3  CB 7F                   bit 7,a                         ; If set, is -
     886   00:43F5  28 0B                   jr  z,CLK_AUTO_GMTP
     887   00:43F7  3E 2D                   ld  a,'-'
     888   00:43F9  CD A2 00                call    CHPUT
     889   00:43FC  DD CB 01 BE             res 7,(ix+1)                    ; Clear - indicator
     890   00:4400  18 05                   jr  CLK_AUTO_GMTM
     891   00:4402                      CLK_AUTO_GMTP:
     892   00:4402  3E 2B                   ld  a,'+'
     893   00:4404  CD A2 00                call    CHPUT
     894   00:4407                      CLK_AUTO_GMTM:
     895   00:4407  3E 09                   ld  a,9
     896   00:4409  DD BE 01                cp  (ix+1)                      ; Greater than 9?
     897   00:440C  30 0F                   jr  nc,CLK_AUTO_GMTD            ; If not, just print what is in A + '0'
     898   00:440E  3E 31                   ld  a,'1'                       ; It is 1
     899   00:4410  CD A2 00                call    CHPUT
     900   00:4413  DD 7E 01                ld  a,(ix+1)
     901   00:4416  C6 26                   add '0'-10                      ; Need to subtract 10 and add '0' to print
     902   00:4418  CD A2 00                call    CHPUT
     903   00:441B  18 0B                   jr  CLK_AUTO_GMT_OPT
     904   00:441D                      CLK_AUTO_GMTD:
     905   00:441D  3E 30                   ld  a,'0'
     906   00:441F  DD 86 01                add a,(ix+1)                    ; Our value
     907   00:4422  CD A2 00                call    CHPUT
     908   00:4425  DD 74 01                ld  (ix+1),h                    ; Restore original value
     909   00:4428                      CLK_AUTO_GMT_OPT:
     910   00:4428  21 7F 6A                ld  hl,MMENU_CLOCK_OPT
     911   00:442B  CD A5 4C                call    PRINTHL
     912   00:442E                      CLK_AUTO_WAIT_OPT_INPUT:
     913   00:442E  CD 9F 00                call    CHGET
     914   00:4431  FE 1B                   cp  #1b                         ; ESC?
     915   00:4433  CA 66 42                jp  z,ESPSETUP                  ; Back to main menu
     916   00:4436  FE 30                   cp  '0'
     917   00:4438  CA 50 44                jp  z,CLK_AUTO_WAIT_GMT
     918   00:443B  FE 31                   cp  '1'
     919   00:443D  CA 50 44                jp  z,CLK_AUTO_WAIT_GMT
     920   00:4440  FE 32                   cp  '2'
     921   00:4442  CA 50 44                jp  z,CLK_AUTO_WAIT_GMT
     922   00:4445  FE 33                   cp  '3'
     923   00:4447  CA 50 44                jp  z,CLK_AUTO_WAIT_GMT
     924   00:444A  CD C0 00                call    BEEP                    ; Wrong Input, beep
     925   00:444D  C3 2E 44                jp  CLK_AUTO_WAIT_OPT_INPUT     ; And return, waiting another key
     926   00:4450                      CLK_AUTO_WAIT_GMT:
     927   00:4450  CD A2 00                call    CHPUT                   ; Print option
     928   00:4453  D6 30                   sub '0'                         ; Adjust format
     929   00:4455  DD 77 00                ld  (ix+0),a                    ; Save it
     930   00:4458  B7                      or  a
     931   00:4459  CA 47 45                jp  z,CLK_AUTO_GMT_CHK_DONE     ; And send the command if just disabling clock auto set
     932   00:445C  FE 03                   cp  3
     933   00:445E  CA 47 45                jp  z,CLK_AUTO_GMT_CHK_DONE     ; Or send the command if just disabling the adapter
     934   00:4461  21 A9 6A                ld  hl,MMENU_GMT_OPT
     935   00:4464  CD A5 4C                call    PRINTHL
     936   00:4467  16 00                   ld  d,0                         ; # of digits entered
     937   00:4469  1E 00                   ld  e,0                         ; # of characters printed
     938   00:446B  DD 36 01 00             ld  (ix+1),0                    ; GMT 0
     939   00:446F                      CLK_AUTO_WAIT_GMT_INPUT:
     940   00:446F  CD 9F 00                call    CHGET
     941   00:4472  FE 1B                   cp  #1b                         ; ESC?
     942   00:4474  CA 66 42                jp  z,ESPSETUP                  ; Back to main menu
     943   00:4477  FE 0D                   cp  #0d                         ; ENTER?
     944   00:4479  CA C2 44                jp  z,CLK_AUTO_GMT_CHK_INPUT    ; Check if ok to send command
     945   00:447C  FE 08                   cp  #08                         ; Backspace?
     946   00:447E  CA 93 44                jp  z,CLK_AUTO_GMT_CHK_BS       ; Check if there is something to erase
     947   00:4481  FE 2D                   cp  '-'                         ; Negative value?
     948   00:4483  CA C2 44                jp  z,CLK_AUTO_GMT_CHK_INPUT
     949   00:4486  FE 30                   cp  '0'                         ; >=0?
     950   00:4488  DA B4 44                jp  c,CLK_AUTO_GMT_BAD_INPUT    ; If not, bad input
     951   00:448B  FE 3A                   cp  '9'+1                       ; <= 9
     952   00:448D  D2 B4 44                jp  nc,CLK_AUTO_GMT_BAD_INPUT   ; If not, bad input
     953   00:4490  C3 C2 44                jp  CLK_AUTO_GMT_CHK_INPUT      ; Otherwise, validate digit
     954   00:4493                      CLK_AUTO_GMT_CHK_BS:
     955   00:4493  AF                      xor a
     956   00:4494  BB                      cp  e                           ; Anything on screen?
     957   00:4495  28 1D                   jr  z,CLK_AUTO_GMT_BAD_INPUT    ; Nothing to erase
     958   00:4497  1D                      dec e                           ; One less character on the screen
     959   00:4498  BA                      cp  d                           ; Any digit?
     960   00:4499  28 03                   jr  z,CLK_AUTO_GMT_CHK_BS_MIN   ; If not, just erase - sign
     961   00:449B                          ; There is, so it is one less digit
     962   00:449B  15                      dec d
     963   00:449C  18 04                   jr  CLK_AUTO_GMT_CHK_DIGIT
     964   00:449E                      CLK_AUTO_GMT_CHK_BS_MIN:
     965   00:449E  DD 36 01 00             ld  (ix+1),0                    ; Reset sign
     966   00:44A2                      CLK_AUTO_GMT_CHK_DIGIT:
     967   00:44A2  3E 08                   ld  a,8                         ; Backspace
     968   00:44A4  CD A2 00                call    CHPUT                   ; Print it
     969   00:44A7  3E 20                   ld  a,' '                       ; Space
     970   00:44A9  CD A2 00                call    CHPUT                   ; Print it
     971   00:44AC  3E 08                   ld  a,8                         ; Backspace
     972   00:44AE  CD A2 00                call    CHPUT                   ; Print it
     973   00:44B1  C3 6F 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; Return
     974   00:44B4                      CLK_AUTO_GMT_BAD_INPUT:
     975   00:44B4                          ; Beep might use sub rom, and if so, all registers will be messed up, better save
     976   00:44B4  C5                      push    bc
     977   00:44B5  D5                      push    de
     978   00:44B6  F5                      push    af
     979   00:44B7  E5                      push    hl
     980   00:44B8  CD C0 00                call    BEEP                    ; Wrong Input, beep
     981   00:44BB  E1                      pop hl
     982   00:44BC  F1                      pop af
     983   00:44BD  D1                      pop de
     984   00:44BE  C1                      pop bc
     985   00:44BF  C3 6F 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; And return, waiting another key
     986   00:44C2                      CLK_AUTO_GMT_CHK_INPUT:
     987   00:44C2  4F                      ld  c,a                         ; Save in C for printing if needed
     988   00:44C3  FE 2D                   cp  '-'                         ; - sign?
     989   00:44C5  20 11                   jr  nz,CLK_AUTO_GMT_CHK_CR      ; If not, check if enter
     990   00:44C7                          ; - sign
     991   00:44C7  3E 00                   ld  a,0
     992   00:44C9  BB                      cp  e                           ; If not the first character, can't accept
     993   00:44CA  20 E8                   jr  nz,CLK_AUTO_GMT_BAD_INPUT
     994   00:44CC                          ; It is the first, so let's print it
     995   00:44CC  79                      ld  a,c
     996   00:44CD  CD A2 00                call    CHPUT
     997   00:44D0  DD 36 01 80             ld  (ix+1),0x80                 ; Set the - sign bit, for now rest is zero
     998   00:44D4  1C                      inc e                           ; Increase # of characters printed
     999   00:44D5  C3 6F 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; Continue waiting input
    1000   00:44D8                      CLK_AUTO_GMT_CHK_CR:
    1001   00:44D8  FE 0D                   cp  #0d                         ; ENTER?
    1002   00:44DA  20 0F                   jr  nz,CLK_AUTO_GMT_CHK_CD      ; If not, check if digit is valid
    1003   00:44DC                          ; Enter
    1004   00:44DC  3E 00                   ld  a,0
    1005   00:44DE  BA                      cp  d                           ; Ok, at least one digit entered?
    1006   00:44DF  28 D3                   jr  z,CLK_AUTO_GMT_BAD_INPUT    ; No, so, enter is no good now
    1007   00:44E1                          ; It is, if it had a digit entered and did not send, it was 1, so...
    1008   00:44E1  3E 01                   ld  a,1
    1009   00:44E3  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1010   00:44E6  DD 77 01                ld  (ix+1),a                    ; Save
    1011   00:44E9  18 5C                   jr  CLK_AUTO_GMT_CHK_DONE       ; Ok, ready to send
    1012   00:44EB                      CLK_AUTO_GMT_CHK_CD:
    1013   00:44EB                          ; Ok, it is a digit
    1014   00:44EB  06 30                   ld  b,'0'
    1015   00:44ED  90                      sub a,b                         ; A has digit value
    1016   00:44EE  47                      ld  b,a                         ; Save in B
    1017   00:44EF  3E 00                   ld  a,0
    1018   00:44F1  BA                      cp  d
    1019   00:44F2  20 1E                   jr  nz,CLK_AUTO_GMT_CHK_CSD     ; If not zero, it is second digit, so almost done
    1020   00:44F4                          ; 1st digit, let's check if it is other than 1, if it is, we are almost done
    1021   00:44F4  3E 01                   ld  a,1
    1022   00:44F6  B8                      cp  b
    1023   00:44F7  28 10                   jr  z,CLK_AUTO_GMT_CHK_CD.1     ; If it is 1, wait next digit or enter
    1024   00:44F9                          ; Not 1, so just adjust ix+1 and go
    1025   00:44F9  79                      ld  a,c
    1026   00:44FA  CD A2 00                call    CHPUT                   ; Print it
    1027   00:44FD  78                      ld  a,b
    1028   00:44FE  B7                      or  a
    1029   00:44FF  28 03                   jr  z,CLK_AUTO_SKIP_SIGN
    1030   00:4501  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1031   00:4504                      CLK_AUTO_SKIP_SIGN:
    1032   00:4504  DD 77 01                ld  (ix+1),a                    ; Save
    1033   00:4507  18 3E                   jr  CLK_AUTO_GMT_CHK_DONE       ; Ok, ready to send
    1034   00:4509                      CLK_AUTO_GMT_CHK_CD.1:
    1035   00:4509  79                      ld  a,c
    1036   00:450A  CD A2 00                call    CHPUT                   ; Print it
    1037   00:450D  14                      inc d                           ; Digits entered now is 1
    1038   00:450E  1C                      inc e                           ; Digits printed increased
    1039   00:450F  C3 6F 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; Continue waiting input
    1040   00:4512                      CLK_AUTO_GMT_CHK_CSD:
    1041   00:4512                          ; Second digit, easy... First was 1, now need to check if it is 0, 1 or 2, otherwise, bad entry
    1042   00:4512  78                      ld  a,b
    1043   00:4513  06 03                   ld  b,3
    1044   00:4515  B8                      cp  b
    1045   00:4516  D2 B4 44                jp  nc,CLK_AUTO_GMT_BAD_INPUT   ; 3 or more, so, not valid
    1046   00:4519  B7                      or  a                           ; Is it zero?
    1047   00:451A  20 0E                   jr  nz,CLK_AUTO_GMT_CHK_CSD1    ; If not, check for 1
    1048   00:451C                          ; It was zero
    1049   00:451C  3E 0A                   ld  a,10                        ; So, 10
    1050   00:451E  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1051   00:4521  DD 77 01                ld  (ix+1),a                    ; Save
    1052   00:4524  79                      ld  a,c
    1053   00:4525  CD A2 00                call    CHPUT                   ; Print it
    1054   00:4528  18 1D                   jr  CLK_AUTO_GMT_CHK_DONE       ; Ready to
    1055   00:452A                      CLK_AUTO_GMT_CHK_CSD1:
    1056   00:452A  3D                      dec a                           ; Is it one?
    1057   00:452B  20 0E                   jr  nz,CLK_AUTO_GMT_CHK_CSD2
    1058   00:452D                          ; It was one
    1059   00:452D  3E 0B                   ld  a,11                        ; So, eleven
    1060   00:452F  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1061   00:4532  DD 77 01                ld  (ix+1),a                    ; Save
    1062   00:4535  79                      ld  a,c
    1063   00:4536  CD A2 00                call    CHPUT                   ; Print it
    1064   00:4539  18 0C                   jr  CLK_AUTO_GMT_CHK_DONE       ; Ready to send
    1065   00:453B                      CLK_AUTO_GMT_CHK_CSD2:
    1066   00:453B                          ; It was two
    1067   00:453B  3E 0C                   ld  a,12                        ; So, twelve
    1068   00:453D  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1069   00:4540  DD 77 01                ld  (ix+1),a                    ; Save
    1070   00:4543  79                      ld  a,c
    1071   00:4544  CD A2 00                call    CHPUT                   ; Print it
    1072   00:4547                          ; And send command
    1073   00:4547                      CLK_AUTO_GMT_CHK_DONE:
    1074   00:4547  3E 0D                   ld  a,#0d
    1075   00:4549  CD A2 00                call    CHPUT
    1076   00:454C  3E 0A                   ld  a,#0a
    1077   00:454E  CD A2 00                call    CHPUT
    1078   00:4551  21 6A 70                ld  hl,STR_SENDING
    1079   00:4554  CD A5 4C                call    PRINTHL
    1080   00:4557                          CLEAR_UART
    1080   00:4557  3E 14             >     ld  a,20
    1080   00:4559  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
