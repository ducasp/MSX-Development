    5294   00:5C12  CB 47             >     bit 0,a
    5295   00:5C14  20 05                   jr  nz,SSH_SEND_ST2.1
    5296   00:5C16  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5297   00:5C19  18 F4                   jr  SSH_SEND_ST2
    5298   00:5C1B                      SSH_SEND_ST2.1:
    5299   00:5C1B                          ; nz, discard
    5300   00:5C1B                          RECEIVE_DATA
    5300   00:5C1B  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5301   00:5C1E  05                      dec b
    5302   00:5C1F  20 EE                   jr  nz,SSH_SEND_ST2
    5303   00:5C21                      
    5304   00:5C21                          ; done, no return data other than return code
    5305   00:5C21  AF                      xor a
    5306   00:5C22  C9                      ret
