    1116   00:45A6  11 14 00                ld  de,20                       ; At least 10s waiting scan to finish, retry 20 times waiting 0.5s between attempts
    1117   00:45A9                      WIFI_SCAN_WAIT_END:
    1118   00:45A9                          CLEAR_UART
    1118   00:45A9  3E 14             >     ld  a,20
