    4694   00:58CF  3E 02                   ld  a,2                         ; Set sends 2 bytes
    4695   00:58D1                          SEND_DATA                       ; Send the command size lsb
    4695   00:58D1  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4696   00:58D4  79                      ld  a,c
    4697   00:58D5                          SEND_DATA                       ; Send the operation
