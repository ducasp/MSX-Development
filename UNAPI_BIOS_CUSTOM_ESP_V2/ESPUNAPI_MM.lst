    4599   00:584C  21 B4 00                ld  hl,180
    4600   00:584F  CD 3E 61                call    SETCOUNTER
    4601   00:5852                      SSH_STATE_ST1:
    4602   00:5852                          CHECK_DATA
    4602   00:5852  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    4602   00:5855  CB 47             >     bit 0,a
    4603   00:5857  20 05                   jr  nz,SSH_STATE_ST1.1
    4604   00:5859  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4605   00:585C  18 F4                   jr  SSH_STATE_ST1
    4606   00:585E                      SSH_STATE_ST1.1:
    4607   00:585E                          ; nz, check the data
