    1712   00:49C2  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1713   00:49C5  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1714   00:49C8  CD 38 4B                call    WAIT_MENU_QCMD_RESPONSE
    1715   00:49CB  C0                      ret nz                          ; If success return
    1716   00:49CC  3E 0D                   ld  a,CR
    1717   00:49CE  CD A2 00                call    CHPUT
    1718   00:49D1  3E 0A                   ld  a,LF
    1719   00:49D3  CD A2 00                call    CHPUT
    1720   00:49D6  C3 2E 4B                jp  MENU_SUB_BAD_END            ; If error, nothing much to do, main menu
    1721   00:49D9                      
    1722   00:49D9                      SET_NAGLE_ON:
    1723   00:49D9  3E 4F                   ld  a,'O'
    1724   00:49DB  CD A2 00                call    CHPUT
    1725   00:49DE  3E 0D                   ld  a,#0d
    1726   00:49E0  CD A2 00                call    CHPUT
    1727   00:49E3  3E 0A                   ld  a,#0a
    1728   00:49E5  CD A2 00                call    CHPUT
    1729   00:49E8  21 62 70                ld  hl,STR_SENDING              ; Indicate it is sending a command
    1730   00:49EB  CD 9D 4C                call    PRINTHL
    1731   00:49EE                          CLEAR_UART
    1731   00:49EE  3E 14             >     ld  a,20
    1731   00:49F0  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
