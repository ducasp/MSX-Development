    1185   00:4625  CD A5 4C                call    PRINTHL
    1186   00:4628  E1                      pop hl
    1187   00:4629                      PRT_AP_CHKLOOP:
    1188   00:4629  23                      inc hl
    1189   00:462A  1C                      inc e
    1190   00:462B  3E 08                   ld  a,SCAN_MAX_PAGE_SIZE
    1191   00:462D  BB                      cp  e
    1192   00:462E  CA 39 46                jp  z,APLIST_OVERFLOW
    1193   00:4631  15                      dec d
    1194   00:4632  C2 DD 45                jp  nz,WIFI_LIST_LOOP
    1195   00:4635  06 00                   ld  b,0                         ; Signal no more list data
    1196   00:4637  18 10                   jr  APLIST_NO_OVERFLOW
    1197   00:4639                      APLIST_OVERFLOW:
