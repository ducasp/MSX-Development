    2168   00:4C8F  C9                      ret
    2169   00:4C90                      
    2170   00:4C90                      ; This routine will check if HL is 0, if it is, will return immediatelly
    2171   00:4C90                      ; If it is not, will decrease HL value and halt (wait one interrupt)
    2172   00:4C90                      HLTIMEOUT:
    2173   00:4C90  7C                      ld  a,h
    2174   00:4C91  B5                      or  l
    2175   00:4C92  C8                      ret z
