    3525   00:5319  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3526   00:531C  B7                      or  a                           ; 0?
    3527   00:531D  C0                      ret nz                          ; if not, done
    3528   00:531E                      
    3529   00:531E                          ; next two bytes are return code and size bytes, don't care, it is 5
    3530   00:531E  06 02                   ld  b,2
    3531   00:5320                      TCPIP_UDP_STATE_ST2:
    3532   00:5320                          CHECK_DATA
    3532   00:5320  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3532   00:5323  CB 47             >     bit 0,a
    3533   00:5325  20 05                   jr  nz,TCPIP_UDP_STATE_ST2.1
    3534   00:5327  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3535   00:532A  18 F4                   jr  TCPIP_UDP_STATE_ST2
    3536   00:532C                      TCPIP_UDP_STATE_ST2.1:
    3537   00:532C                          ; nz, discard
    3538   00:532C                          RECEIVE_DATA
    3538   00:532C  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3539   00:532F  05                      dec b
    3540   00:5330  20 EE                   jr  nz,TCPIP_UDP_STATE_ST2
    3541   00:5332                      
    3542   00:5332                          ; now just get the 5 bytes (Port LSB then MSB, # of packets, packet size LSB then MSB) and order it in L, H, B, E and D
    3543   00:5332                      TCPIP_UDP_STATE_RESP_ST1:
    3544   00:5332                          CHECK_DATA
    3544   00:5332  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3544   00:5335  CB 47             >     bit 0,a
    3545   00:5337  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST1.1
    3546   00:5339  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3547   00:533C  18 F4                   jr  TCPIP_UDP_STATE_RESP_ST1
    3548   00:533E                      TCPIP_UDP_STATE_RESP_ST1.1:
    3549   00:533E                          ; nz, get it
    3550   00:533E                          RECEIVE_DATA
    3550   00:533E  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3551   00:5341  6F                      ld  l,a
    3552   00:5342                      TCPIP_UDP_STATE_RESP_ST2:
    3553   00:5342                          CHECK_DATA
    3553   00:5342  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3553   00:5345  CB 47             >     bit 0,a
    3554   00:5347  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST2.1
    3555   00:5349  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3556   00:534C  18 F4                   jr  TCPIP_UDP_STATE_RESP_ST2
    3557   00:534E                      TCPIP_UDP_STATE_RESP_ST2.1:
    3558   00:534E                          ; nz, get it
    3559   00:534E                          RECEIVE_DATA
    3559   00:534E  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3560   00:5351  67                      ld  h,a
    3561   00:5352                      TCPIP_UDP_STATE_RESP_ST3:
    3562   00:5352                          CHECK_DATA
    3562   00:5352  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3562   00:5355  CB 47             >     bit 0,a
    3563   00:5357  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST3.1
    3564   00:5359  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3565   00:535C  18 F4                   jr  TCPIP_UDP_STATE_RESP_ST3
    3566   00:535E                      TCPIP_UDP_STATE_RESP_ST3.1:
    3567   00:535E                          ; nz, get it
    3568   00:535E                          RECEIVE_DATA
    3568   00:535E  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3569   00:5361  47                      ld  b,a
    3570   00:5362                      TCPIP_UDP_STATE_RESP_ST4:
    3571   00:5362                          CHECK_DATA
    3571   00:5362  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3571   00:5365  CB 47             >     bit 0,a
    3572   00:5367  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST4.1
    3573   00:5369  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3574   00:536C  18 F4                   jr  TCPIP_UDP_STATE_RESP_ST4
    3575   00:536E                      TCPIP_UDP_STATE_RESP_ST4.1:
    3576   00:536E                          ; nz, get it
    3577   00:536E                          RECEIVE_DATA
    3577   00:536E  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3578   00:5371  5F                      ld  e,a
    3579   00:5372                      TCPIP_UDP_STATE_RESP_ST5:
    3580   00:5372                          CHECK_DATA
    3580   00:5372  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3580   00:5375  CB 47             >     bit 0,a
    3581   00:5377  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST5.1
    3582   00:5379  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3583   00:537C  18 F4                   jr  TCPIP_UDP_STATE_RESP_ST5
    3584   00:537E                      TCPIP_UDP_STATE_RESP_ST5.1:
    3585   00:537E                          ; nz, get it
    3586   00:537E                          RECEIVE_DATA
    3586   00:537E  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3587   00:5381  57                      ld  d,a
    3588   00:5382                          ; done
    3589   00:5382  AF                      xor a
    3590   00:5383  C9                      ret
