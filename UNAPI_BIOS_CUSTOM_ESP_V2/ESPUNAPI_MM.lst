    4705   00:58FD                      ;=========================
    4706   00:58FD                      ;===   SSH_KEY_IMPORT   ===
    4707   00:58FD                      ;=========================
    4708   00:58FD                      ;Import SSH key data.
    4709   00:58FD                      ;
    4710   00:58FD                      ;Input:  A  = 14
    4711   00:58FD                      ;        C  = Control flags (bit 0 = last block)
    4712   00:58FD                      ;        DE = Address of input data
    4713   00:58FD                      ;        HL = Data length
    4714   00:58FD                      ;Output: A  = Error code
    4715   00:58FD                      SSH_KEY_IMPORT:
