    5579   00:5D9F                          ; nz, discard
    5580   00:5D9F                          RECEIVE_DATA
    5580   00:5D9F  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5581   00:5DA2  05                      dec b
    5582   00:5DA3  20 EE                   jr  nz,TCPIP_CONFIG_AUTOIP_ST2
    5583   00:5DA5                      
    5584   00:5DA5                          ; now just get the 1 byte, configuration, should go to C
    5585   00:5DA5                      TCPIP_CONFIG_AUTOIP_CONF_ST1:
    5586   00:5DA5                          CHECK_DATA
    5586   00:5DA5  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5586   00:5DA8  CB 47             >     bit 0,a
    5587   00:5DAA  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_CONF_ST1.1
    5588   00:5DAC  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5589   00:5DAF  18 F4                   jr  TCPIP_CONFIG_AUTOIP_CONF_ST1
    5590   00:5DB1                      TCPIP_CONFIG_AUTOIP_CONF_ST1.1:
    5591   00:5DB1                          ; nz, get it
    5592   00:5DB1                          RECEIVE_DATA
    5592   00:5DB1  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5593   00:5DB4  4F                      ld  c,a
    5594   00:5DB5                          ; done
    5595   00:5DB5  AF                      xor a
    5596   00:5DB6  C9                      ret
    5597   00:5DB7                      
    5598   00:5DB7                      ;=========================
    5599   00:5DB7                      ;===  TCPIP_CONFIG_IP  ===
    5600   00:5DB7                      ;=========================
    5601   00:5DB7                      ;Manually configure an IP address.
    5602   00:5DB7                      ;
    5603   00:5DB7                      ;Input:  A = 26
    5604   00:5DB7                      ;        B = Index of address to set:
    5605   00:5DB7                      ;            1: Local IP address
    5606   00:5DB7                      ;            2: Peer IP address
    5607   00:5DB7                      ;            3: Subnet mask
    5608   00:5DB7                      ;            4: Default gateway
    5609   00:5DB7                      ;            5: Primary DNS server IP address
    5610   00:5DB7                      ;            6: Secondary DNS server IP address
    5611   00:5DB7                      ;        L.H.E.D = Address value
    5612   00:5DB7                      ;Output: A = Error code
    5613   00:5DB7                      TCPIP_CONFIG_IP:
    5614   00:5DB7                          SEND_DATA                       ; Send the command
    5614   00:5DB7  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5615   00:5DBA  AF                      xor a
    5616   00:5DBB                          SEND_DATA                       ; Send the command size msb
    5616   00:5DBB  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5617   00:5DBE  3E 05                   ld  a,5
    5618   00:5DC0                          SEND_DATA                       ; Send the command size lsb
    5618   00:5DC0  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5619   00:5DC3  78                      ld  a,b
    5620   00:5DC4                          SEND_DATA                       ; Send the address to set
    5620   00:5DC4  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5621   00:5DC7  7D                      ld  a,l
    5622   00:5DC8                          SEND_DATA                       ; Send the IP first byte
    5622   00:5DC8  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5623   00:5DCB  7C                      ld  a,h
    5624   00:5DCC                          SEND_DATA                       ; Send the IP second byte
    5624   00:5DCC  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5625   00:5DCF  7B                      ld  a,e
    5626   00:5DD0                          SEND_DATA                       ; Send the IP third byte
    5626   00:5DD0  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5627   00:5DD3  7A                      ld  a,d
    5628   00:5DD4                          SEND_DATA                       ; Send the IP fourth byte
    5628   00:5DD4  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5629   00:5DD7                      
    5630   00:5DD7                          ; Now wait up to 180 ticks to get response
    5631   00:5DD7  21 B4 00                ld  hl,180
    5632   00:5DDA  CD C2 5E                call    SETCOUNTER
    5633   00:5DDD                      TCPIP_CONFIG_IP_ST1:
    5634   00:5DDD                          CHECK_DATA
    5634   00:5DDD  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5634   00:5DE0  CB 47             >     bit 0,a
    5635   00:5DE2  20 05                   jr  nz,TCPIP_CONFIG_IP_ST1.1
    5636   00:5DE4  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5637   00:5DE7  18 F4                   jr  TCPIP_CONFIG_IP_ST1
    5638   00:5DE9                      TCPIP_CONFIG_IP_ST1.1:
    5639   00:5DE9                          ; nz, check the data
    5640   00:5DE9                          RECEIVE_DATA
    5640   00:5DE9  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5641   00:5DEC  FE 1A                   cp  26                          ; Is response of our command?
    5642   00:5DEE  20 ED                   jr  nz,TCPIP_CONFIG_IP_ST1
    5643   00:5DF0                          ; now get return code, and that is it
    5644   00:5DF0                      TCPIP_CONFIG_IP_RC:
    5645   00:5DF0                          CHECK_DATA
    5645   00:5DF0  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5645   00:5DF3  CB 47             >     bit 0,a
    5646   00:5DF5  20 05                   jr  nz,TCPIP_CONFIG_IP_RC.1
    5647   00:5DF7  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5648   00:5DFA  18 F4                   jr  TCPIP_CONFIG_IP_RC
    5649   00:5DFC                      TCPIP_CONFIG_IP_RC.1:
    5650   00:5DFC                          ; nz, discard
    5651   00:5DFC                          RECEIVE_DATA
    5651   00:5DFC  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5652   00:5DFF  C9                      ret                             ; done
    5653   00:5E00                      
    5654   00:5E00                      ;==========================
    5655   00:5E00                      ;===  TCPIP_CONFIG_TTL  ===
    5656   00:5E00                      ;==========================
    5657   00:5E00                      ;Get/set the value of TTL and TOS for outgoing datagrams.
    5658   00:5E00                      ;
    5659   00:5E00                      ;Input:  A = 27
    5660   00:5E00                      ;        B = 0: Get current values (just return 255 for TTL and 0 for TOS
    5661   00:5E00                      ;               as ESP do not expose or allow configurations of it)
    5662   00:5E00                      ;            1: Set values
    5663   00:5E00                      ;        D = New value for TTL (only if B=1)
    5664   00:5E00                      ;        E = New value for ToS (only if B=1)
    5665   00:5E00                      ;Output: A = Error code
    5666   00:5E00                      ;        D = Value of TTL after the routine execution
    5667   00:5E00                      ;        E = Value of ToS after the routine execution
    5668   00:5E00                      TCPIP_CONFIG_TTL:
    5669   00:5E00  78                      ld  a,b
    5670   00:5E01  E6 FE                   and %11111110
    5671   00:5E03  B7                      or  a
    5672   00:5E04  3E 04                   ld  a,ERR_INV_PARAM
    5673   00:5E06  C0                      ret nz
    5674   00:5E07  78                      ld  a,b
    5675   00:5E08  B7                      or  a
    5676   00:5E09                          ; Cant set, so NOT IMP
    5677   00:5E09  3E 01                   ld  a,ERR_NOT_IMP
    5678   00:5E0B  C0                      ret nz                          ; if not get, not implemented
    5679   00:5E0C                          ; get, so just return D = #FF, A = OK = 0 and E = 0
    5680   00:5E0C  AF                      xor a
    5681   00:5E0D  1E 00                   ld  e,0
    5682   00:5E0F  16 FF                   ld  d,#FF
    5683   00:5E11  C9                      ret
    5684   00:5E12                      
    5685   00:5E12                      ;===========================
    5686   00:5E12                      ;===  TCPIP_CONFIG_PING  ===
    5687   00:5E12                      ;===========================
    5688   00:5E12                      ;Get/set the automatic PING reply flag.
    5689   00:5E12                      ;
    5690   00:5E12                      ;Input:  A = 28
    5691   00:5E12                      ;        B = 0: Get current flag value
    5692   00:5E12                      ;            1: Set flag value (ERR_NOT_IMP)
    5693   00:5E12                      ;        C = New flag value (only if B=1):
    5694   00:5E12                      ;            0: Off
    5695   00:5E12                      ;            1: On
    5696   00:5E12                      ;Output: A = Error code
    5697   00:5E12                      ;        C = Flag value after the routine execution
    5698   00:5E12                      TCPIP_CONFIG_PING:
    5699   00:5E12  78                      ld  a,b
    5700   00:5E13  E6 FE                   and %11111110
    5701   00:5E15  B7                      or  a
    5702   00:5E16  3E 04                   ld  a,ERR_INV_PARAM
    5703   00:5E18  C0                      ret nz
    5704   00:5E19  78                      ld  a,b
    5705   00:5E1A  B7                      or  a
    5706   00:5E1B                          ; Cant set, so NOT IMP
    5707   00:5E1B  3E 01                   ld  a,ERR_NOT_IMP
    5708   00:5E1D  C0                      ret nz                          ; if not get, not implemented
    5709   00:5E1E                          ; get, so just return C = 1, A = OK = 0
    5710   00:5E1E  AF                      xor a
    5711   00:5E1F  0E 01                   ld  c,1
    5712   00:5E21  C9                      ret
    5713   00:5E22                      
    5714   00:5E22                      ;============================
    5715   00:5E22                      ;===  Auxiliary routines  ===
    5716   00:5E22                      ;============================
    5717   00:5E22                      
    5718   00:5E22                      ;--- Get slot connected on page 1
    5719   00:5E22                      ;    Input:  -
    5720   00:5E22                      ;    Output: A = Slot number
    5721   00:5E22                      ;    Modifies: AF, HL, E, BC
    5722   00:5E22                      
    5723   00:5E22                      GETSLT:
    5724   00:5E22  DB A8                   in  a,(#A8)
    5725   00:5E24  0F                      rrca
    5726   00:5E25  0F                      rrca
    5727   00:5E26  E6 03                   and 3
    5728   00:5E28  4F                      ld  c,a                         ;C = Slot
    5729   00:5E29  06 00                   ld  b,0
    5730   00:5E2B  21 C1 FC                ld  hl,EXPTBL
    5731   00:5E2E  09                      add hl,bc
    5732   00:5E2F  7E                      ld  a,(hl)
    5733   00:5E30  E6 80                   and #80
    5734   00:5E32  B1                      or  c
    5735   00:5E33  4F                      ld  c,a
    5736   00:5E34  23                      inc hl
    5737   00:5E35  23                      inc hl
    5738   00:5E36  23                      inc hl
    5739   00:5E37  23                      inc hl
    5740   00:5E38  7E                      ld  a,(hl)
    5741   00:5E39  E6 0C                   and #0C
    5742   00:5E3B  B1                      or  c
    5743   00:5E3C  CB 7F                   bit 7,a
    5744   00:5E3E  C0                      ret nz
    5745   00:5E3F  E6 03                   and %11
    5746   00:5E41  C9                      ret
    5747   00:5E42                      
    5748   00:5E42                      ;--- Get slot connected on page 1 and test if work area has been created, if not, create it
    5749   00:5E42                      ;    Input:  -
    5750   00:5E42                      ;    Output: A = Slot number
    5751   00:5E42                      ;    Modifies: AF, HL, E, BC
    5752   00:5E42                      
    5753   00:5E42                      GETSLTT:
    5754   00:5E42  DB A8                   in  a,(#A8)
    5755   00:5E44  0F                      rrca
    5756   00:5E45  0F                      rrca
    5757   00:5E46  E6 03                   and 3
    5758   00:5E48  4F                      ld  c,a                         ;C = Slot
    5759   00:5E49  06 00                   ld  b,0
    5760   00:5E4B  21 C1 FC                ld  hl,EXPTBL
    5761   00:5E4E  09                      add hl,bc
    5762   00:5E4F  7E                      ld  a,(hl)
    5763   00:5E50  E6 80                   and #80
    5764   00:5E52  B1                      or  c
    5765   00:5E53  4F                      ld  c,a
    5766   00:5E54  23                      inc hl
    5767   00:5E55  23                      inc hl
    5768   00:5E56  23                      inc hl
    5769   00:5E57  23                      inc hl
    5770   00:5E58  7E                      ld  a,(hl)
    5771   00:5E59  E6 0C                   and #0C
    5772   00:5E5B  B1                      or  c
    5773   00:5E5C  CB 7F                   bit 7,a
    5774   00:5E5E  C2 63 5E                jp  nz,GETSLTT1
    5775   00:5E61  E6 03                   and %11
    5776   00:5E63                      GETSLTT1:
    5777   00:5E63  F5                      push    af
    5778   00:5E64  C5                      push    bc
    5779   00:5E65  E5                      push    hl
    5780   00:5E66  CD 7B 5E                call    GETWRK
    5781   00:5E69  01 05 00                ld  bc,5
    5782   00:5E6C  09                      add hl,bc
    5783   00:5E6D  7E                      ld  a,(hl)
    5784   00:5E6E  B7                      or  a
    5785   00:5E6F  C2 77 5E                jp  nz,GETSLTTRET
    5786   00:5E72  3C                      inc a
    5787   00:5E73  77                      ld  (hl),a
    5788   00:5E74  CD FB 41                call    HIMEM_ALLOC
    5789   00:5E77                      GETSLTTRET:
    5790   00:5E77  E1                      pop hl
    5791   00:5E78  C1                      pop bc
    5792   00:5E79  F1                      pop af
    5793   00:5E7A  C9                      ret
    5794   00:5E7B                      
    5795   00:5E7B                      ;--- Obtain slot work area (8 bytes) on SLTWRK
    5796   00:5E7B                      ;    Input:  A  = Slot number
    5797   00:5E7B                      ;    Output: HL = Work area address
    5798   00:5E7B                      ;    Modifies: AF, BC
    5799   00:5E7B                      
    5800   00:5E7B                      GETWRK:
    5801   00:5E7B  47                      ld  b,a
    5802   00:5E7C  0F                      rrca
    5803   00:5E7D  0F                      rrca
    5804   00:5E7E  0F                      rrca
    5805   00:5E7F  E6 60                   and %01100000
    5806   00:5E81  4F                      ld  c,a                         ;C = Slot * 32
    5807   00:5E82  78                      ld  a,b
    5808   00:5E83  07                      rlca
    5809   00:5E84  E6 18                   and %00011000                   ;A = Subslot * 8
    5810   00:5E86  B1                      or  c
    5811   00:5E87  4F                      ld  c,a
    5812   00:5E88  06 00                   ld  b,0
    5813   00:5E8A  21 09 FD                ld  hl,SLTWRK
    5814   00:5E8D  09                      add hl,bc
    5815   00:5E8E  C9                      ret
    5816   00:5E8F                      
    5817   00:5E8F                      ;--- Obtain the address where our memory area address in high memory is stored
    5818   00:5E8F                      ;    Input:  A  = Slot number
    5819   00:5E8F                      ;    Output: HL = High memory area address
    5820   00:5E8F                      ;    Modifies: AF, BC
    5821   00:5E8F                      
    5822   00:5E8F                      GETMEMPOINTERADDR:
    5823   00:5E8F  47                      ld  b,a
    5824   00:5E90  0F                      rrca
    5825   00:5E91  0F                      rrca
    5826   00:5E92  0F                      rrca
    5827   00:5E93  E6 60                   and %01100000
    5828   00:5E95  4F                      ld  c,a                         ; C = Slot * 32
    5829   00:5E96  78                      ld  a,b
    5830   00:5E97  07                      rlca
    5831   00:5E98  E6 18                   and %00011000                   ; A = Subslot * 8
    5832   00:5E9A  B1                      or  c
    5833   00:5E9B  4F                      ld  c,a
    5834   00:5E9C  06 00                   ld  b,0
    5835   00:5E9E  D2 A2 5E                jp  nc,GETMEM_1
    5836   00:5EA1  04                      inc b
    5837   00:5EA2                      GETMEM_1:
    5838   00:5EA2  21 09 FD                ld  hl,SLTWRK
    5839   00:5EA5  09                      add hl,bc
    5840   00:5EA6  01 05 00                ld  bc,5
    5841   00:5EA9  09                      add hl,bc
    5842   00:5EAA  C9                      ret
    5843   00:5EAB                      
    5844   00:5EAB                      ;--- Obtain the address where our memory area address in high memory is stored
    5845   00:5EAB                      ;    Input:  A  = Slot number
    5846   00:5EAB                      ;    Output: HL = High memory area address
    5847   00:5EAB                      ;    Modifies: AF, BC
    5848   00:5EAB                      
    5849   00:5EAB                      GETMEMPOINTER:
    5850   00:5EAB  CD 8F 5E                call    GETMEMPOINTERADDR
    5851   00:5EAE  4E                      ld  c,(hl)
    5852   00:5EAF  23                      inc hl
    5853   00:5EB0  66                      ld  h,(hl)
    5854   00:5EB1  69                      ld  l,c
    5855   00:5EB2  C9                      ret
    5856   00:5EB3                      
    5857   00:5EB3                      ;--- Obtain our HTIM_I driven counter value in high memory
    5858   00:5EB3                      ;    Input:  none
    5859   00:5EB3                      ;    Output: HL = counter value
    5860   00:5EB3                      ;    Modifies: AF, HL, DE, BC
    5861   00:5EB3                      
    5862   00:5EB3                      GETCOUNTER:
    5863   00:5EB3  CD 22 5E                call    GETSLT
    5864   00:5EB6                          ; Slot in A, now get the address of our counter
    5865   00:5EB6  CD AB 5E                call    GETMEMPOINTER
    5866   00:5EB9                          ; HL has the address of our memory area, counter is 5 bytes after start
    5867   00:5EB9  11 05 00                ld  de,MEMORY_COUNTER_OFFSET
    5868   00:5EBC  19                      add hl,de
    5869   00:5EBD                          ; Ok, this is where our counter is so get it
    5870   00:5EBD  5E                      ld  e,(hl)
    5871   00:5EBE  23                      inc hl
    5872   00:5EBF  56                      ld  d,(hl)
    5873   00:5EC0                          ; DE has the counter value
    5874   00:5EC0  EB                      ex  de,hl                       ; Counter value in HL
    5875   00:5EC1  C9                      ret
    5876   00:5EC2                      
    5877   00:5EC2                      ;--- Set our HTIM_I driven counter value in high memory
    5878   00:5EC2                      ;    Input:  HL = new counter value
    5879   00:5EC2                      ;    Output: none
    5880   00:5EC2                      ;    Modifies: AF, HL, DE, BC
    5881   00:5EC2                      
    5882   00:5EC2                      SETCOUNTER:
    5883   00:5EC2  E5                      push    hl                      ; Save parameter
    5884   00:5EC3  CD 22 5E                call    GETSLT
    5885   00:5EC6                          ; Slot in A, now get the address of our counter
    5886   00:5EC6  CD AB 5E                call    GETMEMPOINTER
    5887   00:5EC9                          ; HL has the address of our memory area, counter is 5 bytes after start
    5888   00:5EC9  11 05 00                ld  de,MEMORY_COUNTER_OFFSET
    5889   00:5ECC  19                      add hl,de
    5890   00:5ECD                          ; Ok, this is where our counter is so get it
    5891   00:5ECD                          ; HL has the address of counter
    5892   00:5ECD  D1                      pop de                          ; Restore parameter in DE
    5893   00:5ECE  73                      ld  (hl),e
    5894   00:5ECF  23                      inc hl
    5895   00:5ED0  72                      ld  (hl),d
    5896   00:5ED1  C9                      ret
    5897   00:5ED2                      
    5898   00:5ED2                      ;--- Obtain a one byte param saved in high memory
    5899   00:5ED2                      ;    Input:  none
    5900   00:5ED2                      ;    Output: A = param
    5901   00:5ED2                      ;    Modifies: AF
    5902   00:5ED2                      
    5903   00:5ED2                      GETBYTE:
    5904   00:5ED2  C5                      push    bc
    5905   00:5ED3  D5                      push    de
    5906   00:5ED4  E5                      push    hl
    5907   00:5ED5  CD 22 5E                call    GETSLT
    5908   00:5ED8                          ; Slot in A, now get the address of our counter
    5909   00:5ED8  CD AB 5E                call    GETMEMPOINTER
    5910   00:5EDB                          ; HL has the address of our memory area, param is 7 bytes after start
    5911   00:5EDB  11 07 00                ld  de,MEMORY_SB_VAR_OFFSET
    5912   00:5EDE  19                      add hl,de
    5913   00:5EDF                          ; Ok, this is where our param is so get it
    5914   00:5EDF  7E                      ld  a,(hl)
    5915   00:5EE0  E1                      pop hl
    5916   00:5EE1  D1                      pop de
    5917   00:5EE2  C1                      pop bc
    5918   00:5EE3  C9                      ret
    5919   00:5EE4                      
    5920   00:5EE4                      ;--- Set a one byte param value in high memory
    5921   00:5EE4                      ;    Input:  A = new counter value
    5922   00:5EE4                      ;    Output: none
    5923   00:5EE4                      ;    Modifies: AF
    5924   00:5EE4                      
    5925   00:5EE4                      SETBYTE:
    5926   00:5EE4  C5                      push    bc
    5927   00:5EE5  D5                      push    de
    5928   00:5EE6  E5                      push    hl
    5929   00:5EE7  F5                      push    af                      ; Save parameter
    5930   00:5EE8  CD 22 5E                call    GETSLT
    5931   00:5EEB                          ; Slot in A, now get the address
    5932   00:5EEB  CD AB 5E                call    GETMEMPOINTER
    5933   00:5EEE                          ; HL has the address of our memory area, byte param is 7 bytes after start
    5934   00:5EEE  11 07 00                ld  de,MEMORY_SB_VAR_OFFSET
    5935   00:5EF1  19                      add hl,de
    5936   00:5EF2                          ; HL has the address of param
    5937   00:5EF2  F1                      pop af                          ; Restore parameter
    5938   00:5EF3  77                      ld  (hl),a
    5939   00:5EF4  E1                      pop hl
    5940   00:5EF5  D1                      pop de
    5941   00:5EF6  C1                      pop bc
    5942   00:5EF7  C9                      ret
    5943   00:5EF8                      
    5944   00:5EF8                      ;--- Obtain a two bytes param saved in high memory
    5945   00:5EF8                      ;    Input:  none
    5946   00:5EF8                      ;    Output: HL = param
    5947   00:5EF8                      ;    Modifies: AF, HL
    5948   00:5EF8                      
    5949   00:5EF8                      GETWORD:
    5950   00:5EF8  C5                      push    bc
    5951   00:5EF9  D5                      push    de
    5952   00:5EFA  CD 22 5E                call    GETSLT
    5953   00:5EFD                          ; Slot in A, now get the address of our counter
    5954   00:5EFD  CD AB 5E                call    GETMEMPOINTER
    5955   00:5F00                          ; HL has the address of our memory area, param is 7 bytes after start
    5956   00:5F00  11 0B 00                ld  de,MEMORY_DB_VAR_OFFSET
    5957   00:5F03  19                      add hl,de
    5958   00:5F04                          ; Ok, this is where our param is so get it
    5959   00:5F04  5E                      ld  e,(hl)
