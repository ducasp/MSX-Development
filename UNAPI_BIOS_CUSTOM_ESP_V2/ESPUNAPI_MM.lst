    2094   00:4C14  C3 83 4C                jp  WAIT_MENU_SCMD_RESPONSE_END ; If time out waiting, return
    2095   00:4C17                      WAIT_MENU_SCMD_RESPONSE_ST1.1:
    2096   00:4C17                          ; nz, check the data
