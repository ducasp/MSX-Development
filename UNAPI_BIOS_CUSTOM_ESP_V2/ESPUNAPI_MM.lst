    5048   00:5AE9                      ;========================
    5049   00:5AE9                      ;===     SSH_SEND     ===
    5050   00:5AE9                      ;========================
    5051   00:5AE9                      ;Send data to a SSH connection.
    5052   00:5AE9                      ;
    5053   00:5AE9                      ;Input:  A  = 5
