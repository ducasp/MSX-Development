    3944   00:5562                      ;========================
    3945   00:5562                      ;===  TCPIP_TCP_OPEN  ===
    3946   00:5562                      ;========================
    3947   00:5562                      ;Open a TCP connection.
    3948   00:5562                      ;
    3949   00:5562                      ;Input:  A  = 13
    3950   00:5562                      ;        HL = Address of parameters block
    3951   00:5562                      ;Output: A = Error code
    3952   00:5562                      ;        B = Connection number
    3953   00:5562                      ;        C = Connection not open reason (mostly for TLS)
    3954   00:5562                      ;
    3955   00:5562                      ;Parameters block format:
    3956   00:5562                      ;
    3957   00:5562                      ;+0 (4): Remote IP address (0.0.0.0 for unspecified remote socket)
    3958   00:5562                      ;+4 (2): Remote port (ignored if unspecified remote socket)
    3959   00:5562                      ;+6 (2): Local port, 0FFFFh for a random value
    3960   00:5562                      ;+8 (2): Suggestion for user timeout value
    3961   00:5562                      ;+10 (1): Flags:
    3962   00:5562                      ;         bit 0: Set for passive connection
    3963   00:5562                      ;         bit 1: Set for resident connection
    3964   00:5562                      ;         bit 2: Set for TLS connection
    3965   00:5562                      ;         bit 3: Set for TLS connection validating host certificate
    3966   00:5562                      ;+11 (2): If 0000 no host name validation, otherwise the hostname string address (zero terminated)
    3967   00:5562                      ;TCP_OPEN_IP1               (ix+0)
    3968   00:5562                      ;TCP_OPEN_IP2               (ix+1)
    3969   00:5562                      ;TCP_OPEN_IP3               (ix+2)
    3970   00:5562                      ;TCP_OPEN_IP4               (ix+3)
    3971   00:5562                      ;TCP_OPEN_RP                (ix+4)
    3972   00:5562                      ;TCP_OPEN_LP                (ix+6)
    3973   00:5562                      ;TCP_OPEN_TO                (ix+8)
    3974   00:5562                      ;TCP_OPEN_CMD_FLAGS         (ix+10)
    3975   00:5562                      ;TCP_OPEN_CMD_HOST_LSB      (ix+11)
    3976   00:5562                      ;TCP_OPEN_CMD_HOST_MSB      (ix+12)
    3977   00:5562                      
    3978   00:5562                      ; When no connection, let's get the reason and put in register C, as agreed
    3979   00:5562                      ; with Nestor this will be the way to go in the next UNAPI revision
    3980   00:5562                      TCPIP_TCP_OPEN_ERROR:
    3981   00:5562                          ; next two bytes are return code and size bytes, don't care, it is 1, conn close reason
    3982   00:5562  47                      ld  b,a                         ; save error in b
    3983   00:5563  0E 02                   ld  c,2
    3984   00:5565                      TCPIP_TCP_OPEN_ERROR2:
    3985   00:5565                          CHECK_DATA
    3985   00:5565  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3985   00:5568  CB 47             >     bit 0,a
    3986   00:556A  20 05                   jr  nz,TCPIP_TCP_OPEN_ERROR2.1
    3987   00:556C  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3988   00:556F  18 F4                   jr  TCPIP_TCP_OPEN_ERROR2
    3989   00:5571                      TCPIP_TCP_OPEN_ERROR2.1:
    3990   00:5571                          ; nz, discard
    3991   00:5571                          RECEIVE_DATA
    3991   00:5571  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3992   00:5574  0D                      dec c
    3993   00:5575  20 EE                   jr  nz,TCPIP_TCP_OPEN_ERROR2
    3994   00:5577  78                      ld  a,b
    3995   00:5578  FE 0B                   cp  ERR_NO_CONN
    3996   00:557A  20 10                   jr  nz,TCPIP_TCP_OPEN_ERROR4    ; other errors do not have extra bytes as result
    3997   00:557C                      ; now just get the 1 byte, close reason, should go to C
    3998   00:557C                      TCPIP_TCP_OPEN_ERROR3:
    3999   00:557C                          CHECK_DATA
    3999   00:557C  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3999   00:557F  CB 47             >     bit 0,a
    4000   00:5581  20 05                   jr  nz,TCPIP_TCP_OPEN_ERROR3.1
    4001   00:5583  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4002   00:5586  18 F4                   jr  TCPIP_TCP_OPEN_ERROR3
    4003   00:5588                      TCPIP_TCP_OPEN_ERROR3.1:
    4004   00:5588                          ; nz, get it
    4005   00:5588                          RECEIVE_DATA
    4005   00:5588  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4006   00:558B  4F                      ld  c,a
    4007   00:558C                      TCPIP_TCP_OPEN_ERROR4:
    4008   00:558C                          ; now return w/ error that is saved in b
    4009   00:558C  78                      ld  a,b
    4010   00:558D  06 00                   ld  b,0                         ; no connection, so 0
    4011   00:558F  C9                      ret
    4012   00:5590                      
    4013   00:5590                      TCPIP_TCP_OPEN:
    4014   00:5590  E5                      push    hl                      ; save param block address
    4015   00:5591  7C                      ld  a,h
    4016   00:5592  DD 67                   ld  ixh,a
    4017   00:5594  7D                      ld  a,l
    4018   00:5595  DD 6F                   ld  ixl,a
    4019   00:5597                          ; IX now has the parameters area
    4020   00:5597                          ; most times it will be non tls, so this is the first test case
    4021   00:5597  21 0B 00                ld  hl,11
    4022   00:559A  CD 87 61                call    SETWORD                 ; If it is non-TLS, send 11 bytes
    4023   00:559D  DD 7E 0A                ld  a,(ix+10)                   ; TCP_OPEN_CMD_FLAGS
    4024   00:55A0  CB 57                   bit 2,a
    4025   00:55A2  28 4F                   jr  z,TCPIP_TCP_OPEN_NO_TLS
    4026   00:55A4                      
    4027   00:55A4                          ; TLS, but, do we have host name?
    4028   00:55A4  21 0C 00                ld  hl,12
    4029   00:55A7  CD 87 61                call    SETWORD                 ; If it is TLS without host name, send 12 bytes, one zero as host name suffice
    4030   00:55AA  DD 6E 0B                ld  l,(ix+11)                   ; TCP_OPEN_CMD_HOST_LSB
    4031   00:55AD  DD 7E 0C                ld  a,(ix+12)                   ; TCP_OPEN_CMD_HOST_MSB
    4032   00:55B0  B5                      or  l
    4033   00:55B1                          ; if TLS and next two bytes are 00 no host to check
    4034   00:55B1  28 40                   jr  z,TCPIP_TCP_OPEN_NO_CHECKHOST
    4035   00:55B3                          ; we are here, host to check
    4036   00:55B3  DD 66 0C                ld  h,(ix+12)                   ; TCP_OPEN_CMD_HOST_MSB
    4037   00:55B6  D1                      pop de                          ; Retrieve parameters address
    4038   00:55B7  E5                      push    hl                      ; Save host name address
    4039   00:55B8  D5                      push    de                      ; Save Parameters address (so it is in the order we are going to need)
    4040   00:55B9                          ; let's check how many bytes there are
    4041   00:55B9  11 0B 00                ld  de,11                       ; Start with 11, all params except host name
    4042   00:55BC                      TCPIP_TCP_OPEN_CHECK_HOSTOF:
    4043   00:55BC  7E                      ld  a,(hl)
    4044   00:55BD  13                      inc de                          ; Not zero, so increase size count
    4045   00:55BE  23                      inc hl                          ; And next hostname byte
    4046   00:55BF  B7                      or  a                           ; If zero, hostname terminated
    4047   00:55C0                          ; Loop until terminator (0) is found
    4048   00:55C0  C2 BC 55                jp  nz,TCPIP_TCP_OPEN_CHECK_HOSTOF
    4049   00:55C3                      
    4050   00:55C3                      TCPIP_TCP_OPEN_HOSTNAME_SENDCMDWITHHOSTNAME:
    4051   00:55C3                          ; Ok, so, DE has the full hostname size, let's start sending from here
    4052   00:55C3  3E 0D                   ld  a,13                        ; Function TCP OPEN
    4053   00:55C5                          SEND_DATA                       ; Send the command
    4053   00:55C5  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4054   00:55C8  7A                      ld  a,d
    4055   00:55C9                          SEND_DATA                       ; Send the command size msb
    4055   00:55C9  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4056   00:55CC  7B                      ld  a,e
    4057   00:55CD                          SEND_DATA                       ; Send the command size lsb
    4057   00:55CD  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4058   00:55D0  E1                      pop hl                          ; Restore the memory address for the parameters
    4059   00:55D1                          ; First send the 11 bytes parameters
    4060   00:55D1                          if USE_MEM_IO = 0
    4061   00:55D1                    ~     ld  c,OUT_TX_PORT
    4062   00:55D1                    ~     outi
    4063   00:55D1                    ~     outi
    4064   00:55D1                    ~     outi
    4065   00:55D1                    ~     outi
    4066   00:55D1                    ~     outi
    4067   00:55D1                    ~     outi
    4068   00:55D1                    ~     outi
    4069   00:55D1                    ~     outi
    4070   00:55D1                    ~     outi
    4071   00:55D1                    ~     outi
    4072   00:55D1                    ~     outi                            ; Unrolled outi is a bit faster :)
    4073   00:55D1                    ~     else
    4074   00:55D1  06 0B                   ld  b,11                        ; Send 11 bytes
    4075   00:55D3                      TCPIP_TCP_OPEN_HOSTNAME_SENDCMDWITHHOSTNAME_LOOP_PARAM:
    4076   00:55D3  7E                      ld  a,(hl)
    4077   00:55D4  32 07 7F                ld  (MEM_OUT_TX_PORT),a
    4078   00:55D7  23                      inc hl
    4079   00:55D8  10 F9                   djnz TCPIP_TCP_OPEN_HOSTNAME_SENDCMDWITHHOSTNAME_LOOP_PARAM
    4080   00:55DA                          endif
    4081   00:55DA  EB                      ex  de,hl                       ; Size in HL
    4082   00:55DB  11 0B 00                ld  de,11
    4083   00:55DE  B7                      or  a                           ; zero flag
    4084   00:55DF  ED 52                   sbc hl,de
    4085   00:55E1  EB                      ex de,hl                        ; and adjusted size back in de
    4086   00:55E2  E1                      pop hl                          ; Restore the memory address for hostname
    4087   00:55E3                      ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    4088   00:55E3  43                      ld  b,e                         ; Number of loops originaly in DE
    4089   00:55E4  1B                      dec de
    4090   00:55E5  14                      inc d
    4091   00:55E6                          if USE_MEM_IO = 0
    4092   00:55E6                    ~     ld  c,OUT_TX_PORT
    4093   00:55E6                    ~ TCPIP_TCP_OPEN_SENDHOSTNAME:
    4094   00:55E6                    ~     outi
    4095   00:55E6                    ~     jr  nz,TCPIP_TCP_OPEN_SENDHOSTNAME
