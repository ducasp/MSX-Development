    1752   00:4A18  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    1753   00:4A1B  3E 63                   ld  a,CMD_QUERY_ACLK_SETTINGS
    1754   00:4A1D                          SEND_DATA
    1754   00:4A1D  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1755   00:4A20  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1756   00:4A23  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1757   00:4A27  DD 6B                   ld  ixl,e
    1758   00:4A29  DD 62                   ld  ixh,d                       ; address in IX
    1759   00:4A2B  CD 6E 4B                call    WAIT_MENU_CMD_RESPONSE
    1760   00:4A2E  CA 27 4B                jp  z,MENU_SUB_BAD_END
    1761   00:4A31                          ; Response received, IX+0 and IX+1 has Auto Clock and GMT, A
