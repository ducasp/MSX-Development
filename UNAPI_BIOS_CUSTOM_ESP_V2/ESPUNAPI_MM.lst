    4267   00:569E  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4268   00:56A1  7A                      ld  a,d
    4269   00:56A2                          SEND_DATA                       ; Send the command size msb
    4269   00:56A2  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4270   00:56A5  7B                      ld  a,e
    4271   00:56A6                          SEND_DATA                       ; Send the command size lsb
    4271   00:56A6  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4272   00:56A9  E1                      pop hl                          ; Restore the memory address for the parameters
    4273   00:56AA                      ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    4274   00:56AA  43                      ld  b,e                         ; Number of loops originaly in DE
    4275   00:56AB  1B                      dec de
    4276   00:56AC  14                      inc d
    4277   00:56AD                          if USE_MEM_IO = 0
    4278   00:56AD                    ~     ld  c,OUT_TX_PORT
    4279   00:56AD                    ~ SSH_OPEN_SENDDATA:
    4280   00:56AD                    ~     outi
    4281   00:56AD                    ~     jr  nz,SSH_OPEN_SENDDATA
    4282   00:56AD                    ~     else
    4283   00:56AD                      SSH_OPEN_SENDDATA:
    4284   00:56AD  7E                      ld  a,(hl)
    4285   00:56AE  32 07 7F                ld  (MEM_OUT_TX_PORT),a
    4286   00:56B1  23                      inc hl
    4287   00:56B2  10 F9                   djnz SSH_OPEN_SENDDATA
    4288   00:56B4                          endif
    4289   00:56B4  15                      dec d
    4290   00:56B5  20 F6                   jr  nz,SSH_OPEN_SENDDATA
    4291   00:56B7                          ; Now wait up to 3600 (1 minute @ 60Hz) ticks to get response
    4292   00:56B7  21 10 0E                ld  hl,3600
    4293   00:56BA  CD C2 5E                call    SETCOUNTER
