    2404   00:4DA8  D5                      push    de
    2405   00:4DA9  5F                      ld  e,a
    2406   00:4DAA  16 00                   ld  d,0
    2407   00:4DAC  19                      add hl,de
    2408   00:4DAD  D1                      pop de
    2409   00:4DAE                      
