    5362   00:5C5E                          ; nz, check the data
    5363   00:5C5E                          RECEIVE_DATA
    5363   00:5C5E  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5364   00:5C61  FE 8A                   cp  #8A                         ; Is response of our command?
    5365   00:5C63  20 ED                   jr  nz,SSH_AUTH_RESPOND_ST1
    5366   00:5C65                          ; now get return code, if return code other than 0, it is finished
    5367   00:5C65                      SSH_AUTH_RESPOND_RC:
    5368   00:5C65                          CHECK_DATA
    5368   00:5C65  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5368   00:5C68  CB 47             >     bit 0,a
    5369   00:5C6A  20 05                   jr  nz,SSH_AUTH_RESPOND_RC.1
    5370   00:5C6C  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
