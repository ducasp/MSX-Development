    4364   00:5727  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4365   00:572A  05                      dec b
    4366   00:572B  20 EE                   jr  nz,SSH_OPEN_ST2
    4367   00:572D                      
    4368   00:572D                          ; now just get the 1 byte, conn#, should go to B
