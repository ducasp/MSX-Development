    5396   00:5CB4  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5397   00:5CB7  18 F4                   jr  TCPIP_TCP_STATE_ST2
    5398   00:5CB9                      TCPIP_TCP_STATE_ST2.1:
    5399   00:5CB9                          ; nz, discard
