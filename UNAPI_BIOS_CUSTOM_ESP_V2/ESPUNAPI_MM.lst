    4769   00:594C  20 EE                   jr  nz,TCPIP_TCP_STATE_ERROR2
    4770   00:594E                      
    4771   00:594E                          ; now return w/ error that is saved in b
    4772   00:594E  78                      ld  a,b
    4773   00:594F  06 00                   ld  b,0
    4774   00:5951  0E 07                   ld  c,7
    4775   00:5953  21 00 00                ld  hl,0
    4776   00:5956  11 00 00                ld  de,0
