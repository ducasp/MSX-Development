    2505   00:4E12                      ;===  Functions addresses table  ===
    2506   00:4E12                      ;===             SSH             ===
    2507   00:4E12                      ;===================================
    2508   00:4E12                      ;--- Implementation-specific routines addresses table
    2509   00:4E12                      
    2510   00:4E12                      FN_TABLE_S:
    2511   00:4E12  4A 4E               FN_0_S:                 dw  UNAPI_GET_INFO_SSH
    2512   00:4E14  55 4E               FN_1_S:                 dw  SSH_GET_CAPAB
    2513   00:4E16  B5 56               FN_2_S:                 dw  SSH_OPEN
    2514   00:4E18  E8 57               FN_3_S:                 dw  SSH_CLOSE
    2515   00:4E1A  3A 58               FN_4_S:                 dw  SSH_STATE
    2516   00:4E1C  CA 5B               FN_5_S:                 dw  SSH_SEND
    2517   00:4E1E  CA 5D               FN_6_S:                 dw  SSH_RCV
    2518   00:4E20  BC 58               FN_7_S:                 dw  SSH_TERM_TYPE
    2519   00:4E22  39 59               FN_8_S:                 dw  SSH_WIN_SIZE
    2520   00:4E24  AA 5E               FN_9_S:                 dw  SSH_AUTH_GET_CHALLENGE
    2521   00:4E26  2B 5C               FN_10_S:                dw  SSH_AUTH_RESPOND
    2522   00:4E28  96 57               FN_11_S:                dw  SSH_ADD_KNOWN_HOST
    2523   00:4E2A                      
    2524   00:4E2A                      ;========================
    2525   00:4E2A                      ;===  Functions code  ===
    2526   00:4E2A                      ;========================
    2527   00:4E2A                      FN_NOT_IMP:
    2528   00:4E2A  3E 01                   ld  a,ERR_NOT_IMP
    2529   00:4E2C  C9                      ret
    2530   00:4E2D                      
    2531   00:4E2D                      END_OK:
    2532   00:4E2D  AF                      xor a
    2533   00:4E2E  C9                      ret
    2534   00:4E2F                      
    2535   00:4E2F                      ; Most functions do not have special handling on time out and can use this.
    2536   00:4E2F                      ; If there is a need to retry sending or receiving on time-out, then a custom
    2537   00:4E2F                      ; time-out function must be done, check the examples of UDP and TCP receive
    2538   00:4E2F                      TCPIP_GENERIC_CHECK_TIME_OUT:
    2539   00:4E2F                          ; Save registers other than AF
    2540   00:4E2F  C5                      push bc
    2541   00:4E30  D5                      push de
    2542   00:4E31  E5                      push hl
    2543   00:4E32  CD 2F 61                call    GETCOUNTER
    2544   00:4E35  7D                      ld  a,l
    2545   00:4E36  B4                      or  h
    2546   00:4E37                          ; Restore registers, we are returning
    2547   00:4E37  E1                      pop hl
    2548   00:4E38  D1                      pop de
    2549   00:4E39  C1                      pop bc
    2550   00:4E3A  C0                      ret nz
    2551   00:4E3B                          ; Ok, timeout...
    2552   00:4E3B  F1                      pop af                          ; Get return address of who called this out of the stack
    2553   00:4E3C  3E 0F                   ld  a,ERR_INV_OPER
    2554   00:4E3E  C9                      ret                             ; and return the function itself
    2555   00:4E3F                      
    2556   00:4E3F                      ;========================
    2557   00:4E3F                      ;===  UNAPI_GET_INFO  ===
    2558   00:4E3F                      ;========================
    2559   00:4E3F                      ; Obtain the implementation name and version for TCP/IP.
    2560   00:4E3F                      ;
    2561   00:4E3F                      ;    Input:  A  = 0
    2562   00:4E3F                      ;    Output: HL = Descriptive string for this implementation, on this slot, zero terminated
    2563   00:4E3F                      ;            DE = API version supported, D.E
    2564   00:4E3F                      ;            BC = This implementation version, B.C.
    2565   00:4E3F                      ;            A  = 0 and Cy = 0
    2566   00:4E3F                      UNAPI_GET_INFO:
    2567   00:4E3F  01 04 01                ld  bc,256*ROM_V_P+ROM_V_S
    2568   00:4E42  11 02 01                ld  de,256*API_V_P+API_V_S
    2569   00:4E45  21 CC 72                ld  hl,APIINFO
    2570   00:4E48  AF                      xor a
    2571   00:4E49  C9                      ret
    2572   00:4E4A                      
    2573   00:4E4A                      ;========================
    2574   00:4E4A                      ;===  UNAPI_GET_INFO  ===
    2575   00:4E4A                      ;========================
    2576   00:4E4A                      ; Obtain the implementation name and version for SSH.
    2577   00:4E4A                      ;
    2578   00:4E4A                      ;    Input:  A  = 0
    2579   00:4E4A                      ;    Output: HL = Descriptive string for this implementation, on this slot, zero terminated
    2580   00:4E4A                      ;            DE = API version supported, D.E
    2581   00:4E4A                      ;            BC = This implementation version, B.C.
    2582   00:4E4A                      ;            A  = 0 and Cy = 0
    2583   00:4E4A                      UNAPI_GET_INFO_SSH:
    2584   00:4E4A  01 04 01                ld  bc,256*ROM_V_P+ROM_V_S
    2585   00:4E4D  11 02 01                ld  de,256*API_V_P+API_V_S
    2586   00:4E50  21 DD 72                ld  hl,APIINFO_SSH
    2587   00:4E53  AF                      xor a
    2588   00:4E54  C9                      ret
    2589   00:4E55                      
    2590   00:4E55                      ;=========================
    2591   00:4E55                      ;===   SSH_GET_CAPAB   ===
    2592   00:4E55                      ;=========================
    2593   00:4E55                      ; Get information about the SSH capabilities and features.
    2594   00:4E55                      ;
    2595   00:4E55                      ;    Input:  A = 1
    2596   00:4E55                      ;            B = Index of information block to retrieve:
    2597   00:4E55                      ;                1: Block 1 (only block supported, other blocks reserved for expansion)
    2598   00:4E55                      ;    Output: A = Error code
    2599   00:4E55                      ;        When information block 1 requested:
    2600   00:4E55                      ;            HL = Capabilities flags
    2601   00:4E55                      ;            B  = Maximum simultaneous SSH connections supported
    2602   00:4E55                      ;            C  = Free SSH connections currently available
    2603   00:4E55                      ;            DE = Maximum data per command
    2604   00:4E55                      SSH_GET_CAPAB:
    2605   00:4E55                          ; SSH functions start at 127 on ESP
    2606   00:4E55  CB FF                   set 7,a
    2607   00:4E57                          SEND_DATA                       ; Send the command
    2607   00:4E57  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2608   00:4E5A  AF                      xor a
    2609   00:4E5B                          SEND_DATA                       ; Send the command size msb
    2609   00:4E5B  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2610   00:4E5E  3C                      inc a
    2611   00:4E5F                          SEND_DATA                       ; Send the command size lsb
    2611   00:4E5F  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2612   00:4E62  78                      ld  a,b
    2613   00:4E63                          SEND_DATA                       ; Send the parameter
    2613   00:4E63  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2614   00:4E66                      
    2615   00:4E66                          ; Now wait up to 120 ticks to get response
    2616   00:4E66  21 78 00                ld  hl,120
    2617   00:4E69  CD 3E 61                call    SETCOUNTER
    2618   00:4E6C                      SSH_GET_CAPAB_ST1:
    2619   00:4E6C                          CHECK_DATA
    2619   00:4E6C  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2619   00:4E6F  CB 47             >     bit 0,a
    2620   00:4E71  20 05                   jr  nz,SSH_GET_CAPAB_ST1.1
    2621   00:4E73  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2622   00:4E76  18 F4                   jr  SSH_GET_CAPAB_ST1
    2623   00:4E78                      SSH_GET_CAPAB_ST1.1:
    2624   00:4E78                          ; nz, check the data
    2625   00:4E78                          RECEIVE_DATA
    2625   00:4E78  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2626   00:4E7B  FE 81                   cp  #81                         ; Is response of our command?
    2627   00:4E7D  20 ED                   jr  nz,SSH_GET_CAPAB_ST1
    2628   00:4E7F                          ; Now get return code, if return code other than 0, it is finished
    2629   00:4E7F                      SSH_GET_CAPAB_RC:
    2630   00:4E7F                          CHECK_DATA
    2630   00:4E7F  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2630   00:4E82  CB 47             >     bit 0,a
    2631   00:4E84  20 05                   jr  nz,SSH_GET_CAPAB_RC.1
    2632   00:4E86  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2633   00:4E89  18 F4                   jr  SSH_GET_CAPAB_RC
    2634   00:4E8B                      SSH_GET_CAPAB_RC.1:
    2635   00:4E8B                          ; nz, discard
    2636   00:4E8B                          RECEIVE_DATA
    2636   00:4E8B  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2637   00:4E8E  B7                      or  a                           ; 0?
    2638   00:4E8F  C0                      ret nz                          ; If not, done
