    2346   00:4D63  20 06                   jr  nz,DO_EXTBIO2SSH
    2347   00:4D65  04                      inc b
    2348   00:4D66  E3                      ex  (sp),hl
    2349   00:4D67  11 22 22                ld  de,#2222
    2350   00:4D6A  C9                      ret
    2351   00:4D6B                      
    2352   00:4D6B                      DO_EXTBIO2SSH:
    2353   00:4D6B                          ; A=1: Return A=Slot, B=Segment, HL=UNAPI entry address
    2354   00:4D6B                      
    2355   00:4D6B  3D                      dec a
    2356   00:4D6C  20 0D                   jr  nz,DO_EXTBIO3SSH
    2357   00:4D6E  E1                      pop hl
    2358   00:4D6F  CD B6 60                call    GETSLTT                 ; GETSLTT is GETSLT that checks if our memory area @ HIMEM has been allocated, if not, allocate it
    2359   00:4D72  06 FF                   ld  b,#FF
    2360   00:4D74  21 EC 4D                ld  hl,UNAPI2_ENTRY
    2361   00:4D77  11 22 22                ld  de,#2222
