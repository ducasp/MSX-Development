    4982   00:5A6D  18 F4                   jr  TCPIP_TCP_STATE_ST1
    4983   00:5A6F                      TCPIP_TCP_STATE_ST1.1:
    4984   00:5A6F                          ; nz, check the data
    4985   00:5A6F                          RECEIVE_DATA
    4985   00:5A6F  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
