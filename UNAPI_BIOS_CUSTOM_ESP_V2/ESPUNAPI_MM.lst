    2358   00:4D74  20 0D                   jr  nz,DO_EXTBIO3SSH
    2359   00:4D76  E1                      pop hl
    2360   00:4D77  CD BE 60                call    GETSLTT                 ; GETSLTT is GETSLT that checks if our memory area @ HIMEM has been allocated, if not, allocate it
    2361   00:4D7A  06 FF                   ld  b,#FF
    2362   00:4D7C  21 F4 4D                ld  hl,UNAPI2_ENTRY
    2363   00:4D7F  11 22 22                ld  de,#2222
