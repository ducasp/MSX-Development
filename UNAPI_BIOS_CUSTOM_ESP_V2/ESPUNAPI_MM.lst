    6473   00:6256                      ;=========================
    6474   00:6256                      ;===  TCPIP_CONFIG_IP  ===
    6475   00:6256                      ;=========================
    6476   00:6256                      ;Manually configure an IP address.
    6477   00:6256                      ;
    6478   00:6256                      ;Input:  A = 26
    6479   00:6256                      ;        B = Index of address to set:
    6480   00:6256                      ;            1: Local IP address
    6481   00:6256                      ;            2: Peer IP address
    6482   00:6256                      ;            3: Subnet mask
    6483   00:6256                      ;            4: Default gateway
    6484   00:6256                      ;            5: Primary DNS server IP address
    6485   00:6256                      ;            6: Secondary DNS server IP address
    6486   00:6256                      ;        L.H.E.D = Address value
    6487   00:6256                      ;Output: A = Error code
    6488   00:6256                      TCPIP_CONFIG_IP:
    6489   00:6256                          SEND_DATA                       ; Send the command
    6489   00:6256  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6490   00:6259  AF                      xor a
    6491   00:625A                          SEND_DATA                       ; Send the command size msb
    6491   00:625A  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6492   00:625D  3E 05                   ld  a,5
    6493   00:625F                          SEND_DATA                       ; Send the command size lsb
    6493   00:625F  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6494   00:6262  78                      ld  a,b
    6495   00:6263                          SEND_DATA                       ; Send the address to set
    6495   00:6263  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6496   00:6266  7D                      ld  a,l
    6497   00:6267                          SEND_DATA                       ; Send the IP first byte
    6497   00:6267  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6498   00:626A  7C                      ld  a,h
    6499   00:626B                          SEND_DATA                       ; Send the IP second byte
    6499   00:626B  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6500   00:626E  7B                      ld  a,e
    6501   00:626F                          SEND_DATA                       ; Send the IP third byte
    6501   00:626F  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6502   00:6272  7A                      ld  a,d
    6503   00:6273                          SEND_DATA                       ; Send the IP fourth byte
    6503   00:6273  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6504   00:6276                      
    6505   00:6276                          ; Now wait up to 180 ticks to get response
    6506   00:6276  21 B4 00                ld  hl,180
    6507   00:6279  CD 61 63                call    SETCOUNTER
