    1758   00:4A24  C9                      ret                             ; Time out and continue
    1759   00:4A25                      
    1760   00:4A25                      ; Check Auto Clock
    1761   00:4A25                      ISCLKAUTO:
    1762   00:4A25                          CLEAR_UART
    1762   00:4A25  3E 14             >     ld  a,20
    1762   00:4A27  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    1763   00:4A2A  3E 63                   ld  a,CMD_QUERY_ACLK_SETTINGS
    1764   00:4A2C                          SEND_DATA
    1764   00:4A2C  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1765   00:4A2F  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1766   00:4A32  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1767   00:4A36  DD 6B                   ld  ixl,e
    1768   00:4A38  DD 62                   ld  ixh,d                       ; address in IX
    1769   00:4A3A  CD 7D 4B                call    WAIT_MENU_CMD_RESPONSE
    1770   00:4A3D  CA 36 4B                jp  z,MENU_SUB_BAD_END
    1771   00:4A40                          ; Response received, IX+0 and IX+1 has Auto Clock and GMT, A
    1772   00:4A40  C9                      ret
    1773   00:4A41                      
    1774   00:4A41                      ; Check what is the current NAGLE setting
    1775   00:4A41                      CHECKNAGLE:
    1776   00:4A41                          CLEAR_UART
    1776   00:4A41  3E 14             >     ld  a,20
    1776   00:4A43  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    1777   00:4A46  3E 51                   ld  a,CMD_QUERY_ESP_SETTINGS
    1778   00:4A48                          SEND_DATA
    1778   00:4A48  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1779   00:4A4B  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1780   00:4A4E  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1781   00:4A52  DD 6B                   ld  ixl,e
    1782   00:4A54  DD 62                   ld  ixh,d                       ; Address in IX
    1783   00:4A56  CD 7D 4B                call    WAIT_MENU_CMD_RESPONSE
    1784   00:4A59  CA 36 4B                jp  z,MENU_SUB_BAD_END
    1785   00:4A5C                          ; Response received, nagle is the first one, ON: or OFF:
    1786   00:4A5C  3E 4F                   ld  a,'O'
    1787   00:4A5E  DD BE 00                cp  (ix+0)
    1788   00:4A61  C2 36 4B                jp  nz,MENU_SUB_BAD_END
    1789   00:4A64  3E 4E                   ld  a,'N'
    1790   00:4A66  DD BE 01                cp  (ix+1)
    1791   00:4A69  C2 76 4A                jp  nz,CHECK_NAGLE_OFF
    1792   00:4A6C  3E 3A                   ld  a,':'
    1793   00:4A6E  DD BE 02                cp  (ix+2)
    1794   00:4A71  C2 36 4B                jp  nz,MENU_SUB_BAD_END
    1795   00:4A74  B7                      or  a                           ; It will make it NZ
    1796   00:4A75  C9                      ret
    1797   00:4A76                      CHECK_NAGLE_OFF:
    1798   00:4A76  3E 46                   ld  a,'F'
    1799   00:4A78  DD BE 01                cp  (ix+1)
    1800   00:4A7B  C2 36 4B                jp  nz,MENU_SUB_BAD_END
    1801   00:4A7E  3E 46                   ld  a,'F'
    1802   00:4A80  DD BE 02                cp  (ix+2)
    1803   00:4A83  C2 36 4B                jp  nz,MENU_SUB_BAD_END
    1804   00:4A86  3E 3A                   ld  a,':'
    1805   00:4A88  DD BE 03                cp  (ix+3)
    1806   00:4A8B  C2 36 4B                jp  nz,MENU_SUB_BAD_END
    1807   00:4A8E                          ; Already has zero, so just ret
    1808   00:4A8E  C9                      ret
    1809   00:4A8F                      
    1810   00:4A8F                      ; Check what is the current TIMEOUT setting, return 0 if always on, otherwise there is a timeout
    1811   00:4A8F                      ; Will return a zero terminated string @ HL that can be printed
    1812   00:4A8F                      ; Will return the value in DE
    1813   00:4A8F                      CHECKTIMEOUT:
    1814   00:4A8F                          CLEAR_UART
    1814   00:4A8F  3E 14             >     ld  a,20
    1814   00:4A91  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    1815   00:4A94  3E 51                   ld  a,CMD_QUERY_ESP_SETTINGS
    1816   00:4A96                          SEND_DATA
    1816   00:4A96  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1817   00:4A99  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1818   00:4A9C  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1819   00:4AA0  DD 6B                   ld  ixl,e
    1820   00:4AA2  DD 62                   ld  ixh,d                       ; Address in IX
    1821   00:4AA4  CD 7D 4B                call    WAIT_MENU_CMD_RESPONSE
    1822   00:4AA7  CA 36 4B                jp  z,MENU_SUB_BAD_END
    1823   00:4AAA                          ; Response received, nagle is the first one, ON: or OFF:
    1824   00:4AAA  3E 3A                   ld  a,':'
    1825   00:4AAC  DD 23                   inc ix
    1826   00:4AAE  DD 23                   inc ix                          ; Nagle response is two or three bytes long, let's check
    1827   00:4AB0  0B                      dec bc
    1828   00:4AB1  0B                      dec bc                          ; Remaining bytes
    1829   00:4AB2  DD BE 00                cp  (ix+0)
    1830   00:4AB5  CA C1 4A                jp  z,CHECKTIMEOUT.1
    1831   00:4AB8  DD 23                   inc ix
    1832   00:4ABA  0B                      dec bc                          ; Remaining bytes
    1833   00:4ABB  DD BE 00                cp  (ix+0)
    1834   00:4ABE  C2 36 4B                jp  nz,MENU_SUB_BAD_END         ; If not here, sorry to say it is an error
    1835   00:4AC1                      CHECKTIMEOUT.1:
    1836   00:4AC1  78                      ld  a,b
    1837   00:4AC2  B1                      or  c                           ; All data read?
    1838   00:4AC3  CA 36 4B                jp  z,MENU_SUB_BAD_END          ; If so, sorry to say it is an error
    1839   00:4AC6  DD 23                   inc ix                          ; At the first digit
    1840   00:4AC8  0B                      dec bc                          ; Remaining bytes
    1841   00:4AC9  78                      ld  a,b
    1842   00:4ACA  B1                      or  c                           ; All data read?
    1843   00:4ACB  CA 36 4B                jp  z,MENU_SUB_BAD_END          ; If so, sorry to say it is an error
    1844   00:4ACE  DD E5                   push    ix                      ; This is the start of the string, save it
    1845   00:4AD0  26 00                   ld  h,0                         ; No digit so far
    1846   00:4AD2                          ; It can have up to three digits
    1847   00:4AD2                      CHECKTIMEOUT.2:
    1848   00:4AD2  3E 3A                   ld  a,':'
    1849   00:4AD4  DD BE 00                cp  (ix+0)                      ; Check if it is the separator
    1850   00:4AD7  CA F8 4A                jp  z,CHECKTIMEOUT.3            ; If it is routine will follow through
    1851   00:4ADA  DD 7E 00                ld  a,(ix+0)                    ; Get the supposed digit in A
    1852   00:4ADD  2E 3A                   ld  l,'9'+1
    1853   00:4ADF  BD                      cp  l
    1854   00:4AE0  D2 35 4B                jp  nc,MENU_SUB_BAD_END_1S      ; If more than '9', sorry to say it is an error
    1855   00:4AE3  2E 30                   ld  l,'0'
    1856   00:4AE5  BD                      cp  l
    1857   00:4AE6  DA 35 4B                jp  c,MENU_SUB_BAD_END_1S       ; If less than '0', sorry to say it is an error
    1858   00:4AE9  24                      inc h                           ; It is not, so it is a digit
    1859   00:4AEA  3E 03                   ld  a,3
    1860   00:4AEC  BC                      cp  h
    1861   00:4AED  DA 35 4B                jp  c,MENU_SUB_BAD_END_1S       ; If more than three digits, sorry to say it is an error
    1862   00:4AF0  DD 23                   inc ix                          ; Increase pointer
    1863   00:4AF2  0B                      dec bc                          ; Decrease remaining
    1864   00:4AF3  78                      ld  a,b
    1865   00:4AF4  B1                      or  c                           ; All data read?
    1866   00:4AF5  C2 D2 4A                jp  nz,CHECKTIMEOUT.2           ; Not, so rinse and repeat
    1867   00:4AF8                      CHECKTIMEOUT.3:
    1868   00:4AF8  DD 36 00 00             ld  (ix+0),0                    ; Null terminate string value
    1869   00:4AFC  DD 2B                   dec ix
    1870   00:4AFE  DD 7E 00                ld  a,(ix+0)                    ; 1st Digit in A
    1871   00:4B01  D6 30                   sub '0'                         ; Convert it to decimal value
    1872   00:4B03  5F                      ld  e,a
    1873   00:4B04  16 00                   ld  d,0                         ; DE has first digit
    1874   00:4B06  25                      dec h                           ; Decrement digit counter
    1875   00:4B07  28 28                   jr  z,CHECKTIMEOUT.END          ; If all digits, done
    1876   00:4B09                          ; Now second digit, multiply it by 10 and add to E, even if 90 + 9, still fits E
    1877   00:4B09  DD 2B                   dec ix
    1878   00:4B0B  DD 7E 00                ld  a,(ix+0)                    ; 2nd Digit
    1879   00:4B0E  D6 30                   sub '0'                         ; Convert it to decimal value
    1880   00:4B10  87                      add a,a                         ; A has *2
    1881   00:4B11  4F                      ld  c,a                         ; C has *2
    1882   00:4B12  87                      add a,a                         ; A has *4
    1883   00:4B13  87                      add a,a                         ; A has *8
    1884   00:4B14  81                      add a,c                         ; A has *10
    1885   00:4B15  83                      add a,e                         ; A has two digits result
    1886   00:4B16  5F                      ld  e,a                         ; Back to E, DE has two digits results
    1887   00:4B17  25                      dec h                           ; Decrement digit counter
    1888   00:4B18  28 17                   jr  z,CHECKTIMEOUT.END          ; If all digits, done
    1889   00:4B1A                          ; Now Third digit, multiply it by 100 and add to DE
    1890   00:4B1A  DD 2B                   dec ix
    1891   00:4B1C  DD 7E 00                ld  a,(ix+0)                    ; 3rd Digit
    1892   00:4B1F  D6 30                   sub '0'                         ; Convert it to decimal value
    1893   00:4B21  87                      add a,a                         ; A has *2
    1894   00:4B22  4F                      ld  c,a                         ; C has *2
    1895   00:4B23  87                      add a,a                         ; A has *4
    1896   00:4B24  87                      add a,a                         ; A has *8
    1897   00:4B25  81                      add a,c                         ; A has *10
    1898   00:4B26  26 00                   ld  h,0
    1899   00:4B28  6F                      ld  l,a                         ; HL has *10
    1900   00:4B29  29                      add hl,hl                       ; HL has *20
    1901   00:4B2A  44                      ld  b,h
    1902   00:4B2B  4D                      ld  c,l                         ; BC has *20
    1903   00:4B2C  29                      add hl,hl                       ; HL has *40
    1904   00:4B2D  29                      add hl,hl                       ; HL has *80
    1905   00:4B2E  09                      add hl,bc                       ; HL has *100
    1906   00:4B2F  19                      add hl,de                       ; HL has three digit value
    1907   00:4B30  EB                      ex  de,hl                       ; now in DE
    1908   00:4B31                      CHECKTIMEOUT.END:
    1909   00:4B31  E1                      pop hl                          ; Restore address of string version of time count
    1910   00:4B32  7A                      ld  a,d
    1911   00:4B33  B3                      or  e                           ; Set zero flag according to the time out set
    1912   00:4B34  C9                      ret
    1913   00:4B35                      
    1914   00:4B35                      MENU_SUB_BAD_END_1S:
    1915   00:4B35  F1                      pop af                          ; 1 register was stacked, pop it
    1916   00:4B36                      MENU_SUB_BAD_END:
    1917   00:4B36  F1                      pop af                          ; It was a sub, so clear stack
    1918   00:4B37                      MENU_BAD_END:
    1919   00:4B37  21 02 71                ld  hl,STR_SENDING_FAIL         ; error message
    1920   00:4B3A  CD A5 4C                call    PRINTHL
    1921   00:4B3D  C3 16 4A                jp  WAIT_2S_AND_THEN_MAINMENU
    1922   00:4B40                      
    1923   00:4B40                      ; WAIT an ESP quick command Response
    1924   00:4B40                      ; Inputs:
    1925   00:4B40                      ; A -> Command Code
    1926   00:4B40                      ; HL -> Timeout
    1927   00:4B40                      ;
    1928   00:4B40                      ; Returns:
    1929   00:4B40                      ; Flag Z is zero if failure, non zero if success
    1930   00:4B40                      ;
    1931   00:4B40                      ; Affect:
    1932   00:4B40                      ; AF and HL
    1933   00:4B40                      ;
    1934   00:4B40                      WAIT_MENU_QCMD_RESPONSE:
    1935   00:4B40  D5                      push    de
    1936   00:4B41  57                      ld  d,a                         ; Command to wait in D
    1937   00:4B42                      WAIT_MENU_QCMD_RESPONSE_ST1:
    1938   00:4B42                          LOAD_STS_PORT_IN_A
    1938   00:4B42  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    1939   00:4B45  CB 6F                   bit 5,a                         ; If nz Port #07 is not available
    1940   00:4B47  C2 77 4B                jp  nz,WAIT_MENU_QCMD_RESPONSE_END_NOK
    1941   00:4B4A  CB 47                   bit 0,a                         ; If nz has data
    1942   00:4B4C  20 08                   jr  nz,WAIT_MENU_QCMD_RESPONSE_ST1.1
    1943   00:4B4E  CD 9F 4C                call    HLTIMEOUT
    1944   00:4B51  20 EF                   jr  nz,WAIT_MENU_QCMD_RESPONSE_ST1
    1945   00:4B53  C3 75 4B                jp  WAIT_MENU_QCMD_RESPONSE_END ; If time out waiting, return
    1946   00:4B56                      WAIT_MENU_QCMD_RESPONSE_ST1.1:
    1947   00:4B56                          ; nz, check the data
    1948   00:4B56                          RECEIVE_DATA
    1948   00:4B56  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    1949   00:4B59  BA                      cp  d                           ; Is response of our command?
    1950   00:4B5A  20 E6                   jr  nz,WAIT_MENU_QCMD_RESPONSE_ST1
    1951   00:4B5C                          ; Now get return code, if return code other than 0, it is failure, otherwise success
    1952   00:4B5C                      WAIT_MENU_QCMD_RESPONSE_RC:
    1953   00:4B5C                          CHECK_DATA
    1953   00:4B5C  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    1953   00:4B5F  CB 47             >     bit 0,a
    1954   00:4B61  20 08                   jr  nz,WAIT_MENU_QCMD_RESPONSE_RC.1
    1955   00:4B63  CD 9F 4C                call    HLTIMEOUT
    1956   00:4B66  20 F4                   jr  nz,WAIT_MENU_QCMD_RESPONSE_RC
    1957   00:4B68  C3 75 4B                jp  WAIT_MENU_QCMD_RESPONSE_END ; If time-out waiting, return
    1958   00:4B6B                      WAIT_MENU_QCMD_RESPONSE_RC.1:
    1959   00:4B6B                          RECEIVE_DATA
    1959   00:4B6B  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    1960   00:4B6E  B7                      or  a                           ; 0?
    1961   00:4B6F                          ; If not, done
    1962   00:4B6F  C2 77 4B                jp  nz,WAIT_MENU_QCMD_RESPONSE_END_NOK
