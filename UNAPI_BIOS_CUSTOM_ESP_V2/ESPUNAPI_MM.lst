    5426   00:5CDC  B7                      or  a                           ; 0?
    5427   00:5CDD  28 04                   jr  z,SSH_RCV_ST2A              ; if not, done
    5428   00:5CDF  01 00 00                ld  bc,0                        ; no data received
    5429   00:5CE2  C9                      ret
    5430   00:5CE3                          ; next two bytes are response size bytes save it to BC
    5431   00:5CE3                      SSH_RCV_ST2A:
    5432   00:5CE3                          CHECK_DATA
    5432   00:5CE3  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5432   00:5CE6  CB 47             >     bit 0,a
    5433   00:5CE8  20 05                   jr  nz,SSH_RCV_ST2A.1
    5434   00:5CEA  CD 4A 5B                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5435   00:5CED  18 F4                   jr  SSH_RCV_ST2A
