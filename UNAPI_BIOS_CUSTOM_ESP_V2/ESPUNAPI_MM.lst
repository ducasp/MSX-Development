    5872   00:5F1D                          RECEIVE_DATA
    5872   00:5F1D  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5873   00:5F20  67                      ld h,a
    5874   00:5F21                      SSH_AUTH_GET_CHALLENGE_ST2B:
    5875   00:5F21                          CHECK_DATA
    5875   00:5F21  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5875   00:5F24  CB 47             >     bit 0,a
    5876   00:5F26  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_ST2B.1
    5877   00:5F28  CD 8C 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5878   00:5F2B  18 F4                   jr  SSH_AUTH_GET_CHALLENGE_ST2B
    5879   00:5F2D                      SSH_AUTH_GET_CHALLENGE_ST2B.1:
    5880   00:5F2D                          ; nz, low byte count of bytes to receive
    5881   00:5F2D                          RECEIVE_DATA
    5881   00:5F2D  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5882   00:5F30  6F                      ld  l,a
    5883   00:5F31  CD 4E 61                call    GETBYTE                 ; if return was err buff...
    5884   00:5F34  D6 0D                   sub 13
    5885   00:5F36  20 23                   jr  nz,SSH_AUTH_GET_CHALLENGE_ST2BB.1
    5886   00:5F38                          ; If here we need to have A as 13, B and C with needed buffer size
    5887   00:5F38                      SSH_AUTH_GET_CHALLENGE_BUFERRA:
    5888   00:5F38                          CHECK_DATA
    5888   00:5F38  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5888   00:5F3B  CB 47             >     bit 0,a
    5889   00:5F3D  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_BUFERRA.1
    5890   00:5F3F  CD 8C 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5891   00:5F42  18 F4                   jr  SSH_AUTH_GET_CHALLENGE_BUFERRA
    5892   00:5F44                      SSH_AUTH_GET_CHALLENGE_BUFERRA.1:
    5893   00:5F44                          ; nz, low byte count of bytes to receive
    5894   00:5F44                          RECEIVE_DATA
    5894   00:5F44  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5895   00:5F47  4F                      ld c,a
    5896   00:5F48                      SSH_AUTH_GET_CHALLENGE_BUFERRB:
    5897   00:5F48                          CHECK_DATA
    5897   00:5F48  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5897   00:5F4B  CB 47             >     bit 0,a
