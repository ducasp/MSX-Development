    1057   00:4525  3E 0B                   ld  a,11                        ; So, eleven
    1058   00:4527  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1059   00:452A  DD 77 01                ld  (ix+1),a                    ; Save
    1060   00:452D  79                      ld  a,c
