    5781   00:5E95                      ;==============================
    5782   00:5E95                      ;=== SSH_AUTH_GET_CHALLENGE ===
    5783   00:5E95                      ;==============================
    5784   00:5E95                      ;Receive keyboard interactive challenge data from a SSH connection.
    5785   00:5E95                      ;
    5786   00:5E95                      ;Input:   A  = 9
    5787   00:5E95                      ;         B  = Connection number
    5788   00:5E95                      ;         DE = Address for the retrieved data
    5789   00:5E95                      ;         HL = Max Length of the data to be obtained
    5790   00:5E95                      ;Output:  A  = Error code
    5791   00:5E95                      ;         BC = Total number of bytes that have been actually retrieved
    5792   00:5E95                      ;         H  = Number of prompts
    5793   00:5E95                      ;         L  = Echo flag bitmap
    5794   00:5E95                      ; Save registers other than AF
    5795   00:5E95                      SSH_AUTH_GET_CHALLENGE_RETRY_QRCV:
    5796   00:5E95  CD 4E 61                call    GETBYTE
    5797   00:5E98  B7                      or  a
    5798   00:5E99  28 0C                   jr  z,SSH_AUTH_GET_CHALLENGE_CHECK_TIME_OUT.NORXRETRY
    5799   00:5E9B                          ; Ok, so let's ask ESP to re-send the data and retry receiving it
    5800   00:5E9B  3D                      dec a
    5801   00:5E9C  CD 60 61                call    SETBYTE                 ; we are retrying it
    5802   00:5E9F  3E 72                   ld  a,'r'                       ; retry transmission command
    5803   00:5EA1                          SEND_DATA
    5803   00:5EA1  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5804   00:5EA4  C3 CE 5E                jp  SSH_AUTH_GET_CHALLENGE.RXRETRY             ; and retry it
    5805   00:5EA7                      SSH_AUTH_GET_CHALLENGE_CHECK_TIME_OUT.NORXRETRY:
    5806   00:5EA7  3E 0F                   ld  a,ERR_INV_OPER
    5807   00:5EA9  C9                      ret                             ; and return the function itself
    5808   00:5EAA                      
    5809   00:5EAA                      SSH_AUTH_GET_CHALLENGE:
    5810   00:5EAA  EB                      ex  de,hl
    5811   00:5EAB  CD 87 61                call    SETWORD
    5812   00:5EAE  EB                      ex  de,hl
    5813   00:5EAF  3E 89                   ld  a,#89
    5814   00:5EB1                          SEND_DATA                       ; Send the command
    5814   00:5EB1  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5815   00:5EB4  AF                      xor a
    5816   00:5EB5                          SEND_DATA                       ; Send the command size msb
    5816   00:5EB5  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5817   00:5EB8  3E 03                   ld  a,3
    5818   00:5EBA                          SEND_DATA                       ; Send the command size lsb
    5818   00:5EBA  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5819   00:5EBD  78                      ld  a,b
    5820   00:5EBE                          SEND_DATA                       ; Send the connection #
    5820   00:5EBE  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5821   00:5EC1  7D                      ld  a,l
    5822   00:5EC2                          SEND_DATA                       ; Send MAX rcv size LSB
    5822   00:5EC2  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5823   00:5EC5  7C                      ld  a,h
    5824   00:5EC6                          SEND_DATA                       ; Send MAX rcv size MSB
    5824   00:5EC6  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5825   00:5EC9  3E 03                   ld  a,3
    5826   00:5ECB  CD 60 61                call    SETBYTE                 ; Ok, retry up to three times
    5827   00:5ECE                      SSH_AUTH_GET_CHALLENGE.RXRETRY:
    5828   00:5ECE                          ; Now wait up to 600 ticks to get response
    5829   00:5ECE  21 58 02                ld  hl,600
    5830   00:5ED1  CD 3E 61                call    SETCOUNTER
