    7375   00:6576                      ; http://map.grauw.nl/articles/vdp_tut.php
    7376   00:6576                      ; Set VDP address counter to write from address AHL (17-bits)
    7377   00:6576                      ; Enables the interrupts
    7378   00:6576                      SET_VDP_WRITE:
    7379   00:6576  CB 04                   rlc h
    7380   00:6578  17                      rla
    7381   00:6579  CB 04                   rlc h
    7382   00:657B  17                      rla
    7383   00:657C  CB 3C                   srl h
    7384   00:657E  CB 3C                   srl h
    7385   00:6580  F3                      di
    7386   00:6581  D3 99                   out (#99),a
    7387   00:6583  3E 8E                   ld  a,14+128
    7388   00:6585  D3 99                   out (#99),a
    7389   00:6587  7D                      ld  a,l
    7390   00:6588  00                      nop                             ; Do not remove this 'nop' here!
    7391   00:6589  D3 99                   out (#99),a
    7392   00:658B  7C                      ld  a,h
    7393   00:658C  F6 40                   or  64
    7394   00:658E  FB                      ei
    7395   00:658F  D3 99                   out (#99),a
    7396   00:6591  C9                      ret
