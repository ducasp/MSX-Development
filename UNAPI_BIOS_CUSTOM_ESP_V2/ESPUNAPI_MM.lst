    4579   00:583A                      ;=========================
    4580   00:583A                      ;===     SSH_STATE     ===
    4581   00:583A                      ;=========================
    4582   00:583A                      ;Get the state of a SSH connection.
    4583   00:583A                      ;
    4584   00:583A                      ;Input:  A = 4
    4585   00:583A                      ;        B = Connection number
    4586   00:583A                      ;Output: A = Error code
    4587   00:583A                      ;        B = Connection state
    4588   00:583A                      ;       HL = Number of available bytes
    4589   00:583A                      SSH_STATE:
    4590   00:583A  CB FF                   set 7,a                         ; ESP SSH commands start at #80
    4591   00:583C                          SEND_DATA                       ; Send the command
    4591   00:583C  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4592   00:583F  AF                      xor a
    4593   00:5840                          SEND_DATA                       ; Send the command size msb
    4593   00:5840  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4594   00:5843  3E 01                   ld  a,1
