    1147   00:45DD  CD A2 00                call    CHPUT
    1148   00:45E0  3E 2D                   ld  a,'-'                       ; Dash
    1149   00:45E2  CD A2 00                call    CHPUT
    1150   00:45E5  3E 20                   ld  a,' '                       ; Space
    1151   00:45E7  CD A2 00                call    CHPUT
    1152   00:45EA  06 18                   ld  b,24                        ; Cuts AP names > 23 chars
    1153   00:45EC                      PRT_APNAMELP:
