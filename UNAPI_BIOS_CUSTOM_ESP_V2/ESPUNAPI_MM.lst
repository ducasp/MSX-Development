    3120   00:513D                          ; done
    3121   00:513D  AF                      xor a
    3122   00:513E  C9                      ret
    3123   00:513F                      
    3124   00:513F                      ;=====================
    3125   00:513F                      ;===  TCPIP_DNS_Q  ===
    3126   00:513F                      ;=====================
    3127   00:513F                      ;Start a host name resolution query.
    3128   00:513F                      ;
    3129   00:513F                      ;Input:  A  = 6
    3130   00:513F                      ;        HL = Address of the host name to be resolved, zero terminated
    3131   00:513F                      ;        B  = Flags, when set to 1 they instruct the resolver to:
    3132   00:513F                      ;             bit 0: Only abort the query currently in progress, if there is any
    3133   00:513F                      ;                    (other flags and registers are then ignored)
    3134   00:513F                      ;             bit 1: Assume that the passed name is an IP address,
    3135   00:513F                      ;                    and return an error if this is not true
    3136   00:513F                      ;             bit 2: If there is a query in progress already,
    3137   00:513F                      ;                    do NOT abort it and return an error instead
    3138   00:513F                      ;Output:  A = Error code
    3139   00:513F                      ;         B = 0 if a query to a DNS server is in progress
    3140   00:513F                      ;             1 if the name represented an IP address
    3141   00:513F                      ;             2 if the name could be resolved locally
    3142   00:513F                      ;         L.H.E.D = Resolved IP address
    3143   00:513F                      ;                   (only if no error occurred and B=1 or 2 is returned)
    3144   00:513F                      ;RAM Buffer to store names to be resolved (and used also to translate IPs from ASCII to 32bits number)
    3145   00:513F                      ;Will store the result of the last DNS query
    3146   00:513F                      TCPIP_DNS_Q:
    3147   00:513F  E5                      push    hl                      ; Save HL
    3148   00:5140  AF                      xor a
    3149   00:5141  5F                      ld  e,a
    3150   00:5142  57                      ld  d,a                         ; Zero DE
    3151   00:5143                      TCPIP_DNS_Q_SIZE_LOOP:
    3152   00:5143  7E                      ld  a,(hl)                      ; so let's check the size of dns data
    3153   00:5144  B7                      or  a                           ; it is zero terminated
    3154   00:5145  28 05                   jr  z,TCPIP_DNS_Q_SEND          ; if zero, end of string
    3155   00:5147  13                      inc de                          ; ok, not zero, one more char
    3156   00:5148  23                      inc hl                          ; next
    3157   00:5149  C3 43 51                jp  TCPIP_DNS_Q_SIZE_LOOP       ; jp is a tad bit faster and we are not worried about code size
    3158   00:514C                      TCPIP_DNS_Q_SEND:
    3159   00:514C                          ; Here we send the query and wait the result
    3160   00:514C  13                      inc de                          ; add 1, we will send flag first
    3161   00:514D  3E CE                   ld  a,206                       ; DNS_Q_NEW
    3162   00:514F                          SEND_DATA                       ; Send the command
    3162   00:514F  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3163   00:5152  7A                      ld  a,d
    3164   00:5153                          SEND_DATA                       ; Send the command size msb
    3164   00:5153  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3165   00:5156  7B                      ld  a,e
    3166   00:5157                          SEND_DATA                       ; Send the command size lsb
    3166   00:5157  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3167   00:515A  78                      ld  a,b
    3168   00:515B                          SEND_DATA                       ; Send the flag byte
    3168   00:515B  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3169   00:515E                      
    3170   00:515E                          if USE_MEM_IO = 0
    3171   00:515E                    ~     ; now otir of DNS/DNS BUFFER DATA SIZE
    3172   00:515E                    ~     ld  c,OUT_TX_PORT               ; our data TX port
    3173   00:515E                    ~     endif
    3174   00:515E  E1                      pop hl                          ; string to try to resolve
    3175   00:515F  1B                      dec de                          ; we are sending just data addressed by HL, so revert count
    3176   00:5160  7A                      ld  a,d
    3177   00:5161  B3                      or  e                           ; if de zero, no string, wrong parameters, but let the ESP answer
    3178   00:5162  CA 74 51                jp  z,TCPIP_DNS_Q_WAIT_RSP
    3179   00:5165  AF                      xor a
    3180   00:5166                          ; Fast 16 bit variable size loop by GRAUW
    3181   00:5166  43                      ld  b,e
    3182   00:5167  1B                      dec de
    3183   00:5168  14                      inc d
    3184   00:5169                      TCPIP_DNS_Q_SENDLP:
    3185   00:5169                          ; send it
    3186   00:5169                          if USE_MEM_IO = 0
    3187   00:5169                    ~     outi
    3188   00:5169                    ~     jp  nz,TCPIP_DNS_Q_SENDLP
    3189   00:5169                    ~     else
    3190   00:5169  7E                      ld  a,(hl)
    3191   00:516A  32 07 7F                ld  (MEM_OUT_TX_PORT),a
    3192   00:516D  23                      inc hl
    3193   00:516E  10 F9                   djnz TCPIP_DNS_Q_SENDLP
    3194   00:5170                          endif
    3195   00:5170  15                      dec d
    3196   00:5171  C2 69 51                jp  nz,TCPIP_DNS_Q_SENDLP
    3197   00:5174                      TCPIP_DNS_Q_WAIT_RSP:
    3198   00:5174                          ; Now wait up to 900 ticks (15s@60Hz) to get response
    3199   00:5174  21 84 03                ld  hl,900
    3200   00:5177  CD 36 61                call    SETCOUNTER
    3201   00:517A                      TCPIP_DNSQ_SEND_ST1:
    3202   00:517A                          CHECK_DATA
    3202   00:517A  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3202   00:517D  CB 47             >     bit 0,a
    3203   00:517F  20 05                   jr  nz,TCPIP_DNSQ_SEND_ST1.1
    3204   00:5181  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3205   00:5184  18 F4                   jr  TCPIP_DNSQ_SEND_ST1
    3206   00:5186                      TCPIP_DNSQ_SEND_ST1.1:
    3207   00:5186                          ; nz, check the data
    3208   00:5186                          RECEIVE_DATA
    3208   00:5186  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3209   00:5189  FE CE                   cp  206                         ; Is response of our command?
    3210   00:518B  20 ED                   jr  nz,TCPIP_DNSQ_SEND_ST1
    3211   00:518D                          ; now get return code, if return code other than 0, it is finished
    3212   00:518D                      TCPIP_DNSQ_SEND_RC:
    3213   00:518D                          CHECK_DATA
    3213   00:518D  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3213   00:5190  CB 47             >     bit 0,a
    3214   00:5192  20 05                   jr  nz,TCPIP_DNSQ_SEND_RC.1
    3215   00:5194  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3216   00:5197  18 F4                   jr  TCPIP_DNSQ_SEND_RC
    3217   00:5199                      TCPIP_DNSQ_SEND_RC.1:
    3218   00:5199                          ; nz, discard
    3219   00:5199                          RECEIVE_DATA
    3219   00:5199  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3220   00:519C  B7                      or  a                           ; 0?
    3221   00:519D  06 00                   ld  b,0                         ; say in progress as there is no failure status
    3222   00:519F  C0                      ret nz                          ; if not, done, ERROR won't return data
    3223   00:51A0                      
    3224   00:51A0                          ; next two bytes are return code and size bytes, don't care, it is 4, resolved IP
    3225   00:51A0  06 02                   ld  b,2
    3226   00:51A2                      TCPIP_DNSQ_SEND_RC_ST2:
    3227   00:51A2                          CHECK_DATA
    3227   00:51A2  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3227   00:51A5  CB 47             >     bit 0,a
    3228   00:51A7  20 05                   jr  nz,TCPIP_DNSQ_SEND_RC_ST2.1
    3229   00:51A9  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3230   00:51AC  18 F4                   jr  TCPIP_DNSQ_SEND_RC_ST2
    3231   00:51AE                      TCPIP_DNSQ_SEND_RC_ST2.1:
    3232   00:51AE                          ; nz, discard
    3233   00:51AE                          RECEIVE_DATA
    3233   00:51AE  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3234   00:51B1  05                      dec b
    3235   00:51B2  20 EE                   jr  nz,TCPIP_DNSQ_SEND_RC_ST2
    3236   00:51B4                      
    3237   00:51B4                          ; now just get the 4 bytes IP and place it in L H E D
    3238   00:51B4                      TCPIP_DNSQ_IP_ST1:
    3239   00:51B4                          CHECK_DATA
    3239   00:51B4  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3239   00:51B7  CB 47             >     bit 0,a
    3240   00:51B9  20 05                   jr  nz,TCPIP_DNSQ_IP_ST1.1
    3241   00:51BB  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3242   00:51BE  18 F4                   jr  TCPIP_DNSQ_IP_ST1
    3243   00:51C0                      TCPIP_DNSQ_IP_ST1.1:
    3244   00:51C0                          ; nz, get it
    3245   00:51C0                          RECEIVE_DATA
    3245   00:51C0  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3246   00:51C3  6F                      ld  l,a
    3247   00:51C4                      TCPIP_DNSQ_IP_ST2:
    3248   00:51C4                          CHECK_DATA
    3248   00:51C4  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3248   00:51C7  CB 47             >     bit 0,a
    3249   00:51C9  20 05                   jr  nz,TCPIP_DNSQ_IP_ST2.1
    3250   00:51CB  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3251   00:51CE  18 F4                   jr  TCPIP_DNSQ_IP_ST2
    3252   00:51D0                      TCPIP_DNSQ_IP_ST2.1:
    3253   00:51D0                          ; nz, get it
    3254   00:51D0                          RECEIVE_DATA
    3254   00:51D0  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3255   00:51D3  67                      ld  h,a
    3256   00:51D4                      TCPIP_DNSQ_IP_ST3:
    3257   00:51D4                          CHECK_DATA
    3257   00:51D4  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3257   00:51D7  CB 47             >     bit 0,a
    3258   00:51D9  20 05                   jr  nz,TCPIP_DNSQ_IP_ST3.1
    3259   00:51DB  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3260   00:51DE  18 F4                   jr  TCPIP_DNSQ_IP_ST3
    3261   00:51E0                      TCPIP_DNSQ_IP_ST3.1:
    3262   00:51E0                          ; nz, get it
    3263   00:51E0                          RECEIVE_DATA
    3263   00:51E0  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3264   00:51E3  5F                      ld  e,a
    3265   00:51E4                      TCPIP_DNSQ_IP_ST4:
    3266   00:51E4                          CHECK_DATA
    3266   00:51E4  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3266   00:51E7  CB 47             >     bit 0,a
    3267   00:51E9  20 05                   jr  nz,TCPIP_DNSQ_IP_ST4.1
    3268   00:51EB  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3269   00:51EE  18 F4                   jr  TCPIP_DNSQ_IP_ST4
    3270   00:51F0                      TCPIP_DNSQ_IP_ST4.1:
    3271   00:51F0                          ; nz, get it
    3272   00:51F0                          RECEIVE_DATA
    3272   00:51F0  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3273   00:51F3  57                      ld  d,a
    3274   00:51F4                          ; done
    3275   00:51F4  3E 01                   ld  a,1
    3276   00:51F6  CD 5B 62                call    SETDNSREADY             ; DNS done
    3277   00:51F9  CD 85 62                call    SETDNSRESULT            ; DNS RESULT
    3278   00:51FC  06 02                   ld  b,2
    3279   00:51FE  AF                      xor a
    3280   00:51FF  C9                      ret
    3281   00:5200                      
    3282   00:5200                      ;=====================
    3283   00:5200                      ;===  TCPIP_DNS_S  ===
    3284   00:5200                      ;=====================
    3285   00:5200                      ;Obtains the host name resolution process state and result.
    3286   00:5200                      ;
    3287   00:5200                      ;Input:  A = 7
    3288   00:5200                      ;        B = Flags, when set to 1 they instruct the resolver to:
    3289   00:5200                      ;            bit 0: Clear any existing result or error condition after the execution
    3290   00:5200                      ;                   (except if there is a query in progress)
    3291   00:5200                      ;Output: A = Error code
    3292   00:5200                      ;        B = DNS error code (when error is ERR_DNS)
    3293   00:5200                      ;        B = Current query status (when error is ERR_OK):
    3294   00:5200                      ;            0: There is no query in progress, nor any result nor error code available
    3295   00:5200                      ;            1: There is a query in progress
    3296   00:5200                      ;            2: Query is complete
    3297   00:5200                      ;        C = Current query sub status (when error is ERR_OK and B=1):
    3298   00:5200                      ;            0: Unknown
    3299   00:5200                      ;            1: Querying the primary DNS server
    3300   00:5200                      ;            2: Querying the secondary DNS server
    3301   00:5200                      ;            3: Querying another DNS server
    3302   00:5200                      ;        C = Resolution process type (when error is ERR_OK and B=2):
    3303   00:5200                      ;            0: The name was obtained by querying a DNS server
    3304   00:5200                      ;            1: The name was a direct representation of an IP address
    3305   00:5200                      ;            2: The name was resolved locally
    3306   00:5200                      ;       L.H.E.D = Resolved IP address (when error is ERR_OK and B=2)
    3307   00:5200                      TCPIP_DNS_S:
    3308   00:5200                          ;--- Is there a result?
    3309   00:5200  CD 49 62                call    GETDNSREADY             ; DNS done?
    3310   00:5203  B7                      or  a
    3311   00:5204  28 23                   jr  z,TCPIP_DNS_S_NORESULT      ; No DNS result
    3312   00:5206                          ;--- Ok, we have a result, is it success?
    3313   00:5206  3D                      dec a
    3314   00:5207  28 12                   jr  z,TCPIP_DNS_S_HASRESULT     ; If it is 1, it was not an error
    3315   00:5209                          ;--- Shoot, there is an error...
    3316   00:5209                          ;--- And sure thing, ESP do not tell us details, it is always failure :-P
    3317   00:5209  CB 40                   bit 0,b                         ;--- clear error after this?
    3318   00:520B  28 09                   jr  z,TCP_IP_DNS_S_NOCLR
    3319   00:520D                          ;--- Clear
    3320   00:520D  06 00                   ld b,0                          ;--- Like I've said, no details
    3321   00:520F  AF                      xor a
    3322   00:5210  CD 5B 62                call    SETDNSREADY             ; DNS not done
    3323   00:5213  3E 08                   ld  a,ERR_DNS;
    3324   00:5215  C9                      ret
    3325   00:5216                      TCP_IP_DNS_S_NOCLR:
    3326   00:5216                          ;--- Don't clear
    3327   00:5216  3E 08                   ld  a,ERR_DNS
    3328   00:5218  06 00                   ld  b,0                         ;--- Like I've said, no details
    3329   00:521A  C9                      ret
    3330   00:521B                          ;--- There is a result available...
    3331   00:521B                      TCPIP_DNS_S_HASRESULT:
    3332   00:521B                          ;--- Copy the result
    3333   00:521B  CD 6F 62                call    GETDNSRESULT
    3334   00:521E  AF                      xor a
    3335   00:521F  CB 40                   bit 0,b                         ;--- clear result after this?
    3336   00:5221  28 03                   jr  z,TCP_IP_DNS_S_RES_NOCLR    ;--- no, just return
    3337   00:5223                          ;--- Yes, clear
    3338   00:5223  CD 5B 62                call    SETDNSREADY             ; DNS not done
    3339   00:5226                      TCP_IP_DNS_S_RES_NOCLR:
    3340   00:5226  06 02                   ld  b,2
    3341   00:5228  C9                      ret
    3342   00:5229                      
    3343   00:5229                      TCPIP_DNS_S_NORESULT:
    3344   00:5229  AF                      xor a                           ;--- OK no query in progress, no result, means nothing in progress
    3345   00:522A  06 00                   ld  b,0                         ;--- No query in progress
    3346   00:522C  C9                      ret
    3347   00:522D                      
    3348   00:522D                      ;========================
    3349   00:522D                      ;===  TCPIP_UDP_OPEN  ===
    3350   00:522D                      ;========================
    3351   00:522D                      ;Open an UDP connection.
    3352   00:522D                      ;
    3353   00:522D                      ;Input:  A  = 8
    3354   00:522D                      ;        HL = Local port number (#FFFF=random)
    3355   00:522D                      ;        B  = Intended connection lifetime:
    3356   00:522D                      ;             0: Transient
    3357   00:522D                      ;             1: Resident
    3358   00:522D                      ;Output: A = Error code
    3359   00:522D                      ;        B = Connection number
    3360   00:522D                      TCPIP_UDP_OPEN:
    3361   00:522D                          SEND_DATA                       ; Send the command
    3361   00:522D  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3362   00:5230  AF                      xor a
    3363   00:5231                          SEND_DATA                       ; Send the command size msb
    3363   00:5231  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3364   00:5234  3E 03                   ld  a,3
    3365   00:5236                          SEND_DATA                       ; Send the command size lsb
    3365   00:5236  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3366   00:5239  7D                      ld  a,l
    3367   00:523A                          SEND_DATA                       ; Send the port LSB
    3367   00:523A  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3368   00:523D  7C                      ld  a,h
    3369   00:523E                          SEND_DATA                       ; Send the port MSB
    3369   00:523E  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3370   00:5241  78                      ld  a,b
    3371   00:5242                          SEND_DATA                       ; Send the connection transient/resident
    3371   00:5242  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3372   00:5245                      
    3373   00:5245                          ; Now wait up to 180 ticks to get response
    3374   00:5245  21 B4 00                ld  hl,180
    3375   00:5248  CD 36 61                call    SETCOUNTER
    3376   00:524B                      TCPIP_UDP_OPEN_ST1:
    3377   00:524B                          CHECK_DATA
    3377   00:524B  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3377   00:524E  CB 47             >     bit 0,a
    3378   00:5250  20 05                   jr  nz,TCPIP_UDP_OPEN_ST1.1
    3379   00:5252  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3380   00:5255  18 F4                   jr  TCPIP_UDP_OPEN_ST1
    3381   00:5257                      TCPIP_UDP_OPEN_ST1.1:
    3382   00:5257                          ; nz, check the data
    3383   00:5257                          RECEIVE_DATA
    3383   00:5257  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3384   00:525A  FE 08                   cp  8                           ; Is response of our command?
    3385   00:525C  20 ED                   jr  nz,TCPIP_UDP_OPEN_ST1
    3386   00:525E                          ; now get return code, if return code other than 0, it is finished
    3387   00:525E                      TCPIP_UDP_OPEN_RC:
    3388   00:525E                          CHECK_DATA
    3388   00:525E  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3388   00:5261  CB 47             >     bit 0,a
    3389   00:5263  20 05                   jr  nz,TCPIP_UDP_OPEN_RC.1
    3390   00:5265  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3391   00:5268  18 F4                   jr  TCPIP_UDP_OPEN_RC
    3392   00:526A                      TCPIP_UDP_OPEN_RC.1:
    3393   00:526A                          ; nz, discard
    3394   00:526A                          RECEIVE_DATA
    3394   00:526A  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3395   00:526D  B7                      or  a                           ; 0?
    3396   00:526E  C0                      ret nz                          ; if not, done
    3397   00:526F                      
    3398   00:526F                          ; next two bytes are return code and size bytes, don't care, it is 1, conn #
    3399   00:526F  06 02                   ld  b,2
    3400   00:5271                      TCPIP_UDP_OPEN_ST2:
    3401   00:5271                          CHECK_DATA
    3401   00:5271  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3401   00:5274  CB 47             >     bit 0,a
    3402   00:5276  20 05                   jr  nz,TCPIP_UDP_OPEN_ST2.1
    3403   00:5278  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3404   00:527B  18 F4                   jr  TCPIP_UDP_OPEN_ST2
    3405   00:527D                      TCPIP_UDP_OPEN_ST2.1:
    3406   00:527D                          ; nz, discard
    3407   00:527D                          RECEIVE_DATA
    3407   00:527D  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3408   00:5280  05                      dec b
    3409   00:5281  20 EE                   jr  nz,TCPIP_UDP_OPEN_ST2
    3410   00:5283                      
    3411   00:5283                          ; now just get the 1 byte, conn#, should go to B
    3412   00:5283                      TCPIP_UDP_OPEN_CONN_ST1:
    3413   00:5283                          CHECK_DATA
    3413   00:5283  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3413   00:5286  CB 47             >     bit 0,a
    3414   00:5288  20 05                   jr  nz,TCPIP_UDP_OPEN_CONN_ST1.1
    3415   00:528A  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3416   00:528D  18 F4                   jr  TCPIP_UDP_OPEN_CONN_ST1
    3417   00:528F                      TCPIP_UDP_OPEN_CONN_ST1.1:
    3418   00:528F                          ; nz, get it
    3419   00:528F                          RECEIVE_DATA
    3419   00:528F  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3420   00:5292  47                      ld  b,a
    3421   00:5293                          ; done
    3422   00:5293  AF                      xor a
    3423   00:5294  C9                      ret
    3424   00:5295                      
    3425   00:5295                      ;=========================
    3426   00:5295                      ;===  TCPIP_UDP_CLOSE  ===
    3427   00:5295                      ;=========================
    3428   00:5295                      ;Close a UDP connection.
    3429   00:5295                      ;
    3430   00:5295                      ;Input:  A = 9
    3431   00:5295                      ;        B = Connection number
    3432   00:5295                      ;            0 to close all open transient UDP connections
    3433   00:5295                      ;Output: A = Error code
    3434   00:5295                      TCPIP_UDP_CLOSE:
    3435   00:5295                          SEND_DATA                       ; Send the command
    3435   00:5295  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3436   00:5298  AF                      xor a
    3437   00:5299                          SEND_DATA                       ; Send the command size msb
    3437   00:5299  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3438   00:529C  3E 01                   ld  a,1
    3439   00:529E                          SEND_DATA                       ; Send the command size lsb
    3439   00:529E  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3440   00:52A1  78                      ld  a,b
    3441   00:52A2                          SEND_DATA                       ; Send the connection #
    3441   00:52A2  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3442   00:52A5                          ; Now wait up to 180 ticks to get response
    3443   00:52A5  21 B4 00                ld  hl,180
    3444   00:52A8  CD 36 61                call    SETCOUNTER
    3445   00:52AB                      TCPIP_UDP_CLOSE_ST1:
    3446   00:52AB                          CHECK_DATA
    3446   00:52AB  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3446   00:52AE  CB 47             >     bit 0,a
    3447   00:52B0  20 05                   jr  nz,TCPIP_UDP_CLOSE_ST1.1
    3448   00:52B2  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3449   00:52B5  18 F4                   jr  TCPIP_UDP_CLOSE_ST1
    3450   00:52B7                      TCPIP_UDP_CLOSE_ST1.1:
    3451   00:52B7                          ; nz, check the data
    3452   00:52B7                          RECEIVE_DATA
    3452   00:52B7  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3453   00:52BA  FE 09                   cp  9                           ; Is response of our command?
    3454   00:52BC  20 ED                   jr  nz,TCPIP_UDP_CLOSE_ST1
    3455   00:52BE                          ; now get return code, if return code other than 0, it is finished
    3456   00:52BE                      TCPIP_UDP_CLOSE_RC:
    3457   00:52BE                          CHECK_DATA
    3457   00:52BE  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3457   00:52C1  CB 47             >     bit 0,a
    3458   00:52C3  20 05                   jr  nz,TCPIP_UDP_CLOSE_RC.1
    3459   00:52C5  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3460   00:52C8  18 F4                   jr  TCPIP_UDP_CLOSE_RC
    3461   00:52CA                      TCPIP_UDP_CLOSE_RC.1:
    3462   00:52CA                          ; nz, discard
    3463   00:52CA                          RECEIVE_DATA
    3463   00:52CA  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3464   00:52CD  B7                      or  a                           ; 0?
    3465   00:52CE  C0                      ret nz                          ; if not, done
    3466   00:52CF                      
    3467   00:52CF                          ; next two bytes are return code and size bytes, don't care, it is 1, conn #
    3468   00:52CF  06 02                   ld  b,2
    3469   00:52D1                      TCPIP_UDP_CLOSE_ST2:
    3470   00:52D1                          CHECK_DATA
    3470   00:52D1  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3470   00:52D4  CB 47             >     bit 0,a
    3471   00:52D6  20 05                   jr  nz,TCPIP_UDP_CLOSE_ST2.1
    3472   00:52D8  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3473   00:52DB  18 F4                   jr  TCPIP_UDP_CLOSE_ST2
    3474   00:52DD                      TCPIP_UDP_CLOSE_ST2.1:
    3475   00:52DD                          ; nz, discard
    3476   00:52DD                          RECEIVE_DATA
    3476   00:52DD  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3477   00:52E0  05                      dec b
    3478   00:52E1  20 EE                   jr  nz,TCPIP_UDP_CLOSE_ST2
    3479   00:52E3                      
    3480   00:52E3                          ; done, no return data other than return code
    3481   00:52E3  AF                      xor a
    3482   00:52E4  C9                      ret
    3483   00:52E5                      
    3484   00:52E5                      ;=========================
    3485   00:52E5                      ;===  TCPIP_UDP_STATE  ===
    3486   00:52E5                      ;=========================
    3487   00:52E5                      ;Get the state of a UDP connection.
    3488   00:52E5                      ;
    3489   00:52E5                      ;Input:  A = 10
    3490   00:52E5                      ;        B = Connection number
    3491   00:52E5                      ;Output: A  = Error code
    3492   00:52E5                      ;        HL = Local port number
    3493   00:52E5                      ;        B  = Number of pending incoming datagrams
    3494   00:52E5                      ;        DE = Size of oldest pending incoming datagram (data part only)
    3495   00:52E5                      TCPIP_UDP_STATE:
    3496   00:52E5                          SEND_DATA                       ; Send the command
    3496   00:52E5  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3497   00:52E8  AF                      xor a
    3498   00:52E9                          SEND_DATA                       ; Send the command size msb
    3498   00:52E9  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3499   00:52EC  3C                      inc a
    3500   00:52ED                          SEND_DATA                       ; Send the command size lsb
    3500   00:52ED  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3501   00:52F0  78                      ld  a,b
    3502   00:52F1                          SEND_DATA                       ; Send the parameter
    3502   00:52F1  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3503   00:52F4                      
    3504   00:52F4                          ; Now wait up to 60 ticks to get response
    3505   00:52F4  21 3C 00                ld  hl,60
    3506   00:52F7  CD 36 61                call    SETCOUNTER
    3507   00:52FA                      TCPIP_UDP_STATE_ST1:
