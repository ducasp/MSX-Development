    1088   00:456E                          SEND_DATA
    1088   00:456E  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1089   00:4571  DD 7E 01                ld  a,(ix+1)                    ; GMT
    1090   00:4574                          SEND_DATA
    1090   00:4574  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
