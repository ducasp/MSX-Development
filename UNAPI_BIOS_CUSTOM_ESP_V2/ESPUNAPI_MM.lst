    4746   00:5939                      ;        HL = Number of total available incoming bytes
    4747   00:5939                      ;        DE = Number of urgent available incoming bytes
    4748   00:5939                      ;        IX = Available free space in the output buffer
    4749   00:5939                      ;             (0FFFFh = infinite)
    4750   00:5939                      ;
    4751   00:5939                      ;Connection information block consists of:
    4752   00:5939                      ;
    4753   00:5939                      ;    +0 (4): Remote IP address
    4754   00:5939                      ;    +4 (2): Remote port
    4755   00:5939                      ;    +6 (2): Local port
    4756   00:5939                      TCPIP_TCP_STATE_ERROR:
    4757   00:5939                          ; next two bytes are size bytes, don't care
    4758   00:5939  47                      ld  b,a                         ; save error in b
