    1652   00:4943                      ;===  SETUP Menu Routines  ==
    1653   00:4943                      ;===  Auxiliary Functions  ==
    1654   00:4943                      ;============================
    1655   00:4943                      SET_ESP_WIFI_TIMEOUT:
    1656   00:4943  EB                      ex  de,hl
    1657   00:4944  3E 0D                   ld  a,#0d
    1658   00:4946  CD A2 00                call    CHPUT
    1659   00:4949  3E 0A                   ld  a,#0a
    1660   00:494B  CD A2 00                call    CHPUT
    1661   00:494E  21 06 6D                ld  hl,STR_SENDING              ; Indicate it is sending a command
    1662   00:4951  CD 96 4C                call    PRINTHL
    1663   00:4954                          CLEAR_UART
    1663   00:4954  3E 14             >     ld  a,20
    1663   00:4956  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    1664   00:4959  3E 54                   ld  a,CMD_TIMER_SET
    1665   00:495B                          SEND_DATA
    1665   00:495B  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1666   00:495E  AF                      xor a                           ; Size MSB is 0
    1667   00:495F                          SEND_DATA
    1667   00:495F  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1668   00:4962  3E 02                   ld  a,2                         ; Size LSB is 2
    1669   00:4964                          SEND_DATA
    1669   00:4964  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
