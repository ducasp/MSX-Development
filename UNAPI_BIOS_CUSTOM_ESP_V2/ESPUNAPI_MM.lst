    1228   00:4665  FE 30                   cp  '0'                         ; Check if A is less than 0
    1229   00:4667  DA 15 48                jp  c,INPUT_WFSAP_BAD_INPUT     ; If it is, ignore
    1230   00:466A  BB                      cp  e                           ; Check if a is greater than what is in E
    1231   00:466B  D2 15 48                jp  nc,INPUT_WFSAP_BAD_INPUT    ; If it is, ignore
    1232   00:466E  C3 08 47                jp  WIFI_CONNECT_SELECTION_OK   ; Selection Ok if here
    1233   00:4671                      
    1234   00:4671                      WIFI_SELECT_SPACEBAR:
