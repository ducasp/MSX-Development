    2441   00:4DD0  89 5B               FN_18:                  dw  TCPIP_TCP_RCV
    2442   00:4DD2                      ; TCPIP_TCP_FLUSH makes no sense as we do not use buffers to send, any buffer is internal to ESP and we can't delete
    2443   00:4DD2  18 4E               FN_19:                  dw  FN_NOT_IMP
    2444   00:4DD4                      ; TCPIP_RAW_OPEN not going to be implemented, ESP do not support RAW connections
