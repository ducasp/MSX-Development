    5310   00:5C2B                      ;========================
    5311   00:5C2B                      ;=== SSH_AUTH_RESPOND ===
    5312   00:5C2B                      ;========================
    5313   00:5C2B                      ;Respond auth data requested for SSH connection.
    5314   00:5C2B                      ;
    5315   00:5C2B                      ;Input:  A  = 10
    5316   00:5C2B                      ;        B  = Connection number
    5317   00:5C2B                      ;        DE = Address of the data to be sent
    5318   00:5C2B                      ;        HL = Length of the data to be sent
