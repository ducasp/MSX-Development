    4600   00:584D  CB 47             >     bit 0,a
    4601   00:584F  20 05                   jr  nz,SSH_STATE_ST1.1
    4602   00:5851  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
