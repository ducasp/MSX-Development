     339   00:4000                      ;************************
     340   00:4000                      ;***  MSX ROM HEADER  ***
     341   00:4000                      ;************************
     342   00:4000                          org #4000
     343   00:4000  41 42                   db                  #41,#42
     344   00:4002  10 40                   dw                  INIT        ; Initialize ESP, if not found, won't install hook
     345   00:4004  00 00                   dw                  0           ; Statement
     346   00:4006  00 00                   dw                  0           ; Device
     347   00:4008  00 00                   dw                  0           ; Text
     348   00:400A  00 (6)                  ds                  6           ; Reserved
     349   00:4010                      
     350   00:4010                      ;==================
     351   00:4010                      ;===  Start-up  ===
     352   00:4010                      ;==================
     353   00:4010                      
     354   00:4010                      INIT:
     355   00:4010  7C                      ld  a,h                         ; Let's test if we are mirrored and being executed in wrong page
     356   00:4011  FE 40                   cp  #40                         ; is MSB 0x40?
     357   00:4013  C0                      ret nz                          ; if not, return, it is a mirror
     358   00:4014                          ; Let's set some System Variables
     359   00:4014  AF                      xor a                           ; a = #00
     360   00:4015  32 A9 FC                ld  (CSRSW),a                   ; cursor display is disabled
     361   00:4018  32 DB F3                ld  (CLIKSW),a                  ; when key press, key click disabled
     362   00:401B                          ; Let's intercept [DEL] key
     363   00:401B  3E 08                   ld  a,8
     364   00:401D  CD 41 01                call    SNSMAT
     365   00:4020  CB 5F                   bit 3,a                         ; Test [DEL]
     366   00:4022  C8                      ret z                           ; If DEL is pressed, UNAPI driver is not loaded and exits
     367   00:4023                          ; Let's check the Screen Mode, ref. https://www.msx.org/wiki/VDP_Table_Base_Address_Registers
     368   00:4023  3A E1 F3                ld  a,(REG2SAV)
     369   00:4026  FE 02                   cp  2
     370   00:4028  CA 32 40                jp  z,SCREEN_SETUP              ; If yes, is SCREEN 3
     371   00:402B  3A E3 F3                ld  a,(REG4SAV)
     372   00:402E  FE 00                   cp  0
     373   00:4030  28 06                   jr  z,IS_SCREEN1                ; If yes, is SCREEN 1
     374   00:4032                      SCREEN_SETUP:
     375   00:4032                          ; Let's set the SCREEN 1
     376   00:4032  3E 01                   ld  a,1                         ; a = #01
     377   00:4034  F7                      rst #30
     378   00:4035  00                      db  0
     379   00:4036  5F 00                   dw  CHGMOD                      ; SCREEN 1
     380   00:4038                      IS_SCREEN1:
     381   00:4038  3E 1D                   ld  a,29                        ; WIDTH 29
     382   00:403A  32 B0 F3                ld  (LINLEN),a
     383   00:403D                          ; We check if the Port F2 device is available
     384   00:403D                          READ_F2                         ; a = #FF, default value if it comes from power off or hard reset
     384   00:403D  3A 05 7F          >     ld  a,(MEM_PORT_F2)
     385   00:4040  2F                      cpl                             ; a = #FF - a
     386   00:4041  4F                      ld  c,a                         ; c = #00
     387   00:4042                          WRITE_F2                        ; a = #00
     387   00:4042  32 05 7F          >     ld  (MEM_PORT_F2),a
     388   00:4045                          ; Wait 250ms to ensure a successful hard reset even if you press the button very quickly
     389   00:4045  CD 16 4A                call    WAIT_250MS_AND_THEN_CONTINUE
     390   00:4048                          READ_F2                         ; a = #00?
     390   00:4048  3A 05 7F          >     ld  a,(MEM_PORT_F2)
     391   00:404B  2F                      cpl                             ; a = #FF - a
     392   00:404C                          WRITE_F2                        ; a = #FF?
     392   00:404C  32 05 7F          >     ld  (MEM_PORT_F2),a
     393   00:404F  F5                      push    af
     394   00:4050  3E FE                   ld  a,#FE                       ; Preset #FE, unexpected error
     395   00:4052                          WRITE_F2                        ; on port #F2
     395   00:4052  32 05 7F          >     ld  (MEM_PORT_F2),a
     396   00:4055  F1                      pop af
     397   00:4056  B9                      cp  c                           ; If not a = c, port #F2 is writable and available
     398   00:4057  28 3D                   jr  z,BOOT_FROM_POWER_OFF       ; If a = c, port #F2 is not available, let's proceed as "boot from power off"
     399   00:4059                          ; Ok, Port F2 device available
     400   00:4059  FE EF                   cp  #EF                         ; UNAPI driver has been disabled
     401   00:405B  20 04                   jr  nz,NOT_DISABLED_BY_F2       ; No, let's continue checking
     402   00:405D                          WRITE_F2                        ; If yes, UNAPI driver is not loaded and exits, but need to restore F2 port to not have a false error
     402   00:405D  32 05 7F          >     ld  (MEM_PORT_F2),a
     403   00:4060  C9                      ret                             ; And our work is done
     404   00:4061                      NOT_DISABLED_BY_F2:
     405   00:4061  FE F0                   cp  #F0                         ; UNAPI driver has been loaded at least once
     406   00:4063  C2 78 40                jp  nz, F2_IS_NOT_F0            ; Ok, has not been loaded
     407   00:4066                          ; Let's intercept [F1] key
     408   00:4066  3E 06                   ld  a,6
     409   00:4068  CD 41 01                call    SNSMAT
     410   00:406B  CB 6F                   bit 5,a                         ; Test [F1]
     411   00:406D  CA 42 42                jp  z,ENTERING_ESPSETUP         ; If F1 is pressed, let's execute our setup menu
     412   00:4070                          ; F1 is not pressed, continue
     413   00:4070  CB 77                   bit 6,a                         ; Test [F2]
     414   00:4072  C2 F6 40                jp  nz,INIT_UNAPI               ; If F2 is not pressed, let's proceed to INIT_UNAPI
     415   00:4075                          ; F2 is not pressed, continue
     416   00:4075  C3 AF 41                jp  INIT_NOCLOCKUPDAT2          ; If yes, proceed without affecting the connection or the date and time
     417   00:4078                      F2_IS_NOT_F0:
     418   00:4078  FE F1                   cp  #F1                         ; User requested to go directly to Wi-Fi Setup
     419   00:407A  CA 42 42                jp  z,ENTERING_ESPSETUP         ; If yes, let's execute our setup menu
     420   00:407D  FE F2                   cp  #F2                         ; User forces to check if ESP is installed
     421   00:407F  CA D2 40                jp  z,F2_IS_PRESSED             ; If yes, let's go check it out
     422   00:4082  FE FE                   cp  #FE                         ; Unexpected error from the previous reboot
     423   00:4084  20 10                   jr  nz,BOOT_FROM_POWER_OFF      ; If no one is confirmed, let's proceed as "boot from power off"
     424   00:4086                          ; Oops! An unexpected error occurred on the last reboot
     425   00:4086  21 7E 72                ld  hl,STR_OOPS                 ; Print Oops! An unexpected error message
     426   00:4089  CD 9D 4C                call    PRINTHL                 ; and let's proceed as "boot from power off"
     427   00:408C  06 78                   ld  b,120                       ; Wait 2 seconds with message on screen
     428   00:408E                      WAIT_2S:
     429   00:408E  76                      halt
     430   00:408F  10 FD                   djnz    WAIT_2S                 ; If not zero, our time out has not elapsed
     431   00:4091  3E 0C                   ld  a,CLS
     432   00:4093  CD A2 00                call    CHPUT
     433   00:4096                      BOOT_FROM_POWER_OFF:
     434   00:4096                          ; Let's intercept [F1] key
     435   00:4096  3E 06                   ld  a,6
     436   00:4098  CD 41 01                call    SNSMAT
     437   00:409B  CB 6F                   bit 5,a                         ; Test [F1]
     438   00:409D  CA 42 42                jp  z,ENTERING_ESPSETUP         ; If F1 is pressed, let's execute our setup menu
     439   00:40A0                          ; F1 is not pressed, continue
     440   00:40A0  CD F0 62                call    CHECK_ESP_TYPE          ; Always detect ESP type and SSH support
     441   00:40A3                          if  NON_VERBOSE_ROM = 0
     442   00:40A3  CD 37 62                call    GETESPFLAGS
     443   00:40A6  E6 02                   and ESPFLAG_SSH
     444   00:40A8  21 B5 65                ld  hl,WELCOME
     445   00:40AB  28 03                   jr  z,NOT32_1
     446   00:40AD  21 FF 65                ld  hl,WELCOME32
     447   00:40B0                      NOT32_1:
     448   00:40B0  CD 9D 4C                call    PRINTHL
     449   00:40B3                          CHECK_QUICK_RECEIVE
     449   00:40B3  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
     449   00:40B6  CB 5F             >     bit 3,a
     450   00:40B8  20 08                   jr  nz,BOOT_FROM_POWER_OFF.1    ; QR Supported
     451   00:40BA  21 69 66                ld  hl,WELCOME_SF2
     452   00:40BD  CD 9D 4C                call    PRINTHL
     453   00:40C0  18 06                   jr  BOOT_FROM_POWER_OFF.2
     454   00:40C2                      BOOT_FROM_POWER_OFF.1:
     455   00:40C2  21 4D 66                ld  hl,WELCOME_SF
     456   00:40C5  CD 9D 4C                call    PRINTHL
     457   00:40C8                      BOOT_FROM_POWER_OFF.2:
     458   00:40C8                          endif
     459   00:40C8  3E 06                   ld  a,6
     460   00:40CA  CD 41 01                call    SNSMAT
     461   00:40CD  CB 77                   bit 6,a                         ; Test [F2]
     462   00:40CF  C2 F6 40                jp  nz,INIT_UNAPI               ; If F2 is not pressed, let's proceed to INIT_UNAPI
     463   00:40D2                          ; F2 is pressed, continue
     464   00:40D2                      F2_IS_PRESSED:
     465   00:40D2  CD F8 63                call    RESET_ESP
     466   00:40D5  B7                      or  a
     467   00:40D6  20 06                   jr  nz,ESP_NOT_FOUND
     468   00:40D8  21 7D 71                ld  hl,OK_S                     ; Properly detected
     469   00:40DB  C3 E8 40                jp  INIT_F_MSG                  ; Well, if reset successful, continue
     470   00:40DE                      ESP_NOT_FOUND:
     471   00:40DE                          ; If here, ESP was not found, so, exit with an error message
     472   00:40DE  78                      ld  a,b
     473   00:40DF  B7                      or  a
     474   00:40E0  21 F9 71                ld  hl,FAIL_S                   ; If 0, non responsive
     475   00:40E3  28 03                   jr  z,INIT_F_MSG
     476   00:40E5  21 43 72                ld  hl,FAIL_F                   ; Otherwise, firmware is old
     477   00:40E8                      INIT_F_MSG:
     478   00:40E8  CD 9D 4C                call    PRINTHL
     479   00:40EB                      INIT_F_WAIT:
     480   00:40EB  06 B4                   ld  b,180                       ; 3s
     481   00:40ED                      INIT_F_LOOP_WAIT:
     482   00:40ED  76                      halt
     483   00:40EE  10 FD                   djnz    INIT_F_LOOP_WAIT
     484   00:40F0                      AND_DONE:
     485   00:40F0  3E EF                   ld  a,#EF                       ; Set #EF, ESP Not Found
     486   00:40F2                          WRITE_F2                        ; on port #F2
     486   00:40F2  32 05 7F          >     ld  (MEM_PORT_F2),a
     487   00:40F5  C9                      ret                             ; And done
     488   00:40F6                      INIT_UNAPI:
     489   00:40F6                          CLEAR_UART
     489   00:40F6  3E 14             >     ld  a,20
     489   00:40F8  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     490   00:40FB  3E 63                   ld  a,CMD_QUERY_ACLK_SETTINGS
     491   00:40FD                          SEND_DATA
     491   00:40FD  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     492   00:4100  21 3C 00                ld  hl,60                       ; Wait Up To 1s
     493   00:4103  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
     494   00:4107  DD 6B                   ld  ixl,e
     495   00:4109  DD 62                   ld  ixh,d                       ; Address in IX
     496   00:410B  CD 75 4B                call    WAIT_MENU_CMD_RESPONSE
     497   00:410E  CA A5 41                jp  z,INIT_NOCLOCKUPDATE        ; If error, just skip
     498   00:4111                          ; Response received, IX+0 and IX+1 has Auto Clock and GMT
     499   00:4111  3E 03                   ld  a,3
     500   00:4113  DD BE 00                cp  (ix+0)
     501   00:4116  20 0B                   jr  nz,INIT_UNAPI2              ; If not disabled continue on INIT_UNAPI2
     502   00:4118                          ; Disabled, ok, so let's ensure connection is not locked (just in case it was setup as disabled right now)
     503   00:4118                          CLEAR_UART
     503   00:4118  3E 14             >     ld  a,20
     503   00:411A  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     504   00:411D  3E 68                   ld  a,CMD_WIFIRELEASE_ESP
     505   00:411F                          SEND_DATA                       ; Just send, no need to wait response
     505   00:411F  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     506   00:4122  C9                      ret
     507   00:4123                      INIT_UNAPI2:
     508   00:4123  3A 2D 00                ld  a,(#002D)                   ; Check MSX Version
     509   00:4126  B7                      or  a
     510   00:4127  28 7C                   jr  z,INIT_NOCLOCKUPDATE        ; If zero, MSX1, can't set clock
     511   00:4129  AF                      xor a
     512   00:412A  DD B6 00                or  (ix+0)
     513   00:412D  28 76                   jr  z,INIT_NOCLOCKUPDATE        ; if turned off, skip
     514   00:412F                          ; Ok, not zero, so we are going to simply request the time, it might take up to 10s
     515   00:412F  DD 23                   inc ix
     516   00:4131  DD 23                   inc ix                          ; ok, leave IX+0 and IX+1 intact
     517   00:4133                          ; b = number of response check attempts
     518   00:4133  06 05                   ld  b,5                         ; 5 * 2s = 10s
     519   00:4135                          CLEAR_UART
     519   00:4135  3E 14             >     ld  a,20
     519   00:4137  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     520   00:413A  3E 47                   ld  a,CMD_GET_TIME
     521   00:413C                          SEND_DATA
     521   00:413C  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     522   00:413F                      TRY_AGAIN:
     523   00:413F  C5                      push    bc
     524   00:4140  21 78 00                ld  hl,120                      ; Wait Up To 2s per attempt
     525   00:4143  CD 75 4B                call    WAIT_MENU_CMD_RESPONSE
     526   00:4146  20 1E                   jr  nz,INIT_CLOCKUPDATE         ; if ok, follow up
     527   00:4148  21 5E 72                ld  hl,STR_WAITING              ; Print Waiting for connection message
     528   00:414B  CD 9D 4C                call    PRINTHL
     529   00:414E  3E FF                   ld  a,#ff
     530   00:4150  B8                      cp  b                           ; Was time-out the failure reason?
     531   00:4151  C1                      pop bc                          ; Restore stack ballance and retry counter
     532   00:4152  20 04                   jr  nz,STOP_TRYING              ; If error return code and not time-out, no more checks needed
     533   00:4154  3E 47                   ld  a,CMD_GET_TIME              ; Needed for retries
     534   00:4156  10 E7                   djnz    TRY_AGAIN
     535   00:4158                      STOP_TRYING:
     536   00:4158                          ; Leave a message that clock has not been updated
     537   00:4158  21 0F 71                ld  hl,STR_CLKUPDT_FAIL
     538   00:415B  CD 9D 4C                call    PRINTHL
     539   00:415E  3E F0                   ld  a,240                       ; Wait 4 seconds with message on screen
     540   00:4160                      WAIT_4S:
     541   00:4160  76                      halt
     542   00:4161  3D                      dec a
     543   00:4162                          ; If not zero, our time out has not elapsed
     544   00:4162  20 FC                   jr  nz,WAIT_4S
     545   00:4164  18 3F                   jr  INIT_NOCLOCKUPDATE          ; error, just skip to not set garbage in clock
     546   00:4166                      INIT_CLOCKUPDATE:
     547   00:4166  C1                      pop bc
     548   00:4167  DD 2B                   dec ix
     549   00:4169  DD 2B                   dec ix                          ; ix back where it should
     550   00:416B                          ; ix + 0 -> 0 If no need to set clock, 1 if set clock, 2 if set clock and request to turn Wi-Fi Off
     551   00:416B                          ; ix + 1 -> GMT setting, well, not going to use it
     552   00:416B                          ; ix + 2 -> Seconds
     553   00:416B                          ; ix + 3 -> Minutes
     554   00:416B                          ; ix + 4 -> Hours
     555   00:416B                          ; ix + 5 -> Day
     556   00:416B                          ; ix + 6 -> Month
     557   00:416B                          ; ix + 7 -> Year LSB
     558   00:416B                          ; ix + 8 -> Year MSB
     559   00:416B  DD 66 04                ld  h,(ix+4)
     560   00:416E  DD 6E 03                ld  l,(ix+3)
     561   00:4171  DD 56 02                ld  d,(ix+2)
     562   00:4174  CD 3B 64                call    SET_TIME
     563   00:4177  20 2C                   jr  nz,INIT_NOCLOCKUPDATE       ; if error, just skip
     564   00:4179  DD 66 08                ld  h,(ix+8)
     565   00:417C  DD 6E 07                ld  l,(ix+7)
     566   00:417F  DD 56 06                ld  d,(ix+6)
     567   00:4182  DD 5E 05                ld  e,(ix+5)
     568   00:4185  CD 68 64                call    SET_DATE
     569   00:4188  3E 02                   ld  a,2
     570   00:418A  DD BE 00                cp  (ix+0)
     571   00:418D  20 16                   jr  nz,INIT_NOCLOCKUPDATE
     572   00:418F                          ; First, release any hold to Wi-Fi Connection
     573   00:418F                          CLEAR_UART
     573   00:418F  3E 14             >     ld  a,20
     573   00:4191  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     574   00:4194  3E 68                   ld  a,CMD_WIFIRELEASE_ESP
     575   00:4196                          SEND_DATA                       ; Just send, no need to wait response
     575   00:4196  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     576   00:4199                          ; And, turn off Wi-Fi Immediatelly
     577   00:4199                          CLEAR_UART
     577   00:4199  3E 14             >     ld  a,20
     577   00:419B  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     578   00:419E  3E 4F                   ld  a,CMD_WIFI_OFF
     579   00:41A0                          SEND_DATA                       ; Just send, no need to wait response
     579   00:41A0  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     580   00:41A3  18 0A                   jr  INIT_NOCLOCKUPDAT2
     581   00:41A5                      INIT_NOCLOCKUPDATE:
     582   00:41A5                          ; Release any hold to Wi-Fi Connection
     583   00:41A5                          CLEAR_UART
     583   00:41A5  3E 14             >     ld  a,20
     583   00:41A7  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     584   00:41AA  3E 68                   ld  a,CMD_WIFIRELEASE_ESP
     585   00:41AC                          SEND_DATA                       ; Just send, no need to wait response
     585   00:41AC  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     586   00:41AF                      INIT_NOCLOCKUPDAT2:
     587   00:41AF                          ; Save existing EXTBIO hook if it exists
     588   00:41AF  3A 20 FB                ld  a,(HOKVLD)
     589   00:41B2  CB 47                   bit 0,a
     590   00:41B4  20 0B                   jr  nz,SAVE_HOOK2               ; HOKVLD tells us if there is an extended BIOS already or not, if yes, save it
     591   00:41B6                          ; If here, no extended BIOS
     592   00:41B6  CD 96 60                call    GETSLT
     593   00:41B9  CD EF 60                call    GETWRK                  ; Our ROM work area address is at HL (we can use up to 8 bytes)
     594   00:41BC  3E C9                   ld  a,#c9                       ; RET, as we are the first extended BIOS
     595   00:41BE  77                      ld  (hl),a
     596   00:41BF  18 13                   jr  PATCH                       ; And now all we need to do is patch the EXTBIO hook :)
     597   00:41C1                      
     598   00:41C1                      SAVE_HOOK2:
     599   00:41C1                          ; If here, we are not the first to extend bios, so we need to save the previous one
     600   00:41C1  CD 96 60                call    GETSLT
     601   00:41C4  CD EF 60                call    GETWRK                  ; Our ROM work area address is at HL (we can use up to 8 bytes)
     602   00:41C7  EB                      ex  de,hl                       ; It is the destination for....
     603   00:41C8  21 CA FF                ld  hl,EXTBIO                   ; The actual EXTBIO hook
     604   00:41CB  01 05 00                ld  bc,5                        ; That is 5 bytes large
     605   00:41CE  ED B0                   ldir                            ; And move to our work area
     606   00:41D0  AF                      xor a
     607   00:41D1  12                      ld  (de),a                      ; Not initialized (de is at the sixth byte) of our slot work area
     608   00:41D2  13                      inc de
     609   00:41D3  12                      ld  (de),a                      ; Not initialized (de is at the seventh byte) of our slot work area
     610   00:41D4                      
     611   00:41D4                          ; Patch EXTBIO
     612   00:41D4                      PATCH:
     613   00:41D4  3E F7                   ld  a,#F7                       ; RST #30
     614   00:41D6  32 CA FF                ld  (EXTBIO),a                  ; In EXTBIO hook
     615   00:41D9  CD 96 60                call    GETSLT                  ; Our Slot in A
     616   00:41DC  32 CB FF                ld  (EXTBIO+1),a                ; Next EXTBIO hook byte
     617   00:41DF  21 F2 4C                ld  hl,DO_EXTBIO                ; Our EXTBIO routine address
     618   00:41E2  22 CC FF                ld  (EXTBIO+2),hl               ; Goes to the following two bytes in the hook
     619   00:41E5                      
     620   00:41E5  21 CF FF                ld  hl,EXTBIO+5                 ; Must patch DISINT and ENAINT as well
     621   00:41E8  06 0A                   ld  b,5*2
     622   00:41EA                      PATCH2:
     623   00:41EA  36 C9                   ld  (hl),#C9
     624   00:41EC  23                      inc hl
     625   00:41ED  10 FB                   djnz    PATCH2                  ; So patch all 10 bytes with return
     626   00:41EF                      
     627   00:41EF  21 20 FB                ld  hl,HOKVLD
     628   00:41F2  CB C6                   set 0,(hl)                      ; And set HOKVLD properly to indicate an EXTBIOS is installed
     629   00:41F4                      INIT_OK:
     630   00:41F4                          if  NON_VERBOSE_ROM = 0
     631   00:41F4  CD 98 63                call    PRINT_INSTALLED_MSG     ; All done and set, nice exit message
     632   00:41F7                          endif
     633   00:41F7  3E F0                   ld  a,#F0                       ; Set #F0, UNAPI driver has been loaded at least once
     634   00:41F9                          WRITE_F2
     634   00:41F9  32 05 7F          >     ld  (MEM_PORT_F2),a
     635   00:41FC  C9                      ret
     636   00:41FD                      
     637   00:41FD                      ;==============================
     638   00:41FD                      ;===  TPA Memory Allocation  ==
     639   00:41FD                      ;==============================
     640   00:41FD                      HIMEM_ALLOC:
     641   00:41FD                          ; Now let's reserve memory in the 4th page for our usage
     642   00:41FD  2A 4A FC                ld hl,(HIMEM)                   ; Get HIMEM
     643   00:4200  B7                      or  a                           ; Clear Carry
     644   00:4201  11 1E 00                ld  de,HIMEM_RESERVED_SIZE      ; Reserve How much memory we need
     645   00:4204  ED 52                   sbc hl,de                       ; New HIMEM
     646   00:4206  22 4A FC                ld  (HIMEM),hl                  ; Save it
     647   00:4209  23                      inc hl                          ; To be safe
     648   00:420A  EB                      ex  de,hl                       ; now in DE
     649   00:420B  CD 96 60                call    GETSLT
     650   00:420E  CD 03 61                call    GETMEMPOINTERADDR       ; This is where we are going to store our memory area address
     651   00:4211                          ; GETSLT and GETMEMPOINTER do not change DE, so it still has the our memory area address
     652   00:4211  73                      ld  (hl),e
     653   00:4212  23                      inc hl
     654   00:4213  72                      ld  (hl),d                      ; And save our memory area there
     655   00:4214                          ; Ok, DE has our memory area, let's save old H_TIMI hook there
     656   00:4214  21 9F FD                ld  hl,H_TIMI                   ; The actual H_TIMI hook
     657   00:4217  01 05 00                ld  bc,5                        ; That is 5 bytes large
     658   00:421A  ED B0                   ldir                            ; And move to our memory area
     659   00:421C  F3                      di                              ; Turn of interrupts as we are going to patch H_TIMI
     660   00:421D                      PATCH_H_TIMI:
     661   00:421D  3E F7                   ld  a,#F7                       ; RST #30
     662   00:421F  32 9F FD                ld  (H_TIMI),a                  ; In H_TIMI hook
     663   00:4222  CD 96 60                call    GETSLT                  ; Our Slot in A
     664   00:4225  32 A0 FD                ld  (H_TIMI+1),a                ; Next H_TIMI hook byte
     665   00:4228  21 DE 4C                ld  hl,DO_HTIMI                 ; Our H_TIMI routine address
     666   00:422B  22 A1 FD                ld  (H_TIMI+2),hl               ; Goes to the following two bytes in the hook
     667   00:422E  FB                      ei                              ; done, so re-enable interrupts
     668   00:422F                      
     669   00:422F                          ; Set DNS_READY to zero
     670   00:422F  AF                      xor a
     671   00:4230  CD 5B 62                call    SETDNSREADY
     672   00:4233                          ; Set TIME-OUT counter to zero
     673   00:4233  21 00 00                ld  hl,0
     674   00:4236  CD 36 61                call    SETCOUNTER
     675   00:4239  C9                      ret
     676   00:423A                      
     677   00:423A                      ;============================
     678   00:423A                      ;===  SETUP Menu Routines  ==
     679   00:423A                      ;===       Main Menu       ==
     680   00:423A                      ;============================
     681   00:423A                      ESPSETUP.EXIT:
     682   00:423A  3E 0C                   ld  a,CLS
     683   00:423C  CD A2 00                call    CHPUT
     684   00:423F  C3 F6 40                jp  INIT_UNAPI                  ; When done, resume initialization
     685   00:4242                      ENTERING_ESPSETUP:
     686   00:4242  21 99 65                ld  hl,ENTERING_WIFI_SETUP
     687   00:4245  CD 9D 4C                call    PRINTHL
     688   00:4248  CD 02 65                call    PATTERN_SETUP
     689   00:424B  CD 16 4A                call    WAIT_250MS_AND_THEN_CONTINUE
     690   00:424E                          ; Hold Wi-Fi Connection On
     691   00:424E                          CLEAR_UART
     691   00:424E  3E 14             >     ld  a,20
     691   00:4250  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     692   00:4253  3E 48                   ld  a,CMD_WIFIHOLD_ESP
     693   00:4255                          SEND_DATA
     693   00:4255  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     694   00:4258  21 3C 00                ld  hl,60                       ; Up to 1s time-out
     695   00:425B  CD 75 4B                call    WAIT_MENU_CMD_RESPONSE  ; Wait response
     696   00:425E                          ; We do not want to error here, just in case user still need to upgrade ESP firmware
     697   00:425E                      ESPSETUP:
     698   00:425E  CD F8 63                call    RESET_ESP
     699   00:4261  B7                      or  a
     700   00:4262  C2 DE 40                jp  nz,ESP_NOT_FOUND            ; Not well, ESP was not found
     701   00:4265                          ; Well, if reset successful, continue
     702   00:4265  CD F0 62                call    CHECK_ESP_TYPE          ; Detect ESP type and SSH support
     703   00:4268  CD 37 62                call    GETESPFLAGS
     704   00:426B  E6 02                   and ESPFLAG_SSH
     705   00:426D  21 B5 65                ld  hl,WELCOME
     706   00:4270  28 03                   jr  z,NOT32_2
     707   00:4272  21 FF 65                ld  hl,WELCOME32
     708   00:4275                      NOT32_2:
     709   00:4275  CD 9D 4C                call    PRINTHL
     710   00:4278                          CHECK_QUICK_RECEIVE
     710   00:4278  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
     710   00:427B  CB 5F             >     bit 3,a
     711   00:427D  20 08                   jr  nz,ESPSETUP.2NF             ; If yes, tells Quick Receive support
     712   00:427F  21 69 66                ld  hl,WELCOME_SF2
     713   00:4282  CD 9D 4C                call    PRINTHL                 ; Print Welcome message no QR
     714   00:4285  18 06                   jr  ESPSETUP.3NF
     715   00:4287                      ESPSETUP.2NF:
     716   00:4287  21 4D 66                ld  hl,WELCOME_SF
     717   00:428A  CD 9D 4C                call    PRINTHL                 ; Print Welcome message QR
     718   00:428D                      ESPSETUP.3NF:
     719   00:428D  21 89 66                ld  hl,WELCOME_CS
     720   00:4290  CD 9D 4C                call    PRINTHL                 ; Print Wi-Fi is reconnecting to:
     721   00:4293                      ESPSETUP_NEXT:
     722   00:4293  CD 56 01                call    KILBUF                  ; Clear Keyboard Buffer
     723   00:4296  21 B3 66                ld  hl,WELCOME_NEXT
     724   00:4299  CD 9D 4C                call    PRINTHL
     725   00:429C  21 BD 66                ld  hl,WELCOME_SF_NEXT
     726   00:429F  CD 9D 4C                call    PRINTHL                 ; Print Empty Welcome message
     727   00:42A2  CD 38 43                call    GET_AP_STAT
     728   00:42A5  CA DD 42                jp  z,ESPSETUP_NEXT.1G          ; Won't block in case of error
     729   00:42A8                          ; Success, so connection state is in IX+0, then, zero terminated string with SSID starting at IX+1
     730   00:42A8  DD 7E 00                ld  a,(ix+0)
     731   00:42AB  21 C0 66                ld  hl,WELCOME_CS0_NEXT
     732   00:42AE  FE 00                   cp  0
     733   00:42B0  28 1F                   jr  z,ESPSETUP_NEXT.2F
     734   00:42B2  21 EA 66                ld  hl,WELCOME_CS1_NEXT
     735   00:42B5  FE 01                   cp  1
     736   00:42B7  28 18                   jr  z,ESPSETUP_NEXT.2F
     737   00:42B9  21 F3 66                ld  hl,WELCOME_CS2_NEXT
     738   00:42BC  FE 02                   cp  2
     739   00:42BE  28 11                   jr  z,ESPSETUP_NEXT.2F
     740   00:42C0  21 1D 67                ld  hl,WELCOME_CS3_NEXT
     741   00:42C3  FE 03                   cp  3
     742   00:42C5  28 0A                   jr  z,ESPSETUP_NEXT.2F
     743   00:42C7  21 47 67                ld  hl,WELCOME_CS4_NEXT
     744   00:42CA  FE 04                   cp  4
     745   00:42CC  28 03                   jr  z,ESPSETUP_NEXT.2F
     746   00:42CE  21 71 67                ld  hl,WELCOME_CS5_NEXT
     747   00:42D1                      ESPSETUP_NEXT.2F:
     748   00:42D1  FD 67                   ld  iyh,a                       ; Save current conn status in iyh
     749   00:42D3  CD 9D 4C                call    PRINTHL                 ; Print Status
     750   00:42D6  DD E5                   push    ix
     751   00:42D8  E1                      pop hl
     752   00:42D9  23                      inc hl                          ; HL has AP Name
     753   00:42DA  CD A7 4C                call    PRINTHLINE              ; Print AP Name
     754   00:42DD                      ESPSETUP_NEXT.1G:
     755   00:42DD  21 9B 67                ld  hl,MMENU_S_NEXT
     756   00:42E0  CD 9D 4C                call    PRINTHL                 ; Print Main Menu
     757   00:42E3                      MM_CURSOR_BLINK:
     758   00:42E3  CD 24 43                call    MM_CURSOR_SW            ; Cursor On
     759   00:42E6                      CONN_CHG_LOOP:
     760   00:42E6  CD 9C 00                call    CHSNS
     761   00:42E9  20 13                   jr  nz,MM_WAIT_INPUT            ; If not zero, there is a key in buffer
     762   00:42EB                          ; Ok, there is not, we can check if connection status changed
     763   00:42EB  CD 38 43                call    GET_AP_STAT
     764   00:42EE  CA E6 42                jp  z,CONN_CHG_LOOP             ; Won't block in case of error
     765   00:42F1                          ; Success, so connection state is in IX+0
     766   00:42F1  DD 7E 00                ld  a,(ix+0)
     767   00:42F4  FD BC                   cp  iyh                         ; If same, zero
     768   00:42F6  28 EE                   jr  z,CONN_CHG_LOOP             ; Keep loop
     769   00:42F8  CD 24 43                call    MM_CURSOR_SW            ; Cursor Off
     770   00:42FB  C3 93 42                jp  ESPSETUP_NEXT               ; Changed, re-build menu
     771   00:42FE                      MM_WAIT_INPUT:
     772   00:42FE  CD 9F 00                call    CHGET
     773   00:4301  FE 1B                   cp  #1b                         ; ESC?
     774   00:4303  CA 3A 42                jp  z,ESPSETUP.EXIT             ; When done, resume initialization
     775   00:4306  FE 31                   cp  '1'                         ; Setup Nagle?
     776   00:4308  CA FB 48                jp  z,SET_NAGLE
     777   00:430B  FE 32                   cp  '2'                         ; Setup Wi-Fi On Period?
     778   00:430D  CA 35 48                jp  z,SET_WIFI_TIMEOUT
     779   00:4310  FE 33                   cp  '3'                         ; Scan networks?
     780   00:4312  CA 85 45                jp  z,START_WIFI_SCAN
     781   00:4315  FE 34                   cp  '4'                         ; Automatic Setting of Clock?
     782   00:4317  CA A1 43                jp  z,START_CLK_AUTO
     783   00:431A  CD C0 00                call    BEEP                    ; Wrong Input, beep
     784   00:431D  CD 24 43                call    MM_CURSOR_SW            ; Cursor Off
     785   00:4320  76                      halt
     786   00:4321  C3 E3 42                jp  MM_CURSOR_BLINK             ; And return, waiting another key
     787   00:4324                      MM_CURSOR_SW:                       ; Cursor workaround for CONN_CHG_LOOP
     788   00:4324  3E 1D                   ld  a,GOLEFT
     789   00:4326  CD A2 00                call    CHPUT
     790   00:4329  3E 01                   ld  a,1
     791   00:432B  32 A9 FC                ld  (CSRSW),a
     792   00:432E  3E 20                   ld  a,' '
     793   00:4330  CD A2 00                call    CHPUT                   ; Switch the cursor display mode
     794   00:4333  AF                      xor a
     795   00:4334  32 A9 FC                ld  (CSRSW),a
     796   00:4337  C9                      ret
     797   00:4338                      GET_AP_STAT:                        ; Use 'call GET_AP_STAT'
     798   00:4338                          CLEAR_UART
     798   00:4338  3E 14             >     ld  a,20
     798   00:433A  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     799   00:433D  3E 67                   ld  a,CMD_AP_STS
     800   00:433F                          SEND_DATA                       ; Get AP conn status and name
     800   00:433F  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     801   00:4342  21 3C 00                ld  hl,60                       ; Wait Up To 1s
     802   00:4345  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
     803   00:4349  DD 6B                   ld  ixl,e
     804   00:434B  DD 62                   ld  ixh,d                       ; Address in IX
     805   00:434D  C3 75 4B                jp  WAIT_MENU_CMD_RESPONSE
     806   00:4350                      
     807   00:4350                      ;============================
     808   00:4350                      ;===  SETUP Menu Routines  ==
     809   00:4350                      ;===  Wi-Fi and Clock Menu ==
     810   00:4350                      ;============================
     811   00:4350                      CLK_MSX1_GO:
     812   00:4350  21 8A 69                ld  hl,MMENU_CLOCK_MSX1
     813   00:4353  CD 9D 4C                call    PRINTHL                 ; Print Main Clock MSX1 message
     814   00:4356  CD 1D 4A                call    ISCLKAUTO
     815   00:4359  DD 7E 00                ld  a,(ix+0)                    ; Auto Clock Current setting
     816   00:435C  FE 03                   cp  3                           ; If 3 adapter disabled
     817   00:435E  28 08                   jr  z,CLK_MSX1_ADAPTERDIS
     818   00:4360  21 1E 6A                ld  hl,MMENU_CLOCK_0
     819   00:4363  CD 9D 4C                call    PRINTHL
     820   00:4366  18 06                   jr  CLK_MSX1_OPT
     821   00:4368                      CLK_MSX1_ADAPTERDIS:
     822   00:4368  21 64 6A                ld  hl,MMENU_CLOCK_3
     823   00:436B  CD 9D 4C                call    PRINTHL
     824   00:436E                      CLK_MSX1_OPT:
     825   00:436E  21 77 6A                ld  hl,MMENU_CLOCK_OPT
     826   00:4371  CD 9D 4C                call    PRINTHL
     827   00:4374                      CLK_MSX1_WAIT_OPT_INPUT:
     828   00:4374  CD 9F 00                call    CHGET
     829   00:4377  FE 1B                   cp  #1b                         ; ESC?
     830   00:4379  CA 5E 42                jp  z,ESPSETUP                  ; Back to main menu
     831   00:437C  FE 30                   cp  '0'
     832   00:437E  CA 8C 43                jp  z,CLK_MSX1_SEND_CMD
     833   00:4381  FE 33                   cp  '3'
     834   00:4383  CA 48 44                jp  z,CLK_AUTO_WAIT_GMT
     835   00:4386  CD C0 00                call    BEEP                    ; Wrong Input, beep
     836   00:4389  C3 74 43                jp  CLK_MSX1_WAIT_OPT_INPUT     ; And return, waiting another key
     837   00:438C                      CLK_MSX1_SEND_CMD:
     838   00:438C  CD A2 00                call    CHPUT                   ; Print option
     839   00:438F  D6 30                   sub '0'                         ; Adjust format
     840   00:4391  DD 77 00                ld  (ix+0),a                    ; Save it
     841   00:4394  3E 0D                   ld  a,#0d
     842   00:4396  CD A2 00                call    CHPUT
     843   00:4399  3E 0A                   ld  a,#0a
     844   00:439B  CD A2 00                call    CHPUT
     845   00:439E  C3 3F 45                jp  CLK_AUTO_GMT_CHK_DONE       ; And sending the command will be done there
     846   00:43A1                      
     847   00:43A1                      START_CLK_AUTO:
     848   00:43A1  3E 34                   ld  a,'4'
     849   00:43A3  CD A2 00                call    CHPUT
     850   00:43A6  CD 16 4A                call    WAIT_250MS_AND_THEN_CONTINUE
     851   00:43A9  3A 2D 00                ld  a,(#002D)                   ; Check MSX Version
     852   00:43AC  B7                      or  a
     853   00:43AD  CA 50 43                jp  z,CLK_MSX1_GO               ; If zero, MSX1, so can just enable or disable adapter
     854   00:43B0                      CLK_AUTO_GO:
     855   00:43B0  21 2A 68                ld  hl,MMENU_CLOCK_MSX2
     856   00:43B3  CD 9D 4C                call    PRINTHL                 ; Print Main Clock MSX2 message
     857   00:43B6  CD 1D 4A                call    ISCLKAUTO
     858   00:43B9  DD 7E 00                ld  a,(ix+0)                    ; Auto Clock Current setting
     859   00:43BC  B7                      or  a                           ; If zero, off
     860   00:43BD  20 08                   jr  nz,CLK_AUTO_CHK1
     861   00:43BF  21 1E 6A                ld  hl,MMENU_CLOCK_0
     862   00:43C2  CD 9D 4C                call    PRINTHL
     863   00:43C5  18 59                   jr  CLK_AUTO_GMT_OPT
     864   00:43C7                      CLK_AUTO_CHK1:
     865   00:43C7  3D                      dec a                           ; If 1, on and keep wifi on
     866   00:43C8  20 08                   jr  nz,CLK_AUTO_CHK2
     867   00:43CA  21 30 6A                ld  hl,MMENU_CLOCK_1
     868   00:43CD  CD 9D 4C                call    PRINTHL
     869   00:43D0  18 13                   jr  CLK_AUTO_GMT
     870   00:43D2                      CLK_AUTO_CHK2:
     871   00:43D2  3D                      dec a                           ; If 2, on and turn wifi off
     872   00:43D3  20 08                   jr  nz,CLK_AUTO_3
     873   00:43D5  21 4A 6A                ld  hl,MMENU_CLOCK_2
     874   00:43D8  CD 9D 4C                call    PRINTHL
     875   00:43DB  18 08                   jr  CLK_AUTO_GMT
     876   00:43DD                      CLK_AUTO_3:
     877   00:43DD  21 64 6A                ld  hl,MMENU_CLOCK_3
     878   00:43E0  CD 9D 4C                call    PRINTHL
     879   00:43E3  18 3B                   jr  CLK_AUTO_GMT_OPT
     880   00:43E5                      CLK_AUTO_GMT:
     881   00:43E5  DD 66 01                ld  h,(ix+1)                    ; Save it for now
     882   00:43E8  DD 7E 01                ld  a,(ix+1)                    ; GMT current setting
     883   00:43EB  CB 7F                   bit 7,a                         ; If set, is -
     884   00:43ED  28 0B                   jr  z,CLK_AUTO_GMTP
     885   00:43EF  3E 2D                   ld  a,'-'
     886   00:43F1  CD A2 00                call    CHPUT
     887   00:43F4  DD CB 01 BE             res 7,(ix+1)                    ; Clear - indicator
     888   00:43F8  18 05                   jr  CLK_AUTO_GMTM
     889   00:43FA                      CLK_AUTO_GMTP:
     890   00:43FA  3E 2B                   ld  a,'+'
     891   00:43FC  CD A2 00                call    CHPUT
     892   00:43FF                      CLK_AUTO_GMTM:
     893   00:43FF  3E 09                   ld  a,9
     894   00:4401  DD BE 01                cp  (ix+1)                      ; Greater than 9?
     895   00:4404  30 0F                   jr  nc,CLK_AUTO_GMTD            ; If not, just print what is in A + '0'
     896   00:4406  3E 31                   ld  a,'1'                       ; It is 1
     897   00:4408  CD A2 00                call    CHPUT
     898   00:440B  DD 7E 01                ld  a,(ix+1)
     899   00:440E  C6 26                   add '0'-10                      ; Need to subtract 10 and add '0' to print
     900   00:4410  CD A2 00                call    CHPUT
     901   00:4413  18 0B                   jr  CLK_AUTO_GMT_OPT
     902   00:4415                      CLK_AUTO_GMTD:
     903   00:4415  3E 30                   ld  a,'0'
     904   00:4417  DD 86 01                add a,(ix+1)                    ; Our value
     905   00:441A  CD A2 00                call    CHPUT
     906   00:441D  DD 74 01                ld  (ix+1),h                    ; Restore original value
     907   00:4420                      CLK_AUTO_GMT_OPT:
     908   00:4420  21 77 6A                ld  hl,MMENU_CLOCK_OPT
     909   00:4423  CD 9D 4C                call    PRINTHL
     910   00:4426                      CLK_AUTO_WAIT_OPT_INPUT:
     911   00:4426  CD 9F 00                call    CHGET
     912   00:4429  FE 1B                   cp  #1b                         ; ESC?
     913   00:442B  CA 5E 42                jp  z,ESPSETUP                  ; Back to main menu
     914   00:442E  FE 30                   cp  '0'
     915   00:4430  CA 48 44                jp  z,CLK_AUTO_WAIT_GMT
     916   00:4433  FE 31                   cp  '1'
     917   00:4435  CA 48 44                jp  z,CLK_AUTO_WAIT_GMT
     918   00:4438  FE 32                   cp  '2'
     919   00:443A  CA 48 44                jp  z,CLK_AUTO_WAIT_GMT
     920   00:443D  FE 33                   cp  '3'
     921   00:443F  CA 48 44                jp  z,CLK_AUTO_WAIT_GMT
     922   00:4442  CD C0 00                call    BEEP                    ; Wrong Input, beep
     923   00:4445  C3 26 44                jp  CLK_AUTO_WAIT_OPT_INPUT     ; And return, waiting another key
     924   00:4448                      CLK_AUTO_WAIT_GMT:
     925   00:4448  CD A2 00                call    CHPUT                   ; Print option
     926   00:444B  D6 30                   sub '0'                         ; Adjust format
     927   00:444D  DD 77 00                ld  (ix+0),a                    ; Save it
     928   00:4450  B7                      or  a
     929   00:4451  CA 3F 45                jp  z,CLK_AUTO_GMT_CHK_DONE     ; And send the command if just disabling clock auto set
     930   00:4454  FE 03                   cp  3
     931   00:4456  CA 3F 45                jp  z,CLK_AUTO_GMT_CHK_DONE     ; Or send the command if just disabling the adapter
     932   00:4459  21 A1 6A                ld  hl,MMENU_GMT_OPT
     933   00:445C  CD 9D 4C                call    PRINTHL
     934   00:445F  16 00                   ld  d,0                         ; # of digits entered
     935   00:4461  1E 00                   ld  e,0                         ; # of characters printed
     936   00:4463  DD 36 01 00             ld  (ix+1),0                    ; GMT 0
     937   00:4467                      CLK_AUTO_WAIT_GMT_INPUT:
     938   00:4467  CD 9F 00                call    CHGET
     939   00:446A  FE 1B                   cp  #1b                         ; ESC?
     940   00:446C  CA 5E 42                jp  z,ESPSETUP                  ; Back to main menu
     941   00:446F  FE 0D                   cp  #0d                         ; ENTER?
     942   00:4471  CA BA 44                jp  z,CLK_AUTO_GMT_CHK_INPUT    ; Check if ok to send command
     943   00:4474  FE 08                   cp  #08                         ; Backspace?
     944   00:4476  CA 8B 44                jp  z,CLK_AUTO_GMT_CHK_BS       ; Check if there is something to erase
     945   00:4479  FE 2D                   cp  '-'                         ; Negative value?
     946   00:447B  CA BA 44                jp  z,CLK_AUTO_GMT_CHK_INPUT
     947   00:447E  FE 30                   cp  '0'                         ; >=0?
     948   00:4480  DA AC 44                jp  c,CLK_AUTO_GMT_BAD_INPUT    ; If not, bad input
     949   00:4483  FE 3A                   cp  '9'+1                       ; <= 9
     950   00:4485  D2 AC 44                jp  nc,CLK_AUTO_GMT_BAD_INPUT   ; If not, bad input
     951   00:4488  C3 BA 44                jp  CLK_AUTO_GMT_CHK_INPUT      ; Otherwise, validate digit
     952   00:448B                      CLK_AUTO_GMT_CHK_BS:
     953   00:448B  AF                      xor a
     954   00:448C  BB                      cp  e                           ; Anything on screen?
     955   00:448D  28 1D                   jr  z,CLK_AUTO_GMT_BAD_INPUT    ; Nothing to erase
     956   00:448F  1D                      dec e                           ; One less character on the screen
     957   00:4490  BA                      cp  d                           ; Any digit?
     958   00:4491  28 03                   jr  z,CLK_AUTO_GMT_CHK_BS_MIN   ; If not, just erase - sign
     959   00:4493                          ; There is, so it is one less digit
     960   00:4493  15                      dec d
     961   00:4494  18 04                   jr  CLK_AUTO_GMT_CHK_DIGIT
     962   00:4496                      CLK_AUTO_GMT_CHK_BS_MIN:
     963   00:4496  DD 36 01 00             ld  (ix+1),0                    ; Reset sign
     964   00:449A                      CLK_AUTO_GMT_CHK_DIGIT:
     965   00:449A  3E 08                   ld  a,8                         ; Backspace
     966   00:449C  CD A2 00                call    CHPUT                   ; Print it
     967   00:449F  3E 20                   ld  a,' '                       ; Space
     968   00:44A1  CD A2 00                call    CHPUT                   ; Print it
     969   00:44A4  3E 08                   ld  a,8                         ; Backspace
     970   00:44A6  CD A2 00                call    CHPUT                   ; Print it
     971   00:44A9  C3 67 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; Return
     972   00:44AC                      CLK_AUTO_GMT_BAD_INPUT:
     973   00:44AC                          ; Beep might use sub rom, and if so, all registers will be messed up, better save
     974   00:44AC  C5                      push    bc
     975   00:44AD  D5                      push    de
     976   00:44AE  F5                      push    af
     977   00:44AF  E5                      push    hl
     978   00:44B0  CD C0 00                call    BEEP                    ; Wrong Input, beep
     979   00:44B3  E1                      pop hl
     980   00:44B4  F1                      pop af
     981   00:44B5  D1                      pop de
     982   00:44B6  C1                      pop bc
     983   00:44B7  C3 67 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; And return, waiting another key
     984   00:44BA                      CLK_AUTO_GMT_CHK_INPUT:
     985   00:44BA  4F                      ld  c,a                         ; Save in C for printing if needed
     986   00:44BB  FE 2D                   cp  '-'                         ; - sign?
     987   00:44BD  20 11                   jr  nz,CLK_AUTO_GMT_CHK_CR      ; If not, check if enter
     988   00:44BF                          ; - sign
     989   00:44BF  3E 00                   ld  a,0
     990   00:44C1  BB                      cp  e                           ; If not the first character, can't accept
     991   00:44C2  20 E8                   jr  nz,CLK_AUTO_GMT_BAD_INPUT
     992   00:44C4                          ; It is the first, so let's print it
     993   00:44C4  79                      ld  a,c
     994   00:44C5  CD A2 00                call    CHPUT
     995   00:44C8  DD 36 01 80             ld  (ix+1),0x80                 ; Set the - sign bit, for now rest is zero
     996   00:44CC  1C                      inc e                           ; Increase # of characters printed
     997   00:44CD  C3 67 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; Continue waiting input
     998   00:44D0                      CLK_AUTO_GMT_CHK_CR:
     999   00:44D0  FE 0D                   cp  #0d                         ; ENTER?
    1000   00:44D2  20 0F                   jr  nz,CLK_AUTO_GMT_CHK_CD      ; If not, check if digit is valid
    1001   00:44D4                          ; Enter
    1002   00:44D4  3E 00                   ld  a,0
    1003   00:44D6  BA                      cp  d                           ; Ok, at least one digit entered?
    1004   00:44D7  28 D3                   jr  z,CLK_AUTO_GMT_BAD_INPUT    ; No, so, enter is no good now
    1005   00:44D9                          ; It is, if it had a digit entered and did not send, it was 1, so...
    1006   00:44D9  3E 01                   ld  a,1
    1007   00:44DB  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1008   00:44DE  DD 77 01                ld  (ix+1),a                    ; Save
    1009   00:44E1  18 5C                   jr  CLK_AUTO_GMT_CHK_DONE       ; Ok, ready to send
    1010   00:44E3                      CLK_AUTO_GMT_CHK_CD:
    1011   00:44E3                          ; Ok, it is a digit
    1012   00:44E3  06 30                   ld  b,'0'
    1013   00:44E5  90                      sub a,b                         ; A has digit value
    1014   00:44E6  47                      ld  b,a                         ; Save in B
    1015   00:44E7  3E 00                   ld  a,0
    1016   00:44E9  BA                      cp  d
    1017   00:44EA  20 1E                   jr  nz,CLK_AUTO_GMT_CHK_CSD     ; If not zero, it is second digit, so almost done
    1018   00:44EC                          ; 1st digit, let's check if it is other than 1, if it is, we are almost done
    1019   00:44EC  3E 01                   ld  a,1
    1020   00:44EE  B8                      cp  b
    1021   00:44EF  28 10                   jr  z,CLK_AUTO_GMT_CHK_CD.1     ; If it is 1, wait next digit or enter
    1022   00:44F1                          ; Not 1, so just adjust ix+1 and go
    1023   00:44F1  79                      ld  a,c
