    5410   00:5CC1  FE 86                   cp #86                          ; Is response of our command?
    5411   00:5CC3  20 ED                   jr  nz,SSH_RCV_ST1
    5412   00:5CC5                          ; At this point, all data is being buffered, so 15 ticks, quarter second, is more than enough time-out
    5413   00:5CC5  F3                      di
    5414   00:5CC6  21 1E 00                ld  hl,30
    5415   00:5CC9  CD C2 5E                call    SETCOUNTER
