    5719   00:5E59  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5720   00:5E5C  78                      ld  a,b
    5721   00:5E5D                          SEND_DATA                       ; Send the connection #
    5721   00:5E5D  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5722   00:5E60  2B                      dec hl
    5723   00:5E61  EB                      ex  de,hl
    5724   00:5E62                          ; now oti the data starting at hl, size is in DE
    5725   00:5E62                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    5726   00:5E62  43                      ld  b,e                         ;Number of loops originaly in DE
    5727   00:5E63  1B                      dec de
