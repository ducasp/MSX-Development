    5201   00:5BA7                          ; nz, discard
    5202   00:5BA7                          RECEIVE_DATA
    5202   00:5BA7  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5203   00:5BAA  B7                      or  a                           ; 0?
    5204   00:5BAB  C0                      ret nz                          ; if not, done
    5205   00:5BAC                      
    5206   00:5BAC                          ; next two bytes are return code and size bytes, don't care, it is 0
    5207   00:5BAC  06 02                   ld  b,2
    5208   00:5BAE                      TCPIP_TCP_SEND_ST2:
    5209   00:5BAE                          CHECK_DATA
    5209   00:5BAE  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5209   00:5BB1  CB 47             >     bit 0,a
    5210   00:5BB3  20 05                   jr  nz,TCPIP_TCP_SEND_ST2.1
    5211   00:5BB5  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
