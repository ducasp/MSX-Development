    4387   00:5744  20 05                   jr  nz,SSH_OPEN_HOSTHASH.1
    4388   00:5746  CD 8C 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    4389   00:5749  18 F4                   jr  SSH_OPEN_HOSTHASH
