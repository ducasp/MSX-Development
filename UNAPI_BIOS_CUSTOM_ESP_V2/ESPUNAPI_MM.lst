    6083   00:6048                          ; next two bytes are response size bytes save it to BC
    6084   00:6048                      SSH_RCV_ST2A:
    6085   00:6048                          CHECK_DATA
    6085   00:6048  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
