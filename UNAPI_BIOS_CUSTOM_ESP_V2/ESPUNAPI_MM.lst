    4936   00:5A15                          CHECK_DATA
    4936   00:5A15  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    4936   00:5A18  CB 47             >     bit 0,a
    4937   00:5A1A  20 05                   jr  nz,TCPIP_TCP_STATE_ERROR2.1
    4938   00:5A1C  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4939   00:5A1F  18 F4                   jr  TCPIP_TCP_STATE_ERROR2
    4940   00:5A21                      TCPIP_TCP_STATE_ERROR2.1:
    4941   00:5A21                          ; nz, discard
    4942   00:5A21                          RECEIVE_DATA
    4942   00:5A21  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4943   00:5A24  0D                      dec c
    4944   00:5A25  20 EE                   jr  nz,TCPIP_TCP_STATE_ERROR2
    4945   00:5A27                      
    4946   00:5A27                          ; now return w/ error that is saved in b
    4947   00:5A27  78                      ld  a,b
    4948   00:5A28  06 00                   ld  b,0
    4949   00:5A2A  0E 07                   ld  c,7
    4950   00:5A2C  21 00 00                ld  hl,0
    4951   00:5A2F  11 00 00                ld  de,0
    4952   00:5A32  DD 21 00 00             ld  ix,0
