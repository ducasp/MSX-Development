    5133   00:5B62                      ;========================
    5134   00:5B62                      ;===  TCPIP_TCP_SEND  ===
    5135   00:5B62                      ;========================
    5136   00:5B62                      ;Send data to a TCP connection.
    5137   00:5B62                      ;
    5138   00:5B62                      ;Input:  A  = 17
    5139   00:5B62                      ;        B  = Connection number
    5140   00:5B62                      ;        DE = Address of the data to be sent
    5141   00:5B62                      ;        HL = Length of the data to be sent
