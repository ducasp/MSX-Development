    2397   00:4DA1                      
    2398   00:4DA1  FE 1D                   cp  MAX_FN
    2399   00:4DA3  28 02                   jr  z,OK_FNUM
    2400   00:4DA5  30 0E                   jr  nc,UNDEFINED
    2401   00:4DA7                      
