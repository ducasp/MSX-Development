    5241   00:5BCD                          SEND_DATA                       ; Send the command size lsb
    5241   00:5BCD  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5242   00:5BD0  78                      ld  a,b
    5243   00:5BD1                          SEND_DATA                       ; Send the connection #
    5243   00:5BD1  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5244   00:5BD4  2B                      dec hl
    5245   00:5BD5  EB                      ex  de,hl
    5246   00:5BD6                          ; now oti the data starting at hl, size is in DE
    5247   00:5BD6                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    5248   00:5BD6  43                      ld  b,e                         ;Number of loops originaly in DE
    5249   00:5BD7  1B                      dec de
    5250   00:5BD8  14                      inc d
    5251   00:5BD9                          if USE_MEM_IO = 0
    5252   00:5BD9                    ~     ld  c,OUT_TX_PORT
    5253   00:5BD9                    ~ SSH_SEND_R:
    5254   00:5BD9                    ~     outi
    5255   00:5BD9                    ~     jr  nz,SSH_SEND_R
    5256   00:5BD9                    ~     else
    5257   00:5BD9                      SSH_SEND_R:
    5258   00:5BD9  7E                      ld  a,(hl)
    5259   00:5BDA  32 07 7F                ld  (MEM_OUT_TX_PORT),a
    5260   00:5BDD  23                      inc hl
    5261   00:5BDE  10 F9                   djnz SSH_SEND_R
    5262   00:5BE0                          endif
    5263   00:5BE0  15                      dec d
    5264   00:5BE1  20 F6                   jr  nz,SSH_SEND_R
    5265   00:5BE3                      
    5266   00:5BE3                          ; Now wait up to 600 ticks to get response
    5267   00:5BE3  21 58 02                ld  hl,600
    5268   00:5BE6  CD 36 61                call    SETCOUNTER
    5269   00:5BE9                      SSH_SEND_ST1:
    5270   00:5BE9                          CHECK_DATA
    5270   00:5BE9  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5270   00:5BEC  CB 47             >     bit 0,a
    5271   00:5BEE  20 05                   jr  nz,SSH_SEND_R.1
    5272   00:5BF0  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5273   00:5BF3  18 F4                   jr  SSH_SEND_ST1
