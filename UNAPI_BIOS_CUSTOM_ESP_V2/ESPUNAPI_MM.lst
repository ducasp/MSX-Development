    5400   00:5CB9  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5401   00:5CBC  05                      dec b
    5402   00:5CBD  20 EE                   jr  nz,TCPIP_TCP_STATE_ST2
    5403   00:5CBF                      
    5404   00:5CBF                          ; now just get the 16 bytes (Port LSB then MSB, # of packets, packet size LSB then MSB) and order it in C, B, L, H, E, D, IXL and IXH.
    5405   00:5CBF                          ; Remaining 8 bytes go to TCP_STATE_INFORMATION_BLOCK if its value is other than 0
