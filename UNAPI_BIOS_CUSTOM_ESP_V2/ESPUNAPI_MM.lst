    5133   00:5B4A                      ;=======================
    5134   00:5B4A                      ;===  TCPIP_TCP_RCV  ===
    5135   00:5B4A                      ;=======================
    5136   00:5B4A                      ;Receive data from a TCP connection.
    5137   00:5B4A                      ;
    5138   00:5B4A                      ;Input:   A  = 18
    5139   00:5B4A                      ;         B  = Connection number
    5140   00:5B4A                      ;         DE = Address for the retrieved data
    5141   00:5B4A                      ;         HL = Length of the data to be obtained
    5142   00:5B4A                      ;Output:  A  = Error code
    5143   00:5B4A                      ;         BC = Total number of bytes that have been actually retrieved
    5144   00:5B4A                      ;         HL = Number of urgent data bytes that have been retrieved
    5145   00:5B4A                      ;              (placed at the beginning of the received data block)
    5146   00:5B4A                      ; Save registers other than AF
    5147   00:5B4A                      TCPIP_TCP_RCV_CHECK_TIME_OUT:
    5148   00:5B4A  C5                      push bc
    5149   00:5B4B  D5                      push de
    5150   00:5B4C  E5                      push hl
    5151   00:5B4D  CD B3 5E                call    GETCOUNTER
    5152   00:5B50  7D                      ld  a,l
    5153   00:5B51  B4                      or  h
    5154   00:5B52                          ; Restore registers, we are returning
    5155   00:5B52  E1                      pop hl
    5156   00:5B53  D1                      pop de
    5157   00:5B54  C1                      pop bc
    5158   00:5B55  C0                      ret nz
    5159   00:5B56                          ; Ok, timeout...
    5160   00:5B56  F1                      pop af                          ; Get return address of who called this out of the stack, we will return from the function or re-start
    5161   00:5B57                      TCPIP_TCP_RCV_RETRY_QRCV:
    5162   00:5B57  CD D2 5E                call    GETBYTE
    5163   00:5B5A  B7                      or  a
    5164   00:5B5B  28 0C                   jr  z,TCPIP_TCP_RCV_CHECK_TIME_OUT.NORXRETRY
    5165   00:5B5D                          ; Ok, so let's ask ESP to re-send the data and retry receiving it
    5166   00:5B5D  3D                      dec a
    5167   00:5B5E  CD E4 5E                call    SETBYTE                 ; we are retrying it
    5168   00:5B61  3E 72                   ld  a,'r'                       ; retry transmission command
    5169   00:5B63                          SEND_DATA
    5169   00:5B63  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5170   00:5B66  C3 AD 5B                jp  TCPIP_TCP_RCV.RXRETRY       ; and retry it
    5171   00:5B69                      TCPIP_TCP_RCV_CHECK_TIME_OUT.NORXRETRY:
    5172   00:5B69  3E 0F                   ld  a,ERR_INV_OPER
    5173   00:5B6B  C9                      ret                             ; and return the function itself
    5174   00:5B6C                      
    5175   00:5B6C                      TCPIP_TCP_RCV_RET_ERR:
    5176   00:5B6C                          ; next two bytes are size bytes, don't care
    5177   00:5B6C  47                      ld  b,a                         ; save error in b
    5178   00:5B6D  0E 02                   ld  c,2
    5179   00:5B6F                      TCPIP_TCP_RCV_RET_ERR2:
    5180   00:5B6F                          CHECK_DATA
    5180   00:5B6F  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5180   00:5B72  CB 47             >     bit 0,a
    5181   00:5B74  20 05                   jr  nz,TCPIP_TCP_RCV_RET_ERR2.1
    5182   00:5B76  CD 4A 5B                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5183   00:5B79  18 F4                   jr  TCPIP_TCP_RCV_RET_ERR2
    5184   00:5B7B                      TCPIP_TCP_RCV_RET_ERR2.1:
    5185   00:5B7B                          ; nz, discard
    5186   00:5B7B                          RECEIVE_DATA
    5186   00:5B7B  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5187   00:5B7E  0D                      dec c
    5188   00:5B7F  20 EE                   jr  nz,TCPIP_TCP_RCV_RET_ERR2
    5189   00:5B81                          ; now return w/ error that is saved in b
    5190   00:5B81  78                      ld  a,b
    5191   00:5B82                      TCPIP_TCP_RCV_RET_NODATA:
    5192   00:5B82  21 00 00                ld  hl,0
    5193   00:5B85  01 00 00                ld  bc,0
    5194   00:5B88  C9                      ret
    5195   00:5B89                      
    5196   00:5B89                      TCPIP_TCP_RCV:
    5197   00:5B89  EB                      ex  de,hl
    5198   00:5B8A  CD 0B 5F                call    SETWORD
    5199   00:5B8D  EB                      ex  de,hl
    5200   00:5B8E  3E 12                   ld  a,18
    5201   00:5B90                          SEND_DATA                       ; Send the command
    5201   00:5B90  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5202   00:5B93  AF                      xor a
    5203   00:5B94                          SEND_DATA                       ; Send the command size msb
    5203   00:5B94  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5204   00:5B97  3E 03                   ld  a,3
    5205   00:5B99                          SEND_DATA                       ; Send the command size lsb
    5205   00:5B99  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5206   00:5B9C  78                      ld  a,b
    5207   00:5B9D                          SEND_DATA                       ; Send the connection #
    5207   00:5B9D  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5208   00:5BA0  7D                      ld  a,l
    5209   00:5BA1                          SEND_DATA                       ; Send MAX rcv size LSB
    5209   00:5BA1  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5210   00:5BA4  7C                      ld  a,h
    5211   00:5BA5                          SEND_DATA                       ; Send MAX rcv size MSB
    5211   00:5BA5  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5212   00:5BA8  3E 03                   ld  a,3
    5213   00:5BAA  CD E4 5E                call    SETBYTE                 ; Ok, retry up to three times
    5214   00:5BAD                      TCPIP_TCP_RCV.RXRETRY:
    5215   00:5BAD                          ; Now wait up to 600 ticks to get response
    5216   00:5BAD  21 58 02                ld  hl,600
    5217   00:5BB0  CD C2 5E                call    SETCOUNTER
    5218   00:5BB3                      TCPIP_TCP_RCV_ST1:
    5219   00:5BB3                          CHECK_DATA
    5219   00:5BB3  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5219   00:5BB6  CB 47             >     bit 0,a
    5220   00:5BB8  20 05                   jr  nz,TCPIP_TCP_RCV_ST1.1
    5221   00:5BBA  CD 4A 5B                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5222   00:5BBD  18 F4                   jr  TCPIP_TCP_RCV_ST1
    5223   00:5BBF                      TCPIP_TCP_RCV_ST1.1:
    5224   00:5BBF                          ; nz, check the data
    5225   00:5BBF                          RECEIVE_DATA
    5225   00:5BBF  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5226   00:5BC2  FE 12                   cp 18                           ; Is response of our command?
    5227   00:5BC4  20 ED                   jr  nz,TCPIP_TCP_RCV_ST1
    5228   00:5BC6                          ; At this point, all data is being buffered, so 15 ticks, quarter second, is more than enough time-out
    5229   00:5BC6  F3                      di
    5230   00:5BC7  21 1E 00                ld  hl,30
    5231   00:5BCA  CD C2 5E                call    SETCOUNTER
    5232   00:5BCD  FB                      ei
    5233   00:5BCE                          ; now get return code, if return code other than 0, it is finished
    5234   00:5BCE                      TCPIP_TCP_RCV_RC:
    5235   00:5BCE                          CHECK_DATA
    5235   00:5BCE  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5235   00:5BD1  CB 47             >     bit 0,a
    5236   00:5BD3  20 05                   jr  nz,TCPIP_TCP_RCV_RC.1
    5237   00:5BD5  CD 4A 5B                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5238   00:5BD8  18 F4                   jr  TCPIP_TCP_RCV_RC
    5239   00:5BDA                      TCPIP_TCP_RCV_RC.1:
    5240   00:5BDA                          ; nz, discard
    5241   00:5BDA                          RECEIVE_DATA
    5241   00:5BDA  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5242   00:5BDD  B7                      or  a                           ; 0?
    5243   00:5BDE  20 8C                   jr  nz,TCPIP_TCP_RCV_RET_ERR    ; if not, done
    5244   00:5BE0                          ; next two bytes are response size bytes (UB count two bytes, always 0, and data read), save it -2 to BC
    5245   00:5BE0                      TCPIP_TCP_RCV_ST2A:
    5246   00:5BE0                          CHECK_DATA
    5246   00:5BE0  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5246   00:5BE3  CB 47             >     bit 0,a
    5247   00:5BE5  20 05                   jr  nz,TCPIP_TCP_RCV_ST2A.1
    5248   00:5BE7  CD 4A 5B                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5249   00:5BEA  18 F4                   jr  TCPIP_TCP_RCV_ST2A
    5250   00:5BEC                      TCPIP_TCP_RCV_ST2A.1:
    5251   00:5BEC                          ; nz, high byte count of bytes to receive
    5252   00:5BEC                          RECEIVE_DATA
    5252   00:5BEC  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5253   00:5BEF  67                      ld h,a
    5254   00:5BF0                      TCPIP_TCP_RCV_ST2B:
    5255   00:5BF0                          CHECK_DATA
    5255   00:5BF0  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5255   00:5BF3  CB 47             >     bit 0,a
    5256   00:5BF5  20 05                   jr  nz,TCPIP_TCP_RCV_ST2B.1
    5257   00:5BF7  CD 4A 5B                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5258   00:5BFA  18 F4                   jr  TCPIP_TCP_RCV_ST2B
    5259   00:5BFC                      TCPIP_TCP_RCV_ST2B.1:
    5260   00:5BFC                          ; nz, low byte count of bytes to receive
    5261   00:5BFC                          RECEIVE_DATA
    5261   00:5BFC  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5262   00:5BFF  6F                      ld  l,a
    5263   00:5C00  01 02 00                ld  bc,2
