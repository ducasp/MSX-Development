    3120   00:5143                      ;=====================
    3121   00:5143                      ;===  TCPIP_DNS_Q  ===
    3122   00:5143                      ;=====================
    3123   00:5143                      ;Start a host name resolution query.
    3124   00:5143                      ;
    3125   00:5143                      ;Input:  A  = 6
    3126   00:5143                      ;        HL = Address of the host name to be resolved, zero terminated
    3127   00:5143                      ;        B  = Flags, when set to 1 they instruct the resolver to:
    3128   00:5143                      ;             bit 0: Only abort the query currently in progress, if there is any
    3129   00:5143                      ;                    (other flags and registers are then ignored)
    3130   00:5143                      ;             bit 1: Assume that the passed name is an IP address,
    3131   00:5143                      ;                    and return an error if this is not true
    3132   00:5143                      ;             bit 2: If there is a query in progress already,
    3133   00:5143                      ;                    do NOT abort it and return an error instead
    3134   00:5143                      ;Output:  A = Error code
    3135   00:5143                      ;         B = 0 if a query to a DNS server is in progress
    3136   00:5143                      ;             1 if the name represented an IP address
    3137   00:5143                      ;             2 if the name could be resolved locally
    3138   00:5143                      ;         L.H.E.D = Resolved IP address
    3139   00:5143                      ;                   (only if no error occurred and B=1 or 2 is returned)
    3140   00:5143                      ;RAM Buffer to store names to be resolved (and used also to translate IPs from ASCII to 32bits number)
    3141   00:5143                      ;Will store the result of the last DNS query
    3142   00:5143                      TCPIP_DNS_Q:
    3143   00:5143  E5                      push    hl                      ; Save HL
    3144   00:5144  AF                      xor a
    3145   00:5145  5F                      ld  e,a
    3146   00:5146  57                      ld  d,a                         ; Zero DE
    3147   00:5147                      TCPIP_DNS_Q_SIZE_LOOP:
    3148   00:5147  7E                      ld  a,(hl)                      ; so let's check the size of dns data
    3149   00:5148  B7                      or  a                           ; it is zero terminated
    3150   00:5149  28 05                   jr  z,TCPIP_DNS_Q_SEND          ; if zero, end of string
    3151   00:514B  13                      inc de                          ; ok, not zero, one more char
    3152   00:514C  23                      inc hl                          ; next
    3153   00:514D  C3 47 51                jp  TCPIP_DNS_Q_SIZE_LOOP       ; jp is a tad bit faster and we are not worried about code size
    3154   00:5150                      TCPIP_DNS_Q_SEND:
    3155   00:5150                          ; Here we send the query and wait the result
    3156   00:5150  13                      inc de                          ; add 1, we will send flag first
    3157   00:5151  3E CE                   ld  a,206                       ; DNS_Q_NEW
    3158   00:5153                          SEND_DATA                       ; Send the command
    3158   00:5153  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3159   00:5156  7A                      ld  a,d
    3160   00:5157                          SEND_DATA                       ; Send the command size msb
    3160   00:5157  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3161   00:515A  7B                      ld  a,e
    3162   00:515B                          SEND_DATA                       ; Send the command size lsb
    3162   00:515B  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3163   00:515E  78                      ld  a,b
    3164   00:515F                          SEND_DATA                       ; Send the flag byte
    3164   00:515F  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3165   00:5162                      
    3166   00:5162                          if USE_MEM_IO = 0
    3167   00:5162                    ~     ; now otir of DNS/DNS BUFFER DATA SIZE
    3168   00:5162                    ~     ld  c,OUT_TX_PORT               ; our data TX port
    3169   00:5162                    ~     endif
    3170   00:5162  E1                      pop hl                          ; string to try to resolve
    3171   00:5163  1B                      dec de                          ; we are sending just data addressed by HL, so revert count
    3172   00:5164  7A                      ld  a,d
    3173   00:5165  B3                      or  e                           ; if de zero, no string, wrong parameters, but let the ESP answer
    3174   00:5166  CA 78 51                jp  z,TCPIP_DNS_Q_WAIT_RSP
    3175   00:5169  AF                      xor a
    3176   00:516A                          ; Fast 16 bit variable size loop by GRAUW
    3177   00:516A  43                      ld  b,e
    3178   00:516B  1B                      dec de
    3179   00:516C  14                      inc d
    3180   00:516D                      TCPIP_DNS_Q_SENDLP:
    3181   00:516D                          ; send it
    3182   00:516D                          if USE_MEM_IO = 0
    3183   00:516D                    ~     outi
    3184   00:516D                    ~     jp  nz,TCPIP_DNS_Q_SENDLP
    3185   00:516D                    ~     else
    3186   00:516D  7E                      ld  a,(hl)
    3187   00:516E  32 07 7F                ld  (MEM_OUT_TX_PORT),a
    3188   00:5171  23                      inc hl
    3189   00:5172  10 F9                   djnz TCPIP_DNS_Q_SENDLP
    3190   00:5174                          endif
    3191   00:5174  15                      dec d
    3192   00:5175  C2 6D 51                jp  nz,TCPIP_DNS_Q_SENDLP
    3193   00:5178                      TCPIP_DNS_Q_WAIT_RSP:
    3194   00:5178                          ; Now wait up to 900 ticks (15s@60Hz) to get response
    3195   00:5178  21 84 03                ld  hl,900
    3196   00:517B  CD 61 63                call    SETCOUNTER
    3197   00:517E                      TCPIP_DNSQ_SEND_ST1:
    3198   00:517E                          CHECK_DATA
    3198   00:517E  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3198   00:5181  CB 47             >     bit 0,a
    3199   00:5183  20 05                   jr  nz,TCPIP_DNSQ_SEND_ST1.1
    3200   00:5185  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3201   00:5188  18 F4                   jr  TCPIP_DNSQ_SEND_ST1
    3202   00:518A                      TCPIP_DNSQ_SEND_ST1.1:
    3203   00:518A                          ; nz, check the data
    3204   00:518A                          RECEIVE_DATA
    3204   00:518A  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3205   00:518D  FE CE                   cp  206                         ; Is response of our command?
    3206   00:518F  20 ED                   jr  nz,TCPIP_DNSQ_SEND_ST1
    3207   00:5191                          ; now get return code, if return code other than 0, it is finished
    3208   00:5191                      TCPIP_DNSQ_SEND_RC:
    3209   00:5191                          CHECK_DATA
    3209   00:5191  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3209   00:5194  CB 47             >     bit 0,a
    3210   00:5196  20 05                   jr  nz,TCPIP_DNSQ_SEND_RC.1
    3211   00:5198  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3212   00:519B  18 F4                   jr  TCPIP_DNSQ_SEND_RC
    3213   00:519D                      TCPIP_DNSQ_SEND_RC.1:
    3214   00:519D                          ; nz, discard
    3215   00:519D                          RECEIVE_DATA
    3215   00:519D  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3216   00:51A0  B7                      or  a                           ; 0?
    3217   00:51A1  06 00                   ld  b,0                         ; say in progress as there is no failure status
    3218   00:51A3  C0                      ret nz                          ; if not, done, ERROR won't return data
    3219   00:51A4                      
    3220   00:51A4                          ; next two bytes are return code and size bytes, don't care, it is 4, resolved IP
    3221   00:51A4  06 02                   ld  b,2
    3222   00:51A6                      TCPIP_DNSQ_SEND_RC_ST2:
    3223   00:51A6                          CHECK_DATA
    3223   00:51A6  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3223   00:51A9  CB 47             >     bit 0,a
    3224   00:51AB  20 05                   jr  nz,TCPIP_DNSQ_SEND_RC_ST2.1
    3225   00:51AD  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3226   00:51B0  18 F4                   jr  TCPIP_DNSQ_SEND_RC_ST2
    3227   00:51B2                      TCPIP_DNSQ_SEND_RC_ST2.1:
    3228   00:51B2                          ; nz, discard
    3229   00:51B2                          RECEIVE_DATA
    3229   00:51B2  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3230   00:51B5  05                      dec b
    3231   00:51B6  20 EE                   jr  nz,TCPIP_DNSQ_SEND_RC_ST2
    3232   00:51B8                      
    3233   00:51B8                          ; now just get the 4 bytes IP and place it in L H E D
    3234   00:51B8                      TCPIP_DNSQ_IP_ST1:
    3235   00:51B8                          CHECK_DATA
    3235   00:51B8  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3235   00:51BB  CB 47             >     bit 0,a
    3236   00:51BD  20 05                   jr  nz,TCPIP_DNSQ_IP_ST1.1
    3237   00:51BF  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3238   00:51C2  18 F4                   jr  TCPIP_DNSQ_IP_ST1
    3239   00:51C4                      TCPIP_DNSQ_IP_ST1.1:
    3240   00:51C4                          ; nz, get it
    3241   00:51C4                          RECEIVE_DATA
    3241   00:51C4  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3242   00:51C7  6F                      ld  l,a
    3243   00:51C8                      TCPIP_DNSQ_IP_ST2:
    3244   00:51C8                          CHECK_DATA
    3244   00:51C8  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3244   00:51CB  CB 47             >     bit 0,a
    3245   00:51CD  20 05                   jr  nz,TCPIP_DNSQ_IP_ST2.1
    3246   00:51CF  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3247   00:51D2  18 F4                   jr  TCPIP_DNSQ_IP_ST2
    3248   00:51D4                      TCPIP_DNSQ_IP_ST2.1:
    3249   00:51D4                          ; nz, get it
    3250   00:51D4                          RECEIVE_DATA
    3250   00:51D4  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3251   00:51D7  67                      ld  h,a
    3252   00:51D8                      TCPIP_DNSQ_IP_ST3:
    3253   00:51D8                          CHECK_DATA
    3253   00:51D8  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3253   00:51DB  CB 47             >     bit 0,a
    3254   00:51DD  20 05                   jr  nz,TCPIP_DNSQ_IP_ST3.1
    3255   00:51DF  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3256   00:51E2  18 F4                   jr  TCPIP_DNSQ_IP_ST3
    3257   00:51E4                      TCPIP_DNSQ_IP_ST3.1:
    3258   00:51E4                          ; nz, get it
    3259   00:51E4                          RECEIVE_DATA
    3259   00:51E4  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3260   00:51E7  5F                      ld  e,a
    3261   00:51E8                      TCPIP_DNSQ_IP_ST4:
    3262   00:51E8                          CHECK_DATA
    3262   00:51E8  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3262   00:51EB  CB 47             >     bit 0,a
    3263   00:51ED  20 05                   jr  nz,TCPIP_DNSQ_IP_ST4.1
    3264   00:51EF  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3265   00:51F2  18 F4                   jr  TCPIP_DNSQ_IP_ST4
    3266   00:51F4                      TCPIP_DNSQ_IP_ST4.1:
    3267   00:51F4                          ; nz, get it
    3268   00:51F4                          RECEIVE_DATA
    3268   00:51F4  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3269   00:51F7  57                      ld  d,a
    3270   00:51F8                          ; done
    3271   00:51F8  3E 01                   ld  a,1
    3272   00:51FA  CD 73 64                call    SETDNSREADY             ; DNS done
    3273   00:51FD  CD 9D 64                call    SETDNSRESULT            ; DNS RESULT
    3274   00:5200  06 02                   ld  b,2
    3275   00:5202  AF                      xor a
    3276   00:5203  C9                      ret
    3277   00:5204                      
    3278   00:5204                      ;=====================
    3279   00:5204                      ;===  TCPIP_DNS_S  ===
    3280   00:5204                      ;=====================
    3281   00:5204                      ;Obtains the host name resolution process state and result.
    3282   00:5204                      ;
    3283   00:5204                      ;Input:  A = 7
    3284   00:5204                      ;        B = Flags, when set to 1 they instruct the resolver to:
    3285   00:5204                      ;            bit 0: Clear any existing result or error condition after the execution
    3286   00:5204                      ;                   (except if there is a query in progress)
    3287   00:5204                      ;Output: A = Error code
    3288   00:5204                      ;        B = DNS error code (when error is ERR_DNS)
    3289   00:5204                      ;        B = Current query status (when error is ERR_OK):
    3290   00:5204                      ;            0: There is no query in progress, nor any result nor error code available
    3291   00:5204                      ;            1: There is a query in progress
    3292   00:5204                      ;            2: Query is complete
    3293   00:5204                      ;        C = Current query sub status (when error is ERR_OK and B=1):
    3294   00:5204                      ;            0: Unknown
    3295   00:5204                      ;            1: Querying the primary DNS server
    3296   00:5204                      ;            2: Querying the secondary DNS server
    3297   00:5204                      ;            3: Querying another DNS server
    3298   00:5204                      ;        C = Resolution process type (when error is ERR_OK and B=2):
    3299   00:5204                      ;            0: The name was obtained by querying a DNS server
    3300   00:5204                      ;            1: The name was a direct representation of an IP address
    3301   00:5204                      ;            2: The name was resolved locally
    3302   00:5204                      ;       L.H.E.D = Resolved IP address (when error is ERR_OK and B=2)
    3303   00:5204                      TCPIP_DNS_S:
    3304   00:5204                          ;--- Is there a result?
    3305   00:5204  CD 61 64                call    GETDNSREADY             ; DNS done?
    3306   00:5207  B7                      or  a
    3307   00:5208  28 23                   jr  z,TCPIP_DNS_S_NORESULT      ; No DNS result
    3308   00:520A                          ;--- Ok, we have a result, is it success?
    3309   00:520A  3D                      dec a
    3310   00:520B  28 12                   jr  z,TCPIP_DNS_S_HASRESULT     ; If it is 1, it was not an error
    3311   00:520D                          ;--- Shoot, there is an error...
    3312   00:520D                          ;--- And sure thing, ESP do not tell us details, it is always failure :-P
    3313   00:520D  CB 40                   bit 0,b                         ;--- clear error after this?
    3314   00:520F  28 09                   jr  z,TCP_IP_DNS_S_NOCLR
    3315   00:5211                          ;--- Clear
    3316   00:5211  06 00                   ld b,0                          ;--- Like I've said, no details
    3317   00:5213  AF                      xor a
    3318   00:5214  CD 73 64                call    SETDNSREADY             ; DNS not done
    3319   00:5217  3E 08                   ld  a,ERR_DNS;
    3320   00:5219  C9                      ret
    3321   00:521A                      TCP_IP_DNS_S_NOCLR:
    3322   00:521A                          ;--- Don't clear
    3323   00:521A  3E 08                   ld  a,ERR_DNS
    3324   00:521C  06 00                   ld  b,0                         ;--- Like I've said, no details
    3325   00:521E  C9                      ret
    3326   00:521F                          ;--- There is a result available...
    3327   00:521F                      TCPIP_DNS_S_HASRESULT:
    3328   00:521F                          ;--- Copy the result
    3329   00:521F  CD 87 64                call    GETDNSRESULT
    3330   00:5222  AF                      xor a
    3331   00:5223  CB 40                   bit 0,b                         ;--- clear result after this?
    3332   00:5225  28 03                   jr  z,TCP_IP_DNS_S_RES_NOCLR    ;--- no, just return
    3333   00:5227                          ;--- Yes, clear
    3334   00:5227  CD 73 64                call    SETDNSREADY             ; DNS not done
    3335   00:522A                      TCP_IP_DNS_S_RES_NOCLR:
    3336   00:522A  06 02                   ld  b,2
    3337   00:522C  C9                      ret
    3338   00:522D                      
    3339   00:522D                      TCPIP_DNS_S_NORESULT:
    3340   00:522D  AF                      xor a                           ;--- OK no query in progress, no result, means nothing in progress
    3341   00:522E  06 00                   ld  b,0                         ;--- No query in progress
    3342   00:5230  C9                      ret
    3343   00:5231                      
    3344   00:5231                      ;========================
    3345   00:5231                      ;===  TCPIP_UDP_OPEN  ===
    3346   00:5231                      ;========================
    3347   00:5231                      ;Open an UDP connection.
    3348   00:5231                      ;
    3349   00:5231                      ;Input:  A  = 8
    3350   00:5231                      ;        HL = Local port number (#FFFF=random)
    3351   00:5231                      ;        B  = Intended connection lifetime:
    3352   00:5231                      ;             0: Transient
    3353   00:5231                      ;             1: Resident
    3354   00:5231                      ;Output: A = Error code
    3355   00:5231                      ;        B = Connection number
    3356   00:5231                      TCPIP_UDP_OPEN:
    3357   00:5231                          SEND_DATA                       ; Send the command
    3357   00:5231  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3358   00:5234  AF                      xor a
    3359   00:5235                          SEND_DATA                       ; Send the command size msb
    3359   00:5235  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3360   00:5238  3E 03                   ld  a,3
    3361   00:523A                          SEND_DATA                       ; Send the command size lsb
    3361   00:523A  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3362   00:523D  7D                      ld  a,l
    3363   00:523E                          SEND_DATA                       ; Send the port LSB
    3363   00:523E  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3364   00:5241  7C                      ld  a,h
    3365   00:5242                          SEND_DATA                       ; Send the port MSB
    3365   00:5242  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3366   00:5245  78                      ld  a,b
    3367   00:5246                          SEND_DATA                       ; Send the connection transient/resident
    3367   00:5246  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3368   00:5249                      
    3369   00:5249                          ; Now wait up to 180 ticks to get response
    3370   00:5249  21 B4 00                ld  hl,180
    3371   00:524C  CD 61 63                call    SETCOUNTER
    3372   00:524F                      TCPIP_UDP_OPEN_ST1:
    3373   00:524F                          CHECK_DATA
    3373   00:524F  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3373   00:5252  CB 47             >     bit 0,a
    3374   00:5254  20 05                   jr  nz,TCPIP_UDP_OPEN_ST1.1
    3375   00:5256  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3376   00:5259  18 F4                   jr  TCPIP_UDP_OPEN_ST1
    3377   00:525B                      TCPIP_UDP_OPEN_ST1.1:
    3378   00:525B                          ; nz, check the data
    3379   00:525B                          RECEIVE_DATA
    3379   00:525B  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3380   00:525E  FE 08                   cp  8                           ; Is response of our command?
    3381   00:5260  20 ED                   jr  nz,TCPIP_UDP_OPEN_ST1
    3382   00:5262                          ; now get return code, if return code other than 0, it is finished
    3383   00:5262                      TCPIP_UDP_OPEN_RC:
    3384   00:5262                          CHECK_DATA
    3384   00:5262  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3384   00:5265  CB 47             >     bit 0,a
    3385   00:5267  20 05                   jr  nz,TCPIP_UDP_OPEN_RC.1
    3386   00:5269  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3387   00:526C  18 F4                   jr  TCPIP_UDP_OPEN_RC
    3388   00:526E                      TCPIP_UDP_OPEN_RC.1:
    3389   00:526E                          ; nz, discard
    3390   00:526E                          RECEIVE_DATA
    3390   00:526E  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3391   00:5271  B7                      or  a                           ; 0?
    3392   00:5272  C0                      ret nz                          ; if not, done
    3393   00:5273                      
    3394   00:5273                          ; next two bytes are return code and size bytes, don't care, it is 1, conn #
    3395   00:5273  06 02                   ld  b,2
    3396   00:5275                      TCPIP_UDP_OPEN_ST2:
    3397   00:5275                          CHECK_DATA
    3397   00:5275  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3397   00:5278  CB 47             >     bit 0,a
    3398   00:527A  20 05                   jr  nz,TCPIP_UDP_OPEN_ST2.1
    3399   00:527C  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3400   00:527F  18 F4                   jr  TCPIP_UDP_OPEN_ST2
    3401   00:5281                      TCPIP_UDP_OPEN_ST2.1:
    3402   00:5281                          ; nz, discard
    3403   00:5281                          RECEIVE_DATA
    3403   00:5281  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3404   00:5284  05                      dec b
    3405   00:5285  20 EE                   jr  nz,TCPIP_UDP_OPEN_ST2
    3406   00:5287                      
    3407   00:5287                          ; now just get the 1 byte, conn#, should go to B
    3408   00:5287                      TCPIP_UDP_OPEN_CONN_ST1:
    3409   00:5287                          CHECK_DATA
    3409   00:5287  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3409   00:528A  CB 47             >     bit 0,a
    3410   00:528C  20 05                   jr  nz,TCPIP_UDP_OPEN_CONN_ST1.1
    3411   00:528E  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3412   00:5291  18 F4                   jr  TCPIP_UDP_OPEN_CONN_ST1
    3413   00:5293                      TCPIP_UDP_OPEN_CONN_ST1.1:
    3414   00:5293                          ; nz, get it
    3415   00:5293                          RECEIVE_DATA
    3415   00:5293  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3416   00:5296  47                      ld  b,a
    3417   00:5297                          ; done
    3418   00:5297  AF                      xor a
    3419   00:5298  C9                      ret
    3420   00:5299                      
    3421   00:5299                      ;=========================
    3422   00:5299                      ;===  TCPIP_UDP_CLOSE  ===
    3423   00:5299                      ;=========================
    3424   00:5299                      ;Close a UDP connection.
    3425   00:5299                      ;
    3426   00:5299                      ;Input:  A = 9
    3427   00:5299                      ;        B = Connection number
    3428   00:5299                      ;            0 to close all open transient UDP connections
    3429   00:5299                      ;Output: A = Error code
    3430   00:5299                      TCPIP_UDP_CLOSE:
    3431   00:5299                          SEND_DATA                       ; Send the command
    3431   00:5299  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3432   00:529C  AF                      xor a
    3433   00:529D                          SEND_DATA                       ; Send the command size msb
    3433   00:529D  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3434   00:52A0  3E 01                   ld  a,1
    3435   00:52A2                          SEND_DATA                       ; Send the command size lsb
    3435   00:52A2  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3436   00:52A5  78                      ld  a,b
    3437   00:52A6                          SEND_DATA                       ; Send the connection #
    3437   00:52A6  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3438   00:52A9                          ; Now wait up to 180 ticks to get response
    3439   00:52A9  21 B4 00                ld  hl,180
    3440   00:52AC  CD 61 63                call    SETCOUNTER
    3441   00:52AF                      TCPIP_UDP_CLOSE_ST1:
    3442   00:52AF                          CHECK_DATA
    3442   00:52AF  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3442   00:52B2  CB 47             >     bit 0,a
    3443   00:52B4  20 05                   jr  nz,TCPIP_UDP_CLOSE_ST1.1
    3444   00:52B6  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3445   00:52B9  18 F4                   jr  TCPIP_UDP_CLOSE_ST1
    3446   00:52BB                      TCPIP_UDP_CLOSE_ST1.1:
    3447   00:52BB                          ; nz, check the data
    3448   00:52BB                          RECEIVE_DATA
    3448   00:52BB  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3449   00:52BE  FE 09                   cp  9                           ; Is response of our command?
    3450   00:52C0  20 ED                   jr  nz,TCPIP_UDP_CLOSE_ST1
    3451   00:52C2                          ; now get return code, if return code other than 0, it is finished
    3452   00:52C2                      TCPIP_UDP_CLOSE_RC:
    3453   00:52C2                          CHECK_DATA
    3453   00:52C2  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3453   00:52C5  CB 47             >     bit 0,a
    3454   00:52C7  20 05                   jr  nz,TCPIP_UDP_CLOSE_RC.1
    3455   00:52C9  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3456   00:52CC  18 F4                   jr  TCPIP_UDP_CLOSE_RC
    3457   00:52CE                      TCPIP_UDP_CLOSE_RC.1:
    3458   00:52CE                          ; nz, discard
    3459   00:52CE                          RECEIVE_DATA
    3459   00:52CE  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3460   00:52D1  B7                      or  a                           ; 0?
    3461   00:52D2  C0                      ret nz                          ; if not, done
    3462   00:52D3                      
    3463   00:52D3                          ; next two bytes are return code and size bytes, don't care, it is 1, conn #
    3464   00:52D3  06 02                   ld  b,2
    3465   00:52D5                      TCPIP_UDP_CLOSE_ST2:
    3466   00:52D5                          CHECK_DATA
    3466   00:52D5  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3466   00:52D8  CB 47             >     bit 0,a
    3467   00:52DA  20 05                   jr  nz,TCPIP_UDP_CLOSE_ST2.1
    3468   00:52DC  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3469   00:52DF  18 F4                   jr  TCPIP_UDP_CLOSE_ST2
    3470   00:52E1                      TCPIP_UDP_CLOSE_ST2.1:
    3471   00:52E1                          ; nz, discard
    3472   00:52E1                          RECEIVE_DATA
    3472   00:52E1  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3473   00:52E4  05                      dec b
    3474   00:52E5  20 EE                   jr  nz,TCPIP_UDP_CLOSE_ST2
    3475   00:52E7                      
    3476   00:52E7                          ; done, no return data other than return code
    3477   00:52E7  AF                      xor a
    3478   00:52E8  C9                      ret
    3479   00:52E9                      
    3480   00:52E9                      ;=========================
    3481   00:52E9                      ;===  TCPIP_UDP_STATE  ===
    3482   00:52E9                      ;=========================
    3483   00:52E9                      ;Get the state of a UDP connection.
    3484   00:52E9                      ;
    3485   00:52E9                      ;Input:  A = 10
    3486   00:52E9                      ;        B = Connection number
    3487   00:52E9                      ;Output: A  = Error code
    3488   00:52E9                      ;        HL = Local port number
    3489   00:52E9                      ;        B  = Number of pending incoming datagrams
    3490   00:52E9                      ;        DE = Size of oldest pending incoming datagram (data part only)
    3491   00:52E9                      TCPIP_UDP_STATE:
    3492   00:52E9                          SEND_DATA                       ; Send the command
    3492   00:52E9  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3493   00:52EC  AF                      xor a
    3494   00:52ED                          SEND_DATA                       ; Send the command size msb
    3494   00:52ED  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3495   00:52F0  3C                      inc a
    3496   00:52F1                          SEND_DATA                       ; Send the command size lsb
    3496   00:52F1  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3497   00:52F4  78                      ld  a,b
    3498   00:52F5                          SEND_DATA                       ; Send the parameter
    3498   00:52F5  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3499   00:52F8                      
    3500   00:52F8                          ; Now wait up to 60 ticks to get response
    3501   00:52F8  21 3C 00                ld  hl,60
    3502   00:52FB  CD 61 63                call    SETCOUNTER
    3503   00:52FE                      TCPIP_UDP_STATE_ST1:
    3504   00:52FE                          CHECK_DATA
    3504   00:52FE  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3504   00:5301  CB 47             >     bit 0,a
    3505   00:5303  20 05                   jr  nz,TCPIP_UDP_STATE_ST1.1
    3506   00:5305  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3507   00:5308  18 F4                   jr  TCPIP_UDP_STATE_ST1
    3508   00:530A                      TCPIP_UDP_STATE_ST1.1:
    3509   00:530A                          ; nz, check the data
    3510   00:530A                          RECEIVE_DATA
    3510   00:530A  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3511   00:530D  FE 0A                   cp  10                          ; Is response of our command?
    3512   00:530F  20 ED                   jr  nz,TCPIP_UDP_STATE_ST1
    3513   00:5311                          ; now get return code, if return code other than 0, it is finished
    3514   00:5311                      TCPIP_UDP_STATE_RC:
    3515   00:5311                          CHECK_DATA
    3515   00:5311  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3515   00:5314  CB 47             >     bit 0,a
    3516   00:5316  20 05                   jr  nz,TCPIP_UDP_STATE_RC.1
    3517   00:5318  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3518   00:531B  18 F4                   jr  TCPIP_UDP_STATE_RC
    3519   00:531D                      TCPIP_UDP_STATE_RC.1:
    3520   00:531D                          ; nz, discard
    3521   00:531D                          RECEIVE_DATA
    3521   00:531D  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3522   00:5320  B7                      or  a                           ; 0?
    3523   00:5321  C0                      ret nz                          ; if not, done
    3524   00:5322                      
    3525   00:5322                          ; next two bytes are return code and size bytes, don't care, it is 5
    3526   00:5322  06 02                   ld  b,2
    3527   00:5324                      TCPIP_UDP_STATE_ST2:
    3528   00:5324                          CHECK_DATA
    3528   00:5324  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3528   00:5327  CB 47             >     bit 0,a
    3529   00:5329  20 05                   jr  nz,TCPIP_UDP_STATE_ST2.1
    3530   00:532B  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3531   00:532E  18 F4                   jr  TCPIP_UDP_STATE_ST2
    3532   00:5330                      TCPIP_UDP_STATE_ST2.1:
    3533   00:5330                          ; nz, discard
    3534   00:5330                          RECEIVE_DATA
    3534   00:5330  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3535   00:5333  05                      dec b
    3536   00:5334  20 EE                   jr  nz,TCPIP_UDP_STATE_ST2
    3537   00:5336                      
    3538   00:5336                          ; now just get the 5 bytes (Port LSB then MSB, # of packets, packet size LSB then MSB) and order it in L, H, B, E and D
    3539   00:5336                      TCPIP_UDP_STATE_RESP_ST1:
    3540   00:5336                          CHECK_DATA
    3540   00:5336  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3540   00:5339  CB 47             >     bit 0,a
    3541   00:533B  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST1.1
    3542   00:533D  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3543   00:5340  18 F4                   jr  TCPIP_UDP_STATE_RESP_ST1
    3544   00:5342                      TCPIP_UDP_STATE_RESP_ST1.1:
    3545   00:5342                          ; nz, get it
    3546   00:5342                          RECEIVE_DATA
    3546   00:5342  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3547   00:5345  6F                      ld  l,a
    3548   00:5346                      TCPIP_UDP_STATE_RESP_ST2:
    3549   00:5346                          CHECK_DATA
    3549   00:5346  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3549   00:5349  CB 47             >     bit 0,a
    3550   00:534B  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST2.1
    3551   00:534D  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3552   00:5350  18 F4                   jr  TCPIP_UDP_STATE_RESP_ST2
    3553   00:5352                      TCPIP_UDP_STATE_RESP_ST2.1:
    3554   00:5352                          ; nz, get it
    3555   00:5352                          RECEIVE_DATA
    3555   00:5352  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3556   00:5355  67                      ld  h,a
    3557   00:5356                      TCPIP_UDP_STATE_RESP_ST3:
    3558   00:5356                          CHECK_DATA
    3558   00:5356  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3558   00:5359  CB 47             >     bit 0,a
    3559   00:535B  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST3.1
    3560   00:535D  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3561   00:5360  18 F4                   jr  TCPIP_UDP_STATE_RESP_ST3
    3562   00:5362                      TCPIP_UDP_STATE_RESP_ST3.1:
    3563   00:5362                          ; nz, get it
    3564   00:5362                          RECEIVE_DATA
    3564   00:5362  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3565   00:5365  47                      ld  b,a
    3566   00:5366                      TCPIP_UDP_STATE_RESP_ST4:
    3567   00:5366                          CHECK_DATA
    3567   00:5366  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3567   00:5369  CB 47             >     bit 0,a
    3568   00:536B  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST4.1
    3569   00:536D  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3570   00:5370  18 F4                   jr  TCPIP_UDP_STATE_RESP_ST4
    3571   00:5372                      TCPIP_UDP_STATE_RESP_ST4.1:
    3572   00:5372                          ; nz, get it
    3573   00:5372                          RECEIVE_DATA
    3573   00:5372  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3574   00:5375  5F                      ld  e,a
    3575   00:5376                      TCPIP_UDP_STATE_RESP_ST5:
    3576   00:5376                          CHECK_DATA
    3576   00:5376  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3576   00:5379  CB 47             >     bit 0,a
    3577   00:537B  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST5.1
    3578   00:537D  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3579   00:5380  18 F4                   jr  TCPIP_UDP_STATE_RESP_ST5
    3580   00:5382                      TCPIP_UDP_STATE_RESP_ST5.1:
    3581   00:5382                          ; nz, get it
    3582   00:5382                          RECEIVE_DATA
    3582   00:5382  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3583   00:5385  57                      ld  d,a
    3584   00:5386                          ; done
    3585   00:5386  AF                      xor a
    3586   00:5387  C9                      ret
    3587   00:5388                      
    3588   00:5388                      ;========================
    3589   00:5388                      ;===  TCPIP_UDP_SEND  ===
    3590   00:5388                      ;========================
    3591   00:5388                      ;Send an UDP datagram.
    3592   00:5388                      ;
    3593   00:5388                      ;Input:  A = 11
    3594   00:5388                      ;        B = Connection number
    3595   00:5388                      ;        HL = Address of datagram data
    3596   00:5388                      ;        DE = Address of parameters block
    3597   00:5388                      ;Output: A = Error code
    3598   00:5388                      ;
    3599   00:5388                      ;Parameters block:
    3600   00:5388                      ;
    3601   00:5388                      ;    +0 (4): Destination IP address
    3602   00:5388                      ;    +4 (2): Destination port
    3603   00:5388                      ;    +6 (2): Data length
    3604   00:5388                      TCPIP_UDP_SEND:
    3605   00:5388  E5                      push    hl
    3606   00:5389  D5                      push    de
    3607   00:538A                          SEND_DATA                       ; Send the command
    3607   00:538A  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3608   00:538D                          ; prepare new data size, adding our 7 bytes overhead
    3609   00:538D  DD 62                   ld  ixh,d
    3610   00:538F  DD 6B                   ld  ixl,e
    3611   00:5391  11 07 00                ld  de,7
    3612   00:5394  DD 6E 06                ld  l,(ix+6)
    3613   00:5397  DD 66 07                ld  h,(ix+7)
    3614   00:539A  19                      add hl,de
    3615   00:539B  7C                      ld  a,h
    3616   00:539C                          SEND_DATA                       ; Send the command size msb
    3616   00:539C  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3617   00:539F  7D                      ld  a,l
    3618   00:53A0                          SEND_DATA                       ; Send the command size lsb
    3618   00:53A0  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3619   00:53A3  78                      ld  a,b
    3620   00:53A4                          SEND_DATA                       ; Send the connection #
    3620   00:53A4  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3621   00:53A7  D1                      pop de
    3622   00:53A8  E1                      pop hl
    3623   00:53A9  1A                      ld  a,(de)
    3624   00:53AA                          SEND_DATA                       ; Send IP byte 1
    3624   00:53AA  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3625   00:53AD  13                      inc de
    3626   00:53AE  1A                      ld  a,(de)
    3627   00:53AF                          SEND_DATA                       ; Send IP byte 2
    3627   00:53AF  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3628   00:53B2  13                      inc de
    3629   00:53B3  1A                      ld  a,(de)
    3630   00:53B4                          SEND_DATA                       ; Send IP byte 3
    3630   00:53B4  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3631   00:53B7  13                      inc de
    3632   00:53B8  1A                      ld  a,(de)
    3633   00:53B9                          SEND_DATA                       ; Send IP byte 4
    3633   00:53B9  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3634   00:53BC  13                      inc de
    3635   00:53BD  1A                      ld  a,(de)
    3636   00:53BE                          SEND_DATA                       ; Send Port LSB
    3636   00:53BE  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3637   00:53C1  13                      inc de
    3638   00:53C2  1A                      ld  a,(de)
    3639   00:53C3                          SEND_DATA                       ; Send Port MSB
    3639   00:53C3  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3640   00:53C6                          ; now oti the data starting at hl, size is in next DE position
    3641   00:53C6  13                      inc de
    3642   00:53C7  1A                      ld  a,(de)
    3643   00:53C8  47                      ld  b,a                         ; save lsb in b
    3644   00:53C9  13                      inc de
    3645   00:53CA  1A                      ld  a,(de)                      ; msb
    3646   00:53CB  57                      ld  d,a                         ; put in D, there is no ld d,(de)
    3647   00:53CC  58                      ld  e,b                         ; lsb
    3648   00:53CD                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    3649   00:53CD                          ;ld b,e                         ; Number of loops originaly in DE, not needed, b already has e
    3650   00:53CD  1B                      dec de
    3651   00:53CE  14                      inc d
    3652   00:53CF                          if USE_MEM_IO = 0
    3653   00:53CF                    ~     ld  c,OUT_TX_PORT
    3654   00:53CF                    ~ TCPIP_UDP_SEND_R:
    3655   00:53CF                    ~     otir                            ; Send until B is 0
    3656   00:53CF                    ~     else
    3657   00:53CF                      TCPIP_UDP_SEND_R:
    3658   00:53CF  7E                      ld  a,(hl)
    3659   00:53D0  32 07 7F                ld  (MEM_OUT_TX_PORT),a
    3660   00:53D3  23                      inc hl
    3661   00:53D4  10 F9                   djnz TCPIP_UDP_SEND_R
    3662   00:53D6                          endif
    3663   00:53D6  15                      dec d                           ; decrement secondary counter
    3664   00:53D7  20 F6                   jr  nz,TCPIP_UDP_SEND_R         ; If still have another round, do it
    3665   00:53D9                          ; Now wait up to 600 ticks to get response
    3666   00:53D9  21 58 02                ld  hl,600
    3667   00:53DC  CD 61 63                call    SETCOUNTER
    3668   00:53DF                      TCPIP_UDP_SEND_ST1:
    3669   00:53DF                          CHECK_DATA
    3669   00:53DF  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3669   00:53E2  CB 47             >     bit 0,a
    3670   00:53E4  20 05                   jr  nz,TCPIP_UDP_SEND_ST1.1
    3671   00:53E6  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3672   00:53E9  18 F4                   jr  TCPIP_UDP_SEND_ST1
    3673   00:53EB                      TCPIP_UDP_SEND_ST1.1:
    3674   00:53EB                          ; nz, check the data
    3675   00:53EB                          RECEIVE_DATA
    3675   00:53EB  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3676   00:53EE  FE 0B                   cp  11                          ; Is response of our command?
    3677   00:53F0  20 ED                   jr  nz,TCPIP_UDP_SEND_ST1
    3678   00:53F2                          ; now get return code, if return code other than 0, it is finished
    3679   00:53F2                      TCPIP_UDP_SEND_RC:
    3680   00:53F2                          CHECK_DATA
    3680   00:53F2  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3680   00:53F5  CB 47             >     bit 0,a
    3681   00:53F7  20 05                   jr  nz,TCPIP_UDP_SEND_RC.1
    3682   00:53F9  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3683   00:53FC  18 F4                   jr  TCPIP_UDP_SEND_RC
    3684   00:53FE                      TCPIP_UDP_SEND_RC.1:
    3685   00:53FE                          ; nz, discard
    3686   00:53FE                          RECEIVE_DATA
    3686   00:53FE  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3687   00:5401  B7                      or  a                           ; 0?
    3688   00:5402  C0                      ret nz                          ; if not, done
    3689   00:5403                      
    3690   00:5403                          ; next two bytes are return code and size bytes, don't care, it is 0
    3691   00:5403  06 02                   ld  b,2
    3692   00:5405                      TCPIP_UDP_SEND_ST2:
    3693   00:5405                          CHECK_DATA
    3693   00:5405  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3693   00:5408  CB 47             >     bit 0,a
    3694   00:540A  20 05                   jr  nz,TCPIP_UDP_SEND_ST2.1
    3695   00:540C  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3696   00:540F  18 F4                   jr  TCPIP_UDP_SEND_ST2
    3697   00:5411                      TCPIP_UDP_SEND_ST2.1:
    3698   00:5411                          ; nz, discard
    3699   00:5411                          RECEIVE_DATA
    3699   00:5411  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3700   00:5414  05                      dec b
    3701   00:5415  20 EE                   jr  nz,TCPIP_UDP_SEND_ST2
    3702   00:5417                      
    3703   00:5417                          ; done, no return data other than return code
    3704   00:5417  AF                      xor a
    3705   00:5418  C9                      ret
    3706   00:5419                      
    3707   00:5419                      ;=======================
    3708   00:5419                      ;===  TCPIP_UDP_RCV  ===
    3709   00:5419                      ;=======================
    3710   00:5419                      ;Retrieve an incoming UDP datagram.
    3711   00:5419                      ;
    3712   00:5419                      ;Input:  A = 12
    3713   00:5419                      ;        B = Connection number
    3714   00:5419                      ;        HL = Address for datagram data
    3715   00:5419                      ;        DE = Maximum data size to retrieve
    3716   00:5419                      ;Output: A = Error code
    3717   00:5419                      ;        L.H.E.D = Source IP address
    3718   00:5419                      ;        IX = Source port
    3719   00:5419                      ;        BC = Actual received data size
    3720   00:5419                      
    3721   00:5419                      ; Customized TIME OUT routine: If time out receiving data, retry as received data
    3722   00:5419                      ; won't be re-sent as host is unaware of this
    3723   00:5419                      TCPIP_UDP_RCV_CHECK_TIME_OUT:
    3724   00:5419                          ; Save registers other than AF
    3725   00:5419  C5                      push bc
    3726   00:541A  D5                      push de
    3727   00:541B  E5                      push hl
    3728   00:541C  CD 52 63                call    GETCOUNTER
    3729   00:541F  7D                      ld  a,l
    3730   00:5420  B4                      or  h
    3731   00:5421                          ; Restore registers, we are returning
    3732   00:5421  E1                      pop hl
    3733   00:5422  D1                      pop de
    3734   00:5423  C1                      pop bc
    3735   00:5424  C0                      ret nz
    3736   00:5425                          ; Ok, timeout...
    3737   00:5425  F1                      pop af                          ; Get return address of who called this out of the stack, we will return from the function or re-start
    3738   00:5426                      TCPIP_TCP_UDP_RETRY_QRCV:
    3739   00:5426  CD 71 63                call    GETBYTE
    3740   00:5429  B7                      or  a
    3741   00:542A  28 0C                   jr  z,TCPIP_UDP_RCV_CHECK_TIME_OUT.NORXRETRY
    3742   00:542C                          ; Ok, so let's ask ESP to re-send the data and retry receiving it
    3743   00:542C  3D                      dec a
    3744   00:542D  CD 83 63                call    SETBYTE                 ; we are retrying it
    3745   00:5430  3E 72                   ld  a,'r'                       ; retry transmission command
    3746   00:5432                          SEND_DATA
    3746   00:5432  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3747   00:5435  C3 5D 54                jp  TCPIP_UDP_RCV.RXRETRY       ; and retry it
    3748   00:5438                      TCPIP_UDP_RCV_CHECK_TIME_OUT.NORXRETRY:
    3749   00:5438  3E 0F                   ld  a,ERR_INV_OPER
    3750   00:543A  C9                      ret                             ; and return the function itself
    3751   00:543B                      
    3752   00:543B                      TCPIP_UDP_RCV:
    3753   00:543B  CD AA 63                call    SETWORD                 ; Save for later the datagram address
    3754   00:543E  3E 0C                   ld  a,12
    3755   00:5440                          SEND_DATA                       ; Send the command
    3755   00:5440  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3756   00:5443  AF                      xor a
    3757   00:5444                          SEND_DATA                       ; Send the command size msb
    3757   00:5444  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3758   00:5447  3E 03                   ld  a,3
    3759   00:5449                          SEND_DATA                       ; Send the command size lsb
    3759   00:5449  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3760   00:544C  78                      ld  a,b
    3761   00:544D                          SEND_DATA                       ; Send the connection #
    3761   00:544D  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3762   00:5450  7B                      ld  a,e
    3763   00:5451                          SEND_DATA                       ; Send MAX rcv size LSB
    3763   00:5451  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3764   00:5454  7A                      ld  a,d
    3765   00:5455                          SEND_DATA                       ; Send MAX rcv size MSB
    3765   00:5455  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3766   00:5458  3E 03                   ld  a,3
    3767   00:545A  CD 83 63                call    SETBYTE                 ; Ok, retry up to three times
    3768   00:545D                      TCPIP_UDP_RCV.RXRETRY:
    3769   00:545D                          ; Now wait up to 600 ticks to get response
    3770   00:545D  21 58 02                ld  hl,600
    3771   00:5460  CD 61 63                call    SETCOUNTER
    3772   00:5463                      TCPIP_UDP_RCV_ST1:
    3773   00:5463                          CHECK_DATA
    3773   00:5463  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3773   00:5466  CB 47             >     bit 0,a
    3774   00:5468  20 05                   jr  nz,TCPIP_UDP_RCV_ST1.1
    3775   00:546A  CD 19 54                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3776   00:546D  18 F4                   jr  TCPIP_UDP_RCV_ST1
    3777   00:546F                      TCPIP_UDP_RCV_ST1.1:
    3778   00:546F                          ; nz, check the data
    3779   00:546F                          RECEIVE_DATA
    3779   00:546F  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3780   00:5472  FE 0C                   cp  12                          ; Is response of our command?
    3781   00:5474  20 ED                   jr  nz,TCPIP_UDP_RCV_ST1
    3782   00:5476                          ; At this point, all data is being buffered, so 30 ticks, half second, is more than enough time-out
    3783   00:5476  F3                      di
    3784   00:5477  21 1E 00                ld  hl,30
    3785   00:547A  CD 61 63                call    SETCOUNTER
    3786   00:547D  FB                      ei
    3787   00:547E                          ; now get return code, if return code other than 0, it is finished
    3788   00:547E                      TCPIP_UDP_RCV_RC:
    3789   00:547E                          CHECK_DATA
    3789   00:547E  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3789   00:5481  CB 47             >     bit 0,a
    3790   00:5483  20 05                   jr  nz,TCPIP_UDP_RCV_RC.1
    3791   00:5485  CD 19 54                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3792   00:5488  18 F4                   jr  TCPIP_UDP_RCV_RC
    3793   00:548A                      TCPIP_UDP_RCV_RC.1:
    3794   00:548A                          ; nz, discard
    3795   00:548A                          RECEIVE_DATA
    3795   00:548A  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3796   00:548D  B7                      or  a                           ; 0?
    3797   00:548E  C0                      ret nz                          ; if not, done
    3798   00:548F                          ; next two bytes are return code and size bytes, save it to BC
    3799   00:548F                      TCPIP_UDP_RCV_ST2A:
    3800   00:548F                          CHECK_DATA
    3800   00:548F  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3800   00:5492  CB 47             >     bit 0,a
