    7162   00:64C0                      ;*********************************************
    7163   00:64C0                      ;***       WAIT_RESPONSE_FROM_ESP          ***
    7164   00:64C0                      ;*** Will wait ESP to send a response,     ***
    7165   00:64C0                      ;*** discarding all data until it is found.***
    7166   00:64C0                      ;***                                       ***
    7167   00:64C0                      ;*** Inputs:                               ***
    7168   00:64C0                      ;*** HL - Expected response string         ***
    7169   00:64C0                      ;*** A - Response Size                     ***
    7170   00:64C0                      ;*** DE - TimeOut in ticks                 ***
    7171   00:64C0                      ;***                                       ***
    7172   00:64C0                      ;*** Output:                               ***
    7173   00:64C0                      ;*** A - 0 if response received            ***
    7174   00:64C0                      ;*** otherwise response not received and   ***
    7175   00:64C0                      ;*** timed-out.                            ***
    7176   00:64C0                      ;***                                       ***
    7177   00:64C0                      ;*** Changes HL, BC, AF, DE, IX            ***
    7178   00:64C0                      ;*********************************************
    7179   00:64C0                      WRFE_WAIT_DATA:
    7180   00:64C0                          LOAD_STS_PORT_IN_A
    7180   00:64C0  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    7181   00:64C3  CB 6F                   bit 5,a                         ; If nz Port #07 is not available
    7182   00:64C5  20 06                   jr  nz,WRFE_STS_NOT_AVAILABLE
    7183   00:64C7  CB 47                   bit 0,a                         ; if nz has data
    7184   00:64C9  C0                      ret nz
    7185   00:64CA  1B                      dec de
    7186   00:64CB  76                      halt
    7187   00:64CC  C9                      ret
    7188   00:64CD                      WRFE_STS_NOT_AVAILABLE:
    7189   00:64CD  11 00 00                ld  de,0
    7190   00:64D0  AF                      xor a
    7191   00:64D1  C9                      ret
    7192   00:64D2                      
    7193   00:64D2                      WRFE_COMPARE:
    7194   00:64D2  47                      ld  b,a
    7195   00:64D3  7E                      ld  a,(hl)
    7196   00:64D4  B8                      cp  b
    7197   00:64D5  C0                      ret nz
    7198   00:64D6  23                      inc hl
    7199   00:64D7  C9                      ret
    7200   00:64D8                      
    7201   00:64D8                      WAIT_RESPONSE_FROM_ESP:
    7202   00:64D8  4F                      ld  c,a                         ; Response size in C
    7203   00:64D9  E5                      push    hl                      ; Save HL
    7204   00:64DA  AF                      xor a
    7205   00:64DB                      WRFE_ST1:
    7206   00:64DB  DD 67                   ld  ixh,a                       ; We start at index 0
    7207   00:64DD                      
    7208   00:64DD                      WRFE_LOOP:
    7209   00:64DD  CD C0 64                call    WRFE_WAIT_DATA
    7210   00:64E0  20 07                   jr  nz,WRFE_LOOP.1
    7211   00:64E2  7B                      ld  a,e
    7212   00:64E3  B2                      or  d
    7213   00:64E4  CA 04 65                jp  z,WRFE_RET_ERROR
    7214   00:64E7  18 F4                   jr  WRFE_LOOP
    7215   00:64E9                      WRFE_LOOP.1:
    7216   00:64E9                          ; nz, check the data
    7217   00:64E9                          RECEIVE_DATA
    7217   00:64E9  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    7218   00:64EC                          ; Ok, now the byte is in A, let's compare
    7219   00:64EC                      WRFE_IDXCMD:
    7220   00:64EC  CD D2 64                call WRFE_COMPARE
    7221   00:64EF                          ; if match
    7222   00:64EF  28 07                   jr  z,WRFE_RSP_MATCH
    7223   00:64F1                          ; did not match, let's zero the rsp index
    7224   00:64F1  AF                      xor a
    7225   00:64F2  DD 67                   ld  ixh,a                       ; re-start at index 0
    7226   00:64F4  E1                      pop hl                          ; restore the response index
    7227   00:64F5  E5                      push    hl                      ; and keep it in stack
    7228   00:64F6                          ; back to get another byte
    7229   00:64F6  18 E5                   jr  WRFE_LOOP
    7230   00:64F8                      WRFE_RSP_MATCH:
    7231   00:64F8                          ; match
    7232   00:64F8  DD 24                   inc ixh
    7233   00:64FA  DD 7C                   ld  a,ixh
    7234   00:64FC  B9                      cp  c
    7235   00:64FD                          ; if a = c done and response is success
    7236   00:64FD  28 02                   jr  z,WRFE_RET_OK
    7237   00:64FF                          ; not done, back to get more bytes
    7238   00:64FF  18 DC                   jr  WRFE_LOOP
    7239   00:6501                      WRFE_RET_OK:
    7240   00:6501  E1                      pop hl
    7241   00:6502  AF                      xor a
    7242   00:6503  C9                      ret
    7243   00:6504                      WRFE_RET_ERROR:
    7244   00:6504  E1                      pop hl
    7245   00:6505  3E 01                   ld  a,1
    7246   00:6507  C9                      ret
    7247   00:6508                      
    7248   00:6508                      ;*********************************************
    7249   00:6508                      ;***            CHECK_ESP_TYPE             ***
    7250   00:6508                      ;*** If ESP32, NZ will be set and A = 1, if***
    7251   00:6508                      ;*** not NZ will be reset and A=0          ***
    7252   00:6508                      ;*********************************************
    7253   00:6508                      CHECK_ESP_TYPE:
    7254   00:6508  E5                      push    hl
    7255   00:6509  D5                      push    de
    7256   00:650A  FD E5                   push    iy
