    2518   00:4E26                      ;========================
    2519   00:4E26                      ;===  Functions code  ===
    2520   00:4E26                      ;========================
    2521   00:4E26                      FN_NOT_IMP:
    2522   00:4E26  3E 01                   ld  a,ERR_NOT_IMP
    2523   00:4E28  C9                      ret
    2524   00:4E29                      
    2525   00:4E29                      END_OK:
    2526   00:4E29  AF                      xor a
    2527   00:4E2A  C9                      ret
    2528   00:4E2B                      
    2529   00:4E2B                      ; Most functions do not have special handling on time out and can use this.
    2530   00:4E2B                      ; If there is a need to retry sending or receiving on time-out, then a custom
    2531   00:4E2B                      ; time-out function must be done, check the examples of UDP and TCP receive
    2532   00:4E2B                      TCPIP_GENERIC_CHECK_TIME_OUT:
    2533   00:4E2B                          ; Save registers other than AF
    2534   00:4E2B  C5                      push bc
    2535   00:4E2C  D5                      push de
    2536   00:4E2D  E5                      push hl
    2537   00:4E2E  CD 52 63                call    GETCOUNTER
    2538   00:4E31  7D                      ld  a,l
    2539   00:4E32  B4                      or  h
    2540   00:4E33                          ; Restore registers, we are returning
    2541   00:4E33  E1                      pop hl
    2542   00:4E34  D1                      pop de
    2543   00:4E35  C1                      pop bc
    2544   00:4E36  C0                      ret nz
    2545   00:4E37                          ; Ok, timeout...
    2546   00:4E37  F1                      pop af                          ; Get return address of who called this out of the stack
    2547   00:4E38  3E 0F                   ld  a,ERR_INV_OPER
    2548   00:4E3A  C9                      ret                             ; and return the function itself
    2549   00:4E3B                      
    2550   00:4E3B                      ;========================
    2551   00:4E3B                      ;===  UNAPI_GET_INFO  ===
    2552   00:4E3B                      ;========================
    2553   00:4E3B                      ; Obtain the implementation name and version for TCP/IP.
    2554   00:4E3B                      ;
    2555   00:4E3B                      ;    Input:  A  = 0
    2556   00:4E3B                      ;    Output: HL = Descriptive string for this implementation, on this slot, zero terminated
    2557   00:4E3B                      ;            DE = API version supported, D.E
    2558   00:4E3B                      ;            BC = This implementation version, B.C.
    2559   00:4E3B                      ;            A  = 0 and Cy = 0
    2560   00:4E3B                      UNAPI_GET_INFO:
    2561   00:4E3B  01 03 01                ld  bc,256*ROM_V_P+ROM_V_S
    2562   00:4E3E  11 02 01                ld  de,256*API_V_P+API_V_S
    2563   00:4E41  21 A6 73                ld  hl,APIINFO
    2564   00:4E44  AF                      xor a
    2565   00:4E45  C9                      ret
    2566   00:4E46                      
    2567   00:4E46                      ;========================
    2568   00:4E46                      ;===  UNAPI_GET_INFO  ===
    2569   00:4E46                      ;========================
    2570   00:4E46                      ; Obtain the implementation name and version for SSH.
    2571   00:4E46                      ;
    2572   00:4E46                      ;    Input:  A  = 0
    2573   00:4E46                      ;    Output: HL = Descriptive string for this implementation, on this slot, zero terminated
    2574   00:4E46                      ;            DE = API version supported, D.E
    2575   00:4E46                      ;            BC = This implementation version, B.C.
    2576   00:4E46                      ;            A  = 0 and Cy = 0
    2577   00:4E46                      UNAPI_GET_INFO_SSH:
    2578   00:4E46  01 03 01                ld  bc,256*ROM_V_P+ROM_V_S
    2579   00:4E49  11 02 01                ld  de,256*API_V_P+API_V_S
    2580   00:4E4C  21 B7 73                ld  hl,APIINFO_SSH
    2581   00:4E4F  AF                      xor a
    2582   00:4E50  C9                      ret
    2583   00:4E51                      
    2584   00:4E51                      ;=========================
    2585   00:4E51                      ;===   SSH_GET_CAPAB   ===
    2586   00:4E51                      ;=========================
    2587   00:4E51                      ; Get information about the SSH capabilities and features.
    2588   00:4E51                      ;
    2589   00:4E51                      ;    Input:  A = 1
    2590   00:4E51                      ;            B = Index of information block to retrieve:
    2591   00:4E51                      ;                1: Block 1 (only block supported, other blocks reserved for expansion)
    2592   00:4E51                      ;    Output: A = Error code
    2593   00:4E51                      ;        When information block 1 requested:
    2594   00:4E51                      ;            HL = Capabilities flags
    2595   00:4E51                      ;            B  = Maximum simultaneous SSH connections supported
    2596   00:4E51                      ;            C  = Free SSH connections currently available
    2597   00:4E51                      ;            DE = Maximum data per command
    2598   00:4E51                      SSH_GET_CAPAB:
    2599   00:4E51                          ; SSH functions start at 127 on ESP
    2600   00:4E51  CB FF                   set 7,a
    2601   00:4E53                          SEND_DATA                       ; Send the command
    2601   00:4E53  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2602   00:4E56  AF                      xor a
    2603   00:4E57                          SEND_DATA                       ; Send the command size msb
    2603   00:4E57  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2604   00:4E5A  3C                      inc a
    2605   00:4E5B                          SEND_DATA                       ; Send the command size lsb
    2605   00:4E5B  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2606   00:4E5E  78                      ld  a,b
    2607   00:4E5F                          SEND_DATA                       ; Send the parameter
    2607   00:4E5F  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2608   00:4E62                      
    2609   00:4E62                          ; Now wait up to 120 ticks to get response
    2610   00:4E62  21 78 00                ld  hl,120
    2611   00:4E65  CD 61 63                call    SETCOUNTER
    2612   00:4E68                      SSH_GET_CAPAB_ST1:
    2613   00:4E68                          CHECK_DATA
    2613   00:4E68  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2613   00:4E6B  CB 47             >     bit 0,a
    2614   00:4E6D  20 05                   jr  nz,SSH_GET_CAPAB_ST1.1
    2615   00:4E6F  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2616   00:4E72  18 F4                   jr  SSH_GET_CAPAB_ST1
    2617   00:4E74                      SSH_GET_CAPAB_ST1.1:
    2618   00:4E74                          ; nz, check the data
    2619   00:4E74                          RECEIVE_DATA
    2619   00:4E74  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2620   00:4E77  FE 81                   cp  #81                         ; Is response of our command?
    2621   00:4E79  20 ED                   jr  nz,SSH_GET_CAPAB_ST1
    2622   00:4E7B                          ; Now get return code, if return code other than 0, it is finished
    2623   00:4E7B                      SSH_GET_CAPAB_RC:
    2624   00:4E7B                          CHECK_DATA
    2624   00:4E7B  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2624   00:4E7E  CB 47             >     bit 0,a
    2625   00:4E80  20 05                   jr  nz,SSH_GET_CAPAB_RC.1
    2626   00:4E82  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2627   00:4E85  18 F4                   jr  SSH_GET_CAPAB_RC
    2628   00:4E87                      SSH_GET_CAPAB_RC.1:
    2629   00:4E87                          ; nz, discard
    2630   00:4E87                          RECEIVE_DATA
    2630   00:4E87  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2631   00:4E8A  B7                      or  a                           ; 0?
    2632   00:4E8B  C0                      ret nz                          ; If not, done
    2633   00:4E8C                      
    2634   00:4E8C                          ; Next two bytes are size bytes, don't care
    2635   00:4E8C  06 02                   ld  b,2
    2636   00:4E8E                      SSH_GET_CAPAB_ST2:
    2637   00:4E8E                          CHECK_DATA
    2637   00:4E8E  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2637   00:4E91  CB 47             >     bit 0,a
    2638   00:4E93  20 05                   jr  nz,SSH_GET_CAPAB_ST2.1
    2639   00:4E95  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2640   00:4E98  18 F4                   jr  SSH_GET_CAPAB_ST2
    2641   00:4E9A                      SSH_GET_CAPAB_ST2.1:
    2642   00:4E9A                          ; Nz, discard
    2643   00:4E9A                          RECEIVE_DATA
    2643   00:4E9A  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2644   00:4E9D  05                      dec b
