    6578   00:61F4                          ; HL has the address of param
    6579   00:61F4  C1                      pop bc                          ; Restore BC
    6580   00:61F5  71                      ld  (hl),c
    6581   00:61F6  23                      inc hl
    6582   00:61F7  70                      ld  (hl),b
    6583   00:61F8  E1                      pop hl                          ; Restore HL original value
    6584   00:61F9  D1                      pop de                          ; Restore DE
    6585   00:61FA  C9                      ret
    6586   00:61FB                      
    6587   00:61FB                      ;--- Restores HL copy saved in high memory
    6588   00:61FB                      ;    Input:  none
    6589   00:61FB                      ;    Output: HL
    6590   00:61FB                      ;    Modifies: AF
    6591   00:61FB                      
    6592   00:61FB                      HLRESTORE:
    6593   00:61FB  C5                      push    bc
    6594   00:61FC  D5                      push    de
    6595   00:61FD  CD 9E 60                call    GETSLT
    6596   00:6200                          ; Slot in A, now get the address of our counter
    6597   00:6200  CD 27 61                call    GETMEMPOINTER
    6598   00:6203                          ; HL has the address of our memory area, param is 7 bytes after start
    6599   00:6203  11 11 00                ld  de,MEMORY_HLBACKUP_OFFSET
    6600   00:6206  19                      add hl,de
    6601   00:6207                          ; Ok, this is where our param is so get it
    6602   00:6207  5E                      ld  e,(hl)
    6603   00:6208  23                      inc hl
    6604   00:6209  56                      ld  d,(hl)
    6605   00:620A  EB                      ex  de,hl
    6606   00:620B  D1                      pop de
    6607   00:620C  C1                      pop bc
    6608   00:620D  C9                      ret
    6609   00:620E                      
    6610   00:620E                      ;--- Backups HL in high memory
    6611   00:620E                      ;    Input:  HL
    6612   00:620E                      ;    Output: none
    6613   00:620E                      ;    Modifies: AF
    6614   00:620E                      
    6615   00:620E                      HLBACKUP:
    6616   00:620E  D5                      push    de
    6617   00:620F  C5                      push    bc
    6618   00:6210  E5                      push    hl
    6619   00:6211  CD 9E 60                call    GETSLT
    6620   00:6214                          ; Slot in A, now get the address
    6621   00:6214  CD 27 61                call    GETMEMPOINTER
    6622   00:6217                          ; HL has the address of our memory area, byte param is 7 bytes after start
    6623   00:6217  11 11 00                ld  de,MEMORY_HLBACKUP_OFFSET
    6624   00:621A  19                      add hl,de
    6625   00:621B                          ; HL has the address of param
    6626   00:621B  D1                      pop de                          ; Restore HL in de
    6627   00:621C  73                      ld  (hl),e
    6628   00:621D  23                      inc hl
    6629   00:621E  72                      ld  (hl),d
    6630   00:621F  EB                      ex  de,hl                       ; Restore HL
    6631   00:6220  C1                      pop bc                          ; Restore BC
    6632   00:6221  D1                      pop de                          ; Restore DE
    6633   00:6222  C9                      ret
    6634   00:6223                      
    6635   00:6223                      ;--- Return the saved ESP TYPE
    6636   00:6223                      ;    Input:  none
    6637   00:6223                      ;    Output: A and F will be NZ if ESP32
    6638   00:6223                      ;    Modifies: AF
    6639   00:6223                      
    6640   00:6223                      GETESPTYPE:
    6641   00:6223  D5                      push    de
    6642   00:6224  C5                      push    bc
    6643   00:6225  E5                      push    hl
    6644   00:6226  DD E5                   push    ix
    6645   00:6228  FD E5                   push    iy
    6646   00:622A  CD 9E 60                call    GETSLT
    6647   00:622D  CD 0B 61                call    GETMEMPOINTERADDR       ; This is where we are going to store our memory area address
    6648   00:6230                          ; GETSLT and GETMEMPOINTER do not change DE, so it still has the our memory area address
    6649   00:6230  11 02 00                ld  de,2
    6650   00:6233  19                      add hl,de
    6651   00:6234  7E                      ld  a,(hl)
    6652   00:6235  E6 01                   and ESPFLAG_ESP32               ; NZ only if ESP32
    6653   00:6237  FD E1                   pop iy
    6654   00:6239  DD E1                   pop ix
    6655   00:623B  E1                      pop hl
    6656   00:623C  C1                      pop bc
    6657   00:623D  D1                      pop de
    6658   00:623E  C9                      ret
    6659   00:623F                      
    6660   00:623F                      ;--- Return our ESP flags byte (work area offset 7)
    6661   00:623F                      ;    Input:  none
    6662   00:623F                      ;    Output: A = flags
    6663   00:623F                      ;    Modifies: AF
    6664   00:623F                      
    6665   00:623F                      GETESPFLAGS:
    6666   00:623F  C5                      push    bc
    6667   00:6240  D5                      push    de
    6668   00:6241  E5                      push    hl
    6669   00:6242  CD 9E 60                call    GETSLT
    6670   00:6245  CD 0B 61                call    GETMEMPOINTERADDR
    6671   00:6248  11 02 00                ld  de,2
    6672   00:624B  19                      add hl,de                       ; Our flags byte
    6673   00:624C  7E                      ld  a,(hl)
    6674   00:624D  E1                      pop hl
    6675   00:624E  D1                      pop de
    6676   00:624F  C1                      pop bc
    6677   00:6250  C9                      ret
    6678   00:6251                      
    6679   00:6251                      ;--- Obtain if DNS is ready saved in high memory
    6680   00:6251                      ;    Input:  none
    6681   00:6251                      ;    Output: A = DNS ready value
    6682   00:6251                      ;    Modifies: AF
    6683   00:6251                      
    6684   00:6251                      GETDNSREADY:
    6685   00:6251  C5                      push    bc
    6686   00:6252  D5                      push    de
    6687   00:6253  E5                      push    hl
    6688   00:6254  CD 9E 60                call    GETSLT
    6689   00:6257                          ; Slot in A, now get the address
    6690   00:6257  CD 27 61                call    GETMEMPOINTER
    6691   00:625A                          ; HL has the address of our memory area, DNS ready is 8 bytes after start
    6692   00:625A  11 08 00                ld  de,MEMORY_DNS_READY_OFFSET
    6693   00:625D  19                      add hl,de
    6694   00:625E                          ; Ok, get it
    6695   00:625E  7E                      ld  a,(hl)
    6696   00:625F  E1                      pop hl
    6697   00:6260  D1                      pop de
    6698   00:6261  C1                      pop bc
    6699   00:6262  C9                      ret
    6700   00:6263                      
    6701   00:6263                      ;--- Set DNS redy in high memory
    6702   00:6263                      ;    Input:  A = new value
    6703   00:6263                      ;    Output: none
    6704   00:6263                      ;    Modifies: AF
    6705   00:6263                      
    6706   00:6263                      SETDNSREADY:
    6707   00:6263  C5                      push    bc
    6708   00:6264  D5                      push    de
    6709   00:6265  E5                      push    hl
    6710   00:6266  F5                      push    af                      ; Save parameter
    6711   00:6267  CD 9E 60                call    GETSLT
    6712   00:626A                          ; Slot in A, now get the address
    6713   00:626A  CD 27 61                call    GETMEMPOINTER
    6714   00:626D                          ; HL has the address of our memory area, DNS ready is 8 bytes after start
    6715   00:626D  11 08 00                ld  de,MEMORY_DNS_READY_OFFSET
    6716   00:6270  19                      add hl,de
    6717   00:6271                          ; HL has the address of DNS ready
    6718   00:6271  F1                      pop af                          ; Restore parameter
    6719   00:6272  77                      ld  (hl),a
    6720   00:6273  E1                      pop hl
    6721   00:6274  D1                      pop de
    6722   00:6275  C1                      pop bc
    6723   00:6276  C9                      ret
    6724   00:6277                      
    6725   00:6277                      ;--- Obtain DNS result saved in high memory
    6726   00:6277                      ;    Input:  none
    6727   00:6277                      ;    Output: HL DE = DNS result
    6728   00:6277                      ;    Modifies: AF
    6729   00:6277                      
    6730   00:6277                      GETDNSRESULT:
    6731   00:6277  C5                      push    bc
    6732   00:6278  CD 9E 60                call    GETSLT
    6733   00:627B                          ; Slot in A, now get the address
    6734   00:627B  CD 27 61                call    GETMEMPOINTER
    6735   00:627E                          ; HL has the address of our memory area, DNS result is 9 bytes after start
    6736   00:627E  11 09 00                ld  de,MEMORY_DNS_RES_OFFSET
    6737   00:6281  19                      add hl,de
    6738   00:6282                          ; Ok, get it, first bytes are hl
    6739   00:6282  5E                      ld  e,(hl)
    6740   00:6283  23                      inc hl
    6741   00:6284  56                      ld  d,(hl)
    6742   00:6285  D5                      push    de                      ; for now, save in stack, so we can restore to HL later
    6743   00:6286  23                      inc hl
    6744   00:6287  5E                      ld  e,(hl)
    6745   00:6288  23                      inc hl
    6746   00:6289  56                      ld  d,(hl)
    6747   00:628A  E1                      pop hl                          ; and now restore HL value from stack
    6748   00:628B  C1                      pop bc
    6749   00:628C  C9                      ret
    6750   00:628D                      
    6751   00:628D                      ;--- Set DNS result in high memory
    6752   00:628D                      ;    Input:  HL DE = new value
    6753   00:628D                      ;    Output: none
    6754   00:628D                      ;    Modifies: AF
    6755   00:628D                      
    6756   00:628D                      SETDNSRESULT:
    6757   00:628D  C5                      push    bc
    6758   00:628E  D5                      push    de
    6759   00:628F  E5                      push    hl
    6760   00:6290  CD 9E 60                call    GETSLT
    6761   00:6293                          ; Slot in A, now get the address
    6762   00:6293  CD 27 61                call    GETMEMPOINTER
    6763   00:6296                          ; HL has the address of our memory area, DNS result is 9 bytes after start
    6764   00:6296  11 09 00                ld  de,MEMORY_DNS_RES_OFFSET
    6765   00:6299  19                      add hl,de
    6766   00:629A                          ; HL has the address of DNS result
    6767   00:629A  C1                      pop bc                          ; Restore parameter HL in BC
    6768   00:629B  71                      ld  (hl),c
    6769   00:629C  23                      inc hl
    6770   00:629D  70                      ld  (hl),b
    6771   00:629E  D1                      pop de                          ; Restore parameter DE in DE
    6772   00:629F  23                      inc hl
    6773   00:62A0  73                      ld  (hl),e
    6774   00:62A1  23                      inc hl
    6775   00:62A2  72                      ld  (hl),d
    6776   00:62A3  69                      ld  l,c
    6777   00:62A4  60                      ld  h,b                         ; And HL is restored
    6778   00:62A5  C1                      pop bc                          ; Restore BC
    6779   00:62A6  C9                      ret
    6780   00:62A7                      
    6781   00:62A7                      ;--- Convert a character to upper-case if it is a lower-case letter
    6782   00:62A7                      TOUPPER:
    6783   00:62A7  FE 61                   cp  "a"
    6784   00:62A9  D8                      ret c
    6785   00:62AA  FE 7B                   cp  "z"+1
    6786   00:62AC  D0                      ret nc
    6787   00:62AD  E6 DF                   and #DF
    6788   00:62AF  C9                      ret
    6789   00:62B0                      
    6790   00:62B0                      ;*********************************************
    6791   00:62B0                      ;***       WAIT_RESPONSE_FROM_ESP          ***
    6792   00:62B0                      ;*** Will wait ESP to send a response,     ***
    6793   00:62B0                      ;*** discarding all data until it is found.***
    6794   00:62B0                      ;***                                       ***
    6795   00:62B0                      ;*** Inputs:                               ***
    6796   00:62B0                      ;*** HL - Expected response string         ***
    6797   00:62B0                      ;*** A - Response Size                     ***
    6798   00:62B0                      ;*** DE - TimeOut in ticks                 ***
    6799   00:62B0                      ;***                                       ***
    6800   00:62B0                      ;*** Output:                               ***
    6801   00:62B0                      ;*** A - 0 if response received            ***
    6802   00:62B0                      ;*** otherwise response not received and   ***
    6803   00:62B0                      ;*** timed-out.                            ***
    6804   00:62B0                      ;***                                       ***
    6805   00:62B0                      ;*** Changes HL, BC, AF, DE, IX            ***
    6806   00:62B0                      ;*********************************************
    6807   00:62B0                      WRFE_WAIT_DATA:
    6808   00:62B0                          LOAD_STS_PORT_IN_A
    6808   00:62B0  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6809   00:62B3  CB 6F                   bit 5,a                         ; If nz Port #07 is not available
    6810   00:62B5  20 06                   jr  nz,WRFE_STS_NOT_AVAILABLE
    6811   00:62B7  CB 47                   bit 0,a                         ; if nz has data
    6812   00:62B9  C0                      ret nz
    6813   00:62BA  1B                      dec de
    6814   00:62BB  76                      halt
    6815   00:62BC  C9                      ret
    6816   00:62BD                      WRFE_STS_NOT_AVAILABLE:
    6817   00:62BD  11 00 00                ld  de,0
    6818   00:62C0  AF                      xor a
    6819   00:62C1  C9                      ret
    6820   00:62C2                      
    6821   00:62C2                      WRFE_COMPARE:
    6822   00:62C2  47                      ld  b,a
    6823   00:62C3  7E                      ld  a,(hl)
    6824   00:62C4  B8                      cp  b
    6825   00:62C5  C0                      ret nz
    6826   00:62C6  23                      inc hl
    6827   00:62C7  C9                      ret
    6828   00:62C8                      
    6829   00:62C8                      WAIT_RESPONSE_FROM_ESP:
    6830   00:62C8  4F                      ld  c,a                         ; Response size in C
    6831   00:62C9  E5                      push    hl                      ; Save HL
    6832   00:62CA  AF                      xor a
    6833   00:62CB                      WRFE_ST1:
    6834   00:62CB  DD 67                   ld  ixh,a                       ; We start at index 0
    6835   00:62CD                      
    6836   00:62CD                      WRFE_LOOP:
    6837   00:62CD  CD B0 62                call    WRFE_WAIT_DATA
    6838   00:62D0  20 07                   jr  nz,WRFE_LOOP.1
    6839   00:62D2  7B                      ld  a,e
    6840   00:62D3  B2                      or  d
    6841   00:62D4  CA F4 62                jp  z,WRFE_RET_ERROR
    6842   00:62D7  18 F4                   jr  WRFE_LOOP
    6843   00:62D9                      WRFE_LOOP.1:
    6844   00:62D9                          ; nz, check the data
    6845   00:62D9                          RECEIVE_DATA
    6845   00:62D9  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6846   00:62DC                          ; Ok, now the byte is in A, let's compare
    6847   00:62DC                      WRFE_IDXCMD:
    6848   00:62DC  CD C2 62                call WRFE_COMPARE
    6849   00:62DF                          ; if match
    6850   00:62DF  28 07                   jr  z,WRFE_RSP_MATCH
    6851   00:62E1                          ; did not match, let's zero the rsp index
    6852   00:62E1  AF                      xor a
    6853   00:62E2  DD 67                   ld  ixh,a                       ; re-start at index 0
    6854   00:62E4  E1                      pop hl                          ; restore the response index
    6855   00:62E5  E5                      push    hl                      ; and keep it in stack
    6856   00:62E6                          ; back to get another byte
    6857   00:62E6  18 E5                   jr  WRFE_LOOP
    6858   00:62E8                      WRFE_RSP_MATCH:
    6859   00:62E8                          ; match
    6860   00:62E8  DD 24                   inc ixh
    6861   00:62EA  DD 7C                   ld  a,ixh
    6862   00:62EC  B9                      cp  c
    6863   00:62ED                          ; if a = c done and response is success
    6864   00:62ED  28 02                   jr  z,WRFE_RET_OK
    6865   00:62EF                          ; not done, back to get more bytes
    6866   00:62EF  18 DC                   jr  WRFE_LOOP
    6867   00:62F1                      WRFE_RET_OK:
    6868   00:62F1  E1                      pop hl
    6869   00:62F2  AF                      xor a
    6870   00:62F3  C9                      ret
    6871   00:62F4                      WRFE_RET_ERROR:
    6872   00:62F4  E1                      pop hl
    6873   00:62F5  3E 01                   ld  a,1
    6874   00:62F7  C9                      ret
    6875   00:62F8                      
    6876   00:62F8                      ;*********************************************
    6877   00:62F8                      ;***            CHECK_ESP_TYPE             ***
    6878   00:62F8                      ;*** Always flags the SSH check as done.   ***
    6879   00:62F8                      ;*** If ESP32, flags it and probes if SSH  ***
    6880   00:62F8                      ;*** commands are supported.               ***
    6881   00:62F8                      ;*** If ESP32, NZ will be set and A = 1, if***
    6882   00:62F8                      ;*** not NZ will be reset and A=0          ***
    6883   00:62F8                      ;*********************************************
    6884   00:62F8                      CHECK_ESP_TYPE:
    6885   00:62F8  E5                      push    hl
    6886   00:62F9  D5                      push    de
    6887   00:62FA  FD E5                   push    iy
    6888   00:62FC  DD E5                   push    ix
    6889   00:62FE                          CLEAR_UART                      ; Clear UART
    6889   00:62FE  3E 14             >     ld  a,20
    6889   00:6300  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    6890   00:6303  3E 62                   ld  a,CMD_GET_FW_TYPE
    6891   00:6305                          SEND_DATA
    6891   00:6305  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6892   00:6308  21 06 00                ld  hl,6                        ; Wait up to 100ms
    6893   00:630B  ED 5B 76 F6             ld  de,(TXTTAB)                 ; Borrow Basic program area for now....
    6894   00:630F  DD 6B                   ld  ixl,e
    6895   00:6311  DD 62                   ld  ixh,d                       ; Address in IX
    6896   00:6313  CD 7D 4B                call    WAIT_MENU_CMD_RESPONSE
    6897   00:6316  F5                      push    af                      ; Keep result (1 = ESP32, 0 = not)
    6898   00:6317  CD 9E 60                call    GETSLT
    6899   00:631A  CD 0B 61                call    GETMEMPOINTERADDR       ; This is where we are going to store our memory area address
    6900   00:631D  11 02 00                ld  de,2
    6901   00:6320  19                      add hl,de                       ; HL = our flags byte
    6902   00:6321  F1                      pop af
    6903   00:6322  28 0A                   jr  z,CHECK_ESP_TYPE_NO32
    6904   00:6324                          ; ESP32 found: probed + ESP32, then check SSH support
    6905   00:6324  36 81                   ld  (hl),ESPFLAG_SSH_PROBED+ESPFLAG_ESP32
    6906   00:6326  CD 38 63                call    PROBE_ESP_SSH           ; Sets/clears ESPFLAG_SSH
    6907   00:6329  3E 01                   ld  a,1
    6908   00:632B  B7                      or  a                           ; NZ = ESP32, as before
    6909   00:632C  18 03                   jr  CHECK_ESP_TYPE_END
    6910   00:632E                      CHECK_ESP_TYPE_NO32:
    6911   00:632E                          ; No ESP32 means no SSH support either, and SSH was probed
    6912   00:632E  36 80                   ld  (hl),ESPFLAG_SSH_PROBED
    6913   00:6330  AF                      xor a                           ; Z = not ESP32, as before
    6914   00:6331                      CHECK_ESP_TYPE_END:
    6915   00:6331  DD E1                   pop ix
    6916   00:6333  FD E1                   pop iy
    6917   00:6335  D1                      pop de
    6918   00:6336  E1                      pop hl
    6919   00:6337  C9                      ret
    6920   00:6338                      
    6921   00:6338                      ;*********************************************
    6922   00:6338                      ;***             PROBE_ESP_SSH             ***
    6923   00:6338                      ;*** Sends an SSH GET_CAPAB request for    ***
    6924   00:6338                      ;*** block 1 (81h 00h 01h 01h) and accepts ***
    6925   00:6338                      ;*** 81h 00h or 81h 04h as SSH support.    ***
    6926   00:6338                      ;*** Sets/clears ESPFLAG_SSH and marks the ***
    6927   00:6338                      ;*** check as done. Called from boot only. ***
    6928   00:6338                      ;*** Output: NZ if SSH is supported        ***
    6929   00:6338                      ;*********************************************
    6930   00:6338                      PROBE_ESP_SSH:
    6931   00:6338  C5                      push    bc
    6932   00:6339  D5                      push    de
    6933   00:633A  E5                      push    hl
    6934   00:633B  CD 9E 60                call    GETSLT
    6935   00:633E  CD 0B 61                call    GETMEMPOINTERADDR
    6936   00:6341  11 02 00                ld  de,2
    6937   00:6344  19                      add hl,de                       ; Our flags byte
    6938   00:6345  E5                      push    hl                      ; Keep its address
    6939   00:6346  CB FE                   set 7,(hl)                      ; SSH check is done
    6940   00:6348  CB 8E                   res 1,(hl)                      ; Assume SSH is not supported
    6941   00:634A                          CLEAR_UART                      ; Clear UART
    6941   00:634A  3E 14             >     ld  a,20
    6941   00:634C  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    6942   00:634F  3E 81                   ld  a,#81                       ; SSH GET_CAPAB command
    6943   00:6351                          SEND_DATA
    6943   00:6351  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6944   00:6354  AF                      xor a
    6945   00:6355                          SEND_DATA                       ; Command size MSB
    6945   00:6355  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6946   00:6358  3C                      inc a
    6947   00:6359                          SEND_DATA                       ; Command size LSB
    6947   00:6359  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6948   00:635C                          SEND_DATA                       ; Block index (1)
    6948   00:635C  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6949   00:635F  21 02 00                ld  hl,2                        ; Wait up to 2 frames
    6950   00:6362                      PROBE_ESP_SSH_ST1:
    6951   00:6362                          CHECK_DATA
    6951   00:6362  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6951   00:6365  CB 47             >     bit 0,a
    6952   00:6367  20 07                   jr  nz,PROBE_ESP_SSH_ST1.1
    6953   00:6369  CD 9F 4C                call    HLTIMEOUT
    6954   00:636C  20 F4                   jr  nz,PROBE_ESP_SSH_ST1
    6955   00:636E  18 23                   jr  PROBE_ESP_SSH_END           ; Time-out, not supported
    6956   00:6370                      PROBE_ESP_SSH_ST1.1:
    6957   00:6370                          RECEIVE_DATA
    6957   00:6370  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6958   00:6373  FE 81                   cp  #81                         ; Is response of our command?
    6959   00:6375  20 EB                   jr  nz,PROBE_ESP_SSH_ST1
    6960   00:6377                      PROBE_ESP_SSH_ST2:
    6961   00:6377                          CHECK_DATA
    6961   00:6377  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6961   00:637A  CB 47             >     bit 0,a
    6962   00:637C  20 07                   jr  nz,PROBE_ESP_SSH_ST2.1
    6963   00:637E  CD 9F 4C                call    HLTIMEOUT
    6964   00:6381  20 F4                   jr  nz,PROBE_ESP_SSH_ST2
    6965   00:6383  18 0E                   jr  PROBE_ESP_SSH_END           ; Time-out, not supported
    6966   00:6385                      PROBE_ESP_SSH_ST2.1:
    6967   00:6385                          RECEIVE_DATA
    6967   00:6385  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6968   00:6388  B7                      or  a                           ; Error code 0?
    6969   00:6389  28 04                   jr  z,PROBE_ESP_SSH_OK
    6970   00:638B  FE 04                   cp  4                           ; Error code 4?
    6971   00:638D  20 04                   jr  nz,PROBE_ESP_SSH_END        ; Anything else, not supported
    6972   00:638F                      PROBE_ESP_SSH_OK:
    6973   00:638F  E1                      pop hl
    6974   00:6390  CB CE                   set 1,(hl)                      ; SSH is supported
    6975   00:6392  E5                      push    hl
    6976   00:6393                      PROBE_ESP_SSH_END:
    6977   00:6393                          CLEAR_UART                      ; Consume/discard remaining response
    6977   00:6393  3E 14             >     ld  a,20
    6977   00:6395  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    6978   00:6398  E1                      pop hl
    6979   00:6399  7E                      ld  a,(hl)
    6980   00:639A  E6 02                   and ESPFLAG_SSH
    6981   00:639C  E1                      pop hl
    6982   00:639D  D1                      pop de
    6983   00:639E  C1                      pop bc
    6984   00:639F  C9                      ret
    6985   00:63A0                      
    6986   00:63A0                      ;*********************************************
    6987   00:63A0                      ;***         PRINT_INSTALLED_MSG           ***
    6988   00:63A0                      ;*** ESP8266: prints installed message.    ***
    6989   00:63A0                      ;*** ESP32: uses the 'b' (Get Board)       ***
    6990   00:63A0                      ;*** command to print the board ID.        ***
    6991   00:63A0                      ;*********************************************
    6992   00:63A0                      PRINT_INSTALLED_MSG:
    6993   00:63A0  C5                      push    bc
    6994   00:63A1  D5                      push    de
    6995   00:63A2  FD E5                   push    iy
    6996   00:63A4  DD E5                   push    ix
    6997   00:63A6  CD 23 62                call    GETESPTYPE
    6998   00:63A9  28 48                   jr  z,PRINT_INST_8266           ; Not an ESP32, no need to ask
    6999   00:63AB                          ; ESP32, let's get the board identification string
    7000   00:63AB                          CLEAR_UART                      ; Clear UART
    7000   00:63AB  3E 14             >     ld  a,20
    7000   00:63AD  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    7001   00:63B0  3E 62                   ld  a,CMD_GET_FW_TYPE           ; 'b' Get Board, ESP32 only
    7002   00:63B2                          SEND_DATA
    7002   00:63B2  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    7003   00:63B5  21 06 00                ld  hl,6                        ; Wait up to 100ms
    7004   00:63B8  ED 5B 76 F6             ld  de,(TXTTAB)                 ; Borrow Basic program area for now....
    7005   00:63BC  DD 6B                   ld  ixl,e
    7006   00:63BE  DD 62                   ld  ixh,d                       ; Address in IX
    7007   00:63C0  CD 7D 4B                call    WAIT_MENU_CMD_RESPONSE
    7008   00:63C3  28 26                   jr  z,PRINT_INST_32             ; No answer, just tell it is an ESP32
    7009   00:63C5                          ; Response size is in BC, board ID copied at (TXTTAB)
    7010   00:63C5  78                      ld  a,b
    7011   00:63C6  B7                      or  a                           ; Size above 255?
    7012   00:63C7  20 22                   jr  nz,PRINT_INST_32            ; Then just tell it is an ESP32
    7013   00:63C9  79                      ld  a,c
    7014   00:63CA  B7                      or  a                           ; Size zero?
    7015   00:63CB  28 1E                   jr  z,PRINT_INST_32             ; Then just tell it is an ESP32
    7016   00:63CD  FE 18                   cp  24                          ; More than 23 chars?
    7017   00:63CF  30 1A                   jr  nc,PRINT_INST_32            ; Then just tell it is an ESP32
    7018   00:63D1  2A 76 F6                ld  hl,(TXTTAB)
    7019   00:63D4  09                      add hl,bc
    7020   00:63D5  36 00                   ld  (hl),0                      ; Ensure the string is terminated
    7021   00:63D7  21 E4 71                ld  hl,OK_INST_PRE              ; "Installed "
    7022   00:63DA  CD A5 4C                call    PRINTHL
    7023   00:63DD  2A 76 F6                ld  hl,(TXTTAB)
    7024   00:63E0  CD A5 4C                call    PRINTHL                 ; Board identification string
    7025   00:63E3  21 EF 71                ld  hl,OK_INST_SUF              ; " successfully!"
    7026   00:63E6  CD A5 4C                call    PRINTHL
    7027   00:63E9  18 0E                   jr  PRINT_INST_END
    7028   00:63EB                      PRINT_INST_32:
    7029   00:63EB  21 C3 71                ld  hl,OK_ESP32                 ; Installed ESP32 successfully!
    7030   00:63EE  CD A5 4C                call    PRINTHL
    7031   00:63F1  18 06                   jr  PRINT_INST_END
    7032   00:63F3                      PRINT_INST_8266:
    7033   00:63F3  21 A0 71                ld  hl,OK_ESP8266               ; Installed ESP8266 successfully!
    7034   00:63F6  CD A5 4C                call    PRINTHL
    7035   00:63F9                      PRINT_INST_END:
    7036   00:63F9  DD E1                   pop ix
    7037   00:63FB  FD E1                   pop iy
    7038   00:63FD  D1                      pop de
    7039   00:63FE  C1                      pop bc
    7040   00:63FF  C9                      ret
    7041   00:6400                      
    7042   00:6400                      ;*********************************************
    7043   00:6400                      ;***              RESET ESP                ***
    7044   00:6400                      ;*** If RESET ok, A will be 0, otherwise   ***
    7045   00:6400                      ;*** failure                               ***
    7046   00:6400                      ;*********************************************
    7047   00:6400                      RESET_ESP:
    7048   00:6400                          ; Is ESP installed?
    7049   00:6400                          CLEAR_UART                      ; Clear UART
    7049   00:6400  3E 14             >     ld  a,20
    7049   00:6402  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    7050   00:6405  3E 3F                   ld  a,CMD_QUERY_ESP
    7051   00:6407                          SEND_DATA
    7051   00:6407  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    7052   00:640A  21 9F 65                ld  hl,RSP_CMD_QUERY_ESP        ; Expected response
    7053   00:640D  11 3C 00                ld  de,60                       ; Up to 1s @ 60Hz
    7054   00:6410  3E 02                   ld  a,RSP_CMD_QUERY_ESP_SIZE    ; Size of response
    7055   00:6412  CD C8 62                call    WAIT_RESPONSE_FROM_ESP
    7056   00:6415  B7                      or  a
    7057   00:6416  3E 01                   ld  a,1
    7058   00:6418  28 03                   jr  z,RESET_ESP_INIT            ; ESP Found
    7059   00:641A  06 00                   ld  b,0                         ; 0 if no response
    7060   00:641C  C9                      ret
    7061   00:641D                      RESET_ESP_INIT:
    7062   00:641D  06 03                   ld  b,3                         ; Retry up to 10 times
    7063   00:641F                      RESET_ESP_LOOP:
    7064   00:641F                          CLEAR_UART
    7064   00:641F  3E 14             >     ld  a,20
    7064   00:6421  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    7065   00:6424                          SET_SPEED
    7065   00:6424  AF                >     xor a
    7065   00:6425  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    7066   00:6428  76                      halt
    7067   00:6429  76                      halt                            ; Wait a little to make sure speed is adjusted
    7068   00:642A  3E 57                   ld  a,CMD_WRESET_ESP
    7069   00:642C                          SEND_DATA
    7069   00:642C  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    7070   00:642F  21 9A 65                ld  hl,RSP_CMD_RESET_ESP        ; Expected response
    7071   00:6432  11 5A 00                ld  de,90                       ; Up to 1.5s @ 60Hz
    7072   00:6435  3E 05                   ld  a,RSP_CMD_RESET_ESP_SIZE    ; Size of response
    7073   00:6437  C5                      push    bc                      ; Save retry counter
    7074   00:6438  CD C8 62                call    WAIT_RESPONSE_FROM_ESP
    7075   00:643B  C1                      pop bc                          ; restore retry counter
    7076   00:643C  B7                      or  a                           ; Did WAIT RESPONSE return zero?
    7077   00:643D  C8                      ret z                           ; Yes, Warm Reset Ok
    7078   00:643E  10 DF                   djnz RESET_ESP_LOOP             ; No, decrement retry counter and let the loop check
    7079   00:6440                          ; No more retries? Then check if it is old ESP FW
    7080   00:6440                      RESET_CHK_IF_INSTALLED:
    7081   00:6440                          ; No more retries? Then it is old ESP FW
    7082   00:6440  06 01                   ld  b,1
    7083   00:6442  C9                      ret
    7084   00:6443                      
    7085   00:6443                      ;*********************************************
    7086   00:6443                      ;***              SET TIME                 ***
    7087   00:6443                      ;*** H - Hour                              ***
    7088   00:6443                      ;*** L - Minutes                           ***
    7089   00:6443                      ;*** D - Seconds                           ***
    7090   00:6443                      ;***                                       ***
    7091   00:6443                      ;*** A - 0 if Ok otherwise invalid time    ***
    7092   00:6443                      ;*********************************************
    7093   00:6443                      SET_TIME:
    7094   00:6443  7C                      ld  a,h                         ; Hour in A
    7095   00:6444  FE 18                   cp  24                          ; Compare to 24
    7096   00:6446  30 12                   jr  nc,SET_TIME_ERR             ; If 24 or more, invalid
    7097   00:6448  7D                      ld  a,l                         ; Minutes in A
    7098   00:6449  FE 3C                   cp  60                          ; Compare to 60
    7099   00:644B  30 0D                   jr  nc,SET_TIME_ERR             ; If 60 or more, invalid
    7100   00:644D  7A                      LD  a,d                         ; Seconds in D
    7101   00:644E  FE 3C                   cp  60                          ; Compare to 60
    7102   00:6450  30 08                   jr  nc,SET_TIME_ERR             ; If 60 or more invalid
    7103   00:6452  44                      ld  b,h                         ; Hour in B
    7104   00:6453  4D                      ld  c,l                         ; Minutes in C
    7105   00:6454  5A                      ld  e,d                         ; Seconds in E
    7106   00:6455  CD 5D 64                call    SET_RTC_TIME            ; Set time in RTC
    7107   00:6458  AF                      xor a                           ; 0 in A
    7108   00:6459  C9                      ret                             ; Return
    7109   00:645A                      ;   Invalid parameter
    7110   00:645A                      SET_TIME_ERR:
    7111   00:645A  3E 01                   ld  a,1                         ; Invalid Time
    7112   00:645C  C9                      ret                             ; Return
    7113   00:645D                      
    7114   00:645D                      SET_RTC_TIME:
    7115   00:645D  6B                      ld  l,e                         ; Seconds in L
    7116   00:645E  61                      ld  h,c                         ; Minutes in H
    7117   00:645F  50                      ld  d,b                         ; Hour in D
    7118   00:6460  CD B8 64                call    STOP_RTC_COUNT_SET_MODE0; Select RTC Register 13, and set Mode / Page 0
    7119   00:6463  3E 0F                   ld  a,#F                        ; Register F
    7120   00:6465  D3 B4                   out (#B4),a
    7121   00:6467  3E 02                   ld  a,2
    7122   00:6469  D3 B5                   out (#B5),a                     ; Timer reset seconds and on both clock pulses
    7123   00:646B  1E 00                   ld  e,0                         ; Start at register 0
    7124   00:646D  C3 F3 64                jp  SET_RTC_DATE.1              ; And save L, H and D, function will return from there
    7125   00:6470                      
    7126   00:6470                      ;*********************************************
    7127   00:6470                      ;***              SET DATE                 ***
    7128   00:6470                      ;*** HL - Year from 1980 to 2079           ***
    7129   00:6470                      ;*** D - Month from 1 to 12                ***
    7130   00:6470                      ;*** E - Day from 1 to 31                  ***
    7131   00:6470                      ;***                                       ***
    7132   00:6470                      ;*** A - 0 if Ok otherwise invalid Date    ***
    7133   00:6470                      ;*********************************************
    7134   00:6470                      SET_DATE:
    7135   00:6470  01 44 F8                ld  bc,#F844
    7136   00:6473  09                      add hl,bc
    7137   00:6474  30 32                   jr  nc,SET_DATE_ERR             ; No carry -> Year is less than 1980, invalid date
    7138   00:6476  7C                      ld  a,h
    7139   00:6477  B7                      or  a
    7140   00:6478  20 2E                   jr  nz,SET_DATE_ERR             ; If H is set, means year is greater than 2235 ,invalid
    7141   00:647A  7D                      ld  a,l
    7142   00:647B  FE 64                   cp  100
    7143   00:647D  30 29                   jr  nc,SET_DATE_ERR             ; If L >= 100 year is greater than 2079, invalid
    7144   00:647F  47                      ld  b,a                         ; Year - 1980 in B
    7145   00:6480  7A                      ld  a,d                         ; Now test month
    7146   00:6481  3D                      dec a
    7147   00:6482  FE 0C                   cp  12                          ; If 12 or less this should carry
    7148   00:6484  30 22                   jr  nc,SET_DATE_ERR             ; otherwise invalid
    7149   00:6486  21 AB 64                ld  hl,DAYS_IN_MONTH            ; Days in Month table
    7150   00:6489  85                      add a,l                         ; add our month
    7151   00:648A  6F                      ld  l,a                         ; back in L
    7152   00:648B  30 01                   jr  nc,SET_DATE1                ; no carry done
    7153   00:648D  24                      inc h                           ; otherwise increase H
    7154   00:648E                      SET_DATE1:
    7155   00:648E  3E 1C                   ld  a,28                        ; 28 days
    7156   00:6490  BE                      cp  (hl)                        ; If month is 28 days, February, need to check if leap and limit is 29 in this year
    7157   00:6491  20 08                   jr  nz,SET_DATE2                ; if not, skip below code , so probably above check is if month is february
    7158   00:6493  78                      ld  a,b                         ; Year - 1980 in A again
    7159   00:6494  E6 03                   and 3                           ; if other than 0, non divisible per 4, so not a leap year
    7160   00:6496  20 03                   jr  nz,SET_DATE2                ; Regular year
    7161   00:6498  21 B7 64                ld  hl,DAYS_IN_FEBRUARY_LEAP    ; HL has address of 29 days, maximum number of days for february in leap year
    7162   00:649B                      SET_DATE2:
    7163   00:649B  7B                      ld  a,e                         ; Day of month in A
    7164   00:649C  3D                      dec a                           ; Decrement
    7165   00:649D  BE                      cp  (hl)                        ; Compare with Days in month
    7166   00:649E  30 08                   jr  nc,SET_DATE_ERR             ; If day is greater than how many days in month, invalid
    7167   00:64A0  6B                      ld  l,e                         ; Day of month in L
    7168   00:64A1  62                      ld  h,d                         ; Month in H
    7169   00:64A2  50                      ld  d,b                         ; Year - 1980 in D
    7170   00:64A3  CD DD 64                call    SET_RTC_DATE            ; Set date in RTC
    7171   00:64A6  AF                      xor a                           ; A = 0
    7172   00:64A7  C9                      ret                             ; Success
    7173   00:64A8                      ;   Invalid parameter
    7174   00:64A8                      SET_DATE_ERR:
    7175   00:64A8  3E 01                   ld  a,1
    7176   00:64AA  C9                      ret
    7177   00:64AB                      
    7178   00:64AB                      ; Table of top day value for each month
    7179   00:64AB                      DAYS_IN_MONTH:          db  31,28,31,30,31,30,31,31,30,31,30,31
    7179   00:64AB  1F 1C 1F 1E 1F 1E 1F 1F 1E 1F 1E 1F 
    7180   00:64B7                      ; And top day value in February when Leap Year
    7181   00:64B7  1D                  DAYS_IN_FEBRUARY_LEAP:  db  29
    7182   00:64B8                      
    7183   00:64B8                      ; Will select Mode 00 (Date and Time page) and stop clock counting
    7184   00:64B8                      ; Register D value will be left in A
    7185   00:64B8                      STOP_RTC_COUNT_SET_MODE0:
    7186   00:64B8  3E 0D                   ld  a,#D
    7187   00:64BA  D3 B4                   out (#B4),a                     ; Select RTC register D (mode)
    7188   00:64BC  DB B5                   in  a,(#B5)                     ; read register D
    7189   00:64BE  E6 04                   and 4                           ; Save Alarm EN setting, and mode register is 00 and stop counting time
    7190   00:64C0  D3 B5                   out (#B5),a                     ; And save
    7191   00:64C2  C9                      ret
    7192   00:64C3                      
    7193   00:64C3                      ; Will get a non BCD value in A, convert it to BCD and then save it in
    7194   00:64C3                      ; a register pair that starts in the register indicated in E
    7195   00:64C3                      ; Register E will have the next register after that register pair
    7196   00:64C3                      RTC_SAVE_REGISTERPAIR:
    7197   00:64C3  4F                      ld  c,a                         ; Save A in C
    7198   00:64C4  AF                      xor a                           ; 0 in A
    7199   00:64C5  06 08                   ld  b,8                         ; 8 in B, number of bits for conversion
    7200   00:64C7                      RTC_SAVE_REGISTERPAIR.1:
    7201   00:64C7  CB 01                   rlc c                           ; Leftmost bit in Carry
    7202   00:64C9  8F                      adc a,a                         ; A = (A * 2) + Carry
    7203   00:64CA  27                      daa                             ; decimal adjust A, shift = BCD x 2 + carry
    7204   00:64CB  10 FA                   djnz    RTC_SAVE_REGISTERPAIR.1 ; Repeat for 8 bits
    7205   00:64CD  CD D4 64                call    SET_RTC_REG             ; Save LSB in register and increase register address
    7206   00:64D0  0F                      rrca
    7207   00:64D1  0F                      rrca
    7208   00:64D2  0F                      rrca
    7209   00:64D3  0F                      rrca                            ; now MSB is in LSB position
    7210   00:64D4                      SET_RTC_REG:
    7211   00:64D4  47                      ld  b,a                         ; save value to set in B
    7212   00:64D5  7B                      ld  a,e                         ; and now register address in A
    7213   00:64D6  D3 B4                   out (#B4),a                     ; The register we want to set
    7214   00:64D8  78                      ld  a,b                         ; restore value
    7215   00:64D9  D3 B5                   out (#B5),a                     ; save it
    7216   00:64DB  1C                      inc e                           ; increase register address, as this usually is done in pairs
    7217   00:64DC  C9                      ret
    7218   00:64DD                      
    7219   00:64DD                      ; Auxiliary function for SET_DATE and SET_TIME
    7220   00:64DD                      ; SET_RTC_DATE will save date, parameters:
    7221   00:64DD                      ; L - Day
    7222   00:64DD                      ; H - Month
    7223   00:64DD                      ; D - Years since 1980
    7224   00:64DD                      ; All values are regular values, this function will properly convert them
    7225   00:64DD                      ;
    7226   00:64DD                      ; SET_RTC_DATE.1 is used by SET_TIME as well
    7227   00:64DD                      ; It will save three register pairs, starting with the register in E
    7228   00:64DD                      ; First pair is updated with value in L
    7229   00:64DD                      ; Second pair is updated with value in H
    7230   00:64DD                      ; Third pair is updated with value in D
    7231   00:64DD                      SET_RTC_DATE:
    7232   00:64DD  CD B8 64                call    STOP_RTC_COUNT_SET_MODE0; Select RTC Register 13, and set Mode / Page 0
    7233   00:64E0  F6 01                   or  1                           ; Set Bit 0, so Mode / Page 1
    7234   00:64E2  D3 B5                   out (#B5),a                     ; save it in register 13, now page 1 selected
    7235   00:64E4  3E 0B                   ld  a,#B                        ; Leap Year Counter Register
    7236   00:64E6  D3 B4                   out (#B4),a                     ; Select it
    7237   00:64E8  7A                      ld  a,d                         ; Load Years in leap year counter
    7238   00:64E9  D3 B5                   out (#B5),a                     ; So it has count of leap years (0 is 1980, leap, and every time it is 4, leap year again)
    7239   00:64EB  CD B8 64                call    STOP_RTC_COUNT_SET_MODE0; Select RTC Register 13 and set mode / page 0
    7240   00:64EE  CD B8 64                call    STOP_RTC_COUNT_SET_MODE0; do it a second time... DOS does it, don't want to JYNX it :P
    7241   00:64F1  1E 07                   ld  e,7                         ; Register 7
    7242   00:64F3                      SET_RTC_DATE.1:
    7243   00:64F3  7D                      ld  a,l                         ; A has day
    7244   00:64F4  CD C3 64                call    RTC_SAVE_REGISTERPAIR   ; Will convert day to BCD and save in registers 7 and 8
    7245   00:64F7  7C                      ld  a,h                         ; A has month
    7246   00:64F8  CD C3 64                call    RTC_SAVE_REGISTERPAIR   ; Will convert month to BCD and save in register 9 and A
    7247   00:64FB  7A                      ld  a,d                         ; A has how many years since 1980
    7248   00:64FC  CD C3 64                call    RTC_SAVE_REGISTERPAIR   ; Will convert to BCD and save in register B and C
    7249   00:64FF  3E 0D                   ld  a,#D                        ; Register D
    7250   00:6501  D3 B4                   out (#B4),a                     ; Send it
    7251   00:6503  DB B5                   in  a,(#B5)                     ; Read its value
    7252   00:6505  F6 08                   or  8                           ; Start counting time again
    7253   00:6507  D3 B5                   out (#B5),a                     ; Send
    7254   00:6509  C9                      ret
    7255   00:650A                      
    7256   00:650A                      ; Pattern setup routine
    7257   00:650A                      PATTERN_SETUP:
    7258   00:650A  AF                      xor a                           ; Bit-16, V9938 and V9958 only
    7259   00:650B  21 88 00                ld  hl,#0088                    ; Bit-15 to 0, pattern base address = #0088
    7260   00:650E  CD 7E 65                call SET_VDP_WRITE
    7261   00:6511  21 1E 65                ld  hl,PATTERN_DATA             ; Point to hl
    7262   00:6514  06 60                   ld  b,8*12                      ; Redraw 12 chars, max 12 chars are suggested
    7263   00:6516  0E 98                   ld  c,#98                       ; port #98
    7264   00:6518                      OUTI_TO_VRAM_TMS9918:
    7265   00:6518  ED A3                   outi                            ; Slower than otir but useful on TMS9918 which requires 29 T-states
    7266   00:651A  C2 18 65                jp  nz,OUTI_TO_VRAM_TMS9918     ; Therefore, don't use 'djnz' here!
    7267   00:651D  C9                      ret
    7268   00:651E                      PATTERN_DATA:
    7269   00:651E                      ; Pattern-01 is CHR$(1)+CHR$(81) = SCAN_TERMINATOR_OPEN
    7270   00:651E  06                      db  %00000110
    7271   00:651F  09                      db  %00001001
    7272   00:6520  09                      db  %00001001
    7273   00:6521  FC                      db  %11111100                   ; "Opened Padlock"
    7274   00:6522  FC                      db  %11111100
    7275   00:6523  FC                      db  %11111100
    7276   00:6524  FC                      db  %11111100
    7277   00:6525  00                      db  %00000000
    7278   00:6526                      ; Pattern-02 is CHR$(1)+CHR$(82) = SCAN_TERMINATOR_ENC
    7279   00:6526  30                      db  %00110000
