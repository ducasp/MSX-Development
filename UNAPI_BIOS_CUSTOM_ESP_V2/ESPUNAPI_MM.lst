    3594   00:538C                      ;========================
    3595   00:538C                      ;===  TCPIP_UDP_SEND  ===
    3596   00:538C                      ;========================
    3597   00:538C                      ;Send an UDP datagram.
    3598   00:538C                      ;
    3599   00:538C                      ;Input:  A = 11
    3600   00:538C                      ;        B = Connection number
    3601   00:538C                      ;        HL = Address of datagram data
    3602   00:538C                      ;        DE = Address of parameters block
    3603   00:538C                      ;Output: A = Error code
    3604   00:538C                      ;
    3605   00:538C                      ;Parameters block:
    3606   00:538C                      ;
    3607   00:538C                      ;    +0 (4): Destination IP address
    3608   00:538C                      ;    +4 (2): Destination port
    3609   00:538C                      ;    +6 (2): Data length
    3610   00:538C                      TCPIP_UDP_SEND:
    3611   00:538C  E5                      push    hl
    3612   00:538D  D5                      push    de
    3613   00:538E                          SEND_DATA                       ; Send the command
    3613   00:538E  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3614   00:5391                          ; prepare new data size, adding our 7 bytes overhead
    3615   00:5391  DD 62                   ld  ixh,d
    3616   00:5393  DD 6B                   ld  ixl,e
    3617   00:5395  11 07 00                ld  de,7
    3618   00:5398  DD 6E 06                ld  l,(ix+6)
    3619   00:539B  DD 66 07                ld  h,(ix+7)
    3620   00:539E  19                      add hl,de
    3621   00:539F  7C                      ld  a,h
    3622   00:53A0                          SEND_DATA                       ; Send the command size msb
    3622   00:53A0  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3623   00:53A3  7D                      ld  a,l
    3624   00:53A4                          SEND_DATA                       ; Send the command size lsb
    3624   00:53A4  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3625   00:53A7  78                      ld  a,b
    3626   00:53A8                          SEND_DATA                       ; Send the connection #
    3626   00:53A8  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3627   00:53AB  D1                      pop de
    3628   00:53AC  E1                      pop hl
    3629   00:53AD  1A                      ld  a,(de)
    3630   00:53AE                          SEND_DATA                       ; Send IP byte 1
    3630   00:53AE  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3631   00:53B1  13                      inc de
    3632   00:53B2  1A                      ld  a,(de)
    3633   00:53B3                          SEND_DATA                       ; Send IP byte 2
    3633   00:53B3  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3634   00:53B6  13                      inc de
    3635   00:53B7  1A                      ld  a,(de)
    3636   00:53B8                          SEND_DATA                       ; Send IP byte 3
    3636   00:53B8  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3637   00:53BB  13                      inc de
    3638   00:53BC  1A                      ld  a,(de)
    3639   00:53BD                          SEND_DATA                       ; Send IP byte 4
    3639   00:53BD  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3640   00:53C0  13                      inc de
    3641   00:53C1  1A                      ld  a,(de)
    3642   00:53C2                          SEND_DATA                       ; Send Port LSB
    3642   00:53C2  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3643   00:53C5  13                      inc de
    3644   00:53C6  1A                      ld  a,(de)
    3645   00:53C7                          SEND_DATA                       ; Send Port MSB
    3645   00:53C7  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3646   00:53CA                          ; now oti the data starting at hl, size is in next DE position
    3647   00:53CA  13                      inc de
    3648   00:53CB  1A                      ld  a,(de)
    3649   00:53CC  47                      ld  b,a                         ; save lsb in b
    3650   00:53CD  13                      inc de
    3651   00:53CE  1A                      ld  a,(de)                      ; msb
    3652   00:53CF  57                      ld  d,a                         ; put in D, there is no ld d,(de)
    3653   00:53D0  58                      ld  e,b                         ; lsb
    3654   00:53D1                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    3655   00:53D1                          ;ld b,e                         ; Number of loops originaly in DE, not needed, b already has e
    3656   00:53D1  1B                      dec de
    3657   00:53D2  14                      inc d
    3658   00:53D3                          if USE_MEM_IO = 0
    3659   00:53D3                    ~     ld  c,OUT_TX_PORT
    3660   00:53D3                    ~ TCPIP_UDP_SEND_R:
    3661   00:53D3                    ~     otir                            ; Send until B is 0
    3662   00:53D3                    ~     else
    3663   00:53D3                      TCPIP_UDP_SEND_R:
    3664   00:53D3  7E                      ld  a,(hl)
    3665   00:53D4  32 07 7F                ld  (MEM_OUT_TX_PORT),a
    3666   00:53D7  23                      inc hl
    3667   00:53D8  10 F9                   djnz TCPIP_UDP_SEND_R
    3668   00:53DA                          endif
    3669   00:53DA  15                      dec d                           ; decrement secondary counter
    3670   00:53DB  20 F6                   jr  nz,TCPIP_UDP_SEND_R         ; If still have another round, do it
    3671   00:53DD                          ; Now wait up to 600 ticks to get response
    3672   00:53DD  21 58 02                ld  hl,600
    3673   00:53E0  CD 3E 61                call    SETCOUNTER
    3674   00:53E3                      TCPIP_UDP_SEND_ST1:
    3675   00:53E3                          CHECK_DATA
    3675   00:53E3  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3675   00:53E6  CB 47             >     bit 0,a
    3676   00:53E8  20 05                   jr  nz,TCPIP_UDP_SEND_ST1.1
    3677   00:53EA  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3678   00:53ED  18 F4                   jr  TCPIP_UDP_SEND_ST1
    3679   00:53EF                      TCPIP_UDP_SEND_ST1.1:
    3680   00:53EF                          ; nz, check the data
    3681   00:53EF                          RECEIVE_DATA
    3681   00:53EF  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3682   00:53F2  FE 0B                   cp  11                          ; Is response of our command?
    3683   00:53F4  20 ED                   jr  nz,TCPIP_UDP_SEND_ST1
    3684   00:53F6                          ; now get return code, if return code other than 0, it is finished
    3685   00:53F6                      TCPIP_UDP_SEND_RC:
    3686   00:53F6                          CHECK_DATA
    3686   00:53F6  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3686   00:53F9  CB 47             >     bit 0,a
    3687   00:53FB  20 05                   jr  nz,TCPIP_UDP_SEND_RC.1
    3688   00:53FD  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3689   00:5400  18 F4                   jr  TCPIP_UDP_SEND_RC
    3690   00:5402                      TCPIP_UDP_SEND_RC.1:
    3691   00:5402                          ; nz, discard
    3692   00:5402                          RECEIVE_DATA
    3692   00:5402  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3693   00:5405  B7                      or  a                           ; 0?
    3694   00:5406  C0                      ret nz                          ; if not, done
    3695   00:5407                      
    3696   00:5407                          ; next two bytes are return code and size bytes, don't care, it is 0
    3697   00:5407  06 02                   ld  b,2
    3698   00:5409                      TCPIP_UDP_SEND_ST2:
    3699   00:5409                          CHECK_DATA
    3699   00:5409  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3699   00:540C  CB 47             >     bit 0,a
    3700   00:540E  20 05                   jr  nz,TCPIP_UDP_SEND_ST2.1
    3701   00:5410  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3702   00:5413  18 F4                   jr  TCPIP_UDP_SEND_ST2
    3703   00:5415                      TCPIP_UDP_SEND_ST2.1:
    3704   00:5415                          ; nz, discard
    3705   00:5415                          RECEIVE_DATA
    3705   00:5415  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3706   00:5418  05                      dec b
    3707   00:5419  20 EE                   jr  nz,TCPIP_UDP_SEND_ST2
    3708   00:541B                      
    3709   00:541B                          ; done, no return data other than return code
    3710   00:541B  AF                      xor a
    3711   00:541C  C9                      ret
    3712   00:541D                      
    3713   00:541D                      ;=======================
    3714   00:541D                      ;===  TCPIP_UDP_RCV  ===
    3715   00:541D                      ;=======================
    3716   00:541D                      ;Retrieve an incoming UDP datagram.
    3717   00:541D                      ;
    3718   00:541D                      ;Input:  A = 12
    3719   00:541D                      ;        B = Connection number
    3720   00:541D                      ;        HL = Address for datagram data
    3721   00:541D                      ;        DE = Maximum data size to retrieve
    3722   00:541D                      ;Output: A = Error code
    3723   00:541D                      ;        L.H.E.D = Source IP address
    3724   00:541D                      ;        IX = Source port
    3725   00:541D                      ;        BC = Actual received data size
    3726   00:541D                      
    3727   00:541D                      ; Customized TIME OUT routine: If time out receiving data, retry as received data
    3728   00:541D                      ; won't be re-sent as host is unaware of this
    3729   00:541D                      TCPIP_UDP_RCV_CHECK_TIME_OUT:
    3730   00:541D                          ; Save registers other than AF
    3731   00:541D  C5                      push bc
    3732   00:541E  D5                      push de
    3733   00:541F  E5                      push hl
    3734   00:5420  CD 2F 61                call    GETCOUNTER
    3735   00:5423  7D                      ld  a,l
    3736   00:5424  B4                      or  h
    3737   00:5425                          ; Restore registers, we are returning
    3738   00:5425  E1                      pop hl
    3739   00:5426  D1                      pop de
    3740   00:5427  C1                      pop bc
    3741   00:5428  C0                      ret nz
    3742   00:5429                          ; Ok, timeout...
    3743   00:5429  F1                      pop af                          ; Get return address of who called this out of the stack, we will return from the function or re-start
    3744   00:542A                      TCPIP_TCP_UDP_RETRY_QRCV:
    3745   00:542A  CD 4E 61                call    GETBYTE
    3746   00:542D  B7                      or  a
    3747   00:542E  28 0C                   jr  z,TCPIP_UDP_RCV_CHECK_TIME_OUT.NORXRETRY
    3748   00:5430                          ; Ok, so let's ask ESP to re-send the data and retry receiving it
    3749   00:5430  3D                      dec a
    3750   00:5431  CD 60 61                call    SETBYTE                 ; we are retrying it
    3751   00:5434  3E 72                   ld  a,'r'                       ; retry transmission command
    3752   00:5436                          SEND_DATA
    3752   00:5436  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3753   00:5439  C3 61 54                jp  TCPIP_UDP_RCV.RXRETRY       ; and retry it
    3754   00:543C                      TCPIP_UDP_RCV_CHECK_TIME_OUT.NORXRETRY:
    3755   00:543C  3E 0F                   ld  a,ERR_INV_OPER
    3756   00:543E  C9                      ret                             ; and return the function itself
    3757   00:543F                      
    3758   00:543F                      TCPIP_UDP_RCV:
    3759   00:543F  CD 87 61                call    SETWORD                 ; Save for later the datagram address
    3760   00:5442  3E 0C                   ld  a,12
    3761   00:5444                          SEND_DATA                       ; Send the command
    3761   00:5444  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3762   00:5447  AF                      xor a
    3763   00:5448                          SEND_DATA                       ; Send the command size msb
    3763   00:5448  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3764   00:544B  3E 03                   ld  a,3
    3765   00:544D                          SEND_DATA                       ; Send the command size lsb
    3765   00:544D  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3766   00:5450  78                      ld  a,b
    3767   00:5451                          SEND_DATA                       ; Send the connection #
    3767   00:5451  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3768   00:5454  7B                      ld  a,e
    3769   00:5455                          SEND_DATA                       ; Send MAX rcv size LSB
    3769   00:5455  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3770   00:5458  7A                      ld  a,d
    3771   00:5459                          SEND_DATA                       ; Send MAX rcv size MSB
    3771   00:5459  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3772   00:545C  3E 03                   ld  a,3
    3773   00:545E  CD 60 61                call    SETBYTE                 ; Ok, retry up to three times
    3774   00:5461                      TCPIP_UDP_RCV.RXRETRY:
    3775   00:5461                          ; Now wait up to 600 ticks to get response
    3776   00:5461  21 58 02                ld  hl,600
    3777   00:5464  CD 3E 61                call    SETCOUNTER
    3778   00:5467                      TCPIP_UDP_RCV_ST1:
    3779   00:5467                          CHECK_DATA
    3779   00:5467  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3779   00:546A  CB 47             >     bit 0,a
    3780   00:546C  20 05                   jr  nz,TCPIP_UDP_RCV_ST1.1
    3781   00:546E  CD 1D 54                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3782   00:5471  18 F4                   jr  TCPIP_UDP_RCV_ST1
    3783   00:5473                      TCPIP_UDP_RCV_ST1.1:
    3784   00:5473                          ; nz, check the data
    3785   00:5473                          RECEIVE_DATA
    3785   00:5473  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3786   00:5476  FE 0C                   cp  12                          ; Is response of our command?
    3787   00:5478  20 ED                   jr  nz,TCPIP_UDP_RCV_ST1
    3788   00:547A                          ; At this point, all data is being buffered, so 30 ticks, half second, is more than enough time-out
    3789   00:547A  F3                      di
    3790   00:547B  21 1E 00                ld  hl,30
    3791   00:547E  CD 3E 61                call    SETCOUNTER
    3792   00:5481  FB                      ei
    3793   00:5482                          ; now get return code, if return code other than 0, it is finished
    3794   00:5482                      TCPIP_UDP_RCV_RC:
