    2505   00:4E0A                      ;===================================
    2506   00:4E0A                      ;--- Implementation-specific routines addresses table
    2507   00:4E0A                      
    2508   00:4E0A                      FN_TABLE_S:
    2509   00:4E0A  42 4E               FN_0_S:                 dw  UNAPI_GET_INFO_SSH
    2510   00:4E0C  4D 4E               FN_1_S:                 dw  SSH_GET_CAPAB
    2511   00:4E0E  AD 56               FN_2_S:                 dw  SSH_OPEN
    2512   00:4E10  E0 57               FN_3_S:                 dw  SSH_CLOSE
    2513   00:4E12  32 58               FN_4_S:                 dw  SSH_STATE
    2514   00:4E14  C2 5B               FN_5_S:                 dw  SSH_SEND
    2515   00:4E16  C2 5D               FN_6_S:                 dw  SSH_RCV
    2516   00:4E18  B4 58               FN_7_S:                 dw  SSH_TERM_TYPE
    2517   00:4E1A  31 59               FN_8_S:                 dw  SSH_WIN_SIZE
    2518   00:4E1C  A2 5E               FN_9_S:                 dw  SSH_AUTH_GET_CHALLENGE
    2519   00:4E1E  23 5C               FN_10_S:                dw  SSH_AUTH_RESPOND
    2520   00:4E20  8E 57               FN_11_S:                dw  SSH_ADD_KNOWN_HOST
    2521   00:4E22                      
    2522   00:4E22                      ;========================
    2523   00:4E22                      ;===  Functions code  ===
    2524   00:4E22                      ;========================
    2525   00:4E22                      FN_NOT_IMP:
    2526   00:4E22  3E 01                   ld  a,ERR_NOT_IMP
    2527   00:4E24  C9                      ret
    2528   00:4E25                      
    2529   00:4E25                      END_OK:
    2530   00:4E25  AF                      xor a
    2531   00:4E26  C9                      ret
    2532   00:4E27                      
    2533   00:4E27                      ; Most functions do not have special handling on time out and can use this.
    2534   00:4E27                      ; If there is a need to retry sending or receiving on time-out, then a custom
    2535   00:4E27                      ; time-out function must be done, check the examples of UDP and TCP receive
    2536   00:4E27                      TCPIP_GENERIC_CHECK_TIME_OUT:
    2537   00:4E27                          ; Save registers other than AF
    2538   00:4E27  C5                      push bc
    2539   00:4E28  D5                      push de
    2540   00:4E29  E5                      push hl
    2541   00:4E2A  CD 27 61                call    GETCOUNTER
    2542   00:4E2D  7D                      ld  a,l
    2543   00:4E2E  B4                      or  h
    2544   00:4E2F                          ; Restore registers, we are returning
    2545   00:4E2F  E1                      pop hl
    2546   00:4E30  D1                      pop de
    2547   00:4E31  C1                      pop bc
    2548   00:4E32  C0                      ret nz
    2549   00:4E33                          ; Ok, timeout...
    2550   00:4E33  F1                      pop af                          ; Get return address of who called this out of the stack
    2551   00:4E34  3E 0F                   ld  a,ERR_INV_OPER
    2552   00:4E36  C9                      ret                             ; and return the function itself
    2553   00:4E37                      
    2554   00:4E37                      ;========================
    2555   00:4E37                      ;===  UNAPI_GET_INFO  ===
    2556   00:4E37                      ;========================
    2557   00:4E37                      ; Obtain the implementation name and version for TCP/IP.
    2558   00:4E37                      ;
    2559   00:4E37                      ;    Input:  A  = 0
    2560   00:4E37                      ;    Output: HL = Descriptive string for this implementation, on this slot, zero terminated
    2561   00:4E37                      ;            DE = API version supported, D.E
    2562   00:4E37                      ;            BC = This implementation version, B.C.
    2563   00:4E37                      ;            A  = 0 and Cy = 0
    2564   00:4E37                      UNAPI_GET_INFO:
    2565   00:4E37  01 03 01                ld  bc,256*ROM_V_P+ROM_V_S
    2566   00:4E3A  11 02 01                ld  de,256*API_V_P+API_V_S
    2567   00:4E3D  21 C4 72                ld  hl,APIINFO
    2568   00:4E40  AF                      xor a
    2569   00:4E41  C9                      ret
    2570   00:4E42                      
    2571   00:4E42                      ;========================
    2572   00:4E42                      ;===  UNAPI_GET_INFO  ===
    2573   00:4E42                      ;========================
    2574   00:4E42                      ; Obtain the implementation name and version for SSH.
    2575   00:4E42                      ;
    2576   00:4E42                      ;    Input:  A  = 0
    2577   00:4E42                      ;    Output: HL = Descriptive string for this implementation, on this slot, zero terminated
    2578   00:4E42                      ;            DE = API version supported, D.E
    2579   00:4E42                      ;            BC = This implementation version, B.C.
    2580   00:4E42                      ;            A  = 0 and Cy = 0
    2581   00:4E42                      UNAPI_GET_INFO_SSH:
    2582   00:4E42  01 03 01                ld  bc,256*ROM_V_P+ROM_V_S
    2583   00:4E45  11 02 01                ld  de,256*API_V_P+API_V_S
    2584   00:4E48  21 D5 72                ld  hl,APIINFO_SSH
    2585   00:4E4B  AF                      xor a
    2586   00:4E4C  C9                      ret
    2587   00:4E4D                      
    2588   00:4E4D                      ;=========================
    2589   00:4E4D                      ;===   SSH_GET_CAPAB   ===
    2590   00:4E4D                      ;=========================
    2591   00:4E4D                      ; Get information about the SSH capabilities and features.
    2592   00:4E4D                      ;
    2593   00:4E4D                      ;    Input:  A = 1
    2594   00:4E4D                      ;            B = Index of information block to retrieve:
    2595   00:4E4D                      ;                1: Block 1 (only block supported, other blocks reserved for expansion)
    2596   00:4E4D                      ;    Output: A = Error code
    2597   00:4E4D                      ;        When information block 1 requested:
    2598   00:4E4D                      ;            HL = Capabilities flags
    2599   00:4E4D                      ;            B  = Maximum simultaneous SSH connections supported
    2600   00:4E4D                      ;            C  = Free SSH connections currently available
    2601   00:4E4D                      ;            DE = Maximum data per command
    2602   00:4E4D                      SSH_GET_CAPAB:
    2603   00:4E4D                          ; SSH functions start at 127 on ESP
    2604   00:4E4D  CB FF                   set 7,a
    2605   00:4E4F                          SEND_DATA                       ; Send the command
    2605   00:4E4F  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2606   00:4E52  AF                      xor a
    2607   00:4E53                          SEND_DATA                       ; Send the command size msb
    2607   00:4E53  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2608   00:4E56  3C                      inc a
    2609   00:4E57                          SEND_DATA                       ; Send the command size lsb
    2609   00:4E57  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2610   00:4E5A  78                      ld  a,b
    2611   00:4E5B                          SEND_DATA                       ; Send the parameter
    2611   00:4E5B  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2612   00:4E5E                      
    2613   00:4E5E                          ; Now wait up to 120 ticks to get response
    2614   00:4E5E  21 78 00                ld  hl,120
    2615   00:4E61  CD 36 61                call    SETCOUNTER
    2616   00:4E64                      SSH_GET_CAPAB_ST1:
    2617   00:4E64                          CHECK_DATA
    2617   00:4E64  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2617   00:4E67  CB 47             >     bit 0,a
    2618   00:4E69  20 05                   jr  nz,SSH_GET_CAPAB_ST1.1
    2619   00:4E6B  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2620   00:4E6E  18 F4                   jr  SSH_GET_CAPAB_ST1
    2621   00:4E70                      SSH_GET_CAPAB_ST1.1:
    2622   00:4E70                          ; nz, check the data
    2623   00:4E70                          RECEIVE_DATA
    2623   00:4E70  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2624   00:4E73  FE 81                   cp  #81                         ; Is response of our command?
    2625   00:4E75  20 ED                   jr  nz,SSH_GET_CAPAB_ST1
    2626   00:4E77                          ; Now get return code, if return code other than 0, it is finished
    2627   00:4E77                      SSH_GET_CAPAB_RC:
    2628   00:4E77                          CHECK_DATA
    2628   00:4E77  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2628   00:4E7A  CB 47             >     bit 0,a
    2629   00:4E7C  20 05                   jr  nz,SSH_GET_CAPAB_RC.1
    2630   00:4E7E  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2631   00:4E81  18 F4                   jr  SSH_GET_CAPAB_RC
    2632   00:4E83                      SSH_GET_CAPAB_RC.1:
    2633   00:4E83                          ; nz, discard
    2634   00:4E83                          RECEIVE_DATA
    2634   00:4E83  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2635   00:4E86  B7                      or  a                           ; 0?
    2636   00:4E87  C0                      ret nz                          ; If not, done
    2637   00:4E88                      
    2638   00:4E88                          ; Next two bytes are size bytes, don't care
    2639   00:4E88  06 02                   ld  b,2
    2640   00:4E8A                      SSH_GET_CAPAB_ST2:
    2641   00:4E8A                          CHECK_DATA
    2641   00:4E8A  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2641   00:4E8D  CB 47             >     bit 0,a
