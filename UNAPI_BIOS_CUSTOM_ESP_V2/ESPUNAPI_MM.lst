    7377   00:657E                      ; http://map.grauw.nl/articles/vdp_tut.php
    7378   00:657E                      ; Set VDP address counter to write from address AHL (17-bits)
    7379   00:657E                      ; Enables the interrupts
    7380   00:657E                      SET_VDP_WRITE:
    7381   00:657E  CB 04                   rlc h
    7382   00:6580  17                      rla
    7383   00:6581  CB 04                   rlc h
    7384   00:6583  17                      rla
    7385   00:6584  CB 3C                   srl h
    7386   00:6586  CB 3C                   srl h
    7387   00:6588  F3                      di
    7388   00:6589  D3 99                   out (#99),a
    7389   00:658B  3E 8E                   ld  a,14+128
    7390   00:658D  D3 99                   out (#99),a
    7391   00:658F  7D                      ld  a,l
    7392   00:6590  00                      nop                             ; Do not remove this 'nop' here!
    7393   00:6591  D3 99                   out (#99),a
    7394   00:6593  7C                      ld  a,h
    7395   00:6594  F6 40                   or  64
    7396   00:6596  FB                      ei
    7397   00:6597  D3 99                   out (#99),a
    7398   00:6599  C9                      ret
    7399   00:659A                      
    7400   00:659A                      ;*********************************************
    7401   00:659A                      ;***    ESP Specific Commands/Responses    ***
    7402   00:659A                      ;*********************************************
    7403   00:659A                      ; Cold reset of ESP firmware
    7404   00:659A  (00:0052)           CMD_RESET_ESP           equ 'R'
    7405   00:659A                      ; ESP32 only, Get Board, returns board identification string
    7406   00:659A  (00:0062)           CMD_GET_FW_TYPE         equ 'b'
    7407   00:659A                      ; Warm reset of ESP firmware
    7408   00:659A  (00:0057)           CMD_WRESET_ESP          equ 'W'
    7409   00:659A                      ; Hold Wi-Fi Connection On
    7410   00:659A  (00:0048)           CMD_WIFIHOLD_ESP        equ 'H'
    7411   00:659A                      ; Release Wi-Fi Connection Hold
    7412   00:659A  (00:0068)           CMD_WIFIRELEASE_ESP     equ 'h'
    7413   00:659A                      ; Get Updated time and date from internet
    7414   00:659A  (00:0047)           CMD_GET_TIME            equ 'G'
    7415   00:659A                      ; Query Auto Clock settings
    7416   00:659A  (00:0063)           CMD_QUERY_ACLK_SETTINGS equ 'c'
    7417   00:659A                      ; Set Auto Clock settings
    7418   00:659A  (00:0043)           CMD_SET_ACLK_SETTINGS   equ 'C'
    7419   00:659A                      ; Query ESP settings
    7420   00:659A  (00:0051)           CMD_QUERY_ESP_SETTINGS  equ 'Q'
    7421   00:659A                      ; Set Timer Value
    7422   00:659A  (00:0054)           CMD_TIMER_SET           equ 'T'
    7423   00:659A                      ; Turn Nagle On
    7424   00:659A  (00:0044)           CMD_NAGLE_ON            equ 'D'
    7425   00:659A                      ; Turn Nagle Off
    7426   00:659A  (00:004E)           CMD_NAGLE_OFF           equ 'N'
    7427   00:659A                      ; Turn Wi-Fi Off
    7428   00:659A  (00:004F)           CMD_WIFI_OFF            equ 'O'
    7429   00:659A                      ; Request to connect to a network
    7430   00:659A  (00:0041)           CMD_WIFI_CONNECT        equ 'A'
    7431   00:659A                      ; Request to start network scan
    7432   00:659A  (00:0053)           CMD_SCAN_START          equ 'S'
    7433   00:659A                      ; Request network scan result
    7434   00:659A  (00:0073)           CMD_SCAN_RESULTS        equ 's'
    7435   00:659A                      ; Request AP Status
    7436   00:659A  (00:0067)           CMD_AP_STS              equ 'g'
    7437   00:659A                      ; Get ESP firmware version
    7438   00:659A  (00:0056)           CMD_GET_ESP_VER         equ 'V'
    7439   00:659A                      ; After finishing Warm reset, ESP returns ready
    7440   00:659A  52 65 61 64 79      RSP_CMD_RESET_ESP       db  "Ready"
    7441   00:659F  (00:0005)           RSP_CMD_RESET_ESP_SIZE  equ 5
    7442   00:659F                      ; Query ESP Presence
    7443   00:659F  (00:003F)           CMD_QUERY_ESP           equ '?'
    7444   00:659F                      ; Query response
    7445   00:659F  4F 4B               RSP_CMD_QUERY_ESP       db  "OK"
    7446   00:65A1  (00:0002)           RSP_CMD_QUERY_ESP_SIZE  equ 2
    7447   00:65A1                      
