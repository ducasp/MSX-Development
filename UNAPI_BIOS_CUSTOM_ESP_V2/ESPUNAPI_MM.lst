    2429   00:4DB8                      ;--- Implementation-specific routines addresses table
    2430   00:4DB8                      FN_TABLE:
    2431   00:4DB8  3F 4E               FN_0:                   dw  UNAPI_GET_INFO
    2432   00:4DBA  06 4F               FN_1:                   dw  TCPIP_GET_CAPAB
    2433   00:4DBC  5E 50               FN_2:                   dw  TCPIP_GET_IPINFO
    2434   00:4DBE  ED 50               FN_3:                   dw  TCPIP_NET_STATE
    2435   00:4DC0                      ; TCPIP_SEND_ECHO not going to be implemented, ESP do not support ping like UNAPI specify
    2436   00:4DC0  2A 4E               FN_4:                   dw  FN_NOT_IMP
    2437   00:4DC2                      ; TCPIP_RCV_ECHO not going to be implemented as SEND_ECHO is not implemented
    2438   00:4DC2  2A 4E               FN_5:                   dw  FN_NOT_IMP
    2439   00:4DC4  47 51               FN_6:                   dw  TCPIP_DNS_Q
    2440   00:4DC6  08 52               FN_7:                   dw  TCPIP_DNS_S
    2441   00:4DC8  35 52               FN_8:                   dw  TCPIP_UDP_OPEN
    2442   00:4DCA  9D 52               FN_9:                   dw  TCPIP_UDP_CLOSE
    2443   00:4DCC  ED 52               FN_10:                  dw  TCPIP_UDP_STATE
    2444   00:4DCE  8C 53               FN_11:                  dw  TCPIP_UDP_SEND
    2445   00:4DD0  3F 54               FN_12:                  dw  TCPIP_UDP_RCV
    2446   00:4DD2  90 55               FN_13:                  dw  TCPIP_TCP_OPEN
    2447   00:4DD4  65 56               FN_14:                  dw  TCPIP_TCP_CLOSE
    2448   00:4DD6  CA 59               FN_15:                  dw  TCPIP_TCP_ABORT
    2449   00:4DD8  3F 5A               FN_16:                  dw  TCPIP_TCP_STATE
    2450   00:4DDA  62 5B               FN_17:                  dw  TCPIP_TCP_SEND
    2451   00:4DDC  CB 5C               FN_18:                  dw  TCPIP_TCP_RCV
    2452   00:4DDE                      ; TCPIP_TCP_FLUSH makes no sense as we do not use buffers to send, any buffer is internal to ESP and we can't delete
    2453   00:4DDE  2A 4E               FN_19:                  dw  FN_NOT_IMP
    2454   00:4DE0                      ; TCPIP_RAW_OPEN not going to be implemented, ESP do not support RAW connections
    2455   00:4DE0  2A 4E               FN_20:                  dw  FN_NOT_IMP
    2456   00:4DE2                      ; TCPIP_RAW_CLOSE not going to be implemented, ESP do not support RAW connections
