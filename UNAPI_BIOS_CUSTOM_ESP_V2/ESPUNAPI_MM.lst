    2824   00:4F8C  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2825   00:4F8F  5F                      ld  e,a
    2826   00:4F90                      TCPIP_GET_CAPAB_BLK3_ST4:
    2827   00:4F90                          CHECK_DATA
    2827   00:4F90  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2827   00:4F93  CB 47             >     bit 0,a
    2828   00:4F95  20 05                   jr  nz,TCPIP_GET_CAPAB_BLK3_ST4.1
    2829   00:4F97  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2830   00:4F9A  18 F4                   jr  TCPIP_GET_CAPAB_BLK3_ST4
