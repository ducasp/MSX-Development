    2146   00:4C75  DD 77 00                ld  (ix+0),a                    ; Put it in the buffer
    2147   00:4C78  DD 23                   inc ix                          ; Increment pointer
    2148   00:4C7A  0D                      dec c                           ; Decrement counter
    2149   00:4C7B  AF                      xor a
    2150   00:4C7C  B1                      or  c                           ; Is counter 0?
    2151   00:4C7D                          ; If not continue getting more SSIDs
    2152   00:4C7D  20 C8                   jr  nz,WAIT_MENU_SCMD_RESPONSE_ST2B
    2153   00:4C7F                          ; It is zero, so, done
    2154   00:4C7F                      WAIT_MENU_SCMD_RESPONSE_END_OK:
    2155   00:4C7F  3E 01                   ld  a,1
    2156   00:4C81  B7                      or  a                           ; NZ to indicate success
