    5524   00:5D85                      ;========================
    5525   00:5D85                      ;===  TCPIP_TCP_SEND  ===
    5526   00:5D85                      ;========================
    5527   00:5D85                      ;Send data to a TCP connection.
    5528   00:5D85                      ;
    5529   00:5D85                      ;Input:  A  = 17
    5530   00:5D85                      ;        B  = Connection number
    5531   00:5D85                      ;        DE = Address of the data to be sent
    5532   00:5D85                      ;        HL = Length of the data to be sent
    5533   00:5D85                      ;        C  = Flags:
    5534   00:5D85                      ;             bit 0: Send the data PUSHed
    5535   00:5D85                      ;             bit 1: The data is urgent
    5536   00:5D85                      ;Output: A = Error code
    5537   00:5D85                      TCPIP_TCP_SEND:
    5538   00:5D85  E5                      push    hl
    5539   00:5D86  D5                      push    de
    5540   00:5D87                          SEND_DATA                       ; Send the command
    5540   00:5D87  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5541   00:5D8A                          ; prepare new data size, adding our 2 bytes overhead
    5542   00:5D8A  11 02 00                ld  de,2
    5543   00:5D8D  19                      add hl,de
    5544   00:5D8E  7C                      ld  a,h
    5545   00:5D8F                          SEND_DATA                       ; Send the command size msb
    5545   00:5D8F  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5546   00:5D92  7D                      ld  a,l
    5547   00:5D93                          SEND_DATA                       ; Send the command size lsb
    5547   00:5D93  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5548   00:5D96  78                      ld  a,b
    5549   00:5D97                          SEND_DATA                       ; Send the connection #
    5549   00:5D97  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5550   00:5D9A  79                      ld  a,c
    5551   00:5D9B                          SEND_DATA                       ; Send the connection flags
    5551   00:5D9B  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5552   00:5D9E  E1                      pop hl
    5553   00:5D9F  D1                      pop de
    5554   00:5DA0                          ; now oti the data starting at hl, size is in DE
    5555   00:5DA0                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    5556   00:5DA0  43                      ld  b,e                         ;Number of loops originaly in DE
    5557   00:5DA1  1B                      dec de
    5558   00:5DA2  14                      inc d
    5559   00:5DA3                          if USE_MEM_IO = 0
