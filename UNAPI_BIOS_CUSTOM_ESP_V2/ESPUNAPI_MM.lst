    5354   00:5C73                      ;=======================
    5355   00:5C73                      ;===     SSH_RCV     ===
    5356   00:5C73                      ;=======================
    5357   00:5C73                      ;Receive data from a SSH connection.
    5358   00:5C73                      ;
    5359   00:5C73                      ;Input:   A  = 6
    5360   00:5C73                      ;         B  = Connection number
    5361   00:5C73                      ;         DE = Address for the retrieved data
    5362   00:5C73                      ;         HL = Length of the data to be obtained
    5363   00:5C73                      ;Output:  A  = Error code
    5364   00:5C73                      ;         BC = Total number of bytes that have been actually retrieved
    5365   00:5C73                      ; Save registers other than AF
    5366   00:5C73                      SSH_RCV_RETRY_QRCV:
    5367   00:5C73  CD D2 5E                call    GETBYTE
    5368   00:5C76  B7                      or  a
    5369   00:5C77  28 0C                   jr  z,SSH_RCV_CHECK_TIME_OUT.NORXRETRY
    5370   00:5C79                          ; Ok, so let's ask ESP to re-send the data and retry receiving it
    5371   00:5C79  3D                      dec a
    5372   00:5C7A  CD E4 5E                call    SETBYTE                 ; we are retrying it
    5373   00:5C7D  3E 72                   ld  a,'r'                       ; retry transmission command
    5374   00:5C7F                          SEND_DATA
    5374   00:5C7F  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5375   00:5C82  C3 AC 5C                jp  SSH_RCV.RXRETRY             ; and retry it
    5376   00:5C85                      SSH_RCV_CHECK_TIME_OUT.NORXRETRY:
    5377   00:5C85  3E 0F                   ld  a,ERR_INV_OPER
    5378   00:5C87  C9                      ret                             ; and return the function itself
    5379   00:5C88                      
    5380   00:5C88                      SSH_RCV:
    5381   00:5C88  EB                      ex  de,hl
    5382   00:5C89  CD 0B 5F                call    SETWORD
    5383   00:5C8C  EB                      ex  de,hl
    5384   00:5C8D  3E 86                   ld  a,#86
    5385   00:5C8F                          SEND_DATA                       ; Send the command
    5385   00:5C8F  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5386   00:5C92  AF                      xor a
    5387   00:5C93                          SEND_DATA                       ; Send the command size msb
    5387   00:5C93  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5388   00:5C96  3E 03                   ld  a,3
    5389   00:5C98                          SEND_DATA                       ; Send the command size lsb
    5389   00:5C98  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5390   00:5C9B  78                      ld  a,b
    5391   00:5C9C                          SEND_DATA                       ; Send the connection #
    5391   00:5C9C  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5392   00:5C9F  7D                      ld  a,l
    5393   00:5CA0                          SEND_DATA                       ; Send MAX rcv size LSB
    5393   00:5CA0  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5394   00:5CA3  7C                      ld  a,h
    5395   00:5CA4                          SEND_DATA                       ; Send MAX rcv size MSB
    5395   00:5CA4  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5396   00:5CA7  3E 03                   ld  a,3
    5397   00:5CA9  CD E4 5E                call    SETBYTE                 ; Ok, retry up to three times
    5398   00:5CAC                      SSH_RCV.RXRETRY:
    5399   00:5CAC                          ; Now wait up to 600 ticks to get response
    5400   00:5CAC  21 58 02                ld  hl,600
