    1249   00:468A                          ; Otherwise it is a digit
    1250   00:468A  77                      ld  (hl),a
    1251   00:468B  79                      ld  a,c
    1252   00:468C  D6 20                   sub 32                          ; SSID maximum is 32 characters
    1253   00:468E  28 EA                   jr  z,WIFI_CONNECT_MANUAL_ENTRY
    1254   00:4690  7E                      ld  a,(hl)
    1255   00:4691  0C                      inc c
    1256   00:4692  23                      inc hl
    1257   00:4693  FE 20                   cp  32
    1258   00:4695  30 04                   jr  nc,WIFI_CONNECT_ME_CHKPRT2  ; Ok, not below space, but is it delete?
    1259   00:4697  3E 3F                   ld  a,'?'                       ; Prints a question mark
    1260   00:4699  18 06                   jr  WIFI_CONNECT_ME_CHKPRTD
    1261   00:469B                      WIFI_CONNECT_ME_CHKPRT2:
    1262   00:469B  FE 7F                   cp  #7f
    1263   00:469D  20 02                   jr  nz,WIFI_CONNECT_ME_CHKPRTD
    1264   00:469F  3E 3F                   ld  a,'?'                       ; Prints a question mark if it is delete
    1265   00:46A1                      WIFI_CONNECT_ME_CHKPRTD:
