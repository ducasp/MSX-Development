    6170   00:608E                      ;===  TCPIP_CONFIG_PING  ===
    6171   00:608E                      ;===========================
    6172   00:608E                      ;Get/set the automatic PING reply flag.
    6173   00:608E                      ;
    6174   00:608E                      ;Input:  A = 28
    6175   00:608E                      ;        B = 0: Get current flag value
    6176   00:608E                      ;            1: Set flag value (ERR_NOT_IMP)
