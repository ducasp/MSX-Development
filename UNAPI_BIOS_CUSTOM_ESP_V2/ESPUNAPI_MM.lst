    4954   00:5A37                      
    4955   00:5A37                      TCPIP_TCP_STATE:
    4956   00:5A37  CD 7F 61                call    SETWORD                 ; Save HL pointer in our memory
    4957   00:5A3A  7C                      ld  a,h
    4958   00:5A3B  B5                      or  l                           ; Information block required?
    4959   00:5A3C  3E 00                   ld  a,0                         ; do not want to mess with flags, let's say no need
    4960   00:5A3E  28 01                   jr  z,TCPIP_TCP_STATE_NOINFOBLOCK
    4961   00:5A40  3C                      inc a                           ; otherwise there is a need
    4962   00:5A41                      TCPIP_TCP_STATE_NOINFOBLOCK:
    4963   00:5A41  CD 58 61                call    SETBYTE                 ; Save for later
    4964   00:5A44  3E 10                   ld  a,16                        ; Our command
    4965   00:5A46                          SEND_DATA                       ; Send the command
    4965   00:5A46  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4966   00:5A49  AF                      xor a
    4967   00:5A4A                          SEND_DATA                       ; Send the command size msb
    4967   00:5A4A  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4968   00:5A4D  3C                      inc a
    4969   00:5A4E                          SEND_DATA                       ; Send the command size lsb
    4969   00:5A4E  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4970   00:5A51  78                      ld  a,b
    4971   00:5A52                          SEND_DATA                       ; Send the parameter
    4971   00:5A52  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4972   00:5A55                      
    4973   00:5A55                          ; Now wait up to 180 ticks to get response
    4974   00:5A55  21 B4 00                ld  hl,180
    4975   00:5A58  CD 36 61                call    SETCOUNTER
