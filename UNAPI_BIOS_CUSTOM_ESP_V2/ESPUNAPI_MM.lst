    1161   00:45FD  10 F5                   djnz    PRT_APNAMELP
    1162   00:45FF  E5                      push    hl
    1163   00:4600  21 5A 6D                ld  hl,SCAN_TERMINATOR_CUT
    1164   00:4603  CD A5 4C                call    PRINTHL
