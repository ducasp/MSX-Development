    2806   00:4F74                      TCPIP_GET_CAPAB_BLK3_ST1.1:
    2807   00:4F74                          ; nz, get it
    2808   00:4F74                          RECEIVE_DATA
    2808   00:4F74  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2809   00:4F77  6F                      ld  l,a
    2810   00:4F78                      TCPIP_GET_CAPAB_BLK3_ST2:
    2811   00:4F78                          CHECK_DATA
    2811   00:4F78  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2811   00:4F7B  CB 47             >     bit 0,a
    2812   00:4F7D  20 05                   jr  nz,TCPIP_GET_CAPAB_BLK3_ST2.1
    2813   00:4F7F  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2814   00:4F82  18 F4                   jr  TCPIP_GET_CAPAB_BLK3_ST2
    2815   00:4F84                      TCPIP_GET_CAPAB_BLK3_ST2.1:
