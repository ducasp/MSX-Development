    2394   00:4D9C  D5                      push    de
    2395   00:4D9D  5F                      ld  e,a
    2396   00:4D9E  16 00                   ld  d,0
    2397   00:4DA0  19                      add hl,de
    2398   00:4DA1  D1                      pop de
