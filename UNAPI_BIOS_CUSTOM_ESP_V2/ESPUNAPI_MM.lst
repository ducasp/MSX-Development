    6022   00:5FDC  28 0C                   jr  z,SSH_RCV_CHECK_TIME_OUT.NORXRETRY
    6023   00:5FDE                          ; Ok, so let's ask ESP to re-send the data and retry receiving it
    6024   00:5FDE  3D                      dec a
    6025   00:5FDF  CD 83 63                call    SETBYTE                 ; we are retrying it
    6026   00:5FE2  3E 72                   ld  a,'r'                       ; retry transmission command
    6027   00:5FE4                          SEND_DATA
    6027   00:5FE4  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6028   00:5FE7  C3 11 60                jp  SSH_RCV.RXRETRY             ; and retry it
    6029   00:5FEA                      SSH_RCV_CHECK_TIME_OUT.NORXRETRY:
    6030   00:5FEA  3E 0F                   ld  a,ERR_INV_OPER
