    1036   00:4506  1C                      inc e                           ; Digits printed increased
    1037   00:4507  C3 67 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; Continue waiting input
    1038   00:450A                      CLK_AUTO_GMT_CHK_CSD:
