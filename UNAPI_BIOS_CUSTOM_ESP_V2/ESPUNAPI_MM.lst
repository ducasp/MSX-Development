    1960   00:4B68  21 00 00                ld  hl,0
    1961   00:4B6B  AF                      xor a
    1962   00:4B6C  D1                      pop de
    1963   00:4B6D  C9                      ret
    1964   00:4B6E                      
    1965   00:4B6E                      ; WAIT an ESP regular command Response
    1966   00:4B6E                      ; Inputs:
    1967   00:4B6E                      ; A -> Command Code
    1968   00:4B6E                      ; HL -> Timeout
    1969   00:4B6E                      ; IX -> Where to store response
    1970   00:4B6E                      ;
    1971   00:4B6E                      ; Returns:
    1972   00:4B6E                      ; Flag Z is zero if failure, non zero if success
    1973   00:4B6E                      ; BC is the response size
    1974   00:4B6E                      ;
    1975   00:4B6E                      ; Affect:
    1976   00:4B6E                      ; AF , BC and HL
