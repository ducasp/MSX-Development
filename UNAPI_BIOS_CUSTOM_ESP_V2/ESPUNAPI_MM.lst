    1174   00:4611  7E                      ld  a,(hl)
    1175   00:4612  B7                      or  a
    1176   00:4613  CA 21 46                jp  z,PRT_APNOTENC
    1177   00:4616  E5                      push    hl
    1178   00:4617  21 68 6D                ld  hl,SCAN_TERMINATOR_ENC
    1179   00:461A  CD A5 4C                call    PRINTHL
    1180   00:461D  E1                      pop hl
    1181   00:461E  C3 29 46                jp  PRT_AP_CHKLOOP
