    4621   00:587C  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4622   00:587F  B7                      or  a                           ; 0?
    4623   00:5880  C0                      ret nz                          ; if not, done
    4624   00:5881                          ; next two bytes are response size, save to HL
    4625   00:5881                      SSH_KEY_EXPORT_SIZE_A:
    4626   00:5881                          CHECK_DATA
    4626   00:5881  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    4626   00:5884  CB 47             >     bit 0,a
