    2431   00:4DB4  56 50               FN_2:                   dw  TCPIP_GET_IPINFO
    2432   00:4DB6  E5 50               FN_3:                   dw  TCPIP_NET_STATE
    2433   00:4DB8                      ; TCPIP_SEND_ECHO not going to be implemented, ESP do not support ping like UNAPI specify
    2434   00:4DB8  22 4E               FN_4:                   dw  FN_NOT_IMP
    2435   00:4DBA                      ; TCPIP_RCV_ECHO not going to be implemented as SEND_ECHO is not implemented
    2436   00:4DBA  22 4E               FN_5:                   dw  FN_NOT_IMP
    2437   00:4DBC  3F 51               FN_6:                   dw  TCPIP_DNS_Q
    2438   00:4DBE  00 52               FN_7:                   dw  TCPIP_DNS_S
