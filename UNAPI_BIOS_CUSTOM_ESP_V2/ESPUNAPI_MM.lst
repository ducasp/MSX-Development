    1660   00:494A                      ;===  SETUP Menu Routines  ==
    1661   00:494A                      ;===  Auxiliary Functions  ==
    1662   00:494A                      ;============================
    1663   00:494A                      SET_ESP_WIFI_TIMEOUT:
    1664   00:494A  EB                      ex  de,hl
    1665   00:494B  3E 0D                   ld  a,#0d
    1666   00:494D  CD A2 00                call    CHPUT
    1667   00:4950  3E 0A                   ld  a,#0a
    1668   00:4952  CD A2 00                call    CHPUT
    1669   00:4955  21 62 70                ld  hl,STR_SENDING              ; Indicate it is sending a command
