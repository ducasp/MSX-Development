    2458   00:4DE4                      ; TCPIP_RAW_STATE not going to be implemented, ESP do not support RAW connections
    2459   00:4DE4  2A 4E               FN_22:                  dw  FN_NOT_IMP
    2460   00:4DE6                      ; TCPIP_RAW_SEND not going to be implemented, ESP do not support RAW connections
    2461   00:4DE6  2A 4E               FN_23:                  dw  FN_NOT_IMP
    2462   00:4DE8                      ; TCPIP_RAW_RCV not going to be implemented, ESP do not support RAW connections
    2463   00:4DE8  2A 4E               FN_24:                  dw  FN_NOT_IMP
    2464   00:4DEA  CF 5F               FN_25:                  dw  TCPIP_CONFIG_AUTOIP
    2465   00:4DEC  33 60               FN_26:                  dw  TCPIP_CONFIG_IP
    2466   00:4DEE  7C 60               FN_27:                  dw  TCPIP_CONFIG_TTL
    2467   00:4DF0  8E 60               FN_28:                  dw  TCPIP_CONFIG_PING
    2468   00:4DF2                      ; TCPIP_WAIT not needed for our implementation
    2469   00:4DF2  2D 4E               FN_29:                  dw  END_OK
