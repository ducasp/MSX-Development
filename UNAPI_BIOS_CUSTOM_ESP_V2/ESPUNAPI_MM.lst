    5310   00:5C3D                      ;             (0 if not needed)
    5311   00:5C3D                      ;Output: A  = Error code
    5312   00:5C3D                      ;        B  = Connection state
    5313   00:5C3D                      ;        C  = Close reason (only if ERR_NO_CONN is returned)
    5314   00:5C3D                      ;        HL = Number of total available incoming bytes
    5315   00:5C3D                      ;        DE = Number of urgent available incoming bytes
    5316   00:5C3D                      ;        IX = Available free space in the output buffer
    5317   00:5C3D                      ;             (0FFFFh = infinite)
    5318   00:5C3D                      ;
    5319   00:5C3D                      ;Connection information block consists of:
    5320   00:5C3D                      ;
    5321   00:5C3D                      ;    +0 (4): Remote IP address
    5322   00:5C3D                      ;    +4 (2): Remote port
    5323   00:5C3D                      ;    +6 (2): Local port
    5324   00:5C3D                      TCPIP_TCP_STATE_ERROR:
    5325   00:5C3D                          ; next two bytes are size bytes, don't care
    5326   00:5C3D  47                      ld  b,a                         ; save error in b
    5327   00:5C3E  0E 02                   ld  c,2
