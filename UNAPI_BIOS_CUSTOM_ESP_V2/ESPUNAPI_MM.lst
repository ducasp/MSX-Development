    5457   00:5D1B                          ; nz, get it
    5458   00:5D1B                          RECEIVE_DATA
    5458   00:5D1B  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5459   00:5D1E  57                      ld  d,a
    5460   00:5D1F                      TCPIP_TCP_STATE_RESP_ST7:
    5461   00:5D1F                          CHECK_DATA
    5461   00:5D1F  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5461   00:5D22  CB 47             >     bit 0,a
    5462   00:5D24  20 05                   jr  nz,TCPIP_TCP_STATE_RESP_ST7.1
    5463   00:5D26  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5464   00:5D29  18 F4                   jr  TCPIP_TCP_STATE_RESP_ST7
    5465   00:5D2B                      TCPIP_TCP_STATE_RESP_ST7.1:
    5466   00:5D2B                          ; nz, get it
