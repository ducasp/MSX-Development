    5395   00:5C8C                      ;=======================
    5396   00:5C8C                      ;===  TCPIP_TCP_RCV  ===
    5397   00:5C8C                      ;=======================
    5398   00:5C8C                      ;Receive data from a TCP connection.
    5399   00:5C8C                      ;
    5400   00:5C8C                      ;Input:   A  = 18
    5401   00:5C8C                      ;         B  = Connection number
    5402   00:5C8C                      ;         DE = Address for the retrieved data
    5403   00:5C8C                      ;         HL = Length of the data to be obtained
    5404   00:5C8C                      ;Output:  A  = Error code
    5405   00:5C8C                      ;         BC = Total number of bytes that have been actually retrieved
    5406   00:5C8C                      ;         HL = Number of urgent data bytes that have been retrieved
    5407   00:5C8C                      ;              (placed at the beginning of the received data block)
    5408   00:5C8C                      ; Save registers other than AF
    5409   00:5C8C                      TCPIP_TCP_RCV_CHECK_TIME_OUT:
    5410   00:5C8C  C5                      push bc
    5411   00:5C8D  D5                      push de
    5412   00:5C8E  E5                      push hl
    5413   00:5C8F  CD 2F 61                call    GETCOUNTER
    5414   00:5C92  7D                      ld  a,l
    5415   00:5C93  B4                      or  h
    5416   00:5C94                          ; Restore registers, we are returning
    5417   00:5C94  E1                      pop hl
    5418   00:5C95  D1                      pop de
    5419   00:5C96  C1                      pop bc
    5420   00:5C97  C0                      ret nz
    5421   00:5C98                          ; Ok, timeout...
    5422   00:5C98  F1                      pop af                          ; Get return address of who called this out of the stack, we will return from the function or re-start
    5423   00:5C99                      TCPIP_TCP_RCV_RETRY_QRCV:
    5424   00:5C99  CD 4E 61                call    GETBYTE
    5425   00:5C9C  B7                      or  a
    5426   00:5C9D  28 0C                   jr  z,TCPIP_TCP_RCV_CHECK_TIME_OUT.NORXRETRY
    5427   00:5C9F                          ; Ok, so let's ask ESP to re-send the data and retry receiving it
    5428   00:5C9F  3D                      dec a
    5429   00:5CA0  CD 60 61                call    SETBYTE                 ; we are retrying it
    5430   00:5CA3  3E 72                   ld  a,'r'                       ; retry transmission command
    5431   00:5CA5                          SEND_DATA
    5431   00:5CA5  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5432   00:5CA8  C3 EF 5C                jp  TCPIP_TCP_RCV.RXRETRY       ; and retry it
    5433   00:5CAB                      TCPIP_TCP_RCV_CHECK_TIME_OUT.NORXRETRY:
    5434   00:5CAB  3E 0F                   ld  a,ERR_INV_OPER
    5435   00:5CAD  C9                      ret                             ; and return the function itself
    5436   00:5CAE                      
    5437   00:5CAE                      TCPIP_TCP_RCV_RET_ERR:
    5438   00:5CAE                          ; next two bytes are size bytes, don't care
    5439   00:5CAE  47                      ld  b,a                         ; save error in b
    5440   00:5CAF  0E 02                   ld  c,2
    5441   00:5CB1                      TCPIP_TCP_RCV_RET_ERR2:
    5442   00:5CB1                          CHECK_DATA
    5442   00:5CB1  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5442   00:5CB4  CB 47             >     bit 0,a
    5443   00:5CB6  20 05                   jr  nz,TCPIP_TCP_RCV_RET_ERR2.1
    5444   00:5CB8  CD 8C 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5445   00:5CBB  18 F4                   jr  TCPIP_TCP_RCV_RET_ERR2
    5446   00:5CBD                      TCPIP_TCP_RCV_RET_ERR2.1:
    5447   00:5CBD                          ; nz, discard
    5448   00:5CBD                          RECEIVE_DATA
    5448   00:5CBD  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5449   00:5CC0  0D                      dec c
    5450   00:5CC1  20 EE                   jr  nz,TCPIP_TCP_RCV_RET_ERR2
    5451   00:5CC3                          ; now return w/ error that is saved in b
    5452   00:5CC3  78                      ld  a,b
    5453   00:5CC4                      TCPIP_TCP_RCV_RET_NODATA:
    5454   00:5CC4  21 00 00                ld  hl,0
    5455   00:5CC7  01 00 00                ld  bc,0
    5456   00:5CCA  C9                      ret
    5457   00:5CCB                      
    5458   00:5CCB                      TCPIP_TCP_RCV:
    5459   00:5CCB  EB                      ex  de,hl
    5460   00:5CCC  CD 87 61                call    SETWORD
    5461   00:5CCF  EB                      ex  de,hl
    5462   00:5CD0  3E 12                   ld  a,18
    5463   00:5CD2                          SEND_DATA                       ; Send the command
    5463   00:5CD2  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5464   00:5CD5  AF                      xor a
    5465   00:5CD6                          SEND_DATA                       ; Send the command size msb
    5465   00:5CD6  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5466   00:5CD9  3E 03                   ld  a,3
    5467   00:5CDB                          SEND_DATA                       ; Send the command size lsb
    5467   00:5CDB  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5468   00:5CDE  78                      ld  a,b
    5469   00:5CDF                          SEND_DATA                       ; Send the connection #
    5469   00:5CDF  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5470   00:5CE2  7D                      ld  a,l
    5471   00:5CE3                          SEND_DATA                       ; Send MAX rcv size LSB
    5471   00:5CE3  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5472   00:5CE6  7C                      ld  a,h
    5473   00:5CE7                          SEND_DATA                       ; Send MAX rcv size MSB
    5473   00:5CE7  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5474   00:5CEA  3E 03                   ld  a,3
    5475   00:5CEC  CD 60 61                call    SETBYTE                 ; Ok, retry up to three times
    5476   00:5CEF                      TCPIP_TCP_RCV.RXRETRY:
    5477   00:5CEF                          ; Now wait up to 600 ticks to get response
    5478   00:5CEF  21 58 02                ld  hl,600
    5479   00:5CF2  CD 3E 61                call    SETCOUNTER
    5480   00:5CF5                      TCPIP_TCP_RCV_ST1:
    5481   00:5CF5                          CHECK_DATA
    5481   00:5CF5  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5481   00:5CF8  CB 47             >     bit 0,a
    5482   00:5CFA  20 05                   jr  nz,TCPIP_TCP_RCV_ST1.1
    5483   00:5CFC  CD 8C 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5484   00:5CFF  18 F4                   jr  TCPIP_TCP_RCV_ST1
    5485   00:5D01                      TCPIP_TCP_RCV_ST1.1:
    5486   00:5D01                          ; nz, check the data
    5487   00:5D01                          RECEIVE_DATA
    5487   00:5D01  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5488   00:5D04  FE 12                   cp 18                           ; Is response of our command?
    5489   00:5D06  20 ED                   jr  nz,TCPIP_TCP_RCV_ST1
    5490   00:5D08                          ; At this point, all data is being buffered, so 15 ticks, quarter second, is more than enough time-out
    5491   00:5D08  F3                      di
    5492   00:5D09  21 1E 00                ld  hl,30
    5493   00:5D0C  CD 3E 61                call    SETCOUNTER
    5494   00:5D0F  FB                      ei
    5495   00:5D10                          ; now get return code, if return code other than 0, it is finished
    5496   00:5D10                      TCPIP_TCP_RCV_RC:
    5497   00:5D10                          CHECK_DATA
    5497   00:5D10  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5497   00:5D13  CB 47             >     bit 0,a
    5498   00:5D15  20 05                   jr  nz,TCPIP_TCP_RCV_RC.1
    5499   00:5D17  CD 8C 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5500   00:5D1A  18 F4                   jr  TCPIP_TCP_RCV_RC
    5501   00:5D1C                      TCPIP_TCP_RCV_RC.1:
    5502   00:5D1C                          ; nz, discard
    5503   00:5D1C                          RECEIVE_DATA
    5503   00:5D1C  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5504   00:5D1F  B7                      or  a                           ; 0?
    5505   00:5D20  20 8C                   jr  nz,TCPIP_TCP_RCV_RET_ERR    ; if not, done
    5506   00:5D22                          ; next two bytes are response size bytes (UB count two bytes, always 0, and data read), save it -2 to BC
    5507   00:5D22                      TCPIP_TCP_RCV_ST2A:
    5508   00:5D22                          CHECK_DATA
    5508   00:5D22  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5508   00:5D25  CB 47             >     bit 0,a
    5509   00:5D27  20 05                   jr  nz,TCPIP_TCP_RCV_ST2A.1
    5510   00:5D29  CD 8C 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5511   00:5D2C  18 F4                   jr  TCPIP_TCP_RCV_ST2A
    5512   00:5D2E                      TCPIP_TCP_RCV_ST2A.1:
    5513   00:5D2E                          ; nz, high byte count of bytes to receive
    5514   00:5D2E                          RECEIVE_DATA
    5514   00:5D2E  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5515   00:5D31  67                      ld h,a
    5516   00:5D32                      TCPIP_TCP_RCV_ST2B:
    5517   00:5D32                          CHECK_DATA
    5517   00:5D32  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5517   00:5D35  CB 47             >     bit 0,a
    5518   00:5D37  20 05                   jr  nz,TCPIP_TCP_RCV_ST2B.1
    5519   00:5D39  CD 8C 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5520   00:5D3C  18 F4                   jr  TCPIP_TCP_RCV_ST2B
    5521   00:5D3E                      TCPIP_TCP_RCV_ST2B.1:
    5522   00:5D3E                          ; nz, low byte count of bytes to receive
    5523   00:5D3E                          RECEIVE_DATA
    5523   00:5D3E  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5524   00:5D41  6F                      ld  l,a
    5525   00:5D42  01 02 00                ld  bc,2
    5526   00:5D45                          ; subtract 2 (Urgent data count, not used)
    5527   00:5D45  AF                      xor a                           ; zero carry
    5528   00:5D46  ED 42                   sbc hl,bc
    5529   00:5D48                          ; if it was 0, will carry
    5530   00:5D48                          if USE_MEM_IO = 1
    5531   00:5D48  DA C4 5C                jp  c,TCPIP_TCP_RCV_RET_NODATA
    5532   00:5D4B                          else
    5533   00:5D4B                    ~     jr  c,TCPIP_TCP_RCV_RET_NODATA
    5534   00:5D4B                    ~     endif
    5535   00:5D4B  4D                      ld  c,l
    5536   00:5D4C  44                      ld  b,h                         ; BC has effective received data size, as well as HL
    5537   00:5D4D                      
    5538   00:5D4D                          ; now just discard 2 bytes urgent data
    5539   00:5D4D                      TCPIP_TCP_RCV_UDC_ST1:
    5540   00:5D4D                          CHECK_DATA
    5540   00:5D4D  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5540   00:5D50  CB 47             >     bit 0,a
    5541   00:5D52  20 05                   jr  nz,TCPIP_TCP_RCV_UDC_ST1.1
    5542   00:5D54  CD 8C 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5543   00:5D57  18 F4                   jr  TCPIP_TCP_RCV_UDC_ST1
    5544   00:5D59                      TCPIP_TCP_RCV_UDC_ST1.1:
    5545   00:5D59                          ; nz, get it
    5546   00:5D59                          RECEIVE_DATA
    5546   00:5D59  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5547   00:5D5C                      TCPIP_TCP_RCV_UDC_ST2:
    5548   00:5D5C                          CHECK_DATA
    5548   00:5D5C  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5548   00:5D5F  CB 47             >     bit 0,a
    5549   00:5D61  20 05                   jr  nz,TCPIP_TCP_RCV_UDC_ST2.1
    5550   00:5D63  CD 8C 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5551   00:5D66  18 F4                   jr  TCPIP_TCP_RCV_UDC_ST2
    5552   00:5D68                      TCPIP_TCP_RCV_UDC_ST2.1:
    5553   00:5D68                          ; nz, get it
