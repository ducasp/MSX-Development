    6287   00:6021                      ;*********************************************
    6288   00:6021                      ;***       WAIT_RESPONSE_FROM_ESP          ***
    6289   00:6021                      ;*** Will wait ESP to send a response,     ***
    6290   00:6021                      ;*** discarding all data until it is found.***
    6291   00:6021                      ;***                                       ***
    6292   00:6021                      ;*** Inputs:                               ***
    6293   00:6021                      ;*** HL - Expected response string         ***
    6294   00:6021                      ;*** A - Response Size                     ***
    6295   00:6021                      ;*** DE - TimeOut in ticks                 ***
    6296   00:6021                      ;***                                       ***
    6297   00:6021                      ;*** Output:                               ***
    6298   00:6021                      ;*** A - 0 if response received            ***
    6299   00:6021                      ;*** otherwise response not received and   ***
    6300   00:6021                      ;*** timed-out.                            ***
    6301   00:6021                      ;***                                       ***
    6302   00:6021                      ;*** Changes HL, BC, AF, DE, IX            ***
    6303   00:6021                      ;*********************************************
    6304   00:6021                      WRFE_WAIT_DATA:
    6305   00:6021                          LOAD_STS_PORT_IN_A
    6305   00:6021  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6306   00:6024  CB 6F                   bit 5,a                         ; If nz Port #07 is not available
    6307   00:6026  20 06                   jr  nz,WRFE_STS_NOT_AVAILABLE
    6308   00:6028  CB 47                   bit 0,a                         ; if nz has data
    6309   00:602A  C0                      ret nz
    6310   00:602B  1B                      dec de
    6311   00:602C  76                      halt
    6312   00:602D  C9                      ret
    6313   00:602E                      WRFE_STS_NOT_AVAILABLE:
    6314   00:602E  11 00 00                ld  de,0
    6315   00:6031  AF                      xor a
    6316   00:6032  C9                      ret
    6317   00:6033                      
    6318   00:6033                      WRFE_COMPARE:
    6319   00:6033  47                      ld  b,a
    6320   00:6034  7E                      ld  a,(hl)
    6321   00:6035  B8                      cp  b
    6322   00:6036  C0                      ret nz
    6323   00:6037  23                      inc hl
    6324   00:6038  C9                      ret
    6325   00:6039                      
    6326   00:6039                      WAIT_RESPONSE_FROM_ESP:
    6327   00:6039  4F                      ld  c,a                         ; Response size in C
    6328   00:603A  E5                      push    hl                      ; Save HL
    6329   00:603B  AF                      xor a
    6330   00:603C                      WRFE_ST1:
    6331   00:603C  DD 67                   ld  ixh,a                       ; We start at index 0
    6332   00:603E                      
    6333   00:603E                      WRFE_LOOP:
    6334   00:603E  CD 21 60                call    WRFE_WAIT_DATA
    6335   00:6041  20 07                   jr  nz,WRFE_LOOP.1
    6336   00:6043  7B                      ld  a,e
    6337   00:6044  B2                      or  d
    6338   00:6045  CA 65 60                jp  z,WRFE_RET_ERROR
    6339   00:6048  18 F4                   jr  WRFE_LOOP
    6340   00:604A                      WRFE_LOOP.1:
    6341   00:604A                          ; nz, check the data
    6342   00:604A                          RECEIVE_DATA
    6342   00:604A  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6343   00:604D                          ; Ok, now the byte is in A, let's compare
    6344   00:604D                      WRFE_IDXCMD:
    6345   00:604D  CD 33 60                call WRFE_COMPARE
    6346   00:6050                          ; if match
    6347   00:6050  28 07                   jr  z,WRFE_RSP_MATCH
    6348   00:6052                          ; did not match, let's zero the rsp index
    6349   00:6052  AF                      xor a
    6350   00:6053  DD 67                   ld  ixh,a                       ; re-start at index 0
    6351   00:6055  E1                      pop hl                          ; restore the response index
    6352   00:6056  E5                      push    hl                      ; and keep it in stack
    6353   00:6057                          ; back to get another byte
    6354   00:6057  18 E5                   jr  WRFE_LOOP
    6355   00:6059                      WRFE_RSP_MATCH:
    6356   00:6059                          ; match
    6357   00:6059  DD 24                   inc ixh
    6358   00:605B  DD 7C                   ld  a,ixh
    6359   00:605D  B9                      cp  c
    6360   00:605E                          ; if a = c done and response is success
    6361   00:605E  28 02                   jr  z,WRFE_RET_OK
    6362   00:6060                          ; not done, back to get more bytes
    6363   00:6060  18 DC                   jr  WRFE_LOOP
    6364   00:6062                      WRFE_RET_OK:
    6365   00:6062  E1                      pop hl
    6366   00:6063  AF                      xor a
    6367   00:6064  C9                      ret
    6368   00:6065                      WRFE_RET_ERROR:
    6369   00:6065  E1                      pop hl
    6370   00:6066  3E 01                   ld  a,1
    6371   00:6068  C9                      ret
    6372   00:6069                      
    6373   00:6069                      ;*********************************************
    6374   00:6069                      ;***            CHECK_ESP_TYPE             ***
    6375   00:6069                      ;*** If ESP32, NZ will be set and A = 1, if***
    6376   00:6069                      ;*** not NZ will be reset and A=0          ***
    6377   00:6069                      ;*********************************************
    6378   00:6069                      CHECK_ESP_TYPE:
    6379   00:6069  E5                      push    hl
    6380   00:606A  D5                      push    de
    6381   00:606B  FD E5                   push    iy
    6382   00:606D  DD E5                   push    ix
    6383   00:606F                          CLEAR_UART                      ; Clear UART
    6383   00:606F  3E 14             >     ld  a,20
    6383   00:6071  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    6384   00:6074  3E 62                   ld  a,CMD_GET_FW_TYPE
    6385   00:6076                          SEND_DATA
    6385   00:6076  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6386   00:6079  21 06 00                ld  hl,6                        ; Wait up to 100ms
    6387   00:607C  ED 5B 76 F6             ld  de,(TXTTAB)                 ; Borrow Basic program area for now....
    6388   00:6080  DD 6B                   ld  ixl,e
    6389   00:6082  DD 62                   ld  ixh,d                       ; Address in IX
    6390   00:6084  CD 6E 4B                call    WAIT_MENU_CMD_RESPONSE
    6391   00:6087  F5                      push    af
    6392   00:6088  CD 22 5E                call    GETSLT
    6393   00:608B  CD 8F 5E                call    GETMEMPOINTERADDR       ; This is where we are going to store our memory area address
    6394   00:608E  11 07 00                ld  de,7
    6395   00:6091  19                      add hl,de
    6396   00:6092  F1                      pop af
    6397   00:6093  77                      ld  (hl),a
    6398   00:6094  B7                      or  a
    6399   00:6095  DD E1                   pop ix
    6400   00:6097  FD E1                   pop iy
    6401   00:6099  D1                      pop de
    6402   00:609A  E1                      pop hl
    6403   00:609B  C9                      ret
    6404   00:609C                      
    6405   00:609C                      ;*********************************************
    6406   00:609C                      ;***              RESET ESP                ***
    6407   00:609C                      ;*** If RESET ok, A will be 0, otherwise   ***
    6408   00:609C                      ;*** failure                               ***
    6409   00:609C                      ;*********************************************
    6410   00:609C                      RESET_ESP:
    6411   00:609C                          ; Is ESP installed?
    6412   00:609C                          CLEAR_UART                      ; Clear UART
    6412   00:609C  3E 14             >     ld  a,20
    6412   00:609E  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    6413   00:60A1  3E 3F                   ld  a,CMD_QUERY_ESP
    6414   00:60A3                          SEND_DATA
    6414   00:60A3  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6415   00:60A6  21 3B 62                ld  hl,RSP_CMD_QUERY_ESP        ; Expected response
    6416   00:60A9  11 3C 00                ld  de,60                       ; Up to 1s @ 60Hz
    6417   00:60AC  3E 02                   ld  a,RSP_CMD_QUERY_ESP_SIZE    ; Size of response
    6418   00:60AE  CD 39 60                call    WAIT_RESPONSE_FROM_ESP
    6419   00:60B1  B7                      or  a
    6420   00:60B2  3E 01                   ld  a,1
    6421   00:60B4  28 03                   jr  z,RESET_ESP_INIT            ; ESP Found
    6422   00:60B6  06 00                   ld  b,0                         ; 0 if no response
    6423   00:60B8  C9                      ret
    6424   00:60B9                      RESET_ESP_INIT:
    6425   00:60B9  06 03                   ld  b,3                         ; Retry up to 10 times
    6426   00:60BB                      RESET_ESP_LOOP:
    6427   00:60BB                          CLEAR_UART
    6427   00:60BB  3E 14             >     ld  a,20
    6427   00:60BD  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    6428   00:60C0                          SET_SPEED
    6428   00:60C0  AF                >     xor a
    6428   00:60C1  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    6429   00:60C4  76                      halt
    6430   00:60C5  76                      halt                            ; Wait a little to make sure speed is adjusted
    6431   00:60C6  3E 57                   ld  a,CMD_WRESET_ESP
    6432   00:60C8                          SEND_DATA
    6432   00:60C8  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6433   00:60CB  21 36 62                ld  hl,RSP_CMD_RESET_ESP        ; Expected response
    6434   00:60CE  11 5A 00                ld  de,90                       ; Up to 1.5s @ 60Hz
    6435   00:60D1  3E 05                   ld  a,RSP_CMD_RESET_ESP_SIZE    ; Size of response
    6436   00:60D3  C5                      push    bc                      ; Save retry counter
    6437   00:60D4  CD 39 60                call    WAIT_RESPONSE_FROM_ESP
    6438   00:60D7  C1                      pop bc                          ; restore retry counter
    6439   00:60D8  B7                      or  a                           ; Did WAIT RESPONSE return zero?
    6440   00:60D9  C8                      ret z                           ; Yes, Warm Reset Ok
    6441   00:60DA  10 DF                   djnz RESET_ESP_LOOP             ; No, decrement retry counter and let the loop check
    6442   00:60DC                          ; No more retries? Then check if it is old ESP FW
    6443   00:60DC                      RESET_CHK_IF_INSTALLED:
    6444   00:60DC                          ; No more retries? Then it is old ESP FW
    6445   00:60DC  06 01                   ld  b,1
    6446   00:60DE  C9                      ret
    6447   00:60DF                      
    6448   00:60DF                      ;*********************************************
    6449   00:60DF                      ;***              SET TIME                 ***
    6450   00:60DF                      ;*** H - Hour                              ***
    6451   00:60DF                      ;*** L - Minutes                           ***
    6452   00:60DF                      ;*** D - Seconds                           ***
    6453   00:60DF                      ;***                                       ***
    6454   00:60DF                      ;*** A - 0 if Ok otherwise invalid time    ***
    6455   00:60DF                      ;*********************************************
    6456   00:60DF                      SET_TIME:
    6457   00:60DF  7C                      ld  a,h                         ; Hour in A
    6458   00:60E0  FE 18                   cp  24                          ; Compare to 24
    6459   00:60E2  30 12                   jr  nc,SET_TIME_ERR             ; If 24 or more, invalid
    6460   00:60E4  7D                      ld  a,l                         ; Minutes in A
    6461   00:60E5  FE 3C                   cp  60                          ; Compare to 60
    6462   00:60E7  30 0D                   jr  nc,SET_TIME_ERR             ; If 60 or more, invalid
    6463   00:60E9  7A                      LD  a,d                         ; Seconds in D
    6464   00:60EA  FE 3C                   cp  60                          ; Compare to 60
    6465   00:60EC  30 08                   jr  nc,SET_TIME_ERR             ; If 60 or more invalid
    6466   00:60EE  44                      ld  b,h                         ; Hour in B
    6467   00:60EF  4D                      ld  c,l                         ; Minutes in C
    6468   00:60F0  5A                      ld  e,d                         ; Seconds in E
    6469   00:60F1  CD F9 60                call    SET_RTC_TIME            ; Set time in RTC
    6470   00:60F4  AF                      xor a                           ; 0 in A
    6471   00:60F5  C9                      ret                             ; Return
    6472   00:60F6                      ;   Invalid parameter
    6473   00:60F6                      SET_TIME_ERR:
    6474   00:60F6  3E 01                   ld  a,1                         ; Invalid Time
    6475   00:60F8  C9                      ret                             ; Return
    6476   00:60F9                      
    6477   00:60F9                      SET_RTC_TIME:
    6478   00:60F9  6B                      ld  l,e                         ; Seconds in L
    6479   00:60FA  61                      ld  h,c                         ; Minutes in H
    6480   00:60FB  50                      ld  d,b                         ; Hour in D
    6481   00:60FC  CD 54 61                call    STOP_RTC_COUNT_SET_MODE0; Select RTC Register 13, and set Mode / Page 0
    6482   00:60FF  3E 0F                   ld  a,#F                        ; Register F
    6483   00:6101  D3 B4                   out (#B4),a
    6484   00:6103  3E 02                   ld  a,2
    6485   00:6105  D3 B5                   out (#B5),a                     ; Timer reset seconds and on both clock pulses
    6486   00:6107  1E 00                   ld  e,0                         ; Start at register 0
    6487   00:6109  C3 8F 61                jp  SET_RTC_DATE.1              ; And save L, H and D, function will return from there
    6488   00:610C                      
    6489   00:610C                      ;*********************************************
    6490   00:610C                      ;***              SET DATE                 ***
    6491   00:610C                      ;*** HL - Year from 1980 to 2079           ***
    6492   00:610C                      ;*** D - Month from 1 to 12                ***
    6493   00:610C                      ;*** E - Day from 1 to 31                  ***
    6494   00:610C                      ;***                                       ***
    6495   00:610C                      ;*** A - 0 if Ok otherwise invalid Date    ***
    6496   00:610C                      ;*********************************************
    6497   00:610C                      SET_DATE:
    6498   00:610C  01 44 F8                ld  bc,#F844
    6499   00:610F  09                      add hl,bc
    6500   00:6110  30 32                   jr  nc,SET_DATE_ERR             ; No carry -> Year is less than 1980, invalid date
    6501   00:6112  7C                      ld  a,h
    6502   00:6113  B7                      or  a
    6503   00:6114  20 2E                   jr  nz,SET_DATE_ERR             ; If H is set, means year is greater than 2235 ,invalid
    6504   00:6116  7D                      ld  a,l
    6505   00:6117  FE 64                   cp  100
    6506   00:6119  30 29                   jr  nc,SET_DATE_ERR             ; If L >= 100 year is greater than 2079, invalid
    6507   00:611B  47                      ld  b,a                         ; Year - 1980 in B
    6508   00:611C  7A                      ld  a,d                         ; Now test month
    6509   00:611D  3D                      dec a
    6510   00:611E  FE 0C                   cp  12                          ; If 12 or less this should carry
    6511   00:6120  30 22                   jr  nc,SET_DATE_ERR             ; otherwise invalid
    6512   00:6122  21 47 61                ld  hl,DAYS_IN_MONTH            ; Days in Month table
    6513   00:6125  85                      add a,l                         ; add our month
    6514   00:6126  6F                      ld  l,a                         ; back in L
    6515   00:6127  30 01                   jr  nc,SET_DATE1                ; no carry done
    6516   00:6129  24                      inc h                           ; otherwise increase H
    6517   00:612A                      SET_DATE1:
    6518   00:612A  3E 1C                   ld  a,28                        ; 28 days
    6519   00:612C  BE                      cp  (hl)                        ; If month is 28 days, February, need to check if leap and limit is 29 in this year
    6520   00:612D  20 08                   jr  nz,SET_DATE2                ; if not, skip below code , so probably above check is if month is february
    6521   00:612F  78                      ld  a,b                         ; Year - 1980 in A again
    6522   00:6130  E6 03                   and 3                           ; if other than 0, non divisible per 4, so not a leap year
    6523   00:6132  20 03                   jr  nz,SET_DATE2                ; Regular year
    6524   00:6134  21 53 61                ld  hl,DAYS_IN_FEBRUARY_LEAP    ; HL has address of 29 days, maximum number of days for february in leap year
    6525   00:6137                      SET_DATE2:
    6526   00:6137  7B                      ld  a,e                         ; Day of month in A
    6527   00:6138  3D                      dec a                           ; Decrement
    6528   00:6139  BE                      cp  (hl)                        ; Compare with Days in month
    6529   00:613A  30 08                   jr  nc,SET_DATE_ERR             ; If day is greater than how many days in month, invalid
    6530   00:613C  6B                      ld  l,e                         ; Day of month in L
    6531   00:613D  62                      ld  h,d                         ; Month in H
    6532   00:613E  50                      ld  d,b                         ; Year - 1980 in D
    6533   00:613F  CD 79 61                call    SET_RTC_DATE            ; Set date in RTC
    6534   00:6142  AF                      xor a                           ; A = 0
    6535   00:6143  C9                      ret                             ; Success
    6536   00:6144                      ;   Invalid parameter
    6537   00:6144                      SET_DATE_ERR:
    6538   00:6144  3E 01                   ld  a,1
    6539   00:6146  C9                      ret
    6540   00:6147                      
    6541   00:6147                      ; Table of top day value for each month
    6542   00:6147                      DAYS_IN_MONTH:          db  31,28,31,30,31,30,31,31,30,31,30,31
    6542   00:6147  1F 1C 1F 1E 1F 1E 1F 1F 1E 1F 1E 1F 
    6543   00:6153                      ; And top day value in February when Leap Year
    6544   00:6153  1D                  DAYS_IN_FEBRUARY_LEAP:  db  29
    6545   00:6154                      
    6546   00:6154                      ; Will select Mode 00 (Date and Time page) and stop clock counting
    6547   00:6154                      ; Register D value will be left in A
    6548   00:6154                      STOP_RTC_COUNT_SET_MODE0:
    6549   00:6154  3E 0D                   ld  a,#D
    6550   00:6156  D3 B4                   out (#B4),a                     ; Select RTC register D (mode)
    6551   00:6158  DB B5                   in  a,(#B5)                     ; read register D
    6552   00:615A  E6 04                   and 4                           ; Save Alarm EN setting, and mode register is 00 and stop counting time
    6553   00:615C  D3 B5                   out (#B5),a                     ; And save
    6554   00:615E  C9                      ret
    6555   00:615F                      
    6556   00:615F                      ; Will get a non BCD value in A, convert it to BCD and then save it in
    6557   00:615F                      ; a register pair that starts in the register indicated in E
    6558   00:615F                      ; Register E will have the next register after that register pair
    6559   00:615F                      RTC_SAVE_REGISTERPAIR:
    6560   00:615F  4F                      ld  c,a                         ; Save A in C
    6561   00:6160  AF                      xor a                           ; 0 in A
    6562   00:6161  06 08                   ld  b,8                         ; 8 in B, number of bits for conversion
    6563   00:6163                      RTC_SAVE_REGISTERPAIR.1:
    6564   00:6163  CB 01                   rlc c                           ; Leftmost bit in Carry
    6565   00:6165  8F                      adc a,a                         ; A = (A * 2) + Carry
    6566   00:6166  27                      daa                             ; decimal adjust A, shift = BCD x 2 + carry
    6567   00:6167  10 FA                   djnz    RTC_SAVE_REGISTERPAIR.1 ; Repeat for 8 bits
    6568   00:6169  CD 70 61                call    SET_RTC_REG             ; Save LSB in register and increase register address
    6569   00:616C  0F                      rrca
    6570   00:616D  0F                      rrca
    6571   00:616E  0F                      rrca
    6572   00:616F  0F                      rrca                            ; now MSB is in LSB position
    6573   00:6170                      SET_RTC_REG:
    6574   00:6170  47                      ld  b,a                         ; save value to set in B
    6575   00:6171  7B                      ld  a,e                         ; and now register address in A
    6576   00:6172  D3 B4                   out (#B4),a                     ; The register we want to set
    6577   00:6174  78                      ld  a,b                         ; restore value
    6578   00:6175  D3 B5                   out (#B5),a                     ; save it
    6579   00:6177  1C                      inc e                           ; increase register address, as this usually is done in pairs
    6580   00:6178  C9                      ret
    6581   00:6179                      
    6582   00:6179                      ; Auxiliary function for SET_DATE and SET_TIME
    6583   00:6179                      ; SET_RTC_DATE will save date, parameters:
    6584   00:6179                      ; L - Day
    6585   00:6179                      ; H - Month
    6586   00:6179                      ; D - Years since 1980
    6587   00:6179                      ; All values are regular values, this function will properly convert them
    6588   00:6179                      ;
    6589   00:6179                      ; SET_RTC_DATE.1 is used by SET_TIME as well
    6590   00:6179                      ; It will save three register pairs, starting with the register in E
    6591   00:6179                      ; First pair is updated with value in L
    6592   00:6179                      ; Second pair is updated with value in H
    6593   00:6179                      ; Third pair is updated with value in D
    6594   00:6179                      SET_RTC_DATE:
    6595   00:6179  CD 54 61                call    STOP_RTC_COUNT_SET_MODE0; Select RTC Register 13, and set Mode / Page 0
    6596   00:617C  F6 01                   or  1                           ; Set Bit 0, so Mode / Page 1
    6597   00:617E  D3 B5                   out (#B5),a                     ; save it in register 13, now page 1 selected
    6598   00:6180  3E 0B                   ld  a,#B                        ; Leap Year Counter Register
    6599   00:6182  D3 B4                   out (#B4),a                     ; Select it
    6600   00:6184  7A                      ld  a,d                         ; Load Years in leap year counter
    6601   00:6185  D3 B5                   out (#B5),a                     ; So it has count of leap years (0 is 1980, leap, and every time it is 4, leap year again)
    6602   00:6187  CD 54 61                call    STOP_RTC_COUNT_SET_MODE0; Select RTC Register 13 and set mode / page 0
    6603   00:618A  CD 54 61                call    STOP_RTC_COUNT_SET_MODE0; do it a second time... DOS does it, don't want to JYNX it :P
    6604   00:618D  1E 07                   ld  e,7                         ; Register 7
    6605   00:618F                      SET_RTC_DATE.1:
    6606   00:618F  7D                      ld  a,l                         ; A has day
    6607   00:6190  CD 5F 61                call    RTC_SAVE_REGISTERPAIR   ; Will convert day to BCD and save in registers 7 and 8
    6608   00:6193  7C                      ld  a,h                         ; A has month
    6609   00:6194  CD 5F 61                call    RTC_SAVE_REGISTERPAIR   ; Will convert month to BCD and save in register 9 and A
    6610   00:6197  7A                      ld  a,d                         ; A has how many years since 1980
    6611   00:6198  CD 5F 61                call    RTC_SAVE_REGISTERPAIR   ; Will convert to BCD and save in register B and C
    6612   00:619B  3E 0D                   ld  a,#D                        ; Register D
    6613   00:619D  D3 B4                   out (#B4),a                     ; Send it
    6614   00:619F  DB B5                   in  a,(#B5)                     ; Read its value
    6615   00:61A1  F6 08                   or  8                           ; Start counting time again
    6616   00:61A3  D3 B5                   out (#B5),a                     ; Send
    6617   00:61A5  C9                      ret
    6618   00:61A6                      
    6619   00:61A6                      ; Pattern setup routine
    6620   00:61A6                      PATTERN_SETUP:
    6621   00:61A6  AF                      xor a                           ; Bit-16, V9938 and V9958 only
    6622   00:61A7  21 88 00                ld  hl,#0088                    ; Bit-15 to 0, pattern base address = #0088
    6623   00:61AA  CD 1A 62                call SET_VDP_WRITE
    6624   00:61AD  21 BA 61                ld  hl,PATTERN_DATA             ; Point to hl
    6625   00:61B0  06 60                   ld  b,8*12                      ; Redraw 12 chars, max 12 chars are suggested
    6626   00:61B2  0E 98                   ld  c,#98                       ; port #98
    6627   00:61B4                      OUTI_TO_VRAM_TMS9918:
    6628   00:61B4  ED A3                   outi                            ; Slower than otir but useful on TMS9918 which requires 29 T-states
    6629   00:61B6  C2 B4 61                jp  nz,OUTI_TO_VRAM_TMS9918     ; Therefore, don't use 'djnz' here!
    6630   00:61B9  C9                      ret
    6631   00:61BA                      PATTERN_DATA:
    6632   00:61BA                      ; Pattern-01 is CHR$(1)+CHR$(81) = SCAN_TERMINATOR_OPEN
    6633   00:61BA  06                      db  %00000110
    6634   00:61BB  09                      db  %00001001
    6635   00:61BC  09                      db  %00001001
    6636   00:61BD  FC                      db  %11111100                   ; "Opened Padlock"
    6637   00:61BE  FC                      db  %11111100
    6638   00:61BF  FC                      db  %11111100
    6639   00:61C0  FC                      db  %11111100
    6640   00:61C1  00                      db  %00000000
    6641   00:61C2                      ; Pattern-02 is CHR$(1)+CHR$(82) = SCAN_TERMINATOR_ENC
    6642   00:61C2  30                      db  %00110000
    6643   00:61C3  48                      db  %01001000
    6644   00:61C4  48                      db  %01001000
    6645   00:61C5  FC                      db  %11111100                   ; "Closed Padlock"
    6646   00:61C6  FC                      db  %11111100
    6647   00:61C7  FC                      db  %11111100
    6648   00:61C8  FC                      db  %11111100
    6649   00:61C9  00                      db  %00000000
    6650   00:61CA                      ; Pattern-03 is CHR$(1)+CHR$(83) = Wi-Fi Connected to the AP:
    6651   00:61CA  00                      db  %00000000
    6652   00:61CB  00                      db  %00000000
    6653   00:61CC  70                      db  %01110000
    6654   00:61CD  70                      db  %01110000                   ; "Full Access Point"
    6655   00:61CE  70                      db  %01110000
    6656   00:61CF  20                      db  %00100000
    6657   00:61D0  20                      db  %00100000
    6658   00:61D1  70                      db  %01110000
    6659   00:61D2                      ; Pattern-04 is CHR$(1)+CHR$(84) = Wi-Fi Failed to connect to:
    6660   00:61D2  00                      db  %00000000
    6661   00:61D3  88                      db  %10001000
    6662   00:61D4  50                      db  %01010000
    6663   00:61D5  20                      db  %00100000                   ; "X"
    6664   00:61D6  50                      db  %01010000
    6665   00:61D7  88                      db  %10001000
    6666   00:61D8  00                      db  %00000000
    6667   00:61D9  00                      db  %00000000
    6668   00:61DA                      ; Pattern-05 is CHR$(1)+CHR$(85) = Requesting connection to:
    6669   00:61DA  00                      db  %00000000
    6670   00:61DB  00                      db  %00000000
    6671   00:61DC  50                      db  %01010000
    6672   00:61DD  20                      db  %00100000                   ; "Partial Access Point"
    6673   00:61DE  50                      db  %01010000
