    6038   00:5FF4  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6039   00:5FF7  AF                      xor a
    6040   00:5FF8                          SEND_DATA                       ; Send the command size msb
    6040   00:5FF8  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6041   00:5FFB  3E 03                   ld  a,3
    6042   00:5FFD                          SEND_DATA                       ; Send the command size lsb
    6042   00:5FFD  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6043   00:6000  78                      ld  a,b
    6044   00:6001                          SEND_DATA                       ; Send the connection #
    6044   00:6001  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
