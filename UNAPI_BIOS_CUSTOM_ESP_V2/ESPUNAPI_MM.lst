    7398   00:6592                      ;*********************************************
    7399   00:6592                      ;***    ESP Specific Commands/Responses    ***
    7400   00:6592                      ;*********************************************
    7401   00:6592                      ; Cold reset of ESP firmware
    7402   00:6592  (00:0052)           CMD_RESET_ESP           equ 'R'
    7403   00:6592                      ; ESP32 only, Get Board, returns board identification string
    7404   00:6592  (00:0062)           CMD_GET_FW_TYPE         equ 'b'
    7405   00:6592                      ; Warm reset of ESP firmware
    7406   00:6592  (00:0057)           CMD_WRESET_ESP          equ 'W'
    7407   00:6592                      ; Hold Wi-Fi Connection On
    7408   00:6592  (00:0048)           CMD_WIFIHOLD_ESP        equ 'H'
    7409   00:6592                      ; Release Wi-Fi Connection Hold
    7410   00:6592  (00:0068)           CMD_WIFIRELEASE_ESP     equ 'h'
    7411   00:6592                      ; Get Updated time and date from internet
    7412   00:6592  (00:0047)           CMD_GET_TIME            equ 'G'
    7413   00:6592                      ; Query Auto Clock settings
    7414   00:6592  (00:0063)           CMD_QUERY_ACLK_SETTINGS equ 'c'
    7415   00:6592                      ; Set Auto Clock settings
    7416   00:6592  (00:0043)           CMD_SET_ACLK_SETTINGS   equ 'C'
    7417   00:6592                      ; Query ESP settings
    7418   00:6592  (00:0051)           CMD_QUERY_ESP_SETTINGS  equ 'Q'
    7419   00:6592                      ; Set Timer Value
    7420   00:6592  (00:0054)           CMD_TIMER_SET           equ 'T'
    7421   00:6592                      ; Turn Nagle On
    7422   00:6592  (00:0044)           CMD_NAGLE_ON            equ 'D'
    7423   00:6592                      ; Turn Nagle Off
    7424   00:6592  (00:004E)           CMD_NAGLE_OFF           equ 'N'
    7425   00:6592                      ; Turn Wi-Fi Off
    7426   00:6592  (00:004F)           CMD_WIFI_OFF            equ 'O'
    7427   00:6592                      ; Request to connect to a network
    7428   00:6592  (00:0041)           CMD_WIFI_CONNECT        equ 'A'
    7429   00:6592                      ; Request to start network scan
    7430   00:6592  (00:0053)           CMD_SCAN_START          equ 'S'
    7431   00:6592                      ; Request network scan result
    7432   00:6592  (00:0073)           CMD_SCAN_RESULTS        equ 's'
    7433   00:6592                      ; Request AP Status
    7434   00:6592  (00:0067)           CMD_AP_STS              equ 'g'
    7435   00:6592                      ; Get ESP firmware version
    7436   00:6592  (00:0056)           CMD_GET_ESP_VER         equ 'V'
    7437   00:6592                      ; After finishing Warm reset, ESP returns ready
    7438   00:6592  52 65 61 64 79      RSP_CMD_RESET_ESP       db  "Ready"
    7439   00:6597  (00:0005)           RSP_CMD_RESET_ESP_SIZE  equ 5
    7440   00:6597                      ; Query ESP Presence
    7441   00:6597  (00:003F)           CMD_QUERY_ESP           equ '?'
    7442   00:6597                      ; Query response
    7443   00:6597  4F 4B               RSP_CMD_QUERY_ESP       db  "OK"
    7444   00:6599  (00:0002)           RSP_CMD_QUERY_ESP_SIZE  equ 2
