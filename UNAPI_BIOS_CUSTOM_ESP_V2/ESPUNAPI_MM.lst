    4643   00:5896                          ; read and move it to B
    4644   00:5896                          RECEIVE_DATA
    4644   00:5896  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4645   00:5899  47                      ld  b,a
    4646   00:589A                      
    4647   00:589A                      SSH_STATE_REG_L:
    4648   00:589A                          CHECK_DATA
    4648   00:589A  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    4648   00:589D  CB 47             >     bit 0,a
