    5786   00:5EAF                      ;=======================
    5787   00:5EAF                      ;===  TCPIP_TCP_RCV  ===
    5788   00:5EAF                      ;=======================
    5789   00:5EAF                      ;Receive data from a TCP connection.
    5790   00:5EAF                      ;
    5791   00:5EAF                      ;Input:   A  = 18
    5792   00:5EAF                      ;         B  = Connection number
    5793   00:5EAF                      ;         DE = Address for the retrieved data
    5794   00:5EAF                      ;         HL = Length of the data to be obtained
    5795   00:5EAF                      ;Output:  A  = Error code
    5796   00:5EAF                      ;         BC = Total number of bytes that have been actually retrieved
    5797   00:5EAF                      ;         HL = Number of urgent data bytes that have been retrieved
    5798   00:5EAF                      ;              (placed at the beginning of the received data block)
    5799   00:5EAF                      ; Save registers other than AF
    5800   00:5EAF                      TCPIP_TCP_RCV_CHECK_TIME_OUT:
    5801   00:5EAF  C5                      push bc
    5802   00:5EB0  D5                      push de
    5803   00:5EB1  E5                      push hl
    5804   00:5EB2  CD 52 63                call    GETCOUNTER
    5805   00:5EB5  7D                      ld  a,l
    5806   00:5EB6  B4                      or  h
    5807   00:5EB7                          ; Restore registers, we are returning
    5808   00:5EB7  E1                      pop hl
    5809   00:5EB8  D1                      pop de
    5810   00:5EB9  C1                      pop bc
    5811   00:5EBA  C0                      ret nz
    5812   00:5EBB                          ; Ok, timeout...
    5813   00:5EBB  F1                      pop af                          ; Get return address of who called this out of the stack, we will return from the function or re-start
    5814   00:5EBC                      TCPIP_TCP_RCV_RETRY_QRCV:
    5815   00:5EBC  CD 71 63                call    GETBYTE
    5816   00:5EBF  B7                      or  a
    5817   00:5EC0  28 0C                   jr  z,TCPIP_TCP_RCV_CHECK_TIME_OUT.NORXRETRY
    5818   00:5EC2                          ; Ok, so let's ask ESP to re-send the data and retry receiving it
    5819   00:5EC2  3D                      dec a
    5820   00:5EC3  CD 83 63                call    SETBYTE                 ; we are retrying it
    5821   00:5EC6  3E 72                   ld  a,'r'                       ; retry transmission command
    5822   00:5EC8                          SEND_DATA
    5822   00:5EC8  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5823   00:5ECB  C3 12 5F                jp  TCPIP_TCP_RCV.RXRETRY       ; and retry it
    5824   00:5ECE                      TCPIP_TCP_RCV_CHECK_TIME_OUT.NORXRETRY:
    5825   00:5ECE  3E 0F                   ld  a,ERR_INV_OPER
    5826   00:5ED0  C9                      ret                             ; and return the function itself
    5827   00:5ED1                      
    5828   00:5ED1                      TCPIP_TCP_RCV_RET_ERR:
    5829   00:5ED1                          ; next two bytes are size bytes, don't care
    5830   00:5ED1  47                      ld  b,a                         ; save error in b
    5831   00:5ED2  0E 02                   ld  c,2
    5832   00:5ED4                      TCPIP_TCP_RCV_RET_ERR2:
    5833   00:5ED4                          CHECK_DATA
    5833   00:5ED4  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5833   00:5ED7  CB 47             >     bit 0,a
    5834   00:5ED9  20 05                   jr  nz,TCPIP_TCP_RCV_RET_ERR2.1
    5835   00:5EDB  CD AF 5E                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5836   00:5EDE  18 F4                   jr  TCPIP_TCP_RCV_RET_ERR2
    5837   00:5EE0                      TCPIP_TCP_RCV_RET_ERR2.1:
    5838   00:5EE0                          ; nz, discard
    5839   00:5EE0                          RECEIVE_DATA
    5839   00:5EE0  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5840   00:5EE3  0D                      dec c
    5841   00:5EE4  20 EE                   jr  nz,TCPIP_TCP_RCV_RET_ERR2
    5842   00:5EE6                          ; now return w/ error that is saved in b
    5843   00:5EE6  78                      ld  a,b
    5844   00:5EE7                      TCPIP_TCP_RCV_RET_NODATA:
    5845   00:5EE7  21 00 00                ld  hl,0
    5846   00:5EEA  01 00 00                ld  bc,0
    5847   00:5EED  C9                      ret
    5848   00:5EEE                      
    5849   00:5EEE                      TCPIP_TCP_RCV:
    5850   00:5EEE  EB                      ex  de,hl
    5851   00:5EEF  CD AA 63                call    SETWORD
    5852   00:5EF2  EB                      ex  de,hl
    5853   00:5EF3  3E 12                   ld  a,18
    5854   00:5EF5                          SEND_DATA                       ; Send the command
    5854   00:5EF5  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5855   00:5EF8  AF                      xor a
    5856   00:5EF9                          SEND_DATA                       ; Send the command size msb
    5856   00:5EF9  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5857   00:5EFC  3E 03                   ld  a,3
    5858   00:5EFE                          SEND_DATA                       ; Send the command size lsb
    5858   00:5EFE  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5859   00:5F01  78                      ld  a,b
    5860   00:5F02                          SEND_DATA                       ; Send the connection #
    5860   00:5F02  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5861   00:5F05  7D                      ld  a,l
    5862   00:5F06                          SEND_DATA                       ; Send MAX rcv size LSB
    5862   00:5F06  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5863   00:5F09  7C                      ld  a,h
    5864   00:5F0A                          SEND_DATA                       ; Send MAX rcv size MSB
    5864   00:5F0A  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5865   00:5F0D  3E 03                   ld  a,3
    5866   00:5F0F  CD 83 63                call    SETBYTE                 ; Ok, retry up to three times
    5867   00:5F12                      TCPIP_TCP_RCV.RXRETRY:
    5868   00:5F12                          ; Now wait up to 600 ticks to get response
    5869   00:5F12  21 58 02                ld  hl,600
    5870   00:5F15  CD 61 63                call    SETCOUNTER
    5871   00:5F18                      TCPIP_TCP_RCV_ST1:
    5872   00:5F18                          CHECK_DATA
    5872   00:5F18  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5872   00:5F1B  CB 47             >     bit 0,a
    5873   00:5F1D  20 05                   jr  nz,TCPIP_TCP_RCV_ST1.1
    5874   00:5F1F  CD AF 5E                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5875   00:5F22  18 F4                   jr  TCPIP_TCP_RCV_ST1
    5876   00:5F24                      TCPIP_TCP_RCV_ST1.1:
    5877   00:5F24                          ; nz, check the data
    5878   00:5F24                          RECEIVE_DATA
    5878   00:5F24  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
