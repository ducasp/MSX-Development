    1343   00:471A  23                      inc hl
    1344   00:471B  B7                      or  a
    1345   00:471C  C2 16 47                jp  nz,WIFI_CONNECT_AP_SRCH.1   ; Find string terminator
    1346   00:471F                          ; Found, jump encryption byte
    1347   00:471F  23                      inc hl
    1348   00:4720  1D                      dec e                           ; Decrement selection, if 0 we are done
    1349   00:4721  C2 16 47                jp  nz,WIFI_CONNECT_AP_SRCH.1
    1350   00:4724                      WIFI_CONNECT_AP_PWDQ:
    1351   00:4724                          ; HL has the address of AP name string
    1352   00:4724  54                      ld  d,h
    1353   00:4725  5D                      ld  e,l                         ; Save copy in D
    1354   00:4726  01 00 00                ld  bc,0                        ; BC will have the ap connection data length
    1355   00:4729                      WIFI_CONNECT_APSIZE:
    1356   00:4729  03                      inc bc
    1357   00:472A  1A                      ld  a,(de)
    1358   00:472B  13                      inc de
    1359   00:472C  B7                      or  a
    1360   00:472D  C2 29 47                jp  nz,WIFI_CONNECT_APSIZE      ; Count size, including zero terminator
    1361   00:4730                          ; Check for encryption
    1362   00:4730  1A                      ld  a,(de)
    1363   00:4731  B7                      or  a
    1364   00:4732  CA C3 47                jp  z,WIFI_CONNECT_SENDCMD      ; If no password requested, good to go
    1365   00:4735                          ; Shoot, need to request password, well, let's do it
    1366   00:4735  E5                      push    hl                      ; Save HL
    1367   00:4736  21 35 6C                ld  hl,MMENU_ASKPWD
    1368   00:4739  CD 9D 4C                call    PRINTHL                 ; Inform that user need to input PWD
    1369   00:473C  E1                      pop hl                          ; Restore HL
    1370   00:473D  FD 21 00 00             ld  iy,0                        ; IY will help in backspacing
    1371   00:4741  DD 26 01                ld  ixh,1                       ; Start hidden
    1372   00:4744                      WIFI_CONNECT_RCV_PWD:
    1373   00:4744  CD 9F 00                call    CHGET
    1374   00:4747  FE 1B                   cp  #1b                         ; ESC?
    1375   00:4749  CA 5E 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1376   00:474C  FE 08                   cp  #08                         ; Backspace?
    1377   00:474E  CA 9F 47                jp  z,WIFI_CONNECT_RCV_PWD_BS   ; Check if there is something to erase
    1378   00:4751  FE 0D                   cp  #0d                         ; ENTER?
    1379   00:4753  CA BC 47                jp  z,WIFI_PWD_CHECK_INPUT      ; Check if ok
    1380   00:4756  FE 7F                   cp  #7f                         ; Delete?
    1381   00:4758  CA 8B 47                jp  z,WIFI_CONNECT_RCV_PWDH     ; Change password from clear to hidden or vice versa
    1382   00:475B                      WIFI_CONNECT_RCV_PWD_STR:
    1383   00:475B                          ; Ok, so it is a digit and store
    1384   00:475B  12                      ld  (de),a
    1385   00:475C  FD 7D                   ld  a,iyl
    1386   00:475E  D6 3F                   sub 63                          ; 63 chars password limit (WPA2 encryption)
    1387   00:4760  28 E2                   jr  z,WIFI_CONNECT_RCV_PWD
    1388   00:4762  1A                      ld  a,(de)
    1389   00:4763  03                      inc bc
    1390   00:4764  13                      inc de
    1391   00:4765  FD 23                   inc iy                          ; Increment counters and pointer
    1392   00:4767  F5                      push    af                      ; Save A
    1393   00:4768  DD 7C                   ld  a,ixh
    1394   00:476A  B7                      or  a                           ; If zero, print char, otherwise print *
    1395   00:476B  28 09                   jr  z,WIFI_CONNECT_RCV_PWD_CHAR
    1396   00:476D  F1                      pop af
    1397   00:476E  3E 2A                   ld  a,'*'                       ; Print * and keep password hidden
    1398   00:4770  CD A2 00                call    CHPUT
    1399   00:4773  C3 44 47                jp  WIFI_CONNECT_RCV_PWD        ; And back to receiving digits
    1400   00:4776                      WIFI_CONNECT_RCV_PWD_CHAR:
    1401   00:4776  F1                      pop af
    1402   00:4777  FE 20                   cp  32
    1403   00:4779  30 04                   jr  nc,WIFI_CONNECT_RCV_CHKPRT2 ; Ok, not below space, but is it delete?
    1404   00:477B  3E 3F                   ld  a,'?'                       ; Prints a question mark
    1405   00:477D  18 06                   jr  WIFI_CONNECT_RCV_CHKPRTD
    1406   00:477F                      WIFI_CONNECT_RCV_CHKPRT2:
    1407   00:477F  FE 7F                   cp  #7f
    1408   00:4781  20 02                   jr  nz,WIFI_CONNECT_RCV_CHKPRTD
    1409   00:4783  3E 3F                   ld  a,'?'                       ; Prints a question mark if it is delete
    1410   00:4785                      WIFI_CONNECT_RCV_CHKPRTD:
    1411   00:4785  CD A2 00                call    CHPUT                   ; Print a char
    1412   00:4788  C3 44 47                jp  WIFI_CONNECT_RCV_PWD        ; And back to receiving digits
    1413   00:478B                      
    1414   00:478B                      WIFI_CONNECT_RCV_PWDH:
    1415   00:478B  FD 7D                   ld  a,iyl
    1416   00:478D  FD B4                   or  iyh
    1417   00:478F  C2 5B 47                jp  nz,WIFI_CONNECT_RCV_PWD_STR ; If digits entered, can't change password behavior, so it is a pass phrase char
    1418   00:4792  AF                      xor a
    1419   00:4793  DD B4                   or  ixh
    1420   00:4795  DD 26 01                ld  ixh,1
    1421   00:4798  28 AA                   jr  z,WIFI_CONNECT_RCV_PWD      ; Return if it was 0
    1422   00:479A  DD 26 00                ld  ixh,0
    1423   00:479D  28 A5                   jr  z,WIFI_CONNECT_RCV_PWD      ; Otherwise set to 0 and return
    1424   00:479F                      
    1425   00:479F                      WIFI_CONNECT_RCV_PWD_BS:
    1426   00:479F  FD 7D                   ld  a,iyl
    1427   00:47A1  FD B4                   or  iyh
    1428   00:47A3  CA 44 47                jp  z,WIFI_CONNECT_RCV_PWD      ; If no digits entered, nothing to erase
    1429   00:47A6  FD 2B                   dec iy                          ; Decrement counter
    1430   00:47A8  0B                      dec bc                          ; Decrement counter
    1431   00:47A9  1B                      dec de                          ; Decrement pointer
    1432   00:47AA  3E 08                   ld  a,8                         ; Backspace
    1433   00:47AC  CD A2 00                call    CHPUT                   ; Print it
    1434   00:47AF  3E 20                   ld  a,' '                       ; Space
    1435   00:47B1  CD A2 00                call    CHPUT                   ; Print it
    1436   00:47B4  3E 08                   ld  a,8                         ; Backspace
    1437   00:47B6  CD A2 00                call    CHPUT                   ; Print it
    1438   00:47B9  C3 44 47                jp  WIFI_CONNECT_RCV_PWD        ; Return
    1439   00:47BC                      
    1440   00:47BC                      WIFI_PWD_CHECK_INPUT:
    1441   00:47BC  FD 7D                   ld  a,iyl
    1442   00:47BE  FD B4                   or  iyh
    1443   00:47C0  CA 44 47                jp  z,WIFI_CONNECT_RCV_PWD      ; If no digits entered, no password to send
    1444   00:47C3                          ; Otherwise done and ready to send
    1445   00:47C3                      WIFI_CONNECT_SENDCMD:
    1446   00:47C3  CD 16 4A                call    WAIT_250MS_AND_THEN_CONTINUE
    1447   00:47C6  E5                      push    hl
    1448   00:47C7  21 F1 6B                ld  HL,MMENU_CONNECTING
    1449   00:47CA  CD 9D 4C                call    PRINTHL
    1450   00:47CD  E1                      pop hl
    1451   00:47CE                          ; Print AP name
    1452   00:47CE  E5                      push    hl
    1453   00:47CF  CD A7 4C                call    PRINTHLINE              ; Print AP Name
    1454   00:47D2  E1                      pop hl
    1455   00:47D3                          ; HL has the address of our data, BC the data size, so it is just needed to send the command
    1456   00:47D3                          CLEAR_UART
    1456   00:47D3  3E 14             >     ld  a,20
    1456   00:47D5  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    1457   00:47D8  3E 41                   ld  a,CMD_WIFI_CONNECT
    1458   00:47DA                          SEND_DATA
    1458   00:47DA  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1459   00:47DD  78                      ld  a,b                         ; Size MSB is in B
    1460   00:47DE                          SEND_DATA
    1460   00:47DE  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1461   00:47E1  79                      ld  a,c                         ; Size LSB is in c
    1462   00:47E2                          SEND_DATA
    1462   00:47E2  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1463   00:47E5                      WIFI_CONNECT_SENDCMDLP:
    1464   00:47E5  7E                      ld  a,(hl)
    1465   00:47E6                          SEND_DATA
    1465   00:47E6  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1466   00:47E9  23                      inc hl
    1467   00:47EA  0B                      dec bc
    1468   00:47EB  78                      ld  a,b
    1469   00:47EC  B1                      or  c
    1470   00:47ED  C2 E5 47                jp  nz,WIFI_CONNECT_SENDCMDLP
    1471   00:47F0  21 58 02                ld  hl,600                      ; Wait Up To 10s
    1472   00:47F3  3E 41                   ld  a,CMD_WIFI_CONNECT          ; Our command
    1473   00:47F5  CD 38 4B                call    WAIT_MENU_QCMD_RESPONSE
    1474   00:47F8  CA 04 48                jp  z,WIFI_CONNECT_FAIL
    1475   00:47FB  21 96 70                ld  hl,STR_SENDING_OK_JN        ; Success
    1476   00:47FE  CD 9D 4C                call    PRINTHL
    1477   00:4801  C3 0E 4A                jp  WAIT_2S_AND_THEN_MAINMENU
    1478   00:4804                      WIFI_CONNECT_FAIL:
    1479   00:4804  21 B8 70                ld  hl,STR_SENDING_NOK_JN       ; Failure
    1480   00:4807  CD 9D 4C                call    PRINTHL
    1481   00:480A  C3 0A 4A                jp  WAIT_4S_AND_THEN_MAINMENU
    1482   00:480D                      
    1483   00:480D                      INPUT_WFSAP_BAD_INPUT:
    1484   00:480D  C5                      push    bc
    1485   00:480E  D5                      push    de
    1486   00:480F  F5                      push    af
    1487   00:4810  E5                      push    hl
    1488   00:4811  DD E5                   push    ix
    1489   00:4813  FD E5                   push    iy
    1490   00:4815  CD C0 00                call    BEEP                    ; Wrong Input, beep
    1491   00:4818  FD E1                   pop iy
    1492   00:481A  DD E1                   pop ix
    1493   00:481C  E1                      pop hl
    1494   00:481D  F1                      pop af
    1495   00:481E  D1                      pop de
    1496   00:481F  C1                      pop bc
    1497   00:4820  C3 4B 46                jp WIFI_SELECT_AP               ; Return
    1498   00:4823                      
    1499   00:4823                      WIFI_SCAN_NONETWORKS:
    1500   00:4823  21 A4 6B                ld  hl,MMENU_SCANN
    1501   00:4826  CD 9D 4C                call    PRINTHL
    1502   00:4829  C3 0A 4A                jp  WAIT_4S_AND_THEN_MAINMENU
    1503   00:482C                      
    1504   00:482C                      WIFI_SCAN_TIMEOUT:
    1505   00:482C  21 84 6B                ld  hl,MMENU_SCANF
    1506   00:482F  CD 9D 4C                call    PRINTHL
    1507   00:4832  C3 0A 4A                jp  WAIT_4S_AND_THEN_MAINMENU
    1508   00:4835                      
    1509   00:4835                      SET_WIFI_TIMEOUT:
    1510   00:4835  3E 32                   ld  a,'2'
    1511   00:4837  CD A2 00                call    CHPUT
    1512   00:483A  CD 16 4A                call    WAIT_250MS_AND_THEN_CONTINUE
    1513   00:483D  21 67 6D                ld  hl,MMENU_TIMEOUT
    1514   00:4840  CD 9D 4C                call    PRINTHL                 ; Print Main Timeout message
    1515   00:4843  CD 87 4A                call    CHECKTIMEOUT            ; TimeOut is on or off?
    1516   00:4846  CA 5E 48                jp  z,WIFI_SET_ALWAYS_ON        ; If 0, always on
    1517   00:4849                          ; Otherwise there is a timeout
    1518   00:4849  E5                      push    hl
    1519   00:484A  21 9E 6E                ld hl,MMENU_TIMEOUT_NOTALWAYSON1
    1520   00:484D  CD 9D 4C                call    PRINTHL
    1521   00:4850  E1                      pop hl
    1522   00:4851  CD 9D 4C                call    PRINTHL
    1523   00:4854  21 B4 6E                ld hl,MMENU_TIMEOUT_NOTALWAYSON2
    1524   00:4857  CD 9D 4C                call    PRINTHL
    1525   00:485A  16 00                   ld  d,0                         ; Count digits
    1526   00:485C  18 10                   jr  INPUT_TIMEOUT
    1527   00:485E                      WIFI_SET_ALWAYS_ON:
    1528   00:485E  21 49 6E                ld  hl,MMENU_TIMEOUT_ALWAYSON
    1529   00:4861  CD 9D 4C                call    PRINTHL
    1530   00:4864  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1531   00:4868  DD 6B                   ld  ixl,e
    1532   00:486A  DD 62                   ld  ixh,d                       ; Address in IX
    1533   00:486C  16 00                   ld  d,0                         ; Count digits
    1534   00:486E                      INPUT_TIMEOUT:
    1535   00:486E  CD 9F 00                call    CHGET
    1536   00:4871  FE 1B                   cp  #1b                         ; ESC?
    1537   00:4873  CA 5E 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1538   00:4876  FE 0D                   cp  #0d                         ; ENTER?
    1539   00:4878  CA BC 48                jp  z,SET_WIFI_CHECK_INPUT      ; Check if ok
    1540   00:487B  FE 08                   cp  #08                         ; Backspace?
    1541   00:487D  CA A2 48                jp  z,SET_WIFI_BS_INPUT         ; Check if there is something to erase
    1542   00:4880  FE 30                   cp  '0'                         ; Check if A is less than 0
    1543   00:4882  DA 9C 48                jp  c,INPUT_TIMEOUT_BAD_INPUT   ; if it is, ignore
    1544   00:4885  FE 3A                   cp  '9'+1                       ; Check if a is greater than  9
    1545   00:4887  D2 9C 48                jp  nc,INPUT_TIMEOUT_BAD_INPUT  ; If it is, ignore
    1546   00:488A  DD 77 00                ld  (ix+0),a                    ; Save it
    1547   00:488D  CD A2 00                call    CHPUT                   ; It is valid, so print it
    1548   00:4890  14                      inc d                           ; Increment digit count
    1549   00:4891  DD 23                   inc ix                          ; Increment pointer
    1550   00:4893  3E 03                   ld  a,3
    1551   00:4895  BA                      cp  d
    1552   00:4896  CA BC 48                jp  z,SET_WIFI_CHECK_INPUT      ; All we can do is accept up to 3 digits, check if ok
    1553   00:4899  C3 6E 48                jp  INPUT_TIMEOUT               ; Not done yet, so continue
    1554   00:489C                      
    1555   00:489C                      INPUT_TIMEOUT_BAD_INPUT:
    1556   00:489C  CD C0 00                call    BEEP                    ; Wrong Input, beep
    1557   00:489F  C3 6E 48                jp INPUT_TIMEOUT                ; Return
    1558   00:48A2                      
    1559   00:48A2                      SET_WIFI_BS_INPUT:
    1560   00:48A2  AF                      xor a
    1561   00:48A3  B2                      or  d                           ; Counter has any digit?
    1562   00:48A4  CA 6E 48                jp  z,INPUT_TIMEOUT             ; Nope, so just continue
    1563   00:48A7  15                      dec d                           ; Decrement counter
    1564   00:48A8  DD 2B                   dec ix                          ; Decrement pointer
    1565   00:48AA  3E 08                   ld  a,8                         ; Backspace
    1566   00:48AC  CD A2 00                call    CHPUT                   ; Print it
    1567   00:48AF  3E 20                   ld  a,' '                       ; Space
    1568   00:48B1  CD A2 00                call    CHPUT                   ; Print it
    1569   00:48B4  3E 08                   ld  a,8                         ; Backspace
    1570   00:48B6  CD A2 00                call    CHPUT                   ; Print it
    1571   00:48B9  C3 6E 48                jp  INPUT_TIMEOUT               ; Return
    1572   00:48BC                      
    1573   00:48BC                      SET_WIFI_CHECK_INPUT:
    1574   00:48BC  AF                      xor a
    1575   00:48BD  B2                      or  d                           ; Counter has any digits
    1576   00:48BE  CA 6E 48                jp  z,INPUT_TIMEOUT             ; Nope, so just continue
    1577   00:48C1                          ; IX is pointing one position after last digit, so revert
    1578   00:48C1  DD 2B                   dec ix
    1579   00:48C3  DD 7E 00                ld  a,(ix+0)                    ; Digit in A
    1580   00:48C6  D6 30                   sub '0'                         ; Convert it to decimal
    1581   00:48C8  26 00                   ld  h,0                         ; First digit, so H is 0
    1582   00:48CA  6F                      ld  l,a                         ; And L has the digit
    1583   00:48CB  15                      dec d                           ; If digits finished, just set
    1584   00:48CC  CA F8 48                jp  z,SET_WIFI_EXECUTE_SET_COMMAND
    1585   00:48CF  DD 2B                   dec ix
    1586   00:48D1  DD 7E 00                ld  a,(ix+0)                    ; Digit in A
    1587   00:48D4  D6 30                   sub '0'                         ; Convert it to decimal
    1588   00:48D6  87                      add a,a                         ; A*2
    1589   00:48D7  4F                      ld  c,a                         ; A*2 in C
    1590   00:48D8  87                      add a,a                         ; A*4
    1591   00:48D9  87                      add a,a                         ; A*8
    1592   00:48DA  81                      add a,c                         ; A*10
    1593   00:48DB                          ; Up to here, we can get 90 + 9, 99, won't go to H anyway, just add to L
    1594   00:48DB  85                      add a,l                         ; L has the first digit
    1595   00:48DC  6F                      ld  l,a                         ; And now L has the two digits
    1596   00:48DD  15                      dec d                           ; If digits finished, just set
    1597   00:48DE  CA F8 48                jp  z,SET_WIFI_EXECUTE_SET_COMMAND
    1598   00:48E1  DD 2B                   dec ix
    1599   00:48E3  DD 7E 00                ld  a,(ix+0)                    ; Digit in A
    1600   00:48E6  D6 30                   sub '0'                         ; Convert it to decimal
    1601   00:48E8  87                      add a,a                         ; A*2
    1602   00:48E9  4F                      ld  c,a                         ; A*2 in C
    1603   00:48EA  87                      add a,a                         ; A*4
    1604   00:48EB  87                      add a,a                         ; A*8
    1605   00:48EC  81                      add a,c                         ; A*10
    1606   00:48ED  EB                      ex  de,hl                       ; Get the two digits results in de
    1607   00:48EE  6F                      ld  l,a
    1608   00:48EF  26 00                   ld  h,0                         ; HL = A*10
    1609   00:48F1  29                      add hl,hl                       ; HL = A*20
    1610   00:48F2  4D                      ld  c,l
    1611   00:48F3  44                      ld  b,h                         ; BC = A*20
    1612   00:48F4  29                      add hl,hl                       ; HL = A*40
    1613   00:48F5  29                      add hl,hl                       ; HL = A*80
    1614   00:48F6  09                      add hl,bc                       ; HL = A*100
    1615   00:48F7  19                      add hl,de                       ; HL = three digits result
    1616   00:48F8                          ; This was the last digit, up to three
    1617   00:48F8                      SET_WIFI_EXECUTE_SET_COMMAND:
    1618   00:48F8  C3 4A 49                jp  SET_ESP_WIFI_TIMEOUT        ; And set and done
    1619   00:48FB                      
