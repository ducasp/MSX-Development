    1304   00:46E1  3E 08                   ld  a,8                         ; Backspace
    1305   00:46E3  CD A2 00                call    CHPUT                   ; Print it
    1306   00:46E6  3E 20                   ld  a,' '                       ; Space
    1307   00:46E8  CD A2 00                call    CHPUT                   ; Print it
    1308   00:46EB  3E 08                   ld  a,8                         ; Backspace
    1309   00:46ED  CD A2 00                call    CHPUT                   ; Print it
    1310   00:46F0  18 88                   jr  WIFI_CONNECT_MANUAL_ENTRY   ; Return
