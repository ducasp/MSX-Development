    5060   00:5AEB                          SEND_DATA                       ; Send the command
    5060   00:5AEB  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5061   00:5AEE                          ; prepare new data size, adding our 1 byte overhead (connection #)
    5062   00:5AEE  23                      inc hl
    5063   00:5AEF  7C                      ld  a,h
    5064   00:5AF0                          SEND_DATA                       ; Send the command size msb
    5064   00:5AF0  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5065   00:5AF3  7D                      ld  a,l
    5066   00:5AF4                          SEND_DATA                       ; Send the command size lsb
    5066   00:5AF4  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5067   00:5AF7  78                      ld  a,b
    5068   00:5AF8                          SEND_DATA                       ; Send the connection #
    5068   00:5AF8  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
