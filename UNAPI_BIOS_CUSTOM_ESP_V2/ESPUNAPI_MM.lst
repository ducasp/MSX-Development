    1267   00:46A2  FE 20                   cp  32
    1268   00:46A4  30 04                   jr  nc,WIFI_CONNECT_ME_CHKPRT2  ; Ok, not below space, but is it delete?
    1269   00:46A6  3E 3F                   ld  a,'?'                       ; Prints a question mark
    1270   00:46A8  18 06                   jr  WIFI_CONNECT_ME_CHKPRTD
