    1199   00:4634  28 0B                   jr  z,APLIST_NO_OVERFLOW        ; No more items
    1200   00:4636  06 01                   ld  b,1                         ; Signal that there still is data pending to list in another page
    1201   00:4638  E5                      push    hl
