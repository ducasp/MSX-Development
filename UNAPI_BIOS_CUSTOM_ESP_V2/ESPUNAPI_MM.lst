    5275   00:5BF5                          ; nz, check the data
    5276   00:5BF5                          RECEIVE_DATA
    5276   00:5BF5  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5277   00:5BF8  FE 85                   cp  #85                         ; Is response of our command?
    5278   00:5BFA  20 ED                   jr  nz,SSH_SEND_ST1
    5279   00:5BFC                          ; now get return code, if return code other than 0, it is finished
    5280   00:5BFC                      SSH_SEND_RC:
