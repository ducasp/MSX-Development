    5131   00:5B5A                      ;========================
    5132   00:5B5A                      ;===  TCPIP_TCP_SEND  ===
    5133   00:5B5A                      ;========================
    5134   00:5B5A                      ;Send data to a TCP connection.
    5135   00:5B5A                      ;
    5136   00:5B5A                      ;Input:  A  = 17
    5137   00:5B5A                      ;        B  = Connection number
    5138   00:5B5A                      ;        DE = Address of the data to be sent
    5139   00:5B5A                      ;        HL = Length of the data to be sent
    5140   00:5B5A                      ;        C  = Flags:
    5141   00:5B5A                      ;             bit 0: Send the data PUSHed
    5142   00:5B5A                      ;             bit 1: The data is urgent
    5143   00:5B5A                      ;Output: A = Error code
    5144   00:5B5A                      TCPIP_TCP_SEND:
    5145   00:5B5A  E5                      push    hl
    5146   00:5B5B  D5                      push    de
    5147   00:5B5C                          SEND_DATA                       ; Send the command
    5147   00:5B5C  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5148   00:5B5F                          ; prepare new data size, adding our 2 bytes overhead
    5149   00:5B5F  11 02 00                ld  de,2
    5150   00:5B62  19                      add hl,de
    5151   00:5B63  7C                      ld  a,h
    5152   00:5B64                          SEND_DATA                       ; Send the command size msb
    5152   00:5B64  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5153   00:5B67  7D                      ld  a,l
    5154   00:5B68                          SEND_DATA                       ; Send the command size lsb
    5154   00:5B68  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5155   00:5B6B  78                      ld  a,b
    5156   00:5B6C                          SEND_DATA                       ; Send the connection #
    5156   00:5B6C  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5157   00:5B6F  79                      ld  a,c
    5158   00:5B70                          SEND_DATA                       ; Send the connection flags
    5158   00:5B70  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5159   00:5B73  E1                      pop hl
    5160   00:5B74  D1                      pop de
    5161   00:5B75                          ; now oti the data starting at hl, size is in DE
    5162   00:5B75                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    5163   00:5B75  43                      ld  b,e                         ;Number of loops originaly in DE
    5164   00:5B76  1B                      dec de
    5165   00:5B77  14                      inc d
    5166   00:5B78                          if USE_MEM_IO = 0
