    2931   00:503C  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2931   00:503F  CB 47             >     bit 0,a
    2932   00:5041  20 05                   jr  nz,TCPIP_GET_CAPAB_BLK1_ST4.1
    2933   00:5043  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2934   00:5046  18 F4                   jr  TCPIP_GET_CAPAB_BLK1_ST4
    2935   00:5048                      TCPIP_GET_CAPAB_BLK1_ST4.1:
