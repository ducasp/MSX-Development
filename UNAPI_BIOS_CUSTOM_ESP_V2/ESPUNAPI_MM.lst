     334   00:4000  (00:0000)           UNAPI_TCPIP_NS_CLOSED   equ 0
     335   00:4000  (00:0001)           UNAPI_TCPIP_NS_OPENING  equ 1
     336   00:4000  (00:0002)           UNAPI_TCPIP_NS_OPEN     equ 2
