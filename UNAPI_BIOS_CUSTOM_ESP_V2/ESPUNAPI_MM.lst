    4761   00:593C  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    4761   00:593F  CB 47             >     bit 0,a
    4762   00:5941  20 05                   jr  nz,TCPIP_TCP_STATE_ERROR2.1
