    1089   00:457B  C3 07 4A                jp  WAIT_2S_AND_THEN_MAINMENU
    1090   00:457E                      
    1091   00:457E                      ;============================
    1092   00:457E                      ;===  SETUP Menu Routines  ==
    1093   00:457E                      ;===    Wi-Fi Scan Menu    ==
    1094   00:457E                      ;============================
    1095   00:457E                      START_WIFI_SCAN:
    1096   00:457E  3E 33                   ld  a,'3'
    1097   00:4580  CD A2 00                call    CHPUT
    1098   00:4583  CD 0F 4A                call    WAIT_250MS_AND_THEN_CONTINUE
    1099   00:4586                      START_WIFI_RESCAN:
    1100   00:4586  21 DA 67                ld  hl,MMENU_SCAN
    1101   00:4589  CD 96 4C                call    PRINTHL                 ; Print Main Scan message
    1102   00:458C  CD B4 49                call    STARTWIFISCAN           ; Request Wi-Fi Scan to start
    1103   00:458F  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1104   00:4593  DD 6B                   ld  ixl,e
    1105   00:4595  DD 62                   ld  ixh,d                       ; Address in IX
    1106   00:4597  11 14 00                ld  de,20                       ; At least 10s waiting scan to finish, retry 20 times waiting 0.5s between attempts
    1107   00:459A                      WIFI_SCAN_WAIT_END:
    1108   00:459A                          CLEAR_UART
    1108   00:459A  3E 14             >     ld  a,20
    1108   00:459C  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    1109   00:459F  3E 73                   ld  a,CMD_SCAN_RESULTS
    1110   00:45A1                          SEND_DATA
    1110   00:45A1  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1111   00:45A4  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1112   00:45A7  CD FF 4B                call    WAIT_MENU_SCMD_RESPONSE
    1113   00:45AA  C2 C2 45                jp  nz,WIFI_SCAN_SHOW_LIST      ; if success show the list
    1114   00:45AD  78                      ld  a,b
    1115   00:45AE  FE 02                   cp  2                           ; If 2, scan is done and nothing found
    1116   00:45B0  CA 1C 48                jp  z,WIFI_SCAN_NONETWORKS
    1117   00:45B3  2E 1E                   ld  l,30
    1118   00:45B5                      WIFI_SCAN_WAITHS:
    1119   00:45B5  76                      halt
    1120   00:45B6  2D                      dec l
    1121   00:45B7  20 FC                   jr  nz,WIFI_SCAN_WAITHS
    1122   00:45B9  1B                      dec de
    1123   00:45BA  7B                      ld  a,e
    1124   00:45BB  B2                      or  d
    1125   00:45BC  CA 25 48                jp  z,WIFI_SCAN_TIMEOUT
    1126   00:45BF  C3 9A 45                jp  WIFI_SCAN_WAIT_END
    1127   00:45C2                      WIFI_SCAN_SHOW_LIST:
    1128   00:45C2  57                      ld  d,a                         ; Save access point counter here
    1129   00:45C3  1E 00                   ld  e,0                         ; And here how many were printed
    1130   00:45C5  21 5F 68                ld  hl,MMENU_SCANS
    1131   00:45C8  CD 96 4C                call    PRINTHL
    1132   00:45CB  DD E5                   push    ix
    1133   00:45CD  E1                      pop hl                          ; IX in HL
    1134   00:45CE                      WIFI_LIST_LOOP:
    1135   00:45CE  7B                      ld  a,e
    1136   00:45CF  C6 30                   add a,'0'                       ; Convert to number
    1137   00:45D1  CD A2 00                call    CHPUT
    1138   00:45D4  3E 20                   ld  a,' '                       ; Space
    1139   00:45D6  CD A2 00                call    CHPUT
    1140   00:45D9  3E 2D                   ld  a,'-'                       ; Dash
    1141   00:45DB  CD A2 00                call    CHPUT
    1142   00:45DE  3E 20                   ld  a,' '                       ; Space
    1143   00:45E0  CD A2 00                call    CHPUT
    1144   00:45E3  06 18                   ld  b,24                        ; Cuts AP names > 23 chars
    1145   00:45E5                      PRT_APNAMELP:
    1146   00:45E5  7E                      ld  a,(hl)
    1147   00:45E6  B7                      or  a
    1148   00:45E7  CA 01 46                jp  z,PRT_APENC
    1149   00:45EA  CD A2 00                call    CHPUT
    1150   00:45ED  23                      inc hl
    1151   00:45EE  10 F5                   djnz    PRT_APNAMELP
    1152   00:45F0  E5                      push    hl
    1153   00:45F1  21 F6 69                ld  hl,SCAN_TERMINATOR_CUT
    1154   00:45F4  CD 96 4C                call    PRINTHL
    1155   00:45F7  E1                      pop hl
    1156   00:45F8                      PRT_APNAMELP_CUT:
    1157   00:45F8  7E                      ld  a,(hl)
    1158   00:45F9  B7                      or  a
    1159   00:45FA  CA 01 46                jp  z,PRT_APENC
    1160   00:45FD  23                      inc hl
    1161   00:45FE  C3 F8 45                jp  PRT_APNAMELP_CUT
    1162   00:4601                      PRT_APENC:
    1163   00:4601  23                      inc hl
    1164   00:4602  7E                      ld  a,(hl)
    1165   00:4603  B7                      or  a
    1166   00:4604  CA 12 46                jp  z,PRT_APNOTENC
    1167   00:4607  E5                      push    hl
    1168   00:4608  21 04 6A                ld  hl,SCAN_TERMINATOR_ENC
    1169   00:460B  CD 96 4C                call    PRINTHL
    1170   00:460E  E1                      pop hl
    1171   00:460F  C3 1A 46                jp  PRT_AP_CHKLOOP
    1172   00:4612                      PRT_APNOTENC:
    1173   00:4612  E5                      push    hl
    1174   00:4613  21 FD 69                ld  hl,SCAN_TERMINATOR_OPEN
    1175   00:4616  CD 96 4C                call    PRINTHL
    1176   00:4619  E1                      pop hl
    1177   00:461A                      PRT_AP_CHKLOOP:
    1178   00:461A  23                      inc hl
    1179   00:461B  1C                      inc e
    1180   00:461C  3E 08                   ld  a,SCAN_MAX_PAGE_SIZE
    1181   00:461E  BB                      cp  e
    1182   00:461F  CA 2A 46                jp  z,APLIST_OVERFLOW
    1183   00:4622  15                      dec d
    1184   00:4623  C2 CE 45                jp  nz,WIFI_LIST_LOOP
    1185   00:4626  06 00                   ld  b,0                         ; Signal no more list data
    1186   00:4628  18 10                   jr  APLIST_NO_OVERFLOW
    1187   00:462A                      APLIST_OVERFLOW:
    1188   00:462A  15                      dec d                           ; Update remaining items
    1189   00:462B  AF                      xor a
    1190   00:462C  B2                      or  d                           ; Still has items?
    1191   00:462D  28 0B                   jr  z,APLIST_NO_OVERFLOW        ; No more items
    1192   00:462F  06 01                   ld  b,1                         ; Signal that there still is data pending to list in another page
    1193   00:4631  E5                      push    hl
    1194   00:4632  FD E1                   pop iy                          ; Save in IY the address to continue from
    1195   00:4634  4A                      ld  c,d                         ; And C has the remaining AP count
    1196   00:4635  21 87 69                ld  hl,MMENU_SCANQM
    1197   00:4638  18 03                   jr  APLIST_NOFLW
    1198   00:463A                      APLIST_NO_OVERFLOW:
    1199   00:463A                          ; If here, current page has been printed
    1200   00:463A                          ; E has the maximum allowable AP number
    1201   00:463A                          ; B will indicate if there are more items for a next page
    1202   00:463A                          ; IY will hold the address of the following items
    1203   00:463A                          ; Let's ask which one to connect
    1204   00:463A  21 1C 69                ld  hl,MMENU_SCANQ
    1205   00:463D                      APLIST_NOFLW:
    1206   00:463D  CD 96 4C                call    PRINTHL                 ; Show message asking which network to connect
    1207   00:4640  3E 30                   ld  a,'0'
    1208   00:4642  83                      add a,e
    1209   00:4643  5F                      ld  e,a                         ; To make it easy in the selection screen
    1210   00:4644                      WIFI_SELECT_AP:
    1211   00:4644  CD 9F 00                call    CHGET
    1212   00:4647  FE 1B                   cp  #1b                         ; ESC?
    1213   00:4649  CA 5C 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1214   00:464C  FE 20                   cp  #20                         ; Spacebar?
    1215   00:464E  CA 62 46                jp  z,WIFI_SELECT_SPACEBAR      ; Check if re-scan or next page
    1216   00:4651  FE 0D                   cp  CR                          ; ENTER?
    1217   00:4653  CA 6F 46                jp  z,WIFI_CONNECT_ME_CHOOSEN   ; Request AP Name and Password if needed
    1218   00:4656  FE 30                   cp  '0'                         ; Check if A is less than 0
    1219   00:4658  DA 06 48                jp  c,INPUT_WFSAP_BAD_INPUT     ; If it is, ignore
    1220   00:465B  BB                      cp  e                           ; Check if a is greater than what is in E
    1221   00:465C  D2 06 48                jp  nc,INPUT_WFSAP_BAD_INPUT    ; If it is, ignore
    1222   00:465F  C3 F9 46                jp  WIFI_CONNECT_SELECTION_OK   ; Selection Ok if here
    1223   00:4662                      
    1224   00:4662                      WIFI_SELECT_SPACEBAR:
    1225   00:4662  AF                      xor a
    1226   00:4663  B2                      or  d                           ; D = AP counter
    1227   00:4664  CA 86 45                jp  z,START_WIFI_RESCAN         ; Rescan if no more items
    1228   00:4667                          ; Otherwise, more items, start at IY
    1229   00:4667  FD E5                   push    iy
    1230   00:4669  DD E1                   pop ix                          ; Restore the list from where we finished last time
    1231   00:466B  79                      ld  a,c                         ; Restore the remaining APs to list
    1232   00:466C  C3 C2 45                jp  WIFI_SCAN_SHOW_LIST         ; And show
    1233   00:466F                      
    1234   00:466F                      WIFI_CONNECT_ME_CHOOSEN:
    1235   00:466F  21 5E 67                ld  hl,MMENU_MANUALENTRY
    1236   00:4672  CD 96 4C                call    PRINTHL                 ; Show message asking AP details....
    1237   00:4675                          ; IX has the AP list, we don't care, but that address is ours to use to handle SSID Entry
    1238   00:4675  DD E5                   push    ix
    1239   00:4677  E1                      pop hl                          ; HL has the address
    1240   00:4678  0E 00                   ld  c,0                         ; AP name size
    1241   00:467A                      WIFI_CONNECT_MANUAL_ENTRY:
    1242   00:467A  CD 9F 00                call    CHGET
    1243   00:467D  FE 1B                   cp  #1b                         ; ESC?
    1244   00:467F  CA 5C 42                jp  z,ESPSETUP                  ; Back to main setup
    1245   00:4682  FE 08                   cp  #08                         ; Backspace?
    1246   00:4684  28 55                   jr  z,WIFI_CONNECT_ME_BS        ; Check if there is something to erase
    1247   00:4686  FE 0D                   cp  #0d                         ; ENTER?
