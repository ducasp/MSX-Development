    2498   00:4E06                      ;--- Implementation-specific routines addresses table
    2499   00:4E06                      
    2500   00:4E06                      FN_TABLE_S:
    2501   00:4E06  46 4E               FN_0_S:                 dw  UNAPI_GET_INFO_SSH
    2502   00:4E08  51 4E               FN_1_S:                 dw  SSH_GET_CAPAB
    2503   00:4E0A  B1 56               FN_2_S:                 dw  SSH_OPEN
    2504   00:4E0C  0B 5A               FN_3_S:                 dw  SSH_CLOSE
    2505   00:4E0E  5D 5A               FN_4_S:                 dw  SSH_STATE
    2506   00:4E10  ED 5D               FN_5_S:                 dw  SSH_SEND
    2507   00:4E12  ED 5F               FN_6_S:                 dw  SSH_RCV
    2508   00:4E14  DF 5A               FN_7_S:                 dw  SSH_TERM_TYPE
    2509   00:4E16  5C 5B               FN_8_S:                 dw  SSH_WIN_SIZE
    2510   00:4E18  CD 60               FN_9_S:                 dw  SSH_AUTH_GET_CHALLENGE
    2511   00:4E1A  4E 5E               FN_10_S:                dw  SSH_AUTH_RESPOND
    2512   00:4E1C  92 57               FN_11_S:                dw  SSH_ADD_KNOWN_HOST
    2513   00:4E1E  E4 57               FN_12_S:                dw  SSH_KEY_GEN
    2514   00:4E20  30 58               FN_13_S:                dw  SSH_KEY_EXPORT
    2515   00:4E22  FD 58               FN_14_S:                dw  SSH_KEY_IMPORT
