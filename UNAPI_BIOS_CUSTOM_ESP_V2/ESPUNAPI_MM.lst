    4910   00:5A12                      ;===  TCPIP_TCP_STATE  ===
    4911   00:5A12                      ;=========================
    4912   00:5A12                      ;Get the state of a TCP connection.
    4913   00:5A12                      ;
    4914   00:5A12                      ;Input:  A = 16
    4915   00:5A12                      ;        B = Connection number
    4916   00:5A12                      ;        HL = Pointer in TPA for connection information block
    4917   00:5A12                      ;             (0 if not needed)
    4918   00:5A12                      ;Output: A  = Error code
    4919   00:5A12                      ;        B  = Connection state
    4920   00:5A12                      ;        C  = Close reason (only if ERR_NO_CONN is returned)
    4921   00:5A12                      ;        HL = Number of total available incoming bytes
    4922   00:5A12                      ;        DE = Number of urgent available incoming bytes
    4923   00:5A12                      ;        IX = Available free space in the output buffer
    4924   00:5A12                      ;             (0FFFFh = infinite)
    4925   00:5A12                      ;
    4926   00:5A12                      ;Connection information block consists of:
    4927   00:5A12                      ;
    4928   00:5A12                      ;    +0 (4): Remote IP address
    4929   00:5A12                      ;    +4 (2): Remote port
    4930   00:5A12                      ;    +6 (2): Local port
    4931   00:5A12                      TCPIP_TCP_STATE_ERROR:
    4932   00:5A12                          ; next two bytes are size bytes, don't care
    4933   00:5A12  47                      ld  b,a                         ; save error in b
    4934   00:5A13  0E 02                   ld  c,2
