    3942   00:555A                      ;========================
    3943   00:555A                      ;===  TCPIP_TCP_OPEN  ===
    3944   00:555A                      ;========================
    3945   00:555A                      ;Open a TCP connection.
    3946   00:555A                      ;
    3947   00:555A                      ;Input:  A  = 13
    3948   00:555A                      ;        HL = Address of parameters block
    3949   00:555A                      ;Output: A = Error code
    3950   00:555A                      ;        B = Connection number
    3951   00:555A                      ;        C = Connection not open reason (mostly for TLS)
    3952   00:555A                      ;
    3953   00:555A                      ;Parameters block format:
    3954   00:555A                      ;
    3955   00:555A                      ;+0 (4): Remote IP address (0.0.0.0 for unspecified remote socket)
    3956   00:555A                      ;+4 (2): Remote port (ignored if unspecified remote socket)
    3957   00:555A                      ;+6 (2): Local port, 0FFFFh for a random value
    3958   00:555A                      ;+8 (2): Suggestion for user timeout value
    3959   00:555A                      ;+10 (1): Flags:
    3960   00:555A                      ;         bit 0: Set for passive connection
    3961   00:555A                      ;         bit 1: Set for resident connection
    3962   00:555A                      ;         bit 2: Set for TLS connection
    3963   00:555A                      ;         bit 3: Set for TLS connection validating host certificate
    3964   00:555A                      ;+11 (2): If 0000 no host name validation, otherwise the hostname string address (zero terminated)
    3965   00:555A                      ;TCP_OPEN_IP1               (ix+0)
    3966   00:555A                      ;TCP_OPEN_IP2               (ix+1)
    3967   00:555A                      ;TCP_OPEN_IP3               (ix+2)
    3968   00:555A                      ;TCP_OPEN_IP4               (ix+3)
    3969   00:555A                      ;TCP_OPEN_RP                (ix+4)
    3970   00:555A                      ;TCP_OPEN_LP                (ix+6)
    3971   00:555A                      ;TCP_OPEN_TO                (ix+8)
    3972   00:555A                      ;TCP_OPEN_CMD_FLAGS         (ix+10)
    3973   00:555A                      ;TCP_OPEN_CMD_HOST_LSB      (ix+11)
    3974   00:555A                      ;TCP_OPEN_CMD_HOST_MSB      (ix+12)
    3975   00:555A                      
    3976   00:555A                      ; When no connection, let's get the reason and put in register C, as agreed
    3977   00:555A                      ; with Nestor this will be the way to go in the next UNAPI revision
    3978   00:555A                      TCPIP_TCP_OPEN_ERROR:
    3979   00:555A                          ; next two bytes are return code and size bytes, don't care, it is 1, conn close reason
    3980   00:555A  47                      ld  b,a                         ; save error in b
    3981   00:555B  0E 02                   ld  c,2
    3982   00:555D                      TCPIP_TCP_OPEN_ERROR2:
    3983   00:555D                          CHECK_DATA
    3983   00:555D  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3983   00:5560  CB 47             >     bit 0,a
    3984   00:5562  20 05                   jr  nz,TCPIP_TCP_OPEN_ERROR2.1
    3985   00:5564  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3986   00:5567  18 F4                   jr  TCPIP_TCP_OPEN_ERROR2
    3987   00:5569                      TCPIP_TCP_OPEN_ERROR2.1:
    3988   00:5569                          ; nz, discard
    3989   00:5569                          RECEIVE_DATA
    3989   00:5569  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3990   00:556C  0D                      dec c
    3991   00:556D  20 EE                   jr  nz,TCPIP_TCP_OPEN_ERROR2
    3992   00:556F  78                      ld  a,b
    3993   00:5570  FE 0B                   cp  ERR_NO_CONN
    3994   00:5572  20 10                   jr  nz,TCPIP_TCP_OPEN_ERROR4    ; other errors do not have extra bytes as result
    3995   00:5574                      ; now just get the 1 byte, close reason, should go to C
    3996   00:5574                      TCPIP_TCP_OPEN_ERROR3:
    3997   00:5574                          CHECK_DATA
    3997   00:5574  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3997   00:5577  CB 47             >     bit 0,a
    3998   00:5579  20 05                   jr  nz,TCPIP_TCP_OPEN_ERROR3.1
    3999   00:557B  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4000   00:557E  18 F4                   jr  TCPIP_TCP_OPEN_ERROR3
    4001   00:5580                      TCPIP_TCP_OPEN_ERROR3.1:
    4002   00:5580                          ; nz, get it
    4003   00:5580                          RECEIVE_DATA
    4003   00:5580  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4004   00:5583  4F                      ld  c,a
    4005   00:5584                      TCPIP_TCP_OPEN_ERROR4:
    4006   00:5584                          ; now return w/ error that is saved in b
    4007   00:5584  78                      ld  a,b
    4008   00:5585  06 00                   ld  b,0                         ; no connection, so 0
    4009   00:5587  C9                      ret
    4010   00:5588                      
    4011   00:5588                      TCPIP_TCP_OPEN:
    4012   00:5588  E5                      push    hl                      ; save param block address
    4013   00:5589  7C                      ld  a,h
    4014   00:558A  DD 67                   ld  ixh,a
    4015   00:558C  7D                      ld  a,l
    4016   00:558D  DD 6F                   ld  ixl,a
    4017   00:558F                          ; IX now has the parameters area
    4018   00:558F                          ; most times it will be non tls, so this is the first test case
    4019   00:558F  21 0B 00                ld  hl,11
    4020   00:5592  CD 7F 61                call    SETWORD                 ; If it is non-TLS, send 11 bytes
    4021   00:5595  DD 7E 0A                ld  a,(ix+10)                   ; TCP_OPEN_CMD_FLAGS
    4022   00:5598  CB 57                   bit 2,a
    4023   00:559A  28 4F                   jr  z,TCPIP_TCP_OPEN_NO_TLS
    4024   00:559C                      
    4025   00:559C                          ; TLS, but, do we have host name?
    4026   00:559C  21 0C 00                ld  hl,12
    4027   00:559F  CD 7F 61                call    SETWORD                 ; If it is TLS without host name, send 12 bytes, one zero as host name suffice
    4028   00:55A2  DD 6E 0B                ld  l,(ix+11)                   ; TCP_OPEN_CMD_HOST_LSB
    4029   00:55A5  DD 7E 0C                ld  a,(ix+12)                   ; TCP_OPEN_CMD_HOST_MSB
    4030   00:55A8  B5                      or  l
    4031   00:55A9                          ; if TLS and next two bytes are 00 no host to check
    4032   00:55A9  28 40                   jr  z,TCPIP_TCP_OPEN_NO_CHECKHOST
    4033   00:55AB                          ; we are here, host to check
    4034   00:55AB  DD 66 0C                ld  h,(ix+12)                   ; TCP_OPEN_CMD_HOST_MSB
    4035   00:55AE  D1                      pop de                          ; Retrieve parameters address
    4036   00:55AF  E5                      push    hl                      ; Save host name address
    4037   00:55B0  D5                      push    de                      ; Save Parameters address (so it is in the order we are going to need)
    4038   00:55B1                          ; let's check how many bytes there are
    4039   00:55B1  11 0B 00                ld  de,11                       ; Start with 11, all params except host name
    4040   00:55B4                      TCPIP_TCP_OPEN_CHECK_HOSTOF:
    4041   00:55B4  7E                      ld  a,(hl)
    4042   00:55B5  13                      inc de                          ; Not zero, so increase size count
    4043   00:55B6  23                      inc hl                          ; And next hostname byte
    4044   00:55B7  B7                      or  a                           ; If zero, hostname terminated
    4045   00:55B8                          ; Loop until terminator (0) is found
    4046   00:55B8  C2 B4 55                jp  nz,TCPIP_TCP_OPEN_CHECK_HOSTOF
    4047   00:55BB                      
    4048   00:55BB                      TCPIP_TCP_OPEN_HOSTNAME_SENDCMDWITHHOSTNAME:
    4049   00:55BB                          ; Ok, so, DE has the full hostname size, let's start sending from here
    4050   00:55BB  3E 0D                   ld  a,13                        ; Function TCP OPEN
    4051   00:55BD                          SEND_DATA                       ; Send the command
    4051   00:55BD  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4052   00:55C0  7A                      ld  a,d
    4053   00:55C1                          SEND_DATA                       ; Send the command size msb
    4053   00:55C1  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4054   00:55C4  7B                      ld  a,e
    4055   00:55C5                          SEND_DATA                       ; Send the command size lsb
    4055   00:55C5  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4056   00:55C8  E1                      pop hl                          ; Restore the memory address for the parameters
    4057   00:55C9                          ; First send the 11 bytes parameters
    4058   00:55C9                          if USE_MEM_IO = 0
    4059   00:55C9                    ~     ld  c,OUT_TX_PORT
    4060   00:55C9                    ~     outi
    4061   00:55C9                    ~     outi
    4062   00:55C9                    ~     outi
    4063   00:55C9                    ~     outi
    4064   00:55C9                    ~     outi
    4065   00:55C9                    ~     outi
    4066   00:55C9                    ~     outi
    4067   00:55C9                    ~     outi
    4068   00:55C9                    ~     outi
    4069   00:55C9                    ~     outi
    4070   00:55C9                    ~     outi                            ; Unrolled outi is a bit faster :)
    4071   00:55C9                    ~     else
    4072   00:55C9  06 0B                   ld  b,11                        ; Send 11 bytes
    4073   00:55CB                      TCPIP_TCP_OPEN_HOSTNAME_SENDCMDWITHHOSTNAME_LOOP_PARAM:
    4074   00:55CB  7E                      ld  a,(hl)
    4075   00:55CC  32 07 7F                ld  (MEM_OUT_TX_PORT),a
    4076   00:55CF  23                      inc hl
    4077   00:55D0  10 F9                   djnz TCPIP_TCP_OPEN_HOSTNAME_SENDCMDWITHHOSTNAME_LOOP_PARAM
    4078   00:55D2                          endif
    4079   00:55D2  EB                      ex  de,hl                       ; Size in HL
    4080   00:55D3  11 0B 00                ld  de,11
    4081   00:55D6  B7                      or  a                           ; zero flag
    4082   00:55D7  ED 52                   sbc hl,de
    4083   00:55D9  EB                      ex de,hl                        ; and adjusted size back in de
    4084   00:55DA  E1                      pop hl                          ; Restore the memory address for hostname
    4085   00:55DB                      ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    4086   00:55DB  43                      ld  b,e                         ; Number of loops originaly in DE
    4087   00:55DC  1B                      dec de
    4088   00:55DD  14                      inc d
    4089   00:55DE                          if USE_MEM_IO = 0
    4090   00:55DE                    ~     ld  c,OUT_TX_PORT
    4091   00:55DE                    ~ TCPIP_TCP_OPEN_SENDHOSTNAME:
    4092   00:55DE                    ~     outi
    4093   00:55DE                    ~     jr  nz,TCPIP_TCP_OPEN_SENDHOSTNAME
    4094   00:55DE                    ~     else
    4095   00:55DE                      TCPIP_TCP_OPEN_SENDHOSTNAME:
    4096   00:55DE  7E                      ld  a,(hl)
    4097   00:55DF  32 07 7F                ld  (MEM_OUT_TX_PORT),a
    4098   00:55E2  23                      inc hl
    4099   00:55E3  10 F9                   djnz TCPIP_TCP_OPEN_SENDHOSTNAME
    4100   00:55E5                          endif
    4101   00:55E5  15                      dec d
    4102   00:55E6  20 F6                   jr  nz,TCPIP_TCP_OPEN_SENDHOSTNAME
    4103   00:55E8  C3 0B 56                jp  TCPIP_TCP_OPEN_WAIT_RESPONSE
