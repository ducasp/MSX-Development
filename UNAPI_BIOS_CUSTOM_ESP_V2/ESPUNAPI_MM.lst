    3508   00:52FA  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3508   00:52FD  CB 47             >     bit 0,a
    3509   00:52FF  20 05                   jr  nz,TCPIP_UDP_STATE_ST1.1
    3510   00:5301  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3511   00:5304  18 F4                   jr  TCPIP_UDP_STATE_ST1
    3512   00:5306                      TCPIP_UDP_STATE_ST1.1:
    3513   00:5306                          ; nz, check the data
    3514   00:5306                          RECEIVE_DATA
    3514   00:5306  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3515   00:5309  FE 0A                   cp  10                          ; Is response of our command?
    3516   00:530B  20 ED                   jr  nz,TCPIP_UDP_STATE_ST1
    3517   00:530D                          ; now get return code, if return code other than 0, it is finished
    3518   00:530D                      TCPIP_UDP_STATE_RC:
    3519   00:530D                          CHECK_DATA
    3519   00:530D  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3519   00:5310  CB 47             >     bit 0,a
    3520   00:5312  20 05                   jr  nz,TCPIP_UDP_STATE_RC.1
    3521   00:5314  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3522   00:5317  18 F4                   jr  TCPIP_UDP_STATE_RC
    3523   00:5319                      TCPIP_UDP_STATE_RC.1:
    3524   00:5319                          ; nz, discard
