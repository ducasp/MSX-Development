    2804   00:4F6C                      TCPIP_GET_CAPAB_BLK3_ST1.1:
    2805   00:4F6C                          ; nz, get it
    2806   00:4F6C                          RECEIVE_DATA
    2806   00:4F6C  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2807   00:4F6F  6F                      ld  l,a
    2808   00:4F70                      TCPIP_GET_CAPAB_BLK3_ST2:
    2809   00:4F70                          CHECK_DATA
    2809   00:4F70  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2809   00:4F73  CB 47             >     bit 0,a
    2810   00:4F75  20 05                   jr  nz,TCPIP_GET_CAPAB_BLK3_ST2.1
    2811   00:4F77  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2812   00:4F7A  18 F4                   jr  TCPIP_GET_CAPAB_BLK3_ST2
    2813   00:4F7C                      TCPIP_GET_CAPAB_BLK3_ST2.1:
    2814   00:4F7C                          ; nz, get it
    2815   00:4F7C                          RECEIVE_DATA
    2815   00:4F7C  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2816   00:4F7F  67                      ld  h,a
    2817   00:4F80                      TCPIP_GET_CAPAB_BLK3_ST3:
    2818   00:4F80                          CHECK_DATA
    2818   00:4F80  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2818   00:4F83  CB 47             >     bit 0,a
    2819   00:4F85  20 05                   jr  nz,TCPIP_GET_CAPAB_BLK3_ST3.1
    2820   00:4F87  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2821   00:4F8A  18 F4                   jr  TCPIP_GET_CAPAB_BLK3_ST3
    2822   00:4F8C                      TCPIP_GET_CAPAB_BLK3_ST3.1:
    2823   00:4F8C                          ; nz, get it
