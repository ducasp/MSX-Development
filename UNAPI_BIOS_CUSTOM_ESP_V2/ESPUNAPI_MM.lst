    5705   00:5E3C  CD 8C 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5706   00:5E3F  18 F4                   jr  SSH_RCV_ST2B
    5707   00:5E41                      SSH_RCV_ST2B.1:
    5708   00:5E41                          ; nz, low byte count of bytes to receive
    5709   00:5E41                          RECEIVE_DATA
    5709   00:5E41  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5710   00:5E44  6F                      ld  l,a
    5711   00:5E45  B4                      or  h
    5712   00:5E46                          ; if it was 0, no data
    5713   00:5E46                          if USE_MEM_IO = 1
    5714   00:5E46  CA C4 5C                jp  z,TCPIP_TCP_RCV_RET_NODATA  ; not a typo, no need to make the same code again
    5715   00:5E49                          else
    5716   00:5E49                    ~     jp  z,TCPIP_TCP_RCV_RET_NODATA  ; not a typo, no need to make the same code again
    5717   00:5E49                    ~     endif
    5718   00:5E49  4D                      ld  c,l
    5719   00:5E4A  44                      ld  b,h                         ; BC has effective received data size, as well as HL
    5720   00:5E4B                      
    5721   00:5E4B                          ; put effective data size in de
    5722   00:5E4B  EB                      ex  de,hl
    5723   00:5E4C                          ; will start moving at address in stack (we've pushed the adress in WORD)
    5724   00:5E4C  CD 74 61                call    GETWORD
