    2221   00:4CD7                      ;===============================
    2222   00:4CD7                      ;===  HTIM_I hook execution  ===
    2223   00:4CD7                      ;===============================
    2224   00:4CD7                      DO_HTIMI:
    2225   00:4CD7  F5                      push    af                      ; HTIM hook -> need to keep A value
    2226   00:4CD8  CD 52 63                call    GETCOUNTER              ; Counter in hl
    2227   00:4CDB  7D                      ld  a,l
    2228   00:4CDC  B4                      or  h                           ; In this operation, check if HL is 0
    2229   00:4CDD  28 04                   jr  z,DO_HTIMI_END              ; If it is, nothing to do
    2230   00:4CDF  2B                      dec hl                          ; Otherwise decrement it
    2231   00:4CE0  CD 61 63                call    SETCOUNTER              ; And save it
    2232   00:4CE3                      DO_HTIMI_END:
    2233   00:4CE3  CD C1 62                call    GETSLT
    2234   00:4CE6                          ; Slot in A, now get the address of our counter
    2235   00:4CE6  CD 4A 63                call    GETMEMPOINTER
    2236   00:4CE9                          ; HL has the address of our memory area, and there is where we should jump
    2237   00:4CE9  F1                      pop af                          ; Restore original A value
    2238   00:4CEA  E9                      jp  (hl)
    2239   00:4CEB                      
    2240   00:4CEB                      ;===============================
    2241   00:4CEB                      ;===  EXTBIO hook execution  ===
