    2347   00:4D6A  B7                      or  a
    2348   00:4D6B  20 06                   jr  nz,DO_EXTBIO2SSH
    2349   00:4D6D  04                      inc b
    2350   00:4D6E  E3                      ex  (sp),hl
    2351   00:4D6F  11 22 22                ld  de,#2222
    2352   00:4D72  C9                      ret
    2353   00:4D73                      
