    4247   00:56B1                      ;========================
    4248   00:56B1                      ;===     SSH_OPEN     ===
    4249   00:56B1                      ;========================
    4250   00:56B1                      ;Open a SSH connection.
    4251   00:56B1                      ;
    4252   00:56B1                      ;Input:  A  = 2
    4253   00:56B1                      ;        HL = Address of parameters block
    4254   00:56B1                      ;Output: A = Error code
    4255   00:56B1                      ;        B = Connection number
    4256   00:56B1                      ;
    4257   00:56B1                      ;Parameters block format:
    4258   00:56B1                      ;
    4259   00:56B1                      ;+0 (4): Remote IP address (0.0.0.0 for unspecified remote socket)
    4260   00:56B1                      ;+4 (2): Remote port (ignored if unspecified remote socket)
    4261   00:56B1                      ;+6 (1): Subsystem
    4262   00:56B1                      ;+7 (1): Flags
    4263   00:56B1                      ;+8 (variable): username (0 terminated) and then password or public key (0 terminated)
    4264   00:56B1                      ;
    4265   00:56B1                      ;Parameter block MUST have at least 32 bytes available if doing host key verification
    4266   00:56B1                      ;as unknown host key hash will be returned in it
    4267   00:56B1                      
    4268   00:56B1                      SSH_OPEN:
    4269   00:56B1  E5                      push    hl                      ; save param block address
    4270   00:56B2  3E 08                   ld  a,8
    4271   00:56B4  85                      add a,l
    4272   00:56B5  6F                      ld  l,a
    4273   00:56B6  30 01                   jr  nc,SSH_OPEN_1
    4274   00:56B8  24                      inc h
    4275   00:56B9                      SSH_OPEN_1:
    4276   00:56B9                          ; let's check how many bytes there are
    4277   00:56B9  11 08 00                ld  de,8                        ; Start with 8, all params except username and password
    4278   00:56BC                      SSH_OPEN_CHECK_USER:
    4279   00:56BC  7E                      ld  a,(hl)
    4280   00:56BD  13                      inc de                          ; Increase size count
    4281   00:56BE  23                      inc hl                          ; And next byte
    4282   00:56BF  B7                      or  a                           ; If zero, user terminated
    4283   00:56C0                          ; Loop until terminator (0) is found
    4284   00:56C0  C2 BC 56                jp  nz,SSH_OPEN_CHECK_USER
    4285   00:56C3                      SSH_OPEN_CHECK_PASS:
    4286   00:56C3  7E                      ld  a,(hl)
    4287   00:56C4  13                      inc de                          ; Increase size count
    4288   00:56C5  23                      inc hl                          ; And next byte
    4289   00:56C6  B7                      or  a                           ; If zero, password terminated
    4290   00:56C7                          ; Loop until terminator (0) is found
    4291   00:56C7  C2 C3 56                jp  nz,SSH_OPEN_CHECK_PASS
