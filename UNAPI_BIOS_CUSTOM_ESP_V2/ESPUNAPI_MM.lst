    5215   00:5BBA  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5216   00:5BBD  05                      dec b
    5217   00:5BBE  20 EE                   jr  nz,TCPIP_TCP_SEND_ST2
    5218   00:5BC0                      
    5219   00:5BC0                          ; done, no return data other than return code
    5220   00:5BC0  AF                      xor a
