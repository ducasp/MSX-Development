    5308   00:5C23                      ;========================
    5309   00:5C23                      ;=== SSH_AUTH_RESPOND ===
    5310   00:5C23                      ;========================
    5311   00:5C23                      ;Respond auth data requested for SSH connection.
    5312   00:5C23                      ;
    5313   00:5C23                      ;Input:  A  = 10
    5314   00:5C23                      ;        B  = Connection number
    5315   00:5C23                      ;        DE = Address of the data to be sent
    5316   00:5C23                      ;        HL = Length of the data to be sent
    5317   00:5C23                      ;Output: A  = Error code
    5318   00:5C23                      SSH_AUTH_RESPOND:
    5319   00:5C23  CB FF                   set 7,a                         ; ESP SSH commands start at #80
    5320   00:5C25                          SEND_DATA                       ; Send the command
    5320   00:5C25  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5321   00:5C28                          ; prepare new data size, adding our 1 byte overhead (connection #)
    5322   00:5C28  23                      inc hl
    5323   00:5C29  7C                      ld  a,h
    5324   00:5C2A                          SEND_DATA                       ; Send the command size msb
    5324   00:5C2A  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5325   00:5C2D  7D                      ld  a,l
    5326   00:5C2E                          SEND_DATA                       ; Send the command size lsb
    5326   00:5C2E  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5327   00:5C31  78                      ld  a,b
    5328   00:5C32                          SEND_DATA                       ; Send the connection #
    5328   00:5C32  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5329   00:5C35  2B                      dec hl
    5330   00:5C36  EB                      ex  de,hl
    5331   00:5C37                          ; now oti the data starting at hl, size is in DE
    5332   00:5C37                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    5333   00:5C37  43                      ld  b,e                         ;Number of loops originaly in DE
    5334   00:5C38  1B                      dec de
    5335   00:5C39  14                      inc d
    5336   00:5C3A                          if USE_MEM_IO = 0
    5337   00:5C3A                    ~     ld  c,OUT_TX_PORT
    5338   00:5C3A                    ~ SSH_AUTH_RESPOND_R:
    5339   00:5C3A                    ~     outi
    5340   00:5C3A                    ~     jr  nz,SSH_AUTH_RESPOND_R
    5341   00:5C3A                    ~     else
    5342   00:5C3A                      SSH_AUTH_RESPOND_R:
    5343   00:5C3A  7E                      ld  a,(hl)
    5344   00:5C3B  32 07 7F                ld  (MEM_OUT_TX_PORT),a
    5345   00:5C3E  23                      inc hl
    5346   00:5C3F  10 F9                   djnz SSH_AUTH_RESPOND_R
    5347   00:5C41                          endif
    5348   00:5C41  15                      dec d
    5349   00:5C42  20 F6                   jr  nz,SSH_AUTH_RESPOND_R
    5350   00:5C44                      
    5351   00:5C44                          ; Now wait up to 600 ticks to get response
    5352   00:5C44  21 58 02                ld  hl,600
    5353   00:5C47  CD 36 61                call    SETCOUNTER
    5354   00:5C4A                      SSH_AUTH_RESPOND_ST1:
    5355   00:5C4A                          CHECK_DATA
    5355   00:5C4A  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5355   00:5C4D  CB 47             >     bit 0,a
    5356   00:5C4F  20 05                   jr  nz,SSH_AUTH_RESPOND_R.1
    5357   00:5C51  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5358   00:5C54  18 F4                   jr  SSH_AUTH_RESPOND_ST1
    5359   00:5C56                      SSH_AUTH_RESPOND_R.1:
    5360   00:5C56                          ; nz, check the data
    5361   00:5C56                          RECEIVE_DATA
    5361   00:5C56  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5362   00:5C59  FE 8A                   cp  #8A                         ; Is response of our command?
    5363   00:5C5B  20 ED                   jr  nz,SSH_AUTH_RESPOND_ST1
    5364   00:5C5D                          ; now get return code, if return code other than 0, it is finished
    5365   00:5C5D                      SSH_AUTH_RESPOND_RC:
    5366   00:5C5D                          CHECK_DATA
    5366   00:5C5D  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5366   00:5C60  CB 47             >     bit 0,a
    5367   00:5C62  20 05                   jr  nz,SSH_AUTH_RESPOND_RC.1
    5368   00:5C64  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5369   00:5C67  18 F4                   jr  SSH_AUTH_RESPOND_RC
    5370   00:5C69                      SSH_AUTH_RESPOND_RC.1:
    5371   00:5C69                          ; nz, discard
    5372   00:5C69                          RECEIVE_DATA
    5372   00:5C69  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5373   00:5C6C  B7                      or  a                           ; 0?
    5374   00:5C6D  C0                      ret nz                          ; if not, done
    5375   00:5C6E                      
    5376   00:5C6E                          ; next two bytes are return code and size bytes, don't care, it is 0
    5377   00:5C6E  06 02                   ld  b,2
    5378   00:5C70                      SSH_AUTH_RESPOND_ST2:
    5379   00:5C70                          CHECK_DATA
    5379   00:5C70  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5379   00:5C73  CB 47             >     bit 0,a
    5380   00:5C75  20 05                   jr  nz,SSH_AUTH_RESPOND_ST2.1
    5381   00:5C77  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5382   00:5C7A  18 F4                   jr  SSH_AUTH_RESPOND_ST2
    5383   00:5C7C                      SSH_AUTH_RESPOND_ST2.1:
    5384   00:5C7C                          ; nz, discard
    5385   00:5C7C                          RECEIVE_DATA
    5385   00:5C7C  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5386   00:5C7F  05                      dec b
    5387   00:5C80  20 EE                   jr  nz,SSH_AUTH_RESPOND_ST2
    5388   00:5C82                      
    5389   00:5C82                          ; done, no return data other than return code
    5390   00:5C82  AF                      xor a
    5391   00:5C83  C9                      ret
