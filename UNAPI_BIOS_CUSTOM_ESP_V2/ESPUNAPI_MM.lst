    4325   00:56EC  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    4325   00:56EF  CB 47             >     bit 0,a
    4326   00:56F1  20 05                   jr  nz,SSH_OPEN_ST1.1
    4327   00:56F3  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4328   00:56F6  18 F4                   jr  SSH_OPEN_ST1
    4329   00:56F8                      SSH_OPEN_ST1.1:
    4330   00:56F8                          ; nz, check the data
    4331   00:56F8                          RECEIVE_DATA
    4331   00:56F8  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4332   00:56FB  FE 82                   cp  #82                         ; Is response of our command?
    4333   00:56FD  20 ED                   jr  nz,SSH_OPEN_ST1
    4334   00:56FF                          ; now get return code, if return code other than 0, it is finished
    4335   00:56FF                      SSH_OPEN_RC:
