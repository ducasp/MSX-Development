    5223   00:5BC2                      ;========================
    5224   00:5BC2                      ;===     SSH_SEND     ===
    5225   00:5BC2                      ;========================
    5226   00:5BC2                      ;Send data to a SSH connection.
    5227   00:5BC2                      ;
    5228   00:5BC2                      ;Input:  A  = 5
    5229   00:5BC2                      ;        B  = Connection number
    5230   00:5BC2                      ;        DE = Address of the data to be sent
    5231   00:5BC2                      ;        HL = Length of the data to be sent
    5232   00:5BC2                      ;Output: A  = Error code
    5233   00:5BC2                      SSH_SEND:
    5234   00:5BC2  CB FF                   set 7,a                         ; ESP SSH commands start at #80
    5235   00:5BC4                          SEND_DATA                       ; Send the command
    5235   00:5BC4  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5236   00:5BC7                          ; prepare new data size, adding our 1 byte overhead (connection #)
    5237   00:5BC7  23                      inc hl
    5238   00:5BC8  7C                      ld  a,h
    5239   00:5BC9                          SEND_DATA                       ; Send the command size msb
    5239   00:5BC9  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
