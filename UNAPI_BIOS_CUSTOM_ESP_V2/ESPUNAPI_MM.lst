    4251   00:56AD                      ;========================
    4252   00:56AD                      ;===     SSH_OPEN     ===
    4253   00:56AD                      ;========================
    4254   00:56AD                      ;Open a SSH connection.
    4255   00:56AD                      ;
    4256   00:56AD                      ;Input:  A  = 2
    4257   00:56AD                      ;        HL = Address of parameters block
    4258   00:56AD                      ;Output: A = Error code
    4259   00:56AD                      ;        B = Connection number
    4260   00:56AD                      ;
    4261   00:56AD                      ;Parameters block format:
    4262   00:56AD                      ;
    4263   00:56AD                      ;+0 (4): Remote IP address (0.0.0.0 for unspecified remote socket)
    4264   00:56AD                      ;+4 (2): Remote port (ignored if unspecified remote socket)
    4265   00:56AD                      ;+6 (1): Subsystem
    4266   00:56AD                      ;+7 (1): Flags
    4267   00:56AD                      ;+8 (variable): username (0 terminated) and then password or public key (0 terminated)
    4268   00:56AD                      ;
    4269   00:56AD                      ;Parameter block MUST have at least 32 bytes available if doing host key verification
    4270   00:56AD                      ;as unknown host key hash will be returned in it
    4271   00:56AD                      
    4272   00:56AD                      SSH_OPEN:
    4273   00:56AD  E5                      push    hl                      ; save param block address
    4274   00:56AE  3E 08                   ld  a,8
    4275   00:56B0  85                      add a,l
    4276   00:56B1  6F                      ld  l,a
    4277   00:56B2  30 01                   jr  nc,SSH_OPEN_1
    4278   00:56B4  24                      inc h
    4279   00:56B5                      SSH_OPEN_1:
