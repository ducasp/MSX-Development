    1613   00:48F4                      ;===  SETUP Menu Routines  ==
    1614   00:48F4                      ;===      NAGLE Menu       ==
    1615   00:48F4                      ;============================
    1616   00:48F4                      SET_NAGLE:
    1617   00:48F4  3E 31                   ld  a,'1'
    1618   00:48F6  CD A2 00                call    CHPUT
    1619   00:48F9  CD 0F 4A                call    WAIT_250MS_AND_THEN_CONTINUE
    1620   00:48FC  21 90 6B                ld  hl,MMENU_NAGLE
    1621   00:48FF  CD 96 4C                call    PRINTHL                 ; Print Main Nagle message
    1622   00:4902  CD 32 4A                call    CHECKNAGLE              ; Nagle is on or off?
    1623   00:4905  20 1E                   jr  nz,NAGLE_IS_ON              ;
    1624   00:4907  21 C5 6C                ld  hl,MMENU_NAGLE_OFF          ; Show the menu telling nagle is off
    1625   00:490A  CD 96 4C                call    PRINTHL                 ; Print options
    1626   00:490D                      SET_NAGLE_WI_ON:
    1627   00:490D  CD 9F 00                call    CHGET
    1628   00:4910  FE 1B                   cp  #1b                         ; ESC?
    1629   00:4912  CA 5C 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1630   00:4915  FE 4F                   cp  'O'                         ; Toggle Nagle On
    1631   00:4917  CA D2 49                jp  z,SET_NAGLE_ON              ;
    1632   00:491A  FE 6F                   cp  'o'                         ; Toggle Nagle On
    1633   00:491C  CA D2 49                jp  z,SET_NAGLE_ON              ;
    1634   00:491F  CD C0 00                call    BEEP                    ; Wrong Input, beep
    1635   00:4922  C3 0D 49                jp  SET_NAGLE_WI_ON             ; And return waiting key
    1636   00:4925                      
