    1621   00:48FB                      ;===  SETUP Menu Routines  ==
    1622   00:48FB                      ;===      NAGLE Menu       ==
    1623   00:48FB                      ;============================
    1624   00:48FB                      SET_NAGLE:
    1625   00:48FB  3E 31                   ld  a,'1'
    1626   00:48FD  CD A2 00                call    CHPUT
    1627   00:4900  CD 16 4A                call    WAIT_250MS_AND_THEN_CONTINUE
    1628   00:4903  21 EC 6E                ld  hl,MMENU_NAGLE
    1629   00:4906  CD 9D 4C                call    PRINTHL                 ; Print Main Nagle message
    1630   00:4909  CD 39 4A                call    CHECKNAGLE              ; Nagle is on or off?
    1631   00:490C  20 1E                   jr  nz,NAGLE_IS_ON              ;
    1632   00:490E  21 21 70                ld  hl,MMENU_NAGLE_OFF          ; Show the menu telling nagle is off
    1633   00:4911  CD 9D 4C                call    PRINTHL                 ; Print options
    1634   00:4914                      SET_NAGLE_WI_ON:
    1635   00:4914  CD 9F 00                call    CHGET
    1636   00:4917  FE 1B                   cp  #1b                         ; ESC?
    1637   00:4919  CA 5E 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1638   00:491C  FE 4F                   cp  'O'                         ; Toggle Nagle On
    1639   00:491E  CA D9 49                jp  z,SET_NAGLE_ON              ;
    1640   00:4921  FE 6F                   cp  'o'                         ; Toggle Nagle On
    1641   00:4923  CA D9 49                jp  z,SET_NAGLE_ON              ;
    1642   00:4926  CD C0 00                call    BEEP                    ; Wrong Input, beep
    1643   00:4929  C3 14 49                jp  SET_NAGLE_WI_ON             ; And return waiting key
    1644   00:492C                      
    1645   00:492C                      NAGLE_IS_ON:
