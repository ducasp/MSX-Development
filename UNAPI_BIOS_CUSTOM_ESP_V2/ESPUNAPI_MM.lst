    4338   00:5706  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4339   00:5709  18 F4                   jr  SSH_OPEN_RC
    4340   00:570B                      SSH_OPEN_RC.1:
    4341   00:570B                          ; nz, discard
