     334   00:4000                      ;************************
     335   00:4000                      ;***  MSX ROM HEADER  ***
     336   00:4000                      ;************************
     337   00:4000                          org #4000
     338   00:4000  41 42                   db                  #41,#42
     339   00:4002  10 40                   dw                  INIT        ; Initialize ESP, if not found, won't install hook
     340   00:4004  00 00                   dw                  0           ; Statement
     341   00:4006  00 00                   dw                  0           ; Device
     342   00:4008  00 00                   dw                  0           ; Text
     343   00:400A  00 (6)                  ds                  6           ; Reserved
     344   00:4010                      
     345   00:4010                      ;==================
     346   00:4010                      ;===  Start-up  ===
     347   00:4010                      ;==================
     348   00:4010                      
     349   00:4010                      INIT:
     350   00:4010  7C                      ld  a,h                         ; Let's test if we are mirrored and being executed in wrong page
     351   00:4011  FE 40                   cp  #40                         ; is MSB 0x40?
     352   00:4013  C0                      ret nz                          ; if not, return, it is a mirror
     353   00:4014                          ; Let's set some System Variables
     354   00:4014  AF                      xor a                           ; a = #00
     355   00:4015  32 A9 FC                ld  (CSRSW),a                   ; cursor display is disabled
     356   00:4018  32 DB F3                ld  (CLIKSW),a                  ; when key press, key click disabled
     357   00:401B                          ; Let's intercept [DEL] key
     358   00:401B  3E 08                   ld  a,8
     359   00:401D  CD 41 01                call    SNSMAT
     360   00:4020  CB 5F                   bit 3,a                         ; Test [DEL]
     361   00:4022  C8                      ret z                           ; If DEL is pressed, UNAPI driver is not loaded and exits
     362   00:4023                          ; Let's check the Screen Mode, ref. https://www.msx.org/wiki/VDP_Table_Base_Address_Registers
     363   00:4023  3A E1 F3                ld  a,(REG2SAV)
     364   00:4026  FE 02                   cp  2
     365   00:4028  CA 32 40                jp  z,SCREEN_SETUP              ; If yes, is SCREEN 3
     366   00:402B  3A E3 F3                ld  a,(REG4SAV)
     367   00:402E  FE 00                   cp  0
     368   00:4030  28 06                   jr  z,IS_SCREEN1                ; If yes, is SCREEN 1
     369   00:4032                      SCREEN_SETUP:
     370   00:4032                          ; Let's set the SCREEN 1
     371   00:4032  3E 01                   ld  a,1                         ; a = #01
     372   00:4034  F7                      rst #30
     373   00:4035  00                      db  0
     374   00:4036  5F 00                   dw  CHGMOD                      ; SCREEN 1
     375   00:4038                      IS_SCREEN1:
     376   00:4038  3E 1D                   ld  a,29                        ; WIDTH 29
     377   00:403A  32 B0 F3                ld  (LINLEN),a
     378   00:403D                          ; We check if the Port F2 device is available
     379   00:403D                          READ_F2                         ; a = #FF, default value if it comes from power off or hard reset
     379   00:403D  3A 05 7F          >     ld  a,(MEM_PORT_F2)
     380   00:4040  2F                      cpl                             ; a = #FF - a
     381   00:4041  4F                      ld  c,a                         ; c = #00
     382   00:4042                          WRITE_F2                        ; a = #00
     382   00:4042  32 05 7F          >     ld  (MEM_PORT_F2),a
     383   00:4045                          ; Wait 250ms to ensure a successful hard reset even if you press the button very quickly
     384   00:4045  CD 0F 4A                call    WAIT_250MS_AND_THEN_CONTINUE
     385   00:4048                          READ_F2                         ; a = #00?
     385   00:4048  3A 05 7F          >     ld  a,(MEM_PORT_F2)
     386   00:404B  2F                      cpl                             ; a = #FF - a
     387   00:404C                          WRITE_F2                        ; a = #FF?
     387   00:404C  32 05 7F          >     ld  (MEM_PORT_F2),a
     388   00:404F  F5                      push    af
     389   00:4050  3E FE                   ld  a,#FE                       ; Preset #FE, unexpected error
     390   00:4052                          WRITE_F2                        ; on port #F2
     390   00:4052  32 05 7F          >     ld  (MEM_PORT_F2),a
     391   00:4055  F1                      pop af
     392   00:4056  B9                      cp  c                           ; If not a = c, port #F2 is writable and available
     393   00:4057  28 3D                   jr  z,BOOT_FROM_POWER_OFF       ; If a = c, port #F2 is not available, let's proceed as "boot from power off"
     394   00:4059                          ; Ok, Port F2 device available
     395   00:4059  FE EF                   cp  #EF                         ; UNAPI driver has been disabled
     396   00:405B  20 04                   jr  nz,NOT_DISABLED_BY_F2       ; No, let's continue checking
     397   00:405D                          WRITE_F2                        ; If yes, UNAPI driver is not loaded and exits, but need to restore F2 port to not have a false error
     397   00:405D  32 05 7F          >     ld  (MEM_PORT_F2),a
     398   00:4060  C9                      ret                             ; And our work is done
     399   00:4061                      NOT_DISABLED_BY_F2:
     400   00:4061  FE F0                   cp  #F0                         ; UNAPI driver has been loaded at least once
     401   00:4063  C2 78 40                jp  nz, F2_IS_NOT_F0            ; Ok, has not been loaded
     402   00:4066                          ; Let's intercept [F1] key
     403   00:4066  3E 06                   ld  a,6
     404   00:4068  CD 41 01                call    SNSMAT
     405   00:406B  CB 6F                   bit 5,a                         ; Test [F1]
     406   00:406D  CA 40 42                jp  z,ENTERING_ESPSETUP         ; If F1 is pressed, let's execute our setup menu
     407   00:4070                          ; F1 is not pressed, continue
     408   00:4070  CB 77                   bit 6,a                         ; Test [F2]
     409   00:4072  C2 F1 40                jp  nz,INIT_UNAPI               ; If F2 is not pressed, let's proceed to INIT_UNAPI
     410   00:4075                          ; F2 is not pressed, continue
     411   00:4075  C3 AA 41                jp  INIT_NOCLOCKUPDAT2          ; If yes, proceed without affecting the connection or the date and time
     412   00:4078                      F2_IS_NOT_F0:
     413   00:4078  FE F1                   cp  #F1                         ; User requested to go directly to Wi-Fi Setup
     414   00:407A  CA 40 42                jp  z,ENTERING_ESPSETUP         ; If yes, let's execute our setup menu
     415   00:407D  FE F2                   cp  #F2                         ; User forces to check if ESP is installed
     416   00:407F  CA CD 40                jp  z,F2_IS_PRESSED             ; If yes, let's go check it out
     417   00:4082  FE FE                   cp  #FE                         ; Unexpected error from the previous reboot
     418   00:4084  20 10                   jr  nz,BOOT_FROM_POWER_OFF      ; If no one is confirmed, let's proceed as "boot from power off"
     419   00:4086                          ; Oops! An unexpected error occurred on the last reboot
     420   00:4086  21 60 73                ld  hl,STR_OOPS                 ; Print Oops! An unexpected error message
     421   00:4089  CD 96 4C                call    PRINTHL                 ; and let's proceed as "boot from power off"
     422   00:408C  06 78                   ld  b,120                       ; Wait 2 seconds with message on screen
     423   00:408E                      WAIT_2S:
     424   00:408E  76                      halt
     425   00:408F  10 FD                   djnz    WAIT_2S                 ; If not zero, our time out has not elapsed
     426   00:4091  3E 0C                   ld  a,CLS
     427   00:4093  CD A2 00                call    CHPUT
     428   00:4096                      BOOT_FROM_POWER_OFF:
     429   00:4096                          ; Let's intercept [F1] key
     430   00:4096  3E 06                   ld  a,6
     431   00:4098  CD 41 01                call    SNSMAT
     432   00:409B  CB 6F                   bit 5,a                         ; Test [F1]
     433   00:409D  CA 40 42                jp  z,ENTERING_ESPSETUP         ; If F1 is pressed, let's execute our setup menu
     434   00:40A0                          ; F1 is not pressed, continue
     435   00:40A0                          if  NON_VERBOSE_ROM = 0
     436   00:40A0  21 F8 66                ld  hl,WELCOME
     437   00:40A3  CD 08 65                call    CHECK_ESP_TYPE
     438   00:40A6  28 03                   jr  z,NOT32_1
     439   00:40A8  21 42 67                ld  hl,WELCOME32
     440   00:40AB                      NOT32_1:
     441   00:40AB  CD 96 4C                call    PRINTHL
     442   00:40AE                          CHECK_QUICK_RECEIVE
     442   00:40AE  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
     442   00:40B1  CB 5F             >     bit 3,a
     443   00:40B3  20 08                   jr  nz,BOOT_FROM_POWER_OFF.1    ; QR Supported
     444   00:40B5  21 AC 67                ld  hl,WELCOME_SF2
     445   00:40B8  CD 96 4C                call    PRINTHL
     446   00:40BB  18 06                   jr  BOOT_FROM_POWER_OFF.2
     447   00:40BD                      BOOT_FROM_POWER_OFF.1:
     448   00:40BD  21 90 67                ld  hl,WELCOME_SF
     449   00:40C0  CD 96 4C                call    PRINTHL
     450   00:40C3                      BOOT_FROM_POWER_OFF.2:
     451   00:40C3                          endif
     452   00:40C3  3E 06                   ld  a,6
     453   00:40C5  CD 41 01                call    SNSMAT
     454   00:40C8  CB 77                   bit 6,a                         ; Test [F2]
     455   00:40CA  C2 F1 40                jp  nz,INIT_UNAPI               ; If F2 is not pressed, let's proceed to INIT_UNAPI
     456   00:40CD                          ; F2 is pressed, continue
     457   00:40CD                      F2_IS_PRESSED:
     458   00:40CD  CD 3B 65                call    RESET_ESP
     459   00:40D0  B7                      or  a
     460   00:40D1  20 06                   jr  nz,ESP_NOT_FOUND
     461   00:40D3  21 C0 72                ld  hl,OK_S                     ; Properly detected
     462   00:40D6  C3 E3 40                jp  INIT_F_MSG                  ; Well, if reset successful, continue
     463   00:40D9                      ESP_NOT_FOUND:
     464   00:40D9                          ; If here, ESP was not found, so, exit with an error message
     465   00:40D9  78                      ld  a,b
     466   00:40DA  B7                      or  a
     467   00:40DB  21 DB 72                ld  hl,FAIL_S                   ; If 0, non responsive
     468   00:40DE  28 03                   jr  z,INIT_F_MSG
     469   00:40E0  21 25 73                ld  hl,FAIL_F                   ; Otherwise, firmware is old
     470   00:40E3                      INIT_F_MSG:
     471   00:40E3  CD 96 4C                call    PRINTHL
     472   00:40E6                      INIT_F_WAIT:
     473   00:40E6  06 B4                   ld  b,180                       ; 3s
     474   00:40E8                      INIT_F_LOOP_WAIT:
     475   00:40E8  76                      halt
     476   00:40E9  10 FD                   djnz    INIT_F_LOOP_WAIT
     477   00:40EB                      AND_DONE:
     478   00:40EB  3E EF                   ld  a,#EF                       ; Set #EF, ESP Not Found
     479   00:40ED                          WRITE_F2                        ; on port #F2
     479   00:40ED  32 05 7F          >     ld  (MEM_PORT_F2),a
     480   00:40F0  C9                      ret                             ; And done
     481   00:40F1                      INIT_UNAPI:
     482   00:40F1                          CLEAR_UART
     482   00:40F1  3E 14             >     ld  a,20
     482   00:40F3  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     483   00:40F6  3E 63                   ld  a,CMD_QUERY_ACLK_SETTINGS
     484   00:40F8                          SEND_DATA
     484   00:40F8  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     485   00:40FB  21 3C 00                ld  hl,60                       ; Wait Up To 1s
     486   00:40FE  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
     487   00:4102  DD 6B                   ld  ixl,e
     488   00:4104  DD 62                   ld  ixh,d                       ; Address in IX
     489   00:4106  CD 6E 4B                call    WAIT_MENU_CMD_RESPONSE
     490   00:4109  CA A0 41                jp  z,INIT_NOCLOCKUPDATE        ; If error, just skip
     491   00:410C                          ; Response received, IX+0 and IX+1 has Auto Clock and GMT
     492   00:410C  3E 03                   ld  a,3
     493   00:410E  DD BE 00                cp  (ix+0)
     494   00:4111  20 0B                   jr  nz,INIT_UNAPI2              ; If not disabled continue on INIT_UNAPI2
     495   00:4113                          ; Disabled, ok, so let's ensure connection is not locked (just in case it was setup as disabled right now)
     496   00:4113                          CLEAR_UART
     496   00:4113  3E 14             >     ld  a,20
     496   00:4115  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     497   00:4118  3E 68                   ld  a,CMD_WIFIRELEASE_ESP
     498   00:411A                          SEND_DATA                       ; Just send, no need to wait response
     498   00:411A  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     499   00:411D  C9                      ret
     500   00:411E                      INIT_UNAPI2:
     501   00:411E  3A 2D 00                ld  a,(#002D)                   ; Check MSX Version
     502   00:4121  B7                      or  a
     503   00:4122  28 7C                   jr  z,INIT_NOCLOCKUPDATE        ; If zero, MSX1, can't set clock
     504   00:4124  AF                      xor a
     505   00:4125  DD B6 00                or  (ix+0)
     506   00:4128  28 76                   jr  z,INIT_NOCLOCKUPDATE        ; if turned off, skip
     507   00:412A                          ; Ok, not zero, so we are going to simply request the time, it might take up to 10s
     508   00:412A  DD 23                   inc ix
     509   00:412C  DD 23                   inc ix                          ; ok, leave IX+0 and IX+1 intact
     510   00:412E                          ; b = number of response check attempts
     511   00:412E  06 05                   ld  b,5                         ; 5 * 2s = 10s
     512   00:4130                          CLEAR_UART
     512   00:4130  3E 14             >     ld  a,20
     512   00:4132  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     513   00:4135  3E 47                   ld  a,CMD_GET_TIME
     514   00:4137                          SEND_DATA
     514   00:4137  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     515   00:413A                      TRY_AGAIN:
     516   00:413A  C5                      push    bc
     517   00:413B  21 78 00                ld  hl,120                      ; Wait Up To 2s per attempt
     518   00:413E  CD 6E 4B                call    WAIT_MENU_CMD_RESPONSE
     519   00:4141  20 1E                   jr  nz,INIT_CLOCKUPDATE         ; if ok, follow up
     520   00:4143  21 40 73                ld  hl,STR_WAITING              ; Print Waiting for connection message
     521   00:4146  CD 96 4C                call    PRINTHL
     522   00:4149  3E FF                   ld  a,#ff
     523   00:414B  B8                      cp  b                           ; Was time-out the failure reason?
     524   00:414C  C1                      pop bc                          ; Restore stack ballance and retry counter
     525   00:414D  20 04                   jr  nz,STOP_TRYING              ; If error return code and not time-out, no more checks needed
     526   00:414F  3E 47                   ld  a,CMD_GET_TIME              ; Needed for retries
     527   00:4151  10 E7                   djnz    TRY_AGAIN
     528   00:4153                      STOP_TRYING:
     529   00:4153                          ; Leave a message that clock has not been updated
     530   00:4153  21 52 72                ld  hl,STR_CLKUPDT_FAIL
     531   00:4156  CD 96 4C                call    PRINTHL
     532   00:4159  3E F0                   ld  a,240                       ; Wait 4 seconds with message on screen
     533   00:415B                      WAIT_4S:
     534   00:415B  76                      halt
     535   00:415C  3D                      dec a
     536   00:415D                          ; If not zero, our time out has not elapsed
     537   00:415D  20 FC                   jr  nz,WAIT_4S
     538   00:415F  18 3F                   jr  INIT_NOCLOCKUPDATE          ; error, just skip to not set garbage in clock
     539   00:4161                      INIT_CLOCKUPDATE:
     540   00:4161  C1                      pop bc
     541   00:4162  DD 2B                   dec ix
     542   00:4164  DD 2B                   dec ix                          ; ix back where it should
     543   00:4166                          ; ix + 0 -> 0 If no need to set clock, 1 if set clock, 2 if set clock and request to turn Wi-Fi Off
     544   00:4166                          ; ix + 1 -> GMT setting, well, not going to use it
     545   00:4166                          ; ix + 2 -> Seconds
     546   00:4166                          ; ix + 3 -> Minutes
     547   00:4166                          ; ix + 4 -> Hours
     548   00:4166                          ; ix + 5 -> Day
     549   00:4166                          ; ix + 6 -> Month
     550   00:4166                          ; ix + 7 -> Year LSB
     551   00:4166                          ; ix + 8 -> Year MSB
     552   00:4166  DD 66 04                ld  h,(ix+4)
     553   00:4169  DD 6E 03                ld  l,(ix+3)
     554   00:416C  DD 56 02                ld  d,(ix+2)
     555   00:416F  CD 7E 65                call    SET_TIME
     556   00:4172  20 2C                   jr  nz,INIT_NOCLOCKUPDATE       ; if error, just skip
     557   00:4174  DD 66 08                ld  h,(ix+8)
     558   00:4177  DD 6E 07                ld  l,(ix+7)
     559   00:417A  DD 56 06                ld  d,(ix+6)
     560   00:417D  DD 5E 05                ld  e,(ix+5)
     561   00:4180  CD AB 65                call    SET_DATE
     562   00:4183  3E 02                   ld  a,2
     563   00:4185  DD BE 00                cp  (ix+0)
     564   00:4188  20 16                   jr  nz,INIT_NOCLOCKUPDATE
     565   00:418A                          ; First, release any hold to Wi-Fi Connection
     566   00:418A                          CLEAR_UART
     566   00:418A  3E 14             >     ld  a,20
     566   00:418C  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     567   00:418F  3E 68                   ld  a,CMD_WIFIRELEASE_ESP
     568   00:4191                          SEND_DATA                       ; Just send, no need to wait response
     568   00:4191  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     569   00:4194                          ; And, turn off Wi-Fi Immediatelly
     570   00:4194                          CLEAR_UART
     570   00:4194  3E 14             >     ld  a,20
     570   00:4196  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     571   00:4199  3E 4F                   ld  a,CMD_WIFI_OFF
     572   00:419B                          SEND_DATA                       ; Just send, no need to wait response
     572   00:419B  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     573   00:419E  18 0A                   jr  INIT_NOCLOCKUPDAT2
     574   00:41A0                      INIT_NOCLOCKUPDATE:
     575   00:41A0                          ; Release any hold to Wi-Fi Connection
     576   00:41A0                          CLEAR_UART
     576   00:41A0  3E 14             >     ld  a,20
     576   00:41A2  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     577   00:41A5  3E 68                   ld  a,CMD_WIFIRELEASE_ESP
     578   00:41A7                          SEND_DATA                       ; Just send, no need to wait response
     578   00:41A7  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     579   00:41AA                      INIT_NOCLOCKUPDAT2:
     580   00:41AA                          ; Save existing EXTBIO hook if it exists
     581   00:41AA  3A 20 FB                ld  a,(HOKVLD)
     582   00:41AD  CB 47                   bit 0,a
     583   00:41AF  20 0B                   jr  nz,SAVE_HOOK2               ; HOKVLD tells us if there is an extended BIOS already or not, if yes, save it
     584   00:41B1                          ; If here, no extended BIOS
     585   00:41B1  CD C1 62                call    GETSLT
     586   00:41B4  CD 1A 63                call    GETWRK                  ; Our ROM work area address is at HL (we can use up to 8 bytes)
     587   00:41B7  3E C9                   ld  a,#c9                       ; RET, as we are the first extended BIOS
     588   00:41B9  77                      ld  (hl),a
     589   00:41BA  18 13                   jr  PATCH                       ; And now all we need to do is patch the EXTBIO hook :)
     590   00:41BC                      
     591   00:41BC                      SAVE_HOOK2:
     592   00:41BC                          ; If here, we are not the first to extend bios, so we need to save the previous one
     593   00:41BC  CD C1 62                call    GETSLT
     594   00:41BF  CD 1A 63                call    GETWRK                  ; Our ROM work area address is at HL (we can use up to 8 bytes)
     595   00:41C2  EB                      ex  de,hl                       ; It is the destination for....
     596   00:41C3  21 CA FF                ld  hl,EXTBIO                   ; The actual EXTBIO hook
     597   00:41C6  01 05 00                ld  bc,5                        ; That is 5 bytes large
     598   00:41C9  ED B0                   ldir                            ; And move to our work area
     599   00:41CB  AF                      xor a
     600   00:41CC  12                      ld  (de),a                      ; Not initialized (de is at the sixth byte) of our slot work area
     601   00:41CD  13                      inc de
     602   00:41CE  12                      ld  (de),a                      ; Not initialized (de is at the seventh byte) of our slot work area
     603   00:41CF                      
     604   00:41CF                          ; Patch EXTBIO
     605   00:41CF                      PATCH:
     606   00:41CF  3E F7                   ld  a,#F7                       ; RST #30
     607   00:41D1  32 CA FF                ld  (EXTBIO),a                  ; In EXTBIO hook
     608   00:41D4  CD C1 62                call    GETSLT                  ; Our Slot in A
     609   00:41D7  32 CB FF                ld  (EXTBIO+1),a                ; Next EXTBIO hook byte
     610   00:41DA  21 EB 4C                ld  hl,DO_EXTBIO                ; Our EXTBIO routine address
     611   00:41DD  22 CC FF                ld  (EXTBIO+2),hl               ; Goes to the following two bytes in the hook
     612   00:41E0                      
     613   00:41E0  21 CF FF                ld  hl,EXTBIO+5                 ; Must patch DISINT and ENAINT as well
     614   00:41E3  06 0A                   ld  b,5*2
     615   00:41E5                      PATCH2:
     616   00:41E5  36 C9                   ld  (hl),#C9
     617   00:41E7  23                      inc hl
     618   00:41E8  10 FB                   djnz    PATCH2                  ; So patch all 10 bytes with return
     619   00:41EA                      
     620   00:41EA  21 20 FB                ld  hl,HOKVLD
     621   00:41ED  CB C6                   set 0,(hl)                      ; And set HOKVLD properly to indicate an EXTBIOS is installed
     622   00:41EF                      INIT_OK:
     623   00:41EF                          if  NON_VERBOSE_ROM = 0
     624   00:41EF  21 C0 72                ld  hl,OK_S                     ; All done and set, nice exit message
     625   00:41F2  CD 96 4C                call    PRINTHL
     626   00:41F5                          endif
     627   00:41F5  3E F0                   ld  a,#F0                       ; Set #F0, UNAPI driver has been loaded at least once
     628   00:41F7                          WRITE_F2
     628   00:41F7  32 05 7F          >     ld  (MEM_PORT_F2),a
     629   00:41FA  C9                      ret
     630   00:41FB                      
     631   00:41FB                      ;==============================
     632   00:41FB                      ;===  TPA Memory Allocation  ==
     633   00:41FB                      ;==============================
     634   00:41FB                      HIMEM_ALLOC:
     635   00:41FB                          ; Now let's reserve memory in the 4th page for our usage
     636   00:41FB  2A 4A FC                ld hl,(HIMEM)                   ; Get HIMEM
     637   00:41FE  B7                      or  a                           ; Clear Carry
     638   00:41FF  11 1E 00                ld  de,HIMEM_RESERVED_SIZE      ; Reserve How much memory we need
     639   00:4202  ED 52                   sbc hl,de                       ; New HIMEM
     640   00:4204  22 4A FC                ld  (HIMEM),hl                  ; Save it
     641   00:4207  23                      inc hl                          ; To be safe
     642   00:4208  EB                      ex  de,hl                       ; now in DE
     643   00:4209  CD C1 62                call    GETSLT
     644   00:420C  CD 2E 63                call    GETMEMPOINTERADDR       ; This is where we are going to store our memory area address
     645   00:420F                          ; GETSLT and GETMEMPOINTER do not change DE, so it still has the our memory area address
     646   00:420F  73                      ld  (hl),e
     647   00:4210  23                      inc hl
     648   00:4211  72                      ld  (hl),d                      ; And save our memory area there
     649   00:4212                          ; Ok, DE has our memory area, let's save old H_TIMI hook there
     650   00:4212  21 9F FD                ld  hl,H_TIMI                   ; The actual H_TIMI hook
     651   00:4215  01 05 00                ld  bc,5                        ; That is 5 bytes large
     652   00:4218  ED B0                   ldir                            ; And move to our memory area
     653   00:421A  F3                      di                              ; Turn of interrupts as we are going to patch H_TIMI
     654   00:421B                      PATCH_H_TIMI:
     655   00:421B  3E F7                   ld  a,#F7                       ; RST #30
     656   00:421D  32 9F FD                ld  (H_TIMI),a                  ; In H_TIMI hook
     657   00:4220  CD C1 62                call    GETSLT                  ; Our Slot in A
     658   00:4223  32 A0 FD                ld  (H_TIMI+1),a                ; Next H_TIMI hook byte
     659   00:4226  21 D7 4C                ld  hl,DO_HTIMI                 ; Our H_TIMI routine address
     660   00:4229  22 A1 FD                ld  (H_TIMI+2),hl               ; Goes to the following two bytes in the hook
     661   00:422C  FB                      ei                              ; done, so re-enable interrupts
     662   00:422D                      
     663   00:422D                          ; Set DNS_READY to zero
     664   00:422D  AF                      xor a
     665   00:422E  CD 73 64                call    SETDNSREADY
     666   00:4231                          ; Set TIME-OUT counter to zero
     667   00:4231  21 00 00                ld  hl,0
     668   00:4234  CD 61 63                call    SETCOUNTER
     669   00:4237  C9                      ret
     670   00:4238                      
     671   00:4238                      ;============================
     672   00:4238                      ;===  SETUP Menu Routines  ==
     673   00:4238                      ;===       Main Menu       ==
     674   00:4238                      ;============================
     675   00:4238                      ESPSETUP.EXIT:
     676   00:4238  3E 0C                   ld  a,CLS
     677   00:423A  CD A2 00                call    CHPUT
     678   00:423D  C3 F1 40                jp  INIT_UNAPI                  ; When done, resume initialization
     679   00:4240                      ENTERING_ESPSETUP:
     680   00:4240  21 DC 66                ld  hl,ENTERING_WIFI_SETUP
     681   00:4243  CD 96 4C                call    PRINTHL
     682   00:4246  CD 45 66                call    PATTERN_SETUP
     683   00:4249  CD 0F 4A                call    WAIT_250MS_AND_THEN_CONTINUE
     684   00:424C                          ; Hold Wi-Fi Connection On
     685   00:424C                          CLEAR_UART
     685   00:424C  3E 14             >     ld  a,20
     685   00:424E  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     686   00:4251  3E 48                   ld  a,CMD_WIFIHOLD_ESP
     687   00:4253                          SEND_DATA
     687   00:4253  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     688   00:4256  21 3C 00                ld  hl,60                       ; Up to 1s time-out
     689   00:4259  CD 6E 4B                call    WAIT_MENU_CMD_RESPONSE  ; Wait response
     690   00:425C                          ; We do not want to error here, just in case user still need to upgrade ESP firmware
     691   00:425C                      ESPSETUP:
     692   00:425C  CD 3B 65                call    RESET_ESP
     693   00:425F  B7                      or  a
     694   00:4260  C2 D9 40                jp  nz,ESP_NOT_FOUND            ; Not well, ESP was not found
     695   00:4263                          ; Well, if reset successful, continue
     696   00:4263  21 F8 66                ld  hl,WELCOME
     697   00:4266  CD 08 65                call    CHECK_ESP_TYPE
     698   00:4269  28 03                   jr  z,NOT32_2
     699   00:426B  21 42 67                ld  hl,WELCOME32
     700   00:426E                      NOT32_2:
     701   00:426E  CD 96 4C                call    PRINTHL
     702   00:4271                          CHECK_QUICK_RECEIVE
     702   00:4271  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
     702   00:4274  CB 5F             >     bit 3,a
     703   00:4276  20 08                   jr  nz,ESPSETUP.2NF             ; If yes, tells Quick Receive support
     704   00:4278  21 AC 67                ld  hl,WELCOME_SF2
     705   00:427B  CD 96 4C                call    PRINTHL                 ; Print Welcome message no QR
     706   00:427E  18 06                   jr  ESPSETUP.3NF
     707   00:4280                      ESPSETUP.2NF:
     708   00:4280  21 90 67                ld  hl,WELCOME_SF
     709   00:4283  CD 96 4C                call    PRINTHL                 ; Print Welcome message QR
     710   00:4286                      ESPSETUP.3NF:
     711   00:4286  21 CC 67                ld  hl,WELCOME_CS
     712   00:4289  CD 96 4C                call    PRINTHL                 ; Print Wi-Fi is reconnecting to:
     713   00:428C                      ESPSETUP_NEXT:
