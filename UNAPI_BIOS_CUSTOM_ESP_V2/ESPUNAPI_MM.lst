    2952   00:505E                      ;==========================
    2953   00:505E                      ;===  TCPIP_GET_IPINFO  ===
    2954   00:505E                      ;==========================
    2955   00:505E                      ;Get IP address.
    2956   00:505E                      ;
    2957   00:505E                      ;Input:  A = 2
    2958   00:505E                      ;        B = Index of address to obtain:
    2959   00:505E                      ;            1: Local IP address
    2960   00:505E                      ;            2: Peer IP address
    2961   00:505E                      ;            3: Subnet mask
    2962   00:505E                      ;            4: Default gateway
    2963   00:505E                      ;            5: Primary DNS server IP address
    2964   00:505E                      ;            6: Secondary DNS server IP address
    2965   00:505E                      ;Output: A = Error code
    2966   00:505E                      ;        L.H.E.D = Requested address
    2967   00:505E                      TCPIP_GET_IPINFO:
    2968   00:505E                          SEND_DATA                       ; Send the command
    2968   00:505E  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2969   00:5061  AF                      xor a
    2970   00:5062                          SEND_DATA                       ; Send the command size msb
    2970   00:5062  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2971   00:5065  3C                      inc a
    2972   00:5066                          SEND_DATA                       ; Send the command size lsb
    2972   00:5066  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2973   00:5069  78                      ld  a,b
    2974   00:506A                          SEND_DATA
    2974   00:506A  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2975   00:506D                      
    2976   00:506D                          ; Now wait up to 600 ticks to get response
    2977   00:506D  21 58 02                ld  hl,600
    2978   00:5070  CD 3E 61                call    SETCOUNTER
    2979   00:5073                      TCPIP_GET_IPINFO_ST1:
    2980   00:5073                          CHECK_DATA
    2980   00:5073  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2980   00:5076  CB 47             >     bit 0,a
    2981   00:5078  20 05                   jr  nz,TCPIP_GET_IPINFO_ST1.1
    2982   00:507A  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2983   00:507D  18 F4                   jr  TCPIP_GET_IPINFO_ST1
    2984   00:507F                      TCPIP_GET_IPINFO_ST1.1:
    2985   00:507F                          ; nz, check the data
    2986   00:507F                          RECEIVE_DATA
    2986   00:507F  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2987   00:5082  FE 02                   cp  2                           ; Is response of our command?
    2988   00:5084  20 ED                   jr  nz,TCPIP_GET_IPINFO_ST1
    2989   00:5086                          ; now get return code, if return code other than 0, it is finished
    2990   00:5086                      TCPIP_GET_IPINFO_RC:
    2991   00:5086                          CHECK_DATA
    2991   00:5086  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2991   00:5089  CB 47             >     bit 0,a
    2992   00:508B  20 05                   jr  nz,TCPIP_GET_IPINFO_RC.1
    2993   00:508D  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2994   00:5090  18 F4                   jr  TCPIP_GET_IPINFO_RC
    2995   00:5092                      TCPIP_GET_IPINFO_RC.1:
    2996   00:5092                          ; nz, discard
    2997   00:5092                          RECEIVE_DATA
    2997   00:5092  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2998   00:5095  B7                      or  a                           ; 0?
    2999   00:5096  C0                      ret nz                          ; if not, done
    3000   00:5097                      
    3001   00:5097                          ; next two bytes are return code and size bytes, don't care, it is 4
    3002   00:5097  06 02                   ld  b,2
    3003   00:5099                      TCPIP_GET_IPINFO_ST2:
    3004   00:5099                          CHECK_DATA
    3004   00:5099  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3004   00:509C  CB 47             >     bit 0,a
    3005   00:509E  20 05                   jr  nz,TCPIP_GET_IPINFO_ST2.1
    3006   00:50A0  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3007   00:50A3  18 F4                   jr  TCPIP_GET_IPINFO_ST2
    3008   00:50A5                      TCPIP_GET_IPINFO_ST2.1:
    3009   00:50A5                          ; nz, discard
    3010   00:50A5                          RECEIVE_DATA
    3010   00:50A5  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3011   00:50A8  05                      dec b
    3012   00:50A9  20 EE                   jr  nz,TCPIP_GET_IPINFO_ST2
    3013   00:50AB                      
    3014   00:50AB                          ; now just get the 4 bytes IP and order it in L, H, E and D
    3015   00:50AB                      TCPIP_GET_IPINFO_IP_ST1:
    3016   00:50AB                          CHECK_DATA
    3016   00:50AB  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3016   00:50AE  CB 47             >     bit 0,a
    3017   00:50B0  20 05                   jr  nz,TCPIP_GET_IPINFO_IP_ST1.1
    3018   00:50B2  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3019   00:50B5  18 F4                   jr  TCPIP_GET_IPINFO_IP_ST1
    3020   00:50B7                      TCPIP_GET_IPINFO_IP_ST1.1:
    3021   00:50B7                          ; nz, get it
    3022   00:50B7                          RECEIVE_DATA
    3022   00:50B7  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3023   00:50BA  6F                      ld  l,a
    3024   00:50BB                      TCPIP_GET_IPINFO_IP_ST2:
    3025   00:50BB                          CHECK_DATA
    3025   00:50BB  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3025   00:50BE  CB 47             >     bit 0,a
    3026   00:50C0  20 05                   jr  nz,TCPIP_GET_IPINFO_IP_ST2.1
    3027   00:50C2  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3028   00:50C5  18 F4                   jr  TCPIP_GET_IPINFO_IP_ST2
    3029   00:50C7                      TCPIP_GET_IPINFO_IP_ST2.1:
    3030   00:50C7                          ; nz, get it
    3031   00:50C7                          RECEIVE_DATA
    3031   00:50C7  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3032   00:50CA  67                      ld  h,a
    3033   00:50CB                      TCPIP_GET_IPINFO_IP_ST3:
    3034   00:50CB                          CHECK_DATA
    3034   00:50CB  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3034   00:50CE  CB 47             >     bit 0,a
    3035   00:50D0  20 05                   jr  nz,TCPIP_GET_IPINFO_IP_ST3.1
    3036   00:50D2  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3037   00:50D5  18 F4                   jr  TCPIP_GET_IPINFO_IP_ST3
    3038   00:50D7                      TCPIP_GET_IPINFO_IP_ST3.1:
    3039   00:50D7                          ; nz, get it
    3040   00:50D7                          RECEIVE_DATA
    3040   00:50D7  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3041   00:50DA  5F                      ld  e,a
    3042   00:50DB                      TCPIP_GET_IPINFO_IP_ST4:
    3043   00:50DB                          CHECK_DATA
    3043   00:50DB  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3043   00:50DE  CB 47             >     bit 0,a
    3044   00:50E0  20 05                   jr  nz,TCPIP_GET_IPINFO_IP_ST4.1
    3045   00:50E2  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3046   00:50E5  18 F4                   jr  TCPIP_GET_IPINFO_IP_ST4
    3047   00:50E7                      TCPIP_GET_IPINFO_IP_ST4.1:
    3048   00:50E7                          ; nz, get it
    3049   00:50E7                          RECEIVE_DATA
    3049   00:50E7  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3050   00:50EA  57                      ld  d,a
    3051   00:50EB                          ; done
    3052   00:50EB  AF                      xor a
    3053   00:50EC  C9                      ret
    3054   00:50ED                      
    3055   00:50ED                      ;=========================
    3056   00:50ED                      ;===  TCPIP_NET_STATE  ===
    3057   00:50ED                      ;=========================
    3058   00:50ED                      ;Get network state.
    3059   00:50ED                      ;
    3060   00:50ED                      ;Input:  A = 3
    3061   00:50ED                      ;Output: A = Error code
    3062   00:50ED                      ;        B = Current network state:
    3063   00:50ED                      ;            0: Closed
    3064   00:50ED                      ;            1: Opening
    3065   00:50ED                      ;            2: Open
    3066   00:50ED                      ;            3: Closing
    3067   00:50ED                      ;            255: Unknown
    3068   00:50ED                      TCPIP_NET_STATE:
    3069   00:50ED                          SEND_DATA                       ; Send the command
    3069   00:50ED  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3070   00:50F0  AF                      xor a
    3071   00:50F1                          SEND_DATA                       ; Send the command size msb
    3071   00:50F1  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3072   00:50F4                          SEND_DATA                       ; Send the command size lsb
    3072   00:50F4  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3073   00:50F7                      
    3074   00:50F7                          ; Now wait up to 720 ticks to get response
    3075   00:50F7  21 D0 02                ld  hl,720
    3076   00:50FA  CD 3E 61                call    SETCOUNTER
    3077   00:50FD                      TCPIP_NET_STATE_ST1:
    3078   00:50FD                          CHECK_DATA
    3078   00:50FD  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3078   00:5100  CB 47             >     bit 0,a
    3079   00:5102  20 05                   jr  nz,TCPIP_NET_STATE_ST1.1
    3080   00:5104  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3081   00:5107  18 F4                   jr  TCPIP_NET_STATE_ST1
    3082   00:5109                      TCPIP_NET_STATE_ST1.1:
    3083   00:5109                          ; nz, check the data
    3084   00:5109                          RECEIVE_DATA
    3084   00:5109  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3085   00:510C  FE 03                   cp  3                           ; Is response of our command?
    3086   00:510E  20 ED                   jr  nz,TCPIP_NET_STATE_ST1
    3087   00:5110                          ; now get return code, if return code other than 0, it is finished
    3088   00:5110                      TCPIP_NET_STATE_RC:
    3089   00:5110                          CHECK_DATA
    3089   00:5110  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3089   00:5113  CB 47             >     bit 0,a
    3090   00:5115  20 05                   jr  nz,TCPIP_NET_STATE_RC.1
    3091   00:5117  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3092   00:511A  18 F4                   jr  TCPIP_NET_STATE_RC
    3093   00:511C                      TCPIP_NET_STATE_RC.1:
    3094   00:511C                          ; nz, get it
    3095   00:511C                          RECEIVE_DATA
    3095   00:511C  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3096   00:511F  B7                      or  a                           ; 0?
    3097   00:5120  C0                      ret nz                          ; if not, done
    3098   00:5121                      
    3099   00:5121                          ; next two bytes are return code and size bytes, don't care, it is 1
    3100   00:5121  06 02                   ld  b,2
    3101   00:5123                      TCPIP_NET_STATE_ST2:
    3102   00:5123                          CHECK_DATA
    3102   00:5123  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3102   00:5126  CB 47             >     bit 0,a
    3103   00:5128  20 05                   jr  nz,TCPIP_NET_STATE_ST2.1
    3104   00:512A  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3105   00:512D  18 F4                   jr  TCPIP_NET_STATE_ST2
    3106   00:512F                      TCPIP_NET_STATE_ST2.1:
    3107   00:512F                          ; nz, discard
    3108   00:512F                          RECEIVE_DATA
    3108   00:512F  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3109   00:5132  05                      dec b
    3110   00:5133  20 EE                   jr  nz,TCPIP_NET_STATE_ST2
    3111   00:5135                      
    3112   00:5135                          ; now just get the 1 byte (NET STATE) IP and place it in B
    3113   00:5135                      TCPIP_NET_STATE_NS_ST1:
    3114   00:5135                          CHECK_DATA
    3114   00:5135  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3114   00:5138  CB 47             >     bit 0,a
    3115   00:513A  20 05                   jr  nz,TCPIP_NET_STATE_NS_ST1.1
    3116   00:513C  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3117   00:513F  18 F4                   jr  TCPIP_NET_STATE_NS_ST1
    3118   00:5141                      TCPIP_NET_STATE_NS_ST1.1:
    3119   00:5141                          ; nz, get it
    3120   00:5141                          RECEIVE_DATA
    3120   00:5141  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3121   00:5144  47                      ld  b,a
    3122   00:5145                          ; done
    3123   00:5145  AF                      xor a
    3124   00:5146  C9                      ret
    3125   00:5147                      
    3126   00:5147                      ;=====================
    3127   00:5147                      ;===  TCPIP_DNS_Q  ===
    3128   00:5147                      ;=====================
    3129   00:5147                      ;Start a host name resolution query.
    3130   00:5147                      ;
    3131   00:5147                      ;Input:  A  = 6
    3132   00:5147                      ;        HL = Address of the host name to be resolved, zero terminated
    3133   00:5147                      ;        B  = Flags, when set to 1 they instruct the resolver to:
    3134   00:5147                      ;             bit 0: Only abort the query currently in progress, if there is any
    3135   00:5147                      ;                    (other flags and registers are then ignored)
    3136   00:5147                      ;             bit 1: Assume that the passed name is an IP address,
    3137   00:5147                      ;                    and return an error if this is not true
    3138   00:5147                      ;             bit 2: If there is a query in progress already,
    3139   00:5147                      ;                    do NOT abort it and return an error instead
    3140   00:5147                      ;Output:  A = Error code
    3141   00:5147                      ;         B = 0 if a query to a DNS server is in progress
    3142   00:5147                      ;             1 if the name represented an IP address
    3143   00:5147                      ;             2 if the name could be resolved locally
    3144   00:5147                      ;         L.H.E.D = Resolved IP address
    3145   00:5147                      ;                   (only if no error occurred and B=1 or 2 is returned)
    3146   00:5147                      ;RAM Buffer to store names to be resolved (and used also to translate IPs from ASCII to 32bits number)
    3147   00:5147                      ;Will store the result of the last DNS query
    3148   00:5147                      TCPIP_DNS_Q:
    3149   00:5147  E5                      push    hl                      ; Save HL
    3150   00:5148  AF                      xor a
    3151   00:5149  5F                      ld  e,a
    3152   00:514A  57                      ld  d,a                         ; Zero DE
    3153   00:514B                      TCPIP_DNS_Q_SIZE_LOOP:
    3154   00:514B  7E                      ld  a,(hl)                      ; so let's check the size of dns data
    3155   00:514C  B7                      or  a                           ; it is zero terminated
    3156   00:514D  28 05                   jr  z,TCPIP_DNS_Q_SEND          ; if zero, end of string
    3157   00:514F  13                      inc de                          ; ok, not zero, one more char
    3158   00:5150  23                      inc hl                          ; next
    3159   00:5151  C3 4B 51                jp  TCPIP_DNS_Q_SIZE_LOOP       ; jp is a tad bit faster and we are not worried about code size
    3160   00:5154                      TCPIP_DNS_Q_SEND:
    3161   00:5154                          ; Here we send the query and wait the result
    3162   00:5154  13                      inc de                          ; add 1, we will send flag first
    3163   00:5155  3E CE                   ld  a,206                       ; DNS_Q_NEW
    3164   00:5157                          SEND_DATA                       ; Send the command
    3164   00:5157  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3165   00:515A  7A                      ld  a,d
    3166   00:515B                          SEND_DATA                       ; Send the command size msb
    3166   00:515B  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3167   00:515E  7B                      ld  a,e
    3168   00:515F                          SEND_DATA                       ; Send the command size lsb
    3168   00:515F  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3169   00:5162  78                      ld  a,b
    3170   00:5163                          SEND_DATA                       ; Send the flag byte
    3170   00:5163  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3171   00:5166                      
    3172   00:5166                          if USE_MEM_IO = 0
    3173   00:5166                    ~     ; now otir of DNS/DNS BUFFER DATA SIZE
    3174   00:5166                    ~     ld  c,OUT_TX_PORT               ; our data TX port
    3175   00:5166                    ~     endif
    3176   00:5166  E1                      pop hl                          ; string to try to resolve
    3177   00:5167  1B                      dec de                          ; we are sending just data addressed by HL, so revert count
    3178   00:5168  7A                      ld  a,d
    3179   00:5169  B3                      or  e                           ; if de zero, no string, wrong parameters, but let the ESP answer
    3180   00:516A  CA 7C 51                jp  z,TCPIP_DNS_Q_WAIT_RSP
    3181   00:516D  AF                      xor a
    3182   00:516E                          ; Fast 16 bit variable size loop by GRAUW
    3183   00:516E  43                      ld  b,e
    3184   00:516F  1B                      dec de
    3185   00:5170  14                      inc d
    3186   00:5171                      TCPIP_DNS_Q_SENDLP:
    3187   00:5171                          ; send it
    3188   00:5171                          if USE_MEM_IO = 0
    3189   00:5171                    ~     outi
    3190   00:5171                    ~     jp  nz,TCPIP_DNS_Q_SENDLP
    3191   00:5171                    ~     else
    3192   00:5171  7E                      ld  a,(hl)
    3193   00:5172  32 07 7F                ld  (MEM_OUT_TX_PORT),a
    3194   00:5175  23                      inc hl
    3195   00:5176  10 F9                   djnz TCPIP_DNS_Q_SENDLP
    3196   00:5178                          endif
    3197   00:5178  15                      dec d
    3198   00:5179  C2 71 51                jp  nz,TCPIP_DNS_Q_SENDLP
    3199   00:517C                      TCPIP_DNS_Q_WAIT_RSP:
    3200   00:517C                          ; Now wait up to 900 ticks (15s@60Hz) to get response
    3201   00:517C  21 84 03                ld  hl,900
    3202   00:517F  CD 3E 61                call    SETCOUNTER
    3203   00:5182                      TCPIP_DNSQ_SEND_ST1:
    3204   00:5182                          CHECK_DATA
    3204   00:5182  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3204   00:5185  CB 47             >     bit 0,a
    3205   00:5187  20 05                   jr  nz,TCPIP_DNSQ_SEND_ST1.1
    3206   00:5189  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3207   00:518C  18 F4                   jr  TCPIP_DNSQ_SEND_ST1
    3208   00:518E                      TCPIP_DNSQ_SEND_ST1.1:
    3209   00:518E                          ; nz, check the data
    3210   00:518E                          RECEIVE_DATA
    3210   00:518E  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3211   00:5191  FE CE                   cp  206                         ; Is response of our command?
    3212   00:5193  20 ED                   jr  nz,TCPIP_DNSQ_SEND_ST1
    3213   00:5195                          ; now get return code, if return code other than 0, it is finished
    3214   00:5195                      TCPIP_DNSQ_SEND_RC:
    3215   00:5195                          CHECK_DATA
    3215   00:5195  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3215   00:5198  CB 47             >     bit 0,a
    3216   00:519A  20 05                   jr  nz,TCPIP_DNSQ_SEND_RC.1
    3217   00:519C  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3218   00:519F  18 F4                   jr  TCPIP_DNSQ_SEND_RC
    3219   00:51A1                      TCPIP_DNSQ_SEND_RC.1:
    3220   00:51A1                          ; nz, discard
    3221   00:51A1                          RECEIVE_DATA
    3221   00:51A1  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3222   00:51A4  B7                      or  a                           ; 0?
    3223   00:51A5  06 00                   ld  b,0                         ; say in progress as there is no failure status
    3224   00:51A7  C0                      ret nz                          ; if not, done, ERROR won't return data
    3225   00:51A8                      
    3226   00:51A8                          ; next two bytes are return code and size bytes, don't care, it is 4, resolved IP
    3227   00:51A8  06 02                   ld  b,2
    3228   00:51AA                      TCPIP_DNSQ_SEND_RC_ST2:
    3229   00:51AA                          CHECK_DATA
    3229   00:51AA  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3229   00:51AD  CB 47             >     bit 0,a
    3230   00:51AF  20 05                   jr  nz,TCPIP_DNSQ_SEND_RC_ST2.1
    3231   00:51B1  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3232   00:51B4  18 F4                   jr  TCPIP_DNSQ_SEND_RC_ST2
    3233   00:51B6                      TCPIP_DNSQ_SEND_RC_ST2.1:
    3234   00:51B6                          ; nz, discard
    3235   00:51B6                          RECEIVE_DATA
    3235   00:51B6  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3236   00:51B9  05                      dec b
    3237   00:51BA  20 EE                   jr  nz,TCPIP_DNSQ_SEND_RC_ST2
    3238   00:51BC                      
    3239   00:51BC                          ; now just get the 4 bytes IP and place it in L H E D
    3240   00:51BC                      TCPIP_DNSQ_IP_ST1:
    3241   00:51BC                          CHECK_DATA
    3241   00:51BC  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3241   00:51BF  CB 47             >     bit 0,a
    3242   00:51C1  20 05                   jr  nz,TCPIP_DNSQ_IP_ST1.1
    3243   00:51C3  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3244   00:51C6  18 F4                   jr  TCPIP_DNSQ_IP_ST1
    3245   00:51C8                      TCPIP_DNSQ_IP_ST1.1:
    3246   00:51C8                          ; nz, get it
    3247   00:51C8                          RECEIVE_DATA
    3247   00:51C8  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3248   00:51CB  6F                      ld  l,a
    3249   00:51CC                      TCPIP_DNSQ_IP_ST2:
    3250   00:51CC                          CHECK_DATA
    3250   00:51CC  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3250   00:51CF  CB 47             >     bit 0,a
    3251   00:51D1  20 05                   jr  nz,TCPIP_DNSQ_IP_ST2.1
    3252   00:51D3  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3253   00:51D6  18 F4                   jr  TCPIP_DNSQ_IP_ST2
    3254   00:51D8                      TCPIP_DNSQ_IP_ST2.1:
    3255   00:51D8                          ; nz, get it
    3256   00:51D8                          RECEIVE_DATA
    3256   00:51D8  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3257   00:51DB  67                      ld  h,a
    3258   00:51DC                      TCPIP_DNSQ_IP_ST3:
    3259   00:51DC                          CHECK_DATA
    3259   00:51DC  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3259   00:51DF  CB 47             >     bit 0,a
    3260   00:51E1  20 05                   jr  nz,TCPIP_DNSQ_IP_ST3.1
    3261   00:51E3  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3262   00:51E6  18 F4                   jr  TCPIP_DNSQ_IP_ST3
    3263   00:51E8                      TCPIP_DNSQ_IP_ST3.1:
    3264   00:51E8                          ; nz, get it
    3265   00:51E8                          RECEIVE_DATA
    3265   00:51E8  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3266   00:51EB  5F                      ld  e,a
    3267   00:51EC                      TCPIP_DNSQ_IP_ST4:
    3268   00:51EC                          CHECK_DATA
    3268   00:51EC  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3268   00:51EF  CB 47             >     bit 0,a
    3269   00:51F1  20 05                   jr  nz,TCPIP_DNSQ_IP_ST4.1
    3270   00:51F3  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3271   00:51F6  18 F4                   jr  TCPIP_DNSQ_IP_ST4
    3272   00:51F8                      TCPIP_DNSQ_IP_ST4.1:
    3273   00:51F8                          ; nz, get it
    3274   00:51F8                          RECEIVE_DATA
    3274   00:51F8  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3275   00:51FB  57                      ld  d,a
    3276   00:51FC                          ; done
    3277   00:51FC  3E 01                   ld  a,1
    3278   00:51FE  CD 63 62                call    SETDNSREADY             ; DNS done
    3279   00:5201  CD 8D 62                call    SETDNSRESULT            ; DNS RESULT
    3280   00:5204  06 02                   ld  b,2
    3281   00:5206  AF                      xor a
    3282   00:5207  C9                      ret
    3283   00:5208                      
    3284   00:5208                      ;=====================
    3285   00:5208                      ;===  TCPIP_DNS_S  ===
    3286   00:5208                      ;=====================
    3287   00:5208                      ;Obtains the host name resolution process state and result.
    3288   00:5208                      ;
    3289   00:5208                      ;Input:  A = 7
    3290   00:5208                      ;        B = Flags, when set to 1 they instruct the resolver to:
    3291   00:5208                      ;            bit 0: Clear any existing result or error condition after the execution
    3292   00:5208                      ;                   (except if there is a query in progress)
    3293   00:5208                      ;Output: A = Error code
    3294   00:5208                      ;        B = DNS error code (when error is ERR_DNS)
    3295   00:5208                      ;        B = Current query status (when error is ERR_OK):
    3296   00:5208                      ;            0: There is no query in progress, nor any result nor error code available
    3297   00:5208                      ;            1: There is a query in progress
    3298   00:5208                      ;            2: Query is complete
    3299   00:5208                      ;        C = Current query sub status (when error is ERR_OK and B=1):
    3300   00:5208                      ;            0: Unknown
    3301   00:5208                      ;            1: Querying the primary DNS server
    3302   00:5208                      ;            2: Querying the secondary DNS server
    3303   00:5208                      ;            3: Querying another DNS server
    3304   00:5208                      ;        C = Resolution process type (when error is ERR_OK and B=2):
    3305   00:5208                      ;            0: The name was obtained by querying a DNS server
    3306   00:5208                      ;            1: The name was a direct representation of an IP address
    3307   00:5208                      ;            2: The name was resolved locally
    3308   00:5208                      ;       L.H.E.D = Resolved IP address (when error is ERR_OK and B=2)
    3309   00:5208                      TCPIP_DNS_S:
    3310   00:5208                          ;--- Is there a result?
    3311   00:5208  CD 51 62                call    GETDNSREADY             ; DNS done?
    3312   00:520B  B7                      or  a
    3313   00:520C  28 23                   jr  z,TCPIP_DNS_S_NORESULT      ; No DNS result
    3314   00:520E                          ;--- Ok, we have a result, is it success?
    3315   00:520E  3D                      dec a
    3316   00:520F  28 12                   jr  z,TCPIP_DNS_S_HASRESULT     ; If it is 1, it was not an error
    3317   00:5211                          ;--- Shoot, there is an error...
    3318   00:5211                          ;--- And sure thing, ESP do not tell us details, it is always failure :-P
    3319   00:5211  CB 40                   bit 0,b                         ;--- clear error after this?
    3320   00:5213  28 09                   jr  z,TCP_IP_DNS_S_NOCLR
    3321   00:5215                          ;--- Clear
    3322   00:5215  06 00                   ld b,0                          ;--- Like I've said, no details
    3323   00:5217  AF                      xor a
    3324   00:5218  CD 63 62                call    SETDNSREADY             ; DNS not done
    3325   00:521B  3E 08                   ld  a,ERR_DNS;
    3326   00:521D  C9                      ret
    3327   00:521E                      TCP_IP_DNS_S_NOCLR:
    3328   00:521E                          ;--- Don't clear
    3329   00:521E  3E 08                   ld  a,ERR_DNS
    3330   00:5220  06 00                   ld  b,0                         ;--- Like I've said, no details
    3331   00:5222  C9                      ret
    3332   00:5223                          ;--- There is a result available...
    3333   00:5223                      TCPIP_DNS_S_HASRESULT:
    3334   00:5223                          ;--- Copy the result
    3335   00:5223  CD 77 62                call    GETDNSRESULT
    3336   00:5226  AF                      xor a
    3337   00:5227  CB 40                   bit 0,b                         ;--- clear result after this?
    3338   00:5229  28 03                   jr  z,TCP_IP_DNS_S_RES_NOCLR    ;--- no, just return
    3339   00:522B                          ;--- Yes, clear
    3340   00:522B  CD 63 62                call    SETDNSREADY             ; DNS not done
    3341   00:522E                      TCP_IP_DNS_S_RES_NOCLR:
    3342   00:522E  06 02                   ld  b,2
    3343   00:5230  C9                      ret
    3344   00:5231                      
    3345   00:5231                      TCPIP_DNS_S_NORESULT:
    3346   00:5231  AF                      xor a                           ;--- OK no query in progress, no result, means nothing in progress
    3347   00:5232  06 00                   ld  b,0                         ;--- No query in progress
    3348   00:5234  C9                      ret
    3349   00:5235                      
    3350   00:5235                      ;========================
    3351   00:5235                      ;===  TCPIP_UDP_OPEN  ===
    3352   00:5235                      ;========================
    3353   00:5235                      ;Open an UDP connection.
    3354   00:5235                      ;
    3355   00:5235                      ;Input:  A  = 8
    3356   00:5235                      ;        HL = Local port number (#FFFF=random)
    3357   00:5235                      ;        B  = Intended connection lifetime:
    3358   00:5235                      ;             0: Transient
    3359   00:5235                      ;             1: Resident
    3360   00:5235                      ;Output: A = Error code
    3361   00:5235                      ;        B = Connection number
    3362   00:5235                      TCPIP_UDP_OPEN:
    3363   00:5235                          SEND_DATA                       ; Send the command
    3363   00:5235  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3364   00:5238  AF                      xor a
    3365   00:5239                          SEND_DATA                       ; Send the command size msb
    3365   00:5239  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3366   00:523C  3E 03                   ld  a,3
    3367   00:523E                          SEND_DATA                       ; Send the command size lsb
    3367   00:523E  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3368   00:5241  7D                      ld  a,l
    3369   00:5242                          SEND_DATA                       ; Send the port LSB
    3369   00:5242  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3370   00:5245  7C                      ld  a,h
    3371   00:5246                          SEND_DATA                       ; Send the port MSB
    3371   00:5246  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3372   00:5249  78                      ld  a,b
    3373   00:524A                          SEND_DATA                       ; Send the connection transient/resident
    3373   00:524A  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3374   00:524D                      
    3375   00:524D                          ; Now wait up to 180 ticks to get response
    3376   00:524D  21 B4 00                ld  hl,180
    3377   00:5250  CD 3E 61                call    SETCOUNTER
    3378   00:5253                      TCPIP_UDP_OPEN_ST1:
    3379   00:5253                          CHECK_DATA
    3379   00:5253  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3379   00:5256  CB 47             >     bit 0,a
    3380   00:5258  20 05                   jr  nz,TCPIP_UDP_OPEN_ST1.1
    3381   00:525A  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3382   00:525D  18 F4                   jr  TCPIP_UDP_OPEN_ST1
    3383   00:525F                      TCPIP_UDP_OPEN_ST1.1:
    3384   00:525F                          ; nz, check the data
    3385   00:525F                          RECEIVE_DATA
    3385   00:525F  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3386   00:5262  FE 08                   cp  8                           ; Is response of our command?
    3387   00:5264  20 ED                   jr  nz,TCPIP_UDP_OPEN_ST1
    3388   00:5266                          ; now get return code, if return code other than 0, it is finished
    3389   00:5266                      TCPIP_UDP_OPEN_RC:
    3390   00:5266                          CHECK_DATA
    3390   00:5266  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3390   00:5269  CB 47             >     bit 0,a
    3391   00:526B  20 05                   jr  nz,TCPIP_UDP_OPEN_RC.1
    3392   00:526D  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3393   00:5270  18 F4                   jr  TCPIP_UDP_OPEN_RC
    3394   00:5272                      TCPIP_UDP_OPEN_RC.1:
    3395   00:5272                          ; nz, discard
    3396   00:5272                          RECEIVE_DATA
    3396   00:5272  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3397   00:5275  B7                      or  a                           ; 0?
    3398   00:5276  C0                      ret nz                          ; if not, done
    3399   00:5277                      
    3400   00:5277                          ; next two bytes are return code and size bytes, don't care, it is 1, conn #
    3401   00:5277  06 02                   ld  b,2
    3402   00:5279                      TCPIP_UDP_OPEN_ST2:
    3403   00:5279                          CHECK_DATA
    3403   00:5279  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3403   00:527C  CB 47             >     bit 0,a
    3404   00:527E  20 05                   jr  nz,TCPIP_UDP_OPEN_ST2.1
    3405   00:5280  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3406   00:5283  18 F4                   jr  TCPIP_UDP_OPEN_ST2
    3407   00:5285                      TCPIP_UDP_OPEN_ST2.1:
    3408   00:5285                          ; nz, discard
    3409   00:5285                          RECEIVE_DATA
    3409   00:5285  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3410   00:5288  05                      dec b
    3411   00:5289  20 EE                   jr  nz,TCPIP_UDP_OPEN_ST2
    3412   00:528B                      
    3413   00:528B                          ; now just get the 1 byte, conn#, should go to B
    3414   00:528B                      TCPIP_UDP_OPEN_CONN_ST1:
    3415   00:528B                          CHECK_DATA
    3415   00:528B  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3415   00:528E  CB 47             >     bit 0,a
    3416   00:5290  20 05                   jr  nz,TCPIP_UDP_OPEN_CONN_ST1.1
    3417   00:5292  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3418   00:5295  18 F4                   jr  TCPIP_UDP_OPEN_CONN_ST1
    3419   00:5297                      TCPIP_UDP_OPEN_CONN_ST1.1:
    3420   00:5297                          ; nz, get it
    3421   00:5297                          RECEIVE_DATA
    3421   00:5297  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3422   00:529A  47                      ld  b,a
    3423   00:529B                          ; done
    3424   00:529B  AF                      xor a
    3425   00:529C  C9                      ret
    3426   00:529D                      
    3427   00:529D                      ;=========================
    3428   00:529D                      ;===  TCPIP_UDP_CLOSE  ===
    3429   00:529D                      ;=========================
    3430   00:529D                      ;Close a UDP connection.
    3431   00:529D                      ;
    3432   00:529D                      ;Input:  A = 9
    3433   00:529D                      ;        B = Connection number
    3434   00:529D                      ;            0 to close all open transient UDP connections
    3435   00:529D                      ;Output: A = Error code
    3436   00:529D                      TCPIP_UDP_CLOSE:
    3437   00:529D                          SEND_DATA                       ; Send the command
    3437   00:529D  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3438   00:52A0  AF                      xor a
    3439   00:52A1                          SEND_DATA                       ; Send the command size msb
    3439   00:52A1  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3440   00:52A4  3E 01                   ld  a,1
    3441   00:52A6                          SEND_DATA                       ; Send the command size lsb
    3441   00:52A6  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3442   00:52A9  78                      ld  a,b
    3443   00:52AA                          SEND_DATA                       ; Send the connection #
    3443   00:52AA  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3444   00:52AD                          ; Now wait up to 180 ticks to get response
    3445   00:52AD  21 B4 00                ld  hl,180
    3446   00:52B0  CD 3E 61                call    SETCOUNTER
    3447   00:52B3                      TCPIP_UDP_CLOSE_ST1:
    3448   00:52B3                          CHECK_DATA
    3448   00:52B3  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3448   00:52B6  CB 47             >     bit 0,a
    3449   00:52B8  20 05                   jr  nz,TCPIP_UDP_CLOSE_ST1.1
    3450   00:52BA  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3451   00:52BD  18 F4                   jr  TCPIP_UDP_CLOSE_ST1
    3452   00:52BF                      TCPIP_UDP_CLOSE_ST1.1:
    3453   00:52BF                          ; nz, check the data
    3454   00:52BF                          RECEIVE_DATA
    3454   00:52BF  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3455   00:52C2  FE 09                   cp  9                           ; Is response of our command?
    3456   00:52C4  20 ED                   jr  nz,TCPIP_UDP_CLOSE_ST1
    3457   00:52C6                          ; now get return code, if return code other than 0, it is finished
    3458   00:52C6                      TCPIP_UDP_CLOSE_RC:
    3459   00:52C6                          CHECK_DATA
    3459   00:52C6  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3459   00:52C9  CB 47             >     bit 0,a
    3460   00:52CB  20 05                   jr  nz,TCPIP_UDP_CLOSE_RC.1
    3461   00:52CD  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3462   00:52D0  18 F4                   jr  TCPIP_UDP_CLOSE_RC
    3463   00:52D2                      TCPIP_UDP_CLOSE_RC.1:
    3464   00:52D2                          ; nz, discard
    3465   00:52D2                          RECEIVE_DATA
    3465   00:52D2  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3466   00:52D5  B7                      or  a                           ; 0?
    3467   00:52D6  C0                      ret nz                          ; if not, done
    3468   00:52D7                      
    3469   00:52D7                          ; next two bytes are return code and size bytes, don't care, it is 1, conn #
    3470   00:52D7  06 02                   ld  b,2
    3471   00:52D9                      TCPIP_UDP_CLOSE_ST2:
    3472   00:52D9                          CHECK_DATA
    3472   00:52D9  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3472   00:52DC  CB 47             >     bit 0,a
    3473   00:52DE  20 05                   jr  nz,TCPIP_UDP_CLOSE_ST2.1
    3474   00:52E0  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3475   00:52E3  18 F4                   jr  TCPIP_UDP_CLOSE_ST2
    3476   00:52E5                      TCPIP_UDP_CLOSE_ST2.1:
    3477   00:52E5                          ; nz, discard
    3478   00:52E5                          RECEIVE_DATA
    3478   00:52E5  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3479   00:52E8  05                      dec b
    3480   00:52E9  20 EE                   jr  nz,TCPIP_UDP_CLOSE_ST2
    3481   00:52EB                      
    3482   00:52EB                          ; done, no return data other than return code
    3483   00:52EB  AF                      xor a
    3484   00:52EC  C9                      ret
    3485   00:52ED                      
    3486   00:52ED                      ;=========================
    3487   00:52ED                      ;===  TCPIP_UDP_STATE  ===
    3488   00:52ED                      ;=========================
    3489   00:52ED                      ;Get the state of a UDP connection.
    3490   00:52ED                      ;
    3491   00:52ED                      ;Input:  A = 10
    3492   00:52ED                      ;        B = Connection number
    3493   00:52ED                      ;Output: A  = Error code
    3494   00:52ED                      ;        HL = Local port number
    3495   00:52ED                      ;        B  = Number of pending incoming datagrams
    3496   00:52ED                      ;        DE = Size of oldest pending incoming datagram (data part only)
    3497   00:52ED                      TCPIP_UDP_STATE:
    3498   00:52ED                          SEND_DATA                       ; Send the command
    3498   00:52ED  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3499   00:52F0  AF                      xor a
    3500   00:52F1                          SEND_DATA                       ; Send the command size msb
    3500   00:52F1  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3501   00:52F4  3C                      inc a
    3502   00:52F5                          SEND_DATA                       ; Send the command size lsb
    3502   00:52F5  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3503   00:52F8  78                      ld  a,b
    3504   00:52F9                          SEND_DATA                       ; Send the parameter
    3504   00:52F9  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3505   00:52FC                      
    3506   00:52FC                          ; Now wait up to 60 ticks to get response
    3507   00:52FC  21 3C 00                ld  hl,60
    3508   00:52FF  CD 3E 61                call    SETCOUNTER
    3509   00:5302                      TCPIP_UDP_STATE_ST1:
    3510   00:5302                          CHECK_DATA
    3510   00:5302  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3510   00:5305  CB 47             >     bit 0,a
    3511   00:5307  20 05                   jr  nz,TCPIP_UDP_STATE_ST1.1
    3512   00:5309  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3513   00:530C  18 F4                   jr  TCPIP_UDP_STATE_ST1
    3514   00:530E                      TCPIP_UDP_STATE_ST1.1:
    3515   00:530E                          ; nz, check the data
    3516   00:530E                          RECEIVE_DATA
    3516   00:530E  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3517   00:5311  FE 0A                   cp  10                          ; Is response of our command?
    3518   00:5313  20 ED                   jr  nz,TCPIP_UDP_STATE_ST1
    3519   00:5315                          ; now get return code, if return code other than 0, it is finished
    3520   00:5315                      TCPIP_UDP_STATE_RC:
    3521   00:5315                          CHECK_DATA
    3521   00:5315  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3521   00:5318  CB 47             >     bit 0,a
    3522   00:531A  20 05                   jr  nz,TCPIP_UDP_STATE_RC.1
    3523   00:531C  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3524   00:531F  18 F4                   jr  TCPIP_UDP_STATE_RC
    3525   00:5321                      TCPIP_UDP_STATE_RC.1:
    3526   00:5321                          ; nz, discard
