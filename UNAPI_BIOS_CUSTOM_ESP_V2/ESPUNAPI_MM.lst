    1270   00:46A8  77                      ld  (hl),a
    1271   00:46A9  23                      inc hl
    1272   00:46AA  E5                      push    hl                      ; Save it
    1273   00:46AB  21 5E 6C                ld  hl,MENU_MANUALENTRY_PWD
    1274   00:46AE  CD 96 4C                call    PRINTHL                 ; We are asking if password is needed
    1275   00:46B1  E1                      pop hl                          ; Restore it
    1276   00:46B2  CD 9F 00                call    CHGET                   ; Get key, if Y or y, needed, otherwise not
    1277   00:46B5  CB AF                   res 5,a                         ; Force upper case
    1278   00:46B7  FE 59                   cp  'Y'
