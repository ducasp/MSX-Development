    5441   00:5CF3                          CHECK_DATA
    5441   00:5CF3  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5441   00:5CF6  CB 47             >     bit 0,a
    5442   00:5CF8  20 05                   jr  nz,SSH_RCV_ST2B.1
    5443   00:5CFA  CD 4A 5B                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5444   00:5CFD  18 F4                   jr  SSH_RCV_ST2B
    5445   00:5CFF                      SSH_RCV_ST2B.1:
    5446   00:5CFF                          ; nz, low byte count of bytes to receive
    5447   00:5CFF                          RECEIVE_DATA
    5447   00:5CFF  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5448   00:5D02  6F                      ld  l,a
    5449   00:5D03  B4                      or  h
    5450   00:5D04                          ; if it was 0, no data
    5451   00:5D04                          if USE_MEM_IO = 1
    5452   00:5D04  CA 82 5B                jp  z,TCPIP_TCP_RCV_RET_NODATA  ; not a typo, no need to make the same code again
    5453   00:5D07                          else
    5454   00:5D07                    ~     jp  z,TCPIP_TCP_RCV_RET_NODATA  ; not a typo, no need to make the same code again
    5455   00:5D07                    ~     endif
    5456   00:5D07  4D                      ld  c,l
    5457   00:5D08  44                      ld  b,h                         ; BC has effective received data size, as well as HL
    5458   00:5D09                      
    5459   00:5D09                          ; put effective data size in de
    5460   00:5D09  EB                      ex  de,hl
    5461   00:5D0A                          ; will start moving at address in stack (we've pushed the adress in WORD)
    5462   00:5D0A  CD F8 5E                call    GETWORD
    5463   00:5D0D  CD 6B 5F                call    BCBACKUP                ; save count (BC)
    5464   00:5D10                      
    5465   00:5D10                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use ini :-D
    5466   00:5D10  43                      ld  b,e                         ; Number of loops originaly in DE
    5467   00:5D11  1B                      dec de
    5468   00:5D12  14                      inc d
    5469   00:5D13                          if USE_MEM_IO = 0
    5470   00:5D13                    ~     ld  c,IN_DATA_PORT
    5471   00:5D13                    ~     CHECK_QUICK_RECEIVE
    5472   00:5D13                    ~     jr  z,SSH_RCV_R_NSF             ; If not, go to the old, slower route
    5473   00:5D13                    ~     ; Otherwise, let's speed it up baby!
    5474   00:5D13                    ~ SSH_RCV_R:
    5475   00:5D13                    ~     inir
    5476   00:5D13                    ~     else
    5477   00:5D13                          CHECK_QUICK_RECEIVE
    5477   00:5D13  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5477   00:5D16  CB 5F             >     bit 3,a
    5478   00:5D18  28 1A                   jr  z,SSH_RCV_R_NSF       ; If not, go to the old, slower route
    5479   00:5D1A                          ; Otherwise, let's speed it up baby!
    5480   00:5D1A                      SSH_RCV_R:
    5481   00:5D1A  3A 06 7F                ld  a,(MEM_IN_DATA_PORT)
    5482   00:5D1D  77                      ld  (hl),a
