    1642   00:492E  FE 1B                   cp  #1b                         ; ESC?
    1643   00:4930  CA 5C 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1644   00:4933  FE 4F                   cp  'O'                         ; Toggle Nagle Off
    1645   00:4935  CA 83 49                jp  z,SET_NAGLE_OFF             ;
    1646   00:4938  FE 6F                   cp  'o'                         ; Toggle Nagle Off
    1647   00:493A  CA 83 49                jp  z,SET_NAGLE_OFF             ;
    1648   00:493D  CD C0 00                call    BEEP                    ; Wrong Input, beep
    1649   00:4940  C3 2B 49                jp  SET_NAGLE_WI_OFF            ; And return waiting key
