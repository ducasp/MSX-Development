    5627   00:5DED  CB FF                   set 7,a                         ; ESP SSH commands start at #80
    5628   00:5DEF                          SEND_DATA                       ; Send the command
    5628   00:5DEF  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5629   00:5DF2                          ; prepare new data size, adding our 1 byte overhead (connection #)
    5630   00:5DF2  23                      inc hl
    5631   00:5DF3  7C                      ld  a,h
    5632   00:5DF4                          SEND_DATA                       ; Send the command size msb
    5632   00:5DF4  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5633   00:5DF7  7D                      ld  a,l
    5634   00:5DF8                          SEND_DATA                       ; Send the command size lsb
    5634   00:5DF8  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5635   00:5DFB  78                      ld  a,b
    5636   00:5DFC                          SEND_DATA                       ; Send the connection #
    5636   00:5DFC  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5637   00:5DFF  2B                      dec hl
    5638   00:5E00  EB                      ex  de,hl
    5639   00:5E01                          ; now oti the data starting at hl, size is in DE
    5640   00:5E01                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    5641   00:5E01  43                      ld  b,e                         ;Number of loops originaly in DE
    5642   00:5E02  1B                      dec de
    5643   00:5E03  14                      inc d
    5644   00:5E04                          if USE_MEM_IO = 0
