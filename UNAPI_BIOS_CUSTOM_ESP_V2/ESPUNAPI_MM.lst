    5393   00:5C84                      ;=======================
    5394   00:5C84                      ;===  TCPIP_TCP_RCV  ===
    5395   00:5C84                      ;=======================
    5396   00:5C84                      ;Receive data from a TCP connection.
    5397   00:5C84                      ;
    5398   00:5C84                      ;Input:   A  = 18
    5399   00:5C84                      ;         B  = Connection number
    5400   00:5C84                      ;         DE = Address for the retrieved data
    5401   00:5C84                      ;         HL = Length of the data to be obtained
    5402   00:5C84                      ;Output:  A  = Error code
    5403   00:5C84                      ;         BC = Total number of bytes that have been actually retrieved
    5404   00:5C84                      ;         HL = Number of urgent data bytes that have been retrieved
    5405   00:5C84                      ;              (placed at the beginning of the received data block)
    5406   00:5C84                      ; Save registers other than AF
    5407   00:5C84                      TCPIP_TCP_RCV_CHECK_TIME_OUT:
    5408   00:5C84  C5                      push bc
    5409   00:5C85  D5                      push de
    5410   00:5C86  E5                      push hl
    5411   00:5C87  CD 27 61                call    GETCOUNTER
    5412   00:5C8A  7D                      ld  a,l
    5413   00:5C8B  B4                      or  h
    5414   00:5C8C                          ; Restore registers, we are returning
    5415   00:5C8C  E1                      pop hl
    5416   00:5C8D  D1                      pop de
    5417   00:5C8E  C1                      pop bc
    5418   00:5C8F  C0                      ret nz
    5419   00:5C90                          ; Ok, timeout...
    5420   00:5C90  F1                      pop af                          ; Get return address of who called this out of the stack, we will return from the function or re-start
    5421   00:5C91                      TCPIP_TCP_RCV_RETRY_QRCV:
    5422   00:5C91  CD 46 61                call    GETBYTE
    5423   00:5C94  B7                      or  a
    5424   00:5C95  28 0C                   jr  z,TCPIP_TCP_RCV_CHECK_TIME_OUT.NORXRETRY
    5425   00:5C97                          ; Ok, so let's ask ESP to re-send the data and retry receiving it
    5426   00:5C97  3D                      dec a
    5427   00:5C98  CD 58 61                call    SETBYTE                 ; we are retrying it
    5428   00:5C9B  3E 72                   ld  a,'r'                       ; retry transmission command
    5429   00:5C9D                          SEND_DATA
    5429   00:5C9D  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5430   00:5CA0  C3 E7 5C                jp  TCPIP_TCP_RCV.RXRETRY       ; and retry it
    5431   00:5CA3                      TCPIP_TCP_RCV_CHECK_TIME_OUT.NORXRETRY:
    5432   00:5CA3  3E 0F                   ld  a,ERR_INV_OPER
    5433   00:5CA5  C9                      ret                             ; and return the function itself
    5434   00:5CA6                      
    5435   00:5CA6                      TCPIP_TCP_RCV_RET_ERR:
    5436   00:5CA6                          ; next two bytes are size bytes, don't care
    5437   00:5CA6  47                      ld  b,a                         ; save error in b
    5438   00:5CA7  0E 02                   ld  c,2
    5439   00:5CA9                      TCPIP_TCP_RCV_RET_ERR2:
    5440   00:5CA9                          CHECK_DATA
    5440   00:5CA9  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5440   00:5CAC  CB 47             >     bit 0,a
    5441   00:5CAE  20 05                   jr  nz,TCPIP_TCP_RCV_RET_ERR2.1
    5442   00:5CB0  CD 84 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5443   00:5CB3  18 F4                   jr  TCPIP_TCP_RCV_RET_ERR2
    5444   00:5CB5                      TCPIP_TCP_RCV_RET_ERR2.1:
    5445   00:5CB5                          ; nz, discard
    5446   00:5CB5                          RECEIVE_DATA
    5446   00:5CB5  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5447   00:5CB8  0D                      dec c
    5448   00:5CB9  20 EE                   jr  nz,TCPIP_TCP_RCV_RET_ERR2
    5449   00:5CBB                          ; now return w/ error that is saved in b
    5450   00:5CBB  78                      ld  a,b
    5451   00:5CBC                      TCPIP_TCP_RCV_RET_NODATA:
    5452   00:5CBC  21 00 00                ld  hl,0
    5453   00:5CBF  01 00 00                ld  bc,0
    5454   00:5CC2  C9                      ret
    5455   00:5CC3                      
    5456   00:5CC3                      TCPIP_TCP_RCV:
    5457   00:5CC3  EB                      ex  de,hl
    5458   00:5CC4  CD 7F 61                call    SETWORD
    5459   00:5CC7  EB                      ex  de,hl
    5460   00:5CC8  3E 12                   ld  a,18
    5461   00:5CCA                          SEND_DATA                       ; Send the command
    5461   00:5CCA  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5462   00:5CCD  AF                      xor a
    5463   00:5CCE                          SEND_DATA                       ; Send the command size msb
    5463   00:5CCE  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5464   00:5CD1  3E 03                   ld  a,3
    5465   00:5CD3                          SEND_DATA                       ; Send the command size lsb
    5465   00:5CD3  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5466   00:5CD6  78                      ld  a,b
    5467   00:5CD7                          SEND_DATA                       ; Send the connection #
    5467   00:5CD7  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5468   00:5CDA  7D                      ld  a,l
    5469   00:5CDB                          SEND_DATA                       ; Send MAX rcv size LSB
    5469   00:5CDB  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5470   00:5CDE  7C                      ld  a,h
    5471   00:5CDF                          SEND_DATA                       ; Send MAX rcv size MSB
    5471   00:5CDF  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5472   00:5CE2  3E 03                   ld  a,3
    5473   00:5CE4  CD 58 61                call    SETBYTE                 ; Ok, retry up to three times
    5474   00:5CE7                      TCPIP_TCP_RCV.RXRETRY:
    5475   00:5CE7                          ; Now wait up to 600 ticks to get response
    5476   00:5CE7  21 58 02                ld  hl,600
    5477   00:5CEA  CD 36 61                call    SETCOUNTER
    5478   00:5CED                      TCPIP_TCP_RCV_ST1:
    5479   00:5CED                          CHECK_DATA
    5479   00:5CED  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5479   00:5CF0  CB 47             >     bit 0,a
    5480   00:5CF2  20 05                   jr  nz,TCPIP_TCP_RCV_ST1.1
    5481   00:5CF4  CD 84 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5482   00:5CF7  18 F4                   jr  TCPIP_TCP_RCV_ST1
    5483   00:5CF9                      TCPIP_TCP_RCV_ST1.1:
    5484   00:5CF9                          ; nz, check the data
    5485   00:5CF9                          RECEIVE_DATA
    5485   00:5CF9  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5486   00:5CFC  FE 12                   cp 18                           ; Is response of our command?
    5487   00:5CFE  20 ED                   jr  nz,TCPIP_TCP_RCV_ST1
    5488   00:5D00                          ; At this point, all data is being buffered, so 15 ticks, quarter second, is more than enough time-out
    5489   00:5D00  F3                      di
    5490   00:5D01  21 1E 00                ld  hl,30
    5491   00:5D04  CD 36 61                call    SETCOUNTER
    5492   00:5D07  FB                      ei
    5493   00:5D08                          ; now get return code, if return code other than 0, it is finished
    5494   00:5D08                      TCPIP_TCP_RCV_RC:
    5495   00:5D08                          CHECK_DATA
    5495   00:5D08  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5495   00:5D0B  CB 47             >     bit 0,a
    5496   00:5D0D  20 05                   jr  nz,TCPIP_TCP_RCV_RC.1
    5497   00:5D0F  CD 84 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5498   00:5D12  18 F4                   jr  TCPIP_TCP_RCV_RC
    5499   00:5D14                      TCPIP_TCP_RCV_RC.1:
    5500   00:5D14                          ; nz, discard
    5501   00:5D14                          RECEIVE_DATA
    5501   00:5D14  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5502   00:5D17  B7                      or  a                           ; 0?
    5503   00:5D18  20 8C                   jr  nz,TCPIP_TCP_RCV_RET_ERR    ; if not, done
    5504   00:5D1A                          ; next two bytes are response size bytes (UB count two bytes, always 0, and data read), save it -2 to BC
    5505   00:5D1A                      TCPIP_TCP_RCV_ST2A:
    5506   00:5D1A                          CHECK_DATA
    5506   00:5D1A  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5506   00:5D1D  CB 47             >     bit 0,a
    5507   00:5D1F  20 05                   jr  nz,TCPIP_TCP_RCV_ST2A.1
    5508   00:5D21  CD 84 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5509   00:5D24  18 F4                   jr  TCPIP_TCP_RCV_ST2A
    5510   00:5D26                      TCPIP_TCP_RCV_ST2A.1:
    5511   00:5D26                          ; nz, high byte count of bytes to receive
    5512   00:5D26                          RECEIVE_DATA
    5512   00:5D26  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5513   00:5D29  67                      ld h,a
    5514   00:5D2A                      TCPIP_TCP_RCV_ST2B:
    5515   00:5D2A                          CHECK_DATA
    5515   00:5D2A  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5515   00:5D2D  CB 47             >     bit 0,a
    5516   00:5D2F  20 05                   jr  nz,TCPIP_TCP_RCV_ST2B.1
    5517   00:5D31  CD 84 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5518   00:5D34  18 F4                   jr  TCPIP_TCP_RCV_ST2B
    5519   00:5D36                      TCPIP_TCP_RCV_ST2B.1:
    5520   00:5D36                          ; nz, low byte count of bytes to receive
    5521   00:5D36                          RECEIVE_DATA
    5521   00:5D36  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5522   00:5D39  6F                      ld  l,a
    5523   00:5D3A  01 02 00                ld  bc,2
    5524   00:5D3D                          ; subtract 2 (Urgent data count, not used)
    5525   00:5D3D  AF                      xor a                           ; zero carry
    5526   00:5D3E  ED 42                   sbc hl,bc
    5527   00:5D40                          ; if it was 0, will carry
    5528   00:5D40                          if USE_MEM_IO = 1
    5529   00:5D40  DA BC 5C                jp  c,TCPIP_TCP_RCV_RET_NODATA
    5530   00:5D43                          else
    5531   00:5D43                    ~     jr  c,TCPIP_TCP_RCV_RET_NODATA
    5532   00:5D43                    ~     endif
    5533   00:5D43  4D                      ld  c,l
    5534   00:5D44  44                      ld  b,h                         ; BC has effective received data size, as well as HL
    5535   00:5D45                      
    5536   00:5D45                          ; now just discard 2 bytes urgent data
    5537   00:5D45                      TCPIP_TCP_RCV_UDC_ST1:
    5538   00:5D45                          CHECK_DATA
    5538   00:5D45  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5538   00:5D48  CB 47             >     bit 0,a
    5539   00:5D4A  20 05                   jr  nz,TCPIP_TCP_RCV_UDC_ST1.1
    5540   00:5D4C  CD 84 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5541   00:5D4F  18 F4                   jr  TCPIP_TCP_RCV_UDC_ST1
    5542   00:5D51                      TCPIP_TCP_RCV_UDC_ST1.1:
    5543   00:5D51                          ; nz, get it
    5544   00:5D51                          RECEIVE_DATA
    5544   00:5D51  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5545   00:5D54                      TCPIP_TCP_RCV_UDC_ST2:
    5546   00:5D54                          CHECK_DATA
    5546   00:5D54  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5546   00:5D57  CB 47             >     bit 0,a
    5547   00:5D59  20 05                   jr  nz,TCPIP_TCP_RCV_UDC_ST2.1
    5548   00:5D5B  CD 84 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5549   00:5D5E  18 F4                   jr  TCPIP_TCP_RCV_UDC_ST2
    5550   00:5D60                      TCPIP_TCP_RCV_UDC_ST2.1:
    5551   00:5D60                          ; nz, get it
    5552   00:5D60                          RECEIVE_DATA
    5552   00:5D60  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5553   00:5D63                      
    5554   00:5D63                          ; put effective data size in de
    5555   00:5D63  EB                      ex  de,hl
    5556   00:5D64                          ; will start moving at address in stack (we've pushed the adress in WORD)
    5557   00:5D64  CD 6C 61                call    GETWORD
    5558   00:5D67  CD DF 61                call    BCBACKUP                ; save count (BC)
    5559   00:5D6A                      
    5560   00:5D6A                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use ini :-D
    5561   00:5D6A  43                      ld  b,e                         ; Number of loops originaly in DE
    5562   00:5D6B  1B                      dec de
    5563   00:5D6C  14                      inc d
    5564   00:5D6D                          if USE_MEM_IO = 0
    5565   00:5D6D                    ~     ld  c,IN_DATA_PORT
    5566   00:5D6D                    ~     CHECK_QUICK_RECEIVE
    5567   00:5D6D                    ~     jr  z,TCPIP_TCP_RCV_R_NSF       ; If not, go to the old, slower route
    5568   00:5D6D                    ~     ; Otherwise, let's speed it up baby!
    5569   00:5D6D                    ~ TCPIP_TCP_RCV_R:
    5570   00:5D6D                    ~     inir
    5571   00:5D6D                    ~     else
    5572   00:5D6D                          CHECK_QUICK_RECEIVE
    5572   00:5D6D  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5572   00:5D70  CB 5F             >     bit 3,a
    5573   00:5D72  28 1A                   jr  z,TCPIP_TCP_RCV_R_NSF       ; If not, go to the old, slower route
    5574   00:5D74                          ; Otherwise, let's speed it up baby!
    5575   00:5D74                      TCPIP_TCP_RCV_R:
    5576   00:5D74  3A 06 7F                ld  a,(MEM_IN_DATA_PORT)
    5577   00:5D77  77                      ld  (hl),a
    5578   00:5D78  23                      inc hl
    5579   00:5D79  10 F9                   djnz TCPIP_TCP_RCV_R
    5580   00:5D7B                          endif
    5581   00:5D7B  15                      dec d
    5582   00:5D7C  20 F6                   jr nz,TCPIP_TCP_RCV_R
    5583   00:5D7E                          CHECK_BUFFER_UNDERRUN
    5583   00:5D7E  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5583   00:5D81  CB 67             >     bit 4,a
    5584   00:5D83  C2 91 5C                jp  nz,TCPIP_TCP_RCV_RETRY_QRCV ; If yes, retry
    5585   00:5D86                          ; Otherwise, done
    5586   00:5D86  CD CD 61                call    BCRESTORE               ; done, restore return data in BC
    5587   00:5D89                          ; no urgent data support
    5588   00:5D89  21 00 00                ld  hl,0
    5589   00:5D8C  AF                      xor a
