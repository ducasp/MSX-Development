    3527   00:5321  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3528   00:5324  B7                      or  a                           ; 0?
    3529   00:5325  C0                      ret nz                          ; if not, done
    3530   00:5326                      
    3531   00:5326                          ; next two bytes are return code and size bytes, don't care, it is 5
    3532   00:5326  06 02                   ld  b,2
    3533   00:5328                      TCPIP_UDP_STATE_ST2:
    3534   00:5328                          CHECK_DATA
    3534   00:5328  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3534   00:532B  CB 47             >     bit 0,a
    3535   00:532D  20 05                   jr  nz,TCPIP_UDP_STATE_ST2.1
    3536   00:532F  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3537   00:5332  18 F4                   jr  TCPIP_UDP_STATE_ST2
    3538   00:5334                      TCPIP_UDP_STATE_ST2.1:
    3539   00:5334                          ; nz, discard
    3540   00:5334                          RECEIVE_DATA
    3540   00:5334  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3541   00:5337  05                      dec b
    3542   00:5338  20 EE                   jr  nz,TCPIP_UDP_STATE_ST2
    3543   00:533A                      
    3544   00:533A                          ; now just get the 5 bytes (Port LSB then MSB, # of packets, packet size LSB then MSB) and order it in L, H, B, E and D
    3545   00:533A                      TCPIP_UDP_STATE_RESP_ST1:
    3546   00:533A                          CHECK_DATA
    3546   00:533A  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3546   00:533D  CB 47             >     bit 0,a
    3547   00:533F  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST1.1
    3548   00:5341  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3549   00:5344  18 F4                   jr  TCPIP_UDP_STATE_RESP_ST1
    3550   00:5346                      TCPIP_UDP_STATE_RESP_ST1.1:
    3551   00:5346                          ; nz, get it
    3552   00:5346                          RECEIVE_DATA
    3552   00:5346  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3553   00:5349  6F                      ld  l,a
    3554   00:534A                      TCPIP_UDP_STATE_RESP_ST2:
    3555   00:534A                          CHECK_DATA
    3555   00:534A  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3555   00:534D  CB 47             >     bit 0,a
    3556   00:534F  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST2.1
    3557   00:5351  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3558   00:5354  18 F4                   jr  TCPIP_UDP_STATE_RESP_ST2
    3559   00:5356                      TCPIP_UDP_STATE_RESP_ST2.1:
    3560   00:5356                          ; nz, get it
    3561   00:5356                          RECEIVE_DATA
    3561   00:5356  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3562   00:5359  67                      ld  h,a
    3563   00:535A                      TCPIP_UDP_STATE_RESP_ST3:
    3564   00:535A                          CHECK_DATA
    3564   00:535A  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3564   00:535D  CB 47             >     bit 0,a
    3565   00:535F  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST3.1
    3566   00:5361  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3567   00:5364  18 F4                   jr  TCPIP_UDP_STATE_RESP_ST3
    3568   00:5366                      TCPIP_UDP_STATE_RESP_ST3.1:
    3569   00:5366                          ; nz, get it
    3570   00:5366                          RECEIVE_DATA
    3570   00:5366  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3571   00:5369  47                      ld  b,a
    3572   00:536A                      TCPIP_UDP_STATE_RESP_ST4:
    3573   00:536A                          CHECK_DATA
    3573   00:536A  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3573   00:536D  CB 47             >     bit 0,a
    3574   00:536F  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST4.1
    3575   00:5371  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3576   00:5374  18 F4                   jr  TCPIP_UDP_STATE_RESP_ST4
    3577   00:5376                      TCPIP_UDP_STATE_RESP_ST4.1:
    3578   00:5376                          ; nz, get it
    3579   00:5376                          RECEIVE_DATA
    3579   00:5376  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3580   00:5379  5F                      ld  e,a
    3581   00:537A                      TCPIP_UDP_STATE_RESP_ST5:
    3582   00:537A                          CHECK_DATA
    3582   00:537A  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3582   00:537D  CB 47             >     bit 0,a
    3583   00:537F  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST5.1
    3584   00:5381  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3585   00:5384  18 F4                   jr  TCPIP_UDP_STATE_RESP_ST5
    3586   00:5386                      TCPIP_UDP_STATE_RESP_ST5.1:
    3587   00:5386                          ; nz, get it
    3588   00:5386                          RECEIVE_DATA
    3588   00:5386  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3589   00:5389  57                      ld  d,a
    3590   00:538A                          ; done
    3591   00:538A  AF                      xor a
    3592   00:538B  C9                      ret
