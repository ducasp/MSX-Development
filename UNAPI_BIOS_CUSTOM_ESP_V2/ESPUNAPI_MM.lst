    1046   00:4514                          ; It was zero
    1047   00:4514  3E 0A                   ld  a,10                        ; So, 10
    1048   00:4516  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1049   00:4519  DD 77 01                ld  (ix+1),a                    ; Save
    1050   00:451C  79                      ld  a,c
    1051   00:451D  CD A2 00                call    CHPUT                   ; Print it
    1052   00:4520  18 1D                   jr  CLK_AUTO_GMT_CHK_DONE       ; Ready to
    1053   00:4522                      CLK_AUTO_GMT_CHK_CSD1:
