    1652   00:493D  FE 1B                   cp  #1b                         ; ESC?
    1653   00:493F  CA 66 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1654   00:4942  FE 4F                   cp  'O'                         ; Toggle Nagle Off
    1655   00:4944  CA 92 49                jp  z,SET_NAGLE_OFF             ;
    1656   00:4947  FE 6F                   cp  'o'                         ; Toggle Nagle Off
    1657   00:4949  CA 92 49                jp  z,SET_NAGLE_OFF             ;
    1658   00:494C  CD C0 00                call    BEEP                    ; Wrong Input, beep
