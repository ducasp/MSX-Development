    5780   00:5E8D                      ;=== SSH_AUTH_GET_CHALLENGE ===
    5781   00:5E8D                      ;==============================
    5782   00:5E8D                      ;Receive keyboard interactive challenge data from a SSH connection.
    5783   00:5E8D                      ;
    5784   00:5E8D                      ;Input:   A  = 9
    5785   00:5E8D                      ;         B  = Connection number
    5786   00:5E8D                      ;         DE = Address for the retrieved data
    5787   00:5E8D                      ;         HL = Max Length of the data to be obtained
    5788   00:5E8D                      ;Output:  A  = Error code
    5789   00:5E8D                      ;         BC = Total number of bytes that have been actually retrieved
    5790   00:5E8D                      ;         H  = Number of prompts
    5791   00:5E8D                      ;         L  = Echo flag bitmap
    5792   00:5E8D                      ; Save registers other than AF
