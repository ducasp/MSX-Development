    4619   00:5871  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4620   00:5874  B7                      or  a                           ; 0?
    4621   00:5875  C0                      ret nz                          ; if not, done
    4622   00:5876                      
    4623   00:5876                          ; next two bytes are size bytes, don't care, it is fixed as 3 if ok
    4624   00:5876  06 02                   ld  b,2
    4625   00:5878                      SSH_STATE_ST2:
    4626   00:5878                          CHECK_DATA
    4626   00:5878  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    4626   00:587B  CB 47             >     bit 0,a
    4627   00:587D  20 05                   jr  nz,SSH_STATE_ST2.1
    4628   00:587F  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4629   00:5882  18 F4                   jr  SSH_STATE_ST2
    4630   00:5884                      SSH_STATE_ST2.1:
    4631   00:5884                          ; nz, discard
    4632   00:5884                          RECEIVE_DATA
    4632   00:5884  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4633   00:5887  05                      dec b
    4634   00:5888  20 EE                   jr  nz,SSH_STATE_ST2
    4635   00:588A                      
    4636   00:588A                          ; now we have three bytes to get, first go to B and second to L and third to H
    4637   00:588A                      SSH_STATE_REG_B:
    4638   00:588A                          CHECK_DATA
    4638   00:588A  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    4638   00:588D  CB 47             >     bit 0,a
    4639   00:588F  20 05                   jr  nz,SSH_STATE_REG_B.1
