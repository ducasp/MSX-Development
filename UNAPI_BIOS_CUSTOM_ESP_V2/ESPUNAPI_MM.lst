    5519   00:5D53                      ;=============================
    5520   00:5D53                      ;===  TCPIP_CONFIG_AUTOIP  ===
    5521   00:5D53                      ;=============================
    5522   00:5D53                      ;Enable or disable the automatic IP addresses retrieval.
    5523   00:5D53                      ;
    5524   00:5D53                      ;Input:  A = 25
    5525   00:5D53                      ;        B = 0: Get current configuration
    5526   00:5D53                      ;            1: Set configuration
    5527   00:5D53                      ;        C = Configuration to set (only if B=1):
    5528   00:5D53                      ;            bit 0: Set to automatically retrieve
    5529   00:5D53                      ;                   local IP address, subnet mask and default gateway
    5530   00:5D53                      ;            bit 1: Set to automatically retrieve DNS servers addresses
    5531   00:5D53                      ;            bits 2-7: Unused, must be zero
    5532   00:5D53                      ;Output: A = Error code
    5533   00:5D53                      ;        C = Configuration after the routine execution
    5534   00:5D53                      ;            (same format as C at input)
    5535   00:5D53                      TCPIP_CONFIG_AUTOIP:
    5536   00:5D53                          SEND_DATA                       ; Send the command
    5536   00:5D53  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5537   00:5D56  AF                      xor a
    5538   00:5D57                          SEND_DATA                       ; Send the command size msb
    5538   00:5D57  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5539   00:5D5A  3E 02                   ld  a,2
    5540   00:5D5C                          SEND_DATA                       ; Send the command size lsb
    5540   00:5D5C  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5541   00:5D5F  78                      ld  a,b
    5542   00:5D60                          SEND_DATA                       ; Send the command
    5542   00:5D60  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5543   00:5D63  79                      ld  a,c
    5544   00:5D64                          SEND_DATA                       ; Send the command parameter
    5544   00:5D64  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5545   00:5D67                      
    5546   00:5D67                          ; Now wait up to 180 ticks to get response
    5547   00:5D67  21 B4 00                ld hl,180
    5548   00:5D6A  CD C2 5E                call    SETCOUNTER
    5549   00:5D6D                      TCPIP_CONFIG_AUTOIP_ST1:
    5550   00:5D6D                          CHECK_DATA
    5550   00:5D6D  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5550   00:5D70  CB 47             >     bit 0,a
    5551   00:5D72  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_ST1.1
    5552   00:5D74  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5553   00:5D77  18 F4                   jr  TCPIP_CONFIG_AUTOIP_ST1
