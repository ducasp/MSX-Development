    1733   00:49F5                          SEND_DATA
    1733   00:49F5  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1734   00:49F8  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1735   00:49FB  CD 38 4B                call    WAIT_MENU_QCMD_RESPONSE
    1736   00:49FE  CA 2F 4B                jp  z,MENU_BAD_END
    1737   00:4A01  21 7D 70                ld  hl,STR_SENDING_OK           ; Success
    1738   00:4A04  CD 9D 4C                call    PRINTHL
    1739   00:4A07  C3 0E 4A                jp  WAIT_2S_AND_THEN_MAINMENU
    1740   00:4A0A                      
    1741   00:4A0A                      WAIT_4S_AND_THEN_MAINMENU:
    1742   00:4A0A  3E F0                   ld  a,240                       ; Wait 4 seconds with message on screen
    1743   00:4A0C  18 02                   jr  WAIT_AND_THEN_MAINMENU
    1744   00:4A0E                      WAIT_2S_AND_THEN_MAINMENU:
    1745   00:4A0E  3E 78                   ld  a,120                       ; Wait 2 seconds with message on screen
    1746   00:4A10                      WAIT_AND_THEN_MAINMENU:
    1747   00:4A10  CD 18 4A                call    WAIT_BEFORE_CONTINUING
    1748   00:4A13  C3 5E 42                jp  ESPSETUP                    ; When done, back to main setup
    1749   00:4A16                      WAIT_250MS_AND_THEN_CONTINUE:
    1750   00:4A16  3E 0F                   ld  a,15                        ; Wait 250 ms then continue
    1751   00:4A18                      WAIT_BEFORE_CONTINUING:
    1752   00:4A18  76                      halt
    1753   00:4A19  3D                      dec a
    1754   00:4A1A                          ; If not zero, our time out has not elapsed
    1755   00:4A1A  20 FC                   jr  nz,WAIT_BEFORE_CONTINUING
    1756   00:4A1C  C9                      ret                             ; Time out and continue
    1757   00:4A1D                      
    1758   00:4A1D                      ; Check Auto Clock
    1759   00:4A1D                      ISCLKAUTO:
    1760   00:4A1D                          CLEAR_UART
    1760   00:4A1D  3E 14             >     ld  a,20
    1760   00:4A1F  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    1761   00:4A22  3E 63                   ld  a,CMD_QUERY_ACLK_SETTINGS
    1762   00:4A24                          SEND_DATA
    1762   00:4A24  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1763   00:4A27  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1764   00:4A2A  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1765   00:4A2E  DD 6B                   ld  ixl,e
    1766   00:4A30  DD 62                   ld  ixh,d                       ; address in IX
    1767   00:4A32  CD 75 4B                call    WAIT_MENU_CMD_RESPONSE
    1768   00:4A35  CA 2E 4B                jp  z,MENU_SUB_BAD_END
    1769   00:4A38                          ; Response received, IX+0 and IX+1 has Auto Clock and GMT, A
    1770   00:4A38  C9                      ret
    1771   00:4A39                      
    1772   00:4A39                      ; Check what is the current NAGLE setting
    1773   00:4A39                      CHECKNAGLE:
    1774   00:4A39                          CLEAR_UART
    1774   00:4A39  3E 14             >     ld  a,20
    1774   00:4A3B  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    1775   00:4A3E  3E 51                   ld  a,CMD_QUERY_ESP_SETTINGS
    1776   00:4A40                          SEND_DATA
    1776   00:4A40  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1777   00:4A43  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1778   00:4A46  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1779   00:4A4A  DD 6B                   ld  ixl,e
    1780   00:4A4C  DD 62                   ld  ixh,d                       ; Address in IX
    1781   00:4A4E  CD 75 4B                call    WAIT_MENU_CMD_RESPONSE
    1782   00:4A51  CA 2E 4B                jp  z,MENU_SUB_BAD_END
    1783   00:4A54                          ; Response received, nagle is the first one, ON: or OFF:
    1784   00:4A54  3E 4F                   ld  a,'O'
    1785   00:4A56  DD BE 00                cp  (ix+0)
    1786   00:4A59  C2 2E 4B                jp  nz,MENU_SUB_BAD_END
    1787   00:4A5C  3E 4E                   ld  a,'N'
    1788   00:4A5E  DD BE 01                cp  (ix+1)
    1789   00:4A61  C2 6E 4A                jp  nz,CHECK_NAGLE_OFF
    1790   00:4A64  3E 3A                   ld  a,':'
    1791   00:4A66  DD BE 02                cp  (ix+2)
    1792   00:4A69  C2 2E 4B                jp  nz,MENU_SUB_BAD_END
    1793   00:4A6C  B7                      or  a                           ; It will make it NZ
    1794   00:4A6D  C9                      ret
    1795   00:4A6E                      CHECK_NAGLE_OFF:
    1796   00:4A6E  3E 46                   ld  a,'F'
    1797   00:4A70  DD BE 01                cp  (ix+1)
    1798   00:4A73  C2 2E 4B                jp  nz,MENU_SUB_BAD_END
    1799   00:4A76  3E 46                   ld  a,'F'
    1800   00:4A78  DD BE 02                cp  (ix+2)
    1801   00:4A7B  C2 2E 4B                jp  nz,MENU_SUB_BAD_END
    1802   00:4A7E  3E 3A                   ld  a,':'
    1803   00:4A80  DD BE 03                cp  (ix+3)
    1804   00:4A83  C2 2E 4B                jp  nz,MENU_SUB_BAD_END
    1805   00:4A86                          ; Already has zero, so just ret
    1806   00:4A86  C9                      ret
    1807   00:4A87                      
    1808   00:4A87                      ; Check what is the current TIMEOUT setting, return 0 if always on, otherwise there is a timeout
    1809   00:4A87                      ; Will return a zero terminated string @ HL that can be printed
    1810   00:4A87                      ; Will return the value in DE
    1811   00:4A87                      CHECKTIMEOUT:
    1812   00:4A87                          CLEAR_UART
    1812   00:4A87  3E 14             >     ld  a,20
    1812   00:4A89  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    1813   00:4A8C  3E 51                   ld  a,CMD_QUERY_ESP_SETTINGS
    1814   00:4A8E                          SEND_DATA
    1814   00:4A8E  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1815   00:4A91  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1816   00:4A94  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1817   00:4A98  DD 6B                   ld  ixl,e
    1818   00:4A9A  DD 62                   ld  ixh,d                       ; Address in IX
    1819   00:4A9C  CD 75 4B                call    WAIT_MENU_CMD_RESPONSE
    1820   00:4A9F  CA 2E 4B                jp  z,MENU_SUB_BAD_END
    1821   00:4AA2                          ; Response received, nagle is the first one, ON: or OFF:
    1822   00:4AA2  3E 3A                   ld  a,':'
    1823   00:4AA4  DD 23                   inc ix
    1824   00:4AA6  DD 23                   inc ix                          ; Nagle response is two or three bytes long, let's check
    1825   00:4AA8  0B                      dec bc
    1826   00:4AA9  0B                      dec bc                          ; Remaining bytes
    1827   00:4AAA  DD BE 00                cp  (ix+0)
    1828   00:4AAD  CA B9 4A                jp  z,CHECKTIMEOUT.1
    1829   00:4AB0  DD 23                   inc ix
    1830   00:4AB2  0B                      dec bc                          ; Remaining bytes
    1831   00:4AB3  DD BE 00                cp  (ix+0)
    1832   00:4AB6  C2 2E 4B                jp  nz,MENU_SUB_BAD_END         ; If not here, sorry to say it is an error
    1833   00:4AB9                      CHECKTIMEOUT.1:
    1834   00:4AB9  78                      ld  a,b
    1835   00:4ABA  B1                      or  c                           ; All data read?
    1836   00:4ABB  CA 2E 4B                jp  z,MENU_SUB_BAD_END          ; If so, sorry to say it is an error
    1837   00:4ABE  DD 23                   inc ix                          ; At the first digit
    1838   00:4AC0  0B                      dec bc                          ; Remaining bytes
    1839   00:4AC1  78                      ld  a,b
    1840   00:4AC2  B1                      or  c                           ; All data read?
    1841   00:4AC3  CA 2E 4B                jp  z,MENU_SUB_BAD_END          ; If so, sorry to say it is an error
    1842   00:4AC6  DD E5                   push    ix                      ; This is the start of the string, save it
    1843   00:4AC8  26 00                   ld  h,0                         ; No digit so far
    1844   00:4ACA                          ; It can have up to three digits
    1845   00:4ACA                      CHECKTIMEOUT.2:
    1846   00:4ACA  3E 3A                   ld  a,':'
    1847   00:4ACC  DD BE 00                cp  (ix+0)                      ; Check if it is the separator
    1848   00:4ACF  CA F0 4A                jp  z,CHECKTIMEOUT.3            ; If it is routine will follow through
    1849   00:4AD2  DD 7E 00                ld  a,(ix+0)                    ; Get the supposed digit in A
    1850   00:4AD5  2E 3A                   ld  l,'9'+1
    1851   00:4AD7  BD                      cp  l
    1852   00:4AD8  D2 2D 4B                jp  nc,MENU_SUB_BAD_END_1S      ; If more than '9', sorry to say it is an error
    1853   00:4ADB  2E 30                   ld  l,'0'
    1854   00:4ADD  BD                      cp  l
    1855   00:4ADE  DA 2D 4B                jp  c,MENU_SUB_BAD_END_1S       ; If less than '0', sorry to say it is an error
    1856   00:4AE1  24                      inc h                           ; It is not, so it is a digit
    1857   00:4AE2  3E 03                   ld  a,3
    1858   00:4AE4  BC                      cp  h
    1859   00:4AE5  DA 2D 4B                jp  c,MENU_SUB_BAD_END_1S       ; If more than three digits, sorry to say it is an error
    1860   00:4AE8  DD 23                   inc ix                          ; Increase pointer
    1861   00:4AEA  0B                      dec bc                          ; Decrease remaining
    1862   00:4AEB  78                      ld  a,b
    1863   00:4AEC  B1                      or  c                           ; All data read?
    1864   00:4AED  C2 CA 4A                jp  nz,CHECKTIMEOUT.2           ; Not, so rinse and repeat
    1865   00:4AF0                      CHECKTIMEOUT.3:
    1866   00:4AF0  DD 36 00 00             ld  (ix+0),0                    ; Null terminate string value
    1867   00:4AF4  DD 2B                   dec ix
    1868   00:4AF6  DD 7E 00                ld  a,(ix+0)                    ; 1st Digit in A
    1869   00:4AF9  D6 30                   sub '0'                         ; Convert it to decimal value
    1870   00:4AFB  5F                      ld  e,a
    1871   00:4AFC  16 00                   ld  d,0                         ; DE has first digit
    1872   00:4AFE  25                      dec h                           ; Decrement digit counter
    1873   00:4AFF  28 28                   jr  z,CHECKTIMEOUT.END          ; If all digits, done
    1874   00:4B01                          ; Now second digit, multiply it by 10 and add to E, even if 90 + 9, still fits E
    1875   00:4B01  DD 2B                   dec ix
    1876   00:4B03  DD 7E 00                ld  a,(ix+0)                    ; 2nd Digit
    1877   00:4B06  D6 30                   sub '0'                         ; Convert it to decimal value
    1878   00:4B08  87                      add a,a                         ; A has *2
    1879   00:4B09  4F                      ld  c,a                         ; C has *2
    1880   00:4B0A  87                      add a,a                         ; A has *4
    1881   00:4B0B  87                      add a,a                         ; A has *8
    1882   00:4B0C  81                      add a,c                         ; A has *10
    1883   00:4B0D  83                      add a,e                         ; A has two digits result
    1884   00:4B0E  5F                      ld  e,a                         ; Back to E, DE has two digits results
    1885   00:4B0F  25                      dec h                           ; Decrement digit counter
    1886   00:4B10  28 17                   jr  z,CHECKTIMEOUT.END          ; If all digits, done
    1887   00:4B12                          ; Now Third digit, multiply it by 100 and add to DE
    1888   00:4B12  DD 2B                   dec ix
    1889   00:4B14  DD 7E 00                ld  a,(ix+0)                    ; 3rd Digit
    1890   00:4B17  D6 30                   sub '0'                         ; Convert it to decimal value
    1891   00:4B19  87                      add a,a                         ; A has *2
    1892   00:4B1A  4F                      ld  c,a                         ; C has *2
    1893   00:4B1B  87                      add a,a                         ; A has *4
    1894   00:4B1C  87                      add a,a                         ; A has *8
    1895   00:4B1D  81                      add a,c                         ; A has *10
    1896   00:4B1E  26 00                   ld  h,0
    1897   00:4B20  6F                      ld  l,a                         ; HL has *10
    1898   00:4B21  29                      add hl,hl                       ; HL has *20
    1899   00:4B22  44                      ld  b,h
    1900   00:4B23  4D                      ld  c,l                         ; BC has *20
    1901   00:4B24  29                      add hl,hl                       ; HL has *40
    1902   00:4B25  29                      add hl,hl                       ; HL has *80
    1903   00:4B26  09                      add hl,bc                       ; HL has *100
    1904   00:4B27  19                      add hl,de                       ; HL has three digit value
    1905   00:4B28  EB                      ex  de,hl                       ; now in DE
    1906   00:4B29                      CHECKTIMEOUT.END:
    1907   00:4B29  E1                      pop hl                          ; Restore address of string version of time count
    1908   00:4B2A  7A                      ld  a,d
    1909   00:4B2B  B3                      or  e                           ; Set zero flag according to the time out set
    1910   00:4B2C  C9                      ret
    1911   00:4B2D                      
    1912   00:4B2D                      MENU_SUB_BAD_END_1S:
    1913   00:4B2D  F1                      pop af                          ; 1 register was stacked, pop it
    1914   00:4B2E                      MENU_SUB_BAD_END:
    1915   00:4B2E  F1                      pop af                          ; It was a sub, so clear stack
    1916   00:4B2F                      MENU_BAD_END:
    1917   00:4B2F  21 FA 70                ld  hl,STR_SENDING_FAIL         ; error message
    1918   00:4B32  CD 9D 4C                call    PRINTHL
    1919   00:4B35  C3 0E 4A                jp  WAIT_2S_AND_THEN_MAINMENU
    1920   00:4B38                      
    1921   00:4B38                      ; WAIT an ESP quick command Response
    1922   00:4B38                      ; Inputs:
    1923   00:4B38                      ; A -> Command Code
    1924   00:4B38                      ; HL -> Timeout
    1925   00:4B38                      ;
    1926   00:4B38                      ; Returns:
    1927   00:4B38                      ; Flag Z is zero if failure, non zero if success
    1928   00:4B38                      ;
    1929   00:4B38                      ; Affect:
    1930   00:4B38                      ; AF and HL
    1931   00:4B38                      ;
    1932   00:4B38                      WAIT_MENU_QCMD_RESPONSE:
    1933   00:4B38  D5                      push    de
    1934   00:4B39  57                      ld  d,a                         ; Command to wait in D
    1935   00:4B3A                      WAIT_MENU_QCMD_RESPONSE_ST1:
    1936   00:4B3A                          LOAD_STS_PORT_IN_A
    1936   00:4B3A  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    1937   00:4B3D  CB 6F                   bit 5,a                         ; If nz Port #07 is not available
    1938   00:4B3F  C2 6F 4B                jp  nz,WAIT_MENU_QCMD_RESPONSE_END_NOK
    1939   00:4B42  CB 47                   bit 0,a                         ; If nz has data
    1940   00:4B44  20 08                   jr  nz,WAIT_MENU_QCMD_RESPONSE_ST1.1
    1941   00:4B46  CD 97 4C                call    HLTIMEOUT
    1942   00:4B49  20 EF                   jr  nz,WAIT_MENU_QCMD_RESPONSE_ST1
    1943   00:4B4B  C3 6D 4B                jp  WAIT_MENU_QCMD_RESPONSE_END ; If time out waiting, return
    1944   00:4B4E                      WAIT_MENU_QCMD_RESPONSE_ST1.1:
    1945   00:4B4E                          ; nz, check the data
    1946   00:4B4E                          RECEIVE_DATA
    1946   00:4B4E  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    1947   00:4B51  BA                      cp  d                           ; Is response of our command?
    1948   00:4B52  20 E6                   jr  nz,WAIT_MENU_QCMD_RESPONSE_ST1
    1949   00:4B54                          ; Now get return code, if return code other than 0, it is failure, otherwise success
    1950   00:4B54                      WAIT_MENU_QCMD_RESPONSE_RC:
    1951   00:4B54                          CHECK_DATA
    1951   00:4B54  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    1951   00:4B57  CB 47             >     bit 0,a
    1952   00:4B59  20 08                   jr  nz,WAIT_MENU_QCMD_RESPONSE_RC.1
    1953   00:4B5B  CD 97 4C                call    HLTIMEOUT
    1954   00:4B5E  20 F4                   jr  nz,WAIT_MENU_QCMD_RESPONSE_RC
    1955   00:4B60  C3 6D 4B                jp  WAIT_MENU_QCMD_RESPONSE_END ; If time-out waiting, return
    1956   00:4B63                      WAIT_MENU_QCMD_RESPONSE_RC.1:
    1957   00:4B63                          RECEIVE_DATA
    1957   00:4B63  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    1958   00:4B66  B7                      or  a                           ; 0?
    1959   00:4B67                          ; If not, done
    1960   00:4B67  C2 6F 4B                jp  nz,WAIT_MENU_QCMD_RESPONSE_END_NOK
    1961   00:4B6A                      WAIT_MENU_QCMD_RESPONSE_END_OK:
    1962   00:4B6A  3E 01                   ld  a,1
    1963   00:4B6C  B7                      or  a                           ; NZ to indicate success
    1964   00:4B6D                      WAIT_MENU_QCMD_RESPONSE_END:
