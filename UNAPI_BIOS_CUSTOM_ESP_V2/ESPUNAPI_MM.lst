    4671   00:58BC                      ;=========================
    4672   00:58BC                      ;===   SSH_TERM_TYPE   ===
    4673   00:58BC                      ;=========================
    4674   00:58BC                      ;Get or set the terminal type requested on PTY connection.
    4675   00:58BC                      ;
    4676   00:58BC                      ;Input:  A = 7
    4677   00:58BC                      ;        C = Operation ( 0 - Get / 1 - Set)
    4678   00:58BC                      ;        D = Terminal Type when Set
    4679   00:58BC                      ;Output: A = Error code
    4680   00:58BC                      ;        D = Terminal Type (when Get)
    4681   00:58BC                      SSH_TERM_TYPE:
    4682   00:58BC  CB FF                   set 7,a                         ; ESP SSH commands start at #80
    4683   00:58BE                          SEND_DATA                       ; Send the command
    4683   00:58BE  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4684   00:58C1  AF                      xor a
    4685   00:58C2                          SEND_DATA                       ; Send the command size msb
    4685   00:58C2  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4686   00:58C5  79                      ld  a,c
    4687   00:58C6  CD 60 61                call    SETBYTE                 ; Save operation
    4688   00:58C9  B7                      or  a
    4689   00:58CA  20 0B                   jr  nz,SSH_TERM_TYPE_SET
    4690   00:58CC  3E 01                   ld  a,1                         ; Get sends 1 byte
    4691   00:58CE                          SEND_DATA                       ; Send the command size lsb
    4691   00:58CE  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4692   00:58D1  79                      ld  a,c
    4693   00:58D2                          SEND_DATA                       ; Send the operation
    4693   00:58D2  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4694   00:58D5  18 0D                   jr  SSH_TERM_TYPE_ST0
    4695   00:58D7                      SSH_TERM_TYPE_SET:
    4696   00:58D7  3E 02                   ld  a,2                         ; Set sends 2 bytes
    4697   00:58D9                          SEND_DATA                       ; Send the command size lsb
    4697   00:58D9  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4698   00:58DC  79                      ld  a,c
    4699   00:58DD                          SEND_DATA                       ; Send the operation
    4699   00:58DD  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4700   00:58E0  7A                      ld  a,d
    4701   00:58E1                          SEND_DATA                       ; Send the Terminal Type to set
    4701   00:58E1  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4702   00:58E4                      SSH_TERM_TYPE_ST0:
