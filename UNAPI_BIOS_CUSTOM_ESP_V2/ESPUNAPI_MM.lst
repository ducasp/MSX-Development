    2710   00:4EFE                      ;=========================
    2711   00:4EFE                      ;===  TCPIP_GET_CAPAB  ===
    2712   00:4EFE                      ;=========================
    2713   00:4EFE                      ; Get information about the TCP/IP capabilities and features.
    2714   00:4EFE                      ;
    2715   00:4EFE                      ;    Input:  A = 1
    2716   00:4EFE                      ;            B = Index of information block to retrieve:
    2717   00:4EFE                      ;                1: Capabilities and features flags, link level protocol
    2718   00:4EFE                      ;                2: Connection pool size and status
    2719   00:4EFE                      ;                3: Maximum datagram size allowed
    2720   00:4EFE                      ;                4: Second set of capabilities and features flags
    2721   00:4EFE                      ;    Output: A = Error code
    2722   00:4EFE                      ;        When information block 1 requested:
    2723   00:4EFE                      ;            HL = Capabilities flags
    2724   00:4EFE                      ;            DE = Features flags
    2725   00:4EFE                      ;            B  = Link level protocol used
    2726   00:4EFE                      ;        When information block 2 requested:
    2727   00:4EFE                      ;            B = Maximum simultaneous TCP connections supported
    2728   00:4EFE                      ;            C = Maximum simultaneous UDP connections supported
    2729   00:4EFE                      ;            D = Free TCP connections currently available
    2730   00:4EFE                      ;            E = Free UDP connections currently available
    2731   00:4EFE                      ;            H = Maximum simultaneous raw IP connections supported
    2732   00:4EFE                      ;            L = Free raw IP connections currently available
    2733   00:4EFE                      ;        When information block 3 requested:
    2734   00:4EFE                      ;            HL = Maximum incoming datagram size supported
    2735   00:4EFE                      ;            DE = Maximum outgoing datagram size supported
    2736   00:4EFE                      ;        When information block 4 requested:
    2737   00:4EFE                      ;            HL = Second set of capabilities flags
    2738   00:4EFE                      ;            DE = Second set of features flags (currently unused, always zero)
    2739   00:4EFE                      TCPIP_GET_CAPAB:
    2740   00:4EFE                          SEND_DATA                       ; Send the command
    2740   00:4EFE  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2741   00:4F01  AF                      xor a
    2742   00:4F02                          SEND_DATA                       ; Send the command size msb
    2742   00:4F02  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2743   00:4F05  3C                      inc a
    2744   00:4F06                          SEND_DATA                       ; Send the command size lsb
    2744   00:4F06  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2745   00:4F09  78                      ld  a,b
    2746   00:4F0A  CD 58 61                call    SETBYTE                 ; Save it, we are going to need it later
    2747   00:4F0D                          SEND_DATA                       ; Send the parameter
    2747   00:4F0D  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2748   00:4F10                      
    2749   00:4F10                          ; Now wait up to 120 ticks to get response
    2750   00:4F10  21 78 00                ld  hl,120
    2751   00:4F13  CD 36 61                call    SETCOUNTER
    2752   00:4F16                      TCPIP_GET_CAPAB_ST1:
    2753   00:4F16                          CHECK_DATA
    2753   00:4F16  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2753   00:4F19  CB 47             >     bit 0,a
    2754   00:4F1B  20 05                   jr  nz,TCPIP_GET_CAPAB_ST1.1
    2755   00:4F1D  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2756   00:4F20  18 F4                   jr  TCPIP_GET_CAPAB_ST1
    2757   00:4F22                      TCPIP_GET_CAPAB_ST1.1:
    2758   00:4F22                          ; nz, check the data
    2759   00:4F22                          RECEIVE_DATA
    2759   00:4F22  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2760   00:4F25  FE 01                   cp  1                           ; Is response of our command?
    2761   00:4F27  20 ED                   jr  nz,TCPIP_GET_CAPAB_ST1
    2762   00:4F29                          ; Now get return code, if return code other than 0, it is finished
    2763   00:4F29                      TCPIP_GET_CAPAB_RC:
    2764   00:4F29                          CHECK_DATA
    2764   00:4F29  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2764   00:4F2C  CB 47             >     bit 0,a
    2765   00:4F2E  20 05                   jr  nz,TCPIP_GET_CAPAB_RC.1
    2766   00:4F30  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2767   00:4F33  18 F4                   jr  TCPIP_GET_CAPAB_RC
    2768   00:4F35                      TCPIP_GET_CAPAB_RC.1:
    2769   00:4F35                          ; nz, discard
    2770   00:4F35                          RECEIVE_DATA
    2770   00:4F35  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2771   00:4F38  B7                      or  a                           ; 0?
    2772   00:4F39  C0                      ret nz                          ; If not, done
    2773   00:4F3A                      
    2774   00:4F3A                          ; Next two bytes are return code and size bytes, don't care
    2775   00:4F3A  06 02                   ld  b,2
    2776   00:4F3C                      TCPIP_GET_CAPAB_ST2:
    2777   00:4F3C                          CHECK_DATA
    2777   00:4F3C  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2777   00:4F3F  CB 47             >     bit 0,a
    2778   00:4F41  20 05                   jr  nz,TCPIP_GET_CAPAB_ST2.1
    2779   00:4F43  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2780   00:4F46  18 F4                   jr  TCPIP_GET_CAPAB_ST2
    2781   00:4F48                      TCPIP_GET_CAPAB_ST2.1:
    2782   00:4F48                          ; Nz, discard
    2783   00:4F48                          RECEIVE_DATA
    2783   00:4F48  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2784   00:4F4B  05                      dec b
    2785   00:4F4C  20 EE                   jr  nz,TCPIP_GET_CAPAB_ST2
    2786   00:4F4E                      
    2787   00:4F4E                          ; Now check if block 1, 2 or 3
    2788   00:4F4E  CD 46 61                call    GETBYTE                 ; Get the parameter we saved at the start
    2789   00:4F51  3D                      dec a
    2790   00:4F52  CA 04 50                jp  z,TCPIP_GET_CAPAB_BLK1      ; 1
    2791   00:4F55  3D                      dec a
    2792   00:4F56  CA A2 4F                jp  z,TCPIP_GET_CAPAB_BLK2      ; 2
    2793   00:4F59  3D                      dec a
    2794   00:4F5A  CA 60 4F                jp  z,TCPIP_GET_CAPAB_BLK3      ; 3
    2795   00:4F5D                          ; Else, only block four, same as block 1
    2796   00:4F5D  C3 04 50                jp  TCPIP_GET_CAPAB_BLK1        ; 1
    2797   00:4F60                          ; Block 3 Handling, we will receive L, H, E and D
    2798   00:4F60                      TCPIP_GET_CAPAB_BLK3:
    2799   00:4F60                      TCPIP_GET_CAPAB_BLK3_ST1:
    2800   00:4F60                          CHECK_DATA
