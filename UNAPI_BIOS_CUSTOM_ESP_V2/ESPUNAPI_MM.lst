    5303   00:5C3D                      ;===  TCPIP_TCP_STATE  ===
    5304   00:5C3D                      ;=========================
    5305   00:5C3D                      ;Get the state of a TCP connection.
    5306   00:5C3D                      ;
    5307   00:5C3D                      ;Input:  A = 16
    5308   00:5C3D                      ;        B = Connection number
