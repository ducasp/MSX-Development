    5838   00:5EE0  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5839   00:5EE3  FE 89                   cp #89                          ; Is response of our command?
    5840   00:5EE5  20 ED                   jr  nz,SSH_AUTH_GET_CHALLENGE_ST1
    5841   00:5EE7                          ; At this point, all data is being buffered, so 15 ticks, quarter second, is more than enough time-out
    5842   00:5EE7  F3                      di
    5843   00:5EE8  21 1E 00                ld  hl,30
    5844   00:5EEB  CD 3E 61                call    SETCOUNTER
    5845   00:5EEE  FB                      ei
    5846   00:5EEF                          ; now get return code, if return code other than 0, it is finished
    5847   00:5EEF                      SSH_AUTH_GET_CHALLENGE_RC:
    5848   00:5EEF                          CHECK_DATA
