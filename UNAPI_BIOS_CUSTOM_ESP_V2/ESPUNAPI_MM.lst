    5272   00:5C09                    ~     endif
    5273   00:5C09  4D                      ld  c,l
    5274   00:5C0A  44                      ld  b,h                         ; BC has effective received data size, as well as HL
    5275   00:5C0B                      
    5276   00:5C0B                          ; now just discard 2 bytes urgent data
    5277   00:5C0B                      TCPIP_TCP_RCV_UDC_ST1:
    5278   00:5C0B                          CHECK_DATA
    5278   00:5C0B  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
