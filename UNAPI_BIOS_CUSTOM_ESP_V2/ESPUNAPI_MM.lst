    2462   00:4DE2  C7 5F               FN_25:                  dw  TCPIP_CONFIG_AUTOIP
    2463   00:4DE4  2B 60               FN_26:                  dw  TCPIP_CONFIG_IP
    2464   00:4DE6  74 60               FN_27:                  dw  TCPIP_CONFIG_TTL
