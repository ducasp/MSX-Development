    1764   00:4A32                      ; Check what is the current NAGLE setting
    1765   00:4A32                      CHECKNAGLE:
    1766   00:4A32                          CLEAR_UART
    1766   00:4A32  3E 14             >     ld  a,20
    1766   00:4A34  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    1767   00:4A37  3E 51                   ld  a,CMD_QUERY_ESP_SETTINGS
    1768   00:4A39                          SEND_DATA
    1768   00:4A39  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1769   00:4A3C  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1770   00:4A3F  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1771   00:4A43  DD 6B                   ld  ixl,e
    1772   00:4A45  DD 62                   ld  ixh,d                       ; Address in IX
    1773   00:4A47  CD 6E 4B                call    WAIT_MENU_CMD_RESPONSE
    1774   00:4A4A  CA 27 4B                jp  z,MENU_SUB_BAD_END
    1775   00:4A4D                          ; Response received, nagle is the first one, ON: or OFF:
    1776   00:4A4D  3E 4F                   ld  a,'O'
    1777   00:4A4F  DD BE 00                cp  (ix+0)
    1778   00:4A52  C2 27 4B                jp  nz,MENU_SUB_BAD_END
    1779   00:4A55  3E 4E                   ld  a,'N'
    1780   00:4A57  DD BE 01                cp  (ix+1)
    1781   00:4A5A  C2 67 4A                jp  nz,CHECK_NAGLE_OFF
    1782   00:4A5D  3E 3A                   ld  a,':'
    1783   00:4A5F  DD BE 02                cp  (ix+2)
    1784   00:4A62  C2 27 4B                jp  nz,MENU_SUB_BAD_END
    1785   00:4A65  B7                      or  a                           ; It will make it NZ
    1786   00:4A66  C9                      ret
    1787   00:4A67                      CHECK_NAGLE_OFF:
    1788   00:4A67  3E 46                   ld  a,'F'
    1789   00:4A69  DD BE 01                cp  (ix+1)
    1790   00:4A6C  C2 27 4B                jp  nz,MENU_SUB_BAD_END
    1791   00:4A6F  3E 46                   ld  a,'F'
    1792   00:4A71  DD BE 02                cp  (ix+2)
    1793   00:4A74  C2 27 4B                jp  nz,MENU_SUB_BAD_END
    1794   00:4A77  3E 3A                   ld  a,':'
    1795   00:4A79  DD BE 03                cp  (ix+3)
    1796   00:4A7C  C2 27 4B                jp  nz,MENU_SUB_BAD_END
    1797   00:4A7F                          ; Already has zero, so just ret
    1798   00:4A7F  C9                      ret
    1799   00:4A80                      
    1800   00:4A80                      ; Check what is the current TIMEOUT setting, return 0 if always on, otherwise there is a timeout
    1801   00:4A80                      ; Will return a zero terminated string @ HL that can be printed
    1802   00:4A80                      ; Will return the value in DE
    1803   00:4A80                      CHECKTIMEOUT:
    1804   00:4A80                          CLEAR_UART
    1804   00:4A80  3E 14             >     ld  a,20
    1804   00:4A82  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    1805   00:4A85  3E 51                   ld  a,CMD_QUERY_ESP_SETTINGS
    1806   00:4A87                          SEND_DATA
    1806   00:4A87  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1807   00:4A8A  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1808   00:4A8D  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1809   00:4A91  DD 6B                   ld  ixl,e
    1810   00:4A93  DD 62                   ld  ixh,d                       ; Address in IX
    1811   00:4A95  CD 6E 4B                call    WAIT_MENU_CMD_RESPONSE
    1812   00:4A98  CA 27 4B                jp  z,MENU_SUB_BAD_END
    1813   00:4A9B                          ; Response received, nagle is the first one, ON: or OFF:
    1814   00:4A9B  3E 3A                   ld  a,':'
    1815   00:4A9D  DD 23                   inc ix
    1816   00:4A9F  DD 23                   inc ix                          ; Nagle response is two or three bytes long, let's check
    1817   00:4AA1  0B                      dec bc
    1818   00:4AA2  0B                      dec bc                          ; Remaining bytes
    1819   00:4AA3  DD BE 00                cp  (ix+0)
    1820   00:4AA6  CA B2 4A                jp  z,CHECKTIMEOUT.1
    1821   00:4AA9  DD 23                   inc ix
    1822   00:4AAB  0B                      dec bc                          ; Remaining bytes
    1823   00:4AAC  DD BE 00                cp  (ix+0)
    1824   00:4AAF  C2 27 4B                jp  nz,MENU_SUB_BAD_END         ; If not here, sorry to say it is an error
    1825   00:4AB2                      CHECKTIMEOUT.1:
    1826   00:4AB2  78                      ld  a,b
    1827   00:4AB3  B1                      or  c                           ; All data read?
    1828   00:4AB4  CA 27 4B                jp  z,MENU_SUB_BAD_END          ; If so, sorry to say it is an error
    1829   00:4AB7  DD 23                   inc ix                          ; At the first digit
    1830   00:4AB9  0B                      dec bc                          ; Remaining bytes
    1831   00:4ABA  78                      ld  a,b
    1832   00:4ABB  B1                      or  c                           ; All data read?
    1833   00:4ABC  CA 27 4B                jp  z,MENU_SUB_BAD_END          ; If so, sorry to say it is an error
    1834   00:4ABF  DD E5                   push    ix                      ; This is the start of the string, save it
    1835   00:4AC1  26 00                   ld  h,0                         ; No digit so far
    1836   00:4AC3                          ; It can have up to three digits
    1837   00:4AC3                      CHECKTIMEOUT.2:
    1838   00:4AC3  3E 3A                   ld  a,':'
    1839   00:4AC5  DD BE 00                cp  (ix+0)                      ; Check if it is the separator
    1840   00:4AC8  CA E9 4A                jp  z,CHECKTIMEOUT.3            ; If it is routine will follow through
    1841   00:4ACB  DD 7E 00                ld  a,(ix+0)                    ; Get the supposed digit in A
    1842   00:4ACE  2E 3A                   ld  l,'9'+1
    1843   00:4AD0  BD                      cp  l
    1844   00:4AD1  D2 26 4B                jp  nc,MENU_SUB_BAD_END_1S      ; If more than '9', sorry to say it is an error
    1845   00:4AD4  2E 30                   ld  l,'0'
    1846   00:4AD6  BD                      cp  l
    1847   00:4AD7  DA 26 4B                jp  c,MENU_SUB_BAD_END_1S       ; If less than '0', sorry to say it is an error
    1848   00:4ADA  24                      inc h                           ; It is not, so it is a digit
    1849   00:4ADB  3E 03                   ld  a,3
    1850   00:4ADD  BC                      cp  h
    1851   00:4ADE  DA 26 4B                jp  c,MENU_SUB_BAD_END_1S       ; If more than three digits, sorry to say it is an error
    1852   00:4AE1  DD 23                   inc ix                          ; Increase pointer
    1853   00:4AE3  0B                      dec bc                          ; Decrease remaining
    1854   00:4AE4  78                      ld  a,b
    1855   00:4AE5  B1                      or  c                           ; All data read?
    1856   00:4AE6  C2 C3 4A                jp  nz,CHECKTIMEOUT.2           ; Not, so rinse and repeat
    1857   00:4AE9                      CHECKTIMEOUT.3:
    1858   00:4AE9  DD 36 00 00             ld  (ix+0),0                    ; Null terminate string value
    1859   00:4AED  DD 2B                   dec ix
    1860   00:4AEF  DD 7E 00                ld  a,(ix+0)                    ; 1st Digit in A
    1861   00:4AF2  D6 30                   sub '0'                         ; Convert it to decimal value
    1862   00:4AF4  5F                      ld  e,a
    1863   00:4AF5  16 00                   ld  d,0                         ; DE has first digit
    1864   00:4AF7  25                      dec h                           ; Decrement digit counter
    1865   00:4AF8  28 28                   jr  z,CHECKTIMEOUT.END          ; If all digits, done
    1866   00:4AFA                          ; Now second digit, multiply it by 10 and add to E, even if 90 + 9, still fits E
    1867   00:4AFA  DD 2B                   dec ix
    1868   00:4AFC  DD 7E 00                ld  a,(ix+0)                    ; 2nd Digit
    1869   00:4AFF  D6 30                   sub '0'                         ; Convert it to decimal value
    1870   00:4B01  87                      add a,a                         ; A has *2
    1871   00:4B02  4F                      ld  c,a                         ; C has *2
    1872   00:4B03  87                      add a,a                         ; A has *4
    1873   00:4B04  87                      add a,a                         ; A has *8
    1874   00:4B05  81                      add a,c                         ; A has *10
    1875   00:4B06  83                      add a,e                         ; A has two digits result
    1876   00:4B07  5F                      ld  e,a                         ; Back to E, DE has two digits results
    1877   00:4B08  25                      dec h                           ; Decrement digit counter
    1878   00:4B09  28 17                   jr  z,CHECKTIMEOUT.END          ; If all digits, done
    1879   00:4B0B                          ; Now Third digit, multiply it by 100 and add to DE
    1880   00:4B0B  DD 2B                   dec ix
    1881   00:4B0D  DD 7E 00                ld  a,(ix+0)                    ; 3rd Digit
    1882   00:4B10  D6 30                   sub '0'                         ; Convert it to decimal value
    1883   00:4B12  87                      add a,a                         ; A has *2
    1884   00:4B13  4F                      ld  c,a                         ; C has *2
    1885   00:4B14  87                      add a,a                         ; A has *4
    1886   00:4B15  87                      add a,a                         ; A has *8
    1887   00:4B16  81                      add a,c                         ; A has *10
    1888   00:4B17  26 00                   ld  h,0
    1889   00:4B19  6F                      ld  l,a                         ; HL has *10
    1890   00:4B1A  29                      add hl,hl                       ; HL has *20
    1891   00:4B1B  44                      ld  b,h
    1892   00:4B1C  4D                      ld  c,l                         ; BC has *20
    1893   00:4B1D  29                      add hl,hl                       ; HL has *40
    1894   00:4B1E  29                      add hl,hl                       ; HL has *80
    1895   00:4B1F  09                      add hl,bc                       ; HL has *100
    1896   00:4B20  19                      add hl,de                       ; HL has three digit value
    1897   00:4B21  EB                      ex  de,hl                       ; now in DE
    1898   00:4B22                      CHECKTIMEOUT.END:
    1899   00:4B22  E1                      pop hl                          ; Restore address of string version of time count
    1900   00:4B23  7A                      ld  a,d
    1901   00:4B24  B3                      or  e                           ; Set zero flag according to the time out set
    1902   00:4B25  C9                      ret
    1903   00:4B26                      
    1904   00:4B26                      MENU_SUB_BAD_END_1S:
    1905   00:4B26  F1                      pop af                          ; 1 register was stacked, pop it
    1906   00:4B27                      MENU_SUB_BAD_END:
    1907   00:4B27  F1                      pop af                          ; It was a sub, so clear stack
    1908   00:4B28                      MENU_BAD_END:
    1909   00:4B28  21 9E 6D                ld  hl,STR_SENDING_FAIL         ; error message
    1910   00:4B2B  CD 96 4C                call    PRINTHL
    1911   00:4B2E  C3 07 4A                jp  WAIT_2S_AND_THEN_MAINMENU
    1912   00:4B31                      
    1913   00:4B31                      ; WAIT an ESP quick command Response
    1914   00:4B31                      ; Inputs:
    1915   00:4B31                      ; A -> Command Code
    1916   00:4B31                      ; HL -> Timeout
    1917   00:4B31                      ;
    1918   00:4B31                      ; Returns:
    1919   00:4B31                      ; Flag Z is zero if failure, non zero if success
    1920   00:4B31                      ;
    1921   00:4B31                      ; Affect:
    1922   00:4B31                      ; AF and HL
    1923   00:4B31                      ;
    1924   00:4B31                      WAIT_MENU_QCMD_RESPONSE:
    1925   00:4B31  D5                      push    de
    1926   00:4B32  57                      ld  d,a                         ; Command to wait in D
    1927   00:4B33                      WAIT_MENU_QCMD_RESPONSE_ST1:
    1928   00:4B33                          LOAD_STS_PORT_IN_A
    1928   00:4B33  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    1929   00:4B36  CB 6F                   bit 5,a                         ; If nz Port #07 is not available
    1930   00:4B38  C2 68 4B                jp  nz,WAIT_MENU_QCMD_RESPONSE_END_NOK
    1931   00:4B3B  CB 47                   bit 0,a                         ; If nz has data
    1932   00:4B3D  20 08                   jr  nz,WAIT_MENU_QCMD_RESPONSE_ST1.1
    1933   00:4B3F  CD 90 4C                call    HLTIMEOUT
    1934   00:4B42  20 EF                   jr  nz,WAIT_MENU_QCMD_RESPONSE_ST1
    1935   00:4B44  C3 66 4B                jp  WAIT_MENU_QCMD_RESPONSE_END ; If time out waiting, return
    1936   00:4B47                      WAIT_MENU_QCMD_RESPONSE_ST1.1:
    1937   00:4B47                          ; nz, check the data
    1938   00:4B47                          RECEIVE_DATA
    1938   00:4B47  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    1939   00:4B4A  BA                      cp  d                           ; Is response of our command?
    1940   00:4B4B  20 E6                   jr  nz,WAIT_MENU_QCMD_RESPONSE_ST1
    1941   00:4B4D                          ; Now get return code, if return code other than 0, it is failure, otherwise success
    1942   00:4B4D                      WAIT_MENU_QCMD_RESPONSE_RC:
    1943   00:4B4D                          CHECK_DATA
    1943   00:4B4D  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    1943   00:4B50  CB 47             >     bit 0,a
    1944   00:4B52  20 08                   jr  nz,WAIT_MENU_QCMD_RESPONSE_RC.1
    1945   00:4B54  CD 90 4C                call    HLTIMEOUT
    1946   00:4B57  20 F4                   jr  nz,WAIT_MENU_QCMD_RESPONSE_RC
    1947   00:4B59  C3 66 4B                jp  WAIT_MENU_QCMD_RESPONSE_END ; If time-out waiting, return
    1948   00:4B5C                      WAIT_MENU_QCMD_RESPONSE_RC.1:
    1949   00:4B5C                          RECEIVE_DATA
    1949   00:4B5C  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    1950   00:4B5F  B7                      or  a                           ; 0?
    1951   00:4B60                          ; If not, done
    1952   00:4B60  C2 68 4B                jp  nz,WAIT_MENU_QCMD_RESPONSE_END_NOK
    1953   00:4B63                      WAIT_MENU_QCMD_RESPONSE_END_OK:
    1954   00:4B63  3E 01                   ld  a,1
    1955   00:4B65  B7                      or  a                           ; NZ to indicate success
    1956   00:4B66                      WAIT_MENU_QCMD_RESPONSE_END:
    1957   00:4B66  D1                      pop de
    1958   00:4B67  C9                      ret
