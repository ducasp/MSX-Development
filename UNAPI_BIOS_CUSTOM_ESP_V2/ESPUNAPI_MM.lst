    4286   00:56C1  13                      inc de                          ; Increase size count
    4287   00:56C2  23                      inc hl                          ; And next byte
    4288   00:56C3  B7                      or  a                           ; If zero, user terminated
    4289   00:56C4                          ; Loop until terminator (0) is found
    4290   00:56C4  C2 C0 56                jp  nz,SSH_OPEN_CHECK_USER
    4291   00:56C7                      SSH_OPEN_CHECK_PASS:
    4292   00:56C7  7E                      ld  a,(hl)
    4293   00:56C8  13                      inc de                          ; Increase size count
    4294   00:56C9  23                      inc hl                          ; And next byte
