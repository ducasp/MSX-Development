    5570   00:5DAA                          endif
    5571   00:5DAA  15                      dec d
    5572   00:5DAB  20 F6                   jr  nz,TCPIP_TCP_SEND_R
    5573   00:5DAD                      
    5574   00:5DAD                          ; Now wait up to 600 ticks to get response
