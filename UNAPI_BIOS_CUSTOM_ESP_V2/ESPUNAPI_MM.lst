    5185   00:5B8B  CB 47             >     bit 0,a
    5186   00:5B8D  20 05                   jr  nz,TCPIP_TCP_SEND_R.1
    5187   00:5B8F  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
