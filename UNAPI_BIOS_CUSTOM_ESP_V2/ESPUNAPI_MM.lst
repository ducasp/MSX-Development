    6008   00:5FD8                      ;===     SSH_RCV     ===
    6009   00:5FD8                      ;=======================
    6010   00:5FD8                      ;Receive data from a SSH connection.
    6011   00:5FD8                      ;
    6012   00:5FD8                      ;Input:   A  = 6
    6013   00:5FD8                      ;         B  = Connection number
    6014   00:5FD8                      ;         DE = Address for the retrieved data
    6015   00:5FD8                      ;         HL = Length of the data to be obtained
    6016   00:5FD8                      ;Output:  A  = Error code
    6017   00:5FD8                      ;         BC = Total number of bytes that have been actually retrieved
    6018   00:5FD8                      ; Save registers other than AF
    6019   00:5FD8                      SSH_RCV_RETRY_QRCV:
    6020   00:5FD8  CD 71 63                call    GETBYTE
