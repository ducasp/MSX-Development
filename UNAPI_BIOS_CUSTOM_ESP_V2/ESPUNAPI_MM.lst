    5143   00:5B62                      ;             bit 0: Send the data PUSHed
    5144   00:5B62                      ;             bit 1: The data is urgent
    5145   00:5B62                      ;Output: A = Error code
    5146   00:5B62                      TCPIP_TCP_SEND:
    5147   00:5B62  E5                      push    hl
    5148   00:5B63  D5                      push    de
    5149   00:5B64                          SEND_DATA                       ; Send the command
    5149   00:5B64  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
