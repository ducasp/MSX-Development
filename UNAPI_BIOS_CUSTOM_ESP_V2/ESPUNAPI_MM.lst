    4634   00:5894  CB 47             >     bit 0,a
    4635   00:5896  20 05                   jr  nz,SSH_KEY_EXPORT_SIZE_B.1
    4636   00:5898  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4637   00:589B  18 F4                   jr  SSH_KEY_EXPORT_SIZE_B
    4638   00:589D                      SSH_KEY_EXPORT_SIZE_B.1:
    4639   00:589D                          RECEIVE_DATA
    4639   00:589D  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4640   00:58A0  6F                      ld  l,a                         ; HL = response size (unused)
    4641   00:58A1                          ; Read BC bytes written (LSB then MSB)
    4642   00:58A1                      SSH_KEY_EXPORT_BC_L:
    4643   00:58A1                          CHECK_DATA
    4643   00:58A1  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    4643   00:58A4  CB 47             >     bit 0,a
    4644   00:58A6  20 05                   jr  nz,SSH_KEY_EXPORT_BC_L.1
    4645   00:58A8  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4646   00:58AB  18 F4                   jr  SSH_KEY_EXPORT_BC_L
    4647   00:58AD                      SSH_KEY_EXPORT_BC_L.1:
    4648   00:58AD                          RECEIVE_DATA
    4648   00:58AD  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4649   00:58B0  4F                      ld  c,a
