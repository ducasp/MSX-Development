    3083   00:510F  CB 47             >     bit 0,a
    3084   00:5111  20 05                   jr  nz,TCPIP_NET_STATE_RC.1
    3085   00:5113  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3086   00:5116  18 F4                   jr  TCPIP_NET_STATE_RC
