    5286   00:5C1D  CB 47             >     bit 0,a
    5287   00:5C1F  20 05                   jr  nz,TCPIP_TCP_RCV_UDC_ST2.1
    5288   00:5C21  CD 4A 5B                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5289   00:5C24  18 F4                   jr  TCPIP_TCP_RCV_UDC_ST2
    5290   00:5C26                      TCPIP_TCP_RCV_UDC_ST2.1:
    5291   00:5C26                          ; nz, get it
