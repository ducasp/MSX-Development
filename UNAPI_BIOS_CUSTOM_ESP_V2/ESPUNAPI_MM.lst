    2511   00:4E18                      ;========================
    2512   00:4E18                      ;===  Functions code  ===
    2513   00:4E18                      ;========================
    2514   00:4E18                      FN_NOT_IMP:
    2515   00:4E18  3E 01                   ld  a,ERR_NOT_IMP
    2516   00:4E1A  C9                      ret
    2517   00:4E1B                      
    2518   00:4E1B                      END_OK:
    2519   00:4E1B  AF                      xor a
    2520   00:4E1C  C9                      ret
    2521   00:4E1D                      
    2522   00:4E1D                      ; Most functions do not have special handling on time out and can use this.
    2523   00:4E1D                      ; If there is a need to retry sending or receiving on time-out, then a custom
    2524   00:4E1D                      ; time-out function must be done, check the examples of UDP and TCP receive
    2525   00:4E1D                      TCPIP_GENERIC_CHECK_TIME_OUT:
    2526   00:4E1D                          ; Save registers other than AF
    2527   00:4E1D  C5                      push bc
    2528   00:4E1E  D5                      push de
    2529   00:4E1F  E5                      push hl
    2530   00:4E20  CD B3 5E                call    GETCOUNTER
    2531   00:4E23  7D                      ld  a,l
    2532   00:4E24  B4                      or  h
    2533   00:4E25                          ; Restore registers, we are returning
    2534   00:4E25  E1                      pop hl
    2535   00:4E26  D1                      pop de
    2536   00:4E27  C1                      pop bc
    2537   00:4E28  C0                      ret nz
    2538   00:4E29                          ; Ok, timeout...
    2539   00:4E29  F1                      pop af                          ; Get return address of who called this out of the stack
    2540   00:4E2A  3E 0F                   ld  a,ERR_INV_OPER
    2541   00:4E2C  C9                      ret                             ; and return the function itself
    2542   00:4E2D                      
    2543   00:4E2D                      ;========================
    2544   00:4E2D                      ;===  UNAPI_GET_INFO  ===
    2545   00:4E2D                      ;========================
    2546   00:4E2D                      ; Obtain the implementation name and version for TCP/IP.
    2547   00:4E2D                      ;
    2548   00:4E2D                      ;    Input:  A  = 0
    2549   00:4E2D                      ;    Output: HL = Descriptive string for this implementation, on this slot, zero terminated
    2550   00:4E2D                      ;            DE = API version supported, D.E
    2551   00:4E2D                      ;            BC = This implementation version, B.C.
    2552   00:4E2D                      ;            A  = 0 and Cy = 0
    2553   00:4E2D                      UNAPI_GET_INFO:
    2554   00:4E2D  01 03 01                ld  bc,256*ROM_V_P+ROM_V_S
    2555   00:4E30  11 02 01                ld  de,256*API_V_P+API_V_S
    2556   00:4E33  21 07 6F                ld  hl,APIINFO
    2557   00:4E36  AF                      xor a
    2558   00:4E37  C9                      ret
    2559   00:4E38                      
    2560   00:4E38                      ;========================
    2561   00:4E38                      ;===  UNAPI_GET_INFO  ===
    2562   00:4E38                      ;========================
    2563   00:4E38                      ; Obtain the implementation name and version for SSH.
    2564   00:4E38                      ;
    2565   00:4E38                      ;    Input:  A  = 0
    2566   00:4E38                      ;    Output: HL = Descriptive string for this implementation, on this slot, zero terminated
    2567   00:4E38                      ;            DE = API version supported, D.E
    2568   00:4E38                      ;            BC = This implementation version, B.C.
    2569   00:4E38                      ;            A  = 0 and Cy = 0
    2570   00:4E38                      UNAPI_GET_INFO_SSH:
    2571   00:4E38  01 03 01                ld  bc,256*ROM_V_P+ROM_V_S
    2572   00:4E3B  11 02 01                ld  de,256*API_V_P+API_V_S
    2573   00:4E3E  21 18 6F                ld  hl,APIINFO_SSH
    2574   00:4E41  AF                      xor a
    2575   00:4E42  C9                      ret
    2576   00:4E43                      
    2577   00:4E43                      ;=========================
    2578   00:4E43                      ;===   SSH_GET_CAPAB   ===
    2579   00:4E43                      ;=========================
    2580   00:4E43                      ; Get information about the SSH capabilities and features.
    2581   00:4E43                      ;
    2582   00:4E43                      ;    Input:  A = 1
    2583   00:4E43                      ;            B = Index of information block to retrieve:
    2584   00:4E43                      ;                1: Block 1 (only block supported, other blocks reserved for expansion)
    2585   00:4E43                      ;    Output: A = Error code
    2586   00:4E43                      ;        When information block 1 requested:
    2587   00:4E43                      ;            HL = Capabilities flags
    2588   00:4E43                      ;            B  = Maximum simultaneous SSH connections supported
    2589   00:4E43                      ;            C  = Free SSH connections currently available
    2590   00:4E43                      SSH_GET_CAPAB:
    2591   00:4E43                          ; SSH functions start at 127 on ESP
    2592   00:4E43  CB FF                   set 7,a
    2593   00:4E45                          SEND_DATA                       ; Send the command
    2593   00:4E45  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2594   00:4E48  AF                      xor a
    2595   00:4E49                          SEND_DATA                       ; Send the command size msb
    2595   00:4E49  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2596   00:4E4C  3C                      inc a
    2597   00:4E4D                          SEND_DATA                       ; Send the command size lsb
    2597   00:4E4D  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2598   00:4E50  78                      ld  a,b
    2599   00:4E51                          SEND_DATA                       ; Send the parameter
    2599   00:4E51  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2600   00:4E54                      
    2601   00:4E54                          ; Now wait up to 120 ticks to get response
    2602   00:4E54  21 78 00                ld  hl,120
    2603   00:4E57  CD C2 5E                call    SETCOUNTER
    2604   00:4E5A                      SSH_GET_CAPAB_ST1:
    2605   00:4E5A                          CHECK_DATA
    2605   00:4E5A  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2605   00:4E5D  CB 47             >     bit 0,a
    2606   00:4E5F  20 05                   jr  nz,SSH_GET_CAPAB_ST1.1
    2607   00:4E61  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2608   00:4E64  18 F4                   jr  SSH_GET_CAPAB_ST1
    2609   00:4E66                      SSH_GET_CAPAB_ST1.1:
    2610   00:4E66                          ; nz, check the data
    2611   00:4E66                          RECEIVE_DATA
    2611   00:4E66  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2612   00:4E69  FE 81                   cp  #81                         ; Is response of our command?
    2613   00:4E6B  20 ED                   jr  nz,SSH_GET_CAPAB_ST1
    2614   00:4E6D                          ; Now get return code, if return code other than 0, it is finished
    2615   00:4E6D                      SSH_GET_CAPAB_RC:
    2616   00:4E6D                          CHECK_DATA
    2616   00:4E6D  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2616   00:4E70  CB 47             >     bit 0,a
    2617   00:4E72  20 05                   jr  nz,SSH_GET_CAPAB_RC.1
    2618   00:4E74  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2619   00:4E77  18 F4                   jr  SSH_GET_CAPAB_RC
    2620   00:4E79                      SSH_GET_CAPAB_RC.1:
    2621   00:4E79                          ; nz, discard
    2622   00:4E79                          RECEIVE_DATA
    2622   00:4E79  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2623   00:4E7C  B7                      or  a                           ; 0?
    2624   00:4E7D  C0                      ret nz                          ; If not, done
    2625   00:4E7E                      
    2626   00:4E7E                          ; Next two bytes are size bytes, don't care
    2627   00:4E7E  06 02                   ld  b,2
    2628   00:4E80                      SSH_GET_CAPAB_ST2:
    2629   00:4E80                          CHECK_DATA
    2629   00:4E80  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2629   00:4E83  CB 47             >     bit 0,a
    2630   00:4E85  20 05                   jr  nz,SSH_GET_CAPAB_ST2.1
    2631   00:4E87  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2632   00:4E8A  18 F4                   jr  SSH_GET_CAPAB_ST2
    2633   00:4E8C                      SSH_GET_CAPAB_ST2.1:
    2634   00:4E8C                          ; Nz, discard
    2635   00:4E8C                          RECEIVE_DATA
    2635   00:4E8C  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2636   00:4E8F  05                      dec b
    2637   00:4E90  20 EE                   jr  nz,SSH_GET_CAPAB_ST2
    2638   00:4E92                      
    2639   00:4E92                      SSH_GET_CAPAB_BLK1_ST1:
    2640   00:4E92                          CHECK_DATA
    2640   00:4E92  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2640   00:4E95  CB 47             >     bit 0,a
    2641   00:4E97  20 05                   jr  nz,SSH_GET_CAPAB_BLK1_ST1.1
    2642   00:4E99  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2643   00:4E9C  18 F4                   jr  SSH_GET_CAPAB_BLK1_ST1
