    6740   00:621A                      ; http://map.grauw.nl/articles/vdp_tut.php
    6741   00:621A                      ; Set VDP address counter to write from address AHL (17-bits)
    6742   00:621A                      ; Enables the interrupts
    6743   00:621A                      SET_VDP_WRITE:
    6744   00:621A  CB 04                   rlc h
    6745   00:621C  17                      rla
    6746   00:621D  CB 04                   rlc h
    6747   00:621F  17                      rla
    6748   00:6220  CB 3C                   srl h
    6749   00:6222  CB 3C                   srl h
    6750   00:6224  F3                      di
    6751   00:6225  D3 99                   out (#99),a
    6752   00:6227  3E 8E                   ld  a,14+128
    6753   00:6229  D3 99                   out (#99),a
    6754   00:622B  7D                      ld  a,l
    6755   00:622C  00                      nop                             ; Do not remove this 'nop' here!
    6756   00:622D  D3 99                   out (#99),a
    6757   00:622F  7C                      ld  a,h
    6758   00:6230  F6 40                   or  64
    6759   00:6232  FB                      ei
    6760   00:6233  D3 99                   out (#99),a
    6761   00:6235  C9                      ret
