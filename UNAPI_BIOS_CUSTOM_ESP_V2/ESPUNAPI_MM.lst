    1745   00:4A14  18 02                   jr  WAIT_AND_THEN_MAINMENU
    1746   00:4A16                      WAIT_2S_AND_THEN_MAINMENU:
    1747   00:4A16  3E 78                   ld  a,120                       ; Wait 2 seconds with message on screen
    1748   00:4A18                      WAIT_AND_THEN_MAINMENU:
    1749   00:4A18  CD 20 4A                call    WAIT_BEFORE_CONTINUING
    1750   00:4A1B  C3 66 42                jp  ESPSETUP                    ; When done, back to main setup
    1751   00:4A1E                      WAIT_250MS_AND_THEN_CONTINUE:
    1752   00:4A1E  3E 0F                   ld  a,15                        ; Wait 250 ms then continue
    1753   00:4A20                      WAIT_BEFORE_CONTINUING:
    1754   00:4A20  76                      halt
    1755   00:4A21  3D                      dec a
    1756   00:4A22                          ; If not zero, our time out has not elapsed
