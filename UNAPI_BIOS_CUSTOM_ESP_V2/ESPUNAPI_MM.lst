    2373   00:4D80  11 22 22                ld  de,#2222
    2374   00:4D83                      JUMP_OLD:                           ; Assumes "push hl,bc,af" done
    2375   00:4D83  D5                      push    de
    2376   00:4D84  CD 96 60                call    GETSLT
