    2363   00:4D7B                      
    2364   00:4D7B                          ; A>1: A=A-1, and jump to old hook
    2365   00:4D7B                      
    2366   00:4D7B                      DO_EXTBIO3SSH:                         ; A=A-1 already done
    2367   00:4D7B  E3                      ex  (sp),hl
