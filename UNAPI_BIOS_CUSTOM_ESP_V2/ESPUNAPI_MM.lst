    6095   00:605D  20 05                   jr  nz,SSH_RCV_ST2B.1
    6096   00:605F  CD AF 5E                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    6097   00:6062  18 F4                   jr  SSH_RCV_ST2B
    6098   00:6064                      SSH_RCV_ST2B.1:
    6099   00:6064                          ; nz, low byte count of bytes to receive
