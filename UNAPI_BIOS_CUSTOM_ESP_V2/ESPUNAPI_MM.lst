     326   00:4000  (00:000A)           ERR_CONN_EXISTS:        equ 10
     327   00:4000  (00:000B)           ERR_NO_CONN:            equ 11
     328   00:4000  (00:000C)           ERR_CONN_STATE:         equ 12
