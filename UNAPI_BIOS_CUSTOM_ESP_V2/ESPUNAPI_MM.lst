    4652   00:58B6  20 05                   jr  nz,SSH_KEY_EXPORT_BC_H.1
    4653   00:58B8  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4654   00:58BB  18 F4                   jr  SSH_KEY_EXPORT_BC_H
    4655   00:58BD                      SSH_KEY_EXPORT_BC_H.1:
    4656   00:58BD                          RECEIVE_DATA
    4656   00:58BD  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4657   00:58C0  47                      ld  b,a                         ; BC = bytes written
    4658   00:58C1                          ; Read H flags
    4659   00:58C1                      SSH_KEY_EXPORT_HF:
    4660   00:58C1                          CHECK_DATA
    4660   00:58C1  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    4660   00:58C4  CB 47             >     bit 0,a
    4661   00:58C6  20 05                   jr  nz,SSH_KEY_EXPORT_HF.1
    4662   00:58C8  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4663   00:58CB  18 F4                   jr  SSH_KEY_EXPORT_HF
    4664   00:58CD                      SSH_KEY_EXPORT_HF.1:
    4665   00:58CD                          RECEIVE_DATA
    4665   00:58CD  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4666   00:58D0  F5                      push    af                      ; Save H flags on stack
    4667   00:58D1                          ; Now receive BC bytes of data into buffer
    4668   00:58D1  CD 0A 64                call    BCBACKUP                ; save BC (bytes written count)
    4669   00:58D4  78                      ld  a,b
    4670   00:58D5  B1                      or  c
    4671   00:58D6  28 1F                   jr  z,SSH_KEY_EXPORT_NODATA    ; if 0 bytes, skip receive
    4672   00:58D8  C5                      push    bc                      ; push BC for loop counter
    4673   00:58D9  CD 97 63                call    GETWORD                 ; HL = output buffer address
    4674   00:58DC  D1                      pop     de                      ; DE = bytes to receive
    4675   00:58DD                          ; Grauw Optimized 16 bit loop, regular receive only
    4676   00:58DD  43                      ld  b,e                         ; B = LSB of count
    4677   00:58DE  1B                      dec de
    4678   00:58DF  14                      inc d                           ; D = MSB+1
    4679   00:58E0                          if USE_MEM_IO = 0
    4680   00:58E0                    ~     ld  c,IN_DATA_PORT
    4681   00:58E0                    ~     endif
    4682   00:58E0                      SSH_KEY_EXPORT_RCV:
