    2330   00:4D56  CD 3F 62                call    GETESPFLAGS
    2331   00:4D59  E6 02                   and ESPFLAG_SSH
    2332   00:4D5B  28 2B                   jr  z,JUMP_OLD2
    2333   00:4D5D                      
    2334   00:4D5D                          ; A=255: Jump to old hook
