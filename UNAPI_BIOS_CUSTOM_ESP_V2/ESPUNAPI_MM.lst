    6529   00:629F                      ;==========================
    6530   00:629F                      ;===  TCPIP_CONFIG_TTL  ===
    6531   00:629F                      ;==========================
    6532   00:629F                      ;Get/set the value of TTL and TOS for outgoing datagrams.
    6533   00:629F                      ;
    6534   00:629F                      ;Input:  A = 27
    6535   00:629F                      ;        B = 0: Get current values (just return 255 for TTL and 0 for TOS
    6536   00:629F                      ;               as ESP do not expose or allow configurations of it)
    6537   00:629F                      ;            1: Set values
    6538   00:629F                      ;        D = New value for TTL (only if B=1)
    6539   00:629F                      ;        E = New value for ToS (only if B=1)
    6540   00:629F                      ;Output: A = Error code
    6541   00:629F                      ;        D = Value of TTL after the routine execution
    6542   00:629F                      ;        E = Value of ToS after the routine execution
    6543   00:629F                      TCPIP_CONFIG_TTL:
    6544   00:629F  78                      ld  a,b
    6545   00:62A0  E6 FE                   and %11111110
    6546   00:62A2  B7                      or  a
    6547   00:62A3  3E 04                   ld  a,ERR_INV_PARAM
    6548   00:62A5  C0                      ret nz
    6549   00:62A6  78                      ld  a,b
    6550   00:62A7  B7                      or  a
    6551   00:62A8                          ; Cant set, so NOT IMP
    6552   00:62A8  3E 01                   ld  a,ERR_NOT_IMP
    6553   00:62AA  C0                      ret nz                          ; if not get, not implemented
    6554   00:62AB                          ; get, so just return D = #FF, A = OK = 0 and E = 0
    6555   00:62AB  AF                      xor a
    6556   00:62AC  1E 00                   ld  e,0
    6557   00:62AE  16 FF                   ld  d,#FF
    6558   00:62B0  C9                      ret
    6559   00:62B1                      
    6560   00:62B1                      ;===========================
    6561   00:62B1                      ;===  TCPIP_CONFIG_PING  ===
    6562   00:62B1                      ;===========================
    6563   00:62B1                      ;Get/set the automatic PING reply flag.
    6564   00:62B1                      ;
    6565   00:62B1                      ;Input:  A = 28
    6566   00:62B1                      ;        B = 0: Get current flag value
    6567   00:62B1                      ;            1: Set flag value (ERR_NOT_IMP)
    6568   00:62B1                      ;        C = New flag value (only if B=1):
    6569   00:62B1                      ;            0: Off
    6570   00:62B1                      ;            1: On
    6571   00:62B1                      ;Output: A = Error code
    6572   00:62B1                      ;        C = Flag value after the routine execution
    6573   00:62B1                      TCPIP_CONFIG_PING:
    6574   00:62B1  78                      ld  a,b
    6575   00:62B2  E6 FE                   and %11111110
    6576   00:62B4  B7                      or  a
    6577   00:62B5  3E 04                   ld  a,ERR_INV_PARAM
    6578   00:62B7  C0                      ret nz
    6579   00:62B8  78                      ld  a,b
    6580   00:62B9  B7                      or  a
    6581   00:62BA                          ; Cant set, so NOT IMP
    6582   00:62BA  3E 01                   ld  a,ERR_NOT_IMP
    6583   00:62BC  C0                      ret nz                          ; if not get, not implemented
    6584   00:62BD                          ; get, so just return C = 1, A = OK = 0
    6585   00:62BD  AF                      xor a
    6586   00:62BE  0E 01                   ld  c,1
    6587   00:62C0  C9                      ret
    6588   00:62C1                      
