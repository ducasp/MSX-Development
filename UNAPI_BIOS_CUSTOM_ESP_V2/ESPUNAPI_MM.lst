    4969   00:5A81                      TCPIP_TCP_SEND:
    4970   00:5A81  E5                      push    hl
    4971   00:5A82  D5                      push    de
    4972   00:5A83                          SEND_DATA                       ; Send the command
    4972   00:5A83  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
