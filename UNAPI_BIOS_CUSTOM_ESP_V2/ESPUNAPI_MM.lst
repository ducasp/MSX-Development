    4410   00:5763  2B                      dec hl                          ; decrement one byte, first is connection will go to B
    4411   00:5764                          ; Now get connection number and save it 
    4412   00:5764                      SSH_OPEN_HOSTHASH_CONN:
    4413   00:5764                          CHECK_DATA
    4413   00:5764  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    4413   00:5767  CB 47             >     bit 0,a
    4414   00:5769  20 05                   jr  nz,SSH_OPEN_HOSTHASH_CONN.1
    4415   00:576B  CD 8C 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    4416   00:576E  18 F4                   jr  SSH_OPEN_HOSTHASH_CONN
    4417   00:5770                      SSH_OPEN_HOSTHASH_CONN.1:
    4418   00:5770                          ; nz, connection number
    4419   00:5770                          RECEIVE_DATA
    4419   00:5770  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4420   00:5773  47                      ld b,a
    4421   00:5774  C5                      push    bc                      ; save it
    4422   00:5775                      
    4423   00:5775  4D                      ld  c,l
    4424   00:5776  44                      ld  b,h                         ; BC has effective received data size, as well as HL
    4425   00:5777                      
    4426   00:5777                          ; put effective data size in de
    4427   00:5777  EB                      ex  de,hl
    4428   00:5778                          ; address was in de, now in HL, BC effective received size
    4429   00:5778                      
    4430   00:5778                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use ini :-D
    4431   00:5778  43                      ld  b,e                         ; Number of loops originaly in DE
    4432   00:5779  1B                      dec de
    4433   00:577A  14                      inc d
    4434   00:577B                          if USE_MEM_IO = 0
    4435   00:577B                    ~     ld  c,IN_DATA_PORT
    4436   00:577B                    ~     endif
    4437   00:577B                      SSH_OPEN_HOSTHASH_NSF:
    4438   00:577B                          CHECK_DATA
    4438   00:577B  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    4438   00:577E  CB 47             >     bit 0,a
    4439   00:5780  20 05                   jr  nz,SSH_OPEN_HOSTHASH_NSF.1
    4440   00:5782  CD 8C 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    4441   00:5785  18 F4                   jr  SSH_OPEN_HOSTHASH_NSF
    4442   00:5787                      SSH_OPEN_HOSTHASH_NSF.1:
    4443   00:5787                          if USE_MEM_IO = 0
    4444   00:5787                    ~     ini
    4445   00:5787                    ~     else
    4446   00:5787  3A 06 7F                ld  a,(MEM_IN_DATA_PORT)
    4447   00:578A  77                      ld  (hl),a
    4448   00:578B  23                      inc hl
    4449   00:578C  05                      dec b
    4450   00:578D                          endif
    4451   00:578D  20 EC                   jr  nz,SSH_OPEN_HOSTHASH_NSF
    4452   00:578F  15                      dec d
    4453   00:5790  20 E9                   jr nz,SSH_OPEN_HOSTHASH_NSF
    4454   00:5792                          ; restore BC to get conn # in B
    4455   00:5792  C1                      pop bc
    4456   00:5793                          ; if we are here, return code is 132, unknown host
    4457   00:5793  3E 84                   ld  a,132
    4458   00:5795  C9                      ret
