    3036   00:50BB                      TCPIP_NET_STATE:
    3037   00:50BB                          SEND_DATA                       ; Send the command
    3037   00:50BB  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3038   00:50BE  AF                      xor a
    3039   00:50BF                          SEND_DATA                       ; Send the command size msb
    3039   00:50BF  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3040   00:50C2                          SEND_DATA                       ; Send the command size lsb
    3040   00:50C2  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3041   00:50C5                      
    3042   00:50C5                          ; Now wait up to 720 ticks to get response
    3043   00:50C5  21 D0 02                ld  hl,720
