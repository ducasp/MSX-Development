    5647   00:5DD1  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5648   00:5DD4  AF                      xor a
    5649   00:5DD5                          SEND_DATA                       ; Send the command size msb
    5649   00:5DD5  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
