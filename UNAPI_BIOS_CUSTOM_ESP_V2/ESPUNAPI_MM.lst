    5900   00:5F52  18 F4                   jr  SSH_AUTH_GET_CHALLENGE_BUFERRB
    5901   00:5F54                      SSH_AUTH_GET_CHALLENGE_BUFERRB.1:
    5902   00:5F54                          ; nz, high byte count of bytes to receive
    5903   00:5F54                          RECEIVE_DATA
    5903   00:5F54  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5904   00:5F57  47                      ld  b,a
    5905   00:5F58  3E 0D                   ld  a,13                        ; ERR BUFF
    5906   00:5F5A  C9                      ret
    5907   00:5F5B                          ; If here, should be ok and will get the data
    5908   00:5F5B                      SSH_AUTH_GET_CHALLENGE_ST2BB.1:
    5909   00:5F5B  7D                      ld  a,l
    5910   00:5F5C  B4                      or  h
    5911   00:5F5D                          ; if it was 0, no data
    5912   00:5F5D  CA C4 5C                jp  z,TCPIP_TCP_RCV_RET_NODATA  ; not a typo, no need to make the same code again
    5913   00:5F60                          ; Ok, we need to get the flags that will go to HL, we get it in BC and then push to the stack
    5914   00:5F60                      SSH_AUTH_GET_CHALLENGE_FLAGSA:
    5915   00:5F60                          CHECK_DATA
    5915   00:5F60  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5915   00:5F63  CB 47             >     bit 0,a
    5916   00:5F65  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_FLAGSA.1
