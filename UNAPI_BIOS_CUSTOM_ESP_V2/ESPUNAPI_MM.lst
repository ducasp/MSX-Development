    1199   00:463A  AF                      xor a
    1200   00:463B  B2                      or  d                           ; Still has items?
    1201   00:463C  28 0B                   jr  z,APLIST_NO_OVERFLOW        ; No more items
    1202   00:463E  06 01                   ld  b,1                         ; Signal that there still is data pending to list in another page
    1203   00:4640  E5                      push    hl
    1204   00:4641  FD E1                   pop iy                          ; Save in IY the address to continue from
    1205   00:4643  4A                      ld  c,d                         ; And C has the remaining AP count
    1206   00:4644  21 EB 6C                ld  hl,MMENU_SCANQM
    1207   00:4647  18 03                   jr  APLIST_NOFLW
    1208   00:4649                      APLIST_NO_OVERFLOW:
    1209   00:4649                          ; If here, current page has been printed
    1210   00:4649                          ; E has the maximum allowable AP number
    1211   00:4649                          ; B will indicate if there are more items for a next page
    1212   00:4649                          ; IY will hold the address of the following items
    1213   00:4649                          ; Let's ask which one to connect
    1214   00:4649  21 80 6C                ld  hl,MMENU_SCANQ
    1215   00:464C                      APLIST_NOFLW:
