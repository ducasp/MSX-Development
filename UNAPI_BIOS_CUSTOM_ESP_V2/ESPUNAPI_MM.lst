    4938   00:5A1D                          CHECK_DATA
    4938   00:5A1D  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    4938   00:5A20  CB 47             >     bit 0,a
    4939   00:5A22  20 05                   jr  nz,TCPIP_TCP_STATE_ERROR2.1
    4940   00:5A24  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4941   00:5A27  18 F4                   jr  TCPIP_TCP_STATE_ERROR2
    4942   00:5A29                      TCPIP_TCP_STATE_ERROR2.1:
    4943   00:5A29                          ; nz, discard
    4944   00:5A29                          RECEIVE_DATA
    4944   00:5A29  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4945   00:5A2C  0D                      dec c
    4946   00:5A2D  20 EE                   jr  nz,TCPIP_TCP_STATE_ERROR2
    4947   00:5A2F                      
    4948   00:5A2F                          ; now return w/ error that is saved in b
    4949   00:5A2F  78                      ld  a,b
    4950   00:5A30  06 00                   ld  b,0
    4951   00:5A32  0E 07                   ld  c,7
    4952   00:5A34  21 00 00                ld  hl,0
    4953   00:5A37  11 00 00                ld  de,0
    4954   00:5A3A  DD 21 00 00             ld  ix,0
