    5272   00:5BF4  CB 47             >     bit 0,a
    5273   00:5BF6  20 05                   jr  nz,SSH_SEND_R.1
    5274   00:5BF8  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5275   00:5BFB  18 F4                   jr  SSH_SEND_ST1
