    2706   00:4F02                      ;=========================
    2707   00:4F02                      ;===  TCPIP_GET_CAPAB  ===
    2708   00:4F02                      ;=========================
    2709   00:4F02                      ; Get information about the TCP/IP capabilities and features.
    2710   00:4F02                      ;
    2711   00:4F02                      ;    Input:  A = 1
    2712   00:4F02                      ;            B = Index of information block to retrieve:
    2713   00:4F02                      ;                1: Capabilities and features flags, link level protocol
    2714   00:4F02                      ;                2: Connection pool size and status
    2715   00:4F02                      ;                3: Maximum datagram size allowed
    2716   00:4F02                      ;                4: Second set of capabilities and features flags
    2717   00:4F02                      ;    Output: A = Error code
    2718   00:4F02                      ;        When information block 1 requested:
    2719   00:4F02                      ;            HL = Capabilities flags
    2720   00:4F02                      ;            DE = Features flags
    2721   00:4F02                      ;            B  = Link level protocol used
    2722   00:4F02                      ;        When information block 2 requested:
    2723   00:4F02                      ;            B = Maximum simultaneous TCP connections supported
    2724   00:4F02                      ;            C = Maximum simultaneous UDP connections supported
    2725   00:4F02                      ;            D = Free TCP connections currently available
    2726   00:4F02                      ;            E = Free UDP connections currently available
    2727   00:4F02                      ;            H = Maximum simultaneous raw IP connections supported
    2728   00:4F02                      ;            L = Free raw IP connections currently available
    2729   00:4F02                      ;        When information block 3 requested:
    2730   00:4F02                      ;            HL = Maximum incoming datagram size supported
    2731   00:4F02                      ;            DE = Maximum outgoing datagram size supported
    2732   00:4F02                      ;        When information block 4 requested:
    2733   00:4F02                      ;            HL = Second set of capabilities flags
    2734   00:4F02                      ;            DE = Second set of features flags (currently unused, always zero)
    2735   00:4F02                      TCPIP_GET_CAPAB:
    2736   00:4F02                          SEND_DATA                       ; Send the command
    2736   00:4F02  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2737   00:4F05  AF                      xor a
    2738   00:4F06                          SEND_DATA                       ; Send the command size msb
    2738   00:4F06  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2739   00:4F09  3C                      inc a
    2740   00:4F0A                          SEND_DATA                       ; Send the command size lsb
    2740   00:4F0A  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2741   00:4F0D  78                      ld  a,b
    2742   00:4F0E  CD 83 63                call    SETBYTE                 ; Save it, we are going to need it later
    2743   00:4F11                          SEND_DATA                       ; Send the parameter
    2743   00:4F11  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2744   00:4F14                      
    2745   00:4F14                          ; Now wait up to 120 ticks to get response
    2746   00:4F14  21 78 00                ld  hl,120
    2747   00:4F17  CD 61 63                call    SETCOUNTER
    2748   00:4F1A                      TCPIP_GET_CAPAB_ST1:
    2749   00:4F1A                          CHECK_DATA
    2749   00:4F1A  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2749   00:4F1D  CB 47             >     bit 0,a
    2750   00:4F1F  20 05                   jr  nz,TCPIP_GET_CAPAB_ST1.1
    2751   00:4F21  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2752   00:4F24  18 F4                   jr  TCPIP_GET_CAPAB_ST1
    2753   00:4F26                      TCPIP_GET_CAPAB_ST1.1:
    2754   00:4F26                          ; nz, check the data
    2755   00:4F26                          RECEIVE_DATA
    2755   00:4F26  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2756   00:4F29  FE 01                   cp  1                           ; Is response of our command?
    2757   00:4F2B  20 ED                   jr  nz,TCPIP_GET_CAPAB_ST1
    2758   00:4F2D                          ; Now get return code, if return code other than 0, it is finished
    2759   00:4F2D                      TCPIP_GET_CAPAB_RC:
    2760   00:4F2D                          CHECK_DATA
    2760   00:4F2D  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2760   00:4F30  CB 47             >     bit 0,a
    2761   00:4F32  20 05                   jr  nz,TCPIP_GET_CAPAB_RC.1
    2762   00:4F34  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2763   00:4F37  18 F4                   jr  TCPIP_GET_CAPAB_RC
    2764   00:4F39                      TCPIP_GET_CAPAB_RC.1:
    2765   00:4F39                          ; nz, discard
    2766   00:4F39                          RECEIVE_DATA
    2766   00:4F39  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2767   00:4F3C  B7                      or  a                           ; 0?
    2768   00:4F3D  C0                      ret nz                          ; If not, done
    2769   00:4F3E                      
    2770   00:4F3E                          ; Next two bytes are return code and size bytes, don't care
    2771   00:4F3E  06 02                   ld  b,2
    2772   00:4F40                      TCPIP_GET_CAPAB_ST2:
    2773   00:4F40                          CHECK_DATA
    2773   00:4F40  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2773   00:4F43  CB 47             >     bit 0,a
    2774   00:4F45  20 05                   jr  nz,TCPIP_GET_CAPAB_ST2.1
    2775   00:4F47  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2776   00:4F4A  18 F4                   jr  TCPIP_GET_CAPAB_ST2
    2777   00:4F4C                      TCPIP_GET_CAPAB_ST2.1:
    2778   00:4F4C                          ; Nz, discard
    2779   00:4F4C                          RECEIVE_DATA
    2779   00:4F4C  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2780   00:4F4F  05                      dec b
    2781   00:4F50  20 EE                   jr  nz,TCPIP_GET_CAPAB_ST2
    2782   00:4F52                      
    2783   00:4F52                          ; Now check if block 1, 2 or 3
    2784   00:4F52  CD 71 63                call    GETBYTE                 ; Get the parameter we saved at the start
    2785   00:4F55  3D                      dec a
    2786   00:4F56  CA 08 50                jp  z,TCPIP_GET_CAPAB_BLK1      ; 1
    2787   00:4F59  3D                      dec a
    2788   00:4F5A  CA A6 4F                jp  z,TCPIP_GET_CAPAB_BLK2      ; 2
    2789   00:4F5D  3D                      dec a
    2790   00:4F5E  CA 64 4F                jp  z,TCPIP_GET_CAPAB_BLK3      ; 3
    2791   00:4F61                          ; Else, only block four, same as block 1
    2792   00:4F61  C3 08 50                jp  TCPIP_GET_CAPAB_BLK1        ; 1
    2793   00:4F64                          ; Block 3 Handling, we will receive L, H, E and D
