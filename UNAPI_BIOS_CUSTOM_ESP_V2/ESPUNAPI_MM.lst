    1122   00:45B4  78                      ld  a,b
    1123   00:45B5  FE 02                   cp  2                           ; If 2, scan is done and nothing found
    1124   00:45B7  CA 23 48                jp  z,WIFI_SCAN_NONETWORKS
    1125   00:45BA  2E 1E                   ld  l,30
    1126   00:45BC                      WIFI_SCAN_WAITHS:
