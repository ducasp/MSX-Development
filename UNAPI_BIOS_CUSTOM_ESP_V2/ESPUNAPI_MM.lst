    5554   00:5D68  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5555   00:5D6B                      
    5556   00:5D6B                          ; put effective data size in de
    5557   00:5D6B  EB                      ex  de,hl
    5558   00:5D6C                          ; will start moving at address in stack (we've pushed the adress in WORD)
    5559   00:5D6C  CD 74 61                call    GETWORD
    5560   00:5D6F  CD E7 61                call    BCBACKUP                ; save count (BC)
    5561   00:5D72                      
    5562   00:5D72                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use ini :-D
    5563   00:5D72  43                      ld  b,e                         ; Number of loops originaly in DE
    5564   00:5D73  1B                      dec de
    5565   00:5D74  14                      inc d
