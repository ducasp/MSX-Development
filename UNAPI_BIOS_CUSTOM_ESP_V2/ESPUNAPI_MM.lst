    4584   00:5837  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4585   00:583A  AF                      xor a
    4586   00:583B                          SEND_DATA                       ; Send the command size msb
    4586   00:583B  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4587   00:583E  3E 03                   ld  a,3
    4588   00:5840                          SEND_DATA                       ; Send the command size lsb
    4588   00:5840  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4589   00:5843  78                      ld  a,b
    4590   00:5844                          SEND_DATA                       ; Send B (what to export)
    4590   00:5844  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
