     715   00:428F  21 57 63                ld  hl,WELCOME_NEXT
     716   00:4292  CD 96 4C                call    PRINTHL
     717   00:4295  21 61 63                ld  hl,WELCOME_SF_NEXT
     718   00:4298  CD 96 4C                call    PRINTHL                 ; Print Empty Welcome message
     719   00:429B  CD 31 43                call    GET_AP_STAT
     720   00:429E  CA D6 42                jp  z,ESPSETUP_NEXT.1G          ; Won't block in case of error
     721   00:42A1                          ; Success, so connection state is in IX+0, then, zero terminated string with SSID starting at IX+1
     722   00:42A1  DD 7E 00                ld  a,(ix+0)
     723   00:42A4  21 64 63                ld  hl,WELCOME_CS0_NEXT
     724   00:42A7  FE 00                   cp  0
     725   00:42A9  28 1F                   jr  z,ESPSETUP_NEXT.2F
     726   00:42AB  21 8E 63                ld  hl,WELCOME_CS1_NEXT
     727   00:42AE  FE 01                   cp  1
     728   00:42B0  28 18                   jr  z,ESPSETUP_NEXT.2F
     729   00:42B2  21 97 63                ld  hl,WELCOME_CS2_NEXT
     730   00:42B5  FE 02                   cp  2
     731   00:42B7  28 11                   jr  z,ESPSETUP_NEXT.2F
     732   00:42B9  21 C1 63                ld  hl,WELCOME_CS3_NEXT
     733   00:42BC  FE 03                   cp  3
     734   00:42BE  28 0A                   jr  z,ESPSETUP_NEXT.2F
     735   00:42C0  21 EB 63                ld  hl,WELCOME_CS4_NEXT
     736   00:42C3  FE 04                   cp  4
     737   00:42C5  28 03                   jr  z,ESPSETUP_NEXT.2F
     738   00:42C7  21 15 64                ld  hl,WELCOME_CS5_NEXT
     739   00:42CA                      ESPSETUP_NEXT.2F:
     740   00:42CA  FD 67                   ld  iyh,a                       ; Save current conn status in iyh
     741   00:42CC  CD 96 4C                call    PRINTHL                 ; Print Status
     742   00:42CF  DD E5                   push    ix
     743   00:42D1  E1                      pop hl
     744   00:42D2  23                      inc hl                          ; HL has AP Name
     745   00:42D3  CD A0 4C                call    PRINTHLINE              ; Print AP Name
     746   00:42D6                      ESPSETUP_NEXT.1G:
     747   00:42D6  21 3F 64                ld  hl,MMENU_S_NEXT
     748   00:42D9  CD 96 4C                call    PRINTHL                 ; Print Main Menu
     749   00:42DC                      MM_CURSOR_BLINK:
     750   00:42DC  CD 1D 43                call    MM_CURSOR_SW            ; Cursor On
     751   00:42DF                      CONN_CHG_LOOP:
     752   00:42DF  CD 9C 00                call    CHSNS
     753   00:42E2  20 13                   jr  nz,MM_WAIT_INPUT            ; If not zero, there is a key in buffer
     754   00:42E4                          ; Ok, there is not, we can check if connection status changed
     755   00:42E4  CD 31 43                call    GET_AP_STAT
     756   00:42E7  CA DF 42                jp  z,CONN_CHG_LOOP             ; Won't block in case of error
     757   00:42EA                          ; Success, so connection state is in IX+0
     758   00:42EA  DD 7E 00                ld  a,(ix+0)
     759   00:42ED  FD BC                   cp  iyh                         ; If same, zero
     760   00:42EF  28 EE                   jr  z,CONN_CHG_LOOP             ; Keep loop
     761   00:42F1  CD 1D 43                call    MM_CURSOR_SW            ; Cursor Off
     762   00:42F4  C3 8C 42                jp  ESPSETUP_NEXT               ; Changed, re-build menu
     763   00:42F7                      MM_WAIT_INPUT:
     764   00:42F7  CD 9F 00                call    CHGET
     765   00:42FA  FE 1B                   cp  #1b                         ; ESC?
     766   00:42FC  CA 38 42                jp  z,ESPSETUP.EXIT             ; When done, resume initialization
     767   00:42FF  FE 31                   cp  '1'                         ; Setup Nagle?
     768   00:4301  CA F4 48                jp  z,SET_NAGLE
     769   00:4304  FE 32                   cp  '2'                         ; Setup Wi-Fi On Period?
     770   00:4306  CA 2E 48                jp  z,SET_WIFI_TIMEOUT
     771   00:4309  FE 33                   cp  '3'                         ; Scan networks?
     772   00:430B  CA 7E 45                jp  z,START_WIFI_SCAN
     773   00:430E  FE 34                   cp  '4'                         ; Automatic Setting of Clock?
     774   00:4310  CA 9A 43                jp  z,START_CLK_AUTO
     775   00:4313  CD C0 00                call    BEEP                    ; Wrong Input, beep
     776   00:4316  CD 1D 43                call    MM_CURSOR_SW            ; Cursor Off
     777   00:4319  76                      halt
     778   00:431A  C3 DC 42                jp  MM_CURSOR_BLINK             ; And return, waiting another key
     779   00:431D                      MM_CURSOR_SW:                       ; Cursor workaround for CONN_CHG_LOOP
     780   00:431D  3E 1D                   ld  a,GOLEFT
     781   00:431F  CD A2 00                call    CHPUT
     782   00:4322  3E 01                   ld  a,1
     783   00:4324  32 A9 FC                ld  (CSRSW),a
     784   00:4327  3E 20                   ld  a,' '
     785   00:4329  CD A2 00                call    CHPUT                   ; Switch the cursor display mode
     786   00:432C  AF                      xor a
     787   00:432D  32 A9 FC                ld  (CSRSW),a
     788   00:4330  C9                      ret
     789   00:4331                      GET_AP_STAT:                        ; Use 'call GET_AP_STAT'
     790   00:4331                          CLEAR_UART
     790   00:4331  3E 14             >     ld  a,20
     790   00:4333  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     791   00:4336  3E 67                   ld  a,CMD_AP_STS
     792   00:4338                          SEND_DATA                       ; Get AP conn status and name
     792   00:4338  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     793   00:433B  21 3C 00                ld  hl,60                       ; Wait Up To 1s
     794   00:433E  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
     795   00:4342  DD 6B                   ld  ixl,e
     796   00:4344  DD 62                   ld  ixh,d                       ; Address in IX
     797   00:4346  C3 6E 4B                jp  WAIT_MENU_CMD_RESPONSE
     798   00:4349                      
     799   00:4349                      ;============================
     800   00:4349                      ;===  SETUP Menu Routines  ==
     801   00:4349                      ;===  Wi-Fi and Clock Menu ==
     802   00:4349                      ;============================
     803   00:4349                      CLK_MSX1_GO:
     804   00:4349  21 2E 66                ld  hl,MMENU_CLOCK_MSX1
     805   00:434C  CD 96 4C                call    PRINTHL                 ; Print Main Clock MSX1 message
     806   00:434F  CD 16 4A                call    ISCLKAUTO
     807   00:4352  DD 7E 00                ld  a,(ix+0)                    ; Auto Clock Current setting
     808   00:4355  FE 03                   cp  3                           ; If 3 adapter disabled
     809   00:4357  28 08                   jr  z,CLK_MSX1_ADAPTERDIS
     810   00:4359  21 C2 66                ld  hl,MMENU_CLOCK_0
     811   00:435C  CD 96 4C                call    PRINTHL
     812   00:435F  18 06                   jr  CLK_MSX1_OPT
     813   00:4361                      CLK_MSX1_ADAPTERDIS:
     814   00:4361  21 08 67                ld  hl,MMENU_CLOCK_3
     815   00:4364  CD 96 4C                call    PRINTHL
     816   00:4367                      CLK_MSX1_OPT:
     817   00:4367  21 1B 67                ld  hl,MMENU_CLOCK_OPT
     818   00:436A  CD 96 4C                call    PRINTHL
     819   00:436D                      CLK_MSX1_WAIT_OPT_INPUT:
     820   00:436D  CD 9F 00                call    CHGET
     821   00:4370  FE 1B                   cp  #1b                         ; ESC?
     822   00:4372  CA 5C 42                jp  z,ESPSETUP                  ; Back to main menu
     823   00:4375  FE 30                   cp  '0'
     824   00:4377  CA 85 43                jp  z,CLK_MSX1_SEND_CMD
     825   00:437A  FE 33                   cp  '3'
     826   00:437C  CA 41 44                jp  z,CLK_AUTO_WAIT_GMT
     827   00:437F  CD C0 00                call    BEEP                    ; Wrong Input, beep
     828   00:4382  C3 6D 43                jp  CLK_MSX1_WAIT_OPT_INPUT     ; And return, waiting another key
     829   00:4385                      CLK_MSX1_SEND_CMD:
     830   00:4385  CD A2 00                call    CHPUT                   ; Print option
     831   00:4388  D6 30                   sub '0'                         ; Adjust format
     832   00:438A  DD 77 00                ld  (ix+0),a                    ; Save it
     833   00:438D  3E 0D                   ld  a,#0d
     834   00:438F  CD A2 00                call    CHPUT
     835   00:4392  3E 0A                   ld  a,#0a
     836   00:4394  CD A2 00                call    CHPUT
     837   00:4397  C3 38 45                jp  CLK_AUTO_GMT_CHK_DONE       ; And sending the command will be done there
     838   00:439A                      
     839   00:439A                      START_CLK_AUTO:
     840   00:439A  3E 34                   ld  a,'4'
     841   00:439C  CD A2 00                call    CHPUT
     842   00:439F  CD 0F 4A                call    WAIT_250MS_AND_THEN_CONTINUE
     843   00:43A2  3A 2D 00                ld  a,(#002D)                   ; Check MSX Version
     844   00:43A5  B7                      or  a
     845   00:43A6  CA 49 43                jp  z,CLK_MSX1_GO               ; If zero, MSX1, so can just enable or disable adapter
     846   00:43A9                      CLK_AUTO_GO:
     847   00:43A9  21 CE 64                ld  hl,MMENU_CLOCK_MSX2
     848   00:43AC  CD 96 4C                call    PRINTHL                 ; Print Main Clock MSX2 message
     849   00:43AF  CD 16 4A                call    ISCLKAUTO
     850   00:43B2  DD 7E 00                ld  a,(ix+0)                    ; Auto Clock Current setting
     851   00:43B5  B7                      or  a                           ; If zero, off
     852   00:43B6  20 08                   jr  nz,CLK_AUTO_CHK1
     853   00:43B8  21 C2 66                ld  hl,MMENU_CLOCK_0
     854   00:43BB  CD 96 4C                call    PRINTHL
     855   00:43BE  18 59                   jr  CLK_AUTO_GMT_OPT
     856   00:43C0                      CLK_AUTO_CHK1:
     857   00:43C0  3D                      dec a                           ; If 1, on and keep wifi on
     858   00:43C1  20 08                   jr  nz,CLK_AUTO_CHK2
     859   00:43C3  21 D4 66                ld  hl,MMENU_CLOCK_1
     860   00:43C6  CD 96 4C                call    PRINTHL
     861   00:43C9  18 13                   jr  CLK_AUTO_GMT
     862   00:43CB                      CLK_AUTO_CHK2:
     863   00:43CB  3D                      dec a                           ; If 2, on and turn wifi off
     864   00:43CC  20 08                   jr  nz,CLK_AUTO_3
     865   00:43CE  21 EE 66                ld  hl,MMENU_CLOCK_2
     866   00:43D1  CD 96 4C                call    PRINTHL
     867   00:43D4  18 08                   jr  CLK_AUTO_GMT
     868   00:43D6                      CLK_AUTO_3:
     869   00:43D6  21 08 67                ld  hl,MMENU_CLOCK_3
     870   00:43D9  CD 96 4C                call    PRINTHL
     871   00:43DC  18 3B                   jr  CLK_AUTO_GMT_OPT
     872   00:43DE                      CLK_AUTO_GMT:
     873   00:43DE  DD 66 01                ld  h,(ix+1)                    ; Save it for now
     874   00:43E1  DD 7E 01                ld  a,(ix+1)                    ; GMT current setting
     875   00:43E4  CB 7F                   bit 7,a                         ; If set, is -
     876   00:43E6  28 0B                   jr  z,CLK_AUTO_GMTP
     877   00:43E8  3E 2D                   ld  a,'-'
     878   00:43EA  CD A2 00                call    CHPUT
     879   00:43ED  DD CB 01 BE             res 7,(ix+1)                    ; Clear - indicator
     880   00:43F1  18 05                   jr  CLK_AUTO_GMTM
     881   00:43F3                      CLK_AUTO_GMTP:
     882   00:43F3  3E 2B                   ld  a,'+'
     883   00:43F5  CD A2 00                call    CHPUT
     884   00:43F8                      CLK_AUTO_GMTM:
     885   00:43F8  3E 09                   ld  a,9
     886   00:43FA  DD BE 01                cp  (ix+1)                      ; Greater than 9?
     887   00:43FD  30 0F                   jr  nc,CLK_AUTO_GMTD            ; If not, just print what is in A + '0'
     888   00:43FF  3E 31                   ld  a,'1'                       ; It is 1
     889   00:4401  CD A2 00                call    CHPUT
     890   00:4404  DD 7E 01                ld  a,(ix+1)
     891   00:4407  C6 26                   add '0'-10                      ; Need to subtract 10 and add '0' to print
     892   00:4409  CD A2 00                call    CHPUT
     893   00:440C  18 0B                   jr  CLK_AUTO_GMT_OPT
     894   00:440E                      CLK_AUTO_GMTD:
     895   00:440E  3E 30                   ld  a,'0'
     896   00:4410  DD 86 01                add a,(ix+1)                    ; Our value
     897   00:4413  CD A2 00                call    CHPUT
     898   00:4416  DD 74 01                ld  (ix+1),h                    ; Restore original value
     899   00:4419                      CLK_AUTO_GMT_OPT:
     900   00:4419  21 1B 67                ld  hl,MMENU_CLOCK_OPT
     901   00:441C  CD 96 4C                call    PRINTHL
     902   00:441F                      CLK_AUTO_WAIT_OPT_INPUT:
     903   00:441F  CD 9F 00                call    CHGET
     904   00:4422  FE 1B                   cp  #1b                         ; ESC?
     905   00:4424  CA 5C 42                jp  z,ESPSETUP                  ; Back to main menu
     906   00:4427  FE 30                   cp  '0'
     907   00:4429  CA 41 44                jp  z,CLK_AUTO_WAIT_GMT
     908   00:442C  FE 31                   cp  '1'
     909   00:442E  CA 41 44                jp  z,CLK_AUTO_WAIT_GMT
     910   00:4431  FE 32                   cp  '2'
     911   00:4433  CA 41 44                jp  z,CLK_AUTO_WAIT_GMT
     912   00:4436  FE 33                   cp  '3'
     913   00:4438  CA 41 44                jp  z,CLK_AUTO_WAIT_GMT
     914   00:443B  CD C0 00                call    BEEP                    ; Wrong Input, beep
     915   00:443E  C3 1F 44                jp  CLK_AUTO_WAIT_OPT_INPUT     ; And return, waiting another key
     916   00:4441                      CLK_AUTO_WAIT_GMT:
     917   00:4441  CD A2 00                call    CHPUT                   ; Print option
     918   00:4444  D6 30                   sub '0'                         ; Adjust format
     919   00:4446  DD 77 00                ld  (ix+0),a                    ; Save it
     920   00:4449  B7                      or  a
     921   00:444A  CA 38 45                jp  z,CLK_AUTO_GMT_CHK_DONE     ; And send the command if just disabling clock auto set
     922   00:444D  FE 03                   cp  3
     923   00:444F  CA 38 45                jp  z,CLK_AUTO_GMT_CHK_DONE     ; Or send the command if just disabling the adapter
     924   00:4452  21 45 67                ld  hl,MMENU_GMT_OPT
     925   00:4455  CD 96 4C                call    PRINTHL
     926   00:4458  16 00                   ld  d,0                         ; # of digits entered
     927   00:445A  1E 00                   ld  e,0                         ; # of characters printed
     928   00:445C  DD 36 01 00             ld  (ix+1),0                    ; GMT 0
     929   00:4460                      CLK_AUTO_WAIT_GMT_INPUT:
     930   00:4460  CD 9F 00                call    CHGET
     931   00:4463  FE 1B                   cp  #1b                         ; ESC?
     932   00:4465  CA 5C 42                jp  z,ESPSETUP                  ; Back to main menu
     933   00:4468  FE 0D                   cp  #0d                         ; ENTER?
     934   00:446A  CA B3 44                jp  z,CLK_AUTO_GMT_CHK_INPUT    ; Check if ok to send command
     935   00:446D  FE 08                   cp  #08                         ; Backspace?
     936   00:446F  CA 84 44                jp  z,CLK_AUTO_GMT_CHK_BS       ; Check if there is something to erase
     937   00:4472  FE 2D                   cp  '-'                         ; Negative value?
     938   00:4474  CA B3 44                jp  z,CLK_AUTO_GMT_CHK_INPUT
     939   00:4477  FE 30                   cp  '0'                         ; >=0?
     940   00:4479  DA A5 44                jp  c,CLK_AUTO_GMT_BAD_INPUT    ; If not, bad input
     941   00:447C  FE 3A                   cp  '9'+1                       ; <= 9
     942   00:447E  D2 A5 44                jp  nc,CLK_AUTO_GMT_BAD_INPUT   ; If not, bad input
     943   00:4481  C3 B3 44                jp  CLK_AUTO_GMT_CHK_INPUT      ; Otherwise, validate digit
     944   00:4484                      CLK_AUTO_GMT_CHK_BS:
     945   00:4484  AF                      xor a
     946   00:4485  BB                      cp  e                           ; Anything on screen?
     947   00:4486  28 1D                   jr  z,CLK_AUTO_GMT_BAD_INPUT    ; Nothing to erase
     948   00:4488  1D                      dec e                           ; One less character on the screen
     949   00:4489  BA                      cp  d                           ; Any digit?
     950   00:448A  28 03                   jr  z,CLK_AUTO_GMT_CHK_BS_MIN   ; If not, just erase - sign
     951   00:448C                          ; There is, so it is one less digit
     952   00:448C  15                      dec d
     953   00:448D  18 04                   jr  CLK_AUTO_GMT_CHK_DIGIT
     954   00:448F                      CLK_AUTO_GMT_CHK_BS_MIN:
     955   00:448F  DD 36 01 00             ld  (ix+1),0                    ; Reset sign
     956   00:4493                      CLK_AUTO_GMT_CHK_DIGIT:
     957   00:4493  3E 08                   ld  a,8                         ; Backspace
     958   00:4495  CD A2 00                call    CHPUT                   ; Print it
     959   00:4498  3E 20                   ld  a,' '                       ; Space
     960   00:449A  CD A2 00                call    CHPUT                   ; Print it
     961   00:449D  3E 08                   ld  a,8                         ; Backspace
     962   00:449F  CD A2 00                call    CHPUT                   ; Print it
     963   00:44A2  C3 60 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; Return
     964   00:44A5                      CLK_AUTO_GMT_BAD_INPUT:
     965   00:44A5                          ; Beep might use sub rom, and if so, all registers will be messed up, better save
     966   00:44A5  C5                      push    bc
     967   00:44A6  D5                      push    de
     968   00:44A7  F5                      push    af
     969   00:44A8  E5                      push    hl
     970   00:44A9  CD C0 00                call    BEEP                    ; Wrong Input, beep
     971   00:44AC  E1                      pop hl
     972   00:44AD  F1                      pop af
     973   00:44AE  D1                      pop de
     974   00:44AF  C1                      pop bc
     975   00:44B0  C3 60 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; And return, waiting another key
     976   00:44B3                      CLK_AUTO_GMT_CHK_INPUT:
     977   00:44B3  4F                      ld  c,a                         ; Save in C for printing if needed
     978   00:44B4  FE 2D                   cp  '-'                         ; - sign?
     979   00:44B6  20 11                   jr  nz,CLK_AUTO_GMT_CHK_CR      ; If not, check if enter
     980   00:44B8                          ; - sign
     981   00:44B8  3E 00                   ld  a,0
     982   00:44BA  BB                      cp  e                           ; If not the first character, can't accept
     983   00:44BB  20 E8                   jr  nz,CLK_AUTO_GMT_BAD_INPUT
     984   00:44BD                          ; It is the first, so let's print it
     985   00:44BD  79                      ld  a,c
     986   00:44BE  CD A2 00                call    CHPUT
     987   00:44C1  DD 36 01 80             ld  (ix+1),0x80                 ; Set the - sign bit, for now rest is zero
     988   00:44C5  1C                      inc e                           ; Increase # of characters printed
     989   00:44C6  C3 60 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; Continue waiting input
     990   00:44C9                      CLK_AUTO_GMT_CHK_CR:
     991   00:44C9  FE 0D                   cp  #0d                         ; ENTER?
     992   00:44CB  20 0F                   jr  nz,CLK_AUTO_GMT_CHK_CD      ; If not, check if digit is valid
     993   00:44CD                          ; Enter
     994   00:44CD  3E 00                   ld  a,0
     995   00:44CF  BA                      cp  d                           ; Ok, at least one digit entered?
     996   00:44D0  28 D3                   jr  z,CLK_AUTO_GMT_BAD_INPUT    ; No, so, enter is no good now
     997   00:44D2                          ; It is, if it had a digit entered and did not send, it was 1, so...
     998   00:44D2  3E 01                   ld  a,1
     999   00:44D4  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1000   00:44D7  DD 77 01                ld  (ix+1),a                    ; Save
    1001   00:44DA  18 5C                   jr  CLK_AUTO_GMT_CHK_DONE       ; Ok, ready to send
    1002   00:44DC                      CLK_AUTO_GMT_CHK_CD:
    1003   00:44DC                          ; Ok, it is a digit
    1004   00:44DC  06 30                   ld  b,'0'
    1005   00:44DE  90                      sub a,b                         ; A has digit value
    1006   00:44DF  47                      ld  b,a                         ; Save in B
    1007   00:44E0  3E 00                   ld  a,0
    1008   00:44E2  BA                      cp  d
    1009   00:44E3  20 1E                   jr  nz,CLK_AUTO_GMT_CHK_CSD     ; If not zero, it is second digit, so almost done
    1010   00:44E5                          ; 1st digit, let's check if it is other than 1, if it is, we are almost done
    1011   00:44E5  3E 01                   ld  a,1
    1012   00:44E7  B8                      cp  b
    1013   00:44E8  28 10                   jr  z,CLK_AUTO_GMT_CHK_CD.1     ; If it is 1, wait next digit or enter
    1014   00:44EA                          ; Not 1, so just adjust ix+1 and go
    1015   00:44EA  79                      ld  a,c
    1016   00:44EB  CD A2 00                call    CHPUT                   ; Print it
    1017   00:44EE  78                      ld  a,b
    1018   00:44EF  B7                      or  a
    1019   00:44F0  28 03                   jr  z,CLK_AUTO_SKIP_SIGN
    1020   00:44F2  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1021   00:44F5                      CLK_AUTO_SKIP_SIGN:
    1022   00:44F5  DD 77 01                ld  (ix+1),a                    ; Save
    1023   00:44F8  18 3E                   jr  CLK_AUTO_GMT_CHK_DONE       ; Ok, ready to send
    1024   00:44FA                      CLK_AUTO_GMT_CHK_CD.1:
    1025   00:44FA  79                      ld  a,c
    1026   00:44FB  CD A2 00                call    CHPUT                   ; Print it
    1027   00:44FE  14                      inc d                           ; Digits entered now is 1
    1028   00:44FF  1C                      inc e                           ; Digits printed increased
    1029   00:4500  C3 60 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; Continue waiting input
    1030   00:4503                      CLK_AUTO_GMT_CHK_CSD:
    1031   00:4503                          ; Second digit, easy... First was 1, now need to check if it is 0, 1 or 2, otherwise, bad entry
    1032   00:4503  78                      ld  a,b
    1033   00:4504  06 03                   ld  b,3
    1034   00:4506  B8                      cp  b
    1035   00:4507  D2 A5 44                jp  nc,CLK_AUTO_GMT_BAD_INPUT   ; 3 or more, so, not valid
    1036   00:450A  B7                      or  a                           ; Is it zero?
    1037   00:450B  20 0E                   jr  nz,CLK_AUTO_GMT_CHK_CSD1    ; If not, check for 1
    1038   00:450D                          ; It was zero
    1039   00:450D  3E 0A                   ld  a,10                        ; So, 10
    1040   00:450F  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1041   00:4512  DD 77 01                ld  (ix+1),a                    ; Save
    1042   00:4515  79                      ld  a,c
    1043   00:4516  CD A2 00                call    CHPUT                   ; Print it
    1044   00:4519  18 1D                   jr  CLK_AUTO_GMT_CHK_DONE       ; Ready to
    1045   00:451B                      CLK_AUTO_GMT_CHK_CSD1:
    1046   00:451B  3D                      dec a                           ; Is it one?
    1047   00:451C  20 0E                   jr  nz,CLK_AUTO_GMT_CHK_CSD2
    1048   00:451E                          ; It was one
    1049   00:451E  3E 0B                   ld  a,11                        ; So, eleven
    1050   00:4520  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1051   00:4523  DD 77 01                ld  (ix+1),a                    ; Save
    1052   00:4526  79                      ld  a,c
    1053   00:4527  CD A2 00                call    CHPUT                   ; Print it
    1054   00:452A  18 0C                   jr  CLK_AUTO_GMT_CHK_DONE       ; Ready to send
    1055   00:452C                      CLK_AUTO_GMT_CHK_CSD2:
    1056   00:452C                          ; It was two
    1057   00:452C  3E 0C                   ld  a,12                        ; So, twelve
    1058   00:452E  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1059   00:4531  DD 77 01                ld  (ix+1),a                    ; Save
    1060   00:4534  79                      ld  a,c
    1061   00:4535  CD A2 00                call    CHPUT                   ; Print it
    1062   00:4538                          ; And send command
    1063   00:4538                      CLK_AUTO_GMT_CHK_DONE:
    1064   00:4538  3E 0D                   ld  a,#0d
    1065   00:453A  CD A2 00                call    CHPUT
    1066   00:453D  3E 0A                   ld  a,#0a
    1067   00:453F  CD A2 00                call    CHPUT
    1068   00:4542  21 06 6D                ld  hl,STR_SENDING
    1069   00:4545  CD 96 4C                call    PRINTHL
    1070   00:4548                          CLEAR_UART
    1070   00:4548  3E 14             >     ld  a,20
    1070   00:454A  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    1071   00:454D  3E 43                   ld  a,CMD_SET_ACLK_SETTINGS
    1072   00:454F                          SEND_DATA
    1072   00:454F  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1073   00:4552  3E 00                   ld  a,0                         ; Size MSB is 0
    1074   00:4554                          SEND_DATA
    1074   00:4554  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1075   00:4557  3E 02                   ld  a,2                         ; Size LSB is 2
    1076   00:4559                          SEND_DATA
    1076   00:4559  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1077   00:455C  DD 7E 00                ld  a,(ix+0)                    ; Option
    1078   00:455F                          SEND_DATA
    1078   00:455F  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1079   00:4562  DD 7E 01                ld  a,(ix+1)                    ; GMT
    1080   00:4565                          SEND_DATA
    1080   00:4565  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1081   00:4568  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1082   00:456B  3E 43                   ld  a,CMD_SET_ACLK_SETTINGS
    1083   00:456D  CD 31 4B                call    WAIT_MENU_QCMD_RESPONSE
    1084   00:4570  21 21 6D                ld  hl,STR_SENDING_OK
    1085   00:4573  20 03                   jr  nz,CLK_AUTO_GMT_CHK_RESULT
    1086   00:4575  21 9E 6D                ld  hl,STR_SENDING_FAIL
    1087   00:4578                      CLK_AUTO_GMT_CHK_RESULT:
