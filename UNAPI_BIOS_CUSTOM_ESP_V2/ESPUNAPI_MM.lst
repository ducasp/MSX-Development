    1217   00:464F  3E 30                   ld  a,'0'
    1218   00:4651  83                      add a,e
    1219   00:4652  5F                      ld  e,a                         ; To make it easy in the selection screen
    1220   00:4653                      WIFI_SELECT_AP:
    1221   00:4653  CD 9F 00                call    CHGET
    1222   00:4656  FE 1B                   cp  #1b                         ; ESC?
