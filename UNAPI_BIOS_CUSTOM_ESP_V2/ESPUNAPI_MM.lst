    6100   00:6064  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6101   00:6067  6F                      ld  l,a
    6102   00:6068  B4                      or  h
    6103   00:6069                          ; if it was 0, no data
    6104   00:6069                          if USE_MEM_IO = 1
    6105   00:6069  CA E7 5E                jp  z,TCPIP_TCP_RCV_RET_NODATA  ; not a typo, no need to make the same code again
    6106   00:606C                          else
    6107   00:606C                    ~     jp  z,TCPIP_TCP_RCV_RET_NODATA  ; not a typo, no need to make the same code again
    6108   00:606C                    ~     endif
