    3592   00:5384                      ;========================
    3593   00:5384                      ;===  TCPIP_UDP_SEND  ===
    3594   00:5384                      ;========================
    3595   00:5384                      ;Send an UDP datagram.
    3596   00:5384                      ;
    3597   00:5384                      ;Input:  A = 11
    3598   00:5384                      ;        B = Connection number
    3599   00:5384                      ;        HL = Address of datagram data
    3600   00:5384                      ;        DE = Address of parameters block
    3601   00:5384                      ;Output: A = Error code
    3602   00:5384                      ;
    3603   00:5384                      ;Parameters block:
    3604   00:5384                      ;
    3605   00:5384                      ;    +0 (4): Destination IP address
    3606   00:5384                      ;    +4 (2): Destination port
    3607   00:5384                      ;    +6 (2): Data length
    3608   00:5384                      TCPIP_UDP_SEND:
    3609   00:5384  E5                      push    hl
    3610   00:5385  D5                      push    de
    3611   00:5386                          SEND_DATA                       ; Send the command
    3611   00:5386  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3612   00:5389                          ; prepare new data size, adding our 7 bytes overhead
    3613   00:5389  DD 62                   ld  ixh,d
    3614   00:538B  DD 6B                   ld  ixl,e
    3615   00:538D  11 07 00                ld  de,7
    3616   00:5390  DD 6E 06                ld  l,(ix+6)
    3617   00:5393  DD 66 07                ld  h,(ix+7)
    3618   00:5396  19                      add hl,de
    3619   00:5397  7C                      ld  a,h
    3620   00:5398                          SEND_DATA                       ; Send the command size msb
    3620   00:5398  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3621   00:539B  7D                      ld  a,l
    3622   00:539C                          SEND_DATA                       ; Send the command size lsb
    3622   00:539C  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3623   00:539F  78                      ld  a,b
    3624   00:53A0                          SEND_DATA                       ; Send the connection #
    3624   00:53A0  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3625   00:53A3  D1                      pop de
    3626   00:53A4  E1                      pop hl
    3627   00:53A5  1A                      ld  a,(de)
    3628   00:53A6                          SEND_DATA                       ; Send IP byte 1
    3628   00:53A6  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3629   00:53A9  13                      inc de
    3630   00:53AA  1A                      ld  a,(de)
    3631   00:53AB                          SEND_DATA                       ; Send IP byte 2
    3631   00:53AB  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3632   00:53AE  13                      inc de
    3633   00:53AF  1A                      ld  a,(de)
    3634   00:53B0                          SEND_DATA                       ; Send IP byte 3
    3634   00:53B0  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3635   00:53B3  13                      inc de
    3636   00:53B4  1A                      ld  a,(de)
    3637   00:53B5                          SEND_DATA                       ; Send IP byte 4
    3637   00:53B5  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3638   00:53B8  13                      inc de
    3639   00:53B9  1A                      ld  a,(de)
    3640   00:53BA                          SEND_DATA                       ; Send Port LSB
    3640   00:53BA  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3641   00:53BD  13                      inc de
    3642   00:53BE  1A                      ld  a,(de)
    3643   00:53BF                          SEND_DATA                       ; Send Port MSB
    3643   00:53BF  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3644   00:53C2                          ; now oti the data starting at hl, size is in next DE position
    3645   00:53C2  13                      inc de
    3646   00:53C3  1A                      ld  a,(de)
    3647   00:53C4  47                      ld  b,a                         ; save lsb in b
    3648   00:53C5  13                      inc de
    3649   00:53C6  1A                      ld  a,(de)                      ; msb
    3650   00:53C7  57                      ld  d,a                         ; put in D, there is no ld d,(de)
    3651   00:53C8  58                      ld  e,b                         ; lsb
    3652   00:53C9                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    3653   00:53C9                          ;ld b,e                         ; Number of loops originaly in DE, not needed, b already has e
    3654   00:53C9  1B                      dec de
    3655   00:53CA  14                      inc d
    3656   00:53CB                          if USE_MEM_IO = 0
    3657   00:53CB                    ~     ld  c,OUT_TX_PORT
    3658   00:53CB                    ~ TCPIP_UDP_SEND_R:
    3659   00:53CB                    ~     otir                            ; Send until B is 0
    3660   00:53CB                    ~     else
    3661   00:53CB                      TCPIP_UDP_SEND_R:
    3662   00:53CB  7E                      ld  a,(hl)
    3663   00:53CC  32 07 7F                ld  (MEM_OUT_TX_PORT),a
    3664   00:53CF  23                      inc hl
    3665   00:53D0  10 F9                   djnz TCPIP_UDP_SEND_R
    3666   00:53D2                          endif
    3667   00:53D2  15                      dec d                           ; decrement secondary counter
    3668   00:53D3  20 F6                   jr  nz,TCPIP_UDP_SEND_R         ; If still have another round, do it
    3669   00:53D5                          ; Now wait up to 600 ticks to get response
    3670   00:53D5  21 58 02                ld  hl,600
    3671   00:53D8  CD 36 61                call    SETCOUNTER
    3672   00:53DB                      TCPIP_UDP_SEND_ST1:
    3673   00:53DB                          CHECK_DATA
    3673   00:53DB  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3673   00:53DE  CB 47             >     bit 0,a
    3674   00:53E0  20 05                   jr  nz,TCPIP_UDP_SEND_ST1.1
    3675   00:53E2  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3676   00:53E5  18 F4                   jr  TCPIP_UDP_SEND_ST1
    3677   00:53E7                      TCPIP_UDP_SEND_ST1.1:
    3678   00:53E7                          ; nz, check the data
    3679   00:53E7                          RECEIVE_DATA
    3679   00:53E7  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3680   00:53EA  FE 0B                   cp  11                          ; Is response of our command?
    3681   00:53EC  20 ED                   jr  nz,TCPIP_UDP_SEND_ST1
    3682   00:53EE                          ; now get return code, if return code other than 0, it is finished
    3683   00:53EE                      TCPIP_UDP_SEND_RC:
    3684   00:53EE                          CHECK_DATA
    3684   00:53EE  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3684   00:53F1  CB 47             >     bit 0,a
    3685   00:53F3  20 05                   jr  nz,TCPIP_UDP_SEND_RC.1
    3686   00:53F5  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3687   00:53F8  18 F4                   jr  TCPIP_UDP_SEND_RC
    3688   00:53FA                      TCPIP_UDP_SEND_RC.1:
    3689   00:53FA                          ; nz, discard
    3690   00:53FA                          RECEIVE_DATA
    3690   00:53FA  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3691   00:53FD  B7                      or  a                           ; 0?
    3692   00:53FE  C0                      ret nz                          ; if not, done
    3693   00:53FF                      
    3694   00:53FF                          ; next two bytes are return code and size bytes, don't care, it is 0
    3695   00:53FF  06 02                   ld  b,2
    3696   00:5401                      TCPIP_UDP_SEND_ST2:
    3697   00:5401                          CHECK_DATA
    3697   00:5401  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3697   00:5404  CB 47             >     bit 0,a
    3698   00:5406  20 05                   jr  nz,TCPIP_UDP_SEND_ST2.1
    3699   00:5408  CD 27 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3700   00:540B  18 F4                   jr  TCPIP_UDP_SEND_ST2
    3701   00:540D                      TCPIP_UDP_SEND_ST2.1:
    3702   00:540D                          ; nz, discard
    3703   00:540D                          RECEIVE_DATA
    3703   00:540D  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3704   00:5410  05                      dec b
    3705   00:5411  20 EE                   jr  nz,TCPIP_UDP_SEND_ST2
    3706   00:5413                      
    3707   00:5413                          ; done, no return data other than return code
    3708   00:5413  AF                      xor a
    3709   00:5414  C9                      ret
    3710   00:5415                      
    3711   00:5415                      ;=======================
    3712   00:5415                      ;===  TCPIP_UDP_RCV  ===
    3713   00:5415                      ;=======================
    3714   00:5415                      ;Retrieve an incoming UDP datagram.
    3715   00:5415                      ;
    3716   00:5415                      ;Input:  A = 12
    3717   00:5415                      ;        B = Connection number
    3718   00:5415                      ;        HL = Address for datagram data
    3719   00:5415                      ;        DE = Maximum data size to retrieve
    3720   00:5415                      ;Output: A = Error code
    3721   00:5415                      ;        L.H.E.D = Source IP address
    3722   00:5415                      ;        IX = Source port
    3723   00:5415                      ;        BC = Actual received data size
    3724   00:5415                      
    3725   00:5415                      ; Customized TIME OUT routine: If time out receiving data, retry as received data
    3726   00:5415                      ; won't be re-sent as host is unaware of this
    3727   00:5415                      TCPIP_UDP_RCV_CHECK_TIME_OUT:
    3728   00:5415                          ; Save registers other than AF
    3729   00:5415  C5                      push bc
    3730   00:5416  D5                      push de
    3731   00:5417  E5                      push hl
    3732   00:5418  CD 27 61                call    GETCOUNTER
    3733   00:541B  7D                      ld  a,l
    3734   00:541C  B4                      or  h
    3735   00:541D                          ; Restore registers, we are returning
    3736   00:541D  E1                      pop hl
    3737   00:541E  D1                      pop de
    3738   00:541F  C1                      pop bc
    3739   00:5420  C0                      ret nz
    3740   00:5421                          ; Ok, timeout...
    3741   00:5421  F1                      pop af                          ; Get return address of who called this out of the stack, we will return from the function or re-start
    3742   00:5422                      TCPIP_TCP_UDP_RETRY_QRCV:
    3743   00:5422  CD 46 61                call    GETBYTE
    3744   00:5425  B7                      or  a
    3745   00:5426  28 0C                   jr  z,TCPIP_UDP_RCV_CHECK_TIME_OUT.NORXRETRY
    3746   00:5428                          ; Ok, so let's ask ESP to re-send the data and retry receiving it
    3747   00:5428  3D                      dec a
    3748   00:5429  CD 58 61                call    SETBYTE                 ; we are retrying it
    3749   00:542C  3E 72                   ld  a,'r'                       ; retry transmission command
    3750   00:542E                          SEND_DATA
    3750   00:542E  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3751   00:5431  C3 59 54                jp  TCPIP_UDP_RCV.RXRETRY       ; and retry it
    3752   00:5434                      TCPIP_UDP_RCV_CHECK_TIME_OUT.NORXRETRY:
    3753   00:5434  3E 0F                   ld  a,ERR_INV_OPER
    3754   00:5436  C9                      ret                             ; and return the function itself
    3755   00:5437                      
    3756   00:5437                      TCPIP_UDP_RCV:
    3757   00:5437  CD 7F 61                call    SETWORD                 ; Save for later the datagram address
    3758   00:543A  3E 0C                   ld  a,12
    3759   00:543C                          SEND_DATA                       ; Send the command
    3759   00:543C  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3760   00:543F  AF                      xor a
    3761   00:5440                          SEND_DATA                       ; Send the command size msb
    3761   00:5440  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3762   00:5443  3E 03                   ld  a,3
    3763   00:5445                          SEND_DATA                       ; Send the command size lsb
    3763   00:5445  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3764   00:5448  78                      ld  a,b
    3765   00:5449                          SEND_DATA                       ; Send the connection #
    3765   00:5449  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3766   00:544C  7B                      ld  a,e
    3767   00:544D                          SEND_DATA                       ; Send MAX rcv size LSB
    3767   00:544D  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3768   00:5450  7A                      ld  a,d
    3769   00:5451                          SEND_DATA                       ; Send MAX rcv size MSB
    3769   00:5451  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3770   00:5454  3E 03                   ld  a,3
    3771   00:5456  CD 58 61                call    SETBYTE                 ; Ok, retry up to three times
    3772   00:5459                      TCPIP_UDP_RCV.RXRETRY:
    3773   00:5459                          ; Now wait up to 600 ticks to get response
    3774   00:5459  21 58 02                ld  hl,600
    3775   00:545C  CD 36 61                call    SETCOUNTER
    3776   00:545F                      TCPIP_UDP_RCV_ST1:
    3777   00:545F                          CHECK_DATA
    3777   00:545F  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3777   00:5462  CB 47             >     bit 0,a
    3778   00:5464  20 05                   jr  nz,TCPIP_UDP_RCV_ST1.1
    3779   00:5466  CD 15 54                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3780   00:5469  18 F4                   jr  TCPIP_UDP_RCV_ST1
    3781   00:546B                      TCPIP_UDP_RCV_ST1.1:
    3782   00:546B                          ; nz, check the data
    3783   00:546B                          RECEIVE_DATA
    3783   00:546B  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3784   00:546E  FE 0C                   cp  12                          ; Is response of our command?
    3785   00:5470  20 ED                   jr  nz,TCPIP_UDP_RCV_ST1
    3786   00:5472                          ; At this point, all data is being buffered, so 30 ticks, half second, is more than enough time-out
    3787   00:5472  F3                      di
    3788   00:5473  21 1E 00                ld  hl,30
    3789   00:5476  CD 36 61                call    SETCOUNTER
    3790   00:5479  FB                      ei
    3791   00:547A                          ; now get return code, if return code other than 0, it is finished
    3792   00:547A                      TCPIP_UDP_RCV_RC:
    3793   00:547A                          CHECK_DATA
    3793   00:547A  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3793   00:547D  CB 47             >     bit 0,a
    3794   00:547F  20 05                   jr  nz,TCPIP_UDP_RCV_RC.1
    3795   00:5481  CD 15 54                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3796   00:5484  18 F4                   jr  TCPIP_UDP_RCV_RC
    3797   00:5486                      TCPIP_UDP_RCV_RC.1:
    3798   00:5486                          ; nz, discard
