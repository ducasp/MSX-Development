    4293   00:56CA                      SSH_OPEN_SENDCMD:
    4294   00:56CA                          ; Ok, so, DE has the full data size, let's start sending from here
    4295   00:56CA  3E 82                   ld  a,#82                       ; Function SSH OPEN
    4296   00:56CC                          SEND_DATA                       ; Send the command
    4296   00:56CC  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
