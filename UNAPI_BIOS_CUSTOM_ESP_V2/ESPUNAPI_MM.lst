    5878   00:5F25                          ; nz, low byte count of bytes to receive
    5879   00:5F25                          RECEIVE_DATA
    5879   00:5F25  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5880   00:5F28  6F                      ld  l,a
    5881   00:5F29  CD 46 61                call    GETBYTE                 ; if return was err buff...
    5882   00:5F2C  D6 0D                   sub 13
    5883   00:5F2E  20 23                   jr  nz,SSH_AUTH_GET_CHALLENGE_ST2BB.1
    5884   00:5F30                          ; If here we need to have A as 13, B and C with needed buffer size
    5885   00:5F30                      SSH_AUTH_GET_CHALLENGE_BUFERRA:
    5886   00:5F30                          CHECK_DATA
    5886   00:5F30  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5886   00:5F33  CB 47             >     bit 0,a
    5887   00:5F35  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_BUFERRA.1
    5888   00:5F37  CD 84 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5889   00:5F3A  18 F4                   jr  SSH_AUTH_GET_CHALLENGE_BUFERRA
    5890   00:5F3C                      SSH_AUTH_GET_CHALLENGE_BUFERRA.1:
    5891   00:5F3C                          ; nz, low byte count of bytes to receive
    5892   00:5F3C                          RECEIVE_DATA
    5892   00:5F3C  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5893   00:5F3F  4F                      ld c,a
    5894   00:5F40                      SSH_AUTH_GET_CHALLENGE_BUFERRB:
    5895   00:5F40                          CHECK_DATA
    5895   00:5F40  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5895   00:5F43  CB 47             >     bit 0,a
    5896   00:5F45  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_BUFERRB.1
    5897   00:5F47  CD 84 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5898   00:5F4A  18 F4                   jr  SSH_AUTH_GET_CHALLENGE_BUFERRB
    5899   00:5F4C                      SSH_AUTH_GET_CHALLENGE_BUFERRB.1:
    5900   00:5F4C                          ; nz, high byte count of bytes to receive
    5901   00:5F4C                          RECEIVE_DATA
    5901   00:5F4C  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5902   00:5F4F  47                      ld  b,a
    5903   00:5F50  3E 0D                   ld  a,13                        ; ERR BUFF
    5904   00:5F52  C9                      ret
    5905   00:5F53                          ; If here, should be ok and will get the data
    5906   00:5F53                      SSH_AUTH_GET_CHALLENGE_ST2BB.1:
    5907   00:5F53  7D                      ld  a,l
    5908   00:5F54  B4                      or  h
    5909   00:5F55                          ; if it was 0, no data
    5910   00:5F55  CA BC 5C                jp  z,TCPIP_TCP_RCV_RET_NODATA  ; not a typo, no need to make the same code again
    5911   00:5F58                          ; Ok, we need to get the flags that will go to HL, we get it in BC and then push to the stack
    5912   00:5F58                      SSH_AUTH_GET_CHALLENGE_FLAGSA:
    5913   00:5F58                          CHECK_DATA
    5913   00:5F58  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5913   00:5F5B  CB 47             >     bit 0,a
    5914   00:5F5D  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_FLAGSA.1
    5915   00:5F5F  CD 84 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5916   00:5F62  18 F4                   jr  SSH_AUTH_GET_CHALLENGE_FLAGSA
    5917   00:5F64                      SSH_AUTH_GET_CHALLENGE_FLAGSA.1:
    5918   00:5F64                          ; nz, prompts, B to later go to H
    5919   00:5F64                          RECEIVE_DATA
    5919   00:5F64  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5920   00:5F67  47                      ld b,a
    5921   00:5F68                      SSH_AUTH_GET_CHALLENGE_FLAGSB:
    5922   00:5F68                          CHECK_DATA
    5922   00:5F68  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5922   00:5F6B  CB 47             >     bit 0,a
    5923   00:5F6D  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_FLAGSB.1
    5924   00:5F6F  CD 84 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5925   00:5F72  18 F4                   jr  SSH_AUTH_GET_CHALLENGE_FLAGSB
    5926   00:5F74                      SSH_AUTH_GET_CHALLENGE_FLAGSB.1:
    5927   00:5F74                          ; nz, prompts, C to later go to L
    5928   00:5F74                          RECEIVE_DATA
    5928   00:5F74  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5929   00:5F77  4F                      ld c,a
    5930   00:5F78  C5                      push    bc                      ; stack has the flags
    5931   00:5F79                          ; Now let's decrease HL as we've read 2 bytes
    5932   00:5F79  2B                      dec hl
    5933   00:5F7A  2B                      dec hl
    5934   00:5F7B                          ; And loop for the whole remaining response
    5935   00:5F7B  4D                      ld  c,l
    5936   00:5F7C  44                      ld  b,h                         ; BC has effective received data size, as well as HL
    5937   00:5F7D                          ; put effective data size in de
    5938   00:5F7D  EB                      ex  de,hl
    5939   00:5F7E                          ; will start moving at address in stack (we've pushed the adress in WORD)
    5940   00:5F7E  CD 6C 61                call    GETWORD
    5941   00:5F81  CD DF 61                call    BCBACKUP                ; save count (BC)
    5942   00:5F84                      
    5943   00:5F84                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use ini :-D
    5944   00:5F84  43                      ld  b,e                         ; Number of loops originaly in DE
    5945   00:5F85  1B                      dec de
    5946   00:5F86  14                      inc d
    5947   00:5F87                          if USE_MEM_IO = 0
    5948   00:5F87                    ~     ld  c,IN_DATA_PORT
    5949   00:5F87                    ~     CHECK_QUICK_RECEIVE
    5950   00:5F87                    ~     jr  z,SSH_AUTH_GET_CHALLENGE_R_NSF             ; If not, go to the old, slower route
    5951   00:5F87                    ~     ; Otherwise, let's speed it up baby!
    5952   00:5F87                    ~ SSH_AUTH_GET_CHALLENGE_R:
    5953   00:5F87                    ~     inir
    5954   00:5F87                    ~     else
    5955   00:5F87                          CHECK_QUICK_RECEIVE
    5955   00:5F87  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5955   00:5F8A  CB 5F             >     bit 3,a
    5956   00:5F8C  28 1A                   jr  z,SSH_AUTH_GET_CHALLENGE_R_NSF       ; If not, go to the old, slower route
    5957   00:5F8E                          ; Otherwise, let's speed it up baby!
    5958   00:5F8E                      SSH_AUTH_GET_CHALLENGE_R:
    5959   00:5F8E  3A 06 7F                ld  a,(MEM_IN_DATA_PORT)
    5960   00:5F91  77                      ld  (hl),a
    5961   00:5F92  23                      inc hl
    5962   00:5F93  10 F9                   djnz SSH_AUTH_GET_CHALLENGE_R
    5963   00:5F95                          endif
    5964   00:5F95  15                      dec d
    5965   00:5F96  20 F6                   jr nz,SSH_AUTH_GET_CHALLENGE_R
    5966   00:5F98                          CHECK_BUFFER_UNDERRUN
    5966   00:5F98  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5966   00:5F9B  CB 67             >     bit 4,a
    5967   00:5F9D  C2 8D 5E                jp  nz,SSH_AUTH_GET_CHALLENGE_RETRY_QRCV ; If yes, retry
    5968   00:5FA0                          ; Otherwise, done
    5969   00:5FA0  CD CD 61                call    BCRESTORE               ; done, restore return data in BC
    5970   00:5FA3  03                      inc bc
    5971   00:5FA4  03                      inc bc
    5972   00:5FA5                          ; get flags back from stack
    5973   00:5FA5  E1                      pop hl
    5974   00:5FA6  AF                      xor a
    5975   00:5FA7  C9                      ret
    5976   00:5FA8                      SSH_AUTH_GET_CHALLENGE_R_NSF:
    5977   00:5FA8                          CHECK_DATA
    5977   00:5FA8  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5977   00:5FAB  CB 47             >     bit 0,a
    5978   00:5FAD  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_R_NSF.1
    5979   00:5FAF  CD 84 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5980   00:5FB2  18 F4                   jr  SSH_AUTH_GET_CHALLENGE_R_NSF
    5981   00:5FB4                      SSH_AUTH_GET_CHALLENGE_R_NSF.1:
    5982   00:5FB4                          if USE_MEM_IO = 0
    5983   00:5FB4                    ~     ini
    5984   00:5FB4                    ~     else
    5985   00:5FB4  3A 06 7F                ld  a,(MEM_IN_DATA_PORT)
    5986   00:5FB7  77                      ld  (hl),a
    5987   00:5FB8  23                      inc hl
    5988   00:5FB9  05                      dec b
    5989   00:5FBA                          endif
    5990   00:5FBA  20 EC                   jr  nz,SSH_AUTH_GET_CHALLENGE_R_NSF
    5991   00:5FBC  15                      dec d
    5992   00:5FBD  20 E9                   jr nz,SSH_AUTH_GET_CHALLENGE_R_NSF
    5993   00:5FBF  CD CD 61                call    BCRESTORE               ; done, restore return data in BC
    5994   00:5FC2  03                      inc bc
    5995   00:5FC3  03                      inc bc
    5996   00:5FC4                          ; get flags back from stack
    5997   00:5FC4  E1                      pop hl
    5998   00:5FC5  AF                      xor a
    5999   00:5FC6  C9                      ret
