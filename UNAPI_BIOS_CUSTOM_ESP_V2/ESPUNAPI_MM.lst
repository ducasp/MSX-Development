    3052   00:50D7  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3053   00:50DA  FE 03                   cp  3                           ; Is response of our command?
    3054   00:50DC  20 ED                   jr  nz,TCPIP_NET_STATE_ST1
