    6117   00:6075                      
    6118   00:6075                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use ini :-D
    6119   00:6075  43                      ld  b,e                         ; Number of loops originaly in DE
    6120   00:6076  1B                      dec de
    6121   00:6077  14                      inc d
    6122   00:6078                          if USE_MEM_IO = 0
    6123   00:6078                    ~     ld  c,IN_DATA_PORT
    6124   00:6078                    ~     CHECK_QUICK_RECEIVE
    6125   00:6078                    ~     jr  z,SSH_RCV_R_NSF             ; If not, go to the old, slower route
    6126   00:6078                    ~     ; Otherwise, let's speed it up baby!
    6127   00:6078                    ~ SSH_RCV_R:
