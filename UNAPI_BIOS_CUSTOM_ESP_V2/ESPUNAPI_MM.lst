    1215   00:4647  3E 30                   ld  a,'0'
    1216   00:4649  83                      add a,e
    1217   00:464A  5F                      ld  e,a                         ; To make it easy in the selection screen
    1218   00:464B                      WIFI_SELECT_AP:
