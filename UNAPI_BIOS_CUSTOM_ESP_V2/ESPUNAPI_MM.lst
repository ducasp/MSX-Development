    4317   00:56E1  10 F9                   djnz SSH_OPEN_SENDDATA
    4318   00:56E3                          endif
    4319   00:56E3  15                      dec d
    4320   00:56E4  20 F6                   jr  nz,SSH_OPEN_SENDDATA
    4321   00:56E6                          ; Now wait up to 3600 (1 minute @ 60Hz) ticks to get response
    4322   00:56E6  21 10 0E                ld  hl,3600
    4323   00:56E9  CD 61 63                call    SETCOUNTER
