    5467   00:5D2B  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5468   00:5D2E  DD 6F                   ld  ixl,a
    5469   00:5D30                      TCPIP_TCP_STATE_RESP_ST8:
    5470   00:5D30                          CHECK_DATA
    5470   00:5D30  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5470   00:5D33  CB 47             >     bit 0,a
    5471   00:5D35  20 05                   jr  nz,TCPIP_TCP_STATE_RESP_ST8.1
    5472   00:5D37  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5473   00:5D3A  18 F4                   jr  TCPIP_TCP_STATE_RESP_ST8
