    1647   00:492F  CD 9D 4C                call    PRINTHL                 ; Print options
    1648   00:4932                      SET_NAGLE_WI_OFF:
    1649   00:4932  CD 9F 00                call    CHGET
    1650   00:4935  FE 1B                   cp  #1b                         ; ESC?
    1651   00:4937  CA 5E 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1652   00:493A  FE 4F                   cp  'O'                         ; Toggle Nagle Off
    1653   00:493C  CA 8A 49                jp  z,SET_NAGLE_OFF             ;
    1654   00:493F  FE 6F                   cp  'o'                         ; Toggle Nagle Off
    1655   00:4941  CA 8A 49                jp  z,SET_NAGLE_OFF             ;
    1656   00:4944  CD C0 00                call    BEEP                    ; Wrong Input, beep
    1657   00:4947  C3 32 49                jp  SET_NAGLE_WI_OFF            ; And return waiting key
