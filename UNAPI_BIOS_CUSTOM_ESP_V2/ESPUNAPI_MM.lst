    1224   00:465B  FE 20                   cp  #20                         ; Spacebar?
    1225   00:465D  CA 71 46                jp  z,WIFI_SELECT_SPACEBAR      ; Check if re-scan or next page
    1226   00:4660  FE 0D                   cp  CR                          ; ENTER?
