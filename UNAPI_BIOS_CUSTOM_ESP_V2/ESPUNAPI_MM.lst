    3023   00:50BB                      ;=========================
    3024   00:50BB                      ;===  TCPIP_NET_STATE  ===
    3025   00:50BB                      ;=========================
    3026   00:50BB                      ;Get network state.
    3027   00:50BB                      ;
    3028   00:50BB                      ;Input:  A = 3
    3029   00:50BB                      ;Output: A = Error code
    3030   00:50BB                      ;        B = Current network state:
    3031   00:50BB                      ;            0: Closed
    3032   00:50BB                      ;            1: Opening
    3033   00:50BB                      ;            2: Open
    3034   00:50BB                      ;            3: Closing
