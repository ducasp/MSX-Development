    7262   00:651B  ED 5B 76 F6             ld  de,(TXTTAB)                 ; Borrow Basic program area for now....
    7263   00:651F  DD 6B                   ld  ixl,e
    7264   00:6521  DD 62                   ld  ixh,d                       ; Address in IX
    7265   00:6523  CD 6E 4B                call    WAIT_MENU_CMD_RESPONSE
    7266   00:6526  F5                      push    af
    7267   00:6527  CD C1 62                call    GETSLT
    7268   00:652A  CD 2E 63                call    GETMEMPOINTERADDR       ; This is where we are going to store our memory area address
    7269   00:652D  11 07 00                ld  de,7
    7270   00:6530  19                      add hl,de
    7271   00:6531  F1                      pop af
    7272   00:6532  77                      ld  (hl),a
    7273   00:6533  B7                      or  a
    7274   00:6534  DD E1                   pop ix
    7275   00:6536  FD E1                   pop iy
    7276   00:6538  D1                      pop de
    7277   00:6539  E1                      pop hl
    7278   00:653A  C9                      ret
    7279   00:653B                      
    7280   00:653B                      ;*********************************************
    7281   00:653B                      ;***              RESET ESP                ***
    7282   00:653B                      ;*** If RESET ok, A will be 0, otherwise   ***
    7283   00:653B                      ;*** failure                               ***
    7284   00:653B                      ;*********************************************
    7285   00:653B                      RESET_ESP:
    7286   00:653B                          ; Is ESP installed?
    7287   00:653B                          CLEAR_UART                      ; Clear UART
    7287   00:653B  3E 14             >     ld  a,20
    7287   00:653D  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    7288   00:6540  3E 3F                   ld  a,CMD_QUERY_ESP
    7289   00:6542                          SEND_DATA
    7289   00:6542  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    7290   00:6545  21 DA 66                ld  hl,RSP_CMD_QUERY_ESP        ; Expected response
    7291   00:6548  11 3C 00                ld  de,60                       ; Up to 1s @ 60Hz
    7292   00:654B  3E 02                   ld  a,RSP_CMD_QUERY_ESP_SIZE    ; Size of response
    7293   00:654D  CD D8 64                call    WAIT_RESPONSE_FROM_ESP
    7294   00:6550  B7                      or  a
    7295   00:6551  3E 01                   ld  a,1
    7296   00:6553  28 03                   jr  z,RESET_ESP_INIT            ; ESP Found
    7297   00:6555  06 00                   ld  b,0                         ; 0 if no response
    7298   00:6557  C9                      ret
    7299   00:6558                      RESET_ESP_INIT:
    7300   00:6558  06 03                   ld  b,3                         ; Retry up to 10 times
    7301   00:655A                      RESET_ESP_LOOP:
    7302   00:655A                          CLEAR_UART
    7302   00:655A  3E 14             >     ld  a,20
    7302   00:655C  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    7303   00:655F                          SET_SPEED
    7303   00:655F  AF                >     xor a
    7303   00:6560  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    7304   00:6563  76                      halt
    7305   00:6564  76                      halt                            ; Wait a little to make sure speed is adjusted
    7306   00:6565  3E 57                   ld  a,CMD_WRESET_ESP
    7307   00:6567                          SEND_DATA
    7307   00:6567  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    7308   00:656A  21 D5 66                ld  hl,RSP_CMD_RESET_ESP        ; Expected response
    7309   00:656D  11 5A 00                ld  de,90                       ; Up to 1.5s @ 60Hz
    7310   00:6570  3E 05                   ld  a,RSP_CMD_RESET_ESP_SIZE    ; Size of response
    7311   00:6572  C5                      push    bc                      ; Save retry counter
    7312   00:6573  CD D8 64                call    WAIT_RESPONSE_FROM_ESP
    7313   00:6576  C1                      pop bc                          ; restore retry counter
    7314   00:6577  B7                      or  a                           ; Did WAIT RESPONSE return zero?
    7315   00:6578  C8                      ret z                           ; Yes, Warm Reset Ok
    7316   00:6579  10 DF                   djnz RESET_ESP_LOOP             ; No, decrement retry counter and let the loop check
    7317   00:657B                          ; No more retries? Then check if it is old ESP FW
    7318   00:657B                      RESET_CHK_IF_INSTALLED:
    7319   00:657B                          ; No more retries? Then it is old ESP FW
    7320   00:657B  06 01                   ld  b,1
    7321   00:657D  C9                      ret
    7322   00:657E                      
    7323   00:657E                      ;*********************************************
    7324   00:657E                      ;***              SET TIME                 ***
    7325   00:657E                      ;*** H - Hour                              ***
    7326   00:657E                      ;*** L - Minutes                           ***
    7327   00:657E                      ;*** D - Seconds                           ***
    7328   00:657E                      ;***                                       ***
    7329   00:657E                      ;*** A - 0 if Ok otherwise invalid time    ***
    7330   00:657E                      ;*********************************************
    7331   00:657E                      SET_TIME:
    7332   00:657E  7C                      ld  a,h                         ; Hour in A
    7333   00:657F  FE 18                   cp  24                          ; Compare to 24
    7334   00:6581  30 12                   jr  nc,SET_TIME_ERR             ; If 24 or more, invalid
    7335   00:6583  7D                      ld  a,l                         ; Minutes in A
    7336   00:6584  FE 3C                   cp  60                          ; Compare to 60
    7337   00:6586  30 0D                   jr  nc,SET_TIME_ERR             ; If 60 or more, invalid
    7338   00:6588  7A                      LD  a,d                         ; Seconds in D
    7339   00:6589  FE 3C                   cp  60                          ; Compare to 60
    7340   00:658B  30 08                   jr  nc,SET_TIME_ERR             ; If 60 or more invalid
    7341   00:658D  44                      ld  b,h                         ; Hour in B
    7342   00:658E  4D                      ld  c,l                         ; Minutes in C
    7343   00:658F  5A                      ld  e,d                         ; Seconds in E
    7344   00:6590  CD 98 65                call    SET_RTC_TIME            ; Set time in RTC
    7345   00:6593  AF                      xor a                           ; 0 in A
    7346   00:6594  C9                      ret                             ; Return
    7347   00:6595                      ;   Invalid parameter
    7348   00:6595                      SET_TIME_ERR:
    7349   00:6595  3E 01                   ld  a,1                         ; Invalid Time
    7350   00:6597  C9                      ret                             ; Return
    7351   00:6598                      
    7352   00:6598                      SET_RTC_TIME:
    7353   00:6598  6B                      ld  l,e                         ; Seconds in L
    7354   00:6599  61                      ld  h,c                         ; Minutes in H
    7355   00:659A  50                      ld  d,b                         ; Hour in D
    7356   00:659B  CD F3 65                call    STOP_RTC_COUNT_SET_MODE0; Select RTC Register 13, and set Mode / Page 0
    7357   00:659E  3E 0F                   ld  a,#F                        ; Register F
    7358   00:65A0  D3 B4                   out (#B4),a
    7359   00:65A2  3E 02                   ld  a,2
    7360   00:65A4  D3 B5                   out (#B5),a                     ; Timer reset seconds and on both clock pulses
    7361   00:65A6  1E 00                   ld  e,0                         ; Start at register 0
    7362   00:65A8  C3 2E 66                jp  SET_RTC_DATE.1              ; And save L, H and D, function will return from there
    7363   00:65AB                      
    7364   00:65AB                      ;*********************************************
    7365   00:65AB                      ;***              SET DATE                 ***
    7366   00:65AB                      ;*** HL - Year from 1980 to 2079           ***
    7367   00:65AB                      ;*** D - Month from 1 to 12                ***
    7368   00:65AB                      ;*** E - Day from 1 to 31                  ***
    7369   00:65AB                      ;***                                       ***
    7370   00:65AB                      ;*** A - 0 if Ok otherwise invalid Date    ***
    7371   00:65AB                      ;*********************************************
    7372   00:65AB                      SET_DATE:
    7373   00:65AB  01 44 F8                ld  bc,#F844
    7374   00:65AE  09                      add hl,bc
    7375   00:65AF  30 32                   jr  nc,SET_DATE_ERR             ; No carry -> Year is less than 1980, invalid date
    7376   00:65B1  7C                      ld  a,h
    7377   00:65B2  B7                      or  a
    7378   00:65B3  20 2E                   jr  nz,SET_DATE_ERR             ; If H is set, means year is greater than 2235 ,invalid
    7379   00:65B5  7D                      ld  a,l
    7380   00:65B6  FE 64                   cp  100
    7381   00:65B8  30 29                   jr  nc,SET_DATE_ERR             ; If L >= 100 year is greater than 2079, invalid
    7382   00:65BA  47                      ld  b,a                         ; Year - 1980 in B
    7383   00:65BB  7A                      ld  a,d                         ; Now test month
    7384   00:65BC  3D                      dec a
    7385   00:65BD  FE 0C                   cp  12                          ; If 12 or less this should carry
    7386   00:65BF  30 22                   jr  nc,SET_DATE_ERR             ; otherwise invalid
    7387   00:65C1  21 E6 65                ld  hl,DAYS_IN_MONTH            ; Days in Month table
    7388   00:65C4  85                      add a,l                         ; add our month
    7389   00:65C5  6F                      ld  l,a                         ; back in L
    7390   00:65C6  30 01                   jr  nc,SET_DATE1                ; no carry done
    7391   00:65C8  24                      inc h                           ; otherwise increase H
    7392   00:65C9                      SET_DATE1:
    7393   00:65C9  3E 1C                   ld  a,28                        ; 28 days
    7394   00:65CB  BE                      cp  (hl)                        ; If month is 28 days, February, need to check if leap and limit is 29 in this year
    7395   00:65CC  20 08                   jr  nz,SET_DATE2                ; if not, skip below code , so probably above check is if month is february
    7396   00:65CE  78                      ld  a,b                         ; Year - 1980 in A again
    7397   00:65CF  E6 03                   and 3                           ; if other than 0, non divisible per 4, so not a leap year
    7398   00:65D1  20 03                   jr  nz,SET_DATE2                ; Regular year
    7399   00:65D3  21 F2 65                ld  hl,DAYS_IN_FEBRUARY_LEAP    ; HL has address of 29 days, maximum number of days for february in leap year
    7400   00:65D6                      SET_DATE2:
    7401   00:65D6  7B                      ld  a,e                         ; Day of month in A
    7402   00:65D7  3D                      dec a                           ; Decrement
    7403   00:65D8  BE                      cp  (hl)                        ; Compare with Days in month
    7404   00:65D9  30 08                   jr  nc,SET_DATE_ERR             ; If day is greater than how many days in month, invalid
    7405   00:65DB  6B                      ld  l,e                         ; Day of month in L
    7406   00:65DC  62                      ld  h,d                         ; Month in H
    7407   00:65DD  50                      ld  d,b                         ; Year - 1980 in D
    7408   00:65DE  CD 18 66                call    SET_RTC_DATE            ; Set date in RTC
    7409   00:65E1  AF                      xor a                           ; A = 0
    7410   00:65E2  C9                      ret                             ; Success
    7411   00:65E3                      ;   Invalid parameter
    7412   00:65E3                      SET_DATE_ERR:
    7413   00:65E3  3E 01                   ld  a,1
    7414   00:65E5  C9                      ret
    7415   00:65E6                      
    7416   00:65E6                      ; Table of top day value for each month
    7417   00:65E6                      DAYS_IN_MONTH:          db  31,28,31,30,31,30,31,31,30,31,30,31
    7417   00:65E6  1F 1C 1F 1E 1F 1E 1F 1F 1E 1F 1E 1F 
    7418   00:65F2                      ; And top day value in February when Leap Year
    7419   00:65F2  1D                  DAYS_IN_FEBRUARY_LEAP:  db  29
    7420   00:65F3                      
    7421   00:65F3                      ; Will select Mode 00 (Date and Time page) and stop clock counting
    7422   00:65F3                      ; Register D value will be left in A
    7423   00:65F3                      STOP_RTC_COUNT_SET_MODE0:
    7424   00:65F3  3E 0D                   ld  a,#D
    7425   00:65F5  D3 B4                   out (#B4),a                     ; Select RTC register D (mode)
    7426   00:65F7  DB B5                   in  a,(#B5)                     ; read register D
    7427   00:65F9  E6 04                   and 4                           ; Save Alarm EN setting, and mode register is 00 and stop counting time
    7428   00:65FB  D3 B5                   out (#B5),a                     ; And save
    7429   00:65FD  C9                      ret
    7430   00:65FE                      
    7431   00:65FE                      ; Will get a non BCD value in A, convert it to BCD and then save it in
    7432   00:65FE                      ; a register pair that starts in the register indicated in E
    7433   00:65FE                      ; Register E will have the next register after that register pair
    7434   00:65FE                      RTC_SAVE_REGISTERPAIR:
    7435   00:65FE  4F                      ld  c,a                         ; Save A in C
    7436   00:65FF  AF                      xor a                           ; 0 in A
    7437   00:6600  06 08                   ld  b,8                         ; 8 in B, number of bits for conversion
    7438   00:6602                      RTC_SAVE_REGISTERPAIR.1:
    7439   00:6602  CB 01                   rlc c                           ; Leftmost bit in Carry
    7440   00:6604  8F                      adc a,a                         ; A = (A * 2) + Carry
    7441   00:6605  27                      daa                             ; decimal adjust A, shift = BCD x 2 + carry
    7442   00:6606  10 FA                   djnz    RTC_SAVE_REGISTERPAIR.1 ; Repeat for 8 bits
    7443   00:6608  CD 0F 66                call    SET_RTC_REG             ; Save LSB in register and increase register address
    7444   00:660B  0F                      rrca
    7445   00:660C  0F                      rrca
    7446   00:660D  0F                      rrca
    7447   00:660E  0F                      rrca                            ; now MSB is in LSB position
    7448   00:660F                      SET_RTC_REG:
    7449   00:660F  47                      ld  b,a                         ; save value to set in B
    7450   00:6610  7B                      ld  a,e                         ; and now register address in A
    7451   00:6611  D3 B4                   out (#B4),a                     ; The register we want to set
    7452   00:6613  78                      ld  a,b                         ; restore value
    7453   00:6614  D3 B5                   out (#B5),a                     ; save it
    7454   00:6616  1C                      inc e                           ; increase register address, as this usually is done in pairs
    7455   00:6617  C9                      ret
    7456   00:6618                      
    7457   00:6618                      ; Auxiliary function for SET_DATE and SET_TIME
    7458   00:6618                      ; SET_RTC_DATE will save date, parameters:
    7459   00:6618                      ; L - Day
    7460   00:6618                      ; H - Month
    7461   00:6618                      ; D - Years since 1980
    7462   00:6618                      ; All values are regular values, this function will properly convert them
    7463   00:6618                      ;
    7464   00:6618                      ; SET_RTC_DATE.1 is used by SET_TIME as well
    7465   00:6618                      ; It will save three register pairs, starting with the register in E
    7466   00:6618                      ; First pair is updated with value in L
    7467   00:6618                      ; Second pair is updated with value in H
    7468   00:6618                      ; Third pair is updated with value in D
    7469   00:6618                      SET_RTC_DATE:
    7470   00:6618  CD F3 65                call    STOP_RTC_COUNT_SET_MODE0; Select RTC Register 13, and set Mode / Page 0
    7471   00:661B  F6 01                   or  1                           ; Set Bit 0, so Mode / Page 1
    7472   00:661D  D3 B5                   out (#B5),a                     ; save it in register 13, now page 1 selected
    7473   00:661F  3E 0B                   ld  a,#B                        ; Leap Year Counter Register
    7474   00:6621  D3 B4                   out (#B4),a                     ; Select it
    7475   00:6623  7A                      ld  a,d                         ; Load Years in leap year counter
    7476   00:6624  D3 B5                   out (#B5),a                     ; So it has count of leap years (0 is 1980, leap, and every time it is 4, leap year again)
    7477   00:6626  CD F3 65                call    STOP_RTC_COUNT_SET_MODE0; Select RTC Register 13 and set mode / page 0
    7478   00:6629  CD F3 65                call    STOP_RTC_COUNT_SET_MODE0; do it a second time... DOS does it, don't want to JYNX it :P
    7479   00:662C  1E 07                   ld  e,7                         ; Register 7
    7480   00:662E                      SET_RTC_DATE.1:
    7481   00:662E  7D                      ld  a,l                         ; A has day
    7482   00:662F  CD FE 65                call    RTC_SAVE_REGISTERPAIR   ; Will convert day to BCD and save in registers 7 and 8
    7483   00:6632  7C                      ld  a,h                         ; A has month
    7484   00:6633  CD FE 65                call    RTC_SAVE_REGISTERPAIR   ; Will convert month to BCD and save in register 9 and A
    7485   00:6636  7A                      ld  a,d                         ; A has how many years since 1980
    7486   00:6637  CD FE 65                call    RTC_SAVE_REGISTERPAIR   ; Will convert to BCD and save in register B and C
    7487   00:663A  3E 0D                   ld  a,#D                        ; Register D
    7488   00:663C  D3 B4                   out (#B4),a                     ; Send it
    7489   00:663E  DB B5                   in  a,(#B5)                     ; Read its value
    7490   00:6640  F6 08                   or  8                           ; Start counting time again
    7491   00:6642  D3 B5                   out (#B5),a                     ; Send
    7492   00:6644  C9                      ret
    7493   00:6645                      
    7494   00:6645                      ; Pattern setup routine
    7495   00:6645                      PATTERN_SETUP:
    7496   00:6645  AF                      xor a                           ; Bit-16, V9938 and V9958 only
    7497   00:6646  21 88 00                ld  hl,#0088                    ; Bit-15 to 0, pattern base address = #0088
    7498   00:6649  CD B9 66                call SET_VDP_WRITE
    7499   00:664C  21 59 66                ld  hl,PATTERN_DATA             ; Point to hl
    7500   00:664F  06 60                   ld  b,8*12                      ; Redraw 12 chars, max 12 chars are suggested
    7501   00:6651  0E 98                   ld  c,#98                       ; port #98
    7502   00:6653                      OUTI_TO_VRAM_TMS9918:
    7503   00:6653  ED A3                   outi                            ; Slower than otir but useful on TMS9918 which requires 29 T-states
    7504   00:6655  C2 53 66                jp  nz,OUTI_TO_VRAM_TMS9918     ; Therefore, don't use 'djnz' here!
    7505   00:6658  C9                      ret
