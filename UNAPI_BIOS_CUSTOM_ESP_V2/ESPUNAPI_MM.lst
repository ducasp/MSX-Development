    4354   00:571E  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4355   00:5721  18 F4                   jr  SSH_OPEN_ST2
    4356   00:5723                      SSH_OPEN_ST2.1:
    4357   00:5723                          ; nz, discard
    4358   00:5723                          RECEIVE_DATA
    4358   00:5723  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4359   00:5726  05                      dec b
    4360   00:5727  20 EE                   jr  nz,SSH_OPEN_ST2
    4361   00:5729                      
    4362   00:5729                          ; now just get the 1 byte, conn#, should go to B
    4363   00:5729                      SSH_OPEN_CONN_ST1:
    4364   00:5729                          CHECK_DATA
    4364   00:5729  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    4364   00:572C  CB 47             >     bit 0,a
    4365   00:572E  20 05                   jr  nz,SSH_OPEN_CONN_ST1.1
    4366   00:5730  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4367   00:5733  18 F4                   jr  SSH_OPEN_CONN_ST1
    4368   00:5735                      SSH_OPEN_CONN_ST1.1:
    4369   00:5735                          ; nz, get it
    4370   00:5735                          RECEIVE_DATA
    4370   00:5735  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4371   00:5738  47                      ld  b,a
    4372   00:5739                          ; done
    4373   00:5739  AF                      xor a
    4374   00:573A  C9                      ret
    4375   00:573B                      
    4376   00:573B                      SSH_OPEN_HOSTHASH:
    4377   00:573B                          ; HL has memory area to write host fingerprint / hash
    4378   00:573B                          ; we will receive size, should be 33, 1 byte for connection ID
    4379   00:573B                          ; 32 bytes for fingerprint / hash
    4380   00:573B                          CHECK_DATA
    4380   00:573B  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    4380   00:573E  CB 47             >     bit 0,a
    4381   00:5740  20 05                   jr  nz,SSH_OPEN_HOSTHASH.1
    4382   00:5742  CD AF 5E                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    4383   00:5745  18 F4                   jr  SSH_OPEN_HOSTHASH
    4384   00:5747                      SSH_OPEN_HOSTHASH.1:
    4385   00:5747                          ; nz, high byte count of bytes to receive
    4386   00:5747                          RECEIVE_DATA
    4386   00:5747  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4387   00:574A  67                      ld h,a
    4388   00:574B                      SSH_OPEN_HOSTHASHB:
    4389   00:574B                          CHECK_DATA
    4389   00:574B  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
