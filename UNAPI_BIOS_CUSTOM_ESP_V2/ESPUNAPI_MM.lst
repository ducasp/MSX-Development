    2817   00:4F84                          RECEIVE_DATA
    2817   00:4F84  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2818   00:4F87  67                      ld  h,a
    2819   00:4F88                      TCPIP_GET_CAPAB_BLK3_ST3:
    2820   00:4F88                          CHECK_DATA
    2820   00:4F88  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2820   00:4F8B  CB 47             >     bit 0,a
    2821   00:4F8D  20 05                   jr  nz,TCPIP_GET_CAPAB_BLK3_ST3.1
    2822   00:4F8F  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2823   00:4F92  18 F4                   jr  TCPIP_GET_CAPAB_BLK3_ST3
    2824   00:4F94                      TCPIP_GET_CAPAB_BLK3_ST3.1:
    2825   00:4F94                          ; nz, get it
