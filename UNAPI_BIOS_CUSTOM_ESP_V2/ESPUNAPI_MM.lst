    1147   00:45E0  CD A2 00                call    CHPUT
    1148   00:45E3  3E 20                   ld  a,' '                       ; Space
    1149   00:45E5  CD A2 00                call    CHPUT
    1150   00:45E8  3E 2D                   ld  a,'-'                       ; Dash
    1151   00:45EA  CD A2 00                call    CHPUT
    1152   00:45ED  3E 20                   ld  a,' '                       ; Space
    1153   00:45EF  CD A2 00                call    CHPUT
    1154   00:45F2  06 18                   ld  b,24                        ; Cuts AP names > 23 chars
    1155   00:45F4                      PRT_APNAMELP:
