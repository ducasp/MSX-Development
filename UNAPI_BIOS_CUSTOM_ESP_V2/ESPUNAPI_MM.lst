    5918   00:5F6A  18 F4                   jr  SSH_AUTH_GET_CHALLENGE_FLAGSA
    5919   00:5F6C                      SSH_AUTH_GET_CHALLENGE_FLAGSA.1:
    5920   00:5F6C                          ; nz, prompts, B to later go to H
    5921   00:5F6C                          RECEIVE_DATA
    5921   00:5F6C  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5922   00:5F6F  47                      ld b,a
    5923   00:5F70                      SSH_AUTH_GET_CHALLENGE_FLAGSB:
    5924   00:5F70                          CHECK_DATA
    5924   00:5F70  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5924   00:5F73  CB 47             >     bit 0,a
    5925   00:5F75  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_FLAGSB.1
    5926   00:5F77  CD 8C 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5927   00:5F7A  18 F4                   jr  SSH_AUTH_GET_CHALLENGE_FLAGSB
    5928   00:5F7C                      SSH_AUTH_GET_CHALLENGE_FLAGSB.1:
    5929   00:5F7C                          ; nz, prompts, C to later go to L
    5930   00:5F7C                          RECEIVE_DATA
    5930   00:5F7C  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5931   00:5F7F  4F                      ld c,a
    5932   00:5F80  C5                      push    bc                      ; stack has the flags
    5933   00:5F81                          ; Now let's decrease HL as we've read 2 bytes
    5934   00:5F81  2B                      dec hl
    5935   00:5F82  2B                      dec hl
    5936   00:5F83                          ; And loop for the whole remaining response
    5937   00:5F83  4D                      ld  c,l
    5938   00:5F84  44                      ld  b,h                         ; BC has effective received data size, as well as HL
    5939   00:5F85                          ; put effective data size in de
    5940   00:5F85  EB                      ex  de,hl
    5941   00:5F86                          ; will start moving at address in stack (we've pushed the adress in WORD)
    5942   00:5F86  CD 74 61                call    GETWORD
    5943   00:5F89  CD E7 61                call    BCBACKUP                ; save count (BC)
    5944   00:5F8C                      
    5945   00:5F8C                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use ini :-D
    5946   00:5F8C  43                      ld  b,e                         ; Number of loops originaly in DE
    5947   00:5F8D  1B                      dec de
    5948   00:5F8E  14                      inc d
    5949   00:5F8F                          if USE_MEM_IO = 0
    5950   00:5F8F                    ~     ld  c,IN_DATA_PORT
    5951   00:5F8F                    ~     CHECK_QUICK_RECEIVE
    5952   00:5F8F                    ~     jr  z,SSH_AUTH_GET_CHALLENGE_R_NSF             ; If not, go to the old, slower route
    5953   00:5F8F                    ~     ; Otherwise, let's speed it up baby!
    5954   00:5F8F                    ~ SSH_AUTH_GET_CHALLENGE_R:
    5955   00:5F8F                    ~     inir
    5956   00:5F8F                    ~     else
    5957   00:5F8F                          CHECK_QUICK_RECEIVE
    5957   00:5F8F  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5957   00:5F92  CB 5F             >     bit 3,a
    5958   00:5F94  28 1A                   jr  z,SSH_AUTH_GET_CHALLENGE_R_NSF       ; If not, go to the old, slower route
    5959   00:5F96                          ; Otherwise, let's speed it up baby!
    5960   00:5F96                      SSH_AUTH_GET_CHALLENGE_R:
    5961   00:5F96  3A 06 7F                ld  a,(MEM_IN_DATA_PORT)
    5962   00:5F99  77                      ld  (hl),a
    5963   00:5F9A  23                      inc hl
    5964   00:5F9B  10 F9                   djnz SSH_AUTH_GET_CHALLENGE_R
    5965   00:5F9D                          endif
    5966   00:5F9D  15                      dec d
    5967   00:5F9E  20 F6                   jr nz,SSH_AUTH_GET_CHALLENGE_R
    5968   00:5FA0                          CHECK_BUFFER_UNDERRUN
    5968   00:5FA0  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5968   00:5FA3  CB 67             >     bit 4,a
    5969   00:5FA5  C2 95 5E                jp  nz,SSH_AUTH_GET_CHALLENGE_RETRY_QRCV ; If yes, retry
    5970   00:5FA8                          ; Otherwise, done
    5971   00:5FA8  CD D5 61                call    BCRESTORE               ; done, restore return data in BC
    5972   00:5FAB  03                      inc bc
    5973   00:5FAC  03                      inc bc
    5974   00:5FAD                          ; get flags back from stack
    5975   00:5FAD  E1                      pop hl
    5976   00:5FAE  AF                      xor a
    5977   00:5FAF  C9                      ret
    5978   00:5FB0                      SSH_AUTH_GET_CHALLENGE_R_NSF:
    5979   00:5FB0                          CHECK_DATA
    5979   00:5FB0  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5979   00:5FB3  CB 47             >     bit 0,a
    5980   00:5FB5  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_R_NSF.1
    5981   00:5FB7  CD 8C 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5982   00:5FBA  18 F4                   jr  SSH_AUTH_GET_CHALLENGE_R_NSF
    5983   00:5FBC                      SSH_AUTH_GET_CHALLENGE_R_NSF.1:
    5984   00:5FBC                          if USE_MEM_IO = 0
    5985   00:5FBC                    ~     ini
    5986   00:5FBC                    ~     else
    5987   00:5FBC  3A 06 7F                ld  a,(MEM_IN_DATA_PORT)
    5988   00:5FBF  77                      ld  (hl),a
    5989   00:5FC0  23                      inc hl
    5990   00:5FC1  05                      dec b
    5991   00:5FC2                          endif
    5992   00:5FC2  20 EC                   jr  nz,SSH_AUTH_GET_CHALLENGE_R_NSF
    5993   00:5FC4  15                      dec d
    5994   00:5FC5  20 E9                   jr nz,SSH_AUTH_GET_CHALLENGE_R_NSF
    5995   00:5FC7  CD D5 61                call    BCRESTORE               ; done, restore return data in BC
    5996   00:5FCA  03                      inc bc
    5997   00:5FCB  03                      inc bc
    5998   00:5FCC                          ; get flags back from stack
    5999   00:5FCC  E1                      pop hl
    6000   00:5FCD  AF                      xor a
