    6003   00:5FCF                      ;=============================
    6004   00:5FCF                      ;===  TCPIP_CONFIG_AUTOIP  ===
    6005   00:5FCF                      ;=============================
    6006   00:5FCF                      ;Enable or disable the automatic IP addresses retrieval.
    6007   00:5FCF                      ;
    6008   00:5FCF                      ;Input:  A = 25
    6009   00:5FCF                      ;        B = 0: Get current configuration
    6010   00:5FCF                      ;            1: Set configuration
    6011   00:5FCF                      ;        C = Configuration to set (only if B=1):
    6012   00:5FCF                      ;            bit 0: Set to automatically retrieve
    6013   00:5FCF                      ;                   local IP address, subnet mask and default gateway
    6014   00:5FCF                      ;            bit 1: Set to automatically retrieve DNS servers addresses
    6015   00:5FCF                      ;            bits 2-7: Unused, must be zero
    6016   00:5FCF                      ;Output: A = Error code
    6017   00:5FCF                      ;        C = Configuration after the routine execution
    6018   00:5FCF                      ;            (same format as C at input)
    6019   00:5FCF                      TCPIP_CONFIG_AUTOIP:
    6020   00:5FCF                          SEND_DATA                       ; Send the command
    6020   00:5FCF  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6021   00:5FD2  AF                      xor a
    6022   00:5FD3                          SEND_DATA                       ; Send the command size msb
    6022   00:5FD3  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6023   00:5FD6  3E 02                   ld  a,2
    6024   00:5FD8                          SEND_DATA                       ; Send the command size lsb
    6024   00:5FD8  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6025   00:5FDB  78                      ld  a,b
    6026   00:5FDC                          SEND_DATA                       ; Send the command
    6026   00:5FDC  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6027   00:5FDF  79                      ld  a,c
    6028   00:5FE0                          SEND_DATA                       ; Send the command parameter
    6028   00:5FE0  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6029   00:5FE3                      
    6030   00:5FE3                          ; Now wait up to 180 ticks to get response
    6031   00:5FE3  21 B4 00                ld hl,180
    6032   00:5FE6  CD 3E 61                call    SETCOUNTER
    6033   00:5FE9                      TCPIP_CONFIG_AUTOIP_ST1:
    6034   00:5FE9                          CHECK_DATA
    6034   00:5FE9  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6034   00:5FEC  CB 47             >     bit 0,a
    6035   00:5FEE  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_ST1.1
    6036   00:5FF0  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6037   00:5FF3  18 F4                   jr  TCPIP_CONFIG_AUTOIP_ST1
    6038   00:5FF5                      TCPIP_CONFIG_AUTOIP_ST1.1:
    6039   00:5FF5                          ; nz, check the data
    6040   00:5FF5                          RECEIVE_DATA
    6040   00:5FF5  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6041   00:5FF8  FE 19                   cp  25                          ; Is response of our command?
    6042   00:5FFA  20 ED                   jr  nz,TCPIP_CONFIG_AUTOIP_ST1
    6043   00:5FFC                          ; now get return code, if return code other than 0, it is finished
    6044   00:5FFC                      TCPIP_CONFIG_AUTOIP_RC:
    6045   00:5FFC                          CHECK_DATA
    6045   00:5FFC  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6045   00:5FFF  CB 47             >     bit 0,a
    6046   00:6001  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_RC.1
    6047   00:6003  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6048   00:6006  18 F4                   jr  TCPIP_CONFIG_AUTOIP_RC
    6049   00:6008                      TCPIP_CONFIG_AUTOIP_RC.1:
    6050   00:6008                          ;nz, discard
    6051   00:6008                          RECEIVE_DATA
    6051   00:6008  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6052   00:600B  B7                      or  a                           ; 0?
    6053   00:600C  C0                      ret nz                          ; if not, done
    6054   00:600D                      
    6055   00:600D                          ; next two bytes are return code and size bytes, don't care, it is 1, configuration
    6056   00:600D  06 02                   ld  b,2
    6057   00:600F                      TCPIP_CONFIG_AUTOIP_ST2:
    6058   00:600F                          CHECK_DATA
    6058   00:600F  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6058   00:6012  CB 47             >     bit 0,a
    6059   00:6014  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_ST2.1
    6060   00:6016  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6061   00:6019  18 F4                   jr  TCPIP_CONFIG_AUTOIP_ST2
    6062   00:601B                      TCPIP_CONFIG_AUTOIP_ST2.1:
    6063   00:601B                          ; nz, discard
    6064   00:601B                          RECEIVE_DATA
    6064   00:601B  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6065   00:601E  05                      dec b
    6066   00:601F  20 EE                   jr  nz,TCPIP_CONFIG_AUTOIP_ST2
    6067   00:6021                      
    6068   00:6021                          ; now just get the 1 byte, configuration, should go to C
    6069   00:6021                      TCPIP_CONFIG_AUTOIP_CONF_ST1:
    6070   00:6021                          CHECK_DATA
    6070   00:6021  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6070   00:6024  CB 47             >     bit 0,a
    6071   00:6026  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_CONF_ST1.1
    6072   00:6028  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6073   00:602B  18 F4                   jr  TCPIP_CONFIG_AUTOIP_CONF_ST1
    6074   00:602D                      TCPIP_CONFIG_AUTOIP_CONF_ST1.1:
    6075   00:602D                          ; nz, get it
    6076   00:602D                          RECEIVE_DATA
    6076   00:602D  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6077   00:6030  4F                      ld  c,a
    6078   00:6031                          ; done
    6079   00:6031  AF                      xor a
    6080   00:6032  C9                      ret
    6081   00:6033                      
    6082   00:6033                      ;=========================
    6083   00:6033                      ;===  TCPIP_CONFIG_IP  ===
    6084   00:6033                      ;=========================
    6085   00:6033                      ;Manually configure an IP address.
    6086   00:6033                      ;
    6087   00:6033                      ;Input:  A = 26
    6088   00:6033                      ;        B = Index of address to set:
    6089   00:6033                      ;            1: Local IP address
    6090   00:6033                      ;            2: Peer IP address
    6091   00:6033                      ;            3: Subnet mask
    6092   00:6033                      ;            4: Default gateway
    6093   00:6033                      ;            5: Primary DNS server IP address
    6094   00:6033                      ;            6: Secondary DNS server IP address
    6095   00:6033                      ;        L.H.E.D = Address value
    6096   00:6033                      ;Output: A = Error code
    6097   00:6033                      TCPIP_CONFIG_IP:
    6098   00:6033                          SEND_DATA                       ; Send the command
    6098   00:6033  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6099   00:6036  AF                      xor a
    6100   00:6037                          SEND_DATA                       ; Send the command size msb
    6100   00:6037  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6101   00:603A  3E 05                   ld  a,5
    6102   00:603C                          SEND_DATA                       ; Send the command size lsb
    6102   00:603C  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6103   00:603F  78                      ld  a,b
    6104   00:6040                          SEND_DATA                       ; Send the address to set
    6104   00:6040  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6105   00:6043  7D                      ld  a,l
    6106   00:6044                          SEND_DATA                       ; Send the IP first byte
    6106   00:6044  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6107   00:6047  7C                      ld  a,h
    6108   00:6048                          SEND_DATA                       ; Send the IP second byte
    6108   00:6048  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6109   00:604B  7B                      ld  a,e
    6110   00:604C                          SEND_DATA                       ; Send the IP third byte
    6110   00:604C  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6111   00:604F  7A                      ld  a,d
    6112   00:6050                          SEND_DATA                       ; Send the IP fourth byte
    6112   00:6050  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    6113   00:6053                      
    6114   00:6053                          ; Now wait up to 180 ticks to get response
    6115   00:6053  21 B4 00                ld  hl,180
    6116   00:6056  CD 3E 61                call    SETCOUNTER
    6117   00:6059                      TCPIP_CONFIG_IP_ST1:
    6118   00:6059                          CHECK_DATA
    6118   00:6059  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6118   00:605C  CB 47             >     bit 0,a
    6119   00:605E  20 05                   jr  nz,TCPIP_CONFIG_IP_ST1.1
    6120   00:6060  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6121   00:6063  18 F4                   jr  TCPIP_CONFIG_IP_ST1
    6122   00:6065                      TCPIP_CONFIG_IP_ST1.1:
    6123   00:6065                          ; nz, check the data
    6124   00:6065                          RECEIVE_DATA
    6124   00:6065  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6125   00:6068  FE 1A                   cp  26                          ; Is response of our command?
    6126   00:606A  20 ED                   jr  nz,TCPIP_CONFIG_IP_ST1
    6127   00:606C                          ; now get return code, and that is it
    6128   00:606C                      TCPIP_CONFIG_IP_RC:
    6129   00:606C                          CHECK_DATA
    6129   00:606C  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    6129   00:606F  CB 47             >     bit 0,a
    6130   00:6071  20 05                   jr  nz,TCPIP_CONFIG_IP_RC.1
    6131   00:6073  CD 2F 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    6132   00:6076  18 F4                   jr  TCPIP_CONFIG_IP_RC
    6133   00:6078                      TCPIP_CONFIG_IP_RC.1:
    6134   00:6078                          ; nz, discard
    6135   00:6078                          RECEIVE_DATA
    6135   00:6078  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    6136   00:607B  C9                      ret                             ; done
    6137   00:607C                      
    6138   00:607C                      ;==========================
    6139   00:607C                      ;===  TCPIP_CONFIG_TTL  ===
    6140   00:607C                      ;==========================
    6141   00:607C                      ;Get/set the value of TTL and TOS for outgoing datagrams.
    6142   00:607C                      ;
    6143   00:607C                      ;Input:  A = 27
    6144   00:607C                      ;        B = 0: Get current values (just return 255 for TTL and 0 for TOS
    6145   00:607C                      ;               as ESP do not expose or allow configurations of it)
    6146   00:607C                      ;            1: Set values
    6147   00:607C                      ;        D = New value for TTL (only if B=1)
    6148   00:607C                      ;        E = New value for ToS (only if B=1)
    6149   00:607C                      ;Output: A = Error code
    6150   00:607C                      ;        D = Value of TTL after the routine execution
    6151   00:607C                      ;        E = Value of ToS after the routine execution
    6152   00:607C                      TCPIP_CONFIG_TTL:
    6153   00:607C  78                      ld  a,b
    6154   00:607D  E6 FE                   and %11111110
