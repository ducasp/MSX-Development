    3877   00:550C  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3877   00:550F  CB 47             >     bit 0,a
    3878   00:5511  20 05                   jr  nz,TCPIP_UDP_RCV_PORT_ST2.1
    3879   00:5513  CD 1D 54                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3880   00:5516  18 F4                   jr  TCPIP_UDP_RCV_PORT_ST2
    3881   00:5518                      TCPIP_UDP_RCV_PORT_ST2.1:
