    5655   00:5DDE  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5656   00:5DE1  3E 03                   ld  a,3
    5657   00:5DE3  CD 58 61                call    SETBYTE                 ; Ok, retry up to three times
