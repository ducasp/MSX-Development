    5334   00:5C4C                          ; nz, discard
    5335   00:5C4C                          RECEIVE_DATA
    5335   00:5C4C  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5336   00:5C4F  0D                      dec c
    5337   00:5C50  20 EE                   jr  nz,TCPIP_TCP_STATE_ERROR2
    5338   00:5C52                      
    5339   00:5C52                          ; now return w/ error that is saved in b
    5340   00:5C52  78                      ld  a,b
    5341   00:5C53  06 00                   ld  b,0
    5342   00:5C55  0E 07                   ld  c,7
    5343   00:5C57  21 00 00                ld  hl,0
    5344   00:5C5A  11 00 00                ld  de,0
    5345   00:5C5D  DD 21 00 00             ld  ix,0
