    3890   00:5523                          ; size goes to DE
    3891   00:5523  50                      ld  d,b
    3892   00:5524  59                      ld  e,c
    3893   00:5525                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use ini :-D
    3894   00:5525  43                      ld  b,e                         ; Number of loops originaly in DE
    3895   00:5526  1B                      dec de
    3896   00:5527  14                      inc d
    3897   00:5528                          if USE_MEM_IO = 0
    3898   00:5528                    ~     ld  c,IN_DATA_PORT
    3899   00:5528                    ~     endif
    3900   00:5528                          CHECK_QUICK_RECEIVE
    3900   00:5528  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
