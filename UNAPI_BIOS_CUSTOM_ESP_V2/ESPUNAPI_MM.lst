    3094   00:5115                      ;=====================
    3095   00:5115                      ;===  TCPIP_DNS_Q  ===
    3096   00:5115                      ;=====================
    3097   00:5115                      ;Start a host name resolution query.
    3098   00:5115                      ;
    3099   00:5115                      ;Input:  A  = 6
    3100   00:5115                      ;        HL = Address of the host name to be resolved, zero terminated
    3101   00:5115                      ;        B  = Flags, when set to 1 they instruct the resolver to:
    3102   00:5115                      ;             bit 0: Only abort the query currently in progress, if there is any
    3103   00:5115                      ;                    (other flags and registers are then ignored)
    3104   00:5115                      ;             bit 1: Assume that the passed name is an IP address,
    3105   00:5115                      ;                    and return an error if this is not true
    3106   00:5115                      ;             bit 2: If there is a query in progress already,
    3107   00:5115                      ;                    do NOT abort it and return an error instead
    3108   00:5115                      ;Output:  A = Error code
    3109   00:5115                      ;         B = 0 if a query to a DNS server is in progress
    3110   00:5115                      ;             1 if the name represented an IP address
    3111   00:5115                      ;             2 if the name could be resolved locally
    3112   00:5115                      ;         L.H.E.D = Resolved IP address
    3113   00:5115                      ;                   (only if no error occurred and B=1 or 2 is returned)
    3114   00:5115                      ;RAM Buffer to store names to be resolved (and used also to translate IPs from ASCII to 32bits number)
    3115   00:5115                      ;Will store the result of the last DNS query
    3116   00:5115                      TCPIP_DNS_Q:
    3117   00:5115  E5                      push    hl                      ; Save HL
    3118   00:5116  AF                      xor a
    3119   00:5117  5F                      ld  e,a
    3120   00:5118  57                      ld  d,a                         ; Zero DE
    3121   00:5119                      TCPIP_DNS_Q_SIZE_LOOP:
    3122   00:5119  7E                      ld  a,(hl)                      ; so let's check the size of dns data
    3123   00:511A  B7                      or  a                           ; it is zero terminated
    3124   00:511B  28 05                   jr  z,TCPIP_DNS_Q_SEND          ; if zero, end of string
    3125   00:511D  13                      inc de                          ; ok, not zero, one more char
    3126   00:511E  23                      inc hl                          ; next
    3127   00:511F  C3 19 51                jp  TCPIP_DNS_Q_SIZE_LOOP       ; jp is a tad bit faster and we are not worried about code size
    3128   00:5122                      TCPIP_DNS_Q_SEND:
    3129   00:5122                          ; Here we send the query and wait the result
    3130   00:5122  13                      inc de                          ; add 1, we will send flag first
    3131   00:5123  3E CE                   ld  a,206                       ; DNS_Q_NEW
    3132   00:5125                          SEND_DATA                       ; Send the command
    3132   00:5125  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3133   00:5128  7A                      ld  a,d
    3134   00:5129                          SEND_DATA                       ; Send the command size msb
    3134   00:5129  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3135   00:512C  7B                      ld  a,e
    3136   00:512D                          SEND_DATA                       ; Send the command size lsb
    3136   00:512D  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3137   00:5130  78                      ld  a,b
    3138   00:5131                          SEND_DATA                       ; Send the flag byte
    3138   00:5131  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3139   00:5134                      
    3140   00:5134                          if USE_MEM_IO = 0
    3141   00:5134                    ~     ; now otir of DNS/DNS BUFFER DATA SIZE
    3142   00:5134                    ~     ld  c,OUT_TX_PORT               ; our data TX port
    3143   00:5134                    ~     endif
    3144   00:5134  E1                      pop hl                          ; string to try to resolve
    3145   00:5135  1B                      dec de                          ; we are sending just data addressed by HL, so revert count
    3146   00:5136  7A                      ld  a,d
    3147   00:5137  B3                      or  e                           ; if de zero, no string, wrong parameters, but let the ESP answer
    3148   00:5138  CA 4A 51                jp  z,TCPIP_DNS_Q_WAIT_RSP
    3149   00:513B  AF                      xor a
    3150   00:513C                          ; Fast 16 bit variable size loop by GRAUW
    3151   00:513C  43                      ld  b,e
    3152   00:513D  1B                      dec de
    3153   00:513E  14                      inc d
    3154   00:513F                      TCPIP_DNS_Q_SENDLP:
    3155   00:513F                          ; send it
    3156   00:513F                          if USE_MEM_IO = 0
    3157   00:513F                    ~     outi
    3158   00:513F                    ~     jp  nz,TCPIP_DNS_Q_SENDLP
    3159   00:513F                    ~     else
    3160   00:513F  7E                      ld  a,(hl)
    3161   00:5140  32 07 7F                ld  (MEM_OUT_TX_PORT),a
    3162   00:5143  23                      inc hl
    3163   00:5144  10 F9                   djnz TCPIP_DNS_Q_SENDLP
    3164   00:5146                          endif
    3165   00:5146  15                      dec d
    3166   00:5147  C2 3F 51                jp  nz,TCPIP_DNS_Q_SENDLP
    3167   00:514A                      TCPIP_DNS_Q_WAIT_RSP:
    3168   00:514A                          ; Now wait up to 900 ticks (15s@60Hz) to get response
    3169   00:514A  21 84 03                ld  hl,900
    3170   00:514D  CD C2 5E                call    SETCOUNTER
    3171   00:5150                      TCPIP_DNSQ_SEND_ST1:
    3172   00:5150                          CHECK_DATA
    3172   00:5150  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3172   00:5153  CB 47             >     bit 0,a
    3173   00:5155  20 05                   jr  nz,TCPIP_DNSQ_SEND_ST1.1
    3174   00:5157  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3175   00:515A  18 F4                   jr  TCPIP_DNSQ_SEND_ST1
    3176   00:515C                      TCPIP_DNSQ_SEND_ST1.1:
    3177   00:515C                          ; nz, check the data
    3178   00:515C                          RECEIVE_DATA
    3178   00:515C  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3179   00:515F  FE CE                   cp  206                         ; Is response of our command?
    3180   00:5161  20 ED                   jr  nz,TCPIP_DNSQ_SEND_ST1
    3181   00:5163                          ; now get return code, if return code other than 0, it is finished
    3182   00:5163                      TCPIP_DNSQ_SEND_RC:
    3183   00:5163                          CHECK_DATA
    3183   00:5163  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3183   00:5166  CB 47             >     bit 0,a
    3184   00:5168  20 05                   jr  nz,TCPIP_DNSQ_SEND_RC.1
    3185   00:516A  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3186   00:516D  18 F4                   jr  TCPIP_DNSQ_SEND_RC
    3187   00:516F                      TCPIP_DNSQ_SEND_RC.1:
    3188   00:516F                          ; nz, discard
    3189   00:516F                          RECEIVE_DATA
    3189   00:516F  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3190   00:5172  B7                      or  a                           ; 0?
    3191   00:5173  06 00                   ld  b,0                         ; say in progress as there is no failure status
    3192   00:5175  C0                      ret nz                          ; if not, done, ERROR won't return data
    3193   00:5176                      
    3194   00:5176                          ; next two bytes are return code and size bytes, don't care, it is 4, resolved IP
    3195   00:5176  06 02                   ld  b,2
    3196   00:5178                      TCPIP_DNSQ_SEND_RC_ST2:
    3197   00:5178                          CHECK_DATA
    3197   00:5178  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3197   00:517B  CB 47             >     bit 0,a
    3198   00:517D  20 05                   jr  nz,TCPIP_DNSQ_SEND_RC_ST2.1
    3199   00:517F  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3200   00:5182  18 F4                   jr  TCPIP_DNSQ_SEND_RC_ST2
    3201   00:5184                      TCPIP_DNSQ_SEND_RC_ST2.1:
    3202   00:5184                          ; nz, discard
    3203   00:5184                          RECEIVE_DATA
    3203   00:5184  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3204   00:5187  05                      dec b
    3205   00:5188  20 EE                   jr  nz,TCPIP_DNSQ_SEND_RC_ST2
    3206   00:518A                      
    3207   00:518A                          ; now just get the 4 bytes IP and place it in L H E D
    3208   00:518A                      TCPIP_DNSQ_IP_ST1:
    3209   00:518A                          CHECK_DATA
    3209   00:518A  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3209   00:518D  CB 47             >     bit 0,a
    3210   00:518F  20 05                   jr  nz,TCPIP_DNSQ_IP_ST1.1
    3211   00:5191  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3212   00:5194  18 F4                   jr  TCPIP_DNSQ_IP_ST1
    3213   00:5196                      TCPIP_DNSQ_IP_ST1.1:
    3214   00:5196                          ; nz, get it
    3215   00:5196                          RECEIVE_DATA
    3215   00:5196  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3216   00:5199  6F                      ld  l,a
    3217   00:519A                      TCPIP_DNSQ_IP_ST2:
    3218   00:519A                          CHECK_DATA
    3218   00:519A  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3218   00:519D  CB 47             >     bit 0,a
    3219   00:519F  20 05                   jr  nz,TCPIP_DNSQ_IP_ST2.1
    3220   00:51A1  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3221   00:51A4  18 F4                   jr  TCPIP_DNSQ_IP_ST2
    3222   00:51A6                      TCPIP_DNSQ_IP_ST2.1:
    3223   00:51A6                          ; nz, get it
    3224   00:51A6                          RECEIVE_DATA
    3224   00:51A6  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3225   00:51A9  67                      ld  h,a
    3226   00:51AA                      TCPIP_DNSQ_IP_ST3:
    3227   00:51AA                          CHECK_DATA
    3227   00:51AA  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3227   00:51AD  CB 47             >     bit 0,a
    3228   00:51AF  20 05                   jr  nz,TCPIP_DNSQ_IP_ST3.1
    3229   00:51B1  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3230   00:51B4  18 F4                   jr  TCPIP_DNSQ_IP_ST3
    3231   00:51B6                      TCPIP_DNSQ_IP_ST3.1:
    3232   00:51B6                          ; nz, get it
    3233   00:51B6                          RECEIVE_DATA
    3233   00:51B6  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3234   00:51B9  5F                      ld  e,a
    3235   00:51BA                      TCPIP_DNSQ_IP_ST4:
    3236   00:51BA                          CHECK_DATA
    3236   00:51BA  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3236   00:51BD  CB 47             >     bit 0,a
    3237   00:51BF  20 05                   jr  nz,TCPIP_DNSQ_IP_ST4.1
    3238   00:51C1  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3239   00:51C4  18 F4                   jr  TCPIP_DNSQ_IP_ST4
    3240   00:51C6                      TCPIP_DNSQ_IP_ST4.1:
    3241   00:51C6                          ; nz, get it
    3242   00:51C6                          RECEIVE_DATA
    3242   00:51C6  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3243   00:51C9  57                      ld  d,a
    3244   00:51CA                          ; done
    3245   00:51CA  3E 01                   ld  a,1
    3246   00:51CC  CD D4 5F                call    SETDNSREADY             ; DNS done
    3247   00:51CF  CD FE 5F                call    SETDNSRESULT            ; DNS RESULT
    3248   00:51D2  06 02                   ld  b,2
    3249   00:51D4  AF                      xor a
    3250   00:51D5  C9                      ret
    3251   00:51D6                      
    3252   00:51D6                      ;=====================
    3253   00:51D6                      ;===  TCPIP_DNS_S  ===
    3254   00:51D6                      ;=====================
    3255   00:51D6                      ;Obtains the host name resolution process state and result.
    3256   00:51D6                      ;
    3257   00:51D6                      ;Input:  A = 7
    3258   00:51D6                      ;        B = Flags, when set to 1 they instruct the resolver to:
    3259   00:51D6                      ;            bit 0: Clear any existing result or error condition after the execution
    3260   00:51D6                      ;                   (except if there is a query in progress)
    3261   00:51D6                      ;Output: A = Error code
    3262   00:51D6                      ;        B = DNS error code (when error is ERR_DNS)
    3263   00:51D6                      ;        B = Current query status (when error is ERR_OK):
    3264   00:51D6                      ;            0: There is no query in progress, nor any result nor error code available
    3265   00:51D6                      ;            1: There is a query in progress
    3266   00:51D6                      ;            2: Query is complete
    3267   00:51D6                      ;        C = Current query sub status (when error is ERR_OK and B=1):
    3268   00:51D6                      ;            0: Unknown
    3269   00:51D6                      ;            1: Querying the primary DNS server
    3270   00:51D6                      ;            2: Querying the secondary DNS server
    3271   00:51D6                      ;            3: Querying another DNS server
    3272   00:51D6                      ;        C = Resolution process type (when error is ERR_OK and B=2):
    3273   00:51D6                      ;            0: The name was obtained by querying a DNS server
    3274   00:51D6                      ;            1: The name was a direct representation of an IP address
    3275   00:51D6                      ;            2: The name was resolved locally
    3276   00:51D6                      ;       L.H.E.D = Resolved IP address (when error is ERR_OK and B=2)
    3277   00:51D6                      TCPIP_DNS_S:
    3278   00:51D6                          ;--- Is there a result?
    3279   00:51D6  CD C2 5F                call    GETDNSREADY             ; DNS done?
    3280   00:51D9  B7                      or  a
    3281   00:51DA  28 23                   jr  z,TCPIP_DNS_S_NORESULT      ; No DNS result
    3282   00:51DC                          ;--- Ok, we have a result, is it success?
    3283   00:51DC  3D                      dec a
    3284   00:51DD  28 12                   jr  z,TCPIP_DNS_S_HASRESULT     ; If it is 1, it was not an error
    3285   00:51DF                          ;--- Shoot, there is an error...
    3286   00:51DF                          ;--- And sure thing, ESP do not tell us details, it is always failure :-P
    3287   00:51DF  CB 40                   bit 0,b                         ;--- clear error after this?
    3288   00:51E1  28 09                   jr  z,TCP_IP_DNS_S_NOCLR
    3289   00:51E3                          ;--- Clear
    3290   00:51E3  06 00                   ld b,0                          ;--- Like I've said, no details
    3291   00:51E5  AF                      xor a
    3292   00:51E6  CD D4 5F                call    SETDNSREADY             ; DNS not done
    3293   00:51E9  3E 08                   ld  a,ERR_DNS;
    3294   00:51EB  C9                      ret
    3295   00:51EC                      TCP_IP_DNS_S_NOCLR:
    3296   00:51EC                          ;--- Don't clear
    3297   00:51EC  3E 08                   ld  a,ERR_DNS
    3298   00:51EE  06 00                   ld  b,0                         ;--- Like I've said, no details
    3299   00:51F0  C9                      ret
    3300   00:51F1                          ;--- There is a result available...
    3301   00:51F1                      TCPIP_DNS_S_HASRESULT:
    3302   00:51F1                          ;--- Copy the result
    3303   00:51F1  CD E8 5F                call    GETDNSRESULT
    3304   00:51F4  AF                      xor a
    3305   00:51F5  CB 40                   bit 0,b                         ;--- clear result after this?
    3306   00:51F7  28 03                   jr  z,TCP_IP_DNS_S_RES_NOCLR    ;--- no, just return
    3307   00:51F9                          ;--- Yes, clear
    3308   00:51F9  CD D4 5F                call    SETDNSREADY             ; DNS not done
    3309   00:51FC                      TCP_IP_DNS_S_RES_NOCLR:
    3310   00:51FC  06 02                   ld  b,2
    3311   00:51FE  C9                      ret
    3312   00:51FF                      
    3313   00:51FF                      TCPIP_DNS_S_NORESULT:
    3314   00:51FF  AF                      xor a                           ;--- OK no query in progress, no result, means nothing in progress
    3315   00:5200  06 00                   ld  b,0                         ;--- No query in progress
    3316   00:5202  C9                      ret
    3317   00:5203                      
    3318   00:5203                      ;========================
    3319   00:5203                      ;===  TCPIP_UDP_OPEN  ===
    3320   00:5203                      ;========================
    3321   00:5203                      ;Open an UDP connection.
    3322   00:5203                      ;
    3323   00:5203                      ;Input:  A  = 8
    3324   00:5203                      ;        HL = Local port number (#FFFF=random)
    3325   00:5203                      ;        B  = Intended connection lifetime:
    3326   00:5203                      ;             0: Transient
    3327   00:5203                      ;             1: Resident
    3328   00:5203                      ;Output: A = Error code
    3329   00:5203                      ;        B = Connection number
    3330   00:5203                      TCPIP_UDP_OPEN:
    3331   00:5203                          SEND_DATA                       ; Send the command
    3331   00:5203  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3332   00:5206  AF                      xor a
    3333   00:5207                          SEND_DATA                       ; Send the command size msb
    3333   00:5207  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3334   00:520A  3E 03                   ld  a,3
    3335   00:520C                          SEND_DATA                       ; Send the command size lsb
    3335   00:520C  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3336   00:520F  7D                      ld  a,l
    3337   00:5210                          SEND_DATA                       ; Send the port LSB
    3337   00:5210  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3338   00:5213  7C                      ld  a,h
    3339   00:5214                          SEND_DATA                       ; Send the port MSB
    3339   00:5214  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3340   00:5217  78                      ld  a,b
    3341   00:5218                          SEND_DATA                       ; Send the connection transient/resident
    3341   00:5218  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3342   00:521B                      
    3343   00:521B                          ; Now wait up to 180 ticks to get response
    3344   00:521B  21 B4 00                ld  hl,180
    3345   00:521E  CD C2 5E                call    SETCOUNTER
    3346   00:5221                      TCPIP_UDP_OPEN_ST1:
    3347   00:5221                          CHECK_DATA
    3347   00:5221  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3347   00:5224  CB 47             >     bit 0,a
    3348   00:5226  20 05                   jr  nz,TCPIP_UDP_OPEN_ST1.1
    3349   00:5228  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3350   00:522B  18 F4                   jr  TCPIP_UDP_OPEN_ST1
    3351   00:522D                      TCPIP_UDP_OPEN_ST1.1:
    3352   00:522D                          ; nz, check the data
    3353   00:522D                          RECEIVE_DATA
    3353   00:522D  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3354   00:5230  FE 08                   cp  8                           ; Is response of our command?
    3355   00:5232  20 ED                   jr  nz,TCPIP_UDP_OPEN_ST1
    3356   00:5234                          ; now get return code, if return code other than 0, it is finished
    3357   00:5234                      TCPIP_UDP_OPEN_RC:
    3358   00:5234                          CHECK_DATA
    3358   00:5234  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3358   00:5237  CB 47             >     bit 0,a
    3359   00:5239  20 05                   jr  nz,TCPIP_UDP_OPEN_RC.1
    3360   00:523B  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3361   00:523E  18 F4                   jr  TCPIP_UDP_OPEN_RC
    3362   00:5240                      TCPIP_UDP_OPEN_RC.1:
    3363   00:5240                          ; nz, discard
    3364   00:5240                          RECEIVE_DATA
    3364   00:5240  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3365   00:5243  B7                      or  a                           ; 0?
    3366   00:5244  C0                      ret nz                          ; if not, done
    3367   00:5245                      
    3368   00:5245                          ; next two bytes are return code and size bytes, don't care, it is 1, conn #
    3369   00:5245  06 02                   ld  b,2
    3370   00:5247                      TCPIP_UDP_OPEN_ST2:
    3371   00:5247                          CHECK_DATA
    3371   00:5247  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3371   00:524A  CB 47             >     bit 0,a
    3372   00:524C  20 05                   jr  nz,TCPIP_UDP_OPEN_ST2.1
    3373   00:524E  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3374   00:5251  18 F4                   jr  TCPIP_UDP_OPEN_ST2
    3375   00:5253                      TCPIP_UDP_OPEN_ST2.1:
    3376   00:5253                          ; nz, discard
    3377   00:5253                          RECEIVE_DATA
    3377   00:5253  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3378   00:5256  05                      dec b
    3379   00:5257  20 EE                   jr  nz,TCPIP_UDP_OPEN_ST2
    3380   00:5259                      
    3381   00:5259                          ; now just get the 1 byte, conn#, should go to B
    3382   00:5259                      TCPIP_UDP_OPEN_CONN_ST1:
    3383   00:5259                          CHECK_DATA
    3383   00:5259  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3383   00:525C  CB 47             >     bit 0,a
    3384   00:525E  20 05                   jr  nz,TCPIP_UDP_OPEN_CONN_ST1.1
    3385   00:5260  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3386   00:5263  18 F4                   jr  TCPIP_UDP_OPEN_CONN_ST1
    3387   00:5265                      TCPIP_UDP_OPEN_CONN_ST1.1:
    3388   00:5265                          ; nz, get it
    3389   00:5265                          RECEIVE_DATA
    3389   00:5265  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3390   00:5268  47                      ld  b,a
    3391   00:5269                          ; done
    3392   00:5269  AF                      xor a
    3393   00:526A  C9                      ret
    3394   00:526B                      
    3395   00:526B                      ;=========================
    3396   00:526B                      ;===  TCPIP_UDP_CLOSE  ===
    3397   00:526B                      ;=========================
    3398   00:526B                      ;Close a UDP connection.
    3399   00:526B                      ;
    3400   00:526B                      ;Input:  A = 9
    3401   00:526B                      ;        B = Connection number
    3402   00:526B                      ;            0 to close all open transient UDP connections
    3403   00:526B                      ;Output: A = Error code
    3404   00:526B                      TCPIP_UDP_CLOSE:
    3405   00:526B                          SEND_DATA                       ; Send the command
    3405   00:526B  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3406   00:526E  AF                      xor a
    3407   00:526F                          SEND_DATA                       ; Send the command size msb
    3407   00:526F  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3408   00:5272  3E 01                   ld  a,1
    3409   00:5274                          SEND_DATA                       ; Send the command size lsb
    3409   00:5274  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3410   00:5277  78                      ld  a,b
    3411   00:5278                          SEND_DATA                       ; Send the connection #
    3411   00:5278  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3412   00:527B                          ; Now wait up to 180 ticks to get response
    3413   00:527B  21 B4 00                ld  hl,180
    3414   00:527E  CD C2 5E                call    SETCOUNTER
    3415   00:5281                      TCPIP_UDP_CLOSE_ST1:
    3416   00:5281                          CHECK_DATA
    3416   00:5281  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3416   00:5284  CB 47             >     bit 0,a
    3417   00:5286  20 05                   jr  nz,TCPIP_UDP_CLOSE_ST1.1
    3418   00:5288  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3419   00:528B  18 F4                   jr  TCPIP_UDP_CLOSE_ST1
    3420   00:528D                      TCPIP_UDP_CLOSE_ST1.1:
    3421   00:528D                          ; nz, check the data
    3422   00:528D                          RECEIVE_DATA
    3422   00:528D  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3423   00:5290  FE 09                   cp  9                           ; Is response of our command?
    3424   00:5292  20 ED                   jr  nz,TCPIP_UDP_CLOSE_ST1
    3425   00:5294                          ; now get return code, if return code other than 0, it is finished
    3426   00:5294                      TCPIP_UDP_CLOSE_RC:
    3427   00:5294                          CHECK_DATA
    3427   00:5294  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3427   00:5297  CB 47             >     bit 0,a
    3428   00:5299  20 05                   jr  nz,TCPIP_UDP_CLOSE_RC.1
    3429   00:529B  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3430   00:529E  18 F4                   jr  TCPIP_UDP_CLOSE_RC
    3431   00:52A0                      TCPIP_UDP_CLOSE_RC.1:
    3432   00:52A0                          ; nz, discard
    3433   00:52A0                          RECEIVE_DATA
    3433   00:52A0  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3434   00:52A3  B7                      or  a                           ; 0?
    3435   00:52A4  C0                      ret nz                          ; if not, done
    3436   00:52A5                      
    3437   00:52A5                          ; next two bytes are return code and size bytes, don't care, it is 1, conn #
    3438   00:52A5  06 02                   ld  b,2
    3439   00:52A7                      TCPIP_UDP_CLOSE_ST2:
    3440   00:52A7                          CHECK_DATA
    3440   00:52A7  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3440   00:52AA  CB 47             >     bit 0,a
    3441   00:52AC  20 05                   jr  nz,TCPIP_UDP_CLOSE_ST2.1
    3442   00:52AE  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3443   00:52B1  18 F4                   jr  TCPIP_UDP_CLOSE_ST2
    3444   00:52B3                      TCPIP_UDP_CLOSE_ST2.1:
    3445   00:52B3                          ; nz, discard
    3446   00:52B3                          RECEIVE_DATA
    3446   00:52B3  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3447   00:52B6  05                      dec b
    3448   00:52B7  20 EE                   jr  nz,TCPIP_UDP_CLOSE_ST2
    3449   00:52B9                      
    3450   00:52B9                          ; done, no return data other than return code
    3451   00:52B9  AF                      xor a
    3452   00:52BA  C9                      ret
    3453   00:52BB                      
    3454   00:52BB                      ;=========================
    3455   00:52BB                      ;===  TCPIP_UDP_STATE  ===
    3456   00:52BB                      ;=========================
    3457   00:52BB                      ;Get the state of a UDP connection.
    3458   00:52BB                      ;
    3459   00:52BB                      ;Input:  A = 10
    3460   00:52BB                      ;        B = Connection number
    3461   00:52BB                      ;Output: A  = Error code
    3462   00:52BB                      ;        HL = Local port number
    3463   00:52BB                      ;        B  = Number of pending incoming datagrams
    3464   00:52BB                      ;        DE = Size of oldest pending incoming datagram (data part only)
    3465   00:52BB                      TCPIP_UDP_STATE:
    3466   00:52BB                          SEND_DATA                       ; Send the command
    3466   00:52BB  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3467   00:52BE  AF                      xor a
    3468   00:52BF                          SEND_DATA                       ; Send the command size msb
    3468   00:52BF  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3469   00:52C2  3C                      inc a
    3470   00:52C3                          SEND_DATA                       ; Send the command size lsb
    3470   00:52C3  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3471   00:52C6  78                      ld  a,b
    3472   00:52C7                          SEND_DATA                       ; Send the parameter
    3472   00:52C7  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3473   00:52CA                      
    3474   00:52CA                          ; Now wait up to 60 ticks to get response
    3475   00:52CA  21 3C 00                ld  hl,60
    3476   00:52CD  CD C2 5E                call    SETCOUNTER
    3477   00:52D0                      TCPIP_UDP_STATE_ST1:
    3478   00:52D0                          CHECK_DATA
    3478   00:52D0  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3478   00:52D3  CB 47             >     bit 0,a
    3479   00:52D5  20 05                   jr  nz,TCPIP_UDP_STATE_ST1.1
    3480   00:52D7  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3481   00:52DA  18 F4                   jr  TCPIP_UDP_STATE_ST1
    3482   00:52DC                      TCPIP_UDP_STATE_ST1.1:
    3483   00:52DC                          ; nz, check the data
    3484   00:52DC                          RECEIVE_DATA
    3484   00:52DC  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3485   00:52DF  FE 0A                   cp  10                          ; Is response of our command?
    3486   00:52E1  20 ED                   jr  nz,TCPIP_UDP_STATE_ST1
    3487   00:52E3                          ; now get return code, if return code other than 0, it is finished
    3488   00:52E3                      TCPIP_UDP_STATE_RC:
    3489   00:52E3                          CHECK_DATA
    3489   00:52E3  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3489   00:52E6  CB 47             >     bit 0,a
    3490   00:52E8  20 05                   jr  nz,TCPIP_UDP_STATE_RC.1
    3491   00:52EA  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3492   00:52ED  18 F4                   jr  TCPIP_UDP_STATE_RC
    3493   00:52EF                      TCPIP_UDP_STATE_RC.1:
    3494   00:52EF                          ; nz, discard
    3495   00:52EF                          RECEIVE_DATA
    3495   00:52EF  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3496   00:52F2  B7                      or  a                           ; 0?
    3497   00:52F3  C0                      ret nz                          ; if not, done
    3498   00:52F4                      
    3499   00:52F4                          ; next two bytes are return code and size bytes, don't care, it is 5
    3500   00:52F4  06 02                   ld  b,2
    3501   00:52F6                      TCPIP_UDP_STATE_ST2:
    3502   00:52F6                          CHECK_DATA
    3502   00:52F6  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3502   00:52F9  CB 47             >     bit 0,a
    3503   00:52FB  20 05                   jr  nz,TCPIP_UDP_STATE_ST2.1
    3504   00:52FD  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3505   00:5300  18 F4                   jr  TCPIP_UDP_STATE_ST2
    3506   00:5302                      TCPIP_UDP_STATE_ST2.1:
    3507   00:5302                          ; nz, discard
    3508   00:5302                          RECEIVE_DATA
    3508   00:5302  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3509   00:5305  05                      dec b
    3510   00:5306  20 EE                   jr  nz,TCPIP_UDP_STATE_ST2
    3511   00:5308                      
    3512   00:5308                          ; now just get the 5 bytes (Port LSB then MSB, # of packets, packet size LSB then MSB) and order it in L, H, B, E and D
    3513   00:5308                      TCPIP_UDP_STATE_RESP_ST1:
    3514   00:5308                          CHECK_DATA
    3514   00:5308  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3514   00:530B  CB 47             >     bit 0,a
    3515   00:530D  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST1.1
    3516   00:530F  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3517   00:5312  18 F4                   jr  TCPIP_UDP_STATE_RESP_ST1
    3518   00:5314                      TCPIP_UDP_STATE_RESP_ST1.1:
    3519   00:5314                          ; nz, get it
    3520   00:5314                          RECEIVE_DATA
    3520   00:5314  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3521   00:5317  6F                      ld  l,a
    3522   00:5318                      TCPIP_UDP_STATE_RESP_ST2:
    3523   00:5318                          CHECK_DATA
    3523   00:5318  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3523   00:531B  CB 47             >     bit 0,a
    3524   00:531D  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST2.1
    3525   00:531F  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3526   00:5322  18 F4                   jr  TCPIP_UDP_STATE_RESP_ST2
    3527   00:5324                      TCPIP_UDP_STATE_RESP_ST2.1:
    3528   00:5324                          ; nz, get it
    3529   00:5324                          RECEIVE_DATA
    3529   00:5324  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3530   00:5327  67                      ld  h,a
    3531   00:5328                      TCPIP_UDP_STATE_RESP_ST3:
    3532   00:5328                          CHECK_DATA
    3532   00:5328  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3532   00:532B  CB 47             >     bit 0,a
    3533   00:532D  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST3.1
    3534   00:532F  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3535   00:5332  18 F4                   jr  TCPIP_UDP_STATE_RESP_ST3
    3536   00:5334                      TCPIP_UDP_STATE_RESP_ST3.1:
    3537   00:5334                          ; nz, get it
    3538   00:5334                          RECEIVE_DATA
    3538   00:5334  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3539   00:5337  47                      ld  b,a
    3540   00:5338                      TCPIP_UDP_STATE_RESP_ST4:
    3541   00:5338                          CHECK_DATA
    3541   00:5338  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3541   00:533B  CB 47             >     bit 0,a
    3542   00:533D  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST4.1
    3543   00:533F  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3544   00:5342  18 F4                   jr  TCPIP_UDP_STATE_RESP_ST4
    3545   00:5344                      TCPIP_UDP_STATE_RESP_ST4.1:
    3546   00:5344                          ; nz, get it
    3547   00:5344                          RECEIVE_DATA
    3547   00:5344  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3548   00:5347  5F                      ld  e,a
    3549   00:5348                      TCPIP_UDP_STATE_RESP_ST5:
    3550   00:5348                          CHECK_DATA
    3550   00:5348  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3550   00:534B  CB 47             >     bit 0,a
    3551   00:534D  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST5.1
    3552   00:534F  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3553   00:5352  18 F4                   jr  TCPIP_UDP_STATE_RESP_ST5
    3554   00:5354                      TCPIP_UDP_STATE_RESP_ST5.1:
    3555   00:5354                          ; nz, get it
    3556   00:5354                          RECEIVE_DATA
    3556   00:5354  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3557   00:5357  57                      ld  d,a
    3558   00:5358                          ; done
    3559   00:5358  AF                      xor a
    3560   00:5359  C9                      ret
    3561   00:535A                      
    3562   00:535A                      ;========================
    3563   00:535A                      ;===  TCPIP_UDP_SEND  ===
    3564   00:535A                      ;========================
    3565   00:535A                      ;Send an UDP datagram.
    3566   00:535A                      ;
    3567   00:535A                      ;Input:  A = 11
    3568   00:535A                      ;        B = Connection number
    3569   00:535A                      ;        HL = Address of datagram data
    3570   00:535A                      ;        DE = Address of parameters block
    3571   00:535A                      ;Output: A = Error code
    3572   00:535A                      ;
    3573   00:535A                      ;Parameters block:
    3574   00:535A                      ;
    3575   00:535A                      ;    +0 (4): Destination IP address
    3576   00:535A                      ;    +4 (2): Destination port
    3577   00:535A                      ;    +6 (2): Data length
    3578   00:535A                      TCPIP_UDP_SEND:
    3579   00:535A  E5                      push    hl
    3580   00:535B  D5                      push    de
    3581   00:535C                          SEND_DATA                       ; Send the command
    3581   00:535C  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3582   00:535F                          ; prepare new data size, adding our 7 bytes overhead
    3583   00:535F  DD 62                   ld  ixh,d
    3584   00:5361  DD 6B                   ld  ixl,e
    3585   00:5363  11 07 00                ld  de,7
    3586   00:5366  DD 6E 06                ld  l,(ix+6)
    3587   00:5369  DD 66 07                ld  h,(ix+7)
    3588   00:536C  19                      add hl,de
    3589   00:536D  7C                      ld  a,h
    3590   00:536E                          SEND_DATA                       ; Send the command size msb
    3590   00:536E  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3591   00:5371  7D                      ld  a,l
    3592   00:5372                          SEND_DATA                       ; Send the command size lsb
    3592   00:5372  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3593   00:5375  78                      ld  a,b
    3594   00:5376                          SEND_DATA                       ; Send the connection #
    3594   00:5376  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3595   00:5379  D1                      pop de
    3596   00:537A  E1                      pop hl
    3597   00:537B  1A                      ld  a,(de)
    3598   00:537C                          SEND_DATA                       ; Send IP byte 1
    3598   00:537C  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3599   00:537F  13                      inc de
    3600   00:5380  1A                      ld  a,(de)
    3601   00:5381                          SEND_DATA                       ; Send IP byte 2
    3601   00:5381  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3602   00:5384  13                      inc de
    3603   00:5385  1A                      ld  a,(de)
    3604   00:5386                          SEND_DATA                       ; Send IP byte 3
    3604   00:5386  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3605   00:5389  13                      inc de
    3606   00:538A  1A                      ld  a,(de)
    3607   00:538B                          SEND_DATA                       ; Send IP byte 4
    3607   00:538B  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3608   00:538E  13                      inc de
    3609   00:538F  1A                      ld  a,(de)
    3610   00:5390                          SEND_DATA                       ; Send Port LSB
    3610   00:5390  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3611   00:5393  13                      inc de
    3612   00:5394  1A                      ld  a,(de)
    3613   00:5395                          SEND_DATA                       ; Send Port MSB
    3613   00:5395  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3614   00:5398                          ; now oti the data starting at hl, size is in next DE position
    3615   00:5398  13                      inc de
    3616   00:5399  1A                      ld  a,(de)
    3617   00:539A  47                      ld  b,a                         ; save lsb in b
    3618   00:539B  13                      inc de
    3619   00:539C  1A                      ld  a,(de)                      ; msb
    3620   00:539D  57                      ld  d,a                         ; put in D, there is no ld d,(de)
    3621   00:539E  58                      ld  e,b                         ; lsb
    3622   00:539F                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    3623   00:539F                          ;ld b,e                         ; Number of loops originaly in DE, not needed, b already has e
    3624   00:539F  1B                      dec de
    3625   00:53A0  14                      inc d
    3626   00:53A1                          if USE_MEM_IO = 0
    3627   00:53A1                    ~     ld  c,OUT_TX_PORT
    3628   00:53A1                    ~ TCPIP_UDP_SEND_R:
    3629   00:53A1                    ~     otir                            ; Send until B is 0
    3630   00:53A1                    ~     else
    3631   00:53A1                      TCPIP_UDP_SEND_R:
    3632   00:53A1  7E                      ld  a,(hl)
    3633   00:53A2  32 07 7F                ld  (MEM_OUT_TX_PORT),a
    3634   00:53A5  23                      inc hl
    3635   00:53A6  10 F9                   djnz TCPIP_UDP_SEND_R
    3636   00:53A8                          endif
    3637   00:53A8  15                      dec d                           ; decrement secondary counter
    3638   00:53A9  20 F6                   jr  nz,TCPIP_UDP_SEND_R         ; If still have another round, do it
    3639   00:53AB                          ; Now wait up to 600 ticks to get response
    3640   00:53AB  21 58 02                ld  hl,600
    3641   00:53AE  CD C2 5E                call    SETCOUNTER
    3642   00:53B1                      TCPIP_UDP_SEND_ST1:
    3643   00:53B1                          CHECK_DATA
    3643   00:53B1  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3643   00:53B4  CB 47             >     bit 0,a
    3644   00:53B6  20 05                   jr  nz,TCPIP_UDP_SEND_ST1.1
    3645   00:53B8  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3646   00:53BB  18 F4                   jr  TCPIP_UDP_SEND_ST1
    3647   00:53BD                      TCPIP_UDP_SEND_ST1.1:
    3648   00:53BD                          ; nz, check the data
    3649   00:53BD                          RECEIVE_DATA
    3649   00:53BD  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3650   00:53C0  FE 0B                   cp  11                          ; Is response of our command?
    3651   00:53C2  20 ED                   jr  nz,TCPIP_UDP_SEND_ST1
    3652   00:53C4                          ; now get return code, if return code other than 0, it is finished
    3653   00:53C4                      TCPIP_UDP_SEND_RC:
    3654   00:53C4                          CHECK_DATA
    3654   00:53C4  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3654   00:53C7  CB 47             >     bit 0,a
    3655   00:53C9  20 05                   jr  nz,TCPIP_UDP_SEND_RC.1
    3656   00:53CB  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3657   00:53CE  18 F4                   jr  TCPIP_UDP_SEND_RC
    3658   00:53D0                      TCPIP_UDP_SEND_RC.1:
    3659   00:53D0                          ; nz, discard
    3660   00:53D0                          RECEIVE_DATA
    3660   00:53D0  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3661   00:53D3  B7                      or  a                           ; 0?
    3662   00:53D4  C0                      ret nz                          ; if not, done
    3663   00:53D5                      
    3664   00:53D5                          ; next two bytes are return code and size bytes, don't care, it is 0
    3665   00:53D5  06 02                   ld  b,2
    3666   00:53D7                      TCPIP_UDP_SEND_ST2:
    3667   00:53D7                          CHECK_DATA
    3667   00:53D7  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3667   00:53DA  CB 47             >     bit 0,a
    3668   00:53DC  20 05                   jr  nz,TCPIP_UDP_SEND_ST2.1
    3669   00:53DE  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3670   00:53E1  18 F4                   jr  TCPIP_UDP_SEND_ST2
    3671   00:53E3                      TCPIP_UDP_SEND_ST2.1:
    3672   00:53E3                          ; nz, discard
    3673   00:53E3                          RECEIVE_DATA
    3673   00:53E3  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3674   00:53E6  05                      dec b
    3675   00:53E7  20 EE                   jr  nz,TCPIP_UDP_SEND_ST2
    3676   00:53E9                      
    3677   00:53E9                          ; done, no return data other than return code
    3678   00:53E9  AF                      xor a
    3679   00:53EA  C9                      ret
    3680   00:53EB                      
    3681   00:53EB                      ;=======================
    3682   00:53EB                      ;===  TCPIP_UDP_RCV  ===
    3683   00:53EB                      ;=======================
    3684   00:53EB                      ;Retrieve an incoming UDP datagram.
    3685   00:53EB                      ;
    3686   00:53EB                      ;Input:  A = 12
    3687   00:53EB                      ;        B = Connection number
    3688   00:53EB                      ;        HL = Address for datagram data
    3689   00:53EB                      ;        DE = Maximum data size to retrieve
    3690   00:53EB                      ;Output: A = Error code
    3691   00:53EB                      ;        L.H.E.D = Source IP address
    3692   00:53EB                      ;        IX = Source port
    3693   00:53EB                      ;        BC = Actual received data size
    3694   00:53EB                      
    3695   00:53EB                      ; Customized TIME OUT routine: If time out receiving data, retry as received data
    3696   00:53EB                      ; won't be re-sent as host is unaware of this
    3697   00:53EB                      TCPIP_UDP_RCV_CHECK_TIME_OUT:
    3698   00:53EB                          ; Save registers other than AF
    3699   00:53EB  C5                      push bc
    3700   00:53EC  D5                      push de
    3701   00:53ED  E5                      push hl
    3702   00:53EE  CD B3 5E                call    GETCOUNTER
    3703   00:53F1  7D                      ld  a,l
    3704   00:53F2  B4                      or  h
    3705   00:53F3                          ; Restore registers, we are returning
    3706   00:53F3  E1                      pop hl
    3707   00:53F4  D1                      pop de
    3708   00:53F5  C1                      pop bc
    3709   00:53F6  C0                      ret nz
    3710   00:53F7                          ; Ok, timeout...
    3711   00:53F7  F1                      pop af                          ; Get return address of who called this out of the stack, we will return from the function or re-start
    3712   00:53F8                      TCPIP_TCP_UDP_RETRY_QRCV:
    3713   00:53F8  CD D2 5E                call    GETBYTE
    3714   00:53FB  B7                      or  a
    3715   00:53FC  28 0C                   jr  z,TCPIP_UDP_RCV_CHECK_TIME_OUT.NORXRETRY
    3716   00:53FE                          ; Ok, so let's ask ESP to re-send the data and retry receiving it
    3717   00:53FE  3D                      dec a
    3718   00:53FF  CD E4 5E                call    SETBYTE                 ; we are retrying it
    3719   00:5402  3E 72                   ld  a,'r'                       ; retry transmission command
    3720   00:5404                          SEND_DATA
    3720   00:5404  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3721   00:5407  C3 2F 54                jp  TCPIP_UDP_RCV.RXRETRY       ; and retry it
    3722   00:540A                      TCPIP_UDP_RCV_CHECK_TIME_OUT.NORXRETRY:
    3723   00:540A  3E 0F                   ld  a,ERR_INV_OPER
    3724   00:540C  C9                      ret                             ; and return the function itself
    3725   00:540D                      
    3726   00:540D                      TCPIP_UDP_RCV:
    3727   00:540D  CD 0B 5F                call    SETWORD                 ; Save for later the datagram address
    3728   00:5410  3E 0C                   ld  a,12
    3729   00:5412                          SEND_DATA                       ; Send the command
    3729   00:5412  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3730   00:5415  AF                      xor a
    3731   00:5416                          SEND_DATA                       ; Send the command size msb
    3731   00:5416  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3732   00:5419  3E 03                   ld  a,3
    3733   00:541B                          SEND_DATA                       ; Send the command size lsb
    3733   00:541B  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3734   00:541E  78                      ld  a,b
    3735   00:541F                          SEND_DATA                       ; Send the connection #
    3735   00:541F  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3736   00:5422  7B                      ld  a,e
    3737   00:5423                          SEND_DATA                       ; Send MAX rcv size LSB
    3737   00:5423  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3738   00:5426  7A                      ld  a,d
    3739   00:5427                          SEND_DATA                       ; Send MAX rcv size MSB
    3739   00:5427  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3740   00:542A  3E 03                   ld  a,3
    3741   00:542C  CD E4 5E                call    SETBYTE                 ; Ok, retry up to three times
    3742   00:542F                      TCPIP_UDP_RCV.RXRETRY:
    3743   00:542F                          ; Now wait up to 600 ticks to get response
    3744   00:542F  21 58 02                ld  hl,600
    3745   00:5432  CD C2 5E                call    SETCOUNTER
    3746   00:5435                      TCPIP_UDP_RCV_ST1:
    3747   00:5435                          CHECK_DATA
    3747   00:5435  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3747   00:5438  CB 47             >     bit 0,a
    3748   00:543A  20 05                   jr  nz,TCPIP_UDP_RCV_ST1.1
    3749   00:543C  CD EB 53                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3750   00:543F  18 F4                   jr  TCPIP_UDP_RCV_ST1
    3751   00:5441                      TCPIP_UDP_RCV_ST1.1:
    3752   00:5441                          ; nz, check the data
    3753   00:5441                          RECEIVE_DATA
    3753   00:5441  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3754   00:5444  FE 0C                   cp  12                          ; Is response of our command?
    3755   00:5446  20 ED                   jr  nz,TCPIP_UDP_RCV_ST1
    3756   00:5448                          ; At this point, all data is being buffered, so 30 ticks, half second, is more than enough time-out
    3757   00:5448  F3                      di
    3758   00:5449  21 1E 00                ld  hl,30
    3759   00:544C  CD C2 5E                call    SETCOUNTER
    3760   00:544F  FB                      ei
    3761   00:5450                          ; now get return code, if return code other than 0, it is finished
    3762   00:5450                      TCPIP_UDP_RCV_RC:
    3763   00:5450                          CHECK_DATA
    3763   00:5450  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3763   00:5453  CB 47             >     bit 0,a
    3764   00:5455  20 05                   jr  nz,TCPIP_UDP_RCV_RC.1
    3765   00:5457  CD EB 53                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3766   00:545A  18 F4                   jr  TCPIP_UDP_RCV_RC
    3767   00:545C                      TCPIP_UDP_RCV_RC.1:
    3768   00:545C                          ; nz, discard
    3769   00:545C                          RECEIVE_DATA
    3769   00:545C  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3770   00:545F  B7                      or  a                           ; 0?
    3771   00:5460  C0                      ret nz                          ; if not, done
    3772   00:5461                          ; next two bytes are return code and size bytes, save it to BC
    3773   00:5461                      TCPIP_UDP_RCV_ST2A:
    3774   00:5461                          CHECK_DATA
    3774   00:5461  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3774   00:5464  CB 47             >     bit 0,a
    3775   00:5466  20 05                   jr  nz,TCPIP_UDP_RCV_ST2A.1
    3776   00:5468  CD EB 53                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3777   00:546B  18 F4                   jr  TCPIP_UDP_RCV_ST2A
    3778   00:546D                      TCPIP_UDP_RCV_ST2A.1:
    3779   00:546D                          ; nz, discard
    3780   00:546D                          RECEIVE_DATA
    3780   00:546D  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3781   00:5470  67                      ld  h,a
    3782   00:5471                      TCPIP_UDP_RCV_ST2B:
    3783   00:5471                          CHECK_DATA
    3783   00:5471  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3783   00:5474  CB 47             >     bit 0,a
    3784   00:5476  20 05                   jr  nz,TCPIP_UDP_RCV_ST2B.1
    3785   00:5478  CD EB 53                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3786   00:547B  18 F4                   jr  TCPIP_UDP_RCV_ST2B
    3787   00:547D                      TCPIP_UDP_RCV_ST2B.1:
    3788   00:547D                          ; nz, discard
    3789   00:547D                          RECEIVE_DATA
    3789   00:547D  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3790   00:5480  6F                      ld  l,a
    3791   00:5481  01 06 00                ld  bc,6
    3792   00:5484                          ; subtract 6 (IP and PORT)
    3793   00:5484  AF                      xor a                           ; zero carry
    3794   00:5485  ED 42                   sbc hl,bc
    3795   00:5487  4D                      ld  c,l
    3796   00:5488  44                      ld  b,h                         ; BC has effective received data size
    3797   00:5489                          ; now just get the 4 bytes IP and place it in L H E D
    3798   00:5489                      TCPIP_UDP_RCV_IP_ST1:
    3799   00:5489                          CHECK_DATA
    3799   00:5489  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
