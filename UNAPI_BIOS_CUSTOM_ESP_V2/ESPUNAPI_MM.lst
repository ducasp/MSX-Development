    5567   00:5D75                    ~     ld  c,IN_DATA_PORT
    5568   00:5D75                    ~     CHECK_QUICK_RECEIVE
    5569   00:5D75                    ~     jr  z,TCPIP_TCP_RCV_R_NSF       ; If not, go to the old, slower route
    5570   00:5D75                    ~     ; Otherwise, let's speed it up baby!
    5571   00:5D75                    ~ TCPIP_TCP_RCV_R:
    5572   00:5D75                    ~     inir
    5573   00:5D75                    ~     else
    5574   00:5D75                          CHECK_QUICK_RECEIVE
    5574   00:5D75  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5574   00:5D78  CB 5F             >     bit 3,a
    5575   00:5D7A  28 1A                   jr  z,TCPIP_TCP_RCV_R_NSF       ; If not, go to the old, slower route
    5576   00:5D7C                          ; Otherwise, let's speed it up baby!
