    4567   00:5830                      ;=========================
    4568   00:5830                      ;===   SSH_KEY_EXPORT   ===
    4569   00:5830                      ;=========================
    4570   00:5830                      ;Export SSH key data.
    4571   00:5830                      ;
    4572   00:5830                      ;Input:  A  = 13
    4573   00:5830                      ;        B  = What to export (0/1/2)
    4574   00:5830                      ;        DE = Output buffer address
    4575   00:5830                      ;        HL = Max data per chunk
    4576   00:5830                      ;Output: A  = Error code
