    3105   00:5127                          ; nz, discard
    3106   00:5127                          RECEIVE_DATA
    3106   00:5127  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3107   00:512A  05                      dec b
    3108   00:512B  20 EE                   jr  nz,TCPIP_NET_STATE_ST2
    3109   00:512D                      
    3110   00:512D                          ; now just get the 1 byte (NET STATE) IP and place it in B
    3111   00:512D                      TCPIP_NET_STATE_NS_ST1:
    3112   00:512D                          CHECK_DATA
    3112   00:512D  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3112   00:5130  CB 47             >     bit 0,a
