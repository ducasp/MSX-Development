    5557   00:5D7C  FE 19                   cp  25                          ; Is response of our command?
    5558   00:5D7E  20 ED                   jr  nz,TCPIP_CONFIG_AUTOIP_ST1
    5559   00:5D80                          ; now get return code, if return code other than 0, it is finished
    5560   00:5D80                      TCPIP_CONFIG_AUTOIP_RC:
    5561   00:5D80                          CHECK_DATA
    5561   00:5D80  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5561   00:5D83  CB 47             >     bit 0,a
    5562   00:5D85  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_RC.1
    5563   00:5D87  CD 1D 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5564   00:5D8A  18 F4                   jr  TCPIP_CONFIG_AUTOIP_RC
    5565   00:5D8C                      TCPIP_CONFIG_AUTOIP_RC.1:
    5566   00:5D8C                          ;nz, discard
    5567   00:5D8C                          RECEIVE_DATA
    5567   00:5D8C  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5568   00:5D8F  B7                      or  a                           ; 0?
    5569   00:5D90  C0                      ret nz                          ; if not, done
    5570   00:5D91                      
    5571   00:5D91                          ; next two bytes are return code and size bytes, don't care, it is 1, configuration
    5572   00:5D91  06 02                   ld  b,2
    5573   00:5D93                      TCPIP_CONFIG_AUTOIP_ST2:
    5574   00:5D93                          CHECK_DATA
    5574   00:5D93  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5574   00:5D96  CB 47             >     bit 0,a
    5575   00:5D98  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_ST2.1
