    4981   00:5A93  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4982   00:5A96  79                      ld  a,c
    4983   00:5A97                          SEND_DATA                       ; Send the connection flags
    4983   00:5A97  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
