    5190   00:5B94                          ; nz, check the data
    5191   00:5B94                          RECEIVE_DATA
    5191   00:5B94  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5192   00:5B97  FE 11                   cp  17                          ; Is response of our command?
    5193   00:5B99  20 ED                   jr  nz,TCPIP_TCP_SEND_ST1
    5194   00:5B9B                          ; now get return code, if return code other than 0, it is finished
    5195   00:5B9B                      TCPIP_TCP_SEND_RC:
    5196   00:5B9B                          CHECK_DATA
    5196   00:5B9B  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
