    3938   00:555E                      ;========================
    3939   00:555E                      ;===  TCPIP_TCP_OPEN  ===
    3940   00:555E                      ;========================
    3941   00:555E                      ;Open a TCP connection.
    3942   00:555E                      ;
    3943   00:555E                      ;Input:  A  = 13
    3944   00:555E                      ;        HL = Address of parameters block
    3945   00:555E                      ;Output: A = Error code
    3946   00:555E                      ;        B = Connection number
    3947   00:555E                      ;        C = Connection not open reason (mostly for TLS)
    3948   00:555E                      ;
    3949   00:555E                      ;Parameters block format:
    3950   00:555E                      ;
    3951   00:555E                      ;+0 (4): Remote IP address (0.0.0.0 for unspecified remote socket)
    3952   00:555E                      ;+4 (2): Remote port (ignored if unspecified remote socket)
    3953   00:555E                      ;+6 (2): Local port, 0FFFFh for a random value
    3954   00:555E                      ;+8 (2): Suggestion for user timeout value
    3955   00:555E                      ;+10 (1): Flags:
    3956   00:555E                      ;         bit 0: Set for passive connection
    3957   00:555E                      ;         bit 1: Set for resident connection
    3958   00:555E                      ;         bit 2: Set for TLS connection
    3959   00:555E                      ;         bit 3: Set for TLS connection validating host certificate
    3960   00:555E                      ;+11 (2): If 0000 no host name validation, otherwise the hostname string address (zero terminated)
    3961   00:555E                      ;TCP_OPEN_IP1               (ix+0)
    3962   00:555E                      ;TCP_OPEN_IP2               (ix+1)
    3963   00:555E                      ;TCP_OPEN_IP3               (ix+2)
    3964   00:555E                      ;TCP_OPEN_IP4               (ix+3)
    3965   00:555E                      ;TCP_OPEN_RP                (ix+4)
    3966   00:555E                      ;TCP_OPEN_LP                (ix+6)
    3967   00:555E                      ;TCP_OPEN_TO                (ix+8)
    3968   00:555E                      ;TCP_OPEN_CMD_FLAGS         (ix+10)
    3969   00:555E                      ;TCP_OPEN_CMD_HOST_LSB      (ix+11)
    3970   00:555E                      ;TCP_OPEN_CMD_HOST_MSB      (ix+12)
    3971   00:555E                      
    3972   00:555E                      ; When no connection, let's get the reason and put in register C, as agreed
    3973   00:555E                      ; with Nestor this will be the way to go in the next UNAPI revision
    3974   00:555E                      TCPIP_TCP_OPEN_ERROR:
    3975   00:555E                          ; next two bytes are return code and size bytes, don't care, it is 1, conn close reason
    3976   00:555E  47                      ld  b,a                         ; save error in b
    3977   00:555F  0E 02                   ld  c,2
    3978   00:5561                      TCPIP_TCP_OPEN_ERROR2:
    3979   00:5561                          CHECK_DATA
    3979   00:5561  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3979   00:5564  CB 47             >     bit 0,a
    3980   00:5566  20 05                   jr  nz,TCPIP_TCP_OPEN_ERROR2.1
    3981   00:5568  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3982   00:556B  18 F4                   jr  TCPIP_TCP_OPEN_ERROR2
    3983   00:556D                      TCPIP_TCP_OPEN_ERROR2.1:
    3984   00:556D                          ; nz, discard
    3985   00:556D                          RECEIVE_DATA
    3985   00:556D  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3986   00:5570  0D                      dec c
    3987   00:5571  20 EE                   jr  nz,TCPIP_TCP_OPEN_ERROR2
    3988   00:5573  78                      ld  a,b
    3989   00:5574  FE 0B                   cp  ERR_NO_CONN
    3990   00:5576  20 10                   jr  nz,TCPIP_TCP_OPEN_ERROR4    ; other errors do not have extra bytes as result
    3991   00:5578                      ; now just get the 1 byte, close reason, should go to C
    3992   00:5578                      TCPIP_TCP_OPEN_ERROR3:
    3993   00:5578                          CHECK_DATA
    3993   00:5578  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3993   00:557B  CB 47             >     bit 0,a
    3994   00:557D  20 05                   jr  nz,TCPIP_TCP_OPEN_ERROR3.1
    3995   00:557F  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3996   00:5582  18 F4                   jr  TCPIP_TCP_OPEN_ERROR3
