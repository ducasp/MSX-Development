    1638   00:491F  FE 1B                   cp  #1b                         ; ESC?
    1639   00:4921  CA 66 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1640   00:4924  FE 4F                   cp  'O'                         ; Toggle Nagle On
