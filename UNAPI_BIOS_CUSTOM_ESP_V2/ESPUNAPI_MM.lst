    5245   00:5BD9                          SEND_DATA                       ; Send the connection #
    5245   00:5BD9  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5246   00:5BDC  2B                      dec hl
    5247   00:5BDD  EB                      ex  de,hl
    5248   00:5BDE                          ; now oti the data starting at hl, size is in DE
    5249   00:5BDE                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    5250   00:5BDE  43                      ld  b,e                         ;Number of loops originaly in DE
    5251   00:5BDF  1B                      dec de
    5252   00:5BE0  14                      inc d
    5253   00:5BE1                          if USE_MEM_IO = 0
    5254   00:5BE1                    ~     ld  c,OUT_TX_PORT
    5255   00:5BE1                    ~ SSH_SEND_R:
    5256   00:5BE1                    ~     outi
    5257   00:5BE1                    ~     jr  nz,SSH_SEND_R
    5258   00:5BE1                    ~     else
    5259   00:5BE1                      SSH_SEND_R:
    5260   00:5BE1  7E                      ld  a,(hl)
    5261   00:5BE2  32 07 7F                ld  (MEM_OUT_TX_PORT),a
