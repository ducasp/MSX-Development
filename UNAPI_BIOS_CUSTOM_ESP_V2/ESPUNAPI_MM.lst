    3049   00:50E9                      ;=========================
    3050   00:50E9                      ;===  TCPIP_NET_STATE  ===
    3051   00:50E9                      ;=========================
    3052   00:50E9                      ;Get network state.
    3053   00:50E9                      ;
    3054   00:50E9                      ;Input:  A = 3
    3055   00:50E9                      ;Output: A = Error code
    3056   00:50E9                      ;        B = Current network state:
    3057   00:50E9                      ;            0: Closed
    3058   00:50E9                      ;            1: Opening
    3059   00:50E9                      ;            2: Open
    3060   00:50E9                      ;            3: Closing
    3061   00:50E9                      ;            255: Unknown
    3062   00:50E9                      TCPIP_NET_STATE:
    3063   00:50E9                          SEND_DATA                       ; Send the command
    3063   00:50E9  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3064   00:50EC  AF                      xor a
    3065   00:50ED                          SEND_DATA                       ; Send the command size msb
    3065   00:50ED  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3066   00:50F0                          SEND_DATA                       ; Send the command size lsb
    3066   00:50F0  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3067   00:50F3                      
    3068   00:50F3                          ; Now wait up to 720 ticks to get response
    3069   00:50F3  21 D0 02                ld  hl,720
    3070   00:50F6  CD 61 63                call    SETCOUNTER
    3071   00:50F9                      TCPIP_NET_STATE_ST1:
    3072   00:50F9                          CHECK_DATA
    3072   00:50F9  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3072   00:50FC  CB 47             >     bit 0,a
    3073   00:50FE  20 05                   jr  nz,TCPIP_NET_STATE_ST1.1
