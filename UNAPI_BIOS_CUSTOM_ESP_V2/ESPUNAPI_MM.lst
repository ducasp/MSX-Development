    1065   00:4533  3E 0C                   ld  a,12                        ; So, twelve
    1066   00:4535  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1067   00:4538  DD 77 01                ld  (ix+1),a                    ; Save
    1068   00:453B  79                      ld  a,c
