    3889   00:551B  50                      ld  d,b
    3890   00:551C  59                      ld  e,c
    3891   00:551D                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use ini :-D
    3892   00:551D  43                      ld  b,e                         ; Number of loops originaly in DE
    3893   00:551E  1B                      dec de
    3894   00:551F  14                      inc d
    3895   00:5520                          if USE_MEM_IO = 0
    3896   00:5520                    ~     ld  c,IN_DATA_PORT
