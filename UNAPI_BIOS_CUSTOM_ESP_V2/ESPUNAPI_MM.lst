    5832   00:5ED7  CB 47             >     bit 0,a
    5833   00:5ED9  20 05                   jr  nz,SSH_AUTH_GET_CHALLENGE_ST1.1
    5834   00:5EDB  CD 8C 5C                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    5835   00:5EDE  18 F4                   jr  SSH_AUTH_GET_CHALLENGE_ST1
    5836   00:5EE0                      SSH_AUTH_GET_CHALLENGE_ST1.1:
    5837   00:5EE0                          ; nz, check the data
