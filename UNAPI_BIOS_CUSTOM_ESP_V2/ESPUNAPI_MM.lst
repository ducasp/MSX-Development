    5822   00:5EBE  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5823   00:5EC1  3E 03                   ld  a,3
    5824   00:5EC3  CD 58 61                call    SETBYTE                 ; Ok, retry up to three times
