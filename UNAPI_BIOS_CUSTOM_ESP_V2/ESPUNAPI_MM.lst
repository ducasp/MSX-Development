     139   00:4000  (00:0001)           USE_MEM_IO:             equ 1
     140   00:4000                      ;--- FPGA Version can have the Turbo-R logo incorporated or not...
     141   00:4000  (00:0001)           TURBO_R_LOGO:           equ 1
