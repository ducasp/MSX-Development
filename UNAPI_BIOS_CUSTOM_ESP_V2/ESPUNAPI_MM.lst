    4608   00:585E  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4609   00:5861  FE 84                   cp  #84                         ; Is response of our command?
    4610   00:5863  20 ED                   jr  nz,SSH_STATE_ST1
