    5476   00:5D3C  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5477   00:5D3F  DD 67                   ld  ixh,a
    5478   00:5D41                      
    5479   00:5D41                      ; Check if there is an information block
    5480   00:5D41  CD 0A 64                call    BCBACKUP                ; Save BC, we gonna use it
    5481   00:5D44  06 08                   ld  b,8                         ; prepare in advance for 8 bytes being transferred
    5482   00:5D46  CD 71 63                call    GETBYTE                 ; Let's check if we have flagged need for INFOBLOCK
    5483   00:5D49  B7                      or  a
    5484   00:5D4A  20 17                   jr  nz,TCPIP_TCP_STATE_GET_IBLOCK
    5485   00:5D4C                      
    5486   00:5D4C                      ; If here, just discard Information Block (next 8 bytes)
    5487   00:5D4C                      TCPIP_TCP_STATE_DISCARD_IBLOCK:
    5488   00:5D4C                          CHECK_DATA
    5488   00:5D4C  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5488   00:5D4F  CB 47             >     bit 0,a
    5489   00:5D51  20 05                   jr  nz,TCPIP_TCP_STATE_DISCARD_IBLOCK.1
    5490   00:5D53  CD 2B 4E                call    TCPIP_GENERIC_CHECK_TIME_OUT
    5491   00:5D56  18 F4                   jr  TCPIP_TCP_STATE_DISCARD_IBLOCK
    5492   00:5D58                      TCPIP_TCP_STATE_DISCARD_IBLOCK.1:
