    6192   00:6099  C0                      ret nz                          ; if not get, not implemented
    6193   00:609A                          ; get, so just return C = 1, A = OK = 0
    6194   00:609A  AF                      xor a
    6195   00:609B  0E 01                   ld  c,1
    6196   00:609D  C9                      ret
