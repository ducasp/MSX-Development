    1735   00:49FD                          SEND_DATA
    1735   00:49FD  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1736   00:4A00  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1737   00:4A03  CD 40 4B                call    WAIT_MENU_QCMD_RESPONSE
