    1610   00:48EC                      SET_NAGLE:
    1611   00:48EC  3E 31                   ld  a,'1'
    1612   00:48EE  CD A2 00                call    CHPUT
    1613   00:48F1  CD 07 4A                call    WAIT_250MS_AND_THEN_CONTINUE
    1614   00:48F4  21 4B 66                ld  hl,MMENU_NAGLE
    1615   00:48F7  CD 8E 4C                call    PRINTHL                 ; Print Main Nagle message
    1616   00:48FA  CD 2A 4A                call    CHECKNAGLE              ; Nagle is on or off?
    1617   00:48FD  20 1E                   jr  nz,NAGLE_IS_ON              ;
    1618   00:48FF  21 80 67                ld  hl,MMENU_NAGLE_OFF          ; Show the menu telling nagle is off
    1619   00:4902  CD 8E 4C                call    PRINTHL                 ; Print options
    1620   00:4905                      SET_NAGLE_WI_ON:
