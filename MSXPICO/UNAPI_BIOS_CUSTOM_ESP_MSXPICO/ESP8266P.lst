    1634   00:4923                      SET_NAGLE_WI_OFF:
    1635   00:4923  CD 9F 00                call    CHGET
    1636   00:4926  FE 1B                   cp  #1b                         ; ESC?
    1637   00:4928  CA 5C 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1638   00:492B  FE 4F                   cp  'O'                         ; Toggle Nagle Off
    1639   00:492D  CA 7B 49                jp  z,SET_NAGLE_OFF             ;
    1640   00:4930  FE 6F                   cp  'o'                         ; Toggle Nagle Off
    1641   00:4932  CA 7B 49                jp  z,SET_NAGLE_OFF             ;
    1642   00:4935  CD C0 00                call    BEEP                    ; Wrong Input, beep
