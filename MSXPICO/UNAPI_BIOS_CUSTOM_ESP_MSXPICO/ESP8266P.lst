    2752   00:4F43                          ; nz, discard
    2753   00:4F43                          RECEIVE_DATA
    2753   00:4F43  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2754   00:4F46  B7                      or  a                           ; 0?
    2755   00:4F47  C0                      ret nz                          ; if not, done
    2756   00:4F48                      
    2757   00:4F48                          ; next two bytes are return code and size bytes, don't care, it is 4
    2758   00:4F48  06 02                   ld  b,2
