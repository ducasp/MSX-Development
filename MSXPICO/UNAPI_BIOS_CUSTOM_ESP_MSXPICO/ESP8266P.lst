     334   00:4000                      ;************************
     335   00:4000                      ;***  MSX ROM HEADER  ***
     336   00:4000                      ;************************
     337   00:4000                          org #4000
     338   00:4000  41 42                   db                  #41,#42
     339   00:4002  10 40                   dw                  INIT        ; Initialize ESP, if not found, won't install hook
     340   00:4004  00 00                   dw                  0           ; Statement
     341   00:4006  00 00                   dw                  0           ; Device
     342   00:4008  00 00                   dw                  0           ; Text
     343   00:400A  00 (6)                  ds                  6           ; Reserved
     344   00:4010                      
     345   00:4010                      ;==================
     346   00:4010                      ;===  Start-up  ===
     347   00:4010                      ;==================
     348   00:4010                      
     349   00:4010                      INIT:
     350   00:4010  7C                      ld  a,h                         ; Let's test if we are mirrored and being executed in wrong page
     351   00:4011  FE 40                   cp  #40                         ; is MSB 0x40?
     352   00:4013  C0                      ret nz                          ; if not, return, it is a mirror
     353   00:4014                          ; Let's set some System Variables
     354   00:4014  AF                      xor a                           ; a = #00
     355   00:4015  32 A9 FC                ld  (CSRSW),a                   ; cursor display is disabled
     356   00:4018  32 DB F3                ld  (CLIKSW),a                  ; when key press, key click disabled
     357   00:401B                          ; Let's intercept [DEL] key
     358   00:401B  3E 08                   ld  a,8
     359   00:401D  CD 41 01                call    SNSMAT
     360   00:4020  CB 5F                   bit 3,a                         ; Test [DEL]
     361   00:4022  C8                      ret z                           ; If DEL is pressed, UNAPI driver is not loaded and exits
     362   00:4023                          ; Let's check the Screen Mode, ref. https://www.msx.org/wiki/VDP_Table_Base_Address_Registers
     363   00:4023  3A E1 F3                ld  a,(REG2SAV)
     364   00:4026  FE 02                   cp  2
     365   00:4028  CA 32 40                jp  z,SCREEN_SETUP              ; If yes, is SCREEN 3
     366   00:402B  3A E3 F3                ld  a,(REG4SAV)
     367   00:402E  FE 00                   cp  0
     368   00:4030  28 06                   jr  z,IS_SCREEN1                ; If yes, is SCREEN 1
     369   00:4032                      SCREEN_SETUP:
     370   00:4032                          ; Let's set the SCREEN 1
     371   00:4032  3E 01                   ld  a,1                         ; a = #01
     372   00:4034  F7                      rst #30
     373   00:4035  00                      db  0
     374   00:4036  5F 00                   dw  CHGMOD                      ; SCREEN 1
     375   00:4038                      IS_SCREEN1:
     376   00:4038  3E 1D                   ld  a,29                        ; WIDTH 29
     377   00:403A  32 B0 F3                ld  (LINLEN),a
     378   00:403D                          ; We check if the Port F2 device is available
     379   00:403D                          READ_F2                         ; a = #FF, default value if it comes from power off or hard reset
     379   00:403D  3A 05 7F          >     ld  a,(MEM_PORT_F2)
     380   00:4040  2F                      cpl                             ; a = #FF - a
     381   00:4041  4F                      ld  c,a                         ; c = #00
     382   00:4042                          WRITE_F2                        ; a = #00
     382   00:4042  32 05 7F          >     ld  (MEM_PORT_F2),a
     383   00:4045                          ; Wait 250ms to ensure a successful hard reset even if you press the button very quickly
     384   00:4045  CD 07 4A                call    WAIT_250MS_AND_THEN_CONTINUE
     385   00:4048                          READ_F2                         ; a = #00?
     385   00:4048  3A 05 7F          >     ld  a,(MEM_PORT_F2)
     386   00:404B  2F                      cpl                             ; a = #FF - a
     387   00:404C                          WRITE_F2                        ; a = #FF?
     387   00:404C  32 05 7F          >     ld  (MEM_PORT_F2),a
     388   00:404F  F5                      push    af
     389   00:4050  3E FE                   ld  a,#FE                       ; Preset #FE, unexpected error
     390   00:4052                          WRITE_F2                        ; on port #F2
     390   00:4052  32 05 7F          >     ld  (MEM_PORT_F2),a
     391   00:4055  F1                      pop af
     392   00:4056  B9                      cp  c                           ; If not a = c, port #F2 is writable and available
     393   00:4057  28 3D                   jr  z,BOOT_FROM_POWER_OFF       ; If a = c, port #F2 is not available, let's proceed as "boot from power off"
     394   00:4059                          ; Ok, Port F2 device available
     395   00:4059  FE EF                   cp  #EF                         ; UNAPI driver has been disabled
     396   00:405B  20 04                   jr  nz,NOT_DISABLED_BY_F2       ; No, let's continue checking
     397   00:405D                          WRITE_F2                        ; If yes, UNAPI driver is not loaded and exits, but need to restore F2 port to not have a false error
     397   00:405D  32 05 7F          >     ld  (MEM_PORT_F2),a
     398   00:4060  C9                      ret                             ; And our work is done
     399   00:4061                      NOT_DISABLED_BY_F2:
     400   00:4061  FE F0                   cp  #F0                         ; UNAPI driver has been loaded at least once
     401   00:4063  C2 78 40                jp  nz, F2_IS_NOT_F0            ; Ok, has not been loaded
     402   00:4066                          ; Let's intercept [F1] key
     403   00:4066  3E 06                   ld  a,6
     404   00:4068  CD 41 01                call    SNSMAT
     405   00:406B  CB 6F                   bit 5,a                         ; Test [F1]
     406   00:406D  CA 40 42                jp  z,ENTERING_ESPSETUP         ; If F1 is pressed, let's execute our setup menu
     407   00:4070                          ; F1 is not pressed, continue
     408   00:4070  CB 77                   bit 6,a                         ; Test [F2]
     409   00:4072  C2 E9 40                jp  nz,INIT_UNAPI               ; If F2 is not pressed, let's proceed to INIT_UNAPI
     410   00:4075                          ; F2 is not pressed, continue
     411   00:4075  C3 A2 41                jp  INIT_NOCLOCKUPDAT2          ; If yes, proceed without affecting the connection or the date and time
     412   00:4078                      F2_IS_NOT_F0:
     413   00:4078  FE F1                   cp  #F1                         ; User requested to go directly to Wi-Fi Setup
     414   00:407A  CA 40 42                jp  z,ENTERING_ESPSETUP         ; If yes, let's execute our setup menu
     415   00:407D  FE F2                   cp  #F2                         ; User forces to check if ESP is installed
     416   00:407F  CA C5 40                jp  z,F2_IS_PRESSED             ; If yes, let's go check it out
     417   00:4082  FE FE                   cp  #FE                         ; Unexpected error from the previous reboot
     418   00:4084  20 10                   jr  nz,BOOT_FROM_POWER_OFF      ; If no one is confirmed, let's proceed as "boot from power off"
     419   00:4086                          ; Oops! An unexpected error occurred on the last reboot
     420   00:4086  21 84 69                ld  hl,STR_OOPS                 ; Print Oops! An unexpected error message
     421   00:4089  CD 8E 4C                call    PRINTHL                 ; and let's proceed as "boot from power off"
     422   00:408C  06 78                   ld  b,120                       ; Wait 2 seconds with message on screen
     423   00:408E                      WAIT_2S:
     424   00:408E  76                      halt
     425   00:408F  10 FD                   djnz    WAIT_2S                 ; If not zero, our time out has not elapsed
     426   00:4091  3E 0C                   ld  a,CLS
     427   00:4093  CD A2 00                call    CHPUT
     428   00:4096                      BOOT_FROM_POWER_OFF:
     429   00:4096                          ; Let's intercept [F1] key
     430   00:4096  3E 06                   ld  a,6
     431   00:4098  CD 41 01                call    SNSMAT
     432   00:409B  CB 6F                   bit 5,a                         ; Test [F1]
     433   00:409D  CA 40 42                jp  z,ENTERING_ESPSETUP         ; If F1 is pressed, let's execute our setup menu
     434   00:40A0                          ; F1 is not pressed, continue
     435   00:40A0                          if  NON_VERBOSE_ROM = 0
     436   00:40A0  21 5E 5D                ld  hl,WELCOME
     437   00:40A3  CD 8E 4C                call    PRINTHL
     438   00:40A6                          CHECK_QUICK_RECEIVE
     438   00:40A6  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
     438   00:40A9  CB 5F             >     bit 3,a
     439   00:40AB  20 08                   jr  nz,BOOT_FROM_POWER_OFF.1    ; QR Supported
     440   00:40AD  21 C8 5D                ld  hl,WELCOME_SF2
     441   00:40B0  CD 8E 4C                call    PRINTHL
     442   00:40B3  18 06                   jr  BOOT_FROM_POWER_OFF.2
     443   00:40B5                      BOOT_FROM_POWER_OFF.1:
     444   00:40B5  21 AC 5D                ld  hl,WELCOME_SF
     445   00:40B8  CD 8E 4C                call    PRINTHL
     446   00:40BB                      BOOT_FROM_POWER_OFF.2:
     447   00:40BB                          endif
     448   00:40BB  3E 06                   ld  a,6
     449   00:40BD  CD 41 01                call    SNSMAT
     450   00:40C0  CB 77                   bit 6,a                         ; Test [F2]
     451   00:40C2  C2 E9 40                jp  nz,INIT_UNAPI               ; If F2 is not pressed, let's proceed to INIT_UNAPI
     452   00:40C5                          ; F2 is pressed, continue
     453   00:40C5                      F2_IS_PRESSED:
     454   00:40C5  CD A1 5B                call    RESET_ESP
     455   00:40C8  B7                      or  a
     456   00:40C9  20 06                   jr  nz,ESP_NOT_FOUND
     457   00:40CB  21 DC 68                ld  hl,OK_S                     ; Properly detected
     458   00:40CE  C3 DB 40                jp  INIT_F_MSG                  ; Well, if reset successful, continue
     459   00:40D1                      ESP_NOT_FOUND:
     460   00:40D1                          ; If here, ESP was not found, so, exit with an error message
     461   00:40D1  78                      ld  a,b
     462   00:40D2  B7                      or  a
     463   00:40D3  21 F7 68                ld  hl,FAIL_S                   ; If 0, non responsive
     464   00:40D6  28 03                   jr  z,INIT_F_MSG
     465   00:40D8  21 45 69                ld  hl,FAIL_F                   ; Otherwise, firmware is old
     466   00:40DB                      INIT_F_MSG:
     467   00:40DB  CD 8E 4C                call    PRINTHL
     468   00:40DE                      INIT_F_WAIT:
     469   00:40DE  06 B4                   ld  b,180                       ; 3s
     470   00:40E0                      INIT_F_LOOP_WAIT:
     471   00:40E0  76                      halt
     472   00:40E1  10 FD                   djnz    INIT_F_LOOP_WAIT
     473   00:40E3                      AND_DONE:
     474   00:40E3  3E EF                   ld  a,#EF                       ; Set #EF, ESP Not Found
     475   00:40E5                          WRITE_F2                        ; on port #F2
     475   00:40E5  32 05 7F          >     ld  (MEM_PORT_F2),a
     476   00:40E8  C9                      ret                             ; And done
     477   00:40E9                      INIT_UNAPI:
     478   00:40E9                          CLEAR_UART
     478   00:40E9  3E 14             >     ld  a,20
     478   00:40EB  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     479   00:40EE  3E 63                   ld  a,CMD_QUERY_ACLK_SETTINGS
     480   00:40F0                          SEND_DATA
     480   00:40F0  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     481   00:40F3  21 3C 00                ld  hl,60                       ; Wait Up To 1s
     482   00:40F6  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
     483   00:40FA  DD 6B                   ld  ixl,e
     484   00:40FC  DD 62                   ld  ixh,d                       ; Address in IX
     485   00:40FE  CD 66 4B                call    WAIT_MENU_CMD_RESPONSE
     486   00:4101  CA 98 41                jp  z,INIT_NOCLOCKUPDATE        ; If error, just skip
     487   00:4104                          ; Response received, IX+0 and IX+1 has Auto Clock and GMT
     488   00:4104  3E 03                   ld  a,3
     489   00:4106  DD BE 00                cp  (ix+0)
     490   00:4109  20 0B                   jr  nz,INIT_UNAPI2              ; If not disabled continue on INIT_UNAPI2
     491   00:410B                          ; Disabled, ok, so let's ensure connection is not locked (just in case it was setup as disabled right now)
     492   00:410B                          CLEAR_UART
     492   00:410B  3E 14             >     ld  a,20
     492   00:410D  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     493   00:4110  3E 68                   ld  a,CMD_WIFIRELEASE_ESP
     494   00:4112                          SEND_DATA                       ; Just send, no need to wait response
     494   00:4112  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     495   00:4115  C9                      ret
     496   00:4116                      INIT_UNAPI2:
     497   00:4116  3A 2D 00                ld  a,(#002D)                   ; Check MSX Version
     498   00:4119  B7                      or  a
     499   00:411A  28 7C                   jr  z,INIT_NOCLOCKUPDATE        ; If zero, MSX1, can't set clock
     500   00:411C  AF                      xor a
     501   00:411D  DD B6 00                or  (ix+0)
     502   00:4120  28 76                   jr  z,INIT_NOCLOCKUPDATE        ; if turned off, skip
     503   00:4122                          ; Ok, not zero, so we are going to simply request the time, it might take up to 10s
     504   00:4122  DD 23                   inc ix
     505   00:4124  DD 23                   inc ix                          ; ok, leave IX+0 and IX+1 intact
     506   00:4126                          ; b = number of response check attempts
     507   00:4126  06 05                   ld  b,5                         ; 5 * 2s = 10s
     508   00:4128                          CLEAR_UART
     508   00:4128  3E 14             >     ld  a,20
     508   00:412A  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     509   00:412D  3E 47                   ld  a,CMD_GET_TIME
     510   00:412F                          SEND_DATA
     510   00:412F  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     511   00:4132                      TRY_AGAIN:
     512   00:4132  C5                      push    bc
     513   00:4133  21 78 00                ld  hl,120                      ; Wait Up To 2s per attempt
     514   00:4136  CD 66 4B                call    WAIT_MENU_CMD_RESPONSE
     515   00:4139  20 1E                   jr  nz,INIT_CLOCKUPDATE         ; if ok, follow up
     516   00:413B  21 64 69                ld  hl,STR_WAITING              ; Print Waiting for connection message
     517   00:413E  CD 8E 4C                call    PRINTHL
     518   00:4141  3E FF                   ld  a,#ff
     519   00:4143  B8                      cp  b                           ; Was time-out the failure reason?
     520   00:4144  C1                      pop bc                          ; Restore stack ballance and retry counter
     521   00:4145  20 04                   jr  nz,STOP_TRYING              ; If error return code and not time-out, no more checks needed
     522   00:4147  3E 47                   ld  a,CMD_GET_TIME              ; Needed for retries
     523   00:4149  10 E7                   djnz    TRY_AGAIN
     524   00:414B                      STOP_TRYING:
     525   00:414B                          ; Leave a message that clock has not been updated
     526   00:414B  21 6E 68                ld  hl,STR_CLKUPDT_FAIL
     527   00:414E  CD 8E 4C                call    PRINTHL
     528   00:4151  3E F0                   ld  a,240                       ; Wait 4 seconds with message on screen
     529   00:4153                      WAIT_4S:
     530   00:4153  76                      halt
     531   00:4154  3D                      dec a
     532   00:4155                          ; If not zero, our time out has not elapsed
     533   00:4155  20 FC                   jr  nz,WAIT_4S
     534   00:4157  18 3F                   jr  INIT_NOCLOCKUPDATE          ; error, just skip to not set garbage in clock
     535   00:4159                      INIT_CLOCKUPDATE:
     536   00:4159  C1                      pop bc
     537   00:415A  DD 2B                   dec ix
     538   00:415C  DD 2B                   dec ix                          ; ix back where it should
     539   00:415E                          ; ix + 0 -> 0 If no need to set clock, 1 if set clock, 2 if set clock and request to turn Wi-Fi Off
     540   00:415E                          ; ix + 1 -> GMT setting, well, not going to use it
     541   00:415E                          ; ix + 2 -> Seconds
     542   00:415E                          ; ix + 3 -> Minutes
     543   00:415E                          ; ix + 4 -> Hours
     544   00:415E                          ; ix + 5 -> Day
     545   00:415E                          ; ix + 6 -> Month
     546   00:415E                          ; ix + 7 -> Year LSB
     547   00:415E                          ; ix + 8 -> Year MSB
     548   00:415E  DD 66 04                ld  h,(ix+4)
     549   00:4161  DD 6E 03                ld  l,(ix+3)
     550   00:4164  DD 56 02                ld  d,(ix+2)
     551   00:4167  CD E4 5B                call    SET_TIME
     552   00:416A  20 2C                   jr  nz,INIT_NOCLOCKUPDATE       ; if error, just skip
     553   00:416C  DD 66 08                ld  h,(ix+8)
     554   00:416F  DD 6E 07                ld  l,(ix+7)
     555   00:4172  DD 56 06                ld  d,(ix+6)
     556   00:4175  DD 5E 05                ld  e,(ix+5)
     557   00:4178  CD 11 5C                call    SET_DATE
     558   00:417B  3E 02                   ld  a,2
     559   00:417D  DD BE 00                cp  (ix+0)
     560   00:4180  20 16                   jr  nz,INIT_NOCLOCKUPDATE
     561   00:4182                          ; First, release any hold to Wi-Fi Connection
     562   00:4182                          CLEAR_UART
     562   00:4182  3E 14             >     ld  a,20
     562   00:4184  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     563   00:4187  3E 68                   ld  a,CMD_WIFIRELEASE_ESP
     564   00:4189                          SEND_DATA                       ; Just send, no need to wait response
     564   00:4189  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     565   00:418C                          ; And, turn off Wi-Fi Immediatelly
     566   00:418C                          CLEAR_UART
     566   00:418C  3E 14             >     ld  a,20
     566   00:418E  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     567   00:4191  3E 4F                   ld  a,CMD_WIFI_OFF
     568   00:4193                          SEND_DATA                       ; Just send, no need to wait response
     568   00:4193  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     569   00:4196  18 0A                   jr  INIT_NOCLOCKUPDAT2
     570   00:4198                      INIT_NOCLOCKUPDATE:
     571   00:4198                          ; Release any hold to Wi-Fi Connection
     572   00:4198                          CLEAR_UART
     572   00:4198  3E 14             >     ld  a,20
     572   00:419A  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     573   00:419D  3E 68                   ld  a,CMD_WIFIRELEASE_ESP
     574   00:419F                          SEND_DATA                       ; Just send, no need to wait response
     574   00:419F  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     575   00:41A2                      INIT_NOCLOCKUPDAT2:
     576   00:41A2                          ; Save existing EXTBIO hook if it exists
     577   00:41A2  3A 20 FB                ld  a,(HOKVLD)
     578   00:41A5  CB 47                   bit 0,a
     579   00:41A7  20 18                   jr  nz,SAVE_HOOK2               ; HOKVLD tells us if there is an extended BIOS already or not, if yes, save it
     580   00:41A9                          ; If here, no extended BIOS, initialize EXTBIO, H.BGFD and H.ENFD
     581   00:41A9  21 CA FF                ld  hl,EXTBIO
     582   00:41AC  11 CB FF                ld  de,EXTBIO+1
     583   00:41AF  01 0E 00                ld  bc,15-1
     584   00:41B2  36 C9                   ld  (hl),#C9
     585   00:41B4  ED B0                   ldir
     586   00:41B6                          ; No previous hook, work area byte 0 = RET
     587   00:41B6  CD 75 59                call    GETSLT
     588   00:41B9  CD CE 59                call    GETWRK                  ; Our ROM work area address is at HL (we can use up to 8 bytes)
     589   00:41BC  3E C9                   ld  a,#c9                       ; RET, as we are the first extended BIOS
     590   00:41BE  77                      ld  (hl),a
     591   00:41BF  18 13                   jr  PATCH                       ; And now all we need to do is patch the EXTBIO hook :)
     592   00:41C1                      
     593   00:41C1                      SAVE_HOOK2:
     594   00:41C1                          ; If here, we are not the first to extend bios, so we need to save the previous one
     595   00:41C1  CD 75 59                call    GETSLT
     596   00:41C4  CD CE 59                call    GETWRK                  ; Our ROM work area address is at HL (we can use up to 8 bytes)
     597   00:41C7  EB                      ex  de,hl                       ; It is the destination for....
     598   00:41C8  21 CA FF                ld  hl,EXTBIO                   ; The actual EXTBIO hook
     599   00:41CB  01 05 00                ld  bc,5                        ; That is 5 bytes large
     600   00:41CE  ED B0                   ldir                            ; And move to our work area
     601   00:41D0  AF                      xor a
     602   00:41D1  12                      ld  (de),a                      ; Not initialized (de is at the sixth byte) of our slot work area
     603   00:41D2  13                      inc de
     604   00:41D3  12                      ld  (de),a                      ; Not initialized (de is at the seventh byte) of our slot work area
     605   00:41D4                      
     606   00:41D4                          ; Patch EXTBIO
     607   00:41D4                      PATCH:
     608   00:41D4  3E F7                   ld  a,#F7                       ; RST #30
     609   00:41D6  32 CA FF                ld  (EXTBIO),a                  ; In EXTBIO hook
     610   00:41D9  CD 75 59                call    GETSLT                  ; Our Slot in A
     611   00:41DC  32 CB FF                ld  (EXTBIO+1),a                ; Next EXTBIO hook byte
     612   00:41DF  21 E3 4C                ld  hl,DO_EXTBIO                ; Our EXTBIO routine address
     613   00:41E2  22 CC FF                ld  (EXTBIO+2),hl               ; Goes to the following two bytes in the hook
     614   00:41E5                      
     615   00:41E5  3E C9                   ld  a,#C9                       ; EXTBIO hook 5th byte must be RET
     616   00:41E7  32 CE FF                ld  (EXTBIO+4),a                ; (H.BGFD/H.ENFD follow at +5, keep them)
     617   00:41EA                      
     618   00:41EA  21 20 FB                ld  hl,HOKVLD
     619   00:41ED  CB C6                   set 0,(hl)                      ; And set HOKVLD properly to indicate an EXTBIOS is installed
     620   00:41EF                      INIT_OK:
     621   00:41EF                          if  NON_VERBOSE_ROM = 0
     622   00:41EF  21 DC 68                ld  hl,OK_S                     ; All done and set, nice exit message
     623   00:41F2  CD 8E 4C                call    PRINTHL
     624   00:41F5                          endif
     625   00:41F5  3E F0                   ld  a,#F0                       ; Set #F0, UNAPI driver has been loaded at least once
     626   00:41F7                          WRITE_F2
     626   00:41F7  32 05 7F          >     ld  (MEM_PORT_F2),a
     627   00:41FA  C9                      ret
     628   00:41FB                      
     629   00:41FB                      ;==============================
     630   00:41FB                      ;===  TPA Memory Allocation  ==
     631   00:41FB                      ;==============================
     632   00:41FB                      HIMEM_ALLOC:
     633   00:41FB                          ; Now let's reserve memory in the 4th page for our usage
     634   00:41FB  2A 4A FC                ld hl,(HIMEM)                   ; Get HIMEM
     635   00:41FE  B7                      or  a                           ; Clear Carry
     636   00:41FF  11 1E 00                ld  de,HIMEM_RESERVED_SIZE      ; Reserve How much memory we need
     637   00:4202  ED 52                   sbc hl,de                       ; New HIMEM
     638   00:4204  22 4A FC                ld  (HIMEM),hl                  ; Save it
     639   00:4207  23                      inc hl                          ; To be safe
     640   00:4208  EB                      ex  de,hl                       ; now in DE
     641   00:4209  CD 75 59                call    GETSLT
     642   00:420C  CD E2 59                call    GETMEMPOINTERADDR       ; This is where we are going to store our memory area address
     643   00:420F                          ; GETSLT and GETMEMPOINTER do not change DE, so it still has the our memory area address
     644   00:420F  73                      ld  (hl),e
     645   00:4210  23                      inc hl
     646   00:4211  72                      ld  (hl),d                      ; And save our memory area there
     647   00:4212                          ; Ok, DE has our memory area, let's save old H_TIMI hook there
     648   00:4212  21 9F FD                ld  hl,H_TIMI                   ; The actual H_TIMI hook
     649   00:4215  01 05 00                ld  bc,5                        ; That is 5 bytes large
     650   00:4218  ED B0                   ldir                            ; And move to our memory area
     651   00:421A  F3                      di                              ; Turn of interrupts as we are going to patch H_TIMI
     652   00:421B                      PATCH_H_TIMI:
     653   00:421B  3E F7                   ld  a,#F7                       ; RST #30
     654   00:421D  32 9F FD                ld  (H_TIMI),a                  ; In H_TIMI hook
     655   00:4220  CD 75 59                call    GETSLT                  ; Our Slot in A
     656   00:4223  32 A0 FD                ld  (H_TIMI+1),a                ; Next H_TIMI hook byte
     657   00:4226  21 CF 4C                ld  hl,DO_HTIMI                 ; Our H_TIMI routine address
     658   00:4229  22 A1 FD                ld  (H_TIMI+2),hl               ; Goes to the following two bytes in the hook
     659   00:422C  FB                      ei                              ; done, so re-enable interrupts
     660   00:422D                      
     661   00:422D                          ; Set DNS_READY to zero
     662   00:422D  AF                      xor a
     663   00:422E  CD 0C 5B                call    SETDNSREADY
     664   00:4231                          ; Set TIME-OUT counter to zero
     665   00:4231  21 00 00                ld  hl,0
     666   00:4234  CD 15 5A                call    SETCOUNTER
     667   00:4237  C9                      ret
     668   00:4238                      
     669   00:4238                      ;============================
     670   00:4238                      ;===  SETUP Menu Routines  ==
     671   00:4238                      ;===       Main Menu       ==
     672   00:4238                      ;============================
     673   00:4238                      ESPSETUP.EXIT:
     674   00:4238  3E 0C                   ld  a,CLS
     675   00:423A  CD A2 00                call    CHPUT
     676   00:423D  C3 E9 40                jp  INIT_UNAPI                  ; When done, resume initialization
     677   00:4240                      ENTERING_ESPSETUP:
     678   00:4240  21 42 5D                ld  hl,ENTERING_WIFI_SETUP
     679   00:4243  CD 8E 4C                call    PRINTHL
     680   00:4246  CD AB 5C                call    PATTERN_SETUP
     681   00:4249  CD 07 4A                call    WAIT_250MS_AND_THEN_CONTINUE
     682   00:424C                          ; Hold Wi-Fi Connection On
     683   00:424C                          CLEAR_UART
     683   00:424C  3E 14             >     ld  a,20
     683   00:424E  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     684   00:4251  3E 48                   ld  a,CMD_WIFIHOLD_ESP
     685   00:4253                          SEND_DATA
     685   00:4253  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     686   00:4256  21 3C 00                ld  hl,60                       ; Up to 1s time-out
     687   00:4259  CD 66 4B                call    WAIT_MENU_CMD_RESPONSE  ; Wait response
     688   00:425C                          ; We do not want to error here, just in case user still need to upgrade ESP firmware
     689   00:425C                      ESPSETUP:
     690   00:425C  CD A1 5B                call    RESET_ESP
     691   00:425F  B7                      or  a
     692   00:4260  C2 D1 40                jp  nz,ESP_NOT_FOUND            ; Not well, ESP was not found
     693   00:4263                          ; Well, if reset successful, continue
     694   00:4263  21 5E 5D                ld  hl,WELCOME
     695   00:4266  CD 8E 4C                call    PRINTHL
     696   00:4269                          CHECK_QUICK_RECEIVE
     696   00:4269  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
     696   00:426C  CB 5F             >     bit 3,a
     697   00:426E  20 08                   jr  nz,ESPSETUP.2NF             ; If yes, tells Quick Receive support
     698   00:4270  21 C8 5D                ld  hl,WELCOME_SF2
     699   00:4273  CD 8E 4C                call    PRINTHL                 ; Print Welcome message no QR
     700   00:4276  18 06                   jr  ESPSETUP.3NF
     701   00:4278                      ESPSETUP.2NF:
     702   00:4278  21 AC 5D                ld  hl,WELCOME_SF
     703   00:427B  CD 8E 4C                call    PRINTHL                 ; Print Welcome message QR
     704   00:427E                      ESPSETUP.3NF:
     705   00:427E  21 E8 5D                ld  hl,WELCOME_CS
     706   00:4281  CD 8E 4C                call    PRINTHL                 ; Print Wi-Fi is reconnecting to:
     707   00:4284                      ESPSETUP_NEXT:
     708   00:4284  CD 56 01                call    KILBUF                  ; Clear Keyboard Buffer
     709   00:4287  21 12 5E                ld  hl,WELCOME_NEXT
     710   00:428A  CD 8E 4C                call    PRINTHL
     711   00:428D  21 1C 5E                ld  hl,WELCOME_SF_NEXT
     712   00:4290  CD 8E 4C                call    PRINTHL                 ; Print Empty Welcome message
     713   00:4293  CD 29 43                call    GET_AP_STAT
     714   00:4296  CA CE 42                jp  z,ESPSETUP_NEXT.1G          ; Won't block in case of error
     715   00:4299                          ; Success, so connection state is in IX+0, then, zero terminated string with SSID starting at IX+1
     716   00:4299  DD 7E 00                ld  a,(ix+0)
     717   00:429C  21 1F 5E                ld  hl,WELCOME_CS0_NEXT
     718   00:429F  FE 00                   cp  0
     719   00:42A1  28 1F                   jr  z,ESPSETUP_NEXT.2F
     720   00:42A3  21 49 5E                ld  hl,WELCOME_CS1_NEXT
     721   00:42A6  FE 01                   cp  1
     722   00:42A8  28 18                   jr  z,ESPSETUP_NEXT.2F
     723   00:42AA  21 52 5E                ld  hl,WELCOME_CS2_NEXT
     724   00:42AD  FE 02                   cp  2
     725   00:42AF  28 11                   jr  z,ESPSETUP_NEXT.2F
     726   00:42B1  21 7C 5E                ld  hl,WELCOME_CS3_NEXT
     727   00:42B4  FE 03                   cp  3
     728   00:42B6  28 0A                   jr  z,ESPSETUP_NEXT.2F
     729   00:42B8  21 A6 5E                ld  hl,WELCOME_CS4_NEXT
     730   00:42BB  FE 04                   cp  4
     731   00:42BD  28 03                   jr  z,ESPSETUP_NEXT.2F
     732   00:42BF  21 D0 5E                ld  hl,WELCOME_CS5_NEXT
     733   00:42C2                      ESPSETUP_NEXT.2F:
     734   00:42C2  FD 67                   ld  iyh,a                       ; Save current conn status in iyh
     735   00:42C4  CD 8E 4C                call    PRINTHL                 ; Print Status
     736   00:42C7  DD E5                   push    ix
     737   00:42C9  E1                      pop hl
     738   00:42CA  23                      inc hl                          ; HL has AP Name
     739   00:42CB  CD 98 4C                call    PRINTHLINE              ; Print AP Name
     740   00:42CE                      ESPSETUP_NEXT.1G:
     741   00:42CE  21 FA 5E                ld  hl,MMENU_S_NEXT
     742   00:42D1  CD 8E 4C                call    PRINTHL                 ; Print Main Menu
     743   00:42D4                      MM_CURSOR_BLINK:
     744   00:42D4  CD 15 43                call    MM_CURSOR_SW            ; Cursor On
     745   00:42D7                      CONN_CHG_LOOP:
     746   00:42D7  CD 9C 00                call    CHSNS
     747   00:42DA  20 13                   jr  nz,MM_WAIT_INPUT            ; If not zero, there is a key in buffer
     748   00:42DC                          ; Ok, there is not, we can check if connection status changed
     749   00:42DC  CD 29 43                call    GET_AP_STAT
     750   00:42DF  CA D7 42                jp  z,CONN_CHG_LOOP             ; Won't block in case of error
     751   00:42E2                          ; Success, so connection state is in IX+0
     752   00:42E2  DD 7E 00                ld  a,(ix+0)
     753   00:42E5  FD BC                   cp  iyh                         ; If same, zero
     754   00:42E7  28 EE                   jr  z,CONN_CHG_LOOP             ; Keep loop
     755   00:42E9  CD 15 43                call    MM_CURSOR_SW            ; Cursor Off
     756   00:42EC  C3 84 42                jp  ESPSETUP_NEXT               ; Changed, re-build menu
     757   00:42EF                      MM_WAIT_INPUT:
     758   00:42EF  CD 9F 00                call    CHGET
     759   00:42F2  FE 1B                   cp  #1b                         ; ESC?
     760   00:42F4  CA 38 42                jp  z,ESPSETUP.EXIT             ; When done, resume initialization
     761   00:42F7  FE 31                   cp  '1'                         ; Setup Nagle?
     762   00:42F9  CA EC 48                jp  z,SET_NAGLE
     763   00:42FC  FE 32                   cp  '2'                         ; Setup Wi-Fi On Period?
     764   00:42FE  CA 26 48                jp  z,SET_WIFI_TIMEOUT
     765   00:4301  FE 33                   cp  '3'                         ; Scan networks?
     766   00:4303  CA 76 45                jp  z,START_WIFI_SCAN
     767   00:4306  FE 34                   cp  '4'                         ; Automatic Setting of Clock?
     768   00:4308  CA 92 43                jp  z,START_CLK_AUTO
     769   00:430B  CD C0 00                call    BEEP                    ; Wrong Input, beep
     770   00:430E  CD 15 43                call    MM_CURSOR_SW            ; Cursor Off
     771   00:4311  76                      halt
     772   00:4312  C3 D4 42                jp  MM_CURSOR_BLINK             ; And return, waiting another key
     773   00:4315                      MM_CURSOR_SW:                       ; Cursor workaround for CONN_CHG_LOOP
     774   00:4315  3E 1D                   ld  a,GOLEFT
     775   00:4317  CD A2 00                call    CHPUT
     776   00:431A  3E 01                   ld  a,1
     777   00:431C  32 A9 FC                ld  (CSRSW),a
     778   00:431F  3E 20                   ld  a,' '
     779   00:4321  CD A2 00                call    CHPUT                   ; Switch the cursor display mode
     780   00:4324  AF                      xor a
     781   00:4325  32 A9 FC                ld  (CSRSW),a
     782   00:4328  C9                      ret
     783   00:4329                      GET_AP_STAT:                        ; Use 'call GET_AP_STAT'
     784   00:4329                          CLEAR_UART
     784   00:4329  3E 14             >     ld  a,20
     784   00:432B  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
     785   00:432E  3E 67                   ld  a,CMD_AP_STS
     786   00:4330                          SEND_DATA                       ; Get AP conn status and name
     786   00:4330  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
     787   00:4333  21 3C 00                ld  hl,60                       ; Wait Up To 1s
     788   00:4336  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
     789   00:433A  DD 6B                   ld  ixl,e
     790   00:433C  DD 62                   ld  ixh,d                       ; Address in IX
     791   00:433E  C3 66 4B                jp  WAIT_MENU_CMD_RESPONSE
     792   00:4341                      
     793   00:4341                      ;============================
     794   00:4341                      ;===  SETUP Menu Routines  ==
     795   00:4341                      ;===  Wi-Fi and Clock Menu ==
     796   00:4341                      ;============================
     797   00:4341                      CLK_MSX1_GO:
     798   00:4341  21 E9 60                ld  hl,MMENU_CLOCK_MSX1
     799   00:4344  CD 8E 4C                call    PRINTHL                 ; Print Main Clock MSX1 message
     800   00:4347  CD 0E 4A                call    ISCLKAUTO
     801   00:434A  DD 7E 00                ld  a,(ix+0)                    ; Auto Clock Current setting
     802   00:434D  FE 03                   cp  3                           ; If 3 adapter disabled
     803   00:434F  28 08                   jr  z,CLK_MSX1_ADAPTERDIS
     804   00:4351  21 7D 61                ld  hl,MMENU_CLOCK_0
     805   00:4354  CD 8E 4C                call    PRINTHL
     806   00:4357  18 06                   jr  CLK_MSX1_OPT
     807   00:4359                      CLK_MSX1_ADAPTERDIS:
     808   00:4359  21 C3 61                ld  hl,MMENU_CLOCK_3
     809   00:435C  CD 8E 4C                call    PRINTHL
     810   00:435F                      CLK_MSX1_OPT:
     811   00:435F  21 D6 61                ld  hl,MMENU_CLOCK_OPT
     812   00:4362  CD 8E 4C                call    PRINTHL
     813   00:4365                      CLK_MSX1_WAIT_OPT_INPUT:
     814   00:4365  CD 9F 00                call    CHGET
     815   00:4368  FE 1B                   cp  #1b                         ; ESC?
     816   00:436A  CA 5C 42                jp  z,ESPSETUP                  ; Back to main menu
     817   00:436D  FE 30                   cp  '0'
     818   00:436F  CA 7D 43                jp  z,CLK_MSX1_SEND_CMD
     819   00:4372  FE 33                   cp  '3'
     820   00:4374  CA 39 44                jp  z,CLK_AUTO_WAIT_GMT
     821   00:4377  CD C0 00                call    BEEP                    ; Wrong Input, beep
     822   00:437A  C3 65 43                jp  CLK_MSX1_WAIT_OPT_INPUT     ; And return, waiting another key
     823   00:437D                      CLK_MSX1_SEND_CMD:
     824   00:437D  CD A2 00                call    CHPUT                   ; Print option
     825   00:4380  D6 30                   sub '0'                         ; Adjust format
     826   00:4382  DD 77 00                ld  (ix+0),a                    ; Save it
     827   00:4385  3E 0D                   ld  a,#0d
     828   00:4387  CD A2 00                call    CHPUT
     829   00:438A  3E 0A                   ld  a,#0a
     830   00:438C  CD A2 00                call    CHPUT
     831   00:438F  C3 30 45                jp  CLK_AUTO_GMT_CHK_DONE       ; And sending the command will be done there
     832   00:4392                      
     833   00:4392                      START_CLK_AUTO:
     834   00:4392  3E 34                   ld  a,'4'
     835   00:4394  CD A2 00                call    CHPUT
     836   00:4397  CD 07 4A                call    WAIT_250MS_AND_THEN_CONTINUE
     837   00:439A  3A 2D 00                ld  a,(#002D)                   ; Check MSX Version
     838   00:439D  B7                      or  a
     839   00:439E  CA 41 43                jp  z,CLK_MSX1_GO               ; If zero, MSX1, so can just enable or disable adapter
     840   00:43A1                      CLK_AUTO_GO:
     841   00:43A1  21 89 5F                ld  hl,MMENU_CLOCK_MSX2
     842   00:43A4  CD 8E 4C                call    PRINTHL                 ; Print Main Clock MSX2 message
     843   00:43A7  CD 0E 4A                call    ISCLKAUTO
     844   00:43AA  DD 7E 00                ld  a,(ix+0)                    ; Auto Clock Current setting
     845   00:43AD  B7                      or  a                           ; If zero, off
     846   00:43AE  20 08                   jr  nz,CLK_AUTO_CHK1
     847   00:43B0  21 7D 61                ld  hl,MMENU_CLOCK_0
     848   00:43B3  CD 8E 4C                call    PRINTHL
     849   00:43B6  18 59                   jr  CLK_AUTO_GMT_OPT
     850   00:43B8                      CLK_AUTO_CHK1:
     851   00:43B8  3D                      dec a                           ; If 1, on and keep wifi on
     852   00:43B9  20 08                   jr  nz,CLK_AUTO_CHK2
     853   00:43BB  21 8F 61                ld  hl,MMENU_CLOCK_1
     854   00:43BE  CD 8E 4C                call    PRINTHL
     855   00:43C1  18 13                   jr  CLK_AUTO_GMT
     856   00:43C3                      CLK_AUTO_CHK2:
     857   00:43C3  3D                      dec a                           ; If 2, on and turn wifi off
     858   00:43C4  20 08                   jr  nz,CLK_AUTO_3
     859   00:43C6  21 A9 61                ld  hl,MMENU_CLOCK_2
     860   00:43C9  CD 8E 4C                call    PRINTHL
     861   00:43CC  18 08                   jr  CLK_AUTO_GMT
     862   00:43CE                      CLK_AUTO_3:
     863   00:43CE  21 C3 61                ld  hl,MMENU_CLOCK_3
     864   00:43D1  CD 8E 4C                call    PRINTHL
     865   00:43D4  18 3B                   jr  CLK_AUTO_GMT_OPT
     866   00:43D6                      CLK_AUTO_GMT:
     867   00:43D6  DD 66 01                ld  h,(ix+1)                    ; Save it for now
     868   00:43D9  DD 7E 01                ld  a,(ix+1)                    ; GMT current setting
     869   00:43DC  CB 7F                   bit 7,a                         ; If set, is -
     870   00:43DE  28 0B                   jr  z,CLK_AUTO_GMTP
     871   00:43E0  3E 2D                   ld  a,'-'
     872   00:43E2  CD A2 00                call    CHPUT
     873   00:43E5  DD CB 01 BE             res 7,(ix+1)                    ; Clear - indicator
     874   00:43E9  18 05                   jr  CLK_AUTO_GMTM
     875   00:43EB                      CLK_AUTO_GMTP:
     876   00:43EB  3E 2B                   ld  a,'+'
     877   00:43ED  CD A2 00                call    CHPUT
     878   00:43F0                      CLK_AUTO_GMTM:
     879   00:43F0  3E 09                   ld  a,9
     880   00:43F2  DD BE 01                cp  (ix+1)                      ; Greater than 9?
     881   00:43F5  30 0F                   jr  nc,CLK_AUTO_GMTD            ; If not, just print what is in A + '0'
     882   00:43F7  3E 31                   ld  a,'1'                       ; It is 1
     883   00:43F9  CD A2 00                call    CHPUT
     884   00:43FC  DD 7E 01                ld  a,(ix+1)
     885   00:43FF  C6 26                   add '0'-10                      ; Need to subtract 10 and add '0' to print
     886   00:4401  CD A2 00                call    CHPUT
     887   00:4404  18 0B                   jr  CLK_AUTO_GMT_OPT
     888   00:4406                      CLK_AUTO_GMTD:
     889   00:4406  3E 30                   ld  a,'0'
     890   00:4408  DD 86 01                add a,(ix+1)                    ; Our value
     891   00:440B  CD A2 00                call    CHPUT
     892   00:440E  DD 74 01                ld  (ix+1),h                    ; Restore original value
     893   00:4411                      CLK_AUTO_GMT_OPT:
     894   00:4411  21 D6 61                ld  hl,MMENU_CLOCK_OPT
     895   00:4414  CD 8E 4C                call    PRINTHL
     896   00:4417                      CLK_AUTO_WAIT_OPT_INPUT:
     897   00:4417  CD 9F 00                call    CHGET
     898   00:441A  FE 1B                   cp  #1b                         ; ESC?
     899   00:441C  CA 5C 42                jp  z,ESPSETUP                  ; Back to main menu
     900   00:441F  FE 30                   cp  '0'
     901   00:4421  CA 39 44                jp  z,CLK_AUTO_WAIT_GMT
     902   00:4424  FE 31                   cp  '1'
     903   00:4426  CA 39 44                jp  z,CLK_AUTO_WAIT_GMT
     904   00:4429  FE 32                   cp  '2'
     905   00:442B  CA 39 44                jp  z,CLK_AUTO_WAIT_GMT
     906   00:442E  FE 33                   cp  '3'
     907   00:4430  CA 39 44                jp  z,CLK_AUTO_WAIT_GMT
     908   00:4433  CD C0 00                call    BEEP                    ; Wrong Input, beep
     909   00:4436  C3 17 44                jp  CLK_AUTO_WAIT_OPT_INPUT     ; And return, waiting another key
     910   00:4439                      CLK_AUTO_WAIT_GMT:
     911   00:4439  CD A2 00                call    CHPUT                   ; Print option
     912   00:443C  D6 30                   sub '0'                         ; Adjust format
     913   00:443E  DD 77 00                ld  (ix+0),a                    ; Save it
     914   00:4441  B7                      or  a
     915   00:4442  CA 30 45                jp  z,CLK_AUTO_GMT_CHK_DONE     ; And send the command if just disabling clock auto set
     916   00:4445  FE 03                   cp  3
     917   00:4447  CA 30 45                jp  z,CLK_AUTO_GMT_CHK_DONE     ; Or send the command if just disabling the adapter
     918   00:444A  21 00 62                ld  hl,MMENU_GMT_OPT
     919   00:444D  CD 8E 4C                call    PRINTHL
     920   00:4450  16 00                   ld  d,0                         ; # of digits entered
     921   00:4452  1E 00                   ld  e,0                         ; # of characters printed
     922   00:4454  DD 36 01 00             ld  (ix+1),0                    ; GMT 0
     923   00:4458                      CLK_AUTO_WAIT_GMT_INPUT:
     924   00:4458  CD 9F 00                call    CHGET
     925   00:445B  FE 1B                   cp  #1b                         ; ESC?
     926   00:445D  CA 5C 42                jp  z,ESPSETUP                  ; Back to main menu
     927   00:4460  FE 0D                   cp  #0d                         ; ENTER?
     928   00:4462  CA AB 44                jp  z,CLK_AUTO_GMT_CHK_INPUT    ; Check if ok to send command
     929   00:4465  FE 08                   cp  #08                         ; Backspace?
     930   00:4467  CA 7C 44                jp  z,CLK_AUTO_GMT_CHK_BS       ; Check if there is something to erase
     931   00:446A  FE 2D                   cp  '-'                         ; Negative value?
     932   00:446C  CA AB 44                jp  z,CLK_AUTO_GMT_CHK_INPUT
     933   00:446F  FE 30                   cp  '0'                         ; >=0?
     934   00:4471  DA 9D 44                jp  c,CLK_AUTO_GMT_BAD_INPUT    ; If not, bad input
     935   00:4474  FE 3A                   cp  '9'+1                       ; <= 9
     936   00:4476  D2 9D 44                jp  nc,CLK_AUTO_GMT_BAD_INPUT   ; If not, bad input
     937   00:4479  C3 AB 44                jp  CLK_AUTO_GMT_CHK_INPUT      ; Otherwise, validate digit
     938   00:447C                      CLK_AUTO_GMT_CHK_BS:
     939   00:447C  AF                      xor a
     940   00:447D  BB                      cp  e                           ; Anything on screen?
     941   00:447E  28 1D                   jr  z,CLK_AUTO_GMT_BAD_INPUT    ; Nothing to erase
     942   00:4480  1D                      dec e                           ; One less character on the screen
     943   00:4481  BA                      cp  d                           ; Any digit?
     944   00:4482  28 03                   jr  z,CLK_AUTO_GMT_CHK_BS_MIN   ; If not, just erase - sign
     945   00:4484                          ; There is, so it is one less digit
     946   00:4484  15                      dec d
     947   00:4485  18 04                   jr  CLK_AUTO_GMT_CHK_DIGIT
     948   00:4487                      CLK_AUTO_GMT_CHK_BS_MIN:
     949   00:4487  DD 36 01 00             ld  (ix+1),0                    ; Reset sign
     950   00:448B                      CLK_AUTO_GMT_CHK_DIGIT:
     951   00:448B  3E 08                   ld  a,8                         ; Backspace
     952   00:448D  CD A2 00                call    CHPUT                   ; Print it
     953   00:4490  3E 20                   ld  a,' '                       ; Space
     954   00:4492  CD A2 00                call    CHPUT                   ; Print it
     955   00:4495  3E 08                   ld  a,8                         ; Backspace
     956   00:4497  CD A2 00                call    CHPUT                   ; Print it
     957   00:449A  C3 58 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; Return
     958   00:449D                      CLK_AUTO_GMT_BAD_INPUT:
     959   00:449D                          ; Beep might use sub rom, and if so, all registers will be messed up, better save
     960   00:449D  C5                      push    bc
     961   00:449E  D5                      push    de
     962   00:449F  F5                      push    af
     963   00:44A0  E5                      push    hl
     964   00:44A1  CD C0 00                call    BEEP                    ; Wrong Input, beep
     965   00:44A4  E1                      pop hl
     966   00:44A5  F1                      pop af
     967   00:44A6  D1                      pop de
     968   00:44A7  C1                      pop bc
     969   00:44A8  C3 58 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; And return, waiting another key
     970   00:44AB                      CLK_AUTO_GMT_CHK_INPUT:
     971   00:44AB  4F                      ld  c,a                         ; Save in C for printing if needed
     972   00:44AC  FE 2D                   cp  '-'                         ; - sign?
     973   00:44AE  20 11                   jr  nz,CLK_AUTO_GMT_CHK_CR      ; If not, check if enter
     974   00:44B0                          ; - sign
     975   00:44B0  3E 00                   ld  a,0
     976   00:44B2  BB                      cp  e                           ; If not the first character, can't accept
     977   00:44B3  20 E8                   jr  nz,CLK_AUTO_GMT_BAD_INPUT
     978   00:44B5                          ; It is the first, so let's print it
     979   00:44B5  79                      ld  a,c
     980   00:44B6  CD A2 00                call    CHPUT
     981   00:44B9  DD 36 01 80             ld  (ix+1),0x80                 ; Set the - sign bit, for now rest is zero
     982   00:44BD  1C                      inc e                           ; Increase # of characters printed
     983   00:44BE  C3 58 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; Continue waiting input
     984   00:44C1                      CLK_AUTO_GMT_CHK_CR:
     985   00:44C1  FE 0D                   cp  #0d                         ; ENTER?
     986   00:44C3  20 0F                   jr  nz,CLK_AUTO_GMT_CHK_CD      ; If not, check if digit is valid
     987   00:44C5                          ; Enter
     988   00:44C5  3E 00                   ld  a,0
     989   00:44C7  BA                      cp  d                           ; Ok, at least one digit entered?
     990   00:44C8  28 D3                   jr  z,CLK_AUTO_GMT_BAD_INPUT    ; No, so, enter is no good now
     991   00:44CA                          ; It is, if it had a digit entered and did not send, it was 1, so...
     992   00:44CA  3E 01                   ld  a,1
     993   00:44CC  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
     994   00:44CF  DD 77 01                ld  (ix+1),a                    ; Save
     995   00:44D2  18 5C                   jr  CLK_AUTO_GMT_CHK_DONE       ; Ok, ready to send
     996   00:44D4                      CLK_AUTO_GMT_CHK_CD:
     997   00:44D4                          ; Ok, it is a digit
     998   00:44D4  06 30                   ld  b,'0'
     999   00:44D6  90                      sub a,b                         ; A has digit value
    1000   00:44D7  47                      ld  b,a                         ; Save in B
    1001   00:44D8  3E 00                   ld  a,0
    1002   00:44DA  BA                      cp  d
    1003   00:44DB  20 1E                   jr  nz,CLK_AUTO_GMT_CHK_CSD     ; If not zero, it is second digit, so almost done
    1004   00:44DD                          ; 1st digit, let's check if it is other than 1, if it is, we are almost done
    1005   00:44DD  3E 01                   ld  a,1
    1006   00:44DF  B8                      cp  b
    1007   00:44E0  28 10                   jr  z,CLK_AUTO_GMT_CHK_CD.1     ; If it is 1, wait next digit or enter
    1008   00:44E2                          ; Not 1, so just adjust ix+1 and go
    1009   00:44E2  79                      ld  a,c
    1010   00:44E3  CD A2 00                call    CHPUT                   ; Print it
    1011   00:44E6  78                      ld  a,b
    1012   00:44E7  B7                      or  a
    1013   00:44E8  28 03                   jr  z,CLK_AUTO_SKIP_SIGN
    1014   00:44EA  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1015   00:44ED                      CLK_AUTO_SKIP_SIGN:
    1016   00:44ED  DD 77 01                ld  (ix+1),a                    ; Save
    1017   00:44F0  18 3E                   jr  CLK_AUTO_GMT_CHK_DONE       ; Ok, ready to send
    1018   00:44F2                      CLK_AUTO_GMT_CHK_CD.1:
    1019   00:44F2  79                      ld  a,c
    1020   00:44F3  CD A2 00                call    CHPUT                   ; Print it
    1021   00:44F6  14                      inc d                           ; Digits entered now is 1
    1022   00:44F7  1C                      inc e                           ; Digits printed increased
    1023   00:44F8  C3 58 44                jp  CLK_AUTO_WAIT_GMT_INPUT     ; Continue waiting input
    1024   00:44FB                      CLK_AUTO_GMT_CHK_CSD:
    1025   00:44FB                          ; Second digit, easy... First was 1, now need to check if it is 0, 1 or 2, otherwise, bad entry
    1026   00:44FB  78                      ld  a,b
    1027   00:44FC  06 03                   ld  b,3
    1028   00:44FE  B8                      cp  b
