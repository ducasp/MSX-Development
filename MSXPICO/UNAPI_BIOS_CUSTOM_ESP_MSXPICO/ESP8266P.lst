    1746   00:4A10  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    1747   00:4A13  3E 63                   ld  a,CMD_QUERY_ACLK_SETTINGS
    1748   00:4A15                          SEND_DATA
    1748   00:4A15  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1749   00:4A18  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1750   00:4A1B  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1751   00:4A1F  DD 6B                   ld  ixl,e
    1752   00:4A21  DD 62                   ld  ixh,d                       ; address in IX
    1753   00:4A23  CD 66 4B                call    WAIT_MENU_CMD_RESPONSE
