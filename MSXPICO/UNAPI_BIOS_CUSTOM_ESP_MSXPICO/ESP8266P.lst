    4663   00:58D6  CB 47             >     bit 0,a
    4664   00:58D8  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_RC.1
    4665   00:58DA  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4666   00:58DD  18 F4                   jr  TCPIP_CONFIG_AUTOIP_RC
