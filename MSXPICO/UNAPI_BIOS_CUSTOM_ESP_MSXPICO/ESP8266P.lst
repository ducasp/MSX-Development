    1030   00:4502  B7                      or  a                           ; Is it zero?
    1031   00:4503  20 0E                   jr  nz,CLK_AUTO_GMT_CHK_CSD1    ; If not, check for 1
    1032   00:4505                          ; It was zero
    1033   00:4505  3E 0A                   ld  a,10                        ; So, 10
    1034   00:4507  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1035   00:450A  DD 77 01                ld  (ix+1),a                    ; Save
    1036   00:450D  79                      ld  a,c
    1037   00:450E  CD A2 00                call    CHPUT                   ; Print it
    1038   00:4511  18 1D                   jr  CLK_AUTO_GMT_CHK_DONE       ; Ready to
    1039   00:4513                      CLK_AUTO_GMT_CHK_CSD1:
    1040   00:4513  3D                      dec a                           ; Is it one?
    1041   00:4514  20 0E                   jr  nz,CLK_AUTO_GMT_CHK_CSD2
    1042   00:4516                          ; It was one
    1043   00:4516  3E 0B                   ld  a,11                        ; So, eleven
    1044   00:4518  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1045   00:451B  DD 77 01                ld  (ix+1),a                    ; Save
    1046   00:451E  79                      ld  a,c
    1047   00:451F  CD A2 00                call    CHPUT                   ; Print it
    1048   00:4522  18 0C                   jr  CLK_AUTO_GMT_CHK_DONE       ; Ready to send
    1049   00:4524                      CLK_AUTO_GMT_CHK_CSD2:
    1050   00:4524                          ; It was two
    1051   00:4524  3E 0C                   ld  a,12                        ; So, twelve
    1052   00:4526  DD B6 01                or  a,(ix+1)                    ; Adjust sign, if needed
    1053   00:4529  DD 77 01                ld  (ix+1),a                    ; Save
    1054   00:452C  79                      ld  a,c
