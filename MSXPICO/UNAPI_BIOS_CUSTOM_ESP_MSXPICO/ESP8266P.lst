    3848   00:5497                    ~     ld  c,OUT_TX_PORT
    3849   00:5497                    ~ TCPIP_TCP_OPEN_SENDHOSTNAME:
    3850   00:5497                    ~     outi
    3851   00:5497                    ~     jr  nz,TCPIP_TCP_OPEN_SENDHOSTNAME
    3852   00:5497                    ~     else
