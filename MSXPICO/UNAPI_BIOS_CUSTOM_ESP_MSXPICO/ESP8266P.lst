    4685   00:58F8                      
    4686   00:58F8                          ; now just get the 1 byte, configuration, should go to C
    4687   00:58F8                      TCPIP_CONFIG_AUTOIP_CONF_ST1:
    4688   00:58F8                          CHECK_DATA
