    4668   00:58DF                          ;nz, discard
    4669   00:58DF                          RECEIVE_DATA
    4669   00:58DF  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4670   00:58E2  B7                      or  a                           ; 0?
    4671   00:58E3  C0                      ret nz                          ; if not, done
    4672   00:58E4                      
    4673   00:58E4                          ; next two bytes are return code and size bytes, don't care, it is 1, configuration
    4674   00:58E4  06 02                   ld  b,2
