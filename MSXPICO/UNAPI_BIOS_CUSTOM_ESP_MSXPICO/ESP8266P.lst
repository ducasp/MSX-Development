    1185   00:4625  28 0B                   jr  z,APLIST_NO_OVERFLOW        ; No more items
    1186   00:4627  06 01                   ld  b,1                         ; Signal that there still is data pending to list in another page
    1187   00:4629  E5                      push    hl
    1188   00:462A  FD E1                   pop iy                          ; Save in IY the address to continue from
    1189   00:462C  4A                      ld  c,d                         ; And C has the remaining AP count
    1190   00:462D  21 42 64                ld  hl,MMENU_SCANQM
    1191   00:4630  18 03                   jr  APLIST_NOFLW
