    1646   00:493B                      ;===  SETUP Menu Routines  ==
    1647   00:493B                      ;===  Auxiliary Functions  ==
    1648   00:493B                      ;============================
    1649   00:493B                      SET_ESP_WIFI_TIMEOUT:
    1650   00:493B  EB                      ex  de,hl
    1651   00:493C  3E 0D                   ld  a,#0d
    1652   00:493E  CD A2 00                call    CHPUT
    1653   00:4941  3E 0A                   ld  a,#0a
    1654   00:4943  CD A2 00                call    CHPUT
    1655   00:4946  21 C1 67                ld  hl,STR_SENDING              ; Indicate it is sending a command
    1656   00:4949  CD 8E 4C                call    PRINTHL
    1657   00:494C                          CLEAR_UART
    1657   00:494C  3E 14             >     ld  a,20
    1657   00:494E  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    1658   00:4951  3E 54                   ld  a,CMD_TIMER_SET
    1659   00:4953                          SEND_DATA
    1659   00:4953  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1660   00:4956  AF                      xor a                           ; Size MSB is 0
    1661   00:4957                          SEND_DATA
    1661   00:4957  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1662   00:495A  3E 02                   ld  a,2                         ; Size LSB is 2
    1663   00:495C                          SEND_DATA
    1663   00:495C  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1664   00:495F  7A                      ld  a,d                         ; Timeout MSB
    1665   00:4960                          SEND_DATA
