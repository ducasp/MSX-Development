    4756   00:5953                      ;==========================
    4757   00:5953                      ;===  TCPIP_CONFIG_TTL  ===
    4758   00:5953                      ;==========================
    4759   00:5953                      ;Get/set the value of TTL and TOS for outgoing datagrams.
    4760   00:5953                      ;
    4761   00:5953                      ;Input:  A = 27
    4762   00:5953                      ;        B = 0: Get current values (just return 255 for TTL and 0 for TOS
    4763   00:5953                      ;               as ESP do not expose or allow configurations of it)
    4764   00:5953                      ;            1: Set values
    4765   00:5953                      ;        D = New value for TTL (only if B=1)
    4766   00:5953                      ;        E = New value for ToS (only if B=1)
    4767   00:5953                      ;Output: A = Error code
    4768   00:5953                      ;        D = Value of TTL after the routine execution
    4769   00:5953                      ;        E = Value of ToS after the routine execution
    4770   00:5953                      TCPIP_CONFIG_TTL:
    4771   00:5953  78                      ld  a,b
    4772   00:5954  E6 FE                   and %11111110
    4773   00:5956  B7                      or  a
    4774   00:5957  3E 04                   ld  a,ERR_INV_PARAM
    4775   00:5959  C0                      ret nz
    4776   00:595A  78                      ld  a,b
    4777   00:595B  B7                      or  a
    4778   00:595C                          ; Cant set, so NOT IMP
    4779   00:595C  3E 01                   ld  a,ERR_NOT_IMP
    4780   00:595E  C0                      ret nz                          ; if not get, not implemented
    4781   00:595F                          ; get, so just return D = #FF, A = OK = 0 and E = 0
    4782   00:595F  AF                      xor a
    4783   00:5960  1E 00                   ld  e,0
    4784   00:5962  16 FF                   ld  d,#FF
    4785   00:5964  C9                      ret
    4786   00:5965                      
    4787   00:5965                      ;===========================
    4788   00:5965                      ;===  TCPIP_CONFIG_PING  ===
    4789   00:5965                      ;===========================
    4790   00:5965                      ;Get/set the automatic PING reply flag.
    4791   00:5965                      ;
    4792   00:5965                      ;Input:  A = 28
    4793   00:5965                      ;        B = 0: Get current flag value
    4794   00:5965                      ;            1: Set flag value (ERR_NOT_IMP)
    4795   00:5965                      ;        C = New flag value (only if B=1):
    4796   00:5965                      ;            0: Off
    4797   00:5965                      ;            1: On
    4798   00:5965                      ;Output: A = Error code
    4799   00:5965                      ;        C = Flag value after the routine execution
    4800   00:5965                      TCPIP_CONFIG_PING:
    4801   00:5965  78                      ld  a,b
    4802   00:5966  E6 FE                   and %11111110
    4803   00:5968  B7                      or  a
    4804   00:5969  3E 04                   ld  a,ERR_INV_PARAM
    4805   00:596B  C0                      ret nz
    4806   00:596C  78                      ld  a,b
    4807   00:596D  B7                      or  a
    4808   00:596E                          ; Cant set, so NOT IMP
    4809   00:596E  3E 01                   ld  a,ERR_NOT_IMP
    4810   00:5970  C0                      ret nz                          ; if not get, not implemented
    4811   00:5971                          ; get, so just return C = 1, A = OK = 0
    4812   00:5971  AF                      xor a
    4813   00:5972  0E 01                   ld  c,1
    4814   00:5974  C9                      ret
    4815   00:5975                      
