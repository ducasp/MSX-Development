    5364   00:5B59                      ;*********************************************
    5365   00:5B59                      ;***       WAIT_RESPONSE_FROM_ESP          ***
    5366   00:5B59                      ;*** Will wait ESP to send a response,     ***
    5367   00:5B59                      ;*** discarding all data until it is found.***
    5368   00:5B59                      ;***                                       ***
    5369   00:5B59                      ;*** Inputs:                               ***
    5370   00:5B59                      ;*** HL - Expected response string         ***
    5371   00:5B59                      ;*** A - Response Size                     ***
    5372   00:5B59                      ;*** DE - TimeOut in ticks                 ***
    5373   00:5B59                      ;***                                       ***
    5374   00:5B59                      ;*** Output:                               ***
    5375   00:5B59                      ;*** A - 0 if response received            ***
    5376   00:5B59                      ;*** otherwise response not received and   ***
    5377   00:5B59                      ;*** timed-out.                            ***
    5378   00:5B59                      ;***                                       ***
    5379   00:5B59                      ;*** Changes HL, BC, AF, DE, IX            ***
    5380   00:5B59                      ;*********************************************
    5381   00:5B59                      WRFE_WAIT_DATA:
    5382   00:5B59                          LOAD_STS_PORT_IN_A
    5382   00:5B59  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    5383   00:5B5C  CB 6F                   bit 5,a                         ; If nz Port #07 is not available
    5384   00:5B5E  20 06                   jr  nz,WRFE_STS_NOT_AVAILABLE
    5385   00:5B60  CB 47                   bit 0,a                         ; if nz has data
    5386   00:5B62  C0                      ret nz
    5387   00:5B63  1B                      dec de
    5388   00:5B64  76                      halt
    5389   00:5B65  C9                      ret
    5390   00:5B66                      WRFE_STS_NOT_AVAILABLE:
    5391   00:5B66  11 00 00                ld  de,0
    5392   00:5B69  AF                      xor a
    5393   00:5B6A  C9                      ret
    5394   00:5B6B                      
    5395   00:5B6B                      WRFE_COMPARE:
    5396   00:5B6B  47                      ld  b,a
    5397   00:5B6C  7E                      ld  a,(hl)
    5398   00:5B6D  B8                      cp  b
    5399   00:5B6E  C0                      ret nz
    5400   00:5B6F  23                      inc hl
    5401   00:5B70  C9                      ret
    5402   00:5B71                      
    5403   00:5B71                      WAIT_RESPONSE_FROM_ESP:
    5404   00:5B71  4F                      ld  c,a                         ; Response size in C
    5405   00:5B72  E5                      push    hl                      ; Save HL
    5406   00:5B73  AF                      xor a
    5407   00:5B74                      WRFE_ST1:
    5408   00:5B74  DD 67                   ld  ixh,a                       ; We start at index 0
    5409   00:5B76                      
    5410   00:5B76                      WRFE_LOOP:
    5411   00:5B76  CD 59 5B                call    WRFE_WAIT_DATA
    5412   00:5B79  20 07                   jr  nz,WRFE_LOOP.1
    5413   00:5B7B  7B                      ld  a,e
    5414   00:5B7C  B2                      or  d
    5415   00:5B7D  CA 9D 5B                jp  z,WRFE_RET_ERROR
    5416   00:5B80  18 F4                   jr  WRFE_LOOP
    5417   00:5B82                      WRFE_LOOP.1:
    5418   00:5B82                          ; nz, check the data
    5419   00:5B82                          RECEIVE_DATA
    5419   00:5B82  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    5420   00:5B85                          ; Ok, now the byte is in A, let's compare
    5421   00:5B85                      WRFE_IDXCMD:
    5422   00:5B85  CD 6B 5B                call WRFE_COMPARE
    5423   00:5B88                          ; if match
    5424   00:5B88  28 07                   jr  z,WRFE_RSP_MATCH
    5425   00:5B8A                          ; did not match, let's zero the rsp index
    5426   00:5B8A  AF                      xor a
    5427   00:5B8B  DD 67                   ld  ixh,a                       ; re-start at index 0
    5428   00:5B8D  E1                      pop hl                          ; restore the response index
    5429   00:5B8E  E5                      push    hl                      ; and keep it in stack
    5430   00:5B8F                          ; back to get another byte
    5431   00:5B8F  18 E5                   jr  WRFE_LOOP
    5432   00:5B91                      WRFE_RSP_MATCH:
    5433   00:5B91                          ; match
    5434   00:5B91  DD 24                   inc ixh
    5435   00:5B93  DD 7C                   ld  a,ixh
    5436   00:5B95  B9                      cp  c
    5437   00:5B96                          ; if a = c done and response is success
    5438   00:5B96  28 02                   jr  z,WRFE_RET_OK
    5439   00:5B98                          ; not done, back to get more bytes
    5440   00:5B98  18 DC                   jr  WRFE_LOOP
    5441   00:5B9A                      WRFE_RET_OK:
    5442   00:5B9A  E1                      pop hl
    5443   00:5B9B  AF                      xor a
    5444   00:5B9C  C9                      ret
    5445   00:5B9D                      WRFE_RET_ERROR:
    5446   00:5B9D  E1                      pop hl
    5447   00:5B9E  3E 01                   ld  a,1
    5448   00:5BA0  C9                      ret
    5449   00:5BA1                      
    5450   00:5BA1                      ;*********************************************
    5451   00:5BA1                      ;***              RESET ESP                ***
    5452   00:5BA1                      ;*** If RESET ok, A will be 0, otherwise   ***
    5453   00:5BA1                      ;*** failure                               ***
    5454   00:5BA1                      ;*********************************************
    5455   00:5BA1                      RESET_ESP:
    5456   00:5BA1                          ; Is ESP installed?
    5457   00:5BA1                          CLEAR_UART                      ; Clear UART
    5457   00:5BA1  3E 14             >     ld  a,20
    5457   00:5BA3  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
