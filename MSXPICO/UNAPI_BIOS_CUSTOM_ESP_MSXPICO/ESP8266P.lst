    2811   00:4F9E                      ;=========================
    2812   00:4F9E                      ;===  TCPIP_NET_STATE  ===
    2813   00:4F9E                      ;=========================
    2814   00:4F9E                      ;Get network state.
    2815   00:4F9E                      ;
    2816   00:4F9E                      ;Input:  A = 3
    2817   00:4F9E                      ;Output: A = Error code
    2818   00:4F9E                      ;        B = Current network state:
    2819   00:4F9E                      ;            0: Closed
    2820   00:4F9E                      ;            1: Opening
    2821   00:4F9E                      ;            2: Open
    2822   00:4F9E                      ;            3: Closing
    2823   00:4F9E                      ;            255: Unknown
    2824   00:4F9E                      TCPIP_NET_STATE:
    2825   00:4F9E                          SEND_DATA                       ; Send the command
    2825   00:4F9E  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2826   00:4FA1  AF                      xor a
    2827   00:4FA2                          SEND_DATA                       ; Send the command size msb
    2827   00:4FA2  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2828   00:4FA5                          SEND_DATA                       ; Send the command size lsb
    2828   00:4FA5  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2829   00:4FA8                      
    2830   00:4FA8                          ; Now wait up to 720 ticks to get response
    2831   00:4FA8  21 D0 02                ld  hl,720
    2832   00:4FAB  CD 15 5A                call    SETCOUNTER
    2833   00:4FAE                      TCPIP_NET_STATE_ST1:
    2834   00:4FAE                          CHECK_DATA
    2834   00:4FAE  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2834   00:4FB1  CB 47             >     bit 0,a
    2835   00:4FB3  20 05                   jr  nz,TCPIP_NET_STATE_ST1.1
    2836   00:4FB5  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2837   00:4FB8  18 F4                   jr  TCPIP_NET_STATE_ST1
