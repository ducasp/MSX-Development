    4466   00:57C0  EB                      ex  de,hl
    4467   00:57C1  3E 12                   ld  a,18
    4468   00:57C3                          SEND_DATA                       ; Send the command
    4468   00:57C3  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4469   00:57C6  AF                      xor a
    4470   00:57C7                          SEND_DATA                       ; Send the command size msb
    4470   00:57C7  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4471   00:57CA  3E 03                   ld  a,3
    4472   00:57CC                          SEND_DATA                       ; Send the command size lsb
    4472   00:57CC  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4473   00:57CF  78                      ld  a,b
    4474   00:57D0                          SEND_DATA                       ; Send the connection #
    4474   00:57D0  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4475   00:57D3  7D                      ld  a,l
    4476   00:57D4                          SEND_DATA                       ; Send MAX rcv size LSB
    4476   00:57D4  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4477   00:57D7  7C                      ld  a,h
    4478   00:57D8                          SEND_DATA                       ; Send MAX rcv size MSB
    4478   00:57D8  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4479   00:57DB  3E 03                   ld  a,3
    4480   00:57DD  CD 37 5A                call    SETBYTE                 ; Ok, retry up to three times
    4481   00:57E0                      TCPIP_TCP_RCV.RXRETRY:
    4482   00:57E0                          ; Now wait up to 600 ticks to get response
    4483   00:57E0  21 58 02                ld  hl,600
    4484   00:57E3  CD 15 5A                call    SETCOUNTER
    4485   00:57E6                      TCPIP_TCP_RCV_ST1:
    4486   00:57E6                          CHECK_DATA
    4486   00:57E6  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    4486   00:57E9  CB 47             >     bit 0,a
    4487   00:57EB  20 05                   jr  nz,TCPIP_TCP_RCV_ST1.1
