    4865   00:59A3  E6 80                   and #80
    4866   00:59A5  B1                      or  c
    4867   00:59A6  4F                      ld  c,a
    4868   00:59A7  23                      inc hl
    4869   00:59A8  23                      inc hl
    4870   00:59A9  23                      inc hl
    4871   00:59AA  23                      inc hl
    4872   00:59AB  7E                      ld  a,(hl)
    4873   00:59AC  E6 0C                   and #0C
    4874   00:59AE  B1                      or  c
    4875   00:59AF  CB 7F                   bit 7,a
    4876   00:59B1  C2 B6 59                jp  nz,GETSLTT1
    4877   00:59B4  E6 03                   and %11
    4878   00:59B6                      GETSLTT1:
    4879   00:59B6  F5                      push    af
