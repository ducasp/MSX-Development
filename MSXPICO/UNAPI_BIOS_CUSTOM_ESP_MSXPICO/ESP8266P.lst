    5033   00:5A3E                          ; Slot in A, now get the address
    5034   00:5A3E  CD FE 59                call    GETMEMPOINTER
    5035   00:5A41                          ; HL has the address of our memory area, byte param is 7 bytes after start
    5036   00:5A41  11 07 00                ld  de,MEMORY_SB_VAR_OFFSET
