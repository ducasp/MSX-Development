    1757   00:4A2A                      
    1758   00:4A2A                      ; Check what is the current NAGLE setting
    1759   00:4A2A                      CHECKNAGLE:
    1760   00:4A2A                          CLEAR_UART
    1760   00:4A2A  3E 14             >     ld  a,20
    1760   00:4A2C  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    1761   00:4A2F  3E 51                   ld  a,CMD_QUERY_ESP_SETTINGS
    1762   00:4A31                          SEND_DATA
    1762   00:4A31  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1763   00:4A34  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1764   00:4A37  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1765   00:4A3B  DD 6B                   ld  ixl,e
    1766   00:4A3D  DD 62                   ld  ixh,d                       ; Address in IX
    1767   00:4A3F  CD 66 4B                call    WAIT_MENU_CMD_RESPONSE
    1768   00:4A42  CA 1F 4B                jp  z,MENU_SUB_BAD_END
    1769   00:4A45                          ; Response received, nagle is the first one, ON: or OFF:
    1770   00:4A45  3E 4F                   ld  a,'O'
    1771   00:4A47  DD BE 00                cp  (ix+0)
    1772   00:4A4A  C2 1F 4B                jp  nz,MENU_SUB_BAD_END
    1773   00:4A4D  3E 4E                   ld  a,'N'
    1774   00:4A4F  DD BE 01                cp  (ix+1)
    1775   00:4A52  C2 5F 4A                jp  nz,CHECK_NAGLE_OFF
    1776   00:4A55  3E 3A                   ld  a,':'
    1777   00:4A57  DD BE 02                cp  (ix+2)
    1778   00:4A5A  C2 1F 4B                jp  nz,MENU_SUB_BAD_END
    1779   00:4A5D  B7                      or  a                           ; It will make it NZ
    1780   00:4A5E  C9                      ret
    1781   00:4A5F                      CHECK_NAGLE_OFF:
    1782   00:4A5F  3E 46                   ld  a,'F'
    1783   00:4A61  DD BE 01                cp  (ix+1)
    1784   00:4A64  C2 1F 4B                jp  nz,MENU_SUB_BAD_END
    1785   00:4A67  3E 46                   ld  a,'F'
    1786   00:4A69  DD BE 02                cp  (ix+2)
    1787   00:4A6C  C2 1F 4B                jp  nz,MENU_SUB_BAD_END
    1788   00:4A6F  3E 3A                   ld  a,':'
    1789   00:4A71  DD BE 03                cp  (ix+3)
    1790   00:4A74  C2 1F 4B                jp  nz,MENU_SUB_BAD_END
    1791   00:4A77                          ; Already has zero, so just ret
    1792   00:4A77  C9                      ret
    1793   00:4A78                      
    1794   00:4A78                      ; Check what is the current TIMEOUT setting, return 0 if always on, otherwise there is a timeout
    1795   00:4A78                      ; Will return a zero terminated string @ HL that can be printed
    1796   00:4A78                      ; Will return the value in DE
    1797   00:4A78                      CHECKTIMEOUT:
    1798   00:4A78                          CLEAR_UART
    1798   00:4A78  3E 14             >     ld  a,20
    1798   00:4A7A  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    1799   00:4A7D  3E 51                   ld  a,CMD_QUERY_ESP_SETTINGS
    1800   00:4A7F                          SEND_DATA
    1800   00:4A7F  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1801   00:4A82  21 3C 00                ld  hl,60                       ; Wait Up To 1s
    1802   00:4A85  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1803   00:4A89  DD 6B                   ld  ixl,e
    1804   00:4A8B  DD 62                   ld  ixh,d                       ; Address in IX
    1805   00:4A8D  CD 66 4B                call    WAIT_MENU_CMD_RESPONSE
    1806   00:4A90  CA 1F 4B                jp  z,MENU_SUB_BAD_END
    1807   00:4A93                          ; Response received, nagle is the first one, ON: or OFF:
    1808   00:4A93  3E 3A                   ld  a,':'
    1809   00:4A95  DD 23                   inc ix
    1810   00:4A97  DD 23                   inc ix                          ; Nagle response is two or three bytes long, let's check
    1811   00:4A99  0B                      dec bc
    1812   00:4A9A  0B                      dec bc                          ; Remaining bytes
    1813   00:4A9B  DD BE 00                cp  (ix+0)
    1814   00:4A9E  CA AA 4A                jp  z,CHECKTIMEOUT.1
    1815   00:4AA1  DD 23                   inc ix
    1816   00:4AA3  0B                      dec bc                          ; Remaining bytes
    1817   00:4AA4  DD BE 00                cp  (ix+0)
    1818   00:4AA7  C2 1F 4B                jp  nz,MENU_SUB_BAD_END         ; If not here, sorry to say it is an error
    1819   00:4AAA                      CHECKTIMEOUT.1:
    1820   00:4AAA  78                      ld  a,b
    1821   00:4AAB  B1                      or  c                           ; All data read?
    1822   00:4AAC  CA 1F 4B                jp  z,MENU_SUB_BAD_END          ; If so, sorry to say it is an error
    1823   00:4AAF  DD 23                   inc ix                          ; At the first digit
    1824   00:4AB1  0B                      dec bc                          ; Remaining bytes
    1825   00:4AB2  78                      ld  a,b
    1826   00:4AB3  B1                      or  c                           ; All data read?
    1827   00:4AB4  CA 1F 4B                jp  z,MENU_SUB_BAD_END          ; If so, sorry to say it is an error
    1828   00:4AB7  DD E5                   push    ix                      ; This is the start of the string, save it
    1829   00:4AB9  26 00                   ld  h,0                         ; No digit so far
    1830   00:4ABB                          ; It can have up to three digits
    1831   00:4ABB                      CHECKTIMEOUT.2:
    1832   00:4ABB  3E 3A                   ld  a,':'
    1833   00:4ABD  DD BE 00                cp  (ix+0)                      ; Check if it is the separator
    1834   00:4AC0  CA E1 4A                jp  z,CHECKTIMEOUT.3            ; If it is routine will follow through
    1835   00:4AC3  DD 7E 00                ld  a,(ix+0)                    ; Get the supposed digit in A
    1836   00:4AC6  2E 3A                   ld  l,'9'+1
    1837   00:4AC8  BD                      cp  l
    1838   00:4AC9  D2 1E 4B                jp  nc,MENU_SUB_BAD_END_1S      ; If more than '9', sorry to say it is an error
    1839   00:4ACC  2E 30                   ld  l,'0'
    1840   00:4ACE  BD                      cp  l
    1841   00:4ACF  DA 1E 4B                jp  c,MENU_SUB_BAD_END_1S       ; If less than '0', sorry to say it is an error
    1842   00:4AD2  24                      inc h                           ; It is not, so it is a digit
    1843   00:4AD3  3E 03                   ld  a,3
    1844   00:4AD5  BC                      cp  h
    1845   00:4AD6  DA 1E 4B                jp  c,MENU_SUB_BAD_END_1S       ; If more than three digits, sorry to say it is an error
    1846   00:4AD9  DD 23                   inc ix                          ; Increase pointer
    1847   00:4ADB  0B                      dec bc                          ; Decrease remaining
    1848   00:4ADC  78                      ld  a,b
    1849   00:4ADD  B1                      or  c                           ; All data read?
    1850   00:4ADE  C2 BB 4A                jp  nz,CHECKTIMEOUT.2           ; Not, so rinse and repeat
    1851   00:4AE1                      CHECKTIMEOUT.3:
    1852   00:4AE1  DD 36 00 00             ld  (ix+0),0                    ; Null terminate string value
    1853   00:4AE5  DD 2B                   dec ix
    1854   00:4AE7  DD 7E 00                ld  a,(ix+0)                    ; 1st Digit in A
    1855   00:4AEA  D6 30                   sub '0'                         ; Convert it to decimal value
    1856   00:4AEC  5F                      ld  e,a
    1857   00:4AED  16 00                   ld  d,0                         ; DE has first digit
    1858   00:4AEF  25                      dec h                           ; Decrement digit counter
    1859   00:4AF0  28 28                   jr  z,CHECKTIMEOUT.END          ; If all digits, done
    1860   00:4AF2                          ; Now second digit, multiply it by 10 and add to E, even if 90 + 9, still fits E
    1861   00:4AF2  DD 2B                   dec ix
    1862   00:4AF4  DD 7E 00                ld  a,(ix+0)                    ; 2nd Digit
    1863   00:4AF7  D6 30                   sub '0'                         ; Convert it to decimal value
    1864   00:4AF9  87                      add a,a                         ; A has *2
    1865   00:4AFA  4F                      ld  c,a                         ; C has *2
    1866   00:4AFB  87                      add a,a                         ; A has *4
    1867   00:4AFC  87                      add a,a                         ; A has *8
    1868   00:4AFD  81                      add a,c                         ; A has *10
    1869   00:4AFE  83                      add a,e                         ; A has two digits result
    1870   00:4AFF  5F                      ld  e,a                         ; Back to E, DE has two digits results
    1871   00:4B00  25                      dec h                           ; Decrement digit counter
    1872   00:4B01  28 17                   jr  z,CHECKTIMEOUT.END          ; If all digits, done
    1873   00:4B03                          ; Now Third digit, multiply it by 100 and add to DE
    1874   00:4B03  DD 2B                   dec ix
    1875   00:4B05  DD 7E 00                ld  a,(ix+0)                    ; 3rd Digit
    1876   00:4B08  D6 30                   sub '0'                         ; Convert it to decimal value
    1877   00:4B0A  87                      add a,a                         ; A has *2
    1878   00:4B0B  4F                      ld  c,a                         ; C has *2
    1879   00:4B0C  87                      add a,a                         ; A has *4
    1880   00:4B0D  87                      add a,a                         ; A has *8
    1881   00:4B0E  81                      add a,c                         ; A has *10
    1882   00:4B0F  26 00                   ld  h,0
    1883   00:4B11  6F                      ld  l,a                         ; HL has *10
    1884   00:4B12  29                      add hl,hl                       ; HL has *20
    1885   00:4B13  44                      ld  b,h
    1886   00:4B14  4D                      ld  c,l                         ; BC has *20
    1887   00:4B15  29                      add hl,hl                       ; HL has *40
    1888   00:4B16  29                      add hl,hl                       ; HL has *80
    1889   00:4B17  09                      add hl,bc                       ; HL has *100
    1890   00:4B18  19                      add hl,de                       ; HL has three digit value
    1891   00:4B19  EB                      ex  de,hl                       ; now in DE
    1892   00:4B1A                      CHECKTIMEOUT.END:
    1893   00:4B1A  E1                      pop hl                          ; Restore address of string version of time count
    1894   00:4B1B  7A                      ld  a,d
    1895   00:4B1C  B3                      or  e                           ; Set zero flag according to the time out set
    1896   00:4B1D  C9                      ret
    1897   00:4B1E                      
    1898   00:4B1E                      MENU_SUB_BAD_END_1S:
    1899   00:4B1E  F1                      pop af                          ; 1 register was stacked, pop it
    1900   00:4B1F                      MENU_SUB_BAD_END:
    1901   00:4B1F  F1                      pop af                          ; It was a sub, so clear stack
    1902   00:4B20                      MENU_BAD_END:
    1903   00:4B20  21 59 68                ld  hl,STR_SENDING_FAIL         ; error message
    1904   00:4B23  CD 8E 4C                call    PRINTHL
    1905   00:4B26  C3 FF 49                jp  WAIT_2S_AND_THEN_MAINMENU
    1906   00:4B29                      
    1907   00:4B29                      ; WAIT an ESP quick command Response
    1908   00:4B29                      ; Inputs:
    1909   00:4B29                      ; A -> Command Code
    1910   00:4B29                      ; HL -> Timeout
    1911   00:4B29                      ;
    1912   00:4B29                      ; Returns:
    1913   00:4B29                      ; Flag Z is zero if failure, non zero if success
    1914   00:4B29                      ;
    1915   00:4B29                      ; Affect:
    1916   00:4B29                      ; AF and HL
    1917   00:4B29                      ;
    1918   00:4B29                      WAIT_MENU_QCMD_RESPONSE:
    1919   00:4B29  D5                      push    de
    1920   00:4B2A  57                      ld  d,a                         ; Command to wait in D
    1921   00:4B2B                      WAIT_MENU_QCMD_RESPONSE_ST1:
    1922   00:4B2B                          LOAD_STS_PORT_IN_A
    1922   00:4B2B  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    1923   00:4B2E  CB 6F                   bit 5,a                         ; If nz Port #07 is not available
    1924   00:4B30  C2 60 4B                jp  nz,WAIT_MENU_QCMD_RESPONSE_END_NOK
    1925   00:4B33  CB 47                   bit 0,a                         ; If nz has data
    1926   00:4B35  20 08                   jr  nz,WAIT_MENU_QCMD_RESPONSE_ST1.1
    1927   00:4B37  CD 88 4C                call    HLTIMEOUT
    1928   00:4B3A  20 EF                   jr  nz,WAIT_MENU_QCMD_RESPONSE_ST1
    1929   00:4B3C  C3 5E 4B                jp  WAIT_MENU_QCMD_RESPONSE_END ; If time out waiting, return
    1930   00:4B3F                      WAIT_MENU_QCMD_RESPONSE_ST1.1:
    1931   00:4B3F                          ; nz, check the data
    1932   00:4B3F                          RECEIVE_DATA
    1932   00:4B3F  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    1933   00:4B42  BA                      cp  d                           ; Is response of our command?
    1934   00:4B43  20 E6                   jr  nz,WAIT_MENU_QCMD_RESPONSE_ST1
    1935   00:4B45                          ; Now get return code, if return code other than 0, it is failure, otherwise success
    1936   00:4B45                      WAIT_MENU_QCMD_RESPONSE_RC:
    1937   00:4B45                          CHECK_DATA
    1937   00:4B45  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    1937   00:4B48  CB 47             >     bit 0,a
    1938   00:4B4A  20 08                   jr  nz,WAIT_MENU_QCMD_RESPONSE_RC.1
    1939   00:4B4C  CD 88 4C                call    HLTIMEOUT
    1940   00:4B4F  20 F4                   jr  nz,WAIT_MENU_QCMD_RESPONSE_RC
    1941   00:4B51  C3 5E 4B                jp  WAIT_MENU_QCMD_RESPONSE_END ; If time-out waiting, return
    1942   00:4B54                      WAIT_MENU_QCMD_RESPONSE_RC.1:
    1943   00:4B54                          RECEIVE_DATA
    1943   00:4B54  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    1944   00:4B57  B7                      or  a                           ; 0?
    1945   00:4B58                          ; If not, done
    1946   00:4B58  C2 60 4B                jp  nz,WAIT_MENU_QCMD_RESPONSE_END_NOK
    1947   00:4B5B                      WAIT_MENU_QCMD_RESPONSE_END_OK:
    1948   00:4B5B  3E 01                   ld  a,1
    1949   00:4B5D  B7                      or  a                           ; NZ to indicate success
    1950   00:4B5E                      WAIT_MENU_QCMD_RESPONSE_END:
    1951   00:4B5E  D1                      pop de
    1952   00:4B5F  C9                      ret
    1953   00:4B60                      WAIT_MENU_QCMD_RESPONSE_END_NOK:
    1954   00:4B60  21 00 00                ld  hl,0
    1955   00:4B63  AF                      xor a
    1956   00:4B64  D1                      pop de
    1957   00:4B65  C9                      ret
    1958   00:4B66                      
    1959   00:4B66                      ; WAIT an ESP regular command Response
    1960   00:4B66                      ; Inputs:
    1961   00:4B66                      ; A -> Command Code
    1962   00:4B66                      ; HL -> Timeout
    1963   00:4B66                      ; IX -> Where to store response
    1964   00:4B66                      ;
    1965   00:4B66                      ; Returns:
    1966   00:4B66                      ; Flag Z is zero if failure, non zero if success
    1967   00:4B66                      ; BC is the response size
    1968   00:4B66                      ;
    1969   00:4B66                      ; Affect:
    1970   00:4B66                      ; AF , BC and HL
    1971   00:4B66                      WAIT_MENU_CMD_RESPONSE:
