    4400   00:577D                      ;=======================
    4401   00:577D                      ;===  TCPIP_TCP_RCV  ===
    4402   00:577D                      ;=======================
    4403   00:577D                      ;Receive data from a TCP connection.
    4404   00:577D                      ;
    4405   00:577D                      ;Input:   A  = 18
    4406   00:577D                      ;         B  = Connection number
    4407   00:577D                      ;         DE = Address for the retrieved data
    4408   00:577D                      ;         HL = Length of the data to be obtained
    4409   00:577D                      ;Output:  A  = Error code
    4410   00:577D                      ;         BC = Total number of bytes that have been actually retrieved
    4411   00:577D                      ;         HL = Number of urgent data bytes that have been retrieved
    4412   00:577D                      ;              (placed at the beginning of the received data block)
    4413   00:577D                      ; Save registers other than AF
    4414   00:577D                      TCPIP_TCP_RCV_CHECK_TIME_OUT:
    4415   00:577D  C5                      push bc
    4416   00:577E  D5                      push de
    4417   00:577F  E5                      push hl
    4418   00:5780  CD 06 5A                call    GETCOUNTER
    4419   00:5783  7D                      ld  a,l
    4420   00:5784  B4                      or  h
    4421   00:5785                          ; Restore registers, we are returning
    4422   00:5785  E1                      pop hl
    4423   00:5786  D1                      pop de
    4424   00:5787  C1                      pop bc
    4425   00:5788  C0                      ret nz
    4426   00:5789                          ; Ok, timeout...
    4427   00:5789  F1                      pop af                          ; Get return address of who called this out of the stack, we will return from the function or re-start
    4428   00:578A                      TCPIP_TCP_RCV_RETRY_QRCV:
    4429   00:578A  CD 25 5A                call    GETBYTE
    4430   00:578D  B7                      or  a
    4431   00:578E  28 0C                   jr  z,TCPIP_TCP_RCV_CHECK_TIME_OUT.NORXRETRY
    4432   00:5790                          ; Ok, so let's ask ESP to re-send the data and retry receiving it
    4433   00:5790  3D                      dec a
    4434   00:5791  CD 37 5A                call    SETBYTE                 ; we are retrying it
    4435   00:5794  3E 72                   ld  a,'r'                       ; retry transmission command
    4436   00:5796                          SEND_DATA
    4436   00:5796  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4437   00:5799  C3 E0 57                jp  TCPIP_TCP_RCV.RXRETRY       ; and retry it
    4438   00:579C                      TCPIP_TCP_RCV_CHECK_TIME_OUT.NORXRETRY:
    4439   00:579C  3E 0F                   ld  a,ERR_INV_OPER
    4440   00:579E  C9                      ret                             ; and return the function itself
    4441   00:579F                      
    4442   00:579F                      TCPIP_TCP_RCV_RET_ERR:
    4443   00:579F                          ; next two bytes are size bytes, don't care
    4444   00:579F  47                      ld  b,a                         ; save error in b
    4445   00:57A0  0E 02                   ld  c,2
