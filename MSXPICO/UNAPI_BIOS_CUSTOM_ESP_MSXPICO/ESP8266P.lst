    2215   00:4CCF                      ;===============================
    2216   00:4CCF                      ;===  HTIM_I hook execution  ===
    2217   00:4CCF                      ;===============================
    2218   00:4CCF                      DO_HTIMI:
    2219   00:4CCF  F5                      push    af                      ; HTIM hook -> need to keep A value
    2220   00:4CD0  CD 06 5A                call    GETCOUNTER              ; Counter in hl
    2221   00:4CD3  7D                      ld  a,l
    2222   00:4CD4  B4                      or  h                           ; In this operation, check if HL is o
    2223   00:4CD5  28 04                   jr  z,DO_HTIMI_END              ; If it is, nothing to do
    2224   00:4CD7  2B                      dec hl                          ; Otherwise decrement it
    2225   00:4CD8  CD 15 5A                call    SETCOUNTER              ; And save it
    2226   00:4CDB                      DO_HTIMI_END:
    2227   00:4CDB  CD 75 59                call    GETSLT
    2228   00:4CDE                          ; Slot in A, now get the address of our counter
    2229   00:4CDE  CD FE 59                call    GETMEMPOINTER
    2230   00:4CE1                          ; HL has the address of our memory area, and there is where we should jump
    2231   00:4CE1  F1                      pop af                          ; Restore original A value
    2232   00:4CE2  E9                      jp  (hl)
    2233   00:4CE3                      
    2234   00:4CE3                      ;===============================
    2235   00:4CE3                      ;===  EXTBIO hook execution  ===
    2236   00:4CE3                      ;===============================
    2237   00:4CE3                      DO_EXTBIO:
