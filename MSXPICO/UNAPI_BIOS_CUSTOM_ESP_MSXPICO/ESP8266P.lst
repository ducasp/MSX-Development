    1214   00:4653  BB                      cp  e                           ; Check if a is greater than what is in E
    1215   00:4654  D2 FE 47                jp  nc,INPUT_WFSAP_BAD_INPUT    ; If it is, ignore
    1216   00:4657  C3 F1 46                jp  WIFI_CONNECT_SELECTION_OK   ; Selection Ok if here
    1217   00:465A                      
