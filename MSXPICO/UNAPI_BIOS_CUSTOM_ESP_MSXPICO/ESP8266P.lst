    2129   00:4C57  20 E6                   jr  nz,WAIT_MENU_SCMD_RESPONSE_ST2B
    2130   00:4C59                          ; Get encryption
    2131   00:4C59                      WAIT_MENU_SCMD_RESPONSE_GET_ENC:
    2132   00:4C59                          CHECK_DATA
    2132   00:4C59  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2132   00:4C5C  CB 47             >     bit 0,a
    2133   00:4C5E  20 08                   jr  nz,WAIT_MENU_SCMD_RESPONSE_GET_ENC.1
    2134   00:4C60  CD 88 4C                call    HLTIMEOUT
    2135   00:4C63  20 F4                   jr  nz,WAIT_MENU_SCMD_RESPONSE_GET_ENC
