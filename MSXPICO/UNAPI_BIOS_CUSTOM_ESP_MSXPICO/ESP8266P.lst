    1135   00:45D3  CD A2 00                call    CHPUT
    1136   00:45D6  3E 20                   ld  a,' '                       ; Space
    1137   00:45D8  CD A2 00                call    CHPUT
    1138   00:45DB  06 18                   ld  b,24                        ; Cuts AP names > 23 chars
