    5040   00:5A46  77                      ld  (hl),a
    5041   00:5A47  E1                      pop hl
    5042   00:5A48  D1                      pop de
    5043   00:5A49  C1                      pop bc
    5044   00:5A4A  C9                      ret
    5045   00:5A4B                      
    5046   00:5A4B                      ;--- Obtain a two bytes param saved in high memory
    5047   00:5A4B                      ;    Input:  none
    5048   00:5A4B                      ;    Output: HL = param
    5049   00:5A4B                      ;    Modifies: AF, HL
    5050   00:5A4B                      
    5051   00:5A4B                      GETWORD:
    5052   00:5A4B  C5                      push    bc
    5053   00:5A4C  D5                      push    de
    5054   00:5A4D  CD 75 59                call    GETSLT
    5055   00:5A50                          ; Slot in A, now get the address of our counter
    5056   00:5A50  CD FE 59                call    GETMEMPOINTER
    5057   00:5A53                          ; HL has the address of our memory area, param is 7 bytes after start
    5058   00:5A53  11 0B 00                ld  de,MEMORY_DB_VAR_OFFSET
