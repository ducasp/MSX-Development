    5459   00:5BA8  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5460   00:5BAB  21 40 5D                ld  hl,RSP_CMD_QUERY_ESP        ; Expected response
    5461   00:5BAE  11 3C 00                ld  de,60                       ; Up to 1s @ 60Hz
    5462   00:5BB1  3E 02                   ld  a,RSP_CMD_QUERY_ESP_SIZE    ; Size of response
    5463   00:5BB3  CD 71 5B                call    WAIT_RESPONSE_FROM_ESP
    5464   00:5BB6  B7                      or  a
    5465   00:5BB7  3E 01                   ld  a,1
    5466   00:5BB9  28 03                   jr  z,RESET_ESP_INIT            ; ESP Found
    5467   00:5BBB  06 00                   ld  b,0                         ; 0 if no response
    5468   00:5BBD  C9                      ret
    5469   00:5BBE                      RESET_ESP_INIT:
    5470   00:5BBE  06 03                   ld  b,3                         ; Retry up to 10 times
    5471   00:5BC0                      RESET_ESP_LOOP:
    5472   00:5BC0                          CLEAR_UART
    5472   00:5BC0  3E 14             >     ld  a,20
    5472   00:5BC2  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    5473   00:5BC5                          SET_SPEED
    5473   00:5BC5  AF                >     xor a
    5473   00:5BC6  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    5474   00:5BC9  76                      halt
    5475   00:5BCA  76                      halt                            ; Wait a little to make sure speed is adjusted
    5476   00:5BCB  3E 57                   ld  a,CMD_WRESET_ESP
    5477   00:5BCD                          SEND_DATA
    5477   00:5BCD  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    5478   00:5BD0  21 3B 5D                ld  hl,RSP_CMD_RESET_ESP        ; Expected response
    5479   00:5BD3  11 5A 00                ld  de,90                       ; Up to 1.5s @ 60Hz
    5480   00:5BD6  3E 05                   ld  a,RSP_CMD_RESET_ESP_SIZE    ; Size of response
    5481   00:5BD8  C5                      push    bc                      ; Save retry counter
    5482   00:5BD9  CD 71 5B                call    WAIT_RESPONSE_FROM_ESP
    5483   00:5BDC  C1                      pop bc                          ; restore retry counter
    5484   00:5BDD  B7                      or  a                           ; Did WAIT RESPONSE return zero?
    5485   00:5BDE  C8                      ret z                           ; Yes, Warm Reset Ok
    5486   00:5BDF  10 DF                   djnz RESET_ESP_LOOP             ; No, decrement retry counter and let the loop check
    5487   00:5BE1                          ; No more retries? Then check if it is old ESP FW
    5488   00:5BE1                      RESET_CHK_IF_INSTALLED:
    5489   00:5BE1                          ; No more retries? Then it is old ESP FW
    5490   00:5BE1  06 01                   ld  b,1
    5491   00:5BE3  C9                      ret
    5492   00:5BE4                      
    5493   00:5BE4                      ;*********************************************
    5494   00:5BE4                      ;***              SET TIME                 ***
    5495   00:5BE4                      ;*** H - Hour                              ***
    5496   00:5BE4                      ;*** L - Minutes                           ***
    5497   00:5BE4                      ;*** D - Seconds                           ***
    5498   00:5BE4                      ;***                                       ***
    5499   00:5BE4                      ;*** A - 0 if Ok otherwise invalid time    ***
    5500   00:5BE4                      ;*********************************************
    5501   00:5BE4                      SET_TIME:
    5502   00:5BE4  7C                      ld  a,h                         ; Hour in A
    5503   00:5BE5  FE 18                   cp  24                          ; Compare to 24
    5504   00:5BE7  30 12                   jr  nc,SET_TIME_ERR             ; If 24 or more, invalid
    5505   00:5BE9  7D                      ld  a,l                         ; Minutes in A
    5506   00:5BEA  FE 3C                   cp  60                          ; Compare to 60
    5507   00:5BEC  30 0D                   jr  nc,SET_TIME_ERR             ; If 60 or more, invalid
    5508   00:5BEE  7A                      LD  a,d                         ; Seconds in D
    5509   00:5BEF  FE 3C                   cp  60                          ; Compare to 60
    5510   00:5BF1  30 08                   jr  nc,SET_TIME_ERR             ; If 60 or more invalid
    5511   00:5BF3  44                      ld  b,h                         ; Hour in B
    5512   00:5BF4  4D                      ld  c,l                         ; Minutes in C
    5513   00:5BF5  5A                      ld  e,d                         ; Seconds in E
    5514   00:5BF6  CD FE 5B                call    SET_RTC_TIME            ; Set time in RTC
    5515   00:5BF9  AF                      xor a                           ; 0 in A
    5516   00:5BFA  C9                      ret                             ; Return
    5517   00:5BFB                      ;   Invalid parameter
    5518   00:5BFB                      SET_TIME_ERR:
    5519   00:5BFB  3E 01                   ld  a,1                         ; Invalid Time
    5520   00:5BFD  C9                      ret                             ; Return
    5521   00:5BFE                      
    5522   00:5BFE                      SET_RTC_TIME:
    5523   00:5BFE  6B                      ld  l,e                         ; Seconds in L
    5524   00:5BFF  61                      ld  h,c                         ; Minutes in H
    5525   00:5C00  50                      ld  d,b                         ; Hour in D
    5526   00:5C01  CD 59 5C                call    STOP_RTC_COUNT_SET_MODE0; Select RTC Register 13, and set Mode / Page 0
    5527   00:5C04  3E 0F                   ld  a,#F                        ; Register F
    5528   00:5C06  D3 B4                   out (#B4),a
    5529   00:5C08  3E 02                   ld  a,2
    5530   00:5C0A  D3 B5                   out (#B5),a                     ; Timer reset seconds and on both clock pulses
    5531   00:5C0C  1E 00                   ld  e,0                         ; Start at register 0
    5532   00:5C0E  C3 94 5C                jp  SET_RTC_DATE.1              ; And save L, H and D, function will return from there
    5533   00:5C11                      
    5534   00:5C11                      ;*********************************************
    5535   00:5C11                      ;***              SET DATE                 ***
    5536   00:5C11                      ;*** HL - Year from 1980 to 2079           ***
    5537   00:5C11                      ;*** D - Month from 1 to 12                ***
    5538   00:5C11                      ;*** E - Day from 1 to 31                  ***
    5539   00:5C11                      ;***                                       ***
    5540   00:5C11                      ;*** A - 0 if Ok otherwise invalid Date    ***
    5541   00:5C11                      ;*********************************************
    5542   00:5C11                      SET_DATE:
    5543   00:5C11  01 44 F8                ld  bc,#F844
    5544   00:5C14  09                      add hl,bc
    5545   00:5C15  30 32                   jr  nc,SET_DATE_ERR             ; No carry -> Year is less than 1980, invalid date
    5546   00:5C17  7C                      ld  a,h
    5547   00:5C18  B7                      or  a
    5548   00:5C19  20 2E                   jr  nz,SET_DATE_ERR             ; If H is set, means year is greater than 2235 ,invalid
    5549   00:5C1B  7D                      ld  a,l
    5550   00:5C1C  FE 64                   cp  100
    5551   00:5C1E  30 29                   jr  nc,SET_DATE_ERR             ; If L >= 100 year is greater than 2079, invalid
    5552   00:5C20  47                      ld  b,a                         ; Year - 1980 in B
    5553   00:5C21  7A                      ld  a,d                         ; Now test month
    5554   00:5C22  3D                      dec a
    5555   00:5C23  FE 0C                   cp  12                          ; If 12 or less this should carry
    5556   00:5C25  30 22                   jr  nc,SET_DATE_ERR             ; otherwise invalid
    5557   00:5C27  21 4C 5C                ld  hl,DAYS_IN_MONTH            ; Days in Month table
    5558   00:5C2A  85                      add a,l                         ; add our month
    5559   00:5C2B  6F                      ld  l,a                         ; back in L
    5560   00:5C2C  30 01                   jr  nc,SET_DATE1                ; no carry done
    5561   00:5C2E  24                      inc h                           ; otherwise increase H
    5562   00:5C2F                      SET_DATE1:
    5563   00:5C2F  3E 1C                   ld  a,28                        ; 28 days
    5564   00:5C31  BE                      cp  (hl)                        ; If month is 28 days, February, need to check if leap and limit is 29 in this year
    5565   00:5C32  20 08                   jr  nz,SET_DATE2                ; if not, skip below code , so probably above check is if month is february
    5566   00:5C34  78                      ld  a,b                         ; Year - 1980 in A again
    5567   00:5C35  E6 03                   and 3                           ; if other than 0, non divisible per 4, so not a leap year
    5568   00:5C37  20 03                   jr  nz,SET_DATE2                ; Regular year
    5569   00:5C39  21 58 5C                ld  hl,DAYS_IN_FEBRUARY_LEAP    ; HL has address of 29 days, maximum number of days for february in leap year
    5570   00:5C3C                      SET_DATE2:
    5571   00:5C3C  7B                      ld  a,e                         ; Day of month in A
    5572   00:5C3D  3D                      dec a                           ; Decrement
    5573   00:5C3E  BE                      cp  (hl)                        ; Compare with Days in month
    5574   00:5C3F  30 08                   jr  nc,SET_DATE_ERR             ; If day is greater than how many days in month, invalid
    5575   00:5C41  6B                      ld  l,e                         ; Day of month in L
    5576   00:5C42  62                      ld  h,d                         ; Month in H
    5577   00:5C43  50                      ld  d,b                         ; Year - 1980 in D
    5578   00:5C44  CD 7E 5C                call    SET_RTC_DATE            ; Set date in RTC
    5579   00:5C47  AF                      xor a                           ; A = 0
    5580   00:5C48  C9                      ret                             ; Success
    5581   00:5C49                      ;   Invalid parameter
    5582   00:5C49                      SET_DATE_ERR:
    5583   00:5C49  3E 01                   ld  a,1
    5584   00:5C4B  C9                      ret
    5585   00:5C4C                      
    5586   00:5C4C                      ; Table of top day value for each month
    5587   00:5C4C                      DAYS_IN_MONTH:          db  31,28,31,30,31,30,31,31,30,31,30,31
    5587   00:5C4C  1F 1C 1F 1E 1F 1E 1F 1F 1E 1F 1E 1F 
    5588   00:5C58                      ; And top day value in February when Leap Year
    5589   00:5C58  1D                  DAYS_IN_FEBRUARY_LEAP:  db  29
    5590   00:5C59                      
    5591   00:5C59                      ; Will select Mode 00 (Date and Time page) and stop clock counting
    5592   00:5C59                      ; Register D value will be left in A
    5593   00:5C59                      STOP_RTC_COUNT_SET_MODE0:
    5594   00:5C59  3E 0D                   ld  a,#D
    5595   00:5C5B  D3 B4                   out (#B4),a                     ; Select RTC register D (mode)
    5596   00:5C5D  DB B5                   in  a,(#B5)                     ; read register D
    5597   00:5C5F  E6 04                   and 4                           ; Save Alarm EN setting, and mode register is 00 and stop counting time
    5598   00:5C61  D3 B5                   out (#B5),a                     ; And save
    5599   00:5C63  C9                      ret
    5600   00:5C64                      
    5601   00:5C64                      ; Will get a non BCD value in A, convert it to BCD and then save it in
    5602   00:5C64                      ; a register pair that starts in the register indicated in E
    5603   00:5C64                      ; Register E will have the next register after that register pair
    5604   00:5C64                      RTC_SAVE_REGISTERPAIR:
    5605   00:5C64  4F                      ld  c,a                         ; Save A in C
    5606   00:5C65  AF                      xor a                           ; 0 in A
    5607   00:5C66  06 08                   ld  b,8                         ; 8 in B, number of bits for conversion
    5608   00:5C68                      RTC_SAVE_REGISTERPAIR.1:
    5609   00:5C68  CB 01                   rlc c                           ; Leftmost bit in Carry
    5610   00:5C6A  8F                      adc a,a                         ; A = (A * 2) + Carry
    5611   00:5C6B  27                      daa                             ; decimal adjust A, shift = BCD x 2 + carry
    5612   00:5C6C  10 FA                   djnz    RTC_SAVE_REGISTERPAIR.1 ; Repeat for 8 bits
    5613   00:5C6E  CD 75 5C                call    SET_RTC_REG             ; Save LSB in register and increase register address
    5614   00:5C71  0F                      rrca
    5615   00:5C72  0F                      rrca
    5616   00:5C73  0F                      rrca
    5617   00:5C74  0F                      rrca                            ; now MSB is in LSB position
    5618   00:5C75                      SET_RTC_REG:
    5619   00:5C75  47                      ld  b,a                         ; save value to set in B
    5620   00:5C76  7B                      ld  a,e                         ; and now register address in A
    5621   00:5C77  D3 B4                   out (#B4),a                     ; The register we want to set
    5622   00:5C79  78                      ld  a,b                         ; restore value
    5623   00:5C7A  D3 B5                   out (#B5),a                     ; save it
    5624   00:5C7C  1C                      inc e                           ; increase register address, as this usually is done in pairs
    5625   00:5C7D  C9                      ret
    5626   00:5C7E                      
    5627   00:5C7E                      ; Auxiliary function for SET_DATE and SET_TIME
    5628   00:5C7E                      ; SET_RTC_DATE will save date, parameters:
    5629   00:5C7E                      ; L - Day
    5630   00:5C7E                      ; H - Month
    5631   00:5C7E                      ; D - Years since 1980
    5632   00:5C7E                      ; All values are regular values, this function will properly convert them
    5633   00:5C7E                      ;
    5634   00:5C7E                      ; SET_RTC_DATE.1 is used by SET_TIME as well
    5635   00:5C7E                      ; It will save three register pairs, starting with the register in E
    5636   00:5C7E                      ; First pair is updated with value in L
    5637   00:5C7E                      ; Second pair is updated with value in H
    5638   00:5C7E                      ; Third pair is updated with value in D
    5639   00:5C7E                      SET_RTC_DATE:
    5640   00:5C7E  CD 59 5C                call    STOP_RTC_COUNT_SET_MODE0; Select RTC Register 13, and set Mode / Page 0
    5641   00:5C81  F6 01                   or  1                           ; Set Bit 0, so Mode / Page 1
    5642   00:5C83  D3 B5                   out (#B5),a                     ; save it in register 13, now page 1 selected
    5643   00:5C85  3E 0B                   ld  a,#B                        ; Leap Year Counter Register
    5644   00:5C87  D3 B4                   out (#B4),a                     ; Select it
    5645   00:5C89  7A                      ld  a,d                         ; Load Years in leap year counter
    5646   00:5C8A  D3 B5                   out (#B5),a                     ; So it has count of leap years (0 is 1980, leap, and every time it is 4, leap year again)
    5647   00:5C8C  CD 59 5C                call    STOP_RTC_COUNT_SET_MODE0; Select RTC Register 13 and set mode / page 0
    5648   00:5C8F  CD 59 5C                call    STOP_RTC_COUNT_SET_MODE0; do it a second time... DOS does it, don't want to JYNX it :P
    5649   00:5C92  1E 07                   ld  e,7                         ; Register 7
    5650   00:5C94                      SET_RTC_DATE.1:
    5651   00:5C94  7D                      ld  a,l                         ; A has day
    5652   00:5C95  CD 64 5C                call    RTC_SAVE_REGISTERPAIR   ; Will convert day to BCD and save in registers 7 and 8
    5653   00:5C98  7C                      ld  a,h                         ; A has month
    5654   00:5C99  CD 64 5C                call    RTC_SAVE_REGISTERPAIR   ; Will convert month to BCD and save in register 9 and A
    5655   00:5C9C  7A                      ld  a,d                         ; A has how many years since 1980
    5656   00:5C9D  CD 64 5C                call    RTC_SAVE_REGISTERPAIR   ; Will convert to BCD and save in register B and C
    5657   00:5CA0  3E 0D                   ld  a,#D                        ; Register D
    5658   00:5CA2  D3 B4                   out (#B4),a                     ; Send it
    5659   00:5CA4  DB B5                   in  a,(#B5)                     ; Read its value
    5660   00:5CA6  F6 08                   or  8                           ; Start counting time again
    5661   00:5CA8  D3 B5                   out (#B5),a                     ; Send
    5662   00:5CAA  C9                      ret
    5663   00:5CAB                      
    5664   00:5CAB                      ; Pattern setup routine
    5665   00:5CAB                      PATTERN_SETUP:
    5666   00:5CAB  AF                      xor a                           ; Bit-16, V9938 and V9958 only
    5667   00:5CAC  21 88 00                ld  hl,#0088                    ; Bit-15 to 0, pattern base address = #0088
    5668   00:5CAF  CD 1F 5D                call SET_VDP_WRITE
    5669   00:5CB2  21 BF 5C                ld  hl,PATTERN_DATA             ; Point to hl
    5670   00:5CB5  06 60                   ld  b,8*12                      ; Redraw 12 chars, max 12 chars are suggested
    5671   00:5CB7  0E 98                   ld  c,#98                       ; port #98
    5672   00:5CB9                      OUTI_TO_VRAM_TMS9918:
    5673   00:5CB9  ED A3                   outi                            ; Slower than otir but useful on TMS9918 which requires 29 T-states
    5674   00:5CBB  C2 B9 5C                jp  nz,OUTI_TO_VRAM_TMS9918     ; Therefore, don't use 'djnz' here!
    5675   00:5CBE  C9                      ret
    5676   00:5CBF                      PATTERN_DATA:
