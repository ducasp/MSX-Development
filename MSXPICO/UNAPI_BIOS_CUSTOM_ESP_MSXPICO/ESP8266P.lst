    4447   00:57A5  CB 47             >     bit 0,a
    4448   00:57A7  20 05                   jr  nz,TCPIP_TCP_RCV_RET_ERR2.1
    4449   00:57A9  CD 7D 57                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    4450   00:57AC  18 F4                   jr  TCPIP_TCP_RCV_RET_ERR2
