    5808   00:5D3B                      ;*********************************************
    5809   00:5D3B                      ;***    ESP Specific Commands/Responses    ***
    5810   00:5D3B                      ;*********************************************
    5811   00:5D3B                      ; Cold reset of ESP firmware
    5812   00:5D3B  (00:0052)           CMD_RESET_ESP           equ 'R'
    5813   00:5D3B                      ; Warm reset of ESP firmware
    5814   00:5D3B  (00:0057)           CMD_WRESET_ESP          equ 'W'
    5815   00:5D3B                      ; Hold Wi-Fi Connection On
    5816   00:5D3B  (00:0048)           CMD_WIFIHOLD_ESP        equ 'H'
    5817   00:5D3B                      ; Release Wi-Fi Connection Hold
    5818   00:5D3B  (00:0068)           CMD_WIFIRELEASE_ESP     equ 'h'
    5819   00:5D3B                      ; Get Updated time and date from internet
    5820   00:5D3B  (00:0047)           CMD_GET_TIME            equ 'G'
    5821   00:5D3B                      ; Query Auto Clock settings
    5822   00:5D3B  (00:0063)           CMD_QUERY_ACLK_SETTINGS equ 'c'
    5823   00:5D3B                      ; Set Auto Clock settings
    5824   00:5D3B  (00:0043)           CMD_SET_ACLK_SETTINGS   equ 'C'
    5825   00:5D3B                      ; Query ESP settings
    5826   00:5D3B  (00:0051)           CMD_QUERY_ESP_SETTINGS  equ 'Q'
    5827   00:5D3B                      ; Set Timer Value
    5828   00:5D3B  (00:0054)           CMD_TIMER_SET           equ 'T'
    5829   00:5D3B                      ; Turn Nagle On
    5830   00:5D3B  (00:0044)           CMD_NAGLE_ON            equ 'D'
    5831   00:5D3B                      ; Turn Nagle Off
    5832   00:5D3B  (00:004E)           CMD_NAGLE_OFF           equ 'N'
    5833   00:5D3B                      ; Turn Wi-Fi Off
    5834   00:5D3B  (00:004F)           CMD_WIFI_OFF            equ 'O'
    5835   00:5D3B                      ; Request to connect to a network
    5836   00:5D3B  (00:0041)           CMD_WIFI_CONNECT        equ 'A'
    5837   00:5D3B                      ; Request to start network scan
    5838   00:5D3B  (00:0053)           CMD_SCAN_START          equ 'S'
    5839   00:5D3B                      ; Request network scan result
    5840   00:5D3B  (00:0073)           CMD_SCAN_RESULTS        equ 's'
    5841   00:5D3B                      ; Request AP Status
    5842   00:5D3B  (00:0067)           CMD_AP_STS              equ 'g'
    5843   00:5D3B                      ; Get ESP firmware version
    5844   00:5D3B  (00:0056)           CMD_GET_ESP_VER         equ 'V'
    5845   00:5D3B                      ; After finishing Warm reset, ESP returns ready
    5846   00:5D3B  52 65 61 64 79      RSP_CMD_RESET_ESP       db  "Ready"
    5847   00:5D40  (00:0005)           RSP_CMD_RESET_ESP_SIZE  equ 5
    5848   00:5D40                      ; Query ESP Presence
    5849   00:5D40  (00:003F)           CMD_QUERY_ESP           equ '?'
    5850   00:5D40                      ; Query response
    5851   00:5D40  4F 4B               RSP_CMD_QUERY_ESP       db  "OK"
    5852   00:5D42  (00:0002)           RSP_CMD_QUERY_ESP_SIZE  equ 2
