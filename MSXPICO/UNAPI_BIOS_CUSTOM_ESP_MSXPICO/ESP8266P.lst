    4918   00:59E2                      
    4919   00:59E2                      ;--- Obtain the address where our memory area address in high memory is stored
    4920   00:59E2                      ;    Input:  A  = Slot number
    4921   00:59E2                      ;    Output: HL = High memory area address
    4922   00:59E2                      ;    Modifies: AF, BC
    4923   00:59E2                      
    4924   00:59E2                      GETMEMPOINTERADDR:
    4925   00:59E2  47                      ld  b,a
    4926   00:59E3  0F                      rrca
    4927   00:59E4  0F                      rrca
    4928   00:59E5  0F                      rrca
    4929   00:59E6  E6 60                   and %01100000
    4930   00:59E8  4F                      ld  c,a                         ; C = Slot * 32
    4931   00:59E9  78                      ld  a,b
