    5060   00:5A57                          ; Ok, this is where our param is so get it
    5061   00:5A57  5E                      ld  e,(hl)
    5062   00:5A58  23                      inc hl
    5063   00:5A59  56                      ld  d,(hl)
    5064   00:5A5A  EB                      ex  de,hl                       ; Return in HL
