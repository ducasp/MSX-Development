    4689   00:58FD  20 05                   jr  nz,TCPIP_CONFIG_AUTOIP_CONF_ST1.1
    4690   00:58FF  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4691   00:5902  18 F4                   jr  TCPIP_CONFIG_AUTOIP_CONF_ST1
    4692   00:5904                      TCPIP_CONFIG_AUTOIP_CONF_ST1.1:
