    4505   00:580B  18 F4                   jr  TCPIP_TCP_RCV_RC
    4506   00:580D                      TCPIP_TCP_RCV_RC.1:
    4507   00:580D                          ; nz, discard
    4508   00:580D                          RECEIVE_DATA
    4508   00:580D  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4509   00:5810  B7                      or  a                           ; 0?
    4510   00:5811  20 8C                   jr  nz,TCPIP_TCP_RCV_RET_ERR    ; if not, done
    4511   00:5813                          ; next two bytes are response size bytes (UB count two bytes, always 0, and data read), save it -2 to BC
    4512   00:5813                      TCPIP_TCP_RCV_ST2A:
    4513   00:5813                          CHECK_DATA
    4513   00:5813  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    4513   00:5816  CB 47             >     bit 0,a
    4514   00:5818  20 05                   jr  nz,TCPIP_TCP_RCV_ST2A.1
    4515   00:581A  CD 7D 57                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    4516   00:581D  18 F4                   jr  TCPIP_TCP_RCV_ST2A
    4517   00:581F                      TCPIP_TCP_RCV_ST2A.1:
    4518   00:581F                          ; nz, high byte count of bytes to receive
    4519   00:581F                          RECEIVE_DATA
    4519   00:581F  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4520   00:5822  67                      ld h,a
    4521   00:5823                      TCPIP_TCP_RCV_ST2B:
    4522   00:5823                          CHECK_DATA
    4522   00:5823  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    4522   00:5826  CB 47             >     bit 0,a
    4523   00:5828  20 05                   jr  nz,TCPIP_TCP_RCV_ST2B.1
    4524   00:582A  CD 7D 57                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    4525   00:582D  18 F4                   jr  TCPIP_TCP_RCV_ST2B
    4526   00:582F                      TCPIP_TCP_RCV_ST2B.1:
    4527   00:582F                          ; nz, low byte count of bytes to receive
    4528   00:582F                          RECEIVE_DATA
    4528   00:582F  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4529   00:5832  6F                      ld  l,a
    4530   00:5833  01 02 00                ld  bc,2
