    4575   00:5866                    ~     ; Otherwise, let's speed it up baby!
    4576   00:5866                    ~ TCPIP_TCP_RCV_R:
    4577   00:5866                    ~     inir
    4578   00:5866                    ~     else
    4579   00:5866                          CHECK_QUICK_RECEIVE
    4579   00:5866  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    4579   00:5869  CB 5F             >     bit 3,a
    4580   00:586B  28 1A                   jr  z,TCPIP_TCP_RCV_R_NSF       ; If not, go to the old, slower route
    4581   00:586D                          ; Otherwise, let's speed it up baby!
    4582   00:586D                      TCPIP_TCP_RCV_R:
