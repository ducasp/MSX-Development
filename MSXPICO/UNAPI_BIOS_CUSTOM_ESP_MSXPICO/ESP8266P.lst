    2161   00:4C86  D1                      pop de
    2162   00:4C87  C9                      ret
    2163   00:4C88                      
    2164   00:4C88                      ; This routine will check if HL is 0, if it is, will return immediatelly
    2165   00:4C88                      ; If it is not, will decrease HL value and halt (wait one interrupt)
    2166   00:4C88                      HLTIMEOUT:
    2167   00:4C88  7C                      ld  a,h
    2168   00:4C89  B5                      or  l
    2169   00:4C8A  C8                      ret z
