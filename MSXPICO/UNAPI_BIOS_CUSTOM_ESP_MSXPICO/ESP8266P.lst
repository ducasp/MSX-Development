    2848   00:4FCB  18 F4                   jr  TCPIP_NET_STATE_RC
    2849   00:4FCD                      TCPIP_NET_STATE_RC.1:
    2850   00:4FCD                          ; nz, get it
    2851   00:4FCD                          RECEIVE_DATA
    2851   00:4FCD  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2852   00:4FD0  B7                      or  a                           ; 0?
    2853   00:4FD1  C0                      ret nz                          ; if not, done
    2854   00:4FD2                      
    2855   00:4FD2                          ; next two bytes are return code and size bytes, don't care, it is 1
    2856   00:4FD2  06 02                   ld  b,2
    2857   00:4FD4                      TCPIP_NET_STATE_ST2:
    2858   00:4FD4                          CHECK_DATA
    2858   00:4FD4  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2858   00:4FD7  CB 47             >     bit 0,a
    2859   00:4FD9  20 05                   jr  nz,TCPIP_NET_STATE_ST2.1
    2860   00:4FDB  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2861   00:4FDE  18 F4                   jr  TCPIP_NET_STATE_ST2
    2862   00:4FE0                      TCPIP_NET_STATE_ST2.1:
    2863   00:4FE0                          ; nz, discard
    2864   00:4FE0                          RECEIVE_DATA
    2864   00:4FE0  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2865   00:4FE3  05                      dec b
    2866   00:4FE4  20 EE                   jr  nz,TCPIP_NET_STATE_ST2
    2867   00:4FE6                      
    2868   00:4FE6                          ; now just get the 1 byte (NET STATE) IP and place it in B
    2869   00:4FE6                      TCPIP_NET_STATE_NS_ST1:
    2870   00:4FE6                          CHECK_DATA
    2870   00:4FE6  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2870   00:4FE9  CB 47             >     bit 0,a
    2871   00:4FEB  20 05                   jr  nz,TCPIP_NET_STATE_NS_ST1.1
    2872   00:4FED  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2873   00:4FF0  18 F4                   jr  TCPIP_NET_STATE_NS_ST1
    2874   00:4FF2                      TCPIP_NET_STATE_NS_ST1.1:
    2875   00:4FF2                          ; nz, get it
    2876   00:4FF2                          RECEIVE_DATA
    2876   00:4FF2  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2877   00:4FF5  47                      ld  b,a
    2878   00:4FF6                          ; done
    2879   00:4FF6  AF                      xor a
    2880   00:4FF7  C9                      ret
    2881   00:4FF8                      
    2882   00:4FF8                      ;=====================
    2883   00:4FF8                      ;===  TCPIP_DNS_Q  ===
    2884   00:4FF8                      ;=====================
    2885   00:4FF8                      ;Start a host name resolution query.
    2886   00:4FF8                      ;
    2887   00:4FF8                      ;Input:  A  = 6
    2888   00:4FF8                      ;        HL = Address of the host name to be resolved, zero terminated
    2889   00:4FF8                      ;        B  = Flags, when set to 1 they instruct the resolver to:
    2890   00:4FF8                      ;             bit 0: Only abort the query currently in progress, if there is any
    2891   00:4FF8                      ;                    (other flags and registers are then ignored)
    2892   00:4FF8                      ;             bit 1: Assume that the passed name is an IP address,
    2893   00:4FF8                      ;                    and return an error if this is not true
    2894   00:4FF8                      ;             bit 2: If there is a query in progress already,
    2895   00:4FF8                      ;                    do NOT abort it and return an error instead
    2896   00:4FF8                      ;Output:  A = Error code
    2897   00:4FF8                      ;         B = 0 if a query to a DNS server is in progress
    2898   00:4FF8                      ;             1 if the name represented an IP address
    2899   00:4FF8                      ;             2 if the name could be resolved locally
    2900   00:4FF8                      ;         L.H.E.D = Resolved IP address
    2901   00:4FF8                      ;                   (only if no error occurred and B=1 or 2 is returned)
    2902   00:4FF8                      ;RAM Buffer to store names to be resolved (and used also to translate IPs from ASCII to 32bits number)
    2903   00:4FF8                      ;Will store the result of the last DNS query
    2904   00:4FF8                      TCPIP_DNS_Q:
    2905   00:4FF8  E5                      push    hl                      ; Save HL
    2906   00:4FF9  AF                      xor a
    2907   00:4FFA  5F                      ld  e,a
    2908   00:4FFB  57                      ld  d,a                         ; Zero DE
    2909   00:4FFC                      TCPIP_DNS_Q_SIZE_LOOP:
    2910   00:4FFC  7E                      ld  a,(hl)                      ; so let's check the size of dns data
    2911   00:4FFD  B7                      or  a                           ; it is zero terminated
    2912   00:4FFE  28 05                   jr  z,TCPIP_DNS_Q_SEND          ; if zero, end of string
    2913   00:5000  13                      inc de                          ; ok, not zero, one more char
    2914   00:5001  23                      inc hl                          ; next
    2915   00:5002  C3 FC 4F                jp  TCPIP_DNS_Q_SIZE_LOOP       ; jp is a tad bit faster and we are not worried about code size
    2916   00:5005                      TCPIP_DNS_Q_SEND:
    2917   00:5005                          ; Here we send the query and wait the result
    2918   00:5005  13                      inc de                          ; add 1, we will send flag first
    2919   00:5006  3E CE                   ld  a,206                       ; DNS_Q_NEW
    2920   00:5008                          SEND_DATA                       ; Send the command
    2920   00:5008  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2921   00:500B  7A                      ld  a,d
    2922   00:500C                          SEND_DATA                       ; Send the command size msb
    2922   00:500C  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2923   00:500F  7B                      ld  a,e
    2924   00:5010                          SEND_DATA                       ; Send the command size lsb
    2924   00:5010  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2925   00:5013  78                      ld  a,b
    2926   00:5014                          SEND_DATA                       ; Send the flag byte
    2926   00:5014  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2927   00:5017                      
    2928   00:5017                          if USE_MEM_IO = 0
    2929   00:5017                    ~     ; now otir of DNS/DNS BUFFER DATA SIZE
    2930   00:5017                    ~     ld  c,OUT_TX_PORT               ; our data TX port
    2931   00:5017                    ~     endif
    2932   00:5017  E1                      pop hl                          ; string to try to resolve
    2933   00:5018  1B                      dec de                          ; we are sending just data addressed by HL, so revert count
    2934   00:5019  7A                      ld  a,d
    2935   00:501A  B3                      or  e                           ; if de zero, no string, wrong parameters, but let the ESP answer
    2936   00:501B  CA 2D 50                jp  z,TCPIP_DNS_Q_WAIT_RSP
    2937   00:501E  AF                      xor a
    2938   00:501F                          ; Fast 16 bit variable size loop by GRAUW
    2939   00:501F  43                      ld  b,e
    2940   00:5020  1B                      dec de
    2941   00:5021  14                      inc d
    2942   00:5022                      TCPIP_DNS_Q_SENDLP:
    2943   00:5022                          ; send it
    2944   00:5022                          if USE_MEM_IO = 0
    2945   00:5022                    ~     outi
    2946   00:5022                    ~     jp  nz,TCPIP_DNS_Q_SENDLP
    2947   00:5022                    ~     else
    2948   00:5022  7E                      ld  a,(hl)
    2949   00:5023  32 07 7F                ld  (MEM_OUT_TX_PORT),a
    2950   00:5026  23                      inc hl
    2951   00:5027  10 F9                   djnz TCPIP_DNS_Q_SENDLP
    2952   00:5029                          endif
    2953   00:5029  15                      dec d
    2954   00:502A  C2 22 50                jp  nz,TCPIP_DNS_Q_SENDLP
    2955   00:502D                      TCPIP_DNS_Q_WAIT_RSP:
    2956   00:502D                          ; Now wait up to 900 ticks (15s@60Hz) to get response
    2957   00:502D  21 84 03                ld  hl,900
    2958   00:5030  CD 15 5A                call    SETCOUNTER
    2959   00:5033                      TCPIP_DNSQ_SEND_ST1:
    2960   00:5033                          CHECK_DATA
    2960   00:5033  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2960   00:5036  CB 47             >     bit 0,a
    2961   00:5038  20 05                   jr  nz,TCPIP_DNSQ_SEND_ST1.1
    2962   00:503A  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2963   00:503D  18 F4                   jr  TCPIP_DNSQ_SEND_ST1
    2964   00:503F                      TCPIP_DNSQ_SEND_ST1.1:
    2965   00:503F                          ; nz, check the data
    2966   00:503F                          RECEIVE_DATA
    2966   00:503F  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2967   00:5042  FE CE                   cp  206                         ; Is response of our command?
    2968   00:5044  20 ED                   jr  nz,TCPIP_DNSQ_SEND_ST1
    2969   00:5046                          ; now get return code, if return code other than 0, it is finished
    2970   00:5046                      TCPIP_DNSQ_SEND_RC:
    2971   00:5046                          CHECK_DATA
    2971   00:5046  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2971   00:5049  CB 47             >     bit 0,a
    2972   00:504B  20 05                   jr  nz,TCPIP_DNSQ_SEND_RC.1
    2973   00:504D  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2974   00:5050  18 F4                   jr  TCPIP_DNSQ_SEND_RC
    2975   00:5052                      TCPIP_DNSQ_SEND_RC.1:
    2976   00:5052                          ; nz, discard
    2977   00:5052                          RECEIVE_DATA
    2977   00:5052  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2978   00:5055  B7                      or  a                           ; 0?
    2979   00:5056  06 00                   ld  b,0                         ; say in progress as there is no failure status
    2980   00:5058  C0                      ret nz                          ; if not, done, ERROR won't return data
    2981   00:5059                      
    2982   00:5059                          ; next two bytes are return code and size bytes, don't care, it is 4, resolved IP
    2983   00:5059  06 02                   ld  b,2
    2984   00:505B                      TCPIP_DNSQ_SEND_RC_ST2:
    2985   00:505B                          CHECK_DATA
    2985   00:505B  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2985   00:505E  CB 47             >     bit 0,a
    2986   00:5060  20 05                   jr  nz,TCPIP_DNSQ_SEND_RC_ST2.1
    2987   00:5062  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    2988   00:5065  18 F4                   jr  TCPIP_DNSQ_SEND_RC_ST2
    2989   00:5067                      TCPIP_DNSQ_SEND_RC_ST2.1:
    2990   00:5067                          ; nz, discard
    2991   00:5067                          RECEIVE_DATA
    2991   00:5067  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2992   00:506A  05                      dec b
    2993   00:506B  20 EE                   jr  nz,TCPIP_DNSQ_SEND_RC_ST2
    2994   00:506D                      
    2995   00:506D                          ; now just get the 4 bytes IP and place it in L H E D
    2996   00:506D                      TCPIP_DNSQ_IP_ST1:
    2997   00:506D                          CHECK_DATA
    2997   00:506D  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2997   00:5070  CB 47             >     bit 0,a
    2998   00:5072  20 05                   jr  nz,TCPIP_DNSQ_IP_ST1.1
    2999   00:5074  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3000   00:5077  18 F4                   jr  TCPIP_DNSQ_IP_ST1
    3001   00:5079                      TCPIP_DNSQ_IP_ST1.1:
    3002   00:5079                          ; nz, get it
    3003   00:5079                          RECEIVE_DATA
    3003   00:5079  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3004   00:507C  6F                      ld  l,a
    3005   00:507D                      TCPIP_DNSQ_IP_ST2:
    3006   00:507D                          CHECK_DATA
    3006   00:507D  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3006   00:5080  CB 47             >     bit 0,a
    3007   00:5082  20 05                   jr  nz,TCPIP_DNSQ_IP_ST2.1
    3008   00:5084  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3009   00:5087  18 F4                   jr  TCPIP_DNSQ_IP_ST2
    3010   00:5089                      TCPIP_DNSQ_IP_ST2.1:
    3011   00:5089                          ; nz, get it
    3012   00:5089                          RECEIVE_DATA
    3012   00:5089  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3013   00:508C  67                      ld  h,a
    3014   00:508D                      TCPIP_DNSQ_IP_ST3:
    3015   00:508D                          CHECK_DATA
    3015   00:508D  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3015   00:5090  CB 47             >     bit 0,a
    3016   00:5092  20 05                   jr  nz,TCPIP_DNSQ_IP_ST3.1
    3017   00:5094  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3018   00:5097  18 F4                   jr  TCPIP_DNSQ_IP_ST3
    3019   00:5099                      TCPIP_DNSQ_IP_ST3.1:
    3020   00:5099                          ; nz, get it
    3021   00:5099                          RECEIVE_DATA
    3021   00:5099  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3022   00:509C  5F                      ld  e,a
    3023   00:509D                      TCPIP_DNSQ_IP_ST4:
    3024   00:509D                          CHECK_DATA
    3024   00:509D  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3024   00:50A0  CB 47             >     bit 0,a
    3025   00:50A2  20 05                   jr  nz,TCPIP_DNSQ_IP_ST4.1
    3026   00:50A4  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3027   00:50A7  18 F4                   jr  TCPIP_DNSQ_IP_ST4
    3028   00:50A9                      TCPIP_DNSQ_IP_ST4.1:
    3029   00:50A9                          ; nz, get it
    3030   00:50A9                          RECEIVE_DATA
    3030   00:50A9  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3031   00:50AC  57                      ld  d,a
    3032   00:50AD                          ; done
    3033   00:50AD  3E 01                   ld  a,1
    3034   00:50AF  CD 0C 5B                call    SETDNSREADY             ; DNS done
    3035   00:50B2  CD 36 5B                call    SETDNSRESULT            ; DNS RESULT
    3036   00:50B5  06 02                   ld  b,2
    3037   00:50B7  AF                      xor a
    3038   00:50B8  C9                      ret
    3039   00:50B9                      
    3040   00:50B9                      ;=====================
    3041   00:50B9                      ;===  TCPIP_DNS_S  ===
    3042   00:50B9                      ;=====================
    3043   00:50B9                      ;Obtains the host name resolution process state and result.
    3044   00:50B9                      ;
    3045   00:50B9                      ;Input:  A = 7
    3046   00:50B9                      ;        B = Flags, when set to 1 they instruct the resolver to:
    3047   00:50B9                      ;            bit 0: Clear any existing result or error condition after the execution
    3048   00:50B9                      ;                   (except if there is a query in progress)
    3049   00:50B9                      ;Output: A = Error code
    3050   00:50B9                      ;        B = DNS error code (when error is ERR_DNS)
    3051   00:50B9                      ;        B = Current query status (when error is ERR_OK):
    3052   00:50B9                      ;            0: There is no query in progress, nor any result nor error code available
    3053   00:50B9                      ;            1: There is a query in progress
    3054   00:50B9                      ;            2: Query is complete
    3055   00:50B9                      ;        C = Current query sub status (when error is ERR_OK and B=1):
    3056   00:50B9                      ;            0: Unknown
    3057   00:50B9                      ;            1: Querying the primary DNS server
    3058   00:50B9                      ;            2: Querying the secondary DNS server
    3059   00:50B9                      ;            3: Querying another DNS server
    3060   00:50B9                      ;        C = Resolution process type (when error is ERR_OK and B=2):
    3061   00:50B9                      ;            0: The name was obtained by querying a DNS server
    3062   00:50B9                      ;            1: The name was a direct representation of an IP address
    3063   00:50B9                      ;            2: The name was resolved locally
    3064   00:50B9                      ;       L.H.E.D = Resolved IP address (when error is ERR_OK and B=2)
    3065   00:50B9                      TCPIP_DNS_S:
    3066   00:50B9                          ;--- Is there a result?
    3067   00:50B9  CD FA 5A                call    GETDNSREADY             ; DNS done?
    3068   00:50BC  B7                      or  a
    3069   00:50BD  28 23                   jr  z,TCPIP_DNS_S_NORESULT      ; No DNS result
    3070   00:50BF                          ;--- Ok, we have a result, is it success?
    3071   00:50BF  3D                      dec a
    3072   00:50C0  28 12                   jr  z,TCPIP_DNS_S_HASRESULT     ; If it is 1, it was not an error
    3073   00:50C2                          ;--- Shoot, there is an error...
    3074   00:50C2                          ;--- And sure thing, ESP do not tell us details, it is always failure :-P
    3075   00:50C2  CB 40                   bit 0,b                         ;--- clear error after this?
    3076   00:50C4  28 09                   jr  z,TCP_IP_DNS_S_NOCLR
    3077   00:50C6                          ;--- Clear
    3078   00:50C6  06 00                   ld b,0                          ;--- Like I've said, no details
    3079   00:50C8  AF                      xor a
    3080   00:50C9  CD 0C 5B                call    SETDNSREADY             ; DNS not done
    3081   00:50CC  3E 08                   ld  a,ERR_DNS;
    3082   00:50CE  C9                      ret
    3083   00:50CF                      TCP_IP_DNS_S_NOCLR:
    3084   00:50CF                          ;--- Don't clear
    3085   00:50CF  3E 08                   ld  a,ERR_DNS
    3086   00:50D1  06 00                   ld  b,0                         ;--- Like I've said, no details
    3087   00:50D3  C9                      ret
    3088   00:50D4                          ;--- There is a result available...
    3089   00:50D4                      TCPIP_DNS_S_HASRESULT:
    3090   00:50D4                          ;--- Copy the result
    3091   00:50D4  CD 20 5B                call    GETDNSRESULT
    3092   00:50D7  AF                      xor a
    3093   00:50D8  CB 40                   bit 0,b                         ;--- clear result after this?
    3094   00:50DA  28 03                   jr  z,TCP_IP_DNS_S_RES_NOCLR    ;--- no, just return
    3095   00:50DC                          ;--- Yes, clear
    3096   00:50DC  CD 0C 5B                call    SETDNSREADY             ; DNS not done
    3097   00:50DF                      TCP_IP_DNS_S_RES_NOCLR:
    3098   00:50DF  06 02                   ld  b,2
    3099   00:50E1  C9                      ret
    3100   00:50E2                      
    3101   00:50E2                      TCPIP_DNS_S_NORESULT:
    3102   00:50E2  AF                      xor a                           ;--- OK no query in progress, no result, means nothing in progress
    3103   00:50E3  06 00                   ld  b,0                         ;--- No query in progress
    3104   00:50E5  C9                      ret
    3105   00:50E6                      
    3106   00:50E6                      ;========================
    3107   00:50E6                      ;===  TCPIP_UDP_OPEN  ===
    3108   00:50E6                      ;========================
    3109   00:50E6                      ;Open an UDP connection.
    3110   00:50E6                      ;
    3111   00:50E6                      ;Input:  A  = 8
    3112   00:50E6                      ;        HL = Local port number (#FFFF=random)
    3113   00:50E6                      ;        B  = Intended connection lifetime:
    3114   00:50E6                      ;             0: Transient
    3115   00:50E6                      ;             1: Resident
    3116   00:50E6                      ;Output: A = Error code
    3117   00:50E6                      ;        B = Connection number
    3118   00:50E6                      TCPIP_UDP_OPEN:
    3119   00:50E6                          SEND_DATA                       ; Send the command
    3119   00:50E6  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3120   00:50E9  AF                      xor a
    3121   00:50EA                          SEND_DATA                       ; Send the command size msb
    3121   00:50EA  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3122   00:50ED  3E 03                   ld  a,3
    3123   00:50EF                          SEND_DATA                       ; Send the command size lsb
    3123   00:50EF  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3124   00:50F2  7D                      ld  a,l
    3125   00:50F3                          SEND_DATA                       ; Send the port LSB
    3125   00:50F3  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3126   00:50F6  7C                      ld  a,h
    3127   00:50F7                          SEND_DATA                       ; Send the port MSB
    3127   00:50F7  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3128   00:50FA  78                      ld  a,b
    3129   00:50FB                          SEND_DATA                       ; Send the connection transient/resident
    3129   00:50FB  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3130   00:50FE                      
    3131   00:50FE                          ; Now wait up to 180 ticks to get response
    3132   00:50FE  21 B4 00                ld  hl,180
    3133   00:5101  CD 15 5A                call    SETCOUNTER
    3134   00:5104                      TCPIP_UDP_OPEN_ST1:
    3135   00:5104                          CHECK_DATA
    3135   00:5104  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3135   00:5107  CB 47             >     bit 0,a
    3136   00:5109  20 05                   jr  nz,TCPIP_UDP_OPEN_ST1.1
    3137   00:510B  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3138   00:510E  18 F4                   jr  TCPIP_UDP_OPEN_ST1
    3139   00:5110                      TCPIP_UDP_OPEN_ST1.1:
    3140   00:5110                          ; nz, check the data
    3141   00:5110                          RECEIVE_DATA
    3141   00:5110  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3142   00:5113  FE 08                   cp  8                           ; Is response of our command?
    3143   00:5115  20 ED                   jr  nz,TCPIP_UDP_OPEN_ST1
    3144   00:5117                          ; now get return code, if return code other than 0, it is finished
    3145   00:5117                      TCPIP_UDP_OPEN_RC:
    3146   00:5117                          CHECK_DATA
    3146   00:5117  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3146   00:511A  CB 47             >     bit 0,a
    3147   00:511C  20 05                   jr  nz,TCPIP_UDP_OPEN_RC.1
    3148   00:511E  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3149   00:5121  18 F4                   jr  TCPIP_UDP_OPEN_RC
    3150   00:5123                      TCPIP_UDP_OPEN_RC.1:
    3151   00:5123                          ; nz, discard
    3152   00:5123                          RECEIVE_DATA
    3152   00:5123  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3153   00:5126  B7                      or  a                           ; 0?
    3154   00:5127  C0                      ret nz                          ; if not, done
    3155   00:5128                      
    3156   00:5128                          ; next two bytes are return code and size bytes, don't care, it is 1, conn #
    3157   00:5128  06 02                   ld  b,2
    3158   00:512A                      TCPIP_UDP_OPEN_ST2:
    3159   00:512A                          CHECK_DATA
    3159   00:512A  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3159   00:512D  CB 47             >     bit 0,a
    3160   00:512F  20 05                   jr  nz,TCPIP_UDP_OPEN_ST2.1
    3161   00:5131  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3162   00:5134  18 F4                   jr  TCPIP_UDP_OPEN_ST2
    3163   00:5136                      TCPIP_UDP_OPEN_ST2.1:
    3164   00:5136                          ; nz, discard
    3165   00:5136                          RECEIVE_DATA
    3165   00:5136  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3166   00:5139  05                      dec b
    3167   00:513A  20 EE                   jr  nz,TCPIP_UDP_OPEN_ST2
    3168   00:513C                      
    3169   00:513C                          ; now just get the 1 byte, conn#, should go to B
    3170   00:513C                      TCPIP_UDP_OPEN_CONN_ST1:
    3171   00:513C                          CHECK_DATA
    3171   00:513C  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3171   00:513F  CB 47             >     bit 0,a
    3172   00:5141  20 05                   jr  nz,TCPIP_UDP_OPEN_CONN_ST1.1
    3173   00:5143  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3174   00:5146  18 F4                   jr  TCPIP_UDP_OPEN_CONN_ST1
    3175   00:5148                      TCPIP_UDP_OPEN_CONN_ST1.1:
    3176   00:5148                          ; nz, get it
    3177   00:5148                          RECEIVE_DATA
    3177   00:5148  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3178   00:514B  47                      ld  b,a
    3179   00:514C                          ; done
    3180   00:514C  AF                      xor a
    3181   00:514D  C9                      ret
    3182   00:514E                      
    3183   00:514E                      ;=========================
    3184   00:514E                      ;===  TCPIP_UDP_CLOSE  ===
    3185   00:514E                      ;=========================
    3186   00:514E                      ;Close a UDP connection.
    3187   00:514E                      ;
    3188   00:514E                      ;Input:  A = 9
    3189   00:514E                      ;        B = Connection number
    3190   00:514E                      ;            0 to close all open transient UDP connections
    3191   00:514E                      ;Output: A = Error code
    3192   00:514E                      TCPIP_UDP_CLOSE:
    3193   00:514E                          SEND_DATA                       ; Send the command
    3193   00:514E  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3194   00:5151  AF                      xor a
    3195   00:5152                          SEND_DATA                       ; Send the command size msb
    3195   00:5152  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3196   00:5155  3E 01                   ld  a,1
    3197   00:5157                          SEND_DATA                       ; Send the command size lsb
    3197   00:5157  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3198   00:515A  78                      ld  a,b
    3199   00:515B                          SEND_DATA                       ; Send the connection #
    3199   00:515B  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3200   00:515E                          ; Now wait up to 180 ticks to get response
    3201   00:515E  21 B4 00                ld  hl,180
    3202   00:5161  CD 15 5A                call    SETCOUNTER
    3203   00:5164                      TCPIP_UDP_CLOSE_ST1:
    3204   00:5164                          CHECK_DATA
    3204   00:5164  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3204   00:5167  CB 47             >     bit 0,a
    3205   00:5169  20 05                   jr  nz,TCPIP_UDP_CLOSE_ST1.1
    3206   00:516B  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3207   00:516E  18 F4                   jr  TCPIP_UDP_CLOSE_ST1
    3208   00:5170                      TCPIP_UDP_CLOSE_ST1.1:
    3209   00:5170                          ; nz, check the data
    3210   00:5170                          RECEIVE_DATA
    3210   00:5170  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3211   00:5173  FE 09                   cp  9                           ; Is response of our command?
    3212   00:5175  20 ED                   jr  nz,TCPIP_UDP_CLOSE_ST1
    3213   00:5177                          ; now get return code, if return code other than 0, it is finished
    3214   00:5177                      TCPIP_UDP_CLOSE_RC:
    3215   00:5177                          CHECK_DATA
    3215   00:5177  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3215   00:517A  CB 47             >     bit 0,a
    3216   00:517C  20 05                   jr  nz,TCPIP_UDP_CLOSE_RC.1
    3217   00:517E  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3218   00:5181  18 F4                   jr  TCPIP_UDP_CLOSE_RC
    3219   00:5183                      TCPIP_UDP_CLOSE_RC.1:
    3220   00:5183                          ; nz, discard
    3221   00:5183                          RECEIVE_DATA
    3221   00:5183  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3222   00:5186  B7                      or  a                           ; 0?
    3223   00:5187  C0                      ret nz                          ; if not, done
    3224   00:5188                      
    3225   00:5188                          ; next two bytes are return code and size bytes, don't care, it is 1, conn #
    3226   00:5188  06 02                   ld  b,2
    3227   00:518A                      TCPIP_UDP_CLOSE_ST2:
    3228   00:518A                          CHECK_DATA
    3228   00:518A  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3228   00:518D  CB 47             >     bit 0,a
    3229   00:518F  20 05                   jr  nz,TCPIP_UDP_CLOSE_ST2.1
    3230   00:5191  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3231   00:5194  18 F4                   jr  TCPIP_UDP_CLOSE_ST2
    3232   00:5196                      TCPIP_UDP_CLOSE_ST2.1:
    3233   00:5196                          ; nz, discard
    3234   00:5196                          RECEIVE_DATA
    3234   00:5196  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3235   00:5199  05                      dec b
    3236   00:519A  20 EE                   jr  nz,TCPIP_UDP_CLOSE_ST2
    3237   00:519C                      
    3238   00:519C                          ; done, no return data other than return code
    3239   00:519C  AF                      xor a
    3240   00:519D  C9                      ret
    3241   00:519E                      
    3242   00:519E                      ;=========================
    3243   00:519E                      ;===  TCPIP_UDP_STATE  ===
    3244   00:519E                      ;=========================
    3245   00:519E                      ;Get the state of a UDP connection.
    3246   00:519E                      ;
    3247   00:519E                      ;Input:  A = 10
    3248   00:519E                      ;        B = Connection number
    3249   00:519E                      ;Output: A  = Error code
    3250   00:519E                      ;        HL = Local port number
    3251   00:519E                      ;        B  = Number of pending incoming datagrams
    3252   00:519E                      ;        DE = Size of oldest pending incoming datagram (data part only)
    3253   00:519E                      TCPIP_UDP_STATE:
    3254   00:519E                          SEND_DATA                       ; Send the command
    3254   00:519E  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3255   00:51A1  AF                      xor a
    3256   00:51A2                          SEND_DATA                       ; Send the command size msb
    3256   00:51A2  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3257   00:51A5  3C                      inc a
    3258   00:51A6                          SEND_DATA                       ; Send the command size lsb
    3258   00:51A6  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3259   00:51A9  78                      ld  a,b
    3260   00:51AA                          SEND_DATA                       ; Send the parameter
    3260   00:51AA  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3261   00:51AD                      
    3262   00:51AD                          ; Now wait up to 60 ticks to get response
    3263   00:51AD  21 3C 00                ld  hl,60
    3264   00:51B0  CD 15 5A                call    SETCOUNTER
    3265   00:51B3                      TCPIP_UDP_STATE_ST1:
    3266   00:51B3                          CHECK_DATA
    3266   00:51B3  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3266   00:51B6  CB 47             >     bit 0,a
    3267   00:51B8  20 05                   jr  nz,TCPIP_UDP_STATE_ST1.1
    3268   00:51BA  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3269   00:51BD  18 F4                   jr  TCPIP_UDP_STATE_ST1
    3270   00:51BF                      TCPIP_UDP_STATE_ST1.1:
    3271   00:51BF                          ; nz, check the data
    3272   00:51BF                          RECEIVE_DATA
    3272   00:51BF  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3273   00:51C2  FE 0A                   cp  10                          ; Is response of our command?
    3274   00:51C4  20 ED                   jr  nz,TCPIP_UDP_STATE_ST1
    3275   00:51C6                          ; now get return code, if return code other than 0, it is finished
    3276   00:51C6                      TCPIP_UDP_STATE_RC:
    3277   00:51C6                          CHECK_DATA
    3277   00:51C6  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3277   00:51C9  CB 47             >     bit 0,a
    3278   00:51CB  20 05                   jr  nz,TCPIP_UDP_STATE_RC.1
    3279   00:51CD  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3280   00:51D0  18 F4                   jr  TCPIP_UDP_STATE_RC
    3281   00:51D2                      TCPIP_UDP_STATE_RC.1:
    3282   00:51D2                          ; nz, discard
    3283   00:51D2                          RECEIVE_DATA
    3283   00:51D2  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3284   00:51D5  B7                      or  a                           ; 0?
    3285   00:51D6  C0                      ret nz                          ; if not, done
    3286   00:51D7                      
    3287   00:51D7                          ; next two bytes are return code and size bytes, don't care, it is 5
    3288   00:51D7  06 02                   ld  b,2
    3289   00:51D9                      TCPIP_UDP_STATE_ST2:
    3290   00:51D9                          CHECK_DATA
    3290   00:51D9  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3290   00:51DC  CB 47             >     bit 0,a
    3291   00:51DE  20 05                   jr  nz,TCPIP_UDP_STATE_ST2.1
    3292   00:51E0  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3293   00:51E3  18 F4                   jr  TCPIP_UDP_STATE_ST2
    3294   00:51E5                      TCPIP_UDP_STATE_ST2.1:
    3295   00:51E5                          ; nz, discard
    3296   00:51E5                          RECEIVE_DATA
    3296   00:51E5  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3297   00:51E8  05                      dec b
    3298   00:51E9  20 EE                   jr  nz,TCPIP_UDP_STATE_ST2
    3299   00:51EB                      
    3300   00:51EB                          ; now just get the 5 bytes (Port LSB then MSB, # of packets, packet size LSB then MSB) and order it in L, H, B, E and D
    3301   00:51EB                      TCPIP_UDP_STATE_RESP_ST1:
    3302   00:51EB                          CHECK_DATA
    3302   00:51EB  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3302   00:51EE  CB 47             >     bit 0,a
    3303   00:51F0  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST1.1
    3304   00:51F2  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3305   00:51F5  18 F4                   jr  TCPIP_UDP_STATE_RESP_ST1
    3306   00:51F7                      TCPIP_UDP_STATE_RESP_ST1.1:
    3307   00:51F7                          ; nz, get it
    3308   00:51F7                          RECEIVE_DATA
    3308   00:51F7  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3309   00:51FA  6F                      ld  l,a
    3310   00:51FB                      TCPIP_UDP_STATE_RESP_ST2:
    3311   00:51FB                          CHECK_DATA
    3311   00:51FB  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3311   00:51FE  CB 47             >     bit 0,a
    3312   00:5200  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST2.1
    3313   00:5202  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3314   00:5205  18 F4                   jr  TCPIP_UDP_STATE_RESP_ST2
    3315   00:5207                      TCPIP_UDP_STATE_RESP_ST2.1:
    3316   00:5207                          ; nz, get it
    3317   00:5207                          RECEIVE_DATA
    3317   00:5207  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3318   00:520A  67                      ld  h,a
    3319   00:520B                      TCPIP_UDP_STATE_RESP_ST3:
    3320   00:520B                          CHECK_DATA
    3320   00:520B  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3320   00:520E  CB 47             >     bit 0,a
    3321   00:5210  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST3.1
    3322   00:5212  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3323   00:5215  18 F4                   jr  TCPIP_UDP_STATE_RESP_ST3
    3324   00:5217                      TCPIP_UDP_STATE_RESP_ST3.1:
    3325   00:5217                          ; nz, get it
    3326   00:5217                          RECEIVE_DATA
    3326   00:5217  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3327   00:521A  47                      ld  b,a
    3328   00:521B                      TCPIP_UDP_STATE_RESP_ST4:
    3329   00:521B                          CHECK_DATA
    3329   00:521B  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3329   00:521E  CB 47             >     bit 0,a
    3330   00:5220  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST4.1
    3331   00:5222  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3332   00:5225  18 F4                   jr  TCPIP_UDP_STATE_RESP_ST4
    3333   00:5227                      TCPIP_UDP_STATE_RESP_ST4.1:
    3334   00:5227                          ; nz, get it
    3335   00:5227                          RECEIVE_DATA
    3335   00:5227  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3336   00:522A  5F                      ld  e,a
    3337   00:522B                      TCPIP_UDP_STATE_RESP_ST5:
    3338   00:522B                          CHECK_DATA
    3338   00:522B  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3338   00:522E  CB 47             >     bit 0,a
    3339   00:5230  20 05                   jr  nz,TCPIP_UDP_STATE_RESP_ST5.1
    3340   00:5232  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3341   00:5235  18 F4                   jr  TCPIP_UDP_STATE_RESP_ST5
    3342   00:5237                      TCPIP_UDP_STATE_RESP_ST5.1:
    3343   00:5237                          ; nz, get it
    3344   00:5237                          RECEIVE_DATA
    3344   00:5237  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3345   00:523A  57                      ld  d,a
    3346   00:523B                          ; done
    3347   00:523B  AF                      xor a
    3348   00:523C  C9                      ret
    3349   00:523D                      
    3350   00:523D                      ;========================
    3351   00:523D                      ;===  TCPIP_UDP_SEND  ===
    3352   00:523D                      ;========================
    3353   00:523D                      ;Send an UDP datagram.
    3354   00:523D                      ;
    3355   00:523D                      ;Input:  A = 11
    3356   00:523D                      ;        B = Connection number
    3357   00:523D                      ;        HL = Address of datagram data
    3358   00:523D                      ;        DE = Address of parameters block
    3359   00:523D                      ;Output: A = Error code
    3360   00:523D                      ;
    3361   00:523D                      ;Parameters block:
    3362   00:523D                      ;
    3363   00:523D                      ;    +0 (4): Destination IP address
    3364   00:523D                      ;    +4 (2): Destination port
    3365   00:523D                      ;    +6 (2): Data length
    3366   00:523D                      TCPIP_UDP_SEND:
    3367   00:523D  E5                      push    hl
    3368   00:523E  D5                      push    de
    3369   00:523F                          SEND_DATA                       ; Send the command
    3369   00:523F  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3370   00:5242                          ; prepare new data size, adding our 7 bytes overhead
    3371   00:5242  DD 62                   ld  ixh,d
    3372   00:5244  DD 6B                   ld  ixl,e
    3373   00:5246  11 07 00                ld  de,7
    3374   00:5249  DD 6E 06                ld  l,(ix+6)
    3375   00:524C  DD 66 07                ld  h,(ix+7)
    3376   00:524F  19                      add hl,de
    3377   00:5250  7C                      ld  a,h
    3378   00:5251                          SEND_DATA                       ; Send the command size msb
    3378   00:5251  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3379   00:5254  7D                      ld  a,l
    3380   00:5255                          SEND_DATA                       ; Send the command size lsb
    3380   00:5255  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3381   00:5258  78                      ld  a,b
    3382   00:5259                          SEND_DATA                       ; Send the connection #
    3382   00:5259  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3383   00:525C  D1                      pop de
    3384   00:525D  E1                      pop hl
    3385   00:525E  1A                      ld  a,(de)
    3386   00:525F                          SEND_DATA                       ; Send IP byte 1
    3386   00:525F  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3387   00:5262  13                      inc de
    3388   00:5263  1A                      ld  a,(de)
    3389   00:5264                          SEND_DATA                       ; Send IP byte 2
    3389   00:5264  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3390   00:5267  13                      inc de
    3391   00:5268  1A                      ld  a,(de)
    3392   00:5269                          SEND_DATA                       ; Send IP byte 3
    3392   00:5269  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3393   00:526C  13                      inc de
    3394   00:526D  1A                      ld  a,(de)
    3395   00:526E                          SEND_DATA                       ; Send IP byte 4
    3395   00:526E  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3396   00:5271  13                      inc de
    3397   00:5272  1A                      ld  a,(de)
    3398   00:5273                          SEND_DATA                       ; Send Port LSB
    3398   00:5273  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3399   00:5276  13                      inc de
    3400   00:5277  1A                      ld  a,(de)
    3401   00:5278                          SEND_DATA                       ; Send Port MSB
    3401   00:5278  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3402   00:527B                          ; now oti the data starting at hl, size is in next DE position
    3403   00:527B  13                      inc de
    3404   00:527C  1A                      ld  a,(de)
    3405   00:527D  47                      ld  b,a                         ; save lsb in b
    3406   00:527E  13                      inc de
    3407   00:527F  1A                      ld  a,(de)                      ; msb
    3408   00:5280  57                      ld  d,a                         ; put in D, there is no ld d,(de)
    3409   00:5281  58                      ld  e,b                         ; lsb
    3410   00:5282                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use outi :-D
    3411   00:5282                          ;ld b,e                         ; Number of loops originaly in DE, not needed, b already has e
    3412   00:5282  1B                      dec de
    3413   00:5283  14                      inc d
    3414   00:5284                          if USE_MEM_IO = 0
    3415   00:5284                    ~     ld  c,OUT_TX_PORT
    3416   00:5284                    ~ TCPIP_UDP_SEND_R:
    3417   00:5284                    ~     otir                            ; Send until B is 0
    3418   00:5284                    ~     else
    3419   00:5284                      TCPIP_UDP_SEND_R:
    3420   00:5284  7E                      ld  a,(hl)
    3421   00:5285  32 07 7F                ld  (MEM_OUT_TX_PORT),a
    3422   00:5288  23                      inc hl
    3423   00:5289  10 F9                   djnz TCPIP_UDP_SEND_R
    3424   00:528B                          endif
    3425   00:528B  15                      dec d                           ; decrement secondary counter
    3426   00:528C  20 F6                   jr  nz,TCPIP_UDP_SEND_R         ; If still have another round, do it
    3427   00:528E                          ; Now wait up to 600 ticks to get response
    3428   00:528E  21 58 02                ld  hl,600
    3429   00:5291  CD 15 5A                call    SETCOUNTER
    3430   00:5294                      TCPIP_UDP_SEND_ST1:
    3431   00:5294                          CHECK_DATA
    3431   00:5294  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3431   00:5297  CB 47             >     bit 0,a
    3432   00:5299  20 05                   jr  nz,TCPIP_UDP_SEND_ST1.1
    3433   00:529B  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3434   00:529E  18 F4                   jr  TCPIP_UDP_SEND_ST1
    3435   00:52A0                      TCPIP_UDP_SEND_ST1.1:
    3436   00:52A0                          ; nz, check the data
    3437   00:52A0                          RECEIVE_DATA
    3437   00:52A0  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3438   00:52A3  FE 0B                   cp  11                          ; Is response of our command?
    3439   00:52A5  20 ED                   jr  nz,TCPIP_UDP_SEND_ST1
    3440   00:52A7                          ; now get return code, if return code other than 0, it is finished
    3441   00:52A7                      TCPIP_UDP_SEND_RC:
    3442   00:52A7                          CHECK_DATA
    3442   00:52A7  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3442   00:52AA  CB 47             >     bit 0,a
    3443   00:52AC  20 05                   jr  nz,TCPIP_UDP_SEND_RC.1
    3444   00:52AE  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3445   00:52B1  18 F4                   jr  TCPIP_UDP_SEND_RC
    3446   00:52B3                      TCPIP_UDP_SEND_RC.1:
    3447   00:52B3                          ; nz, discard
    3448   00:52B3                          RECEIVE_DATA
    3448   00:52B3  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3449   00:52B6  B7                      or  a                           ; 0?
    3450   00:52B7  C0                      ret nz                          ; if not, done
    3451   00:52B8                      
    3452   00:52B8                          ; next two bytes are return code and size bytes, don't care, it is 0
    3453   00:52B8  06 02                   ld  b,2
    3454   00:52BA                      TCPIP_UDP_SEND_ST2:
    3455   00:52BA                          CHECK_DATA
    3455   00:52BA  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3455   00:52BD  CB 47             >     bit 0,a
    3456   00:52BF  20 05                   jr  nz,TCPIP_UDP_SEND_ST2.1
    3457   00:52C1  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3458   00:52C4  18 F4                   jr  TCPIP_UDP_SEND_ST2
    3459   00:52C6                      TCPIP_UDP_SEND_ST2.1:
    3460   00:52C6                          ; nz, discard
    3461   00:52C6                          RECEIVE_DATA
    3461   00:52C6  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3462   00:52C9  05                      dec b
    3463   00:52CA  20 EE                   jr  nz,TCPIP_UDP_SEND_ST2
    3464   00:52CC                      
    3465   00:52CC                          ; done, no return data other than return code
    3466   00:52CC  AF                      xor a
    3467   00:52CD  C9                      ret
    3468   00:52CE                      
    3469   00:52CE                      ;=======================
    3470   00:52CE                      ;===  TCPIP_UDP_RCV  ===
    3471   00:52CE                      ;=======================
    3472   00:52CE                      ;Retrieve an incoming UDP datagram.
    3473   00:52CE                      ;
    3474   00:52CE                      ;Input:  A = 12
    3475   00:52CE                      ;        B = Connection number
    3476   00:52CE                      ;        HL = Address for datagram data
    3477   00:52CE                      ;        DE = Maximum data size to retrieve
    3478   00:52CE                      ;Output: A = Error code
    3479   00:52CE                      ;        L.H.E.D = Source IP address
    3480   00:52CE                      ;        IX = Source port
    3481   00:52CE                      ;        BC = Actual received data size
    3482   00:52CE                      
    3483   00:52CE                      ; Customized TIME OUT routine: If time out receiving data, retry as received data
    3484   00:52CE                      ; won't be re-sent as host is unaware of this
    3485   00:52CE                      TCPIP_UDP_RCV_CHECK_TIME_OUT:
    3486   00:52CE                          ; Save registers other than AF
    3487   00:52CE  C5                      push bc
    3488   00:52CF  D5                      push de
    3489   00:52D0  E5                      push hl
    3490   00:52D1  CD 06 5A                call    GETCOUNTER
    3491   00:52D4  7D                      ld  a,l
    3492   00:52D5  B4                      or  h
    3493   00:52D6                          ; Restore registers, we are returning
    3494   00:52D6  E1                      pop hl
    3495   00:52D7  D1                      pop de
    3496   00:52D8  C1                      pop bc
    3497   00:52D9  C0                      ret nz
    3498   00:52DA                          ; Ok, timeout...
    3499   00:52DA  F1                      pop af                          ; Get return address of who called this out of the stack, we will return from the function or re-start
    3500   00:52DB                      TCPIP_TCP_UDP_RETRY_QRCV:
    3501   00:52DB  CD 25 5A                call    GETBYTE
    3502   00:52DE  B7                      or  a
    3503   00:52DF  28 0C                   jr  z,TCPIP_UDP_RCV_CHECK_TIME_OUT.NORXRETRY
    3504   00:52E1                          ; Ok, so let's ask ESP to re-send the data and retry receiving it
    3505   00:52E1  3D                      dec a
    3506   00:52E2  CD 37 5A                call    SETBYTE                 ; we are retrying it
    3507   00:52E5  3E 72                   ld  a,'r'                       ; retry transmission command
    3508   00:52E7                          SEND_DATA
    3508   00:52E7  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3509   00:52EA  C3 12 53                jp  TCPIP_UDP_RCV.RXRETRY       ; and retry it
    3510   00:52ED                      TCPIP_UDP_RCV_CHECK_TIME_OUT.NORXRETRY:
    3511   00:52ED  3E 0F                   ld  a,ERR_INV_OPER
    3512   00:52EF  C9                      ret                             ; and return the function itself
    3513   00:52F0                      
    3514   00:52F0                      TCPIP_UDP_RCV:
    3515   00:52F0  CD 5E 5A                call    SETWORD                 ; Save for later the datagram address
    3516   00:52F3  3E 0C                   ld  a,12
    3517   00:52F5                          SEND_DATA                       ; Send the command
    3517   00:52F5  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3518   00:52F8  AF                      xor a
    3519   00:52F9                          SEND_DATA                       ; Send the command size msb
    3519   00:52F9  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3520   00:52FC  3E 03                   ld  a,3
    3521   00:52FE                          SEND_DATA                       ; Send the command size lsb
    3521   00:52FE  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3522   00:5301  78                      ld  a,b
    3523   00:5302                          SEND_DATA                       ; Send the connection #
    3523   00:5302  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3524   00:5305  7B                      ld  a,e
    3525   00:5306                          SEND_DATA                       ; Send MAX rcv size LSB
    3525   00:5306  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3526   00:5309  7A                      ld  a,d
    3527   00:530A                          SEND_DATA                       ; Send MAX rcv size MSB
    3527   00:530A  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3528   00:530D  3E 03                   ld  a,3
    3529   00:530F  CD 37 5A                call    SETBYTE                 ; Ok, retry up to three times
    3530   00:5312                      TCPIP_UDP_RCV.RXRETRY:
    3531   00:5312                          ; Now wait up to 600 ticks to get response
    3532   00:5312  21 58 02                ld  hl,600
    3533   00:5315  CD 15 5A                call    SETCOUNTER
    3534   00:5318                      TCPIP_UDP_RCV_ST1:
    3535   00:5318                          CHECK_DATA
    3535   00:5318  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3535   00:531B  CB 47             >     bit 0,a
    3536   00:531D  20 05                   jr  nz,TCPIP_UDP_RCV_ST1.1
    3537   00:531F  CD CE 52                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3538   00:5322  18 F4                   jr  TCPIP_UDP_RCV_ST1
    3539   00:5324                      TCPIP_UDP_RCV_ST1.1:
    3540   00:5324                          ; nz, check the data
    3541   00:5324                          RECEIVE_DATA
    3541   00:5324  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3542   00:5327  FE 0C                   cp  12                          ; Is response of our command?
    3543   00:5329  20 ED                   jr  nz,TCPIP_UDP_RCV_ST1
    3544   00:532B                          ; At this point, all data is being buffered, so 30 ticks, half second, is more than enough time-out
    3545   00:532B  F3                      di
    3546   00:532C  21 1E 00                ld  hl,30
    3547   00:532F  CD 15 5A                call    SETCOUNTER
    3548   00:5332  FB                      ei
    3549   00:5333                          ; now get return code, if return code other than 0, it is finished
    3550   00:5333                      TCPIP_UDP_RCV_RC:
    3551   00:5333                          CHECK_DATA
    3551   00:5333  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3551   00:5336  CB 47             >     bit 0,a
    3552   00:5338  20 05                   jr  nz,TCPIP_UDP_RCV_RC.1
    3553   00:533A  CD CE 52                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3554   00:533D  18 F4                   jr  TCPIP_UDP_RCV_RC
    3555   00:533F                      TCPIP_UDP_RCV_RC.1:
    3556   00:533F                          ; nz, discard
    3557   00:533F                          RECEIVE_DATA
    3557   00:533F  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3558   00:5342  B7                      or  a                           ; 0?
    3559   00:5343  C0                      ret nz                          ; if not, done
    3560   00:5344                          ; next two bytes are return code and size bytes, save it to BC
    3561   00:5344                      TCPIP_UDP_RCV_ST2A:
    3562   00:5344                          CHECK_DATA
    3562   00:5344  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3562   00:5347  CB 47             >     bit 0,a
    3563   00:5349  20 05                   jr  nz,TCPIP_UDP_RCV_ST2A.1
    3564   00:534B  CD CE 52                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3565   00:534E  18 F4                   jr  TCPIP_UDP_RCV_ST2A
    3566   00:5350                      TCPIP_UDP_RCV_ST2A.1:
    3567   00:5350                          ; nz, discard
    3568   00:5350                          RECEIVE_DATA
    3568   00:5350  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3569   00:5353  67                      ld  h,a
    3570   00:5354                      TCPIP_UDP_RCV_ST2B:
    3571   00:5354                          CHECK_DATA
    3571   00:5354  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3571   00:5357  CB 47             >     bit 0,a
    3572   00:5359  20 05                   jr  nz,TCPIP_UDP_RCV_ST2B.1
    3573   00:535B  CD CE 52                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3574   00:535E  18 F4                   jr  TCPIP_UDP_RCV_ST2B
    3575   00:5360                      TCPIP_UDP_RCV_ST2B.1:
    3576   00:5360                          ; nz, discard
    3577   00:5360                          RECEIVE_DATA
    3577   00:5360  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3578   00:5363  6F                      ld  l,a
    3579   00:5364  01 06 00                ld  bc,6
    3580   00:5367                          ; subtract 6 (IP and PORT)
    3581   00:5367  AF                      xor a                           ; zero carry
    3582   00:5368  ED 42                   sbc hl,bc
    3583   00:536A  4D                      ld  c,l
    3584   00:536B  44                      ld  b,h                         ; BC has effective received data size
    3585   00:536C                          ; now just get the 4 bytes IP and place it in L H E D
    3586   00:536C                      TCPIP_UDP_RCV_IP_ST1:
    3587   00:536C                          CHECK_DATA
    3587   00:536C  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3587   00:536F  CB 47             >     bit 0,a
    3588   00:5371  20 05                   jr  nz,TCPIP_UDP_RCV_IP_ST1.1
    3589   00:5373  CD CE 52                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3590   00:5376  18 F4                   jr  TCPIP_UDP_RCV_IP_ST1
    3591   00:5378                      TCPIP_UDP_RCV_IP_ST1.1:
    3592   00:5378                          ; nz, get it
    3593   00:5378                          RECEIVE_DATA
    3593   00:5378  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3594   00:537B  6F                      ld  l,a
    3595   00:537C                      TCPIP_UDP_RCV_IP_ST2:
    3596   00:537C                          CHECK_DATA
    3596   00:537C  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3596   00:537F  CB 47             >     bit 0,a
    3597   00:5381  20 05                   jr  nz,TCPIP_UDP_RCV_IP_ST2.1
    3598   00:5383  CD CE 52                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3599   00:5386  18 F4                   jr  TCPIP_UDP_RCV_IP_ST2
    3600   00:5388                      TCPIP_UDP_RCV_IP_ST2.1:
    3601   00:5388                          ; nz, get it
    3602   00:5388                          RECEIVE_DATA
    3602   00:5388  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3603   00:538B  67                      ld  h,a
    3604   00:538C                      TCPIP_UDP_RCV_IP_ST3:
    3605   00:538C                          CHECK_DATA
    3605   00:538C  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3605   00:538F  CB 47             >     bit 0,a
    3606   00:5391  20 05                   jr  nz,TCPIP_UDP_RCV_IP_ST3.1
    3607   00:5393  CD CE 52                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3608   00:5396  18 F4                   jr  TCPIP_UDP_RCV_IP_ST3
    3609   00:5398                      TCPIP_UDP_RCV_IP_ST3.1:
    3610   00:5398                          ; nz, get it
    3611   00:5398                          RECEIVE_DATA
    3611   00:5398  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3612   00:539B  5F                      ld  e,a
    3613   00:539C                      TCPIP_UDP_RCV_IP_ST4:
    3614   00:539C                          CHECK_DATA
    3614   00:539C  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3614   00:539F  CB 47             >     bit 0,a
    3615   00:53A1  20 05                   jr  nz,TCPIP_UDP_RCV_IP_ST4.1
    3616   00:53A3  CD CE 52                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3617   00:53A6  18 F4                   jr  TCPIP_UDP_RCV_IP_ST4
    3618   00:53A8                      TCPIP_UDP_RCV_IP_ST4.1:
    3619   00:53A8                          ; nz, get it
    3620   00:53A8                          RECEIVE_DATA
    3620   00:53A8  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3621   00:53AB  57                      ld  d,a
    3622   00:53AC                          ; now get the 2 bytes port and place in IXL and IXH
    3623   00:53AC                      TCPIP_UDP_RCV_PORT_ST1:
    3624   00:53AC                          CHECK_DATA
    3624   00:53AC  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3624   00:53AF  CB 47             >     bit 0,a
    3625   00:53B1  20 05                   jr  nz,TCPIP_UDP_RCV_PORT_ST1.1
    3626   00:53B3  CD CE 52                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3627   00:53B6  18 F4                   jr  TCPIP_UDP_RCV_PORT_ST1
    3628   00:53B8                      TCPIP_UDP_RCV_PORT_ST1.1:
    3629   00:53B8                          ; nz, get it
    3630   00:53B8                          RECEIVE_DATA
    3630   00:53B8  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3631   00:53BB  DD 6F                   ld  ixl,a
    3632   00:53BD                      TCPIP_UDP_RCV_PORT_ST2:
    3633   00:53BD                          CHECK_DATA
    3633   00:53BD  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3633   00:53C0  CB 47             >     bit 0,a
    3634   00:53C2  20 05                   jr  nz,TCPIP_UDP_RCV_PORT_ST2.1
    3635   00:53C4  CD CE 52                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3636   00:53C7  18 F4                   jr  TCPIP_UDP_RCV_PORT_ST2
    3637   00:53C9                      TCPIP_UDP_RCV_PORT_ST2.1:
    3638   00:53C9                          ; nz, get it
    3639   00:53C9                          RECEIVE_DATA
    3639   00:53C9  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3640   00:53CC  DD 67                   ld  ixh,a
    3641   00:53CE                      
    3642   00:53CE                          ; save the received data in memory
    3643   00:53CE  CD 8A 5A                call    REGBACKUP               ; Save the data received so far, registers will change
    3644   00:53D1                          ; will start moving at RCV_ADDRESS that was stored in our WORD
    3645   00:53D1  CD 4B 5A                call    GETWORD
    3646   00:53D4                          ; size goes to DE
    3647   00:53D4  50                      ld  d,b
    3648   00:53D5  59                      ld  e,c
    3649   00:53D6                          ; Grauw Optimized 16 bit loop, handy for us, mostly since we can use ini :-D
    3650   00:53D6  43                      ld  b,e                         ; Number of loops originaly in DE
    3651   00:53D7  1B                      dec de
    3652   00:53D8  14                      inc d
    3653   00:53D9                          if USE_MEM_IO = 0
    3654   00:53D9                    ~     ld  c,IN_DATA_PORT
    3655   00:53D9                    ~     endif
    3656   00:53D9                          CHECK_QUICK_RECEIVE
    3656   00:53D9  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3656   00:53DC  CB 5F             >     bit 3,a
    3657   00:53DE  28 17                   jr  z,TCPIP_UDP_RCV_R_NSF       ; If not, go to the old, slower route
    3658   00:53E0                          ; Otherwise, let's speed it up baby!
    3659   00:53E0                      TCPIP_UDP_RCV_R:
    3660   00:53E0                          if USE_MEM_IO = 0
    3661   00:53E0                    ~     inir
    3662   00:53E0                    ~     else
    3663   00:53E0  3A 06 7F                ld  a,(MEM_IN_DATA_PORT)
    3664   00:53E3  77                      ld  (hl),a
    3665   00:53E4  23                      inc hl
    3666   00:53E5  10 F9                   djnz TCPIP_UDP_RCV_R
    3667   00:53E7                          endif
    3668   00:53E7  15                      dec d
    3669   00:53E8  20 F6                   jr  nz,TCPIP_UDP_RCV_R
    3670   00:53EA                          CHECK_BUFFER_UNDERRUN
    3670   00:53EA  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3670   00:53ED  CB 67             >     bit 4,a
    3671   00:53EF  C2 DB 52                jp  nz,TCPIP_TCP_UDP_RETRY_QRCV ; If yes, retry
    3672   00:53F2                          ; Otherwise, done
    3673   00:53F2                          ; done, restore return data in DE BC and HL
    3674   00:53F2  CD 73 5A                call    REGRESTORE
    3675   00:53F5  AF                      xor a
    3676   00:53F6  C9                      ret
    3677   00:53F7                          ; Slower route if Interface doesn't implement quick receive
    3678   00:53F7                      TCPIP_UDP_RCV_R_NSF:
    3679   00:53F7                          CHECK_DATA
    3679   00:53F7  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3679   00:53FA  CB 47             >     bit 0,a
    3680   00:53FC  20 05                   jr  nz,TCPIP_UDP_RCV_R_NSF.1
    3681   00:53FE  CD CE 52                call    TCPIP_UDP_RCV_CHECK_TIME_OUT
    3682   00:5401  18 F4                   jr  TCPIP_UDP_RCV_R_NSF
    3683   00:5403                      TCPIP_UDP_RCV_R_NSF.1:
    3684   00:5403                          if USE_MEM_IO = 0
    3685   00:5403                    ~     ini
    3686   00:5403                    ~     else
    3687   00:5403  3A 06 7F                ld  a,(MEM_IN_DATA_PORT)
    3688   00:5406  77                      ld  (hl),a
    3689   00:5407  23                      inc hl
    3690   00:5408  05                      dec b
    3691   00:5409                          endif
    3692   00:5409  20 EC                   jr  nz,TCPIP_UDP_RCV_R_NSF          ; We do not use INIR because we don't know if there is more data, avoiding geting a junk 0xFF
    3693   00:540B  15                      dec d
    3694   00:540C  20 E9                   jr  nz,TCPIP_UDP_RCV_R_NSF
    3695   00:540E                          ; done, restore return data in DE BC and HL
    3696   00:540E  CD 73 5A                call    REGRESTORE
    3697   00:5411  AF                      xor a
    3698   00:5412  C9                      ret
    3699   00:5413                      
    3700   00:5413                      ;========================
    3701   00:5413                      ;===  TCPIP_TCP_OPEN  ===
    3702   00:5413                      ;========================
    3703   00:5413                      ;Open a TCP connection.
    3704   00:5413                      ;
    3705   00:5413                      ;Input:  A  = 13
    3706   00:5413                      ;        HL = Address of parameters block
    3707   00:5413                      ;Output: A = Error code
    3708   00:5413                      ;        B = Connection number
    3709   00:5413                      ;        C = Connection not open reason (mostly for TLS)
    3710   00:5413                      ;
    3711   00:5413                      ;Parameters block format:
    3712   00:5413                      ;
    3713   00:5413                      ;+0 (4): Remote IP address (0.0.0.0 for unspecified remote socket)
    3714   00:5413                      ;+4 (2): Remote port (ignored if unspecified remote socket)
    3715   00:5413                      ;+6 (2): Local port, 0FFFFh for a random value
    3716   00:5413                      ;+8 (2): Suggestion for user timeout value
    3717   00:5413                      ;+10 (1): Flags:
    3718   00:5413                      ;         bit 0: Set for passive connection
    3719   00:5413                      ;         bit 1: Set for resident connection
    3720   00:5413                      ;         bit 2: Set for TLS connection
    3721   00:5413                      ;         bit 3: Set for TLS connection validating host certificate
    3722   00:5413                      ;+11 (2): If 0000 no host name validation, otherwise the hostname string address (zero terminated)
    3723   00:5413                      ;TCP_OPEN_IP1               (ix+0)
    3724   00:5413                      ;TCP_OPEN_IP2               (ix+1)
    3725   00:5413                      ;TCP_OPEN_IP3               (ix+2)
    3726   00:5413                      ;TCP_OPEN_IP4               (ix+3)
    3727   00:5413                      ;TCP_OPEN_RP                (ix+4)
    3728   00:5413                      ;TCP_OPEN_LP                (ix+6)
    3729   00:5413                      ;TCP_OPEN_TO                (ix+8)
    3730   00:5413                      ;TCP_OPEN_CMD_FLAGS         (ix+10)
    3731   00:5413                      ;TCP_OPEN_CMD_HOST_LSB      (ix+11)
    3732   00:5413                      ;TCP_OPEN_CMD_HOST_MSB      (ix+12)
    3733   00:5413                      
    3734   00:5413                      ; When no connection, let's get the reason and put in register C, as agreed
    3735   00:5413                      ; with Nestor this will be the way to go in the next UNAPI revision
    3736   00:5413                      TCPIP_TCP_OPEN_ERROR:
    3737   00:5413                          ; next two bytes are return code and size bytes, don't care, it is 1, conn close reason
    3738   00:5413  47                      ld  b,a                         ; save error in b
    3739   00:5414  0E 02                   ld  c,2
    3740   00:5416                      TCPIP_TCP_OPEN_ERROR2:
    3741   00:5416                          CHECK_DATA
    3741   00:5416  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3741   00:5419  CB 47             >     bit 0,a
    3742   00:541B  20 05                   jr  nz,TCPIP_TCP_OPEN_ERROR2.1
    3743   00:541D  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3744   00:5420  18 F4                   jr  TCPIP_TCP_OPEN_ERROR2
    3745   00:5422                      TCPIP_TCP_OPEN_ERROR2.1:
    3746   00:5422                          ; nz, discard
    3747   00:5422                          RECEIVE_DATA
    3747   00:5422  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3748   00:5425  0D                      dec c
    3749   00:5426  20 EE                   jr  nz,TCPIP_TCP_OPEN_ERROR2
    3750   00:5428  78                      ld  a,b
    3751   00:5429  FE 0B                   cp  ERR_NO_CONN
    3752   00:542B  20 10                   jr  nz,TCPIP_TCP_OPEN_ERROR4    ; other errors do not have extra bytes as result
    3753   00:542D                      ; now just get the 1 byte, close reason, should go to C
    3754   00:542D                      TCPIP_TCP_OPEN_ERROR3:
    3755   00:542D                          CHECK_DATA
    3755   00:542D  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    3755   00:5430  CB 47             >     bit 0,a
    3756   00:5432  20 05                   jr  nz,TCPIP_TCP_OPEN_ERROR3.1
    3757   00:5434  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3758   00:5437  18 F4                   jr  TCPIP_TCP_OPEN_ERROR3
    3759   00:5439                      TCPIP_TCP_OPEN_ERROR3.1:
    3760   00:5439                          ; nz, get it
    3761   00:5439                          RECEIVE_DATA
    3761   00:5439  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    3762   00:543C  4F                      ld  c,a
    3763   00:543D                      TCPIP_TCP_OPEN_ERROR4:
    3764   00:543D                          ; now return w/ error that is saved in b
    3765   00:543D  78                      ld  a,b
    3766   00:543E  06 00                   ld  b,0                         ; no connection, so 0
    3767   00:5440  C9                      ret
    3768   00:5441                      
    3769   00:5441                      TCPIP_TCP_OPEN:
    3770   00:5441  E5                      push    hl                      ; save param block address
    3771   00:5442  7C                      ld  a,h
    3772   00:5443  DD 67                   ld  ixh,a
    3773   00:5445  7D                      ld  a,l
    3774   00:5446  DD 6F                   ld  ixl,a
