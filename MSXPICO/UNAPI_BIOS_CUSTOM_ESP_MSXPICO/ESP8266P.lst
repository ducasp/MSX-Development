    4700   00:590A                      ;=========================
    4701   00:590A                      ;===  TCPIP_CONFIG_IP  ===
    4702   00:590A                      ;=========================
    4703   00:590A                      ;Manually configure an IP address.
    4704   00:590A                      ;
    4705   00:590A                      ;Input:  A = 26
    4706   00:590A                      ;        B = Index of address to set:
    4707   00:590A                      ;            1: Local IP address
    4708   00:590A                      ;            2: Peer IP address
    4709   00:590A                      ;            3: Subnet mask
    4710   00:590A                      ;            4: Default gateway
    4711   00:590A                      ;            5: Primary DNS server IP address
    4712   00:590A                      ;            6: Secondary DNS server IP address
    4713   00:590A                      ;        L.H.E.D = Address value
    4714   00:590A                      ;Output: A = Error code
    4715   00:590A                      TCPIP_CONFIG_IP:
    4716   00:590A                          SEND_DATA                       ; Send the command
    4716   00:590A  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4717   00:590D  AF                      xor a
    4718   00:590E                          SEND_DATA                       ; Send the command size msb
    4718   00:590E  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4719   00:5911  3E 05                   ld  a,5
    4720   00:5913                          SEND_DATA                       ; Send the command size lsb
    4720   00:5913  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4721   00:5916  78                      ld  a,b
    4722   00:5917                          SEND_DATA                       ; Send the address to set
    4722   00:5917  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4723   00:591A  7D                      ld  a,l
    4724   00:591B                          SEND_DATA                       ; Send the IP first byte
    4724   00:591B  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4725   00:591E  7C                      ld  a,h
    4726   00:591F                          SEND_DATA                       ; Send the IP second byte
    4726   00:591F  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4727   00:5922  7B                      ld  a,e
    4728   00:5923                          SEND_DATA                       ; Send the IP third byte
    4728   00:5923  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4729   00:5926  7A                      ld  a,d
    4730   00:5927                          SEND_DATA                       ; Send the IP fourth byte
    4730   00:5927  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4731   00:592A                      
    4732   00:592A                          ; Now wait up to 180 ticks to get response
    4733   00:592A  21 B4 00                ld  hl,180
    4734   00:592D  CD 15 5A                call    SETCOUNTER
    4735   00:5930                      TCPIP_CONFIG_IP_ST1:
    4736   00:5930                          CHECK_DATA
    4736   00:5930  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    4736   00:5933  CB 47             >     bit 0,a
    4737   00:5935  20 05                   jr  nz,TCPIP_CONFIG_IP_ST1.1
    4738   00:5937  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4739   00:593A  18 F4                   jr  TCPIP_CONFIG_IP_ST1
    4740   00:593C                      TCPIP_CONFIG_IP_ST1.1:
    4741   00:593C                          ; nz, check the data
    4742   00:593C                          RECEIVE_DATA
    4742   00:593C  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4743   00:593F  FE 1A                   cp  26                          ; Is response of our command?
    4744   00:5941  20 ED                   jr  nz,TCPIP_CONFIG_IP_ST1
    4745   00:5943                          ; now get return code, and that is it
    4746   00:5943                      TCPIP_CONFIG_IP_RC:
    4747   00:5943                          CHECK_DATA
    4747   00:5943  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    4747   00:5946  CB 47             >     bit 0,a
    4748   00:5948  20 05                   jr  nz,TCPIP_CONFIG_IP_RC.1
    4749   00:594A  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    4750   00:594D  18 F4                   jr  TCPIP_CONFIG_IP_RC
    4751   00:594F                      TCPIP_CONFIG_IP_RC.1:
    4752   00:594F                          ; nz, discard
    4753   00:594F                          RECEIVE_DATA
    4753   00:594F  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4754   00:5952  C9                      ret                             ; done
