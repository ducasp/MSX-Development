    3995   00:5555  CB 47             >     bit 0,a
    3996   00:5557  20 05                   jr  nz,TCPIP_TCP_CLOSE_ST2.1
    3997   00:5559  CD 9C 4D                call    TCPIP_GENERIC_CHECK_TIME_OUT
    3998   00:555C  18 F4                   jr  TCPIP_TCP_CLOSE_ST2
    3999   00:555E                      TCPIP_TCP_CLOSE_ST2.1:
