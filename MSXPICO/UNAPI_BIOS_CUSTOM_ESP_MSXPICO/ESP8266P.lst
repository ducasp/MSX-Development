    4542   00:583E                      
    4543   00:583E                          ; now just discard 2 bytes urgent data
    4544   00:583E                      TCPIP_TCP_RCV_UDC_ST1:
    4545   00:583E                          CHECK_DATA
    4545   00:583E  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    4545   00:5841  CB 47             >     bit 0,a
    4546   00:5843  20 05                   jr  nz,TCPIP_TCP_RCV_UDC_ST1.1
    4547   00:5845  CD 7D 57                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    4548   00:5848  18 F4                   jr  TCPIP_TCP_RCV_UDC_ST1
    4549   00:584A                      TCPIP_TCP_RCV_UDC_ST1.1:
    4550   00:584A                          ; nz, get it
    4551   00:584A                          RECEIVE_DATA
    4551   00:584A  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    4552   00:584D                      TCPIP_TCP_RCV_UDC_ST2:
    4553   00:584D                          CHECK_DATA
    4553   00:584D  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    4553   00:5850  CB 47             >     bit 0,a
    4554   00:5852  20 05                   jr  nz,TCPIP_TCP_RCV_UDC_ST2.1
    4555   00:5854  CD 7D 57                call    TCPIP_TCP_RCV_CHECK_TIME_OUT
    4556   00:5857  18 F4                   jr  TCPIP_TCP_RCV_UDC_ST2
    4557   00:5859                      TCPIP_TCP_RCV_UDC_ST2.1:
    4558   00:5859                          ; nz, get it
