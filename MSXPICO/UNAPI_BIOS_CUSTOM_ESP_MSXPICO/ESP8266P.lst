    2058   00:4BF7                      ; WAIT an ESP Wi-Fi Scan command Response
    2059   00:4BF7                      ; Inputs:
    2060   00:4BF7                      ; A -> Command Code
    2061   00:4BF7                      ; HL -> Timeout
    2062   00:4BF7                      ; IX -> Where to store response
    2063   00:4BF7                      ;
    2064   00:4BF7                      ; Returns:
    2065   00:4BF7                      ; Flag Z is zero if failure, non zero if success
    2066   00:4BF7                      ; A is the number of access points scanned
    2067   00:4BF7                      ;
    2068   00:4BF7                      ; Response is stored as:
    2069   00:4BF7                      ; Access Point SSID zero terminated and after first 0
    2070   00:4BF7                      ; 0 if Open otherwise requires a password to join
    2071   00:4BF7                      ; And this repeats...
    2072   00:4BF7                      ;
    2073   00:4BF7                      ; Affect:
    2074   00:4BF7                      ; AF , BC and HL
    2075   00:4BF7                      ;
    2076   00:4BF7                      WAIT_MENU_SCMD_RESPONSE:
    2077   00:4BF7  D5                      push    de
    2078   00:4BF8  DD E5                   push    ix
