    2839   00:4FBA                          ; nz, check the data
    2840   00:4FBA                          RECEIVE_DATA
    2840   00:4FBA  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2841   00:4FBD  FE 03                   cp  3                           ; Is response of our command?
    2842   00:4FBF  20 ED                   jr  nz,TCPIP_NET_STATE_ST1
    2843   00:4FC1                          ; now get return code, if return code other than 0, it is finished
    2844   00:4FC1                      TCPIP_NET_STATE_RC:
    2845   00:4FC1                          CHECK_DATA
    2845   00:4FC1  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    2845   00:4FC4  CB 47             >     bit 0,a
    2846   00:4FC6  20 05                   jr  nz,TCPIP_NET_STATE_RC.1
