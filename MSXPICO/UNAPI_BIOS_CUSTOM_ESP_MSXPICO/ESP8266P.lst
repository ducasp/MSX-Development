    2137   00:4C68                      WAIT_MENU_SCMD_RESPONSE_GET_ENC.1:
    2138   00:4C68                          RECEIVE_DATA            ; Get data
    2138   00:4C68  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2139   00:4C6B  D6 4F                   sub 'O'                         ; If O, open, will be 0, otherwise, will be notzero
    2140   00:4C6D  DD 77 00                ld  (ix+0),a                    ; Put it in the buffer
    2141   00:4C70  DD 23                   inc ix                          ; Increment pointer
    2142   00:4C72  0D                      dec c                           ; Decrement counter
    2143   00:4C73  AF                      xor a
    2144   00:4C74  B1                      or  c                           ; Is counter 0?
    2145   00:4C75                          ; If not continue getting more SSIDs
    2146   00:4C75  20 C8                   jr  nz,WAIT_MENU_SCMD_RESPONSE_ST2B
    2147   00:4C77                          ; It is zero, so, done
    2148   00:4C77                      WAIT_MENU_SCMD_RESPONSE_END_OK:
    2149   00:4C77  3E 01                   ld  a,1
    2150   00:4C79  B7                      or  a                           ; NZ to indicate success
    2151   00:4C7A  78                      ld  a,b                         ; Number of APs in A
