    3812   00:547D  7B                      ld  a,e
    3813   00:547E                          SEND_DATA                       ; Send the command size lsb
    3813   00:547E  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    3814   00:5481  E1                      pop hl                          ; Restore the memory address for the parameters
    3815   00:5482                          ; First send the 11 bytes parameters
    3816   00:5482                          if USE_MEM_IO = 0
