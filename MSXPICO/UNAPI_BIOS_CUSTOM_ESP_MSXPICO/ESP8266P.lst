    1346   00:471E  C2 1A 47                jp  nz,WIFI_CONNECT_APSIZE      ; Count size, including zero terminator
    1347   00:4721                          ; Check for encryption
    1348   00:4721  1A                      ld  a,(de)
    1349   00:4722  B7                      or  a
    1350   00:4723  CA B4 47                jp  z,WIFI_CONNECT_SENDCMD      ; If no password requested, good to go
    1351   00:4726                          ; Shoot, need to request password, well, let's do it
    1352   00:4726  E5                      push    hl                      ; Save HL
    1353   00:4727  21 94 63                ld  hl,MMENU_ASKPWD
    1354   00:472A  CD 8E 4C                call    PRINTHL                 ; Inform that user need to input PWD
    1355   00:472D  E1                      pop hl                          ; Restore HL
    1356   00:472E  FD 21 00 00             ld  iy,0                        ; IY will help in backspacing
    1357   00:4732  DD 26 01                ld  ixh,1                       ; Start hidden
    1358   00:4735                      WIFI_CONNECT_RCV_PWD:
    1359   00:4735  CD 9F 00                call    CHGET
    1360   00:4738  FE 1B                   cp  #1b                         ; ESC?
    1361   00:473A  CA 5C 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1362   00:473D  FE 08                   cp  #08                         ; Backspace?
    1363   00:473F  CA 90 47                jp  z,WIFI_CONNECT_RCV_PWD_BS   ; Check if there is something to erase
    1364   00:4742  FE 0D                   cp  #0d                         ; ENTER?
    1365   00:4744  CA AD 47                jp  z,WIFI_PWD_CHECK_INPUT      ; Check if ok
    1366   00:4747  FE 7F                   cp  #7f                         ; Delete?
    1367   00:4749  CA 7C 47                jp  z,WIFI_CONNECT_RCV_PWDH     ; Change password from clear to hidden or vice versa
    1368   00:474C                      WIFI_CONNECT_RCV_PWD_STR:
    1369   00:474C                          ; Ok, so it is a digit and store
    1370   00:474C  12                      ld  (de),a
    1371   00:474D  FD 7D                   ld  a,iyl
    1372   00:474F  D6 3F                   sub 63                          ; 63 chars password limit (WPA2 encryption)
    1373   00:4751  28 E2                   jr  z,WIFI_CONNECT_RCV_PWD
    1374   00:4753  1A                      ld  a,(de)
    1375   00:4754  03                      inc bc
    1376   00:4755  13                      inc de
    1377   00:4756  FD 23                   inc iy                          ; Increment counters and pointer
    1378   00:4758  F5                      push    af                      ; Save A
    1379   00:4759  DD 7C                   ld  a,ixh
    1380   00:475B  B7                      or  a                           ; If zero, print char, otherwise print *
    1381   00:475C  28 09                   jr  z,WIFI_CONNECT_RCV_PWD_CHAR
    1382   00:475E  F1                      pop af
    1383   00:475F  3E 2A                   ld  a,'*'                       ; Print * and keep password hidden
    1384   00:4761  CD A2 00                call    CHPUT
    1385   00:4764  C3 35 47                jp  WIFI_CONNECT_RCV_PWD        ; And back to receiving digits
    1386   00:4767                      WIFI_CONNECT_RCV_PWD_CHAR:
    1387   00:4767  F1                      pop af
    1388   00:4768  FE 20                   cp  32
    1389   00:476A  30 04                   jr  nc,WIFI_CONNECT_RCV_CHKPRT2 ; Ok, not below space, but is it delete?
    1390   00:476C  3E 3F                   ld  a,'?'                       ; Prints a question mark
    1391   00:476E  18 06                   jr  WIFI_CONNECT_RCV_CHKPRTD
    1392   00:4770                      WIFI_CONNECT_RCV_CHKPRT2:
    1393   00:4770  FE 7F                   cp  #7f
    1394   00:4772  20 02                   jr  nz,WIFI_CONNECT_RCV_CHKPRTD
    1395   00:4774  3E 3F                   ld  a,'?'                       ; Prints a question mark if it is delete
    1396   00:4776                      WIFI_CONNECT_RCV_CHKPRTD:
    1397   00:4776  CD A2 00                call    CHPUT                   ; Print a char
    1398   00:4779  C3 35 47                jp  WIFI_CONNECT_RCV_PWD        ; And back to receiving digits
    1399   00:477C                      
    1400   00:477C                      WIFI_CONNECT_RCV_PWDH:
    1401   00:477C  FD 7D                   ld  a,iyl
    1402   00:477E  FD B4                   or  iyh
    1403   00:4780  C2 4C 47                jp  nz,WIFI_CONNECT_RCV_PWD_STR ; If digits entered, can't change password behavior, so it is a pass phrase char
    1404   00:4783  AF                      xor a
    1405   00:4784  DD B4                   or  ixh
    1406   00:4786  DD 26 01                ld  ixh,1
    1407   00:4789  28 AA                   jr  z,WIFI_CONNECT_RCV_PWD      ; Return if it was 0
    1408   00:478B  DD 26 00                ld  ixh,0
    1409   00:478E  28 A5                   jr  z,WIFI_CONNECT_RCV_PWD      ; Otherwise set to 0 and return
    1410   00:4790                      
    1411   00:4790                      WIFI_CONNECT_RCV_PWD_BS:
    1412   00:4790  FD 7D                   ld  a,iyl
    1413   00:4792  FD B4                   or  iyh
    1414   00:4794  CA 35 47                jp  z,WIFI_CONNECT_RCV_PWD      ; If no digits entered, nothing to erase
    1415   00:4797  FD 2B                   dec iy                          ; Decrement counter
    1416   00:4799  0B                      dec bc                          ; Decrement counter
    1417   00:479A  1B                      dec de                          ; Decrement pointer
    1418   00:479B  3E 08                   ld  a,8                         ; Backspace
    1419   00:479D  CD A2 00                call    CHPUT                   ; Print it
    1420   00:47A0  3E 20                   ld  a,' '                       ; Space
    1421   00:47A2  CD A2 00                call    CHPUT                   ; Print it
    1422   00:47A5  3E 08                   ld  a,8                         ; Backspace
    1423   00:47A7  CD A2 00                call    CHPUT                   ; Print it
    1424   00:47AA  C3 35 47                jp  WIFI_CONNECT_RCV_PWD        ; Return
    1425   00:47AD                      
    1426   00:47AD                      WIFI_PWD_CHECK_INPUT:
    1427   00:47AD  FD 7D                   ld  a,iyl
    1428   00:47AF  FD B4                   or  iyh
    1429   00:47B1  CA 35 47                jp  z,WIFI_CONNECT_RCV_PWD      ; If no digits entered, no password to send
    1430   00:47B4                          ; Otherwise done and ready to send
    1431   00:47B4                      WIFI_CONNECT_SENDCMD:
    1432   00:47B4  CD 07 4A                call    WAIT_250MS_AND_THEN_CONTINUE
    1433   00:47B7  E5                      push    hl
    1434   00:47B8  21 50 63                ld  HL,MMENU_CONNECTING
    1435   00:47BB  CD 8E 4C                call    PRINTHL
    1436   00:47BE  E1                      pop hl
    1437   00:47BF                          ; Print AP name
    1438   00:47BF  E5                      push    hl
    1439   00:47C0  CD 98 4C                call    PRINTHLINE              ; Print AP Name
    1440   00:47C3  E1                      pop hl
    1441   00:47C4                          ; HL has the address of our data, BC the data size, so it is just needed to send the command
    1442   00:47C4                          CLEAR_UART
    1442   00:47C4  3E 14             >     ld  a,20
    1442   00:47C6  32 06 7F          >     ld  (MEM_OUT_CMD_PORT),a
    1443   00:47C9  3E 41                   ld  a,CMD_WIFI_CONNECT
    1444   00:47CB                          SEND_DATA
    1444   00:47CB  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1445   00:47CE  78                      ld  a,b                         ; Size MSB is in B
    1446   00:47CF                          SEND_DATA
    1446   00:47CF  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1447   00:47D2  79                      ld  a,c                         ; Size LSB is in c
    1448   00:47D3                          SEND_DATA
    1448   00:47D3  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1449   00:47D6                      WIFI_CONNECT_SENDCMDLP:
    1450   00:47D6  7E                      ld  a,(hl)
    1451   00:47D7                          SEND_DATA
    1451   00:47D7  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    1452   00:47DA  23                      inc hl
    1453   00:47DB  0B                      dec bc
    1454   00:47DC  78                      ld  a,b
    1455   00:47DD  B1                      or  c
    1456   00:47DE  C2 D6 47                jp  nz,WIFI_CONNECT_SENDCMDLP
    1457   00:47E1  21 58 02                ld  hl,600                      ; Wait Up To 10s
    1458   00:47E4  3E 41                   ld  a,CMD_WIFI_CONNECT          ; Our command
    1459   00:47E6  CD 29 4B                call    WAIT_MENU_QCMD_RESPONSE
    1460   00:47E9  CA F5 47                jp  z,WIFI_CONNECT_FAIL
    1461   00:47EC  21 F5 67                ld  hl,STR_SENDING_OK_JN        ; Success
    1462   00:47EF  CD 8E 4C                call    PRINTHL
    1463   00:47F2  C3 FF 49                jp  WAIT_2S_AND_THEN_MAINMENU
    1464   00:47F5                      WIFI_CONNECT_FAIL:
    1465   00:47F5  21 17 68                ld  hl,STR_SENDING_NOK_JN       ; Failure
    1466   00:47F8  CD 8E 4C                call    PRINTHL
    1467   00:47FB  C3 FB 49                jp  WAIT_4S_AND_THEN_MAINMENU
    1468   00:47FE                      
    1469   00:47FE                      INPUT_WFSAP_BAD_INPUT:
    1470   00:47FE  C5                      push    bc
    1471   00:47FF  D5                      push    de
    1472   00:4800  F5                      push    af
    1473   00:4801  E5                      push    hl
    1474   00:4802  DD E5                   push    ix
    1475   00:4804  FD E5                   push    iy
    1476   00:4806  CD C0 00                call    BEEP                    ; Wrong Input, beep
    1477   00:4809  FD E1                   pop iy
    1478   00:480B  DD E1                   pop ix
    1479   00:480D  E1                      pop hl
    1480   00:480E  F1                      pop af
    1481   00:480F  D1                      pop de
    1482   00:4810  C1                      pop bc
    1483   00:4811  C3 3C 46                jp WIFI_SELECT_AP               ; Return
    1484   00:4814                      
    1485   00:4814                      WIFI_SCAN_NONETWORKS:
    1486   00:4814  21 03 63                ld  hl,MMENU_SCANN
    1487   00:4817  CD 8E 4C                call    PRINTHL
    1488   00:481A  C3 FB 49                jp  WAIT_4S_AND_THEN_MAINMENU
    1489   00:481D                      
    1490   00:481D                      WIFI_SCAN_TIMEOUT:
    1491   00:481D  21 E3 62                ld  hl,MMENU_SCANF
    1492   00:4820  CD 8E 4C                call    PRINTHL
    1493   00:4823  C3 FB 49                jp  WAIT_4S_AND_THEN_MAINMENU
    1494   00:4826                      
    1495   00:4826                      SET_WIFI_TIMEOUT:
    1496   00:4826  3E 32                   ld  a,'2'
    1497   00:4828  CD A2 00                call    CHPUT
    1498   00:482B  CD 07 4A                call    WAIT_250MS_AND_THEN_CONTINUE
    1499   00:482E  21 C6 64                ld  hl,MMENU_TIMEOUT
    1500   00:4831  CD 8E 4C                call    PRINTHL                 ; Print Main Timeout message
    1501   00:4834  CD 78 4A                call    CHECKTIMEOUT            ; TimeOut is on or off?
    1502   00:4837  CA 4F 48                jp  z,WIFI_SET_ALWAYS_ON        ; If 0, always on
    1503   00:483A                          ; Otherwise there is a timeout
    1504   00:483A  E5                      push    hl
    1505   00:483B  21 FD 65                ld hl,MMENU_TIMEOUT_NOTALWAYSON1
    1506   00:483E  CD 8E 4C                call    PRINTHL
    1507   00:4841  E1                      pop hl
    1508   00:4842  CD 8E 4C                call    PRINTHL
    1509   00:4845  21 13 66                ld hl,MMENU_TIMEOUT_NOTALWAYSON2
    1510   00:4848  CD 8E 4C                call    PRINTHL
    1511   00:484B  16 00                   ld  d,0                         ; Count digits
    1512   00:484D  18 10                   jr  INPUT_TIMEOUT
    1513   00:484F                      WIFI_SET_ALWAYS_ON:
    1514   00:484F  21 A8 65                ld  hl,MMENU_TIMEOUT_ALWAYSON
    1515   00:4852  CD 8E 4C                call    PRINTHL
    1516   00:4855  ED 5B 76 F6             ld  de,(TXTTAB)                 ; We will borrow Basic Program memory area for now...
    1517   00:4859  DD 6B                   ld  ixl,e
    1518   00:485B  DD 62                   ld  ixh,d                       ; Address in IX
    1519   00:485D  16 00                   ld  d,0                         ; Count digits
    1520   00:485F                      INPUT_TIMEOUT:
    1521   00:485F  CD 9F 00                call    CHGET
    1522   00:4862  FE 1B                   cp  #1b                         ; ESC?
    1523   00:4864  CA 5C 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1524   00:4867  FE 0D                   cp  #0d                         ; ENTER?
    1525   00:4869  CA AD 48                jp  z,SET_WIFI_CHECK_INPUT      ; Check if ok
    1526   00:486C  FE 08                   cp  #08                         ; Backspace?
    1527   00:486E  CA 93 48                jp  z,SET_WIFI_BS_INPUT         ; Check if there is something to erase
    1528   00:4871  FE 30                   cp  '0'                         ; Check if A is less than 0
    1529   00:4873  DA 8D 48                jp  c,INPUT_TIMEOUT_BAD_INPUT   ; if it is, ignore
    1530   00:4876  FE 3A                   cp  '9'+1                       ; Check if a is greater than  9
    1531   00:4878  D2 8D 48                jp  nc,INPUT_TIMEOUT_BAD_INPUT  ; If it is, ignore
    1532   00:487B  DD 77 00                ld  (ix+0),a                    ; Save it
    1533   00:487E  CD A2 00                call    CHPUT                   ; It is valid, so print it
    1534   00:4881  14                      inc d                           ; Increment digit count
    1535   00:4882  DD 23                   inc ix                          ; Increment pointer
    1536   00:4884  3E 03                   ld  a,3
    1537   00:4886  BA                      cp  d
    1538   00:4887  CA AD 48                jp  z,SET_WIFI_CHECK_INPUT      ; All we can do is accept up to 3 digits, check if ok
    1539   00:488A  C3 5F 48                jp  INPUT_TIMEOUT               ; Not done yet, so continue
    1540   00:488D                      
    1541   00:488D                      INPUT_TIMEOUT_BAD_INPUT:
    1542   00:488D  CD C0 00                call    BEEP                    ; Wrong Input, beep
    1543   00:4890  C3 5F 48                jp INPUT_TIMEOUT                ; Return
    1544   00:4893                      
    1545   00:4893                      SET_WIFI_BS_INPUT:
    1546   00:4893  AF                      xor a
    1547   00:4894  B2                      or  d                           ; Counter has any digit?
    1548   00:4895  CA 5F 48                jp  z,INPUT_TIMEOUT             ; Nope, so just continue
    1549   00:4898  15                      dec d                           ; Decrement counter
    1550   00:4899  DD 2B                   dec ix                          ; Decrement pointer
    1551   00:489B  3E 08                   ld  a,8                         ; Backspace
    1552   00:489D  CD A2 00                call    CHPUT                   ; Print it
    1553   00:48A0  3E 20                   ld  a,' '                       ; Space
    1554   00:48A2  CD A2 00                call    CHPUT                   ; Print it
    1555   00:48A5  3E 08                   ld  a,8                         ; Backspace
    1556   00:48A7  CD A2 00                call    CHPUT                   ; Print it
    1557   00:48AA  C3 5F 48                jp  INPUT_TIMEOUT               ; Return
    1558   00:48AD                      
    1559   00:48AD                      SET_WIFI_CHECK_INPUT:
    1560   00:48AD  AF                      xor a
    1561   00:48AE  B2                      or  d                           ; Counter has any digits
    1562   00:48AF  CA 5F 48                jp  z,INPUT_TIMEOUT             ; Nope, so just continue
    1563   00:48B2                          ; IX is pointing one position after last digit, so revert
    1564   00:48B2  DD 2B                   dec ix
    1565   00:48B4  DD 7E 00                ld  a,(ix+0)                    ; Digit in A
    1566   00:48B7  D6 30                   sub '0'                         ; Convert it to decimal
    1567   00:48B9  26 00                   ld  h,0                         ; First digit, so H is 0
    1568   00:48BB  6F                      ld  l,a                         ; And L has the digit
    1569   00:48BC  15                      dec d                           ; If digits finished, just set
    1570   00:48BD  CA E9 48                jp  z,SET_WIFI_EXECUTE_SET_COMMAND
    1571   00:48C0  DD 2B                   dec ix
    1572   00:48C2  DD 7E 00                ld  a,(ix+0)                    ; Digit in A
    1573   00:48C5  D6 30                   sub '0'                         ; Convert it to decimal
    1574   00:48C7  87                      add a,a                         ; A*2
    1575   00:48C8  4F                      ld  c,a                         ; A*2 in C
    1576   00:48C9  87                      add a,a                         ; A*4
    1577   00:48CA  87                      add a,a                         ; A*8
    1578   00:48CB  81                      add a,c                         ; A*10
    1579   00:48CC                          ; Up to here, we can get 90 + 9, 99, won't go to H anyway, just add to L
    1580   00:48CC  85                      add a,l                         ; L has the first digit
    1581   00:48CD  6F                      ld  l,a                         ; And now L has the two digits
    1582   00:48CE  15                      dec d                           ; If digits finished, just set
    1583   00:48CF  CA E9 48                jp  z,SET_WIFI_EXECUTE_SET_COMMAND
    1584   00:48D2  DD 2B                   dec ix
    1585   00:48D4  DD 7E 00                ld  a,(ix+0)                    ; Digit in A
    1586   00:48D7  D6 30                   sub '0'                         ; Convert it to decimal
    1587   00:48D9  87                      add a,a                         ; A*2
    1588   00:48DA  4F                      ld  c,a                         ; A*2 in C
    1589   00:48DB  87                      add a,a                         ; A*4
    1590   00:48DC  87                      add a,a                         ; A*8
    1591   00:48DD  81                      add a,c                         ; A*10
    1592   00:48DE  EB                      ex  de,hl                       ; Get the two digits results in de
    1593   00:48DF  6F                      ld  l,a
    1594   00:48E0  26 00                   ld  h,0                         ; HL = A*10
    1595   00:48E2  29                      add hl,hl                       ; HL = A*20
    1596   00:48E3  4D                      ld  c,l
    1597   00:48E4  44                      ld  b,h                         ; BC = A*20
    1598   00:48E5  29                      add hl,hl                       ; HL = A*40
    1599   00:48E6  29                      add hl,hl                       ; HL = A*80
    1600   00:48E7  09                      add hl,bc                       ; HL = A*100
    1601   00:48E8  19                      add hl,de                       ; HL = three digits result
    1602   00:48E9                          ; This was the last digit, up to three
    1603   00:48E9                      SET_WIFI_EXECUTE_SET_COMMAND:
    1604   00:48E9  C3 3B 49                jp  SET_ESP_WIFI_TIMEOUT        ; And set and done
    1605   00:48EC                      
