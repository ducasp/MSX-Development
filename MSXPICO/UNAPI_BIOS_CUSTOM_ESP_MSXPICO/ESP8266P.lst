    2709   00:4F0F                      ;===  TCPIP_GET_IPINFO  ===
    2710   00:4F0F                      ;==========================
    2711   00:4F0F                      ;Get IP address.
    2712   00:4F0F                      ;
    2713   00:4F0F                      ;Input:  A = 2
    2714   00:4F0F                      ;        B = Index of address to obtain:
    2715   00:4F0F                      ;            1: Local IP address
    2716   00:4F0F                      ;            2: Peer IP address
    2717   00:4F0F                      ;            3: Subnet mask
    2718   00:4F0F                      ;            4: Default gateway
    2719   00:4F0F                      ;            5: Primary DNS server IP address
    2720   00:4F0F                      ;            6: Secondary DNS server IP address
    2721   00:4F0F                      ;Output: A = Error code
    2722   00:4F0F                      ;        L.H.E.D = Requested address
    2723   00:4F0F                      TCPIP_GET_IPINFO:
    2724   00:4F0F                          SEND_DATA                       ; Send the command
    2724   00:4F0F  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2725   00:4F12  AF                      xor a
    2726   00:4F13                          SEND_DATA                       ; Send the command size msb
    2726   00:4F13  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2727   00:4F16  3C                      inc a
    2728   00:4F17                          SEND_DATA                       ; Send the command size lsb
    2728   00:4F17  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2729   00:4F1A  78                      ld  a,b
    2730   00:4F1B                          SEND_DATA
    2730   00:4F1B  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    2731   00:4F1E                      
    2732   00:4F1E                          ; Now wait up to 600 ticks to get response
    2733   00:4F1E  21 58 02                ld  hl,600
    2734   00:4F21  CD 15 5A                call    SETCOUNTER
    2735   00:4F24                      TCPIP_GET_IPINFO_ST1:
    2736   00:4F24                          CHECK_DATA
