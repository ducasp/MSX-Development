    4068   00:55B6                      ;=========================
    4069   00:55B6                      ;===  TCPIP_TCP_STATE  ===
    4070   00:55B6                      ;=========================
    4071   00:55B6                      ;Get the state of a TCP connection.
    4072   00:55B6                      ;
    4073   00:55B6                      ;Input:  A = 16
    4074   00:55B6                      ;        B = Connection number
    4075   00:55B6                      ;        HL = Pointer in TPA for connection information block
    4076   00:55B6                      ;             (0 if not needed)
    4077   00:55B6                      ;Output: A  = Error code
    4078   00:55B6                      ;        B  = Connection state
    4079   00:55B6                      ;        C  = Close reason (only if ERR_NO_CONN is returned)
    4080   00:55B6                      ;        HL = Number of total available incoming bytes
    4081   00:55B6                      ;        DE = Number of urgent available incoming bytes
    4082   00:55B6                      ;        IX = Available free space in the output buffer
    4083   00:55B6                      ;             (0FFFFh = infinite)
    4084   00:55B6                      ;
    4085   00:55B6                      ;Connection information block consists of:
    4086   00:55B6                      ;
    4087   00:55B6                      ;    +0 (4): Remote IP address
    4088   00:55B6                      ;    +4 (2): Remote port
    4089   00:55B6                      ;    +6 (2): Local port
