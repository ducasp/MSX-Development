    4954   00:5A02  23                      inc hl
    4955   00:5A03  66                      ld  h,(hl)
    4956   00:5A04  69                      ld  l,c
    4957   00:5A05  C9                      ret
    4958   00:5A06                      
    4959   00:5A06                      ;--- Obtain our HTIM_I driven counter value in high memory
    4960   00:5A06                      ;    Input:  none
    4961   00:5A06                      ;    Output: HL = counter value
    4962   00:5A06                      ;    Modifies: AF, HL, DE, BC
    4963   00:5A06                      
    4964   00:5A06                      GETCOUNTER:
    4965   00:5A06  CD 75 59                call    GETSLT
    4966   00:5A09                          ; Slot in A, now get the address of our counter
    4967   00:5A09  CD FE 59                call    GETMEMPOINTER
    4968   00:5A0C                          ; HL has the address of our memory area, counter is 5 bytes after start
    4969   00:5A0C  11 05 00                ld  de,MEMORY_COUNTER_OFFSET
    4970   00:5A0F  19                      add hl,de
    4971   00:5A10                          ; Ok, this is where our counter is so get it
    4972   00:5A10  5E                      ld  e,(hl)
    4973   00:5A11  23                      inc hl
    4974   00:5A12  56                      ld  d,(hl)
    4975   00:5A13                          ; DE has the counter value
    4976   00:5A13  EB                      ex  de,hl                       ; Counter value in HL
    4977   00:5A14  C9                      ret
    4978   00:5A15                      
    4979   00:5A15                      ;--- Set our HTIM_I driven counter value in high memory
    4980   00:5A15                      ;    Input:  HL = new counter value
    4981   00:5A15                      ;    Output: none
    4982   00:5A15                      ;    Modifies: AF, HL, DE, BC
    4983   00:5A15                      
    4984   00:5A15                      SETCOUNTER:
    4985   00:5A15  E5                      push    hl                      ; Save parameter
    4986   00:5A16  CD 75 59                call    GETSLT
    4987   00:5A19                          ; Slot in A, now get the address of our counter
    4988   00:5A19  CD FE 59                call    GETMEMPOINTER
    4989   00:5A1C                          ; HL has the address of our memory area, counter is 5 bytes after start
    4990   00:5A1C  11 05 00                ld  de,MEMORY_COUNTER_OFFSET
    4991   00:5A1F  19                      add hl,de
    4992   00:5A20                          ; Ok, this is where our counter is so get it
    4993   00:5A20                          ; HL has the address of counter
    4994   00:5A20  D1                      pop de                          ; Restore parameter in DE
    4995   00:5A21  73                      ld  (hl),e
    4996   00:5A22  23                      inc hl
    4997   00:5A23  72                      ld  (hl),d
    4998   00:5A24  C9                      ret
    4999   00:5A25                      
    5000   00:5A25                      ;--- Obtain a one byte param saved in high memory
    5001   00:5A25                      ;    Input:  none
