    3818   00:5482                    ~     outi
    3819   00:5482                    ~     outi
    3820   00:5482                    ~     outi
    3821   00:5482                    ~     outi
    3822   00:5482                    ~     outi
    3823   00:5482                    ~     outi
    3824   00:5482                    ~     outi
    3825   00:5482                    ~     outi
    3826   00:5482                    ~     outi
    3827   00:5482                    ~     outi
    3828   00:5482                    ~     outi                            ; Unrolled outi is a bit faster :)
    3829   00:5482                    ~     else
