    1626   00:4912  FE 6F                   cp  'o'                         ; Toggle Nagle On
    1627   00:4914  CA CA 49                jp  z,SET_NAGLE_ON              ;
    1628   00:4917  CD C0 00                call    BEEP                    ; Wrong Input, beep
    1629   00:491A  C3 05 49                jp  SET_NAGLE_WI_ON             ; And return waiting key
