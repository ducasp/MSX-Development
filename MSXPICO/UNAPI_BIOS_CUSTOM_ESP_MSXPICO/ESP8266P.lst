    1622   00:4908  FE 1B                   cp  #1b                         ; ESC?
    1623   00:490A  CA 5C 42                jp  z,ESPSETUP                  ; When done, back to main setup
    1624   00:490D  FE 4F                   cp  'O'                         ; Toggle Nagle On
