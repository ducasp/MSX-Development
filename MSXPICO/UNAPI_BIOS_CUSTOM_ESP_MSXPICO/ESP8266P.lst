    4621   00:58A6                      ;=============================
    4622   00:58A6                      ;===  TCPIP_CONFIG_AUTOIP  ===
    4623   00:58A6                      ;=============================
    4624   00:58A6                      ;Enable or disable the automatic IP addresses retrieval.
    4625   00:58A6                      ;
    4626   00:58A6                      ;Input:  A = 25
    4627   00:58A6                      ;        B = 0: Get current configuration
    4628   00:58A6                      ;            1: Set configuration
    4629   00:58A6                      ;        C = Configuration to set (only if B=1):
    4630   00:58A6                      ;            bit 0: Set to automatically retrieve
    4631   00:58A6                      ;                   local IP address, subnet mask and default gateway
    4632   00:58A6                      ;            bit 1: Set to automatically retrieve DNS servers addresses
    4633   00:58A6                      ;            bits 2-7: Unused, must be zero
    4634   00:58A6                      ;Output: A = Error code
    4635   00:58A6                      ;        C = Configuration after the routine execution
    4636   00:58A6                      ;            (same format as C at input)
    4637   00:58A6                      TCPIP_CONFIG_AUTOIP:
    4638   00:58A6                          SEND_DATA                       ; Send the command
    4638   00:58A6  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4639   00:58A9  AF                      xor a
    4640   00:58AA                          SEND_DATA                       ; Send the command size msb
    4640   00:58AA  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4641   00:58AD  3E 02                   ld  a,2
    4642   00:58AF                          SEND_DATA                       ; Send the command size lsb
    4642   00:58AF  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4643   00:58B2  78                      ld  a,b
    4644   00:58B3                          SEND_DATA                       ; Send the command
    4644   00:58B3  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4645   00:58B6  79                      ld  a,c
    4646   00:58B7                          SEND_DATA                       ; Send the command parameter
    4646   00:58B7  32 07 7F          >     ld  (MEM_OUT_TX_PORT),a
    4647   00:58BA                      
    4648   00:58BA                          ; Now wait up to 180 ticks to get response
    4649   00:58BA  21 B4 00                ld hl,180
    4650   00:58BD  CD 15 5A                call    SETCOUNTER
    4651   00:58C0                      TCPIP_CONFIG_AUTOIP_ST1:
    4652   00:58C0                          CHECK_DATA
    4652   00:58C0  3A 07 7F          >     ld  a,(MEM_IN_STS_PORT)
    4652   00:58C3  CB 47             >     bit 0,a
