    2088   00:4C0C  C3 7B 4C                jp  WAIT_MENU_SCMD_RESPONSE_END ; If time out waiting, return
    2089   00:4C0F                      WAIT_MENU_SCMD_RESPONSE_ST1.1:
    2090   00:4C0F                          ; nz, check the data
    2091   00:4C0F                          RECEIVE_DATA
    2091   00:4C0F  3A 06 7F          >     ld a,(MEM_IN_DATA_PORT)
    2092   00:4C12  BA                      cp  d                           ; Is response of our command?
    2093   00:4C13  20 E6                   jr  nz,WAIT_MENU_SCMD_RESPONSE_ST1
