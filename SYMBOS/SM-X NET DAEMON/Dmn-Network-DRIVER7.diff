+        ld (cfg_slots+0),a
+        ld a,(stactlssl+12)
+        dec a
+        ld (cfg_slots+1),a
+        ld ix,stabufim0
+        ld de,cfg_macadr
+        db #fd:ld l,6
+        ld bc,3
+staapl1 ld l,(ix+0)
+        ld h,(ix+1)
