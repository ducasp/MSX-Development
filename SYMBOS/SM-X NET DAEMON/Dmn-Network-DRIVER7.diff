+;### CFRDONLY -> IP/DNS input fields are read only while the group is automatic
+;### Destroyed  AF,BC,DE,HL
+cfgrdonly
+        ld a,(cfgctlras)
+        or a
+        ld a,2
+        jr z,cfrdo1
+        xor a
+cfrdo1  ld (cfrdom),a
+        ld hl,cfgctlia0+12
