+        ld de,upderrtxtnum
+        ld hl,upderrtxtcode
+        call upstrc
+        ld h,d
+        ld l,e
+        ld a,(upderrcd)
+        call clcn08
+        ld hl,(updbox)
+updser1 jp upderrm
+
+;### UPDTDAT -> derive the .dat path from the selected file
+updtdat
+        ld hl,updpath
+        ld de,upddat
+        call upstrc
+        ld hl,upddat
+        ld de,0
+updt1   ld a,(hl)
+        or a
+        jr z,updt2
+        cp "."
+        jr nz,updt3
+        push hl
+        pop de
+updt3   inc hl
+        jr updt1
+updt2   ld a,e
+        or d
+        jr z,updt4
+        ld h,d
+        ld l,e
+        inc hl
+        ld (hl),"d"
+        inc hl
+        ld (hl),"a"
+        inc hl
+        ld (hl),"t"
+        inc hl
+        ld (hl),0
+        jr updt5
+updt4   ld (hl),"."
+        inc hl
+        ld (hl),"d"
+        inc hl
+        ld (hl),"a"
+        inc hl
+        ld (hl),"t"
+        inc hl
+        ld (hl),0
+updt5   ret
+
+;### UPDTYP -> read the .dat and send it with command B (ESP32 firmware)
+updtyp
+        call updtdat
+        ld hl,upddat
+        ld a,(App_BnkNum)
+        db #dd:ld h,a
+        call SyFile_FILOPN
+        jr nc,updtp1
+        ld a,1                  ;no .dat file
+        scf
+        ret
+updtp1  ld (updfh2),a
+        ld hl,0
+        ld (upddatl),hl
+        ld a,(App_BnkNum)
+        ld e,a
+        ld a,(updfh2)
+        ld hl,upddatb
+        ld bc,24
+        call SyFile_FILINP
+        jr c,updtp2
+        ld (upddatl),bc
+updtp2  ld a,(updfh2)
+        call SyFile_FILCLO
+        ld a,(upddatl)
+        or a
+        jr z,updtp3
+        cp 6
+        jr nc,updtp4
+updtp3  xor a                   ;no/empty .dat
+        scf
+        ret
+updtp4  ld hl,upddatb
+        ld e,a
+        ld d,0
+        add hl,de
+        dec hl
+        ld a,(hl)
+        or a
+        jr z,updtp5
+        inc hl
+        ld (hl),0
+        ld hl,upddatl
+        inc (hl)
+updtp5  ld hl,upddatb
+        ld a,(upddatl)
+        ld c,a
+        ld b,0
+        call espupdat
+        ret nc
+        scf                     ;A=#FE/#FF/ESP rc
+        ret
