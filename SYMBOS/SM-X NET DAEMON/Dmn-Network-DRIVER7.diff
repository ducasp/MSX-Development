+;### CFRDCHK -> follow the radio selection while the config window is open
+;### Destroyed  AF,BC,HL
+cfgrdchk
+        ld a,(cfgwinid)
+        or a
+        ret z
+        ld a,(cfgctlras)
+        ld hl,cfgrdlas
+        cp (hl)
+        jr nz,cfgrdc1
+        ld a,(cfgctlrbs)
+        ld hl,cfgrdlbs
