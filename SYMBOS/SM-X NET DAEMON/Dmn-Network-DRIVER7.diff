+        call updmsg
+        rst #30
+        call updmsg
+        ld a,(updfoc)
+        or a
+        jr z,updp4
+        ld a,(updwinid)
+        ld d,2
+        ld e,254
+        call SyDesktop_WININH
+        rst #30
+updp4   halt
+        halt
+        ret
+
+;### UPDMSG -> drain desktop messages and track the progress window focus
+updmsg
+updms1  ld a,(App_PrcID)
+        db #dd:ld l,a
+        db #dd:ld h,PRC_ID_DESKTOP
+        ld iy,App_MsgBuf
+        rst #18
+        db #dd:dec l
+        jr nz,updms9
+        ld a,(App_MsgBuf+0)
+        cp MSR_DSK_WFOCUS
+        jr nz,updms1
+        ld a,(App_MsgBuf+1)
+        ld hl,updwinid
+        cp (hl)
+        jr nz,updms1
+        ld a,(App_MsgBuf+2)
+        ld (updfoc),a
+        jr updms1
+updms9  ret
+
+;### UPDTEXT -> set the progress line from HL
+updtext
+        ld de,updline2
+        call upstrc
+        ld h,d
+        ld l,e
+        ld de,updline2+20
+updtx1  ld a,h
+        cp d
+        jr nz,updtx2
+        ld a,l
+        cp e
+        jr nc,updtx3
+updtx2  ld (hl)," "
+        inc hl
+        jr updtx1
+updtx3  xor a
+        ld (de),a
+        ld a,(updwinid)
+        or a
+        ret z
+        call updmsg
+        rst #30
+        call updmsg
+        ld a,(updfoc)
+        or a
+        ret z
+        ld a,(updwinid)
+        ld d,2
+        ld e,254
+        call SyDesktop_WININH
+        rst #30
+        ret
+
+;### UPDCLOSF -> close the update file if open
+updclosf
+        ld a,(updfh)
+        or a
+        ret z
+        xor a
+        ld (updfh),a
+        jp SyFile_FILCLO
+
+;### UPDERRM -> close the progress window and show the message in HL
+upderrm
+        ld a,(updwinid)
+        or a
+        jr z,upderrm1
+        push hl
+        push af
+        xor a
+        ld (updwinid),a
+        pop af
+        call SyDesktop_WINCLS
+        pop hl
+upderrm1
+        ld a,(App_BnkNum)
+        ld b,1+8+64
+        ld de,stawindat
+        call SySystem_SYSWRN
+        jp prgprz0
+
+;### UPDSERR -> close file/window, show the ESP error (A=#FE/#FF/rc)
+updserr ld (upderrcd),a
+        call updclosf
+        ld a,1
+        call netini0
+        jr updser2
+updsers ld (upderrcd),a         ;the update never started: reset the ESP
+        call espupready
+        call updclosf
+        ld a,1
+        call netini0
+updser2 ld a,(upderrcd)
+        cp #FE
+        ld hl,cfgerrmsgbz
+        jr z,updser1
+        cp #FF
+        ld hl,cfgerrmsgns
+        jr z,updser1
