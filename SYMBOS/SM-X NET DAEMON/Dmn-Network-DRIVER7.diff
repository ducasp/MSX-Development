+        set 0,c
+staupda inc hl
+        ld a,(hl)
+        sub 1
+        jr c,staupdb
+        ld (hl),a
+        set 1,c
+staupdb ld a,c
+elseif DRIVER=7
+        ld c,0                  ;OCM Wi-Fi - link is on while the network is online
+        ld a,(net_status)
+        inc a
+        jr nz,staupdl
+        ld c,32
+staupdl ld hl,esp_sta_tx        ;TX and RX stay on for a short moment after data moved
+        ld a,(hl)
+        sub 1
+        jr c,staupda
+        ld (hl),a
+        set 0,c
+staupda inc hl
+        ld a,(hl)
+        sub 1
+        jr c,staupdb
+        ld (hl),a
+        set 1,c
+staupdb ld a,c
+elseif M4BOARD=1
+        ld a,(staupdsnw)
+        ld hl,staupdsig
+        cp (hl)
+        jr z,staupdc
+        ld (hl),a               ;signal changed
+        add a
+        ld c,a
+        ld b,0
+        ld hl,siggfxtab
+        add hl,bc
+        ld a,(hl)
+        inc hl
+        ld h,(hl)
+        ld l,a
+        ld (stawindatc1+4),hl
+        ld a,(stawinid)
+        ld e,14
+        call SyDesktop_WINDIN
+staupdc ld a,(staupdsig)        ;link depends on signal
+        or a
+        ld c,a
+        jr z,staupdd
+        ld c,32
+staupdd ld hl,m4c_sta_tx        ;check TX and RX
+        ld a,(hl)
+        sub 1
+        jr c,staupda
+        ld (hl),a
+        set 0,c
+staupda inc hl
+        ld a,(hl)
+        sub 1
+        jr c,staupdb
+        ld (hl),a
+        set 1,c
+staupdb ld a,c
+elseif DRIVER=4
+        db #fd:ld h,0
+        call w51rbr:db w51_com_physr       ;check status
+        ld a,e
+        bit 0,a
+        jr z,stupd10
+        and %11111110
+        jr stupd11	
+stupd10	or %00000001
+stupd11	rlca                               ;move cable status to bit0
+        ld c,a
+endif
+        ld hl,staupdw51
+        xor (hl)
+        ld (hl),c
+        ret z
+        ld l,a              ;l=changed bits
+        ld h,c              ;h=bits
+        ld ix,staupdctl-3
+        ld b,6
+        ld a,(stawinid)
+        ld c,a
+staupd7 ld de,3
+        add ix,de
+        rrc l
+        rr h
+        bit 7,l
+        jr z,staupd9
+        push hl
+        push bc
+        push ix
+        ld l,(ix+0)
+        ld h,(ix+1)
+        ld a,c
+        ld bc,stactllg0
+        jr nc,staupd8
+        ld bc,stactllg1
+staupd8 ld (hl),c
+        inc hl
+        ld (hl),b
+        ld e,(ix+2)
