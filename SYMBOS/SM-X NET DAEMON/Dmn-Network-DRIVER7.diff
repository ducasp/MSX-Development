+        bit 0,c
+        jr nz,netcfg1
+        inc a
+netcfg1 ld (cfg_ipatyp),a
+        xor a
+        bit 1,c
+        jr nz,netcfg2
+        inc a
+netcfg2 ld (cfg_dnstyp),a
+        jp cfgmodesync
