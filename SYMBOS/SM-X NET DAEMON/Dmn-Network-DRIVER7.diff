+;### CFGTYP -> patch the mode in the TCP/IP tab type records and the radio state
+;### Destroyed  AF,BC,HL
+cfgtyp  ld a,(cfg_ipatyp)
+        ld (cfgctlras),a
+        ld hl,stawindatb1
+        call cfgtyp2
+        ld a,(cfg_dnstyp)
+        ld (cfgctlrbs),a
+        ld hl,stawindatb2
+cfgtyp2 or a
+        ld bc,stactltxh0
+        jr z,cfgtyp3
+        ld bc,stactltxh1
+cfgtyp3 ld (hl),c
+        inc hl
+        ld (hl),b
+        ret
