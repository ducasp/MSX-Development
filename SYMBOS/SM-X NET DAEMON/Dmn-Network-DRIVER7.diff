+;==============================================================================
+;### CONFIG ROUTINES ##########################################################
+;==============================================================================
+
+if DRIVER=0
+cfgdatids   db "Localhost":         ds 32-9         ;ID string
+cfgdatver   db 0,1                                  ;minor, major
+elseif DRIVER=1
+cfgdatids   db "DenYoNet MSX W5100":ds 32-18
+cfgdatver   db 0,1
+elseif DRIVER=2
+cfgdatids   db "GR8NET MSX W5100":  ds 32-16
+cfgdatver   db 0,1
+elseif DRIVER=3
+cfgdatids   db "M4 CPC ESP8266":    ds 32-14
+cfgdatver   db 1,0
+elseif DRIVER=4
+cfgdatids   db "Net4CPC W5100S":    ds 32-14
+cfgdatver   db 0,1
+elseif DRIVER=5
+cfgdatids   db "M4 EP ESP8266":     ds 32-13
+cfgdatver   db 1,0
+elseif DRIVER=7
+cfgdatids   db "OCM Wi-Fi":        ds 32-10
+cfgdatver   db 0,1
+endif
+
+cfgadr  dw cfgdatids,32+2
+
+cfgadrmax   equ 1
+
+;### CFGGET -> get config data
+;### Input      A=type, E,HL=data buffer
+;### Output     CF=1 -> invalid type
+;### Destroyed  AF,BC,DE,HL,IX,IYH
+cfgget  call cfgset1
+        ret c
+        ex de,hl
+        rlca:rlca:rlca:rlca
+        jr cfgset0
+
+;### CFGSET -> set config data
+;### Input      A=type, E,HL=config data
+;### Output     CF=1 -> invalid type
+;### Destroyed  AF,BC,DE,HL,IX,IYH
+cfgset  or a
+        scf
+        ret z
+        call cfgset1
+        ret c
+cfgset0 rst #20:dw jmp_bnkcop
+        or a
+        ret
+cfgset1 cp cfgadrmax
+        ccf
+        ret c
+        add a:add a
+        ld c,a
+        ld b,0
+        ld ix,cfgadr
+        add ix,bc
+        ld a,(App_BnkNum)
+        add a:add a:add a:add a
+        add e                   ;a=source/destination bank
+        ld e,(ix+0)
+        ld d,(ix+1)             ;de=destination
+        ld c,(ix+2)
+        ld b,0                  ;bc=length
+        ret
+
+;### CFGSCK -> get socket status
+;### Input      A=first socket, C=number of sockets, E,HL=destination
+;### Destroyed  AF,BC,DE,HL,IX,IYH
+cfgsck  ld b,a
+        add c
+        cp low_sockmax+1
+        ccf
+        ret c
+        inc c
+        dec c
+        ret z
+        ld d,e
+        push hl
+        push de
+        ld hl,sckdatmem-sckdatlen
+        ld de,sckdatlen
+        inc b
+cfgsck1 add hl,de
+        djnz cfgsck1
+        ex de,hl        ;de=start
+        ld a,c
+        ld c,l
+        ld b,h
+        ld hl,0
+cfgsck2 add hl,bc
+        dec a
+        jr nz,cfgsck2
+        ld c,l
+        ld b,h          ;bc=length
+        pop af
+        add a:add a:add a:add a
+        ld hl,App_BnkNum
+        add (hl)        ;a=source/dest bank
+        ex de,hl        ;hl=start
+        pop de          ;de=destination
+        jp cfgset0
+
+
+;==============================================================================
+;### WI-FI SCAN / CONNECT #####################################################
+;==============================================================================
+
+;### SCANINIT -> initialize the list cells once (display addresses, default Open)
+scaninit
+        ld hl,scanlst
+        ld de,scanap+34
+        ld b,SCANMAX
+        ld c,0
+scanini1
+        ld (hl),c
+        inc hl
+        xor a
+        ld (hl),a
+        inc hl
+        ld (hl),e
+        inc hl
+        ld (hl),d
+        inc hl
+        push de
+        ld de,scanencO
+        ld (hl),e
+        inc hl
+        ld (hl),d
+        inc hl
+        pop de
+        push hl
+        ld hl,68
+        add hl,de
+        ex de,hl
+        pop hl
+        inc c
+        djnz scanini1
+        ret
+
+;### SCANSTART -> start a scan
+scanstart
+        ld a,(scanst)
+        or a
+        ret nz
+        ld a,1
+        ld (scanst),a
+        ld a,3
+        ld (scanrt),a
+        xor a
+        ld (scantic),a
+        ld (scancnt),a
+        ld (scantot),a
+        ld (scandat+0),a
+        ld (scandat+1),a
+        ld (scandat+2),a
+        ld (scandat+3),a
+        dec a
+        ld (scandat+12),a
+        ld (scandat+13),a
+        ld hl,scantxts0
+        call scantset
+        jp scantab
+
+;### SCANBTN -> Rescan button
+scanbtn
+        call scanstart
+        jp prgprz0
+
+;### SCANTAB -> redraw the scan tab if it is the active one
+scantab
+        ld a,(stawinvis)
+        or a
+        ret z
+        ld a,(stactltba0)
+        cp 3
+        ret nz
+        ld a,(stawinid)
+        ld e,255
+        jp SyDesktop_WINDIN
+
+;### SETTAB -> redraw the Settings tab if it is the active one
+settab
+        ld a,(stawinvis)
+        or a
+        ret z
+        ld a,(stactltba0)
+        cp 4
+        ret nz
+        ld a,(stawinid)
+        ld e,255
+        jp SyDesktop_WINDIN
+
+;### SETREAD -> read the ESP settings and fill the Settings tab
+setread
+        call espver
+        jr c,setrd0
+        call setver
+        jr setrd1
+setrd0  ld hl,setxtna
+        ld de,setxtver
+setrd0a ld a,(hl)
+        ld (de),a
+        or a
+        jr z,setrd1
+        inc hl
+        inc de
+        jr setrd0a
+setrd1  call espsetq
+        ret c
+        ld a,(esp_nagle)
+        ld (setnagl),a
+        ld hl,(esp_timer)
+        ld (setapplied),hl
+        ld de,30
+        add hl,de               ;timer+30, round to minutes
+        ld de,0
+setrd2  ld bc,-60
+        add hl,bc
+        jr nc,setrd3
+        inc e
+        ld a,e
+        cp 10
+        jr c,setrd2
+setrd3  ld a,e
+        cp 11
+        jr c,setrd4
+        ld a,10
+setrd4  ld l,a
+        ld h,0
+        add hl,hl
+        ld de,setvaltab
+        add hl,de
+        ld a,(hl)
+        ld (setsld+2),a
+        ld (setstaged),a
+        xor a
+        ld (setsld+3),a
+        ld hl,(esp_timer)
+        call setfmtp
+        ret
+
+;### SETVER -> format the firmware version text
+setver
+        ld hl,setxtpre
+        ld de,setxtver
+setvr1  ld a,(hl)
+        ld (de),a
+        or a
+        jr z,setvr2
+        inc hl
+        inc de
+        jr setvr1
+setvr2  ld a,(esp_vermaj)
+        add a,"0"
+        ld (de),a
+        inc de
+        ld a,"."
+        ld (de),a
+        inc de
+        ld a,(esp_vermin)
+        add a,"0"
+        ld (de),a
+        inc de
+        xor a
+        ld (de),a
+        ld hl,setxtver+18
+        jp setpad
+
+;### SETFMTP -> format the Wi-Fi-on period text (HL=seconds)
+setfmtp
+        ld a,h
+        or l
+        jr nz,setfp1
+        ld hl,setxtalon
+        jr setfp0
+setfp0  ld de,setxtperv
+setfp0a ld a,(hl)
+        ld (de),a
+        or a
+        jr z,setfp8
+        inc hl
+        inc de
+        jr setfp0a
+setfp1  push hl
+        ld b,0
+setfp2  ld a,h
+        or a
+        jr nz,setfp3
+        ld a,l
+        cp 60
+        jr c,setfp4
+setfp3  ld de,-60
+        add hl,de
+        inc b
+        jr setfp2
+setfp4  ld a,l
+        pop hl
+        or a
+        jr nz,setfp6
+        push bc
+        ld a,b
+        ld hl,setxtperv
+        call clcn08
+        pop bc
+        ex de,hl
+        ld a,b
+        cp 1
+        ld hl,setxtmin1
+        jr z,setfp5
+        ld hl,setxtmin2
+setfp5  ld a,(hl)
+        ld (de),a
+        or a
+        jr z,setfp8
+        inc hl
+        inc de
+        jr setfp5
+setfp6  ex de,hl
+        ld ix,0
+        ld iy,setxtperv
+        call clcn32
+        inc iy
+        ld hl,setxtsec
+setfp7  ld a,(hl)
+        ld (iy+0),a
+        or a
+        jr z,setfp8
+        inc hl
+        inc iy
+        jr setfp7
+setfp8  ld hl,setxtperv+18
+        jp setpad
+
+;### SETPAD -> pad the text ending at DE with spaces up to the limit in HL
+setpad
+        or a
+        sbc hl,de
+        ret c
+        ret z
+        ld b,l
+        ex de,hl
+setpd1  ld (hl)," "
+        inc hl
+        djnz setpd1
+        ld (hl),0
+        ret
+
+;### SETSLDC -> period slider clicked (one position minimum per click)
+setsldc
+        ld a,(setsld+2)
+        ld hl,setstaged
+        cp (hl)
+        jr z,setsldc0
+        ld b,0
+        jr nc,setsldc1          ;raw > shown -> right
+        ld b,255                ;raw < shown -> left
+        jr setsldc2
+setsldc1 ld b,1
+setsldc2 ld a,b
+        ld (setorce),a
+        call setpol
+        jp prgprz0
+setsldc0 xor a
+        ld (setorce),a
+        jp prgprz0
+
+;### SETPOL -> update the period text when the slider moves (no ESP access)
+setpol
+        ld a,(stawinvis)
+        or a
+        ret z
+        ld a,(stactltba0)
+        cp 4
+        ret nz
+        ld a,(setsld+2)
+        ld hl,setstaged
+        cp (hl)
+        jr nz,setpoch
+        xor a
+        ld (setorce),a
+        ret
+setpoch
+        ld b,1
+        jr nc,setpoch1           ;raw > shown -> right
+        ld b,255                 ;raw < shown -> left
+setpoch1 ld a,b
+        ld (setorce),a
+        ld a,(setstaged)         ;minutes shown before the change
+        call setvmin
+        ld (setprevm),a
+        ld a,(setsld+2)          ;minutes of the new value
+        call setvmin
+        ld c,a
+        ld a,(setorce)           ;force at least one position in the click direction
+        or a
+        jr z,setpnf
+        inc a
+        jr z,setplft
+        ld a,(setprevm)
+        cp c
+        jr c,setpnf
+        inc a
+        ld c,a
+        jr setpnf
+setplft ld a,(setprevm)
+        cp c
+        jr c,setplf1
+        jr z,setplf1
+        jr setpnf
+setplf1 dec a
+        ld c,a
+setpnf  xor a
+        ld (setorce),a
+        ld a,c
+        bit 7,a
+        jr nz,setpzro
+        cp 11
+        jr c,setpok
+        ld a,10
+        jr setpok
+setpzro xor a
+setpok  ld c,a                   ;minutes 0..10
+        ld l,a
+        ld h,0
+        add hl,hl
+        ld de,setvaltab
+        add hl,de
+        ld a,(hl)                ;snap the slider to the minute position
+        ld (setsld+2),a
+        ld (setstaged),a
+        xor a
+        ld (setsld+3),a
+        ld b,0
+        push bc
+        ld e,7
+        ld a,(stawinid)
+        call SyDesktop_WINDIN
+        pop bc
+        ld a,c
+        ld l,a
+        ld h,0
+        add hl,hl
+        ld de,setmintab
+        add hl,de
+        ld e,(hl)
+        inc hl
+        ld d,(hl)
+        ex de,hl                 ;HL=seconds
+        call setfmtp
+        ld e,9
+        ld a,(stawinid)
+        jp SyDesktop_WINDIN
+
+;### SETVMIN -> slider value (A=0..255) to minutes (A=0..10, rounded)
+setvmin
+        ld l,a
+        ld h,0
+        add hl,hl
+        ld de,25
+        add hl,de
+        ld b,0
+setvm1  ld de,-51
+        add hl,de
+        jr nc,setvm2
+        inc b
+        jr setvm1
+setvm2  ld a,b
+        ret
+
+;### SETNAG -> Nagle checkbox clicked
+setnag
+        ld a,(setnagl)
+        or a
+        jr z,setng1
+        ld a,1
+        jr setng2
+setng1  xor a
+setng2  call espnag
+        jr c,setnge
+        ld a,(setnagl)
+        ld (esp_nagle),a
+        jp prgprz0
+setnge  ld c,a
+        ld a,(esp_nagle)
+        ld (setnagl),a
+        push bc
+        ld e,5
+        ld a,(stawinid)
+        call SyDesktop_WINDIN
+        pop bc
+        ld a,c
+        cp #FE
+        ld hl,cfgerrmsgbz
+        jr z,setng3
+        ld hl,cfgerrmsgns
+setng3  ld a,(App_BnkNum)
+        ld b,1+8+64
+        ld de,stawindat
+        call SySystem_SYSWRN
+        jp prgprz0
+
+;### SETAPP -> apply the Wi-Fi-on period slider
+setapp
+        ld a,(setsld+2)
+        call setvmin             ;A=minutes 0..10
+        ld l,a
+        ld h,0
+        add hl,hl
+        ld de,setmintab
+        add hl,de
+        ld e,(hl)
+        inc hl
+        ld d,(hl)
+        ld h,d
+        ld l,e
+        ld (setapt),hl
+        call esptim
+        jr c,setape
+        ld hl,(setapt)
+        ld (setapplied),hl
+        call setfmtp
+        ld e,9
+        ld a,(stawinid)
+        call SyDesktop_WINDIN
+        jp prgprz0
+setape  cp #FE
+        ld hl,cfgerrmsgbz
+        jr z,setap2
+        ld hl,cfgerrmsgns
+setap2  ld a,(App_BnkNum)
+        ld b,1+8+64
+        ld de,stawindat
+        call SySystem_SYSWRN
+        jp prgprz0
+
+;### UPDATE firmware/certificates #############################################
+
+;### UPSTRC -> copy the 0 terminated string in HL to DE
+upstrc  ld a,(hl)
+        ld (de),a
+        or a
+        ret z
+        inc hl
+        inc de
+        jr upstrc
+
+;### UPDPROG -> animate the "Sending" line
+updprog
+        ld a,(updwinid)
+        or a
+        ret z
+        ld hl,updtxtsend2
+        ld de,updline2
+        call upstrc
+        ld h,d
+        ld l,e
+        ld a,(updpc)
+        call clcn08
+        ld (hl),"%"
+        inc hl
+        ld de,updline2+20
+updp1   ld a,h
+        cp d
+        jr nz,updp2
+        ld a,l
+        cp e
+        jr nc,updp3
+updp2   ld (hl)," "
+        inc hl
+        jr updp1
+updp3   xor a
+        ld (de),a
+        ld a,(updbar)
