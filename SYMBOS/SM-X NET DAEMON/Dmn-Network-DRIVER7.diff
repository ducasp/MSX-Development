+        ld (updacp),hl
+        ld (updacb),hl
+        ld a,#36
+        ld (setbarparam),a
+        xor a
+        ld (setbarparam+1),a
+        ld hl,(updsizl)
+        ld (updrem),hl
+        ld hl,(updsizh)
+        ld (updremhi),hl
+udloop
+        ld hl,updbuf
+        ld bc,(updblk)
+        call espupblk
+        jp c,updserr
+        ld hl,(updacp)
+        ld de,100
+        add hl,de
+udpca   ld de,(updtb)
+        or a
+        sbc hl,de
+        jr c,udpcb
+        ld a,(updpc)
+        inc a
+        ld (updpc),a
+        jr udpca
+udpcb   add hl,de
+        ld (updacp),hl
+        ld hl,(updacb)
+        ld de,255
+        add hl,de
+udpba   ld de,(updtb)
+        or a
+        sbc hl,de
+        jr c,udpbb
+        ld a,(updbar)
+        inc a
+        ld (updbar),a
+        jr udpba
+udpbb   add hl,de
+        ld (updacb),hl
+        ld hl,updblkc
+        inc (hl)
+        ld a,(hl)
+        and 7
+        jr nz,udl0c
+        rst #30
+udl0c   ld a,(updblkc)
+        and 31
+        jr nz,udl0
+        call updprog
+udl0    ld bc,(updblk)
+        ld hl,(updrem)
+        or a
+        sbc hl,bc
+        ld (updrem),hl
+        jr nc,udl1
+        ld hl,(updremhi)
+        dec hl
+        ld (updremhi),hl
+udl1    ld a,(updrem)
+        or a
+        jr nz,udl2
+        ld a,(updrem+1)
+        or a
+        jr nz,udl2
+        ld a,(updremhi)
+        or a
+        jr nz,udl2
+        ld a,(updremhi+1)
+        or a
+        jr z,udfin
+udl2    ld a,(App_BnkNum)
+        ld e,a
+        ld a,(updfh)
+        ld hl,updbuf
+        ld bc,256
+        call SyFile_FILINP
+        jp c,upderrread
+        ld a,b
+        or c
+        jp z,upderrread
+        ld (updblk),bc
+        jp udloop
+udfin
+        ld a,255
+        ld (setbarparam+1),a
+        ld hl,updtxtfin
+        call updtext
+        ld b,60
+udf1    push bc
+        call updmsg
+        pop bc
+        rst #30
+        halt
+        rst #30
+        djnz udf1
+        call espupend
+        jp c,upderrend
+        ld hl,updtxtrst
+        call updtext
+        call espupready
+        jp c,upderrready
+        ld a,(updmode)
+        or a
+        jr nz,upddone
+        ld hl,updtxtidx
+        call updtext
+        ld b,10
+udd1    call espupidx
+        jr nc,upddone
+        djnz udd1
+upddone
+        call updclosf
+        ld a,1
+        call netini0
+        ld hl,updmsgok
+        jp upderrm
+
+upderrop
+        ld hl,updmsgerr1
+        jp upderrm
+upderrcl
+        call updclosf
+        ld hl,updmsgerr4
+        jp upderrm
+upderrtype
+        call updclosf
+        ld hl,updmsgerr2
+        jp upderrm
+upderrread
+        call updclosf
+        ld hl,updmsgerr4
+        jp upderrm
+upderrend
+        call updclosf
+        ld a,1
+        call netini0
+        ld hl,updmsgerr4
+        jp upderrm
+upderrready
+        call updclosf
+        ld a,1
+        call netini0
+        ld hl,updmsgerr3
+        jp upderrm
+
+;### SCANTSET -> copy the string in HL to the scan status line and redraw
+scantset
+        ld de,scantxt
+scants1 ld a,(hl)
+        ld (de),a
+        or a
+        jr z,scants2
+        inc hl
+        inc de
+        jr scants1
+scants2 ret
+
+;### SCANFND -> build "N networks found"
+scanfnd
+        ld a,(scancnt)
+        ld hl,scantxt
+        call clcn08
+        ld de,scantxts3
+scanfn1 ld a,(de)
+        ld (hl),a
+        or a
+        jr z,scanfn2
+        inc de
+        inc hl
+        jr scanfn1
+scanfn2 ret
+
+;### SCANSTS -> status "prefix + display SSID" (HL=prefix)
+scansts
+        ld de,scantxt
+scanst1 ld a,(hl)
+        ld (de),a
+        or a
+        jr z,scanst2
+        inc hl
+        inc de
+        jr scanst1
+scanst2 push de
+        ld hl,(scanentry)
+        ld de,34
+        add hl,de
+        pop de
+scanst3 ld a,(hl)
+        ld (de),a
+        or a
+        jr z,scanst4
+        inc hl
+        inc de
+        jr scanst3
+scanst4 jp scantab
+
+;### SCANFAIL -> status "Connection failed rc=N" (A=rc)
+scanfail
+        push af
+        ld hl,scantxts5
+        ld de,scantxt
+scanf1  ld a,(hl)
+        ld (de),a
+        or a
+        jr z,scanf2
+        inc hl
+        inc de
+        jr scanf1
+scanf2  pop af
+        ld h,d
+        ld l,e
+        call clcn08
+        jp scantab
+
+;### SCANPOL -> poll the scan start and the scan results
+scanpol
+        ld a,(scanst)
+        or a
+        ret z
+        cp 1
+        jr z,scanpos
+        ld hl,scantic
+        dec (hl)
+        ret nz
+        ld (hl),25              ;about every 0.5 seconds
+        ld a,(esp_pend)
+        or a
+        ret nz
+        call espscanr
+        jr c,scanpe
+        or a
+        jr z,scanpr
+        cp 2
+        jr z,scanp2
+        jr scanpt
+scanpos
+        ld a,(scantic)
+        or a
+        jr z,scanpo0
+        dec a
+        ld (scantic),a
+        ret
+scanpo0
+        ld a,(esp_pend)
+        or a
+        ret nz
+        call espscan
+        jr c,scanprt
+        ld a,2
+        ld (scanst),a
+        ld a,25
+        ld (scantic),a
+        ld a,24
+        ld (scantmo),a
+        ret
+scanpr
+        call scanlist
+        ld a,(scancnt)
+        or a
+        jr z,scanpn
+        call scanfnd
+        xor a
+        ld (scanst),a
+        jp scantab
+scanpn
+        xor a
+        ld (scanst),a
+        ld hl,scantxts1
+        call scantset
+        jp scantab
+scanpt
+        ld hl,scantmo
+        dec (hl)
+        jr z,scanprt
+        ret
+scanpe
+        ld hl,scantmo
+        dec (hl)
+        jr z,scanprt
+        ret
+scanp2
+        ld a,(scanrt)
+        or a
+        jr z,scanpn
+        dec a
+        ld (scanrt),a
+        ld a,1
+        ld (scanst),a
+        ld a,25
+        ld (scantic),a
+        ret
+scanprt
+        ld a,(scanrt)
+        or a
+        jr z,scanpfail
+        dec a
+        ld (scanrt),a
+        ld a,1
+        ld (scanst),a
+        ld a,25
+        ld (scantic),a
+        ret
+scanpfail
+        xor a
+        ld (scanst),a
+        ld hl,scantxts2
+        call scantset
+        jp scantab
+
+;### SCANLIST -> patch the list cells from the scan buffer
+scanlist
+        ld hl,scanlst
+        ld ix,scanap
+        ld a,(scancnt)
+        or a
+        jr z,scanls2
+        ld b,a
+scanls1
+        push hl
+        ld de,4
+        add hl,de
+        ld a,(ix+33)
+        ld de,scanencO
+        or a
+        jr z,scanls3
+        ld de,scanencE
+scanls3
+        ld (hl),e
+        inc hl
+        ld (hl),d
+        pop hl
+        ld de,6
+        add hl,de
+        push hl
+        push ix
+        pop hl
+        ld de,68
+        add hl,de
+        push hl
+        pop ix
+        pop hl
+        djnz scanls1
+scanls2
+        ld a,(scancnt)
+        ld (scandat+0),a
+        xor a
+        ld (scandat+1),a
+        ld (scandat+2),a
+        ld (scandat+3),a
+        dec a
+        ld (scandat+12),a
+        ld (scandat+13),a
+        ret
+
+;### SCANSEL -> an access point was clicked in the list
+scansel
+        ld a,(pwdwinid)
+        or a
+        jp nz,prgprz0          ;ignore while the password window is open
+        ld a,(scandat+13)
+        or a
+        jp nz,scansnosel
+        ld a,(scandat+12)
+        ld c,a
+        ld a,(scancnt)
+        cp c
+        jp z,scansnosel
+        jp c,scansnosel
+        ld a,#FF
+        ld (scandat+12),a
+        ld (scandat+13),a
+        ld a,c
+        ld l,a
+        ld h,0
+        add hl,hl
+        add hl,hl
+        add hl,hl
+        add hl,hl
+        add hl,hl
+        add hl,hl               ;*64
+        ex de,hl
+        ld a,c
+        ld l,a
+        ld h,0
+        add hl,hl
+        add hl,hl               ;*4
+        add hl,de               ;*68
+        ld de,scanap
+        add hl,de
+        ld (scanentry),hl
+        ld de,33
+        add hl,de
+        ld a,(hl)
+        or a
+        jr z,scansopen
+        call scanpw
+        jp prgprz0
+scansopen
+        xor a
+        ld (pwdlen),a
+        call scanconn
+        jp prgprz0
+scansnosel
+        ld a,#FF
+        ld (scandat+12),a
+        ld (scandat+13),a
+        jp prgprz0
+
+;### SCANPW -> ask for the password of the selected network
+scanpw
+        ld hl,(scanentry)
+        ld de,34
+        add hl,de
+        ld de,pwdline
+        push hl
+        ld hl,scanpwnet
+scanpw1 ld a,(hl)
+        ld (de),a
+        or a
+        jr z,scanpw2
+        inc hl
+        inc de
+        jr scanpw1
+scanpw2 pop hl
+        ld b,32
+scanpw3 ld a,(hl)
+        or a
+        jr z,scanpw4
+        ld (de),a
+        inc hl
+        inc de
+        dec b
+        jr nz,scanpw3
+scanpw4 xor a
+        ld (de),a
+        ld (pwdbuf),a
+        ld (pwdinp+2),a
+        ld (pwdinp+4),a
+        ld (pwdinp+6),a
+        ld (pwdinp+8),a
+        ld (pwdinp+9),a
+        ld a,1
+        ld (pwdinp+12),a
+        xor a
+        ld (pwdshowb),a
+        ld a,4                  ;the desktop stores the last focus in the group
+        ld (pwdwingrpa+14),a    ;record, put the input back for a fresh open
+        ld a,(App_BnkNum)
+        ld de,pwdwindat
+        call SyDesktop_WINOPN
+        ret c
+        ld (pwdwinid),a
+        ld e,4                  ;draw the initial checkbox state
+        call SyDesktop_WINDIN
+        ld a,(pwdwinid)
+        ld e,3                  ;and the input line
+        call SyDesktop_WINDIN
+        ret
+
+;### PWDOK -> password entered, connect
+pwdok
+        ld a,(pwdwinid)
+        or a
+        jr z,pwdok1
+        push af
+        xor a
+        ld (pwdwinid),a
+        pop af
+        call SyDesktop_WINCLS
+pwdok1
+        ld a,(pwdinp+8)
+        ld (pwdlen),a
+        call scanconn
+        jp prgprz0
+
+;### PWDC1 -> close the password window
+pwdc1
+        ld a,(pwdwinid)
+        or a
+        ret z
+        push af
+        xor a
+        ld (pwdwinid),a
+        pop af
+        jp SyDesktop_WINCLS
+
+;### PWDC1C -> cancel button
+pwdcnc
+        call pwdc1
+        jp prgprz0
+
+;### PWDSHOW -> toggle password visibility
+pwdshow
+        ld hl,pwdinp+12
+        ld a,(hl)
+        xor 1
+        ld (hl),a
+        and 1
+        xor 1                   ;checkbox is checked when the text is visible
+        ld (pwdshowb),a
+        ld a,(pwdwinid)
+        or a
+        jp z,prgprz0
+        push af
+        xor a
+        ld (pwdwinid),a
+        pop af
+        call SyDesktop_WINCLS   ;reopen from the main loop, so the text input
+        ld a,1                  ;re-renders the password state
+        ld (pwdreop),a
+        jp prgprz0
+
+;### PWDROPN -> reopen the password window after a Show toggle
+pwdropn ld a,(pwdreop)
+        or a
+        ret z
+        xor a
+        ld (pwdreop),a
+        ld a,4                  ;desktop overwrote the focus byte, reset it
+        ld (pwdwingrpa+14),a
+        ld a,(App_BnkNum)
+        ld de,pwdwindat
+        call SyDesktop_WINOPN
+        ret c
+        ld (pwdwinid),a
+        ret
+
+;### STADISC -> forget the current Wi-Fi access point
+stadisc
+        call espdisc
+        jr c,stadis1
+        xor a
+        ld (esp_apst),a
+        call espssid             ;update the driver tab WiFi line
+        ld hl,net_ipaadr         ;clear the shown IP/mask/gateway/DNS
+        ld b,20
+        xor a
+stadis3 ld (hl),a
+        inc hl
+        djnz stadis3
+        call cfgipr
+        ld a,1
+        call netini0             ;no IP
+        jp prgprz0
+stadis1
+        cp #FE
+        ld hl,cfgerrmsgbz
+        jr z,stadis2
+        ld hl,cfgerrmsgns
+stadis2
+        ld a,(App_BnkNum)
+        ld b,1+8+64
+        ld de,stawindat
+        call SySystem_SYSWRN
+        jp prgprz0
+
+;### SCANCONN -> build the connect payload and connect (blocking)
+scanconn
+        ld hl,(scanentry)
+        ld de,connbuf
+        ld b,33
+scanco1 ld a,(hl)
+        ld (de),a
+        inc hl
+        inc de
+        or a
+        jr z,scanco2
+        djnz scanco1
+        xor a
+        ld (de),a
+        inc de
+scanco2 ld a,(pwdlen)
+        or a
+        jr z,scanco4
+        ld b,a
+        ld hl,pwdbuf
+scanco3 ld a,(hl)
+        ld (de),a
+        inc hl
+        inc de
+        djnz scanco3
+scanco4 ld hl,connbuf
+        ex de,hl
+        or a
+        sbc hl,de
+        ld (connlen),hl
+        ld hl,scantxts4
+        call scansts
+        ld a,1
+        call netini0
+        ld hl,connbuf
+        ld bc,(connlen)
+        call espconn
+        jr c,scancoe
+        ld hl,scantxts6
+        call scansts
+        ld a,1
+        ld (netipsc),a
+        ret
+scancoe
+        ld c,a
+        ld hl,scanerrmsg
+        cp #FE
+        jr nz,scancoe1
+        ld hl,cfgerrmsgbz
+        jr scancoe3
+scancoe1
+        cp #FF
+        jr nz,scancoe3
+        ld hl,cfgerrmsgns
+scancoe3
+        push hl
+        ld a,c
+        call scanfail
+        pop hl
+        ld a,(App_BnkNum)
+        ld b,1+8+64
+        ld de,stawindat
+        call SySystem_SYSWRN
+        ld a,1
+        ld (netipsc),a
+        ret
+;==============================================================================
+;### SUB ROUTINES #############################################################
+;==============================================================================
+
+;### STRINP -> Initialisiert Textinput (abhängig vom String, den es bearbeitet)
+;### Eingabe    IX=Control
+;### Ausgabe    HL=Stringende (0), BC=Länge (maximal 255)
+;### Verändert  AF
+strinp  ld l,(ix+0)
+        ld h,(ix+1)
+        call strlen
+        ld (ix+8),c
+        ld (ix+4),c
+        xor a
+        ld (ix+2),a
+        ld (ix+6),a
+        ret
+
+;### STRLEN -> Ermittelt Länge eines Strings
+;### Eingabe    HL=String (0-terminiert)
+;### Ausgabe    HL=Stringende (0), BC=Länge (maximal 255, ohne Terminator)
+;### Verändert  -
+strlen  push af
+        xor a
+        ld bc,255
+        cpir
+        ld a,254
+        sub c
+        ld c,a
+        dec hl
+        pop af
+        ret
+
+SySystem_HLPFLG db 0    ;flag, if HLP-path is valid
+SySystem_HLPPTH db "%help.exe "
+SySystem_HLPPTH1 ds 128
+SySHInX db ".HLP",0
+
+SySystem_HLPINI
+        ld hl,(App_BegCode)
+        ld de,App_BegCode
+        dec h
+        add hl,de                   ;HL = CodeEnd = Command line
+        ld de,SySystem_HLPPTH1
+        ld bc,0
+        db #dd:ld l,128
+SySHIn1 ld a,(hl)
+        or a
+        jr z,SySHIn3
+        cp " "
+        jr z,SySHIn3
+        cp "."
+        jr nz,SySHIn2
+        ld c,e
+        ld b,d
+SySHIn2 ld (de),a
+        inc hl
+        inc de
+        db #dd:dec l
+        ret z
+        jr SySHIn1
+SySHIn3 ld a,c
+        or b
+        ret z
+        ld hl,-4
+        add hl,bc
+        ex de,hl
+        ld hl,SySHInX
+        ld bc,5
+        ldir
+        ld a,1
+        ld (SySystem_HLPFLG),a
+        ret
+
+SySystem_HLPOPN
+        ld a,(SySystem_HLPFLG)
+        or a
+        ret z
+        ld hl,SySystem_HLPPTH
+        ld a,(App_BnkNum)
+        jp SySystem_PRGRUN
+
+;### CLCUCS -> Change letters to uppercase
+;### Input      A=char
+;### Output     A=ucase(char)
+;### Destroyed  F
+clcucs  cp "a"
+        ret c
+        cp "z"+1
+        ret nc
+        add "A"-"a"
+        ret
+
+;### CLCN08 -> Converst 8bit number into ASCII string (0-terminated)
+;### Input      A=Value, HL=Destination
+;### Output     HL=points behind last digit
+;### Destroyed  AF,BC
+clcn08  cp 10
+        jr c,clcn082
+        cp 100
+        jr c,clcn081
+        ld c,100
+        call clcn083
+clcn081 ld c,10
+        call clcn083
+clcn082 add "0"
+        ld (hl),a
+        inc hl
+        ld (hl),0
+        ret
+clcn083 ld b,"0"-1
+clcn084 sub c
+        inc b
+        jr nc,clcn084
+        add c
+        ld (hl),b
+        inc hl
+        ret
+
+;### CLCN32 -> Converts 32Bit number into ASCII string (0-terminated)
+;### Input      DE,IX=value, IY=address
+;### Output     IY=address of last char
+;### Veraendert AF,BC,DE,HL,IX,IY
+clcn32t dw 1,0,     10,0,     100,0,     1000,0,     10000,0
+        dw #86a0,1, #4240,#f, #9680,#98, #e100,#5f5, #ca00,#3b9a
+clcn32z ds 4
+
+clcn32  ld (clcn32z),ix
+        ld (clcn32z+2),de
+        ld ix,clcn32t+36
+        ld b,9
+        ld c,0
+clcn321 ld a,"0"
+        or a
+clcn322 ld e,(ix+0):ld d,(ix+1):ld hl,(clcn32z):  sbc hl,de:ld (clcn32z),hl
+        ld e,(ix+2):ld d,(ix+3):ld hl,(clcn32z+2):sbc hl,de:ld (clcn32z+2),hl
+        jr c,clcn325
+        inc c
+        inc a
+        jr clcn322
+clcn325 ld e,(ix+0):ld d,(ix+1):ld hl,(clcn32z):  add hl,de:ld (clcn32z),hl
+        ld e,(ix+2):ld d,(ix+3):ld hl,(clcn32z+2):adc hl,de:ld (clcn32z+2),hl
+        ld de,-4
+        add ix,de
+        inc c
+        dec c
+        jr z,clcn323
+        ld (iy+0),a
+        inc iy
+clcn323 djnz clcn321
+        ld a,(clcn32z)
+        add "0"
+        ld (iy+0),a
+        ld (iy+1),0
+        ret
+
+;### CLCHEX -> Converts 8bit value into hex string
+;### Input      A=value, (DE)=string
+;### Output     DE=DE+2
+;### Destroyed  F,C
+clchex  ld c,a          ;a=number -> (DE)=hexdigits, DE=DE+2
+        rlca:rlca:rlca:rlca
+        call clchex1
+        ld a,c
+clchex1 and 15
+        add "0"
+        cp "9"+1
+        jr c,clchex2
+        add "A"-"9"-1
+clchex2 ld (de),a
+        inc de
+        ret
+
+;### CLCHXB -> converts HEX string into value
+;### Input      HL=hex string (L=16er, H=1er or L=1er, H=0)
+;### Output     CF=1 -> invalid value, CF=0 -> A=value
+;### Destroyed  HL
+clchxb  ld a,l
+        call clchxb0
+        ret c
+        inc h
+        dec h
+        ret z
+        ld l,a
+        ld a,h
+        call clchxb0
+        ret c
+        ld h,a
+        ld a,l
+        add a:add a:add a:add a
+        add h
+        ret
+clchxb0 call clcucs
+        cp "9"+1
+        jr nc,clchxb1
+        sub "0"
+        ret
+clchxb1 cp "A"
+        ret c
+        cp "Z"+1
+        ccf
+        ret c
+        sub "A"-10
+        ret
+
+
